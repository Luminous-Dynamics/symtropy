{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/polar-infrastructure/benchmark/schemas/long-horizon-resilience-contract-0.1.0.schema.json",
  "title": "Symtropy Long-Horizon Resilience Contract",
  "description": "Design-only contract for nonstationary, stateful long-horizon resilience studies. Structural validity does not imply admitted source data, verified physics, or controller performance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_kind", "contract_id", "status", "evidence_class",
    "study_id", "study_question", "evidence_boundary", "horizon", "scenario_families",
    "persistent_state_variables", "adaptation_decisions", "comparison_design",
    "required_metric_ids", "admission_gates", "decision_policy"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_kind": { "const": "symtropy-long-horizon-resilience-contract" },
    "contract_id": { "const": "long_horizon_climate_adaptation_v0" },
    "status": { "const": "proposed_not_executed" },
    "evidence_class": { "const": "test_design_only" },
    "study_id": { "type": "string", "minLength": 1 },
    "study_question": { "type": "string", "minLength": 1 },
    "evidence_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["environmental_trace_admitted", "physical_model_verified", "controller_result_measured", "probability_basis_verified", "scenario_weights", "rule"],
      "properties": {
        "environmental_trace_admitted": { "type": "boolean" },
        "physical_model_verified": { "type": "boolean" },
        "controller_result_measured": { "type": "boolean" },
        "probability_basis_verified": { "type": "boolean" },
        "scenario_weights": { "type": ["array", "null"], "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "horizon": {
      "type": "object", "additionalProperties": false,
      "required": ["start_year", "end_year_exclusive", "duration_years", "planning_resolution", "carry_state_between_events", "allow_state_reset_between_events", "preserve_temporal_order", "allow_silent_gap_imputation"],
      "properties": {
        "start_year": { "type": "integer", "minimum": 1900 },
        "end_year_exclusive": { "type": "integer", "minimum": 1901 },
        "duration_years": { "type": "integer", "minimum": 1 },
        "planning_resolution": { "type": "string", "minLength": 1 },
        "carry_state_between_events": { "type": "boolean" },
        "allow_state_reset_between_events": { "type": "boolean" },
        "preserve_temporal_order": { "type": "boolean" },
        "allow_silent_gap_imputation": { "type": "boolean" }
      }
    },
    "scenario_families": {
      "type": "array", "minItems": 3, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario_id", "scenario_kind", "climate_regime", "nonstationary", "environmental_parameters_included", "source_admission_status", "scenario_weight"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "scenario_kind": { "type": "string", "minLength": 1 },
          "climate_regime": { "type": "string", "minLength": 1 },
          "nonstationary": { "type": "boolean" },
          "environmental_parameters_included": { "type": "boolean" },
          "source_admission_status": { "const": "not_admitted" },
          "scenario_weight": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "persistent_state_variables": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "adaptation_decisions": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_id", "decision_frequency", "decision_costs_admitted"],
        "properties": {
          "decision_id": { "type": "string", "minLength": 1 },
          "decision_frequency": { "type": "string", "minLength": 1 },
          "decision_costs_admitted": { "type": "boolean" }
        }
      }
    },
    "comparison_design": {
      "type": "object", "additionalProperties": false,
      "required": ["arms", "paired_exogenous_trajectories", "same_initial_state_per_pair", "controller_visible_information_must_be_declared", "matched_information_budget_or_explicit_ablation", "compute_budget_must_be_recorded", "locked_holdout_frozen_before_tuning", "whole_site_year_or_episode_blocks", "locked_holdout_used_for_tuning", "reset_state_between_events"],
      "properties": {
        "arms": {
          "type": "array", "minItems": 3, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["arm_id", "state_carryover", "role"],
            "properties": {
              "arm_id": { "type": "string", "minLength": 1 },
              "state_carryover": { "type": "boolean" },
              "adaptation_enabled": { "type": "boolean" },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "paired_exogenous_trajectories": { "type": "boolean" },
        "same_initial_state_per_pair": { "type": "boolean" },
        "controller_visible_information_must_be_declared": { "type": "boolean" },
        "matched_information_budget_or_explicit_ablation": { "type": "boolean" },
        "compute_budget_must_be_recorded": { "type": "boolean" },
        "locked_holdout_frozen_before_tuning": { "type": "boolean" },
        "whole_site_year_or_episode_blocks": { "type": "boolean" },
        "locked_holdout_used_for_tuning": { "type": "boolean" },
        "reset_state_between_events": { "type": "boolean" }
      }
    },
    "required_metric_ids": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "admission_gates": {
      "type": "object", "additionalProperties": false,
      "required": ["source_trace_and_usage_terms_admitted", "climate_scenarios_have_declared_evidence_class", "state_carryover_semantics_verified", "plant_model_verified_for_declared_use", "adaptation_cost_data_admitted_or_cost_metric_disabled", "paired_information_and_compute_budget_reviewed", "locked_holdout_frozen", "negative_controls_passed"],
      "properties": {
        "source_trace_and_usage_terms_admitted": { "type": "boolean" },
        "climate_scenarios_have_declared_evidence_class": { "type": "boolean" },
        "state_carryover_semantics_verified": { "type": "boolean" },
        "plant_model_verified_for_declared_use": { "type": "boolean" },
        "adaptation_cost_data_admitted_or_cost_metric_disabled": { "type": "boolean" },
        "paired_information_and_compute_budget_reviewed": { "type": "boolean" },
        "locked_holdout_frozen": { "type": "boolean" },
        "negative_controls_passed": { "type": "boolean" }
      }
    },
    "decision_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["result_kind", "single_scalar_score_allowed", "probability_weighted_risk_allowed_without_verified_basis", "event_reset_baseline_may_be_called_sota", "failed_or_missing_service_windows_may_be_dropped", "cross_site_or_future_climate_claim_requires_independent_holdout"],
      "properties": {
        "result_kind": { "const": "contract_validation_only_no_performance_results" },
        "single_scalar_score_allowed": { "type": "boolean" },
        "probability_weighted_risk_allowed_without_verified_basis": { "type": "boolean" },
        "event_reset_baseline_may_be_called_sota": { "type": "boolean" },
        "failed_or_missing_service_windows_may_be_dropped": { "type": "boolean" },
        "cross_site_or_future_climate_claim_requires_independent_holdout": { "type": "boolean" }
      }
    }
  }
}