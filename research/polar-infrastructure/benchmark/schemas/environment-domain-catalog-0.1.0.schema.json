{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/polar-resilience-boundary-discovery-v0/research/polar-infrastructure/benchmark/schemas/environment-domain-catalog-0.1.0.schema.json",
  "title": "Symtropy Environment Domain Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "catalog_revision",
    "status",
    "evidence_class",
    "coverage_policy",
    "required_profile_fields",
    "common_dimensions",
    "profiles",
    "required_evidence_labels",
    "validation_rules"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "artifact_kind": {
      "const": "symtropy-environment-domain-catalog"
    },
    "catalog_revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "const": "research_taxonomy_not_physical_model"
    },
    "evidence_class": {
      "type": "string",
      "minLength": 1
    },
    "coverage_policy": {
      "type": "object",
      "required": [
        "required_status_for_each_profile",
        "explicit_unknowns_are_not_passes",
        "cross_domain_transfer_requires_held_out_validation",
        "no_single_universal_environment_score",
        "note"
      ],
      "properties": {
        "required_status_for_each_profile": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4,
          "uniqueItems": true
        },
        "explicit_unknowns_are_not_passes": {
          "const": true
        },
        "cross_domain_transfer_requires_held_out_validation": {
          "const": true
        },
        "no_single_universal_environment_score": {
          "const": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "required_profile_fields": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "common_dimensions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "domain",
          "location_or_body",
          "deployment_mode",
          "stressors",
          "coupled_hazard_hypotheses",
          "model_requirements",
          "required_metrics",
          "evidence_basis",
          "confidence_or_data_limitations",
          "source_urls"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+([._][a-z0-9]+)*$"
          },
          "domain": {
            "type": "string",
            "enum": [
              "earth_extreme_environment",
              "space_cross_cutting",
              "solar_system_body",
              "solar_system_small_body"
            ]
          },
          "location_or_body": {
            "type": "string",
            "minLength": 1
          },
          "deployment_mode": {
            "type": "string",
            "minLength": 1
          },
          "stressors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coupled_hazard_hypotheses": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "model_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_basis": {
            "type": "string",
            "minLength": 1
          },
          "confidence_or_data_limitations": {
            "type": "string",
            "minLength": 1
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "required_evidence_labels": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "validation_rules": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}