      "scope": "Cold-region water, wastewater, fire protection, utilities and thermal design"
    },
    {
      "title": "UFC Arctic/Subarctic criteria index",
      "url": "https://legacy.wbdg.org/dod/ufc",
      "scope": "Site assessment, foundations and buildings"
