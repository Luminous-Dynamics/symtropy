{
  "schema_version": "loco-modal-fault-space-known-answers-v0.1",
  "bounds": {
    "max_components": 16,
    "max_group_tuples": 4096,
    "max_global_signatures": 65536
  },
  "state_vocabulary": [
    "valid",
    "degraded",
    "ood",
    "unavailable",
    "unknown",
    "thermal_derated",
    "voltage_sag"
  ],
  "cases": [
    {
      "id": "A-vision-stereo-shared-camera",
      "components": [
        {
          "id": "rgb",
          "domain": [
            "valid",
            "ood",
            "unavailable"
          ]
        },
        {
          "id": "depth",
          "domain": [
            "valid",
            "ood",
            "unavailable"
          ]
        }
      ],
      "groups": [
        {
          "id": "camera-unit",
          "members": [
            "rgb",
            "depth"
          ],
          "tuples": [
            {
              "rgb": "valid",
              "depth": "valid"
            },
            {
              "rgb": "ood",
              "depth": "ood"
            },
            {
              "rgb": "unavailable",
              "depth": "unavailable"
            }
          ],
          "complete": true
        }
      ],
      "expected": {
        "global_signatures": 3,
        "correlation_preserved": true
      }
    },
    {
