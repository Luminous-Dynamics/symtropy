{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transfer_forecast_cohort_v0.schema.json",
  "title": "ErgoStream transfer forecast cohort v0",
  "description": "Learner-authored probability forecasts for frozen scoped transfer claims. Contains no evaluator truth or hidden shift strata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "forecasts"
  ],
  "properties": {
    "schema_version": {
      "const": "ergo-transfer-forecast-cohort-v0"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "forecasts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_type",
          "claim_scope_sha256",
          "probability_transfer_ppm",
          "decision"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "structural_correspondence",
              "deterministic_dynamics",
              "simulation",
              "bisimulation",
              "mechanism_transfer"
            ]
          },
          "claim_scope_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "probability_transfer_ppm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "decision": {
            "enum": [
              "assert_transfer",
              "reject_transfer",
              "abstain"
            ]
          }
        }
      }
    }
  }
}
