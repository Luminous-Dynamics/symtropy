{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/split_conformal_transfer_receipt_v0.schema.json",
  "title": "Owner-issued split-conformal transfer receipt v0",
  "description": "Evaluator/episode-owner receipt binding a split-conformal transfer quantile to the frozen predictor, preprocessing, calibration cohort, stratum and claim scope. This is not learner-authored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "status",
    "issued_at",
    "model_frozen_at",
    "calibration_started_at",
    "predictor_sha256",
    "preprocessing_sha256",
    "score_function_sha256",
    "calibration_cohort_sha256",
    "sample_ids_sha256",
    "split_manifest_sha256",
    "evidence_prefix_sha256",
    "evaluation_stratum_id",
    "independent_unit_kind",
    "exchangeability_scope",
    "claim_type",
    "alpha_ppm",
    "calibration_count",
    "quantile_rank",
    "quantile_nonconformity_ppm",
    "tie_rule",
    "guarantee",
    "custody_receipt_id"
  ],
  "properties": {
    "schema_version": {
      "const": "ergo-split-conformal-transfer-receipt-v0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "revoked",
        "expired"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "model_frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "calibration_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "predictor_sha256": {
      "$ref": "#/$defs/digest"
    },
    "preprocessing_sha256": {
      "$ref": "#/$defs/digest"
    },
    "score_function_sha256": {
      "$ref": "#/$defs/digest"
    },
    "calibration_cohort_sha256": {
      "$ref": "#/$defs/digest"
    },
    "sample_ids_sha256": {
      "$ref": "#/$defs/digest"
    },
    "split_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "evidence_prefix_sha256": {
      "$ref": "#/$defs/digest"
    },
    "evaluation_stratum_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "independent_unit_kind": {
      "enum": [
        "world_seed",
        "episode",
        "campaign",
        "site",
        "asset",
        "other"
      ]
    },
    "independent_unit_count": {
      "type": "integer",
      "minimum": 1
    },
    "exchangeability_scope": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "structural_correspondence",
        "deterministic_dynamics",
        "simulation",
        "bisimulation",
        "mechanism_transfer"
      ]
    },
    "alpha_ppm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "calibration_count": {
      "type": "integer",
      "minimum": 1
    },
    "quantile_rank": {
      "type": "integer",
      "minimum": 1
    },
    "quantile_nonconformity_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "tie_rule": {
      "const": "include_when_score_lte_quantile"
    },
    "guarantee": {
      "const": "marginal_prediction_set_coverage_under_exchangeability_within_stratum"
    },
    "custody_receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "revocation_reason": {
      "type": "string",
      "minLength": 1
    },
    "claim_scope_sha256": {
      "$ref": "#/$defs/digest"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "revoked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "revocation_reason"
        ]
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
