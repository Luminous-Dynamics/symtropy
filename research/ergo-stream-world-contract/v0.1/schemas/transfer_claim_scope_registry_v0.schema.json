{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transfer_claim_scope_registry_v0.schema.json",
  "title": "ErgoStream transfer claim scope registry v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "ergo-transfer-claim-scope-registry-v0"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_scope",
          "claim_scope_sha256"
        ],
        "properties": {
          "claim_scope": {
            "$ref": "transfer_claim_scope_envelope_v0.schema.json"
          },
          "claim_scope_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
