{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/split_conformal_transfer_v0.schema.json",
  "title": "ErgoStream split-conformal binary transfer artifact v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "calibrator",
    "prediction_sets"
  ],
  "properties": {
    "schema_version": {
      "const": "ergo-split-conformal-transfer-v0"
    },
    "calibrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_stratum_id",
        "alpha_ppm",
        "calibration_count",
        "quantile_rank",
        "quantile_nonconformity_ppm"
      ],
      "properties": {
        "evaluation_stratum_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "alpha_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "calibration_count": {
          "type": "integer",
          "minimum": 1
        },
        "quantile_rank": {
          "type": "integer",
          "minimum": 1
        },
        "quantile_nonconformity_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "prediction_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "evaluation_stratum_id",
          "exchangeability_admitted",
          "include_transfer",
          "include_non_transfer",
          "decision"
        ],
        "properties": {
          "sample_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709552000
          },
          "include_transfer": {
            "type": "boolean"
          },
          "include_non_transfer": {
            "type": "boolean"
          },
          "decision": {
            "enum": [
              "assert_transfer",
              "reject_transfer",
              null
            ]
          },
          "evaluation_stratum_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "exchangeability_admitted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
