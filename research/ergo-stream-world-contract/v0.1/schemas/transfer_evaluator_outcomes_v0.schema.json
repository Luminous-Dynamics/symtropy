{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transfer_evaluator_outcomes_v0.schema.json",
  "title": "ErgoStream evaluator-owned transfer outcomes v0",
  "description": "Owner/evaluator-only truth and preregistered shift strata. Never include in learner-visible episode prefixes or candidate transfer bundles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cohort_id",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "ergo-transfer-evaluator-outcomes-v0"
    },
    "cohort_id": {
      "type": "string",
      "minLength": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "evaluation_stratum_id",
          "transfer_qualified"
        ],
        "properties": {
          "sample_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709552000
          },
          "evaluation_stratum_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "transfer_qualified": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
