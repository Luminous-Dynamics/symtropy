{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/av-sequential-acquisition-scorecard-v1.schema.json",
  "title":"Sequential AV Acquisition Scorecard v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","policy_id","run_id","interpretation","totals","per_episode"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"av-sequential-acquisition-v0"},
    "policy_id":{"type":["string","null"]},
    "run_id":{"type":["string","null"]},
    "interpretation":{"type":"object","additionalProperties":false,
      "required":["status","limitations"],
      "properties":{
        "status":{"const":"synthetic_finite_plan_audit"},
        "limitations":{"type":"array","items":{"type":"string"}}
      }
    },
    "totals":{"type":"object","additionalProperties":false,
      "required":["episode_count","oracle_action_set_matches","mean_expected_information_gain_bits","mean_gross_evsi_units","mean_net_evsi_units","mean_candidate_expected_objective_loss","mean_oracle_expected_objective_loss","mean_regret_vs_exact_nonadaptive_oracle","hard_violation_count"],
      "properties":{
        "episode_count":{"type":"integer","minimum":0},
        "oracle_action_set_matches":{"type":"integer","minimum":0},
        "mean_expected_information_gain_bits":{"type":["number","null"],"minimum":0},
        "mean_gross_evsi_units":{"type":["number","null"]},
        "mean_net_evsi_units":{"type":["number","null"]},
        "mean_candidate_expected_objective_loss":{"type":["number","null"],"minimum":0},
        "mean_oracle_expected_objective_loss":{"type":["number","null"],"minimum":0},
        "mean_regret_vs_exact_nonadaptive_oracle":{"type":["number","null"],"minimum":0},
        "hard_violation_count":{"type":"integer","minimum":0}
      }
    },
    "per_episode":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "required":["episode_id","scenario_family","selected_action_ids","decision","realized_decision_loss","realized_total_loss","expected_information_gain_bits","gross_evsi_units","net_evsi_units","candidate_expected_objective_loss","oracle_expected_objective_loss","oracle_action_ids","regret_vs_exact_nonadaptive_oracle","oracle_action_set_matched","response_tick","resource_usage"],
      "properties":{
        "episode_id":{"type":"string"},
        "scenario_family":{"type":"string"},
        "selected_action_ids":{"type":"array","items":{"type":"string"}},
        "decision":{"type":"string"},
        "realized_decision_loss":{"type":"number","minimum":0},
        "realized_total_loss":{"type":"number","minimum":0},
        "expected_information_gain_bits":{"type":"number","minimum":0},
        "gross_evsi_units":{"type":"number"},
        "net_evsi_units":{"type":"number"},
        "candidate_expected_objective_loss":{"type":"number","minimum":0},
        "oracle_expected_objective_loss":{"type":"number","minimum":0},
        "oracle_action_ids":{"type":"array","items":{"type":"string"}},
        "regret_vs_exact_nonadaptive_oracle":{"type":"number","minimum":0},
        "oracle_action_set_matched":{"type":"boolean"},
        "response_tick":{"type":"integer","minimum":0},
        "resource_usage":{"type":"object","additionalProperties":false,
          "required":["acquisition_cost_units","audio_bytes","video_frames","input_tokens","energy_joules"],
          "properties":{
            "acquisition_cost_units":{"type":"number","minimum":0},
            "audio_bytes":{"type":"integer","minimum":0},
            "video_frames":{"type":"integer","minimum":0},
            "input_tokens":{"type":"integer","minimum":0},
            "energy_joules":{"type":"number","minimum":0}
          }
        }
      }
    }}
  }
}