{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/av-sequential-acquisition-workload-v1.schema.json",
  "title":"Sequential AV Acquisition Workload v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","description","episodes"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"av-sequential-acquisition-v0"},
    "description":{"type":"string"},
    "episodes":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/episode"}}
  },
  "$defs":{
    "action":{
      "type":"object","additionalProperties":false,
      "required":["action_id","modality","permissions_required","acquisition_cost_units","duration_ticks","audio_bytes","video_frames","input_tokens","energy_joules","outcomes"],
      "properties":{
        "action_id":{"type":"string","minLength":1},
        "modality":{"enum":["audio","video","audio_video"]},
        "permissions_required":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "acquisition_cost_units":{"type":"number","minimum":0},
        "duration_ticks":{"type":"integer","minimum":1},
        "audio_bytes":{"type":"integer","minimum":0},
        "video_frames":{"type":"integer","minimum":0},
        "input_tokens":{"type":"integer","minimum":0},
        "energy_joules":{"type":"number","minimum":0},
        "outcomes":{"type":"array","minItems":2,"items":{
          "type":"object","additionalProperties":false,
          "required":["outcome_id","likelihood_by_state"],
          "properties":{
            "outcome_id":{"type":"string","minLength":1},
            "likelihood_by_state":{"type":"object","minProperties":2,"additionalProperties":{"type":"number","minimum":0,"maximum":1}}
          }
        }}
      }
    },
    "episode":{
      "type":"object","additionalProperties":false,
      "required":["episode_id","scenario_family","prior_by_state","decision_loss_by_state","actions","granted_permissions","deadline_tick","budget"],
      "properties":{
        "episode_id":{"type":"string","minLength":1},
        "scenario_family":{"enum":["eig_trap","sequential_complementarity","deadline_inversion","permission_fallback"]},
        "prior_by_state":{"type":"object","minProperties":2,"additionalProperties":{"type":"number","minimum":0,"maximum":1}},
        "decision_loss_by_state":{"type":"object","minProperties":2,"additionalProperties":{"type":"object","additionalProperties":{"type":"number","minimum":0}}},
        "actions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/action"}},
        "granted_permissions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "deadline_tick":{"type":"integer","minimum":1},
        "budget":{"type":"object","additionalProperties":false,
          "required":["max_acquisition_cost_units","max_audio_bytes","max_video_frames","max_input_tokens","max_energy_joules"],
          "properties":{
            "max_acquisition_cost_units":{"type":"number","minimum":0},
            "max_audio_bytes":{"type":"integer","minimum":0},
            "max_video_frames":{"type":"integer","minimum":0},
            "max_input_tokens":{"type":"integer","minimum":0},
            "max_energy_joules":{"type":"number","minimum":0}
          }
        }
      }
    }
  }
}