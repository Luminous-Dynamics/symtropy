{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/construction-design-manifest-v0.1.schema.json",
  "title": "Normalized Construction Design Manifest V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "site_id",
    "work_package_id",
    "model_digest",
    "design_revision",
    "target_frame_id",
    "site_epoch",
    "elements"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "work_package_id": {
      "type": "string",
      "minLength": 1
    },
    "model_digest": {
      "type": "string",
      "minLength": 1
    },
    "design_revision": {
      "type": "string",
      "minLength": 1
    },
    "target_frame_id": {
      "type": "string",
      "minLength": 1
    },
    "site_epoch": {
      "type": "string",
      "minLength": 1
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/design_element"
      }
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "source_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "design_element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "task_family",
        "properties"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "task_family": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        }
      }
    }
  }
}
