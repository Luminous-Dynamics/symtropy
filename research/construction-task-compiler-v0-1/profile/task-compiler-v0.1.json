    "oracle_agreement": 1,
    "implicit_unit_or_frame_inference": 0,
    "cyclic_graphs_admitted": 0
  },
  "claim_ceiling": "The v0.1 validator checks structure and lineage in a normalized synthetic work graph. It does not authenticate authorities, parse arbitrary IFC, approve methods, establish capability, prove physical feasibility, grant motion/safety authority or accept physical construction output.",
