    "graph_identity_fields": [
      "project_id",
      "site_id",
      "work_package_id",
      "model_digest",
      "design_revision",
      "target_frame_id",
      "site_epoch",
      "method_template_id",
      "method_revision_digest",
      "compiler_version",
      "rule_set_digest"
    ],
    "canonical_encoding": {
      "format": "CTG-V0.1",
      "domain_separator": "CTG\\0v1",
      "string_encoding": "UTF-8 with unsigned 64-bit little-endian byte length prefix",
      "option_encoding": "one-byte tag (0 none, 1 some) followed by encoded string for some",
