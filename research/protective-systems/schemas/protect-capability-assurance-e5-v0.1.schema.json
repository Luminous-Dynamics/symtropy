{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/protect-capability-assurance-e5-v0.1.schema.json",
  "title": "Protective Systems E5 Capability Assurance Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "as_of",
    "assets",
    "claims",
    "evidence",
    "changes",
    "actions",
    "oracle_expected"
  ],
  "properties": {
    "schema_version": {
      "const": "protect-capability-assurance-e5/0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "CAPABILITY_ASSURANCE_AND_REQUALIFICATION_PLAN_ONLY"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "configuration_digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "configuration_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "previous_status",
          "depends_on_assets",
          "depends_on_claims",
          "evidence_ids",
          "required_methods",
          "minimum_independence",
          "mandatory_safety_floor"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "previous_status": {
            "const": "QUALIFIED"
          },
          "depends_on_assets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "depends_on_claims": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "required_methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "minimum_independence": {
            "enum": [
              "SELF_REPORTED",
              "WITNESSED",
              "INDEPENDENT"
            ]
          },
          "mandatory_safety_floor": {
            "const": true
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "asset_id",
          "configuration_digest",
          "valid_from",
          "valid_until",
          "valid_until_exclusive",
          "source_class",
          "claim_ceiling"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "VALID",
              "EXPIRED",
              "SUPERSEDED",
              "CONFLICTED",
              "UNKNOWN",
              "REVOKED",
              "NOT_EXECUTED",
              "NOT_APPLICABLE"
            ]
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "configuration_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          },
          "valid_until_exclusive": {
            "const": true
          },
          "source_class": {
            "type": "string",
            "minLength": 1
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "event_type",
          "occurred_at",
          "asset_id",
          "evidence_id",
          "from_digest",
          "to_digest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "enum": [
              "ASSET_CONFIGURATION_CHANGED",
              "EVIDENCE_VALIDITY_BOUNDARY_REACHED"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "asset_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "from_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "to_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "covers_claim_ids",
          "methods",
          "independence",
          "cost_cents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "covers_claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "independence": {
            "enum": [
              "SELF_REPORTED",
              "WITNESSED",
              "INDEPENDENT"
            ]
          },
          "cost_cents": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "oracle_expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "affected_claim_ids",
        "qualified_claim_ids",
        "evidence_states",
        "selected_action_ids",
        "selected_cost_cents"
      ],
      "properties": {
        "affected_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualified_claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_states": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "VALID",
              "EXPIRED",
              "SUPERSEDED",
              "CONFLICTED",
              "UNKNOWN",
              "REVOKED",
              "NOT_EXECUTED",
              "NOT_APPLICABLE"
            ]
          }
        },
        "selected_action_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selected_cost_cents": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
