{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/protective-multiprovider-fixture-manifest-v0.1.schema.json",
  "title": "Protective Systems E3 Multi-provider Fixture Manifest",
  "description": "Synthetic-only manifest pinning native DataCite, OGC API - Records and OpenLineage source fixture bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "source_e1_context",
    "sources",
    "validation_assets"
  ],
  "properties": {
    "schema_version": {
      "const": "protective-multiprovider-fixture-manifest/0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "MULTI_PROVIDER_METADATA_PORTABILITY_ONLY"
    },
    "source_e1_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "execution_status",
        "relationship",
        "relative_path",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_status": {
          "const": "NOT_EXECUTED"
        },
        "relationship": {
          "const": "CONTEXT_ONLY_NOT_A_RUN"
        },
        "relative_path": {
          "const": "context/e1-envelope-context.json"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "relative_path",
          "native_profile",
          "source_identity",
          "retrieval_mode",
          "rights_status",
          "permitted_use",
          "claim_ceiling",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "provider": {
            "enum": [
              "DATACITE",
              "OGC_API_RECORDS",
              "OPENLINEAGE"
            ]
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "native_profile": {
            "type": "string",
            "minLength": 1
          },
          "source_identity": {
            "type": "string",
            "minLength": 1
          },
          "retrieval_mode": {
            "const": "SYNTHETIC_STATIC_FIXTURE"
          },
          "rights_status": {
            "const": "SYNTHETIC_OPEN_FIXTURE"
          },
          "permitted_use": {
            "const": "SYNTHETIC_TEST_ONLY"
          },
          "claim_ceiling": {
            "const": "MULTI_PROVIDER_METADATA_PORTABILITY_ONLY"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "validation_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "relative_path",
          "schema_id",
          "source_repository",
          "source_blob_sha",
          "byte_length",
          "sha256"
        ],
        "properties": {
          "provider": {
            "const": "OPENLINEAGE"
          },
          "relative_path": {
            "const": "schemas/openlineage-2.0.2.schema.json"
          },
          "schema_id": {
            "const": "https://openlineage.io/spec/2-0-2/OpenLineage.json"
          },
          "source_repository": {
            "const": "OpenLineage/OpenLineage"
          },
          "source_blob_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
