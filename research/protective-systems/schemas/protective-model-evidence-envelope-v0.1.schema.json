{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/protective-systems/schemas/protective-model-evidence-envelope-v0.1.schema.json",
  "title": "Protective Model Evidence Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "intended_use",
    "source",
    "analysis",
    "scope",
    "datasets",
    "lineage_edges",
    "uncertainty",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "protective-model-evidence-envelope/0.1"
    },
    "evidence_class": {
      "enum": [
        "synthetic",
        "external_observed"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "datasets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "lineage_edges": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    },
    "claim_ceiling": {
      "enum": [
        "SYNTHETIC_ENVELOPE_AND_ARTIFACT_INTEGRITY_ONLY",
        "EXTERNAL_MODEL_METADATA_AND_ARTIFACT_INTEGRITY_ONLY"
      ]
    },
    "intended_use": {
      "enum": [
        "SYNTHETIC_TEST_ONLY",
        "INTEROPERABILITY_EVALUATION",
        "RESEARCH_EVALUATION",
        "PUBLICATION_REVIEW"
      ]
    }
  },
  "$defs": {
    "versionField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value"
      ],
      "properties": {
        "status": {
          "enum": [
            "KNOWN",
            "UNKNOWN"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "platform_name",
        "provider_kind",
        "software_version",
        "documentation_uri"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "platform_name": {
          "type": "string",
          "minLength": 1
        },
        "provider_kind": {
          "enum": [
            "EXTERNAL_MODEL",
            "SYNTHETIC_FIXTURE"
          ]
        },
        "software_version": {
          "$ref": "#/$defs/versionField"
        },
        "documentation_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "run_id",
        "execution_status",
        "started_at",
        "completed_at"
      ],
      "properties": {
        "analysis_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "execution_status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "NOT_EXECUTED",
            "UNKNOWN"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_id",
        "jurisdiction",
        "system_boundary_id",
        "scenario_id",
        "scenario_basis",
        "time_horizon",
        "coordinate_reference"
      ],
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_basis": {
          "type": "string",
          "minLength": 1
        },
        "time_horizon": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference": {
          "$ref": "#/$defs/versionField"
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "license_id",
        "permitted_use"
      ],
      "properties": {
        "status": {
          "enum": [
            "LICENSED",
            "SYNTHETIC_OPEN_FIXTURE",
            "UNKNOWN",
            "RESTRICTED"
          ]
        },
        "license_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "permitted_use": {
          "enum": [
            "SYNTHETIC_TEST_ONLY",
            "INTEROPERABILITY_EVALUATION",
            "RESEARCH_EVALUATION",
            "PUBLICATION_REVIEW"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "relative_path",
        "provider_file_id",
        "file_name",
        "media_type",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "DATASET_METADATA",
            "FILE_METADATA",
            "DATA_PAYLOAD"
          ]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "provider_file_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "direction",
        "data_type",
        "semantic_type",
        "revision",
        "rights",
        "units",
        "coordinate_reference",
        "artifacts"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "INPUT",
            "OUTPUT"
          ]
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "semantic_type": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "$ref": "#/$defs/versionField"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_reference": {
          "$ref": "#/$defs/versionField"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "relationship"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "CONSUMED_BY",
            "PRODUCED_BY"
          ]
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "representation",
        "method_id",
        "calibration_reference"
      ],
      "properties": {
        "status": {
          "enum": [
            "REPRESENTED",
            "NOT_REPRESENTED",
            "UNKNOWN"
          ]
        },
        "representation": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibration_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
