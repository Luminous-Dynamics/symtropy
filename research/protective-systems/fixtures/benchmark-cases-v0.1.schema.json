{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protective Systems synthetic benchmark corpus v0.1",
  "description": "Structural schema for synthetic record-conformance fixtures. Passing this schema does not establish physical performance, test validity, certification, or safety.",
  "type": "object",
  "required": [
    "schema_version",
    "frozen_at",
    "evidence_class",
    "intended_use",
    "decisions",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "protective-systems-fixtures/0.1"
    },
    "frozen_at": {
      "type": "string",
      "format": "date"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACCEPT_RECORD_ONLY",
          "REJECT_SCOPE",
          "REJECT_STALE_OR_REVOKED",
          "REJECT_MISSING_OR_INVALID",
          "ABSTAIN_UNKNOWN",
          "REQUIRE_INDEPENDENT_REVIEW"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "domain",
        "fixture_class",
        "subject",
        "claim",
        "standard",
        "evidence",
        "expected_decision",
        "rationale"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "human_worn",
            "vehicle",
            "housing",
            "cross_domain"
          ]
        },
        "fixture_class": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "object",
          "required": [
            "id",
            "configuration_revision"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "configuration_revision": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "claim": {
          "type": "object",
          "required": [
            "proposition",
            "performance_claim_permitted"
          ],
          "properties": {
            "proposition": {
              "type": "string",
              "minLength": 1
            },
            "performance_claim_permitted": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "standard": {
          "type": "object",
          "required": [
            "id",
            "addenda",
            "currentness",
            "scope"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "addenda": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "currentness": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "evidence": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "expected_decision": {
          "enum": [
            "ACCEPT_RECORD_ONLY",
            "REJECT_SCOPE",
            "REJECT_STALE_OR_REVOKED",
            "REJECT_MISSING_OR_INVALID",
            "ABSTAIN_UNKNOWN",
            "REQUIRE_INDEPENDENT_REVIEW"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
