{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/rrvr/safety-case-interoperability-v0.1.schema.json",
  "title": "RRVR Safety-Case Interoperability Register v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checked_on",
    "claim_ceiling",
    "standards",
    "evidence_owners"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "checked_on": {
      "type": "string",
      "format": "date"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "kind",
          "scope",
          "rrvr_relevance",
          "claim_limit",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "rrvr_relevance": {
            "type": "string",
            "minLength": 1
          },
          "claim_limit": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "monitor_url": {
            "type": "string",
            "format": "uri"
          },
          "successor_url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "evidence_owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "references",
          "evidence_tier",
          "supports",
          "does_not_support"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_tier": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "string",
            "minLength": 1
          },
          "does_not_support": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
