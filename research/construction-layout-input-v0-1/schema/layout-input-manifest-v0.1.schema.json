{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:construction-layout-input:0.1",
  "title": "Construction Layout Input Manifest",
  "description": "Closed input manifest for a pre-print design, export, frame, inventory and survey-checkpoint admission evaluation. Decisions are not supplied by the manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "project_id",
    "source_model",
    "export",
    "site_binding",
    "coordinate_frame",
    "inventory",
    "control_validation"
  ],
  "properties": {
    "schema_version": {
      "const": "construction-layout-input/0.1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision",
        "sha256",
        "approval_reference",
        "discipline_revisions",
        "feature_ids"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "discipline_revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discipline_id",
              "revision"
            ],
            "properties": {
              "discipline_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "feature_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_model_revision",
        "export_id",
        "sha256",
        "exporter_id",
        "exporter_version",
        "exporter_config_sha256",
        "discipline_revisions",
        "feature_ids"
      ],
      "properties": {
        "source_model_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "export_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exporter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "exporter_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "exporter_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "discipline_revisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "discipline_id",
              "revision"
            ],
            "properties": {
              "discipline_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "feature_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "site_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "task_scope",
        "work_package_revision",
        "work_zone_id",
        "worksite_epoch_sha256",
        "approved_change_sequence"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "work_package_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "work_zone_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "worksite_epoch_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_change_sequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_frame_id",
        "target_frame_id",
        "horizontal_reference",
        "vertical_datum",
        "coordinate_epoch",
        "units",
        "axis_order",
        "handedness",
        "transform_bundle_sha256",
        "transform_resource_sha256s"
      ],
      "properties": {
        "source_frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "target_frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "horizontal_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "vertical_datum": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "coordinate_epoch": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "axis_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x",
              "y",
              "z",
              "east",
              "north",
              "up",
              "easting",
              "northing",
              "height"
            ]
          }
        },
        "handedness": {
          "enum": [
            "right_handed",
            "left_handed"
          ]
        },
        "transform_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transform_resource_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_feature_ids",
        "exported_feature_ids",
        "declared_excluded_feature_ids"
      ],
      "properties": {
        "expected_feature_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "exported_feature_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "declared_excluded_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "control_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey_result_reference",
        "survey_result_sha256",
        "survey_adjustment_reference",
        "survey_adjustment_sha256",
        "fit_point_ids",
        "independent_check_points"
      ],
      "properties": {
        "survey_result_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "survey_result_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "survey_adjustment_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "survey_adjustment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fit_point_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "independent_check_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "point_id",
              "coordinate_frame_id",
              "x_m",
              "y_m",
              "residual_x_mm",
              "residual_y_mm",
              "u95_mm",
              "independence_status",
              "independence_assessment_reference"
            ],
            "properties": {
              "point_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "coordinate_frame_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "x_m": {
                "type": "number"
              },
              "y_m": {
                "type": "number"
              },
              "residual_x_mm": {
                "type": "number"
              },
              "residual_y_mm": {
                "type": "number"
              },
              "u95_mm": {
                "type": "number",
                "minimum": 0
              },
              "independence_status": {
                "enum": [
                  "independent_under_profile",
                  "same_evidence_path",
                  "known_common_mode",
                  "dependence_indeterminate",
                  "not_assessed"
                ]
              },
              "independence_assessment_reference": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      }
    }
  }
}
