{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/construction/material-readiness/v0.1",
  "title": "Construction Material Readiness Fixture",
  "type": "object",
  "required": ["profile_id", "profile_version", "binding", "requirements", "lot_projections", "allocations"],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "profile_version": {"const": "0.1"},
    "binding": {
      "type": "object",
      "required": ["project_id", "floor_id", "work_package_id", "task_id", "design_revision_digest", "site_epoch", "requirement_revision_digest", "receiving_entity_id", "target_location_id", "required_window_start_ms", "required_window_end_ms"],
      "properties": {
        "project_id": {"type": "string", "minLength": 1},
        "floor_id": {"type": "string", "minLength": 1},
        "work_package_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "design_revision_digest": {"type": "string", "minLength": 1},
        "site_epoch": {"type": "string", "minLength": 1},
        "requirement_revision_digest": {"type": "string", "minLength": 1},
        "receiving_entity_id": {"type": "string", "minLength": 1},
        "target_location_id": {"type": "string", "minLength": 1},
        "required_window_start_ms": {"type": "integer", "minimum": 0},
        "required_window_end_ms": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "lot_projections": {"type": "array", "items": {"type": "object"}},
    "allocations": {"type": "array", "items": {"type": "object"}},
    "as_of_ms": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
