{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transformer-region-profile-1.0.0.json",
  "title": "Transformer region and utility qualification profile",
  "description": "Versioned jurisdiction/owner context for transformer engineering. A valid JSON instance is not itself a compliance approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "jurisdiction",
    "owner",
    "applicability",
    "documents",
    "loss_evaluation",
    "economic_basis",
    "reviewers",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,100}$"
    },
    "status": {
      "enum": [
        "DRAFT",
        "VERIFIED",
        "EXPIRED",
        "CONFLICTING"
      ]
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "region_name"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code, or an explicitly documented supranational namespace such as EU."
        },
        "region_name": {
          "type": "string",
          "minLength": 1
        },
        "subdivision_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_timezone": {
          "type": [
            "string",
            "null"
          ],
          "description": "IANA timezone; this does not replace UTC timestamps in source traces."
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_type",
        "name"
      ],
      "properties": {
        "owner_type": {
          "enum": [
            "UTILITY",
            "REGULATOR",
            "PROCUREMENT_AUTHORITY",
            "CUSTOMER",
            "RESEARCH_PROFILE"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "asset_or_tender_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformer_classes",
        "technologies",
        "frequency_hz",
        "voltage_scope_v",
        "rated_power_scope_va"
      ],
      "properties": {
        "transformer_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "technologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "LIQUID_IMMERSED",
              "DRY_TYPE",
              "OTHER_EXPLICIT"
            ]
          },
          "uniqueItems": true
        },
        "frequency_hz": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uniqueItems": true
        },
        "voltage_scope_v": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable, reviewed scope; do not infer a voltage range from country alone."
        },
        "rated_power_scope_va": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable, reviewed scope."
        },
        "environmental_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "excluded_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "title",
          "authority",
          "canonical_url",
          "edition",
          "publication_date",
          "effective_from",
          "checked_at",
          "verification_status",
          "source_sha256",
          "applicability_notes"
        ],
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "canonical_url": {
            "type": "string",
            "format": "uri"
          },
          "edition": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          },
          "verification_status": {
            "enum": [
              "UNVERIFIED",
              "CURRENT_VERIFIED",
              "EXPIRED",
              "CONFLICTING"
            ]
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "applicability_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "loss_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_id",
        "load_point_convention",
        "reference_conditions",
        "notes"
      ],
      "properties": {
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "load_point_convention": {
          "type": "string",
          "minLength": 1
        },
        "reference_conditions": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "economic_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency_code",
        "price_basis",
        "price_year",
        "fx_policy"
      ],
      "properties": {
        "currency_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency; null means not specified, never zero."
        },
        "price_basis": {
          "enum": [
            "REAL",
            "NOMINAL",
            "UNKNOWN"
          ]
        },
        "price_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2200
        },
        "fx_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "organization",
          "reviewed_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date"
          },
          "review_scope": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "documents": {
            "minItems": 1,
            "items": {
              "properties": {
                "edition": {
                  "type": "string",
                  "minLength": 1
                },
                "publication_date": {
                  "type": "string",
                  "format": "date"
                },
                "effective_from": {
                  "type": "string",
                  "format": "date"
                },
                "verification_status": {
                  "const": "CURRENT_VERIFIED"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          },
          "reviewers": {
            "minItems": 2
          }
        }
      }
    }
  ]
}
