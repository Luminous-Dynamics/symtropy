  "comparison_protocol": [
    "Freeze model/firmware/payload/calibration/documentation revision.",
    "Match geometry, route length, occupancy, environment, access and seeded defects.",
    "Use independent physical ground truth and preregister acceptance tolerances.",
    "Include setup, cleaning, calibration, charging, retrieval, maintenance, human review and failed/aborted trials.",
    "Separate vendor claims from independent measurements.",
    "Compare accepted outputs and complete workflow cost, not nominal speed.",
    "Keep sewer, cable microduct, water pipe, walkable tunnel and utility corridor populations separate."
  ],
  "luminous_research_targets": [
    "At least three vendor/tool classes integrated through vendor-neutral evidence interfaces.",
    "Zero false clearances in the frozen synthetic hostile corpus.",
    "100% traceability for counted pilot assets and independently accepted repairs.",
    "Zero unauthorized disclosure in the finite restricted-geometry access-control corpus.",
    "At least 25% lower active-sensing dwell at non-inferior localization task performance, after matched testing.",
    "Prove economic or service superiority against the best eligible local baseline in at least one real site stratum before claiming it."
  ]
}
