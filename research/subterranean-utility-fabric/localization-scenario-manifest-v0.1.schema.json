{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/subterranean-utility-fabric-v0-1/research/subterranean-utility-fabric/localization-scenario-manifest-v0.1.schema.json",
  "title": "SUF Localization Scenario Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "created_date",
    "claim_ceiling",
    "evaluation_scope",
    "method_families",
    "metrics",
    "scenarios",
    "global_controls",
    "data_rights",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": "suf.localization_manifest.v0.1"
    },
    "status": {
      "enum": [
        "campaign_plan_only",
        "synthetic_fixture",
        "laboratory_profile",
        "field_profile"
      ]
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 30
    },
    "evaluation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "state_dimension",
        "unit",
        "paper_comparison_threshold_m",
        "task_tolerance_policy",
        "ground_truth"
      ],
      "properties": {
        "population": {
          "enum": [
            "synthetic_1d_only",
            "sewer_paper_reproduction",
            "non_energized_cable_duct_lab",
            "supervised_field"
          ]
        },
        "state_dimension": {
          "enum": [
            "chainage_1d",
            "pose_2d",
            "pose_3d"
          ]
        },
        "unit": {
          "const": "metre"
        },
        "paper_comparison_threshold_m": {
          "const": 0.5
        },
        "task_tolerance_policy": {
          "const": "freeze_per_application_before_evaluation; never infer from the paper threshold"
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "independence",
            "uncertainty_required"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 5
            },
            "independence": {
              "type": "string",
              "minLength": 10
            },
            "uncertainty_required": {
              "const": true
            }
          }
        }
      }
    },
    "method_families": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TETHER_WHEEL",
          "WHEEL_IMU",
          "VISION_ONLY",
          "ACOUSTIC_DIRECT_ONLY",
          "ACOUSTIC_FEATURE_BASELINE",
          "ACOUSTIC_VISUAL_PF",
          "ACOUSTIC_VISUAL_PGO",
          "MULTIMODAL_TOPOLOGY_AIDED"
        ]
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "profile_population",
          "sensor_conditions",
          "perturbations",
          "ground_truth_kind",
          "expected_disposition",
          "oracle_requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LOC-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 4
          },
          "profile_population": {
            "enum": [
              "synthetic_1d_only",
              "sewer_transfer_reference",
              "cable_duct_target_profile"
            ]
          },
          "sensor_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "vision",
                "acoustic",
                "imu",
                "wheel_odometry",
                "tether_encoder",
                "route_anchor"
              ]
            }
          },
          "perturbations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "ground_truth_kind": {
            "enum": [
              "analytic_exact",
              "independent_fixture_metrology",
              "surveyed_anchor_and_chainage",
              "unavailable"
            ]
          },
          "expected_disposition": {
            "enum": [
              "Accepted",
              "Rejected",
              "Indeterminate",
              "Unsupported"
            ]
          },
          "oracle_requirement": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "global_controls": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "data_rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_data_status",
        "redistribution_status",
        "required_action"
      ],
      "properties": {
        "paper_data_status": {
          "enum": [
            "not_requested",
            "request_required",
            "received_under_terms",
            "unavailable"
          ]
        },
        "redistribution_status": {
          "enum": [
            "not_authorized",
            "authorized_under_recorded_terms",
            "not_applicable"
          ]
        },
        "required_action": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "enum": [
              "research_baseline",
              "standardization_roadmap",
              "subsurface_evidence_guidance",
              "existing_luminous_owner"
            ]
          }
        }
      }
    }
  }
}
