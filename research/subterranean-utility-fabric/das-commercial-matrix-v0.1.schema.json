{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUF DAS commercial comparator matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_date",
    "status",
    "claim_ceiling",
    "comparators",
    "matched_metrics",
    "luminous_position"
  ],
  "properties": {
    "schema_version": {
      "const": "suf.das_commercial_matrix.v0.1"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "comparators": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "capabilities",
          "evidence_type",
          "source",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "vendor_claims": {
            "type": "object"
          },
          "reported_literature_trends": {
            "type": "object"
          },
          "evidence_type": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "matched_metrics": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "luminous_position": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    }
  }
}
