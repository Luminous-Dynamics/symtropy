{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/subterranean-utility-fabric-v0-1/research/subterranean-utility-fabric/fibre-chainage-calibration-manifest-v0.1.schema.json",
  "title": "SUF fibre chainage calibration scenario manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "created_date",
    "claim_ceiling",
    "coordinate_axes",
    "scenarios",
    "global_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "suf.fibre_chainage_calibration_manifest.v0.1"
    },
    "status": {
      "const": "synthetic_campaign_plan_only"
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    },
    "coordinate_axes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "optical_range_m",
          "physical_fibre_chainage_m",
          "route_station_m",
          "geographic_position",
          "asset_attribution"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario_type",
          "name",
          "expected_disposition",
          "conditions",
          "perturbations",
          "oracle_requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FCAL-[0-9]{3}$"
          },
          "scenario_type": {
            "type": "string",
            "minLength": 3
          },
          "name": {
            "type": "string",
            "minLength": 5
          },
          "expected_disposition": {
            "enum": [
              "Accepted",
              "Rejected",
              "Indeterminate",
              "Unsupported"
            ]
          },
          "conditions": {
            "type": "string",
            "minLength": 10
          },
          "perturbations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "oracle_requirement": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "global_controls": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
