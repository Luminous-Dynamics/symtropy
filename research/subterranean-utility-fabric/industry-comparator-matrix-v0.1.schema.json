{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/subterranean-utility-fabric-v0-1/research/subterranean-utility-fabric/industry-comparator-matrix-v0.1.schema.json",
  "title": "SUF industry comparator matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_date",
    "status",
    "claim_ceiling",
    "comparators",
    "comparison_protocol",
    "luminous_research_targets"
  ],
  "properties": {
    "schema_version": {
      "const": "suf.industry_comparator_matrix.v0.1"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "comparators": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "population",
          "capabilities",
          "evidence_type",
          "source_urls",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "population": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reported_specs": {
            "type": "object"
          },
          "evidence_type": {
            "enum": [
              "manufacturer_reported",
              "manufacturer_case_study",
              "industry_practice",
              "industry_standard",
              "published_specification",
              "standardization_reference",
              "approved_conceptual_standard"
            ]
          },
          "source_urls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "comparison_protocol": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "luminous_research_targets": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    }
  }
}
