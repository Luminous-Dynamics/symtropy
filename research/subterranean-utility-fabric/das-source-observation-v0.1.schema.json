            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "interrogator_config_revision": {
          "type": "string",
          "minLength": 2
        },
        "optical_path_id": {
          "type": "string",
          "minLength": 2
        },
        "sample_rate_hz": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "gauge_length_m": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "channel_pitch_m": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "declared_spatial_resolution_m": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        }
      }
    },
    "observed_property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "phenomenon",
        "unit",
        "quantity_semantics"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "format": "uri"
        },
        "phenomenon": {
          "enum": [
            "axial_strain",
            "strain_rate",
            "phase",
            "amplitude",
            "temperature",
            "electrical_current",
            "other"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "quantity_semantics": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenomenon_start",
        "phenomenon_end",
        "result_time",
        "clock_source",
        "synchronization_state",
        "max_clock_offset_ms"
      ],
      "properties": {
        "phenomenon_start": {
          "type": "string",
          "format": "date-time"
        },
        "phenomenon_end": {
          "type": "string",
          "format": "date-time"
        },
        "result_time": {
          "type": "string",
          "format": "date-time"
        },
        "clock_source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "synchronization_state": {
          "enum": [
            "synchronized",
            "bounded_offset",
            "unsynchronized",
            "unknown"
          ]
        },
        "max_clock_offset_ms": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "spatial_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis_kind",
        "unit",
        "start",
        "step",
        "sample_count",
        "direction"
      ],
      "properties": {
        "axis_kind": {
          "enum": [
            "optical_range",
            "vendor_channel_index",
            "physical_fibre_chainage"
          ]
        },
        "unit": {
          "enum": [
            "m",
            "channel_index"
          ]
        },
        "start": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "direction": {
          "enum": [
            "endpoint_a_to_b",
            "endpoint_b_to_a",
            "vendor_defined",
            "unknown"
          ]
        },
        "calibration_reference": {
          "type": "string",
          "minLength": 3
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "axis_kind": {
                "const": "optical_range"
              }
            },
            "required": [
              "axis_kind"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "m"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "axis_kind": {
                "const": "vendor_channel_index"
              }
            },
            "required": [
              "axis_kind"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "channel_index"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "axis_kind": {
                "const": "physical_fibre_chainage"
              }
            },
            "required": [
              "axis_kind"
            ]
          },
          "then": {
            "required": [
              "calibration_reference"
            ],
            "properties": {
              "unit": {
                "const": "m"
              }
            }
          }
        }
      ]
    },
    "fibre_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_state",
        "fibre_id",
        "fibre_revision",
        "endpoint_from_id",
        "endpoint_to_id",
        "route_revision"
      ],
      "properties": {
        "identity_state": {
          "enum": [
            "identified",
            "unresolved",
            "withheld"
          ]
        },
        "fibre_id": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "fibre_revision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "endpoint_from_id": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "endpoint_to_id": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "route_revision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity_state": {
                "const": "identified"
              }
            },
            "required": [
              "identity_state"
            ]
          },
          "then": {
            "properties": {
              "fibre_id": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "present"
                  }
                },
                "required": [
                  "state",
                  "value"
                ]
              },
              "fibre_revision": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "present"
                  }
                },
                "required": [
                  "state",
                  "value"
                ]
              },
              "endpoint_from_id": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "present"
                  }
                },
                "required": [
                  "state",
                  "value"
                ]
              },
              "endpoint_to_id": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "present"
                  }
                },
                "required": [
                  "state",
                  "value"
                ]
              }
            }
          }
        }
      ]
