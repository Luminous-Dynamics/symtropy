    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "method_id",
        "method_revision",
        "parent_artifact_sha256"
      ],
      "properties": {
        "stage": {
          "enum": [
            "raw_vendor_native",
            "normalized_derivative",
            "processed_derivative",
            "feature_derivative"
          ]
        },
        "method_id": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "method_revision": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "value"
              ],
              "properties": {
                "state": {
                  "const": "present"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "unavailable",
                    "withheld",
                    "unknown",
                    "not_applicable"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          ]
        },
        "parent_artifact_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "raw_vendor_native"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "parent_artifact_sha256": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "enum": [
                  "normalized_derivative",
                  "processed_derivative",
                  "feature_derivative"
                ]
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "parent_artifact_sha256": {
                "minItems": 1
              }
            },
            "required": [
              "parameters_sha256"
            ]
          }
        }
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epistemic_state",
        "availability_state",
        "quality_state",
        "coverage_state",
        "review_state"
      ],
      "properties": {
        "epistemic_state": {
          "enum": [
            "observed",
            "compiled_secondary",
            "model_inference",
            "scenario_assumption",
            "unknown"
          ]
        },
        "availability_state": {
          "enum": [
            "available",
            "unobserved",
            "unavailable",
            "withheld",
            "stale"
          ]
        },
        "quality_state": {
          "enum": [
            "valid",
            "degraded",
            "invalid",
            "conflicting",
            "unsupported"
          ]
        },
        "coverage_state": {
          "enum": [
            "observable",
            "degraded",
            "unobserved",
            "unusable",
            "unavailable",
            "not_assessed",
            "unknown"
          ]
        },
        "review_state": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "indeterminate"
          ]
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_state",
        "permitted_purposes",
        "custodian"
      ],
      "properties": {
        "rights_state": {
          "enum": [
            "permitted",
            "permission_required",
            "restricted",
            "withheld",
