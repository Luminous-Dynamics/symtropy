{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/subterranean-utility-fabric-v0-1/research/subterranean-utility-fabric/das-source-observation-v0.1.schema.json",
  "title": "SUF vendor-neutral DAS source-observation envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "claim_ceiling",
    "observation_id",
    "source_artifact",
    "sensor",
    "observed_property",
    "time",
    "spatial_axis",
    "fibre_reference",
    "processing",
    "quality",
    "rights",
    "disclosure"
  ],
  "properties": {
    "schema_version": {
      "const": "suf.das.source_observation.v0.1"
    },
    "status": {
      "const": "metadata_envelope_only"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    },
    "observation_id": {
      "type": "string",
      "minLength": 3
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_uri",
        "media_type",
        "byte_length",
        "sha256",
        "binding_state"
      ],
      "properties": {
        "artifact_uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string",
          "minLength": 3
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "binding_state": {
          "enum": [
            "digest_verified_for_acquired_bytes",
            "scenario_assumption",
            "not_yet_acquired"
          ]
        },
        "source_native": {
          "type": "boolean"
        }
      }
    },
