{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/subterranean-utility-fabric-v0-1/research/subterranean-utility-fabric/superlet-traffic-repro-manifest-v0.1.schema.json",
  "title": "SUF Superlet traffic reproducibility audit manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "created_date",
    "workstream",
    "claim_ceiling",
    "reference_paper_doi",
    "public_repository",
    "observed_split_summary",
    "scenarios",
    "global_controls"
  ],
  "properties": {
    "schema_version": {
      "const": "suf.superlet_traffic_repro_manifest.v0.1"
    },
    "status": {
      "const": "public_source_audit_only"
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "workstream": {
      "const": "SUPERLET-TRAFFIC-REPRO-QUAL-001"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    },
    "reference_paper_doi": {
      "type": "string",
      "minLength": 8
    },
    "public_repository": {
      "type": "string",
      "format": "uri"
    },
    "observed_split_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_rows",
        "train_unique",
        "val_rows",
        "val_unique",
        "overlap",
        "train_labels",
        "val_labels"
      ],
      "properties": {
        "train_rows": {
          "type": "integer",
          "minimum": 0
        },
        "train_unique": {
          "type": "integer",
          "minimum": 0
        },
        "val_rows": {
          "type": "integer",
          "minimum": 0
        },
        "val_unique": {
          "type": "integer",
          "minimum": 0
        },
        "overlap": {
          "type": "integer",
          "minimum": 0
        },
        "train_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "val_labels": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario_type",
          "name",
          "expected_disposition",
          "conditions",
          "perturbations",
          "oracle_requirement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^STR-[0-9]{3}$"
          },
          "scenario_type": {
            "type": "string",
            "minLength": 3
          },
          "name": {
            "type": "string",
            "minLength": 5
          },
          "expected_disposition": {
            "enum": [
              "Accepted",
              "Rejected",
              "Indeterminate",
              "Blocked",
              "Unsupported"
            ]
          },
          "conditions": {
            "type": "string",
            "minLength": 10
          },
          "perturbations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "oracle_requirement": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "global_controls": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  }
}
