{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/rrvr/temporal-closure-cases-v0.1.schema.json",
  "title": "RRVR Temporal Closure Known-Answer Cases v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": { "const": "0.1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "class", "mutation", "expected_decision", "expected_path", "expected_reason", "expected_horizon_ms", "envelope"],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "class": { "enum": ["positive", "negative"] },
        "mutation": { "$ref": "#/$defs/identifier" },
        "expected_decision": { "enum": ["closed", "hold"] },
        "expected_path": { "enum": ["fenced_and_drained", "bounded_expiry", "none"] },
        "expected_reason": { "type": ["string", "null"] },
        "expected_horizon_ms": { "type": ["integer", "null"], "minimum": 0 },
        "envelope": { "$ref": "#/$defs/envelope" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id", "graph_revision", "old_authority_epoch", "current_authority_epoch",
        "nodes", "edges", "inventory_complete", "clock_profile_valid",
        "clock_uncertainty_bound_ms", "scheduling_jitter_bound_ms",
        "elapsed_since_ingress_fence_ms", "invalidated"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/identifier" },
        "graph_revision": { "$ref": "#/$defs/identifier" },
        "old_authority_epoch": { "type": "integer", "minimum": 0 },
        "current_authority_epoch": { "type": "integer", "minimum": 1 },
        "inventory_complete": { "type": "boolean" },
        "clock_profile_valid": { "type": "boolean" },
        "clock_uncertainty_bound_ms": { "type": ["integer", "null"], "minimum": 0 },
        "scheduling_jitter_bound_ms": { "type": ["integer", "null"], "minimum": 0 },
        "elapsed_since_ingress_fence_ms": { "type": "integer", "minimum": 0 },
        "invalidated": { "type": "boolean" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id", "is_ingress", "is_terminal", "rejects_old_epoch",
              "endpoint_fence_enforced", "last_accepted_sequence",
              "last_retired_sequence", "outstanding_commands",
              "retention_bound_ms", "receiver_enforces_expiry"
            ],
            "properties": {
              "node_id": { "$ref": "#/$defs/identifier" },
              "is_ingress": { "type": "boolean" },
              "is_terminal": { "type": "boolean" },
              "rejects_old_epoch": { "type": "boolean" },
              "endpoint_fence_enforced": { "type": "boolean" },
              "last_accepted_sequence": { "type": "integer", "minimum": 0 },
              "last_retired_sequence": { "type": "integer", "minimum": 0 },
              "outstanding_commands": { "type": "integer", "minimum": 0 },
              "retention_bound_ms": { "type": ["integer", "null"], "minimum": 0 },
              "receiver_enforces_expiry": { "type": "boolean" }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "edge_id", "from_node_id", "to_node_id", "in_flight_messages",
              "no_future_old_epoch_enqueue", "transit_bound_ms", "preserves_original_age"
            ],
            "properties": {
              "edge_id": { "$ref": "#/$defs/identifier" },
              "from_node_id": { "$ref": "#/$defs/identifier" },
              "to_node_id": { "$ref": "#/$defs/identifier" },
              "in_flight_messages": { "type": "integer", "minimum": 0 },
              "no_future_old_epoch_enqueue": { "type": "boolean" },
              "transit_bound_ms": { "type": ["integer", "null"], "minimum": 0 },
              "preserves_original_age": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
