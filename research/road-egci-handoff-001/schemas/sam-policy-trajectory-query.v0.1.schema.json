{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sam-policy-trajectory-query-v0.1.schema.json",
  "title": "SAM policy trajectory query v0.1",
  "description": "Exact four-field DTO consumed by Symthaea SAM #10514. It is a query, not a support result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_policy_digest",
    "context_digest",
    "complete",
    "steps"
  ],
  "properties": {
    "target_policy_digest": {
      "type": "string",
      "minLength": 1
    },
    "context_digest": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "history_digest",
          "joint_actions"
        ],
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "history_digest": {
            "type": "string",
            "minLength": 1
          },
          "joint_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "actor_id",
                "action_id",
                "payload_digest"
              ],
              "properties": {
                "actor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "action_id": {
                  "type": "string",
                  "minLength": 1
                },
                "payload_digest": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        },
        "required": [
          "complete"
        ]
      },
      "then": {
        "properties": {
          "steps": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
