{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/rrvr/replay-fidelity-report-v0.1.schema.json",
  "title": "RRVR Replay Fidelity Audit Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "profile_id", "campaign_id", "split_manifest_sha256", "candidate_n", "valid_n", "invalid_n", "unresolved_n", "candidate_audits", "claim_ceiling"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "benchmark": { "const": "RRVR-REPLAY-FIDELITY" },
    "profile_id": { "const": "RoboRecoverReplayV1" },
    "campaign_id": { "type": "string", "minLength": 1 },
    "split_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_n": { "type": "integer", "minimum": 1 },
    "valid_n": { "type": "integer", "minimum": 0 },
    "invalid_n": { "type": "integer", "minimum": 0 },
    "unresolved_n": { "type": "integer", "minimum": 0 },
    "candidate_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "platform", "split", "source_trajectory_id", "trajectory_cluster_id", "status", "end_effector", "object_pose", "frame_checks", "difficulty_success_n", "difficulty_trial_n", "spot_check_attempt_ids", "reason_codes"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["robo_twin", "libero"] },
          "split": { "enum": ["train", "test"] },
          "source_trajectory_id": { "type": "string", "minLength": 1 },
          "trajectory_cluster_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["valid", "invalid", "unresolved"] },
          "end_effector": { "$ref": "#/$defs/pose_check" },
          "object_pose": { "$ref": "#/$defs/pose_check" },
          "frame_checks": { "type": "array", "items": { "$ref": "#/$defs/frame_check" } },
          "difficulty_success_n": { "type": "integer", "minimum": 0 },
          "difficulty_trial_n": { "type": "integer", "minimum": 0 },
          "spot_check_attempt_ids": { "type": "array", "items": { "type": "string" } },
          "reason_codes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "claim_ceiling": { "type": "string", "minLength": 40 }
  },
  "$defs": {
    "pose_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_error_mm", "threshold_mm", "passed"],
      "properties": {
        "observed_error_mm": { "type": ["number", "null"] },
        "threshold_mm": { "const": 2.0 },
        "passed": { "type": ["boolean", "null"] }
      }
    },
    "frame_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_index", "original_sha256", "replay_sha256", "original_width", "original_height", "replay_width", "replay_height", "ssim", "threshold", "passed"],
      "properties": {
        "frame_index": { "type": "integer", "minimum": 0, "maximum": 4 },
        "original_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "replay_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "original_width": { "type": ["integer", "null"], "minimum": 1 },
        "original_height": { "type": ["integer", "null"], "minimum": 1 },
        "replay_width": { "type": ["integer", "null"], "minimum": 1 },
        "replay_height": { "type": ["integer", "null"], "minimum": 1 },
        "ssim": { "type": ["number", "null"] },
        "threshold": { "const": 0.99 },
        "passed": { "type": ["boolean", "null"] }
      }
    }
  }
}
