{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wpt-dispatch-pareto-oracle-v0.schema.json",
  "title": "WPT bounded exact multi-objective dispatch scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_id", "evidence_kind", "interval_count",
    "energy_quantum_mwh", "source_slots", "segment_slots", "receivers",
    "receiver_slots", "shared_resource_slots", "transfer_links", "quality_flags"
  ],
  "properties": {
    "schema_version": { "const": "wpt-dispatch-pareto-oracle-v0" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "evidence_kind": { "const": "SYNTHETIC_KNOWN_TRUTH" },
    "interval_count": { "type": "integer", "minimum": 1, "maximum": 8 },
    "energy_quantum_mwh": { "type": "integer", "minimum": 1 },
    "source_slots": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "interval_index", "available_deliverable_energy_mwh"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "available_deliverable_energy_mwh": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "segment_slots": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "segment_id", "interval_index", "available_deliverable_energy_mwh"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "segment_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "available_deliverable_energy_mwh": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "receivers": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["receiver_id", "arrival_interval", "departure_interval", "requested_service_mwh", "minimum_service_mwh"],
        "properties": {
          "receiver_id": { "type": "string", "minLength": 1 },
          "arrival_interval": { "type": "integer", "minimum": 0 },
          "departure_interval": { "type": "integer", "minimum": 1 },
          "requested_service_mwh": { "type": "integer", "minimum": 1 },
          "minimum_service_mwh": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "receiver_slots": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["receiver_id", "interval_index", "max_acceptance_mwh"],
        "properties": {
          "receiver_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "max_acceptance_mwh": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "shared_resource_slots": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["resource_id", "interval_index", "capacity_units"],
        "properties": {
          "resource_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "capacity_units": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "transfer_links": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["link_id", "source_id", "segment_id", "receiver_id", "interval_index", "max_deliverable_energy_mwh", "asset_stress_units_per_quantum", "shared_resource_uses"],
        "properties": {
          "link_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "segment_id": { "type": "string", "minLength": 1 },
          "receiver_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "max_deliverable_energy_mwh": { "type": "integer", "minimum": 0 },
          "asset_stress_units_per_quantum": { "type": "integer", "minimum": 0 },
          "shared_resource_uses": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["resource_id", "units_per_quantum"],
              "properties": {
                "resource_id": { "type": "string", "minLength": 1 },
                "units_per_quantum": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "quality_flags": { "const": ["SYNTHETIC_ONLY"] }
  }
}
