{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/camera-policy-observation-v1.schema.json",
  "title": "Policy camera observation receipt v1",
  "description": "Policy-visible frame provenance only. Does not contain simulator truth, scenario labels, actor identities, road graph IDs or evaluator audit fields. SHA-256 fields are unkeyed digests, not signatures or proof that upstream action receipts are authentic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "pixel_format",
    "episode_id",
    "agent_id",
    "clock_id",
    "tick",
    "sequence",
    "applied_action_receipt_id",
    "applied_action_receipt_sha256",
    "applied_action_command_id",
    "applied_action_tick",
    "camera_id",
    "camera_calibration_sha256",
    "renderer_revision",
    "capture_timestamp_us",
    "render_completed_timestamp_us",
    "delivered_timestamp_us",
    "frame_width",
    "frame_height",
    "channels",
    "frame_byte_len",
    "frame_sha256",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observation_id": { "$ref": "#/$defs/sha256" },
    "pixel_format": { "const": "rgb8_srgb" },
    "episode_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "clock_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "tick": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 1 },
    "applied_action_receipt_id": { "type": ["string", "null"], "maxLength": 256 },
    "applied_action_receipt_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "applied_action_command_id": { "type": ["string", "null"], "maxLength": 256 },
    "applied_action_tick": { "type": ["integer", "null"], "minimum": 0 },
    "camera_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "camera_calibration_sha256": { "$ref": "#/$defs/sha256" },
    "renderer_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capture_timestamp_us": { "type": "integer", "minimum": 0 },
    "render_completed_timestamp_us": { "type": "integer", "minimum": 0 },
    "delivered_timestamp_us": { "type": "integer", "minimum": 0 },
    "frame_width": { "type": "integer", "minimum": 1, "maximum": 1280 },
    "frame_height": { "type": "integer", "minimum": 1, "maximum": 720 },
    "channels": { "const": 3 },
    "frame_byte_len": { "type": "integer", "minimum": 3, "maximum": 2764800 },
    "frame_sha256": { "$ref": "#/$defs/sha256" },
    "receipt_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "x-invariants": [
    "For non-initial ticks, applied_action_receipt_id, applied_action_receipt_sha256, applied_action_command_id and applied_action_tick are non-null and applied_action_tick equals tick.",
    "For tick zero, all applied-action fields are null.",
    "frame_byte_len equals frame_width multiplied by frame_height multiplied by three.",
    "capture_timestamp_us is the source acquisition time; render_completed_timestamp_us and delivered_timestamp_us are separate later events.",
    "render_completed_timestamp_us must be greater than or equal to capture_timestamp_us.",
    "delivered_timestamp_us must be greater than or equal to render_completed_timestamp_us."
  ]
}
