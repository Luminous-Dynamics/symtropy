{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/rrvr/command-semantics-cases-v0.2.schema.json",
  "title": "RRVR Command Semantics Known-Answer Cases v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "benchmark": {
      "const": "RRVR-COMMAND-SEMANTICS"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 30
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "device_model",
        "firmware_revision",
        "endpoint_revision",
        "configuration_sha256",
        "payload_schema_sha256",
        "units",
        "coordinate_frame",
        "reference_frame",
        "supports_absolute_target",
        "absolute_target_replay_safe",
        "absolute_target_side_effect_free",
        "supports_durable_one_shot_token",
        "rejects_duplicate_one_shot_token",
        "maximum_effects_per_token",
        "endpoint_enforces_authority_epoch",
        "enforces_lease_expiry",
        "watchdog_reaction",
        "watchdog_response_bound_ms",
        "supports_stable_trajectory_segments",
        "supports_progress_checkpoints",
        "supports_measured_progress_resume",
        "supports_downstream_queue_reconciliation"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "device_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "firmware_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "endpoint_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "payload_schema_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "coordinate_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "reference_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "absolute_target_replay_safe": {
          "type": "boolean"
        },
        "absolute_target_side_effect_free": {
          "type": "boolean"
        },
        "maximum_effects_per_token": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "endpoint_enforces_authority_epoch": {
          "type": "boolean"
        },
        "watchdog_reaction": {
          "enum": [
            "controlled_stop",
            "disable_output",
            "hold_last_value",
            "none"
          ]
        },
        "watchdog_response_bound_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "device_id",
        "device_model",
        "firmware_revision",
        "endpoint_revision",
        "configuration_sha256",
        "logical_effect_id_required",
        "attempt_id_required",
        "effect_class",
        "payload_schema_sha256",
        "units",
        "coordinate_frame",
        "reference_frame",
        "motion_semantics",
        "target_predicate",
        "side_effect_envelope",
        "watchdog_reaction"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "device_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "firmware_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "endpoint_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "logical_effect_id_required": {
          "type": "boolean"
        },
        "attempt_id_required": {
          "type": "boolean"
        },
        "effect_class": {
          "enum": [
            "desired_state",
            "one_shot",
            "continuous_lease",
            "trajectory"
          ]
        },
        "payload_schema_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "coordinate_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "reference_frame": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "motion_semantics": {
          "enum": [
            "absolute",
            "relative",
            "one_shot",
            "continuous",
            "segmented_trajectory"
          ]
        },
        "target_predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "idempotent_under_declared_contract": {
          "type": "boolean"
        },
        "same_payload_replay_safe": {
          "type": "boolean"
        },
        "tolerance_microunits": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "side_effect_envelope": {
          "enum": [
            "no_additional_effect_declared",
            "bounded_additional_effect_declared",
            "unknown"
          ]
        },
        "maximum_physical_effects_per_attempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "endpoint_token_required": {
          "type": "boolean"
        },
        "same_token_reactuates": {
          "type": "boolean"
        },
        "independent_outcome_observation_required": {
          "type": "boolean"
        },
        "lease_expiry_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "endpoint_enforces_authority_epoch": {
          "type": "boolean"
        },
        "endpoint_enforces_expiry": {
          "type": "boolean"
        },
        "watchdog_supported": {
          "type": "boolean"
        },
        "watchdog_reaction": {
          "enum": [
            "controlled_stop",
            "disable_output",
            "hold_last_value",
            "none"
          ]
        },
        "watchdog_response_bound_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "clock_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "segment_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "segment_ids_are_stable": {
          "type": "boolean"
        },
        "progress_checkpoints_required": {
          "type": "boolean"
        },
        "resume_from_measured_progress": {
          "type": "boolean"
        },
        "restart_from_segment_zero_allowed": {
          "type": "boolean"
        },
        "downstream_queue_reconciliation_required": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect_class": {
                "const": "desired_state"
              }
            }
          },
          "then": {
            "required": [
              "idempotent_under_declared_contract",
              "same_payload_replay_safe",
              "tolerance_microunits"
            ],
            "properties": {
              "motion_semantics": {
                "const": "absolute"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect_class": {
                "const": "one_shot"
              }
            }
          },
          "then": {
            "required": [
              "maximum_physical_effects_per_attempt",
              "endpoint_token_required",
              "same_token_reactuates",
              "independent_outcome_observation_required"
            ],
            "properties": {
              "motion_semantics": {
                "const": "one_shot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect_class": {
                "const": "continuous_lease"
              }
            }
          },
          "then": {
            "required": [
              "lease_expiry_ms",
              "endpoint_enforces_authority_epoch",
              "endpoint_enforces_expiry",
              "watchdog_supported",
              "watchdog_response_bound_ms",
              "clock_profile_id"
            ],
            "properties": {
              "motion_semantics": {
                "const": "continuous"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "effect_class": {
                "const": "trajectory"
              }
            }
          },
          "then": {
            "required": [
              "segment_count",
              "segment_ids_are_stable",
              "progress_checkpoints_required",
              "resume_from_measured_progress",
              "restart_from_segment_zero_allowed",
              "downstream_queue_reconciliation_required"
            ],
            "properties": {
              "motion_semantics": {
                "const": "segmented_trajectory"
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "class",
        "mutation",
        "expected_decision",
        "expected_reason",
        "device",
        "command"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "class": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "mutation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\\\S"
        },
        "expected_decision": {
          "enum": [
            "accept_profile",
            "hold"
          ]
        },
        "expected_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "DesiredStateRequiresAbsoluteMotion",
            "OneShotTokenMissing",
            "ContinuousLeaseMissingExpiry",
            "TrajectoryRestartFromSegmentZeroAllowed",
            "CoordinateFrameMismatch",
            "DeviceOneShotTokenUnsupported",
            "DeviceLeaseEpochUnsupported",
            "DeviceTrajectoryResumeUnsupported",
            "FirmwareProfileMismatch",
            "DeviceProfileMismatch",
            "PayloadSchemaMismatch",
            "UnitMismatch"
          ]
        },
        "device": {
          "$ref": "#/$defs/device"
        },
        "command": {
          "$ref": "#/$defs/command"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "positive"
              }
            }
          },
          "then": {
            "properties": {
              "expected_decision": {
                "const": "accept_profile"
              },
              "expected_reason": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "negative"
              }
            }
          },
          "then": {
            "properties": {
              "expected_decision": {
                "const": "hold"
              },
              "expected_reason": {
                "not": {
                  "const": null
                }
              }
            }
          }
        }
      ]
    }
  }
}
