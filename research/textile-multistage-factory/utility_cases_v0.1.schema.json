{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/textile-multistage-factory/utility_cases_v0.1.schema.json",
  "title": "Textile multi-stage utility envelope cases v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "fixture_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "TEXTILE-UTILITY-CASES-001"
    },
    "fixture_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "purpose",
          "expected_valid",
          "expected_finding"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "expected_valid": {
            "type": "boolean"
          },
          "expected_finding": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
