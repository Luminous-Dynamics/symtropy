{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Magnetic experiment-selection trace v0.1",
  "type":"object",
  "required":["schema_version","program_id","claim_ceiling","task","traces"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "program_id":{"const":"MAG-AM-EXPERIMENT-SELECTION-BENCH-001"},
    "claim_ceiling":{"type":"string","minLength":1},
    "task":{"$ref":"#/$defs/task"},
    "traces":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/trace"}}
  },
  "additionalProperties":false,
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-fA-F]{64}$"},
    "objective":{
      "type":"object",
      "required":["metric_id","unit","direction"],
      "properties":{
        "metric_id":{"type":"string","minLength":1},
        "unit":{"type":"string","minLength":1},
        "direction":{"enum":["Minimize","Maximize"]}
      },
      "additionalProperties":false
    },
    "task":{
      "type":"object",
      "required":["task_id","candidate_space_digest","target_function_digest","acceptance_policy_digest","initial_design_digest","holdout_manifest_digest","split_unit","experiment_budget","objectives","false_feasible_probability_threshold"],
      "properties":{
        "task_id":{"type":"string","minLength":1},
        "candidate_space_digest":{"$ref":"#/$defs/digest"},
        "target_function_digest":{"$ref":"#/$defs/digest"},
        "acceptance_policy_digest":{"$ref":"#/$defs/digest"},
        "initial_design_digest":{"$ref":"#/$defs/digest"},
        "holdout_manifest_digest":{"$ref":"#/$defs/digest"},
        "split_unit":{"enum":["MaterialLot","Build","ProcessRevision","RandomRows"]},
        "experiment_budget":{"type":"integer","minimum":1},
        "objectives":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/objective"}},
        "oracle_best_objective_0":{"type":"number"},
        "hypervolume_reference_point":{"type":"array","items":{"type":"number"}},
        "false_feasible_probability_threshold":{"type":"number","minimum":0,"maximum":1}
      },
      "additionalProperties":false
    },
    "outcome":{
      "type":"object",
      "required":["experiment_id","candidate_id","material_lot_id","build_id","process_revision","iteration","disposition","cost_minor","objective_values","design_features","predicted_feasibility_probability"],
      "properties":{
        "experiment_id":{"type":"string","minLength":1},
        "candidate_id":{"type":"string","minLength":1},
        "material_lot_id":{"type":"string","minLength":1},
        "build_id":{"type":"string","minLength":1},
        "process_revision":{"type":"string","minLength":1},
        "iteration":{"type":"integer","minimum":1},
        "disposition":{"enum":["Qualified","Fail","Indeterminate","NotEvaluable","Missing"]},
        "cost_minor":{"type":"integer","minimum":0},
        "objective_values":{"type":"array","items":{"type":"number"}},
        "design_features":{"type":"array","minItems":1,"items":{"type":"number"}},
        "predicted_feasibility_probability":{"type":"number","minimum":0,"maximum":1}
      },
      "additionalProperties":false
    },
    "interval":{
      "type":"object",
      "required":["objective_index","lower","upper"],
      "properties":{
        "objective_index":{"type":"integer","minimum":0},
        "lower":{"type":"number"},
        "upper":{"type":"number"}
      },
      "additionalProperties":false
    },
    "holdout":{
      "type":"object",
      "required":["holdout_id","candidate_id","material_lot_id","build_id","process_revision","disposition","objective_values","design_features","predicted_feasibility_probability","predicted_intervals"],
      "properties":{
        "holdout_id":{"type":"string","minLength":1},
        "candidate_id":{"type":"string","minLength":1},
        "material_lot_id":{"type":"string","minLength":1},
        "build_id":{"type":"string","minLength":1},
        "process_revision":{"type":"string","minLength":1},
        "disposition":{"enum":["Qualified","Fail","Indeterminate","NotEvaluable","Missing"]},
        "objective_values":{"type":"array","items":{"type":"number"}},
        "design_features":{"type":"array","minItems":1,"items":{"type":"number"}},
        "predicted_feasibility_probability":{"type":"number","minimum":0,"maximum":1},
        "predicted_intervals":{"type":"array","items":{"$ref":"#/$defs/interval"}}
      },
      "additionalProperties":false
    },
    "trace":{
      "type":"object",
      "required":["policy","matched_seed_id","training_group_ids","holdout_group_ids","initiated_experiment_count","outcomes","holdout"],
      "properties":{
        "policy":{"enum":["ExpertPrior","FactorialDoe","ResponseSurfaceDoe","Random","LatinHypercube","MaximinSpaceFilling","ClusterRepresentative","GaussianProcessExpectedImprovement","GaussianProcessUpperConfidenceBound","ProbabilityOfFeasibility","ThompsonSampling","KnowledgeGradient","ExpectedHypervolumeImprovement","CostAwareBatch","FeasibilityDiversityCombined"]},
        "matched_seed_id":{"type":"string","minLength":1},
        "training_group_ids":{"type":"array","items":{"type":"string","minLength":1}},
        "holdout_group_ids":{"type":"array","items":{"type":"string","minLength":1}},
        "initiated_experiment_count":{"type":"integer","minimum":0},
        "outcomes":{"type":"array","items":{"$ref":"#/$defs/outcome"}},
        "holdout":{"type":"array","items":{"$ref":"#/$defs/holdout"}}
      },
      "additionalProperties":false
    }
  }
}
