{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Magnetic qualification maturity evidence package v0.1",
  "type":"object",
  "required":["schema_version","program_id","claim_ceiling","candidate","receipts","expected"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "program_id":{"const":"MAG-AM-QUALIFICATION-MATURITY-001"},
    "claim_ceiling":{"type":"string","minLength":1},
    "candidate":{"$ref":"#/$defs/candidate"},
    "receipts":{"type":"array","items":{"$ref":"#/$defs/receipt"}},
    "expected":{
      "type":"object",
      "required":["derived_level","supported_levels"],
      "properties":{
        "derived_level":{"enum":["M1","M2","M3","M4","M5"]},
        "supported_levels":{"type":"array","items":{"enum":["M1","M2","M3","M4","M5"]}}
      },
      "additionalProperties":false
    }
  },
  "additionalProperties":false,
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-fA-F]{64}$"},
    "scope":{
      "type":"object",
      "required":["application_id","route_family","route_revision","material_family","product_form","target_function_digest","measurement_setup_digest","acceptance_policy_digest"],
      "properties":{
        "application_id":{"type":"string","minLength":1},
        "route_family":{"type":"string","minLength":1},
        "route_revision":{"type":"string","minLength":1},
        "material_family":{"type":"string","minLength":1},
        "product_form":{"type":"string","minLength":1},
        "target_function_digest":{"$ref":"#/$defs/digest"},
        "measurement_setup_digest":{"$ref":"#/$defs/digest"},
        "acceptance_policy_digest":{"$ref":"#/$defs/digest"}
      },
      "additionalProperties":false
    },
    "candidate":{
      "type":"object",
      "required":["candidate_id","scope","component_id","pbf_lb_equipment_qualification_required","replication_policy"],
      "properties":{
        "candidate_id":{"type":"string","minLength":1},
        "scope":{"$ref":"#/$defs/scope"},
        "component_id":{"type":"string","minLength":1},
        "pbf_lb_equipment_qualification_required":{"type":"boolean"},
        "replication_policy":{
          "type":"object",
          "required":["minimum_independent_builds","minimum_distinct_material_lots","policy_id","policy_digest"],
          "properties":{
            "minimum_independent_builds":{"type":"integer","minimum":1},
            "minimum_distinct_material_lots":{"type":"integer","minimum":1},
            "policy_id":{"type":"string","minLength":1},
            "policy_digest":{"$ref":"#/$defs/digest"}
          },
          "additionalProperties":false
        }
      },
      "additionalProperties":false
    },
    "replication":{
      "type":"object",
      "required":["independent_builds","distinct_material_lots","cohort_policy_digest"],
      "properties":{
        "independent_builds":{"type":"integer","minimum":0},
        "distinct_material_lots":{"type":"integer","minimum":0},
        "cohort_policy_digest":{"$ref":"#/$defs/digest"}
      },
      "additionalProperties":false
    },
    "receipt":{
      "type":"object",
      "required":["evidence_id","digest","kind","class","scope","linked_evidence_ids"],
      "properties":{
        "evidence_id":{"type":"string","minLength":1},
        "digest":{"$ref":"#/$defs/digest"},
        "kind":{"enum":["DesignModel","MaterialPropertyMeasurement","ProcessRecord","MicrostructureCharacterization","PspPLink","AsBuiltInspection","ComponentFunctionalTest","ComponentAcceptance","CohortSummary","VariabilityAnalysis","DurabilityTest","SiteQualitySystem","EquipmentIq","EquipmentOq","EquipmentPq","LaboratoryMethodScope"]},
        "class":{"enum":["PhysicalMeasurement","ProductionRecord","PublishedLiterature","SyntheticControl","ExternalAttestation"]},
        "scope":{"$ref":"#/$defs/scope"},
        "specimen_id":{"type":"string","minLength":1},
        "material_lot_id":{"type":"string","minLength":1},
        "build_id":{"type":"string","minLength":1},
        "component_id":{"type":"string","minLength":1},
        "cohort_id":{"type":"string","minLength":1},
        "method_id":{"type":"string","minLength":1},
        "method_scope_id":{"type":"string","minLength":1},
        "laboratory_id":{"type":"string","minLength":1},
        "calibration_record_id":{"type":"string","minLength":1},
        "calibration_digest":{"$ref":"#/$defs/digest"},
        "uncertainty_record_id":{"type":"string","minLength":1},
        "uncertainty_digest":{"$ref":"#/$defs/digest"},
        "conditions_digest":{"$ref":"#/$defs/digest"},
        "geometry_digest":{"$ref":"#/$defs/digest"},
        "standard_reference":{"type":"string","minLength":1},
        "linked_evidence_ids":{"type":"array","items":{"type":"string","minLength":1}},
        "replication":{"$ref":"#/$defs/replication"}
      },
      "additionalProperties":false
    }
  }
}
