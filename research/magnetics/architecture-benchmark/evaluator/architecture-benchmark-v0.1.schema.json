{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Magnetic system architecture benchmark v0.1",
  "type":"object",
  "required":["schema_version","program_id","claim_ceiling","spec","trials","expected"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "program_id":{"const":"MAG-AM-ARCHITECTURE-BENCH-001"},
    "claim_ceiling":{"type":"string","minLength":1},
    "spec":{"$ref":"#/$defs/spec"},
    "trials":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/trial"}},
    "expected":{"type":"object","required":["candidate_decisions"],"properties":{"candidate_decisions":{"type":"object","additionalProperties":{"enum":["NotComparable","Fail","Indeterminate","NonInferiorNoArchitectureBenefit","ArchitectureAdvantage"]}}},"additionalProperties":false}
  },
  "additionalProperties":false,
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-fA-F]{64}$"},
    "scope":{
      "type":"object",
      "required":["application_id","target_function_digest","stator_winding_digest","inverter_control_digest","cooling_boundary_digest","mechanical_boundary_digest","duty_cycle_digest","thermal_envelope_digest","measurement_setup_digest","acceptance_policy_digest","objective_set_digest"],
      "properties":{
        "application_id":{"type":"string","minLength":1},
        "target_function_digest":{"$ref":"#/$defs/digest"},
        "stator_winding_digest":{"$ref":"#/$defs/digest"},
        "inverter_control_digest":{"$ref":"#/$defs/digest"},
        "cooling_boundary_digest":{"$ref":"#/$defs/digest"},
        "mechanical_boundary_digest":{"$ref":"#/$defs/digest"},
        "duty_cycle_digest":{"$ref":"#/$defs/digest"},
        "thermal_envelope_digest":{"$ref":"#/$defs/digest"},
        "measurement_setup_digest":{"$ref":"#/$defs/digest"},
        "acceptance_policy_digest":{"$ref":"#/$defs/digest"},
        "objective_set_digest":{"$ref":"#/$defs/digest"}
      },
      "additionalProperties":false
    },
    "metric":{
      "type":"object",
      "required":["metric_id","unit","class","direction"],
      "properties":{
        "metric_id":{"type":"string","minLength":1},
        "unit":{"type":"string","minLength":1},
        "class":{"enum":["MandatoryFunction","ArchitectureBenefit"]},
        "direction":{"enum":["Minimize","Maximize"]},
        "hard_min":{"type":"number"},
        "hard_max":{"type":"number"},
        "non_inferiority_margin":{"type":"number","minimum":0}
      },
      "additionalProperties":false
    },
    "spec":{
      "type":"object",
      "required":["benchmark_id","scope","metrics","required_baseline_families","minimum_baseline_optimization_evaluations","minimum_independent_restarts"],
      "properties":{
        "benchmark_id":{"type":"string","minLength":1},
        "scope":{"$ref":"#/$defs/scope"},
        "metrics":{"type":"array","minItems":2,"items":{"$ref":"#/$defs/metric"}},
        "required_baseline_families":{"type":"array","minItems":1,"items":{"enum":["ConventionalSinteredPm","ConventionalBondedPm","PmAssistedSynrm"]}},
        "minimum_baseline_optimization_evaluations":{"type":"integer","minimum":1},
        "minimum_independent_restarts":{"type":"integer","minimum":1}
      },
      "additionalProperties":false
    },
    "acceptance":{
      "type":"object",
      "required":["component_id","specimen_id","receipt_id","receipt_digest","scope_digest","maturity","disposition","physical_evidence_digest"],
      "properties":{
        "component_id":{"type":"string","minLength":1},
        "specimen_id":{"type":"string","minLength":1},
        "receipt_id":{"type":"string","minLength":1},
        "receipt_digest":{"$ref":"#/$defs/digest"},
        "scope_digest":{"$ref":"#/$defs/digest"},
        "maturity":{"enum":["M1","M2","M3","M4","M5"]},
        "disposition":{"enum":["Qualified","Fail","Indeterminate"]},
        "physical_evidence_digest":{"$ref":"#/$defs/digest"}
      },
      "additionalProperties":false
    },
    "optimization":{
      "type":"object",
      "required":["receipt_id","digest","optimizer_id","search_space_digest","objective_digest","constraint_digest","protocol_digest","evaluations","independent_restarts","frozen_before_comparison"],
      "properties":{
        "receipt_id":{"type":"string","minLength":1},
        "digest":{"$ref":"#/$defs/digest"},
        "optimizer_id":{"type":"string","minLength":1},
        "search_space_digest":{"$ref":"#/$defs/digest"},
        "objective_digest":{"$ref":"#/$defs/digest"},
        "constraint_digest":{"$ref":"#/$defs/digest"},
        "protocol_digest":{"$ref":"#/$defs/digest"},
        "evaluations":{"type":"integer","minimum":0},
        "independent_restarts":{"type":"integer","minimum":0},
        "frozen_before_comparison":{"type":"boolean"}
      },
      "additionalProperties":false
    },
    "observation":{
      "type":"object",
      "required":["metric_id","unit","value","uncertainty_radius","evidence_id","evidence_digest","evidence_class","method_id","calibration_digest","uncertainty_record_digest"],
      "properties":{
        "metric_id":{"type":"string","minLength":1},
        "unit":{"type":"string","minLength":1},
        "value":{"type":"number"},
        "uncertainty_radius":{"type":"number","minimum":0},
        "evidence_id":{"type":"string","minLength":1},
        "evidence_digest":{"$ref":"#/$defs/digest"},
        "evidence_class":{"enum":["PhysicalMeasurement","ProductionRecord","Simulation","PublishedLiterature","SyntheticControl"]},
        "method_id":{"type":"string","minLength":1},
        "calibration_digest":{"$ref":"#/$defs/digest"},
        "uncertainty_record_digest":{"$ref":"#/$defs/digest"}
      },
      "additionalProperties":false
    },
    "trial":{
      "type":"object",
      "required":["architecture_id","family","role","scope","acceptance","observations"],
      "properties":{
        "architecture_id":{"type":"string","minLength":1},
        "family":{"enum":["ConventionalSinteredPm","ConventionalBondedPm","PmAssistedSynrm","ReluctanceOnlyControl","AmShapedPmInsert","AmHybridArchitecture"]},
        "role":{"enum":["Candidate","RequiredBaseline","SecondaryControl"]},
        "scope":{"$ref":"#/$defs/scope"},
        "acceptance":{"$ref":"#/$defs/acceptance"},
        "optimization":{"$ref":"#/$defs/optimization"},
        "observations":{"type":"array","items":{"$ref":"#/$defs/observation"}}
      },
      "additionalProperties":false
    }
  }
}
