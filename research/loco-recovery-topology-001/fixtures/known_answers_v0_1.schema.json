{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOCO-RECOVERY-TOPOLOGY-001 known-answer corpus",
  "type": "object",
  "required": [
    "protocol",
    "version",
    "evidence_tier",
    "notes",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "LOCO-RECOVERY-TOPOLOGY-001"
    },
    "version": {
      "const": "0.1"
    },
    "evidence_tier": {
      "const": "synthetic_known_answer"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "nullableNonNegativeInt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "failure_domains",
        "routes",
        "resource_limits",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_domains": {
          "$ref": "#/$defs/stringSet"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "resource_limits": {
          "type": "object",
          "required": [
            "max_steps",
            "available_energy_mj"
          ],
          "additionalProperties": false,
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 0
            },
            "available_energy_mj": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "route_id",
        "action_ids",
        "physical_edge_ids",
        "terminal_region_id",
        "dependencies",
        "upstream_admitted",
        "all_physical_branches_covered",
        "intermediate_viability_complete",
        "worst_case_steps",
        "worst_case_energy_mj"
      ],
      "additionalProperties": false,
      "properties": {
        "route_id": {
          "type": "string",
          "minLength": 1
        },
        "action_ids": {
          "$ref": "#/$defs/stringSet"
        },
        "physical_edge_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terminal_region_id": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "$ref": "#/$defs/stringSet"
        },
        "upstream_admitted": {
          "type": "boolean"
        },
        "all_physical_branches_covered": {
          "type": "boolean"
        },
        "intermediate_viability_complete": {
          "type": "boolean"
        },
        "worst_case_steps": {
          "type": "integer",
          "minimum": 0
        },
        "worst_case_energy_mj": {
          "type": "integer",
          "minimum": 0
        },
        "possible_successors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "state_id",
              "physically_possible",
              "calibrated_probability_ppm"
            ],
            "additionalProperties": false,
            "properties": {
              "state_id": {
                "type": "string",
                "minLength": 1
              },
              "physically_possible": {
                "type": "boolean"
              },
              "calibrated_probability_ppm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            }
          }
        },
        "blocking_successor_ids": {
          "$ref": "#/$defs/stringSet"
        },
        "intermediate_state_ids": {
          "$ref": "#/$defs/stringSet"
        },
        "nonviable_intermediate_state_ids": {
          "$ref": "#/$defs/stringSet"
        },
        "missing_failure_domain_for": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "expected": {
      "type": "object",
      "required": [
        "qualification",
        "physical_route_classes",
        "qualifying_route_ids",
        "independent_route_count",
        "minimum_cut_size",
        "all_minimal_cut_sets",
        "distinct_terminal_regions"
      ],
      "additionalProperties": false,
      "properties": {
        "qualification": {
          "enum": [
            "VALID",
            "REJECTED",
            "UNKNOWN",
            "INVALID"
          ]
        },
        "physical_route_classes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "qualifying_route_ids": {
          "$ref": "#/$defs/stringSet"
        },
        "independent_route_count": {
          "$ref": "#/$defs/nullableNonNegativeInt"
        },
        "minimum_cut_size": {
          "$ref": "#/$defs/nullableNonNegativeInt"
        },
        "distinct_terminal_regions": {
          "$ref": "#/$defs/nullableNonNegativeInt"
        },
        "rejection_reasons": {
          "$ref": "#/$defs/stringSet"
        },
        "all_minimal_cut_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stringSet"
          }
        }
      }
    }
  }
}
