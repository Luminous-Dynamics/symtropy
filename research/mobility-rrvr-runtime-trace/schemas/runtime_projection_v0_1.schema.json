{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mobility-rrvr-runtime-projection-v0.1.json",
  "title": "RRVR Runtime to TLA State Projection v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "header",
    "snapshots"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "system_id",
        "implementation_revision",
        "model_revision",
        "model_source_sha256",
        "model_config_sha256",
        "tla_tool_sha256",
        "fault_profile_revision",
        "max_epoch",
        "naive_retry_enabled"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "system_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation_revision": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "model_source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "model_config_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "tla_tool_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "fault_profile_revision": {
          "type": "string",
          "minLength": 1
        },
        "max_epoch": {
          "type": "integer",
          "minimum": 3
        },
        "naive_retry_enabled": {
          "type": "boolean"
        }
      }
    },
    "snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "logical_sequence",
          "model_action",
          "model_arguments",
          "predecessor_event_ids",
          "source_clock",
          "state_s",
          "owner_evidence"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "logical_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "model_action": {
            "type": [
              "string",
              "null"
            ]
          },
          "model_arguments": {
            "type": "array"
          },
          "predecessor_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_clock": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "clock_id",
                  "boot_epoch_id",
                  "unit",
                  "value",
                  "resolution",
                  "uncertainty"
                ],
                "properties": {
                  "clock_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "boot_epoch_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "resolution": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uncertainty": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "state_s": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "processStatus",
              "bootEpoch",
              "controllerEpoch",
              "stage",
              "reservationCommitted",
              "oldTicketBootEpoch",
              "oldTicketControllerEpoch",
              "oldAccepted",
              "oldAcceptedBootEpoch",
              "oldAcceptedControllerEpoch",
              "commandPending",
              "commandOwnerAttempt",
              "oldPhysicalOutcome",
              "recoveryPhysicalOutcome",
              "appliedEffectCount",
              "persistStatus",
              "storeRecord",
              "storeCallPending",
              "effectEvidence",
              "missionResolution",
              "observerIndependent",
              "queueFenceBootEpoch",
              "downstreamFenceBootEpoch",
              "recoveryPermit",
              "permitUseCount",
              "ticketStatus",
              "ticketBootEpoch",
              "ticketControllerEpoch",
              "ticketAttempt",
              "m1Current",
              "m2Current",
              "ticketBindingValid",
              "liveBindingValid",
              "recoveryAccepted",
              "admittedFreshBoot",
              "admittedFreshController",
              "admittedControllerFence",
              "admittedDownstreamFence",
              "admittedM1",
              "admittedM2",
              "admittedBinding",
              "naiveReplayCount",
              "crashCut"
            ],
            "properties": {
              "processStatus": {
                "type": "string",
                "minLength": 1
              },
              "bootEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "controllerEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "reservationCommitted": {
                "type": "boolean"
              },
              "oldTicketBootEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "oldTicketControllerEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "oldAccepted": {
                "type": "boolean"
              },
              "oldAcceptedBootEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "oldAcceptedControllerEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "commandPending": {
                "type": "boolean"
              },
              "commandOwnerAttempt": {
                "type": "string",
                "minLength": 1
              },
              "oldPhysicalOutcome": {
                "type": "string",
                "minLength": 1
              },
              "recoveryPhysicalOutcome": {
                "type": "string",
                "minLength": 1
              },
              "appliedEffectCount": {
                "type": "integer",
                "minimum": 0
              },
              "persistStatus": {
                "type": "string",
                "minLength": 1
              },
              "storeRecord": {
                "type": "boolean"
              },
              "storeCallPending": {
                "type": "boolean"
              },
              "effectEvidence": {
                "type": "string",
                "minLength": 1
              },
              "missionResolution": {
                "type": "string",
                "minLength": 1
              },
              "observerIndependent": {
                "type": "boolean"
              },
              "queueFenceBootEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "downstreamFenceBootEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "recoveryPermit": {
                "type": "string",
                "minLength": 1
              },
              "permitUseCount": {
                "type": "integer",
                "minimum": 0
              },
              "ticketStatus": {
                "type": "string",
                "minLength": 1
              },
              "ticketBootEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "ticketControllerEpoch": {
                "type": "integer",
                "minimum": 0
              },
              "ticketAttempt": {
                "type": "string",
                "minLength": 1
              },
              "m1Current": {
                "type": "boolean"
              },
              "m2Current": {
                "type": "boolean"
              },
              "ticketBindingValid": {
                "type": "boolean"
              },
              "liveBindingValid": {
                "type": "boolean"
              },
              "recoveryAccepted": {
                "type": "boolean"
              },
              "admittedFreshBoot": {
                "type": "boolean"
              },
              "admittedFreshController": {
                "type": "boolean"
              },
              "admittedControllerFence": {
                "type": "boolean"
              },
              "admittedDownstreamFence": {
                "type": "boolean"
              },
              "admittedM1": {
                "type": "boolean"
              },
              "admittedM2": {
                "type": "boolean"
              },
              "admittedBinding": {
                "type": "boolean"
              },
              "naiveReplayCount": {
                "type": "integer",
                "minimum": 0
              },
              "crashCut": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "owner_evidence": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "domain",
                "owner_id",
                "owner_revision",
                "evidence_id",
                "status",
                "scope",
                "claim_id",
                "claim_scope_sha256",
                "observer_quorum",
                "raw_artifact_id",
                "raw_artifact_sha256"
              ],
              "properties": {
                "domain": {
                  "enum": [
                    "process_epoch",
                    "persistence",
                    "physical_outcome",
                    "mission_resolution",
                    "controller_queue",
                    "downstream_execution_graph",
                    "physical_outcome_observer_quorum",
                    "downstream_observer_quorum",
                    "action_applicability",
                    "recovery_authority"
                  ]
                },
                "owner_id": {
                  "type": "string",
                  "minLength": 1
                },
                "owner_revision": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "raw_artifact_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "current",
                    "confirmed",
                    "refuted",
                    "insufficient_evidence",
                    "unknown",
                    "disputed",
                    "quorum_qualified",
                    "quorum_not_qualified",
                    "not_applicable"
                  ]
                },
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "logical_effect_id",
                    "attempt_id",
                    "subject_boot_epoch",
                    "subject_controller_epoch"
                  ],
                  "properties": {
                    "logical_effect_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt_id": {
                      "enum": [
                        "attempt-1",
                        "attempt-2"
                      ]
                    },
                    "subject_boot_epoch": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "subject_controller_epoch": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "claim_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "claim_scope_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "observer_quorum": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "fault_model_revision",
                        "required_independent_members",
                        "members"
                      ],
                      "properties": {
                        "fault_model_revision": {
                          "type": "string",
                          "minLength": 1
                        },
                        "required_independent_members": {
                          "type": "integer",
                          "minimum": 2,
                          "maximum": 32
                        },
                        "members": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 32,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "observer_id",
                              "observer_revision",
                              "observation_id",
                              "common_cause_domains",
                              "raw_artifact_id",
                              "raw_artifact_sha256"
                            ],
                            "properties": {
                              "observer_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "observer_revision": {
                                "type": "string",
                                "minLength": 1
                              },
                              "observation_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "common_cause_domains": {
                                "type": "array",
                                "minItems": 1,
                                "uniqueItems": true,
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "raw_artifact_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "raw_artifact_sha256": {
                                "type": "string",
                                "pattern": "^[a-fA-F0-9]{64}$"
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "domain": {
                        "enum": [
                          "physical_outcome_observer_quorum",
                          "downstream_observer_quorum"
                        ]
                      },
                      "status": {
                        "const": "not_applicable"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "claim_id": {
                        "type": "null"
                      },
                      "claim_scope_sha256": {
                        "type": "null"
                      },
                      "observer_quorum": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "domain": {
                        "enum": [
                          "physical_outcome_observer_quorum",
                          "downstream_observer_quorum"
                        ]
                      },
                      "status": {
                        "enum": [
                          "quorum_qualified",
                          "quorum_not_qualified",
                          "unknown",
                          "insufficient_evidence",
                          "disputed"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "claim_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "claim_scope_sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "domain": {
                        "enum": [
                          "process_epoch",
                          "persistence",
                          "physical_outcome",
                          "mission_resolution",
                          "controller_queue",
                          "downstream_execution_graph",
                          "action_applicability",
                          "recovery_authority"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "claim_id": {
                        "type": "null"
                      },
                      "claim_scope_sha256": {
                        "type": "null"
                      },
                      "observer_quorum": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "quorum_qualified",
                          "quorum_not_qualified"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "observer_quorum": {
                        "type": "object"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
