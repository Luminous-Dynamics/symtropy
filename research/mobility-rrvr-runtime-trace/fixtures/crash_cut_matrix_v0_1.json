      "expected_mutator_calls": 1,
      "owner_lookup_required": true,
      "expected_disposition": "same_result_no_duplicate_effect",
      "new_attempt_admitted_by_adapter": false
    },
    {
      "id": "same_key_changed_payload_race",
      "boundary": "owner_concurrency",
      "fault": "two coordinators race same key with different payload digests",
      "expected_mutator_calls": 1,
      "owner_lookup_required": true,
      "expected_disposition": "payload_conflict",
      "new_attempt_admitted_by_adapter": false
    },
    {
      "id": "late_old_response",
      "boundary": "late_response",
      "fault": "old response arrives after new process incarnation",
      "expected_mutator_calls": 1,
      "owner_lookup_required": true,
