      },
      {
        "id": "common_independent_referee",
        "purpose": "Compare outputs on identical frozen layouts and ODD strata using an independent calibrated survey/reference system not used by the robot's navigation or print control."
      }
    ],
    "evidence_labels": [
      "vendor_reported",
      "independently_measured",
      "synthetic_fixture",
      "not_publicly_disclosed",
      "not_evaluated"
    ]
  },
