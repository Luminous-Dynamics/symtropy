{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mobility-observer-assurance-v0.1.json",
  "title": "Mobility Observer Common-Cause Assurance Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "claim_id", "claim_scope_commitment", "dependency_profile_commitment",
    "required_independent_observers", "components", "dependency_edges", "channels",
    "scenarios", "samples"
  ],
  "properties": {
    "version": { "const": "0.1" },
    "claim_id": { "$ref": "#/$defs/identifier" },
    "claim_scope_commitment": { "$ref": "#/$defs/commitment" },
    "dependency_profile_commitment": { "$ref": "#/$defs/commitment" },
    "required_independent_observers": { "type": "integer", "minimum": 2, "maximum": 16 },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "failure_domain_id", "kind"],
        "properties": {
          "component_id": { "$ref": "#/$defs/identifier" },
          "failure_domain_id": { "$ref": "#/$defs/identifier" },
          "kind": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "depends_on_component_id"],
        "properties": {
          "component_id": { "$ref": "#/$defs/identifier" },
          "depends_on_component_id": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id", "source_component_id", "measurement_scope_commitment",
          "calibration_commitment", "clock_profile_id",
          "maximum_time_uncertainty_ns", "maximum_sample_age_ns"
        ],
        "properties": {
          "channel_id": { "$ref": "#/$defs/identifier" },
          "source_component_id": { "$ref": "#/$defs/identifier" },
          "measurement_scope_commitment": { "$ref": "#/$defs/commitment" },
          "calibration_commitment": { "$ref": "#/$defs/commitment" },
          "clock_profile_id": { "$ref": "#/$defs/identifier" },
          "maximum_time_uncertainty_ns": { "type": "integer", "minimum": 1 },
          "maximum_sample_age_ns": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "failed_component_ids"],
        "properties": {
          "scenario_id": { "$ref": "#/$defs/identifier" },
          "failed_component_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/identifier" }
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id", "measurement_scope_commitment", "calibration_commitment",
          "clock_profile_id", "time_uncertainty_ns", "observed_at_ns", "evaluated_at_ns",
          "calibration_valid", "placement_scope_matches", "operating_envelope_matches",
          "raw_evidence_commitment"
        ],
        "properties": {
          "channel_id": { "$ref": "#/$defs/identifier" },
          "measurement_scope_commitment": { "$ref": "#/$defs/commitment" },
          "calibration_commitment": { "$ref": "#/$defs/commitment" },
          "clock_profile_id": { "$ref": "#/$defs/identifier" },
          "time_uncertainty_ns": { "type": "integer", "minimum": 0 },
          "observed_at_ns": { "type": "integer", "minimum": 0 },
          "evaluated_at_ns": { "type": "integer", "minimum": 0 },
          "calibration_valid": { "type": "boolean" },
          "placement_scope_matches": { "type": "boolean" },
          "operating_envelope_matches": { "type": "boolean" },
          "raw_evidence_commitment": { "$ref": "#/$defs/commitment" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" },
    "commitment": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
