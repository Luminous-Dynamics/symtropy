{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/rrvr/matched-benchmark-pairs-v0.2.schema.json",
  "title": "RRVR Matched Benchmark Pair Manifest v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "claim_ceiling",
    "campaign_id",
    "profile_sha256",
    "oracle_revision",
    "pairs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "benchmark": {
      "const": "RRVR-MATCHED-CAMPAIGN"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "oracle_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pair"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\\\S"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "task_id",
        "policy_sha256",
        "scene_sha256",
        "initial_state_sha256",
        "action_prefix_sha256",
        "seed",
        "simulator_profile_sha256",
        "fault_schedule_sha256",
        "observer_profile_sha256",
        "expected_disposition",
        "arms"
      ],
      "properties": {
        "pair_id": {
          "$ref": "#/$defs/id"
        },
        "task_id": {
          "$ref": "#/$defs/id"
        },
        "policy_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scene_sha256": {
          "$ref": "#/$defs/digest"
        },
        "initial_state_sha256": {
          "$ref": "#/$defs/digest"
        },
        "action_prefix_sha256": {
          "$ref": "#/$defs/digest"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "simulator_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "fault_schedule_sha256": {
          "$ref": "#/$defs/digest"
        },
        "observer_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "expected_disposition": {
          "enum": [
            "applied",
            "no_effect",
            "partial",
            "unknown",
            "disputed",
            "not_applicable"
          ]
        },
        "arms": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arm_id",
              "implementation_sha256",
              "native_benchmark_preserved",
              "qualification_tier"
            ],
            "properties": {
              "arm_id": {
                "enum": [
                  "native",
                  "east_validity",
                  "roborecover_deviation",
                  "restart_retry",
                  "journal_only",
                  "journal_injector",
                  "endpoint_fenced",
                  "graph_temporal_closure",
                  "full_rrvr"
                ]
              },
              "implementation_sha256": {
                "$ref": "#/$defs/digest"
              },
              "native_benchmark_preserved": {
                "const": true
              },
              "qualification_tier": {
                "enum": [
                  "schema",
                  "formal",
                  "software",
                  "process_fault",
                  "simulator",
                  "hil",
                  "physical",
                  "independent_assessment"
                ]
              },
              "unavailable_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
