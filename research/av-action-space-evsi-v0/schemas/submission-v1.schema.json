{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/av-action-space-evsi-submission-v1.schema.json",
  "title":"AV Action-Space EVSI Candidate Submission v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","policy_id","run_id","predictions"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"av-action-space-evsi-v0"},
    "policy_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "predictions":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["episode_id","transcript_head_sha256","forecast_tick","selected_action_id","forecasts"],
        "properties":{
          "episode_id":{"type":"string","minLength":1},
          "transcript_head_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
          "forecast_tick":{"type":"integer","minimum":0},
          "selected_action_id":{"type":"string","minLength":1},
          "forecasts":{
            "type":"array","minItems":2,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["action_id","estimated_gross_evsi","lower_gross_evsi","upper_gross_evsi"],
              "properties":{
                "action_id":{"type":"string","minLength":1},
                "estimated_gross_evsi":{"type":"number"},
                "lower_gross_evsi":{"type":"number"},
                "upper_gross_evsi":{"type":"number"}
              }
            }
          }
        }
      }
    }
  }
}
