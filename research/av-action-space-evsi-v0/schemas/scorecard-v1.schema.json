{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/av-action-space-evsi-scorecard-v1.schema.json",
  "title":"AV Action-Space EVSI Scorecard v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","policy_id","run_id","totals","episodes"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"av-action-space-evsi-v0"},
    "policy_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "totals":{
      "type":"object","additionalProperties":false,
      "required":["episode_count","forecast_count","action_space_coverage","gross_evsi_mae","gross_evsi_signed_bias","net_evsi_mae","net_evsi_signed_bias","forecast_interval_alpha","forecast_interval_coverage","forecast_interval_mean_width","forecast_interval_winkler_score","pairwise_rank_accuracy","pairwise_rank_pairs","missed_best_action_count","decision_regret_total","decision_regret_mean","oracle_action_selection_accuracy"],
      "properties":{
        "episode_count":{"type":"integer","minimum":0},
        "forecast_count":{"type":"integer","minimum":0},
        "action_space_coverage":{"type":"number","minimum":0,"maximum":1},
        "gross_evsi_mae":{"type":"number","minimum":0},
        "gross_evsi_signed_bias":{"type":"number"},
        "net_evsi_mae":{"type":"number","minimum":0},
        "net_evsi_signed_bias":{"type":"number"},
        "forecast_interval_alpha":{"const":0.1},
        "forecast_interval_coverage":{"type":"number","minimum":0,"maximum":1},
        "forecast_interval_mean_width":{"type":"number","minimum":0},
        "forecast_interval_winkler_score":{"type":"number","minimum":0},
        "pairwise_rank_accuracy":{"type":"number","minimum":0,"maximum":1},
        "pairwise_rank_pairs":{"type":"integer","minimum":0},
        "missed_best_action_count":{"type":"integer","minimum":0},
        "decision_regret_total":{"type":"number","minimum":0},
        "decision_regret_mean":{"type":"number","minimum":0},
        "oracle_action_selection_accuracy":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "episodes":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["episode_id","selected_action_id","oracle_best_action_ids","selected_action_feasible","missed_best_action","decision_regret","best_feasible_net_evsi"],
        "properties":{
          "episode_id":{"type":"string","minLength":1},
          "selected_action_id":{"type":"string","minLength":1},
          "oracle_best_action_ids":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "selected_action_feasible":{"const":true},
          "missed_best_action":{"type":"boolean"},
          "decision_regret":{"type":"number","minimum":0},
          "best_feasible_net_evsi":{"type":"number"}
        }
      }
    }
  }
}
