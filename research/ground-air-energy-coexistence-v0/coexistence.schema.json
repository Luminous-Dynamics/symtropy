{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ground-air-energy-coexistence-v0.schema.json",
  "title": "Ground-air wireless energy coexistence episode v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "disposition",
    "evidence_class",
    "site",
    "sources",
    "channels",
    "sessions",
    "allocations",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "ground-air-energy-coexistence-v0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "disposition": {
      "enum": [
        "NOT_RUN",
        "PASS_SYNTHETIC",
        "INCOMPLETE",
        "SOURCE_LIMIT_BREACH",
        "CHANNEL_LIMIT_BREACH",
        "IDENTITY_CONFLICT",
        "OUT_OF_DOMAIN",
        "COEXISTENCE_UNRESOLVED",
        "SAFETY_UNQUALIFIED",
        "ENERGY_ACCOUNTING_UNRESOLVED",
        "INVALID"
      ]
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC_KNOWN_TRUTH",
        "SIMULATED",
        "LAB_MEASURED",
        "FIELD_MEASURED"
      ]
    },
    "site": {
      "type": [
        "object",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "channels": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "sessions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "allocations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "NOT_RUN"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "evidence_class": {
            "const": "SYNTHETIC_KNOWN_TRUTH"
          },
          "site": {
            "type": "null"
          },
          "sources": {
            "maxItems": 0
          },
          "channels": {
            "maxItems": 0
          },
          "sessions": {
            "maxItems": 0
          },
          "allocations": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "site": {
            "$ref": "#/$defs/site"
          },
          "sources": {
            "minItems": 1
          },
          "channels": {
            "minItems": 1
          },
          "sessions": {
            "minItems": 1
          },
          "allocations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "topology_sha256",
        "pcc_max_import_w",
        "bus_architecture",
        "jurisdiction"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "topology_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pcc_max_import_w": {
          "type": "integer",
          "minimum": 1
        },
        "bus_architecture": {
          "enum": [
            "SHARED_DC_BUS",
            "SEPARATE_CONVERTER_BUSES",
            "AC_DISTRIBUTION_WITH_LOCAL_CONVERTERS"
          ]
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "airspace_site_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "roadway_site_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "maximum_power_w",
        "evidence_class",
        "source_artifact_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_type": {
          "enum": [
            "GRID",
            "RENEWABLE",
            "STATIONARY_STORAGE",
            "GENERATOR",
            "OTHER_QUALIFIED_SOURCE"
          ]
        },
        "maximum_power_w": {
          "type": "integer",
          "minimum": 0
        },
        "available_energy_wh": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "evidence_class": {
          "enum": [
            "SYNTHETIC_KNOWN_TRUTH",
            "SIMULATED",
            "LAB_MEASURED",
            "FIELD_MEASURED"
          ]
        },
        "source_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "domain",
        "modality",
        "transmitter_config_sha256",
        "maximum_input_power_w",
        "envelope_sha256",
        "support_state",
        "coexistence_state",
        "safety_state"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "domain": {
          "enum": [
            "GROUND",
            "AIR"
          ]
        },
        "modality": {
          "enum": [
            "GROUND_DYNAMIC_INDUCTIVE",
            "GROUND_STATIC_INDUCTIVE",
            "AIR_DOCK_INDUCTIVE",
            "AIR_DOCK_CAPACITIVE",
            "AIR_HOVER_INDUCTIVE",
            "AIR_HOVER_CAPACITIVE",
            "AIR_RF_POWER_BEAMING",
            "AIR_OPTICAL_POWER_BEAMING"
          ]
        },
        "transmitter_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "maximum_input_power_w": {
          "type": "integer",
          "minimum": 0
        },
        "envelope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "support_state": {
          "enum": [
            "WITHIN_VALIDATED_SUPPORT",
            "PARTIALLY_OUT_OF_DOMAIN",
            "OUT_OF_DOMAIN",
            "UNRESOLVED"
          ]
        },
        "coexistence_state": {
          "enum": [
            "QUALIFIED_FOR_DECLARED_CASE",
            "NOT_QUALIFIED",
            "UNKNOWN",
            "CONFLICT"
          ]
        },
        "safety_state": {
          "enum": [
            "QUALIFIED_FOR_DECLARED_CASE",
            "NOT_QUALIFIED",
            "UNKNOWN",
            "CONFLICT"
          ]
        },
        "meter_boundary_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "receiver_domain",
        "receiver_class",
        "channel_id",
        "start_ns",
        "end_ns",
        "requested_useful_energy_wh",
        "minimum_useful_energy_wh",
        "maximum_source_power_w",
        "priority",
        "authorization_receipt_sha256",
        "evidence_class"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "receiver_domain": {
          "enum": [
            "GROUND",
            "AIR"
          ]
        },
        "receiver_class": {
          "enum": [
            "ROAD_CAR",
            "ROAD_BUS",
            "ROAD_HEAVY_TRUCK",
            "UAV_DOCKED",
            "UAV_HOVERING",
            "UAV_FIXED_WING",
            "EVTOL_DOCKED",
            "EVTOL_AIRBORNE"
          ]
        },
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 1
        },
        "requested_useful_energy_wh": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_useful_energy_wh": {
          "type": "integer",
          "minimum": 0
        },
        "maximum_source_power_w": {
          "type": "integer",
          "minimum": 0
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "trajectory_or_mission_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_class": {
          "enum": [
            "SYNTHETIC_KNOWN_TRUTH",
            "SIMULATED",
            "LAB_MEASURED",
            "FIELD_MEASURED"
          ]
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "source_id",
        "channel_id",
        "start_ns",
        "end_ns",
        "allocated_source_power_w"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "channel_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 1
        },
        "allocated_source_power_w": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_sessions",
        "maximum_channels",
        "maximum_episode_duration_ns",
        "implicit_coupling_forbidden",
        "unknown_safety_state_rejects"
      ],
      "properties": {
        "maximum_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maximum_channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maximum_episode_duration_ns": {
          "type": "integer",
          "minimum": 1
        },
        "implicit_coupling_forbidden": {
          "const": true
        },
        "unknown_safety_state_rejects": {
          "const": true
        }
      }
    }
  }
}
