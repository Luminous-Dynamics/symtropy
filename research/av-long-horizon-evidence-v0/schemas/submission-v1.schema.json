{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-long-horizon-submission-v1.schema.json",
  "title": "Long-Horizon AV Evidence Candidate Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "policy_id",
    "run_id",
    "memory_condition",
    "model_revision",
    "runtime_revision",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "av-long-horizon-evidence-v0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_condition": {
      "enum": [
        "recent_window",
        "summary_only",
        "episodic_retrieval",
        "evidence_ledger"
      ]
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id",
          "decision",
          "answer",
          "confidence",
          "cited_observation_refs",
          "current_observation_refs",
          "claimed_independent_corroboration",
          "claimed_cross_clock_order",
          "evidence_as_of_tick",
          "response_tick",
          "claimed_distinct_event_count",
          "retrieved_memory_item_refs",
          "retained_memory_item_refs",
          "purge_receipts"
        ],
        "properties": {
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "answer",
              "abstain"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cited_observation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "current_observation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claimed_independent_corroboration": {
            "type": "boolean"
          },
          "claimed_cross_clock_order": {
            "type": "boolean"
          },
          "evidence_as_of_tick": {
            "type": "integer",
            "minimum": 0
          },
          "response_tick": {
            "type": "integer",
            "minimum": 0
          },
          "memory_bytes_used": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "memory_tokens_used": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "retrieval_latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "claimed_distinct_event_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "retrieved_memory_item_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "retained_memory_item_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "purge_receipts": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item_ref",
                "status",
                "purge_tick",
                "receipt_id",
                "attestation_level"
              ],
              "properties": {
                "item_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "purged",
                    "retained"
                  ]
                },
                "purge_tick": {
                  "type": "integer",
                  "minimum": 0
                },
                "receipt_id": {
                  "type": "string",
                  "minLength": 1
                },
                "attestation_level": {
                  "const": "candidate_self_reported"
                }
              }
            }
          },
          "input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "energy_joules": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  }
}
