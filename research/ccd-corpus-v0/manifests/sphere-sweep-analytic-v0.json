{
  "schema_version": 1,
  "campaign_id": "symtropy-ccd-sphere-sweep-v0",
  "status": "research_only_no_sota_claim",
  "time_contract": {
    "ccd_hit_toi": "elapsed_seconds",
    "valid_interval": "[0, dt_seconds]",
    "normalized_toi": "toi_seconds / dt_seconds",
    "not_interchangeable": true
  },
  "checked_api": {
    "sphere_sphere": "sphere_sphere_checked",
    "sphere_halfspace": "sphere_halfspace_checked",
    "valid_miss": "Ok(None)",
    "invalid_query": "Err(CcdQueryError)"
  },
  "analytic_fixtures": [
    {
      "id": "sphere-halfspace-10m-1000mps",
      "type": "sphere_halfspace",
      "position_m": [0.0, 10.0, 0.0],
      "velocity_m_per_s": [0.0, -1000.0, 0.0],
      "radius_m": 0.5,
      "plane_normal": [0.0, 1.0, 0.0],
      "plane_offset_m": 0.0,
      "dt_seconds": 0.02,
      "expected_toi_seconds": 0.0095,
      "expected_toi_fraction": 0.475,
      "absolute_tolerance_seconds": 1e-12
    },
    {
      "id": "sphere-sphere-opposing-10mps",
      "type": "sphere_sphere",
      "position_a_m": [0.0, 0.0, 0.0],
      "velocity_a_m_per_s": [10.0, 0.0, 0.0],
      "radius_a_m": 0.5,
      "position_b_m": [5.0, 0.0, 0.0],
      "velocity_b_m_per_s": [-10.0, 0.0, 0.0],
      "radius_b_m": 0.5,
      "dt_seconds": 0.25,
      "expected_toi_seconds": 0.2,
      "expected_toi_fraction": 0.8,
      "absolute_tolerance_seconds": 1e-12
    },
    {
      "id": "grazing-hit",
      "type": "sphere_sphere",
      "position_a_m": [0.0, 0.0],
      "velocity_a_m_per_s": [1.0, 0.0],
      "radius_a_m": 0.5,
      "position_b_m": [5.0, 1.0],
      "velocity_b_m_per_s": [0.0, 0.0],
      "radius_b_m": 0.5,
      "dt_seconds": 5.0,
      "expected_toi_seconds": 5.0,
      "absolute_tolerance_seconds": 1e-12
    },
    {
      "id": "grazing-near-miss",
      "type": "sphere_sphere",
      "position_a_m": [0.0, 0.0],
      "velocity_a_m_per_s": [1.0, 0.0],
      "radius_a_m": 0.5,
      "position_b_m": [5.0, 1.00000001],
      "velocity_b_m_per_s": [0.0, 0.0],
      "radius_b_m": 0.5,
      "dt_seconds": 5.0,
      "expected": "no_hit"
    },
    {
      "id": "halfspace-step-endpoint-hit",
      "type": "sphere_halfspace",
      "position_m": [0.0, 1.5, 0.0],
      "velocity_m_per_s": [0.0, -1.0, 0.0],
      "radius_m": 0.5,
      "plane_normal": [0.0, 1.0, 0.0],
      "plane_offset_m": 0.0,
      "dt_seconds": 1.0,
      "expected_toi_seconds": 1.0,
      "absolute_tolerance_seconds": 1e-12
    },
    {
      "id": "halfspace-step-endpoint-negative-control",
      "type": "sphere_halfspace",
      "position_m": [0.0, 1.5, 0.0],
      "velocity_m_per_s": [0.0, -1.0, 0.0],
      "radius_m": 0.5,
      "plane_normal": [0.0, 1.0, 0.0],
      "plane_offset_m": 0.0,
      "dt_seconds": 0.999999999,
      "expected": "no_hit"
    }
  ],
  "fixed_grid": {
    "count": 1000,
    "formula": "expected_toi_seconds = (separation_m - radius_a_m - radius_b_m) / relative_closing_speed_m_per_s",
    "separation_m": "2.0 + sample_index * 0.03",
    "relative_closing_speed_m_per_s": "1.0 + sample_index * 0.01",
    "radius_a_m": 0.2,
    "radius_b_m": 0.3,
    "dt_seconds": "expected_toi_seconds * 1.01",
    "absolute_tolerance_seconds": "1e-11 * max(expected_toi_seconds, 1.0)"
  },
  "world_integration": {
    "id": "fast-sphere-static-plane",
    "sphere_radius_m": 0.05,
    "initial_position_m": [0.0, 5.0, 0.0],
    "initial_velocity_m_per_s": [0.0, -500.0, 0.0],
    "plane_normal": [0.0, 1.0, 0.0],
    "plane_offset_m": 0.0,
    "dt_seconds": 0.016,
    "discrete_displacement_without_ccd_m": 8.0,
    "minimum_center_height_m": 0.049999,
    "acceptance": {
      "finite_body_state": true,
      "non_finite_body_count": 0,
      "rotation_health_tolerance": 1e-9
    }
  },
  "acceptance": {
    "all_expected_hits_detected": true,
    "all_expected_misses_rejected": true,
    "invalid_inputs_distinct_from_misses": true,
    "toi_seconds_matches_reference": true,
    "common_translation_and_velocity_invariance": true,
    "post_step_no_tunnelling": true,
    "performance_numbers_reported": false,
    "sota_superiority_claimed": false
  }
}