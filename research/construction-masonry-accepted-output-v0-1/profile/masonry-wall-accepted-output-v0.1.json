      "wrong_design_revision",
      "wrong_block_type_or_substitution",
      "critical_omission",
      "wrong_bond_or_pattern",
      "out_of_tolerance_line_level_or_plumb",
      "missing_required_reinforcement_or_lintel",
      "open_critical_defect",
      "uncertainty_not_fit_for_decision",
      "missing_required_acceptance_test"
    ],
    "threshold_policy": "all numeric geometry, bond, joint, material and structural criteria come from the frozen project specification and competent design/inspection authority",
    "partial_acceptance": "only at a predeclared subsegment/feature boundary; never round partial work up to a whole accepted wall unit"
  },
