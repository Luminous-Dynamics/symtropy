      "required_strata": [
        "block_type",
        "wall_thickness",
        "wall_geometry",
        "opening_and_corner_scope"
      ]
    }
  ],
  "acceptance_predicate": {
    "must_bind": [
      "approved_design_revision",
      "wall_segment_id",
      "site_epoch",
      "target_frame",
      "block_identity_and_dimensions",
      "material_batch_and_substitution_status",
      "bond_pattern_and_course",
      "opening_corner_lintel_reinforcement_and_tie_details",
