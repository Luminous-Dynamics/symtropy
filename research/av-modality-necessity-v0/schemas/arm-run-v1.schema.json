{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-modality-arm-run-v1.schema.json",
  "title": "AV Counterfactual Ablation Arm Run v1",
  "description": "One candidate run for a single controlled input-modality mask.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "comparison_id",
    "policy_id",
    "run_id",
    "input_arm",
    "allowed_modalities",
    "model_revision",
    "runtime_revision",
    "hardware_id",
    "seed",
    "workload_ref",
    "protocol_id",
    "shared_config_id",
    "measurement_status",
    "budget",
    "submission"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "av-modality-necessity-v0"
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_arm": {
      "enum": [
        "video_only",
        "audio_only",
        "audio_video"
      ]
    },
    "allowed_modalities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "video"
        ]
      }
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "hardware_id": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "workload_ref": {
      "type": "string",
      "minLength": 1
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "shared_config_id": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_audio_bytes",
        "max_video_frames",
        "max_input_tokens",
        "max_output_tokens",
        "max_response_ms",
        "max_energy_joules"
      ],
      "properties": {
        "max_audio_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_video_frames": {
          "type": "integer",
          "minimum": 0
        },
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_response_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_energy_joules": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "benchmark_id",
        "policy_id",
        "run_id",
        "model_revision",
        "runtime_revision",
        "predictions"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "benchmark_id": {
          "const": "av-modality-necessity-v0"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "predictions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "measurement_status": {
      "enum": [
        "synthetic_reference",
        "measured"
      ]
    }
  }
}
