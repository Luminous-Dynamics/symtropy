{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-modality-policy-submission-v1.schema.json",
  "title": "AV Modality Necessity Candidate Submission v1",
  "description": "Candidate-visible policy outputs. Must not contain evaluator-only truth or labels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "policy_id",
    "run_id",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "av-modality-necessity-v0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "predictions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id",
          "answer",
          "confidence",
          "abstained",
          "used_modalities",
          "used_transcript",
          "cited_observation_refs",
          "claimed_independent_corroboration",
          "claimed_cross_modal_association",
          "evidence_as_of_tick",
          "response_tick"
        ],
        "properties": {
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "abstained": {
            "type": "boolean"
          },
          "used_modalities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "audio",
                "video"
              ]
            }
          },
          "used_transcript": {
            "type": "boolean"
          },
          "cited_observation_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claimed_independent_corroboration": {
            "type": "boolean"
          },
          "claimed_cross_modal_association": {
            "type": "boolean"
          },
          "evidence_as_of_tick": {
            "type": "integer",
            "minimum": 0
          },
          "response_tick": {
            "type": "integer",
            "minimum": 0
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "audio_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "video_frames": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "generated_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "energy_joules": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
