{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/av-pareto-resource-frontier-scorecard-v1.schema.json",
  "title":"AV Pareto Resource Frontier Scorecard v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","comparison_id","measurement_class","matched_identity_sha256","metric_manifest_sha256","hard_constraints_sha256","totals","pareto_frontier_run_ids","budget_slices","runs"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"av-pareto-resource-frontier-v0"},
    "comparison_id":{"type":"string","minLength":1},
    "measurement_class":{"enum":["synthetic","measured"]},
    "matched_identity_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "metric_manifest_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "hard_constraints_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "totals":{
      "type":"object","additionalProperties":false,
      "required":["run_count","eligible_run_count","ineligible_run_count","pareto_frontier_count","single_weighted_score"],
      "properties":{
        "run_count":{"type":"integer","minimum":0},
        "eligible_run_count":{"type":"integer","minimum":0},
        "ineligible_run_count":{"type":"integer","minimum":0},
        "pareto_frontier_count":{"type":"integer","minimum":0},
        "single_weighted_score":{"type":"null"}
      }
    },
    "pareto_frontier_run_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "budget_slices":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["slice_id","eligible_run_ids","frontier_run_ids"],
        "properties":{
          "slice_id":{"type":"string","minLength":1},
          "eligible_run_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
          "frontier_run_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    },
    "runs":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["run_id","policy_id","eligible","reason_codes","pareto_frontier","dominated_by"],
        "properties":{
          "run_id":{"type":"string","minLength":1},
          "policy_id":{"type":"string","minLength":1},
          "eligible":{"type":"boolean"},
          "reason_codes":{"type":"array","items":{"type":"string"}},
          "pareto_frontier":{"type":"boolean"},
          "dominated_by":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
        }
      }
    }
  }
}
