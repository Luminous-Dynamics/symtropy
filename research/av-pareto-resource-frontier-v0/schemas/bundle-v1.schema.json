{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/av-pareto-resource-frontier-v1.schema.json",
  "title":"AV Pareto Resource Frontier Bundle v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","benchmark_id","comparison","runs"],
  "properties":{
    "schema_version":{"const":1},
    "benchmark_id":{"const":"av-pareto-resource-frontier-v0"},
    "comparison":{
      "type":"object","additionalProperties":false,
      "required":["comparison_id","comparison_mode","measurement_class","match_identity","metric_manifest","hard_constraints","budget_slices"],
      "properties":{
        "comparison_id":{"type":"string","minLength":1},
        "comparison_mode":{"enum":["policy_only","system_level"]},
        "measurement_class":{"enum":["synthetic","measured"]},
        "match_identity":{
          "type":"object","additionalProperties":false,
          "required":["protocol_sha256","cohort_sha256","model_sha256","runtime_sha256","hardware_sha256","input_envelope_sha256"],
          "properties":{
            "protocol_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
            "cohort_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
            "model_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
            "runtime_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
            "hardware_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
            "input_envelope_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
          }
        },
        "metric_manifest":{
          "type":"array","minItems":1,
          "items":{
            "type":"object","additionalProperties":false,
            "required":["metric_id","unit","direction","kind","tolerance"],
            "properties":{
              "metric_id":{"type":"string","minLength":1},
              "unit":{"type":"string","minLength":1},
              "direction":{"enum":["maximize","minimize"]},
              "kind":{"enum":["quality","resource","risk"]},
              "tolerance":{"type":"number","minimum":0}
            }
          }
        },
        "hard_constraints":{
          "type":"array",
          "items":{
            "type":"object","additionalProperties":false,
            "required":["metric_id","op","value"],
            "properties":{
              "metric_id":{"type":"string","minLength":1},
              "op":{"enum":["min","max"]},
              "value":{"type":"number"}
            }
          }
        },
        "budget_slices":{
          "type":"array",
          "items":{
            "type":"object","additionalProperties":false,
            "required":["slice_id","constraints"],
            "properties":{
              "slice_id":{"type":"string","minLength":1},
              "constraints":{
                "type":"array",
                "items":{
                  "type":"object","additionalProperties":false,
                  "required":["metric_id","op","value"],
                  "properties":{
                    "metric_id":{"type":"string","minLength":1},
                    "op":{"enum":["min","max"]},
                    "value":{"type":"number"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "runs":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["run_id","policy_id","policy_source_sha256","match_identity","metrics"],
        "properties":{
          "run_id":{"type":"string","minLength":1},
          "policy_id":{"type":"string","minLength":1},
          "policy_source_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
          "match_identity":{"$ref":"#/$defs/matchIdentity"},
          "metrics":{
            "type":"array",
            "items":{
              "type":"object","additionalProperties":false,
              "required":["metric_id","value","unit","status"],
              "properties":{
                "metric_id":{"type":"string","minLength":1},
                "value":{"type":"number"},
                "unit":{"type":"string","minLength":1},
                "status":{"enum":["MEASURED","DERIVED_FROM_MEASUREMENT","SYNTHETIC","ESTIMATED","NOT_MEASURED","NOT_APPLICABLE"]},
                "method":{"type":"string"},
                "evidence_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  },
  "$defs":{
    "matchIdentity":{
      "type":"object","additionalProperties":false,
      "required":["protocol_sha256","cohort_sha256","model_sha256","runtime_sha256","hardware_sha256","input_envelope_sha256"],
      "properties":{
        "protocol_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "cohort_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "model_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "runtime_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "hardware_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "input_envelope_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
      }
    }
  }
}
