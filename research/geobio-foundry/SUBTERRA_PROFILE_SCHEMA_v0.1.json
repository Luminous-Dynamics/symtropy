{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/subterra/profile/v0.1",
  "title": "Subterra Non-Uniform Profile Record v0.1",
  "description": "A station-ordered one-dimensional subterranean survey profile. Unobserved intervals must be explicit. This is geometry evidence, not a structural safety model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_id", "total_length_m", "segments", "notes"],
  "properties": {
    "profile_id": { "type": "string", "minLength": 1 },
    "total_length_m": { "type": "number", "exclusiveMinimum": 0 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "start_m", "end_m", "cross_section"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "start_m": { "type": "number", "minimum": 0 },
          "end_m": { "type": "number", "exclusiveMinimum": 0 },
          "cross_section": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["width_m", "height_m", "roof_thickness_m"],
                "properties": {
                  "width_m": { "$ref": "#/$defs/measurement" },
                  "height_m": { "$ref": "#/$defs/measurement" },
                  "roof_thickness_m": {
                    "oneOf": [
                      { "$ref": "#/$defs/measurement" },
                      { "type": "null" }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "standard_uncertainty", "correlation_group"],
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "standard_uncertainty": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "correlation_group": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
