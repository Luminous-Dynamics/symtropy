{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/research/symmetry-physical-handoff-001/symmetry-physical-handoff-v0.1.schema.json",
  "title": "Luminous symmetry-to-physical evidence handoff v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_mode",
    "handoff_id",
    "source_math_receipt",
    "physical_problem",
    "full_task_semantics",
    "receiver_verification",
    "claims",
    "claim_boundary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "luminous.symmetry_physical_handoff.v0.1"
    },
    "fixture_mode": {
      "enum": [
        "synthetic_example",
        "admissible_receipt"
      ]
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "source_math_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "receipt_id",
        "receipt_sha256",
        "checker_id",
        "checker_version",
        "profile_id",
        "action_id",
        "coordinate_basis_id",
        "metric_id",
        "generator_set_sha256",
        "evidence_class",
        "qualification_status"
      ],
      "properties": {
        "repository": {
          "const": "Luminous-Dynamics/symthaea"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checker_id": {
          "type": "string",
          "minLength": 1
        },
        "checker_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_basis_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "generator_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_class": {
          "enum": [
            "learned_proposal",
            "sampled_numeric",
            "numeric_lie_basis",
            "exact_polynomial_identity",
            "exact_finite_group",
            "formal_proof"
          ]
        },
        "qualification_status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "group_order": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "physical_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "fixture_sha256",
        "coordinate_change",
        "mass_metric_sha256",
        "force_covectors_sha256",
        "constraint_map_sha256",
        "initial_state_sha256",
        "solver_profile_id",
        "integration_method",
        "time_step_seconds",
        "units_profile_id"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "coordinate_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "from_basis_id",
            "to_basis_id",
            "transform_sha256",
            "transformed_mass_metric_sha256"
          ],
          "properties": {
            "kind": {
              "const": "generalized_coordinate_rebasing"
            },
            "from_basis_id": {
              "type": "string",
              "minLength": 1
            },
            "to_basis_id": {
              "type": "string",
              "minLength": 1
            },
            "transform_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "transformed_mass_metric_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "mass_metric_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "force_covectors_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "constraint_map_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "initial_state_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "solver_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "integration_method": {
          "type": "string",
          "minLength": 1
        },
        "time_step_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units_profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "full_task_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_sha256",
        "candidate_domain_sha256",
        "objective_sha256",
        "feasibility_constraints_sha256",
        "initial_and_boundary_conditions_sha256",
        "observable_mapping_sha256",
        "answer_interpretation_sha256"
      ],
      "properties": {
        "task_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_domain_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "objective_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "feasibility_constraints_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "initial_and_boundary_conditions_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observable_mapping_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "answer_interpretation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "receiver_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "checker_id",
        "checker_version",
        "profile_id",
        "status",
        "obligations",
        "receiver_receipt_sha256"
      ],
      "properties": {
        "repository": {
          "const": "Luminous-Dynamics/symtropy"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "checker_id": {
          "type": "string",
          "minLength": 1
        },
        "checker_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "receiver_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "obligations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mass_metric_congruence",
            "force_covector_duality",
            "momentum_one_form",
            "constraint_jacobian",
            "generator_metric_isometry",
            "discrete_step_equivariance",
            "physical_observables",
            "numerical_error_envelope",
            "full_task_semantics"
          ],
          "properties": {
            "mass_metric_congruence": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "force_covector_duality": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "momentum_one_form": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "constraint_jacobian": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "generator_metric_isometry": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "discrete_step_equivariance": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "physical_observables": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "numerical_error_envelope": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            },
            "full_task_semantics": {
              "enum": [
                "PASS",
                "FAIL",
                "INCONCLUSIVE",
                "NOT_APPLICABLE"
              ]
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_step_equivariance_status",
        "physical_equivalence_authority",
        "scientific_search_pruning_authorized"
      ],
      "properties": {
        "physical_step_equivariance_status": {
          "enum": [
            "PASS",
            "FAIL",
            "INCONCLUSIVE",
            "NOT_APPLICABLE"
          ]
        },
        "physical_equivalence_authority": {
          "enum": [
            "NONE",
            "BOUNDED_STEP_MAP_ONLY"
          ]
        },
        "scientific_search_pruning_authorized": {
          "const": false
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "limitations"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claims": {
            "properties": {
              "physical_step_equivariance_status": {
                "const": "PASS"
              }
            },
            "required": [
              "physical_step_equivariance_status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source_math_receipt": {
            "properties": {
              "qualification_status": {
                "const": "PASS"
              }
            },
            "required": [
              "qualification_status"
            ]
          },
          "receiver_verification": {
            "properties": {
              "status": {
                "const": "PASS"
              },
              "obligations": {
                "properties": {
                  "mass_metric_congruence": {
                    "const": "PASS"
                  },
                  "force_covector_duality": {
                    "const": "PASS"
                  },
                  "momentum_one_form": {
                    "const": "PASS"
                  },
                  "constraint_jacobian": {
                    "const": "PASS"
                  },
                  "generator_metric_isometry": {
                    "const": "PASS"
                  },
                  "discrete_step_equivariance": {
                    "const": "PASS"
                  },
                  "physical_observables": {
                    "const": "PASS"
                  },
                  "numerical_error_envelope": {
                    "const": "PASS"
                  },
                  "full_task_semantics": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "claims": {
            "properties": {
              "physical_equivalence_authority": {
                "const": "BOUNDED_STEP_MAP_ONLY"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claims": {
            "properties": {
              "physical_equivalence_authority": {
                "const": "BOUNDED_STEP_MAP_ONLY"
              }
            },
            "required": [
              "physical_equivalence_authority"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "properties": {
              "physical_step_equivariance_status": {
                "const": "PASS"
              }
            }
          },
          "receiver_verification": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_APPLICABLE"
      ]
    }
  }
}
