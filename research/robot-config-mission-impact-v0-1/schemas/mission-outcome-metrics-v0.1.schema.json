{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:robot-config-mission-outcome-metrics:v0.1",
  "title": "ROBOT-CONFIG-MISSION-IMPACT-001 synthetic outcome metrics v0.1",
  "description": "Closed schema for explicitly synthetic A/B outcome and workflow-resource fixtures; not physical measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "visibility",
    "unit",
    "rows",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "robot-config-mission-impact-outcome-metrics-v0.1"
    },
    "benchmark_id": {
      "const": "ROBOT-CONFIG-MISSION-IMPACT-001"
    },
    "visibility": {
      "const": "public_synthetic_development_not_physical_measurements"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "source",
          "target"
        ],
        "properties": {
          "pair_id": {
            "type": "string",
            "pattern": "^MIP-[0-9]{3}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mission_outcome",
              "functional_units_attempted",
              "accepted_units",
              "rejected_units",
              "held_units",
              "aborted_units",
              "unknown_units",
              "not_started_units",
