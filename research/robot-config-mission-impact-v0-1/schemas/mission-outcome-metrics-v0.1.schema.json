              "total_workflow_crew_seconds",
              "energy_wh",
              "operator_interventions",
              "intervention_seconds",
              "reinspection_count",
              "quality"
            ],
            "properties": {
              "mission_outcome": {
                "enum": [
                  "accepted",
                  "rejected",
                  "held",
                  "aborted_safe_hold",
                  "unknown",
                  "not_started"
                ]
              },
              "functional_units_attempted": {
                "type": "integer",
                "minimum": 0
              },
              "accepted_units": {
                "type": "integer",
                "minimum": 0
              },
              "rejected_units": {
                "type": "integer",
                "minimum": 0
              },
              "held_units": {
                "type": "integer",
                "minimum": 0
              },
              "aborted_units": {
                "type": "integer",
                "minimum": 0
              },
              "unknown_units": {
                "type": "integer",
                "minimum": 0
              },
              "not_started_units": {
                "type": "integer",
                "minimum": 0
              },
              "robot_elapsed_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "total_workflow_crew_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "energy_wh": {
                "type": "number",
                "minimum": 0
              },
              "operator_interventions": {
                "type": "integer",
                "minimum": 0
              },
              "intervention_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "reinspection_count": {
                "type": "integer",
                "minimum": 0
              },
              "quality": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "acceptance_tolerance_mm",
                  "signed_error_mm",
                  "expanded_uncertainty_mm",
                  "independent_measurement_ref"
                ],
                "properties": {
                  "acceptance_tolerance_mm": {
                    "type": "number",
                    "minimum": 0
                  },
                  "signed_error_mm": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "expanded_uncertainty_mm": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "independent_measurement_ref": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          },
