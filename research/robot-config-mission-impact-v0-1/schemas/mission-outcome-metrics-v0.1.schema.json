                "minimum": 0
              },
              "not_started_units": {
                "type": "integer",
                "minimum": 0
              },
              "robot_elapsed_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "total_workflow_crew_seconds": {
                "type": "integer",
                "minimum": 0
