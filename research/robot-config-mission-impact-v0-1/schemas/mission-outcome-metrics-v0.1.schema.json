                "minimum": 0
              },
              "intervention_seconds": {
                "type": "integer",
                "minimum": 0
              },
              "reinspection_count": {
                "type": "integer",
                "minimum": 0
              },
              "quality": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "acceptance_tolerance_mm",
                  "signed_error_mm",
                  "expanded_uncertainty_mm",
                  "independent_measurement_ref"
