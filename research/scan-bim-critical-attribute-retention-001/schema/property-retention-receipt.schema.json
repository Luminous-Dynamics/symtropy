{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/scan-bim-critical-attribute-retention-v0.1.json",
  "title": "Scan-to-BIM Requirement-Weighted Property Retention Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "scope",
    "requirements",
    "comparisons"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "receipt_id": {
      "$ref": "#/$defs/id"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableId": {
      "anyOf": [
        {
          "$ref": "#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableHash": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_run_id",
        "scene_id",
        "source_model_revision",
        "target_model_revision",
        "exchange_profile_id",
        "source_ifc_sha256",
        "target_ifc_sha256",
        "requirement_profile_sha256",
        "requirement_completeness",
        "semantic_diff_report_sha256",
        "identity_correspondence_report_sha256",
        "unit_comparison_report_sha256"
      ],
      "properties": {
        "replay_run_id": {
          "$ref": "#/$defs/id"
        },
        "scene_id": {
          "$ref": "#/$defs/id"
        },
        "source_model_revision": {
          "$ref": "#/$defs/id"
        },
        "target_model_revision": {
          "$ref": "#/$defs/id"
        },
        "exchange_profile_id": {
          "$ref": "#/$defs/id"
        },
        "source_ifc_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_ifc_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirement_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requirement_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "semantic_diff_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "identity_correspondence_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unit_comparison_report_sha256": {
          "$ref": "#/$defs/nullableHash"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "source_entity_id",
        "target_entity_id",
        "ifc_entity_type",
        "property_set",
        "property_name",
        "data_type",
        "importance",
        "required"
      ],
      "properties": {
        "requirement_id": {
          "$ref": "#/$defs/id"
        },
        "source_entity_id": {
          "$ref": "#/$defs/id"
        },
        "target_entity_id": {
          "$ref": "#/$defs/id"
        },
        "ifc_entity_type": {
          "$ref": "#/$defs/id"
        },
        "property_set": {
          "$ref": "#/$defs/id"
        },
        "property_name": {
          "$ref": "#/$defs/id"
        },
        "data_type": {
          "$ref": "#/$defs/id"
        },
        "importance": {
          "enum": [
            "critical",
            "important",
            "advisory"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison_record_id",
        "requirement_id",
        "correspondence_event_id",
        "source_entity_id",
        "target_entity_id",
        "source_state",
        "target_state",
        "disposition",
        "source_value_sha256",
        "target_value_sha256",
        "canonical_value_sha256",
        "semantic_finding_id",
        "unit_comparison_finding_id",
        "comparison_evidence_sha256",
        "reason"
      ],
      "properties": {
        "comparison_record_id": {
          "$ref": "#/$defs/id"
        },
        "requirement_id": {
          "$ref": "#/$defs/id"
        },
        "correspondence_event_id": {
          "$ref": "#/$defs/id"
        },
        "source_entity_id": {
          "$ref": "#/$defs/id"
        },
        "target_entity_id": {
          "$ref": "#/$defs/id"
        },
        "source_state": {
          "enum": [
            "present",
            "absent",
            "unknown",
            "unsupported"
          ]
        },
        "target_state": {
          "enum": [
            "present",
            "absent",
            "unknown",
            "unsupported"
          ]
        },
        "disposition": {
          "enum": [
            "preserved_exact",
            "preserved_normalized",
            "changed",
            "lost",
            "added",
            "unsupported",
            "unresolved",
            "absent_both"
          ]
        },
        "source_value_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "target_value_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "canonical_value_sha256": {
          "$ref": "#/$defs/nullableHash"
        },
        "semantic_finding_id": {
          "$ref": "#/$defs/nullableId"
        },
        "unit_comparison_finding_id": {
          "$ref": "#/$defs/nullableId"
        },
        "comparison_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
