{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/construction-site-state-event-v0.1.json",
  "title": "Construction Site State Event v0.1",
  "description": "Versioned JSON wire mapping for SiteEventEnvelope, including exclusive space-time resource reservations. Consumers verify canonical bytes, SHA-256 values and actor signatures before reducer ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "sequence",
    "previous_event_sha256",
    "event_sha256",
    "actor_id",
    "actor_role",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_event_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "event_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_role": {
      "enum": [
        "design_authority",
        "surveyor",
        "robot",
        "referee",
        "site_quality_authority",
        "site_resource_authority",
        "dispatch_coordinator"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/work_package_published"
        },
        {
          "$ref": "#/$defs/station_qualified"
        },
        {
          "$ref": "#/$defs/execution_started"
        },
        {
          "$ref": "#/$defs/robot_observation_recorded"
        },
        {
          "$ref": "#/$defs/referee_assessment_recorded"
        },
        {
          "$ref": "#/$defs/human_waiver_issued"
        },
        {
          "$ref": "#/$defs/resource_catalog_published"
        },
        {
          "$ref": "#/$defs/space_time_reservation_committed"
        },
        {
          "$ref": "#/$defs/space_time_reservation_released"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_entity_id",
        "entity_type"
      ],
      "properties": {
        "design_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "line",
            "point",
            "arc",
            "text",
            "opening",
            "elevation",
            "other"
          ]
        }
      }
    },
    "acceptance_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_abs_xy_residual_mm",
        "max_reference_u95_xy_mm"
      ],
      "properties": {
        "max_abs_xy_residual_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_reference_u95_xy_mm": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_z_residual_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_reference_u95_z_mm": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_endpoint_residual_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "max_abs_z_residual_mm"
            ]
          },
          "then": {
            "required": [
              "max_reference_u95_z_mm"
            ]
          }
        },
        {
          "if": {
            "required": [
              "max_reference_u95_z_mm"
            ]
          },
          "then": {
            "required": [
              "max_abs_z_residual_mm"
            ]
          }
        }
      ]
    },
    "work_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_sha256",
        "source_model_sha256",
        "source_schema_release",
        "ids_spec_sha256",
        "ids_version",
        "ids_engine_build_sha256",
        "design_revision_sha256",
        "frame_id",
        "frame_sha256",
        "transform_sha256",
        "entity_manifest_sha256",
        "acceptance_profile_sha256",
        "entities",
        "acceptance_profile"
      ],
      "properties": {
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "design_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transform_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "acceptance_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "acceptance_profile": {
          "$ref": "#/$defs/acceptance_profile"
        },
        "source_model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_schema_release": {
          "type": "string",
          "minLength": 1
        },
        "ids_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ids_version": {
          "type": "string",
          "minLength": 1
        },
        "ids_engine_build_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "work_package_published": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package"
      ],
      "properties": {
        "kind": {
          "const": "work_package_published"
        },
        "package": {
          "$ref": "#/$defs/work_package"
        }
      }
    },
    "station_qualified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "station_id",
        "frame_sha256",
        "transform_sha256",
        "calibration_sha256"
      ],
      "properties": {
        "kind": {
          "const": "station_qualified"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "station_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transform_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "station_qualification_event_id"
      ],
      "properties": {
        "kind": {
          "const": "execution_started"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "station_qualification_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "robot_observation_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "disposition",
        "robot_receipt_sha256"
      ],
      "properties": {
        "kind": {
          "const": "robot_observation_recorded"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "printed",
            "not_printed",
            "partial",
            "unknown"
          ]
        },
        "robot_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "referee_assessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "residual_x_mm",
            "residual_y_mm",
            "residual_z_mm",
            "endpoint_start_mm",
            "endpoint_end_mm",
            "reference_u95_x_mm",
            "reference_u95_y_mm",
            "reference_u95_z_mm",
            "measurement_receipt_sha256"
          ],
          "properties": {
            "kind": {
              "const": "measured"
            },
            "residual_x_mm": {
              "type": "number"
            },
            "residual_y_mm": {
              "type": "number"
            },
            "residual_z_mm": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "endpoint_start_mm": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "endpoint_end_mm": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference_u95_x_mm": {
              "type": "number",
              "minimum": 0
            },
            "reference_u95_y_mm": {
              "type": "number",
              "minimum": 0
            },
            "reference_u95_z_mm": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "measurement_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "receipt_sha256"
          ],
          "properties": {
            "kind": {
              "const": "no_mark_found"
            },
            "receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "receipt_sha256",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "receipt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "referee_assessment_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "assessment"
      ],
      "properties": {
        "kind": {
          "const": "referee_assessment_recorded"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "$ref": "#/$defs/referee_assessment"
        }
      }
    },
    "human_waiver_issued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "waiver"
      ],
      "properties": {
        "kind": {
          "const": "human_waiver_issued"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "waiver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_entity_id",
            "authority_id",
            "authority_role",
            "reason",
            "scope",
            "waiver_receipt_sha256"
          ],
          "properties": {
            "design_entity_id": {
              "type": "string",
              "minLength": 1
            },
            "authority_id": {
              "type": "string",
              "minLength": 1
            },
            "authority_role": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "waiver_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "execution_interrupted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "reason",
        "interruption_receipt_sha256"
      ],
      "properties": {
        "kind": {
          "const": "execution_interrupted"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "interruption_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "resource_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "definition_sha256"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "exclusive_resource_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "definition_sha256",
        "start_tick",
        "end_tick"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "space_time_reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reservation_id",
        "resource_catalog_sha256",
        "resource_claim_manifest_sha256",
        "claims",
        "package_sha256",
        "design_revision_sha256",
        "entity_id",
        "robot_id",
        "envelope_sha256",
        "readiness_receipt_sha256",
        "occupancy_assessment_receipt_sha256",
        "occupancy_engine_build_sha256",
        "clearance_policy_sha256",
        "site_snapshot_sha256",
        "site_ledger_sequence",
        "site_ledger_event_sha256",
        "site_clock_domain_id",
        "checked_at_tick",
        "valid_until_tick",
        "committed_at_tick",
        "start_tick",
        "end_tick",
        "lease_valid_until_tick"
      ],
      "properties": {
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "resource_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resource_claim_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exclusive_resource_claim"
          }
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "design_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "robot_id": {
          "type": "string",
          "minLength": 1
        },
        "envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "readiness_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "occupancy_assessment_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "occupancy_engine_build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "clearance_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "site_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "site_ledger_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "site_ledger_event_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "site_clock_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "checked_at_tick": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_tick": {
          "type": "integer",
          "minimum": 1
        },
        "committed_at_tick": {
          "type": "integer",
          "minimum": 0
        },
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 1
        },
        "lease_valid_until_tick": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resource_catalog_published": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "catalog_sha256",
        "resources"
      ],
      "properties": {
        "kind": {
          "const": "resource_catalog_published"
        },
        "catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource_definition"
          }
        }
      }
    },
    "space_time_reservation_committed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reservation"
      ],
      "properties": {
        "kind": {
          "const": "space_time_reservation_committed"
        },
        "reservation": {
          "$ref": "#/$defs/space_time_reservation"
        }
      }
    },
    "space_time_reservation_released": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reservation_id",
        "site_clock_domain_id",
        "cleared_at_tick",
        "site_snapshot_sha256",
        "site_ledger_sequence",
        "site_ledger_event_sha256",
        "release_receipt_sha256"
      ],
      "properties": {
        "kind": {
          "const": "space_time_reservation_released"
        },
        "reservation_id": {
          "type": "string",
          "minLength": 1
        },
        "site_clock_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "cleared_at_tick": {
          "type": "integer",
          "minimum": 0
        },
        "site_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "site_ledger_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "site_ledger_event_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
