{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/construction-offline-site-journal-bundle-v0.1.json",
  "title": "Construction Offline Site Journal Bundle v0.1",
  "description": "A same-checkpoint bundle of actor-owned journals. Hashes and signatures must be verified against canonical bytes before calling the reconciliation planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "base_checkpoint",
    "committed_context",
    "journals"
  ],
  "properties": {
    "schema_version": {
      "const": "construction-offline-site-journal-bundle/0.1"
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "base_checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "committed_context": {
      "$ref": "#/$defs/committed_context"
    },
    "journals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/journal"
      }
    },
    "expected_reconciliation": {
      "$ref": "#/$defs/expected_reconciliation"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design_entity_id",
        "entity_type"
      ],
      "properties": {
        "design_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "line",
            "point",
            "arc",
            "text",
            "opening",
            "elevation",
            "other"
          ]
        }
      }
    },
    "acceptance_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_abs_xy_residual_mm",
        "max_reference_u95_xy_mm"
      ],
      "properties": {
        "max_abs_xy_residual_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_reference_u95_xy_mm": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_z_residual_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_reference_u95_z_mm": {
          "type": "number",
          "minimum": 0
        },
        "max_abs_endpoint_residual_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "max_abs_z_residual_mm"
            ]
          },
          "then": {
            "required": [
              "max_reference_u95_z_mm"
            ]
          }
        },
        {
          "if": {
            "required": [
              "max_reference_u95_z_mm"
            ]
          },
          "then": {
            "required": [
              "max_abs_z_residual_mm"
            ]
          }
        }
      ]
    },
    "work_package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_sha256",
        "source_model_sha256",
        "source_schema_release",
        "ids_spec_sha256",
        "ids_version",
        "ids_engine_build_sha256",
        "coordinate_context_sha256",
        "design_revision_sha256",
        "frame_id",
        "frame_sha256",
        "transform_sha256",
        "entity_manifest_sha256",
        "acceptance_profile_sha256",
        "entities",
        "acceptance_profile"
      ],
      "properties": {
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "design_revision_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transform_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "acceptance_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "acceptance_profile": {
          "$ref": "#/$defs/acceptance_profile"
        },
        "source_model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_schema_release": {
          "type": "string",
          "minLength": 1
        },
        "ids_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ids_version": {
          "type": "string",
          "minLength": 1
        },
        "ids_engine_build_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coordinate_context_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "work_package_published": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package"
      ],
      "properties": {
        "kind": {
          "const": "work_package_published"
        },
        "package": {
          "$ref": "#/$defs/work_package"
        }
      }
    },
    "station_qualified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "station_id",
        "frame_sha256",
        "transform_sha256",
        "calibration_sha256"
      ],
      "properties": {
        "kind": {
          "const": "station_qualified"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "station_id": {
          "type": "string",
          "minLength": 1
        },
        "frame_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transform_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibration_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "station_qualification_event_id"
      ],
      "properties": {
        "kind": {
          "const": "execution_started"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "station_qualification_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "robot_observation_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "disposition",
        "robot_receipt_sha256"
      ],
      "properties": {
        "kind": {
          "const": "robot_observation_recorded"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "printed",
            "not_printed",
            "partial",
            "unknown"
          ]
        },
        "robot_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "referee_assessment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "residual_x_mm",
            "residual_y_mm",
            "residual_z_mm",
            "endpoint_start_mm",
            "endpoint_end_mm",
            "reference_u95_x_mm",
            "reference_u95_y_mm",
            "reference_u95_z_mm",
            "measurement_receipt_sha256"
          ],
          "properties": {
            "kind": {
              "const": "measured"
            },
            "residual_x_mm": {
              "type": "number"
            },
            "residual_y_mm": {
              "type": "number"
            },
            "residual_z_mm": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "endpoint_start_mm": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "endpoint_end_mm": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference_u95_x_mm": {
              "type": "number",
              "minimum": 0
            },
            "reference_u95_y_mm": {
              "type": "number",
              "minimum": 0
            },
            "reference_u95_z_mm": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "measurement_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "receipt_sha256"
          ],
          "properties": {
            "kind": {
              "const": "no_mark_found"
            },
            "receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "receipt_sha256",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "receipt_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "referee_assessment_recorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "assessment"
      ],
      "properties": {
        "kind": {
          "const": "referee_assessment_recorded"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "$ref": "#/$defs/referee_assessment"
        }
      }
    },
    "human_waiver_issued": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "waiver"
      ],
      "properties": {
        "kind": {
          "const": "human_waiver_issued"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "waiver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "design_entity_id",
            "authority_id",
            "authority_role",
            "reason",
            "scope",
            "waiver_receipt_sha256"
          ],
          "properties": {
            "design_entity_id": {
              "type": "string",
              "minLength": 1
            },
            "authority_id": {
              "type": "string",
              "minLength": 1
            },
            "authority_role": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "waiver_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "execution_interrupted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "package_sha256",
        "entity_id",
        "attempt_id",
        "reason",
        "interruption_receipt_sha256"
      ],
      "properties": {
        "kind": {
          "const": "execution_interrupted"
        },
        "package_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "interruption_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence": {
                "const": 0
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "properties": {
              "event_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sequence": {
                "minimum": 1
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "properties": {
              "event_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    },
    "committed_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ids",
        "package_sha256s",
        "station_qualification_event_ids",
        "attempt_ids",
        "observed_attempt_ids"
      ],
      "properties": {
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "package_sha256s": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "station_qualification_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_attempt_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "journal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_sequence",
        "previous_record_sha256",
        "record_sha256",
        "event_id",
        "event_content_sha256",
        "actor_id",
        "actor_role",
        "causal_parent_event_ids",
        "payload"
      ],
      "properties": {
        "local_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_record_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "event_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "enum": [
            "design_authority",
            "surveyor",
            "robot",
            "referee",
            "site_quality_authority"
          ]
        },
        "causal_parent_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/work_package_published"
            },
            {
              "$ref": "#/$defs/station_qualified"
            },
            {
              "$ref": "#/$defs/execution_started"
            },
            {
              "$ref": "#/$defs/robot_observation_recorded"
            },
            {
              "$ref": "#/$defs/execution_interrupted"
            },
            {
              "$ref": "#/$defs/referee_assessment_recorded"
            },
            {
              "$ref": "#/$defs/human_waiver_issued"
            }
          ]
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journal_id",
        "site_id",
        "owner_actor_id",
        "base_checkpoint",
        "entries"
      ],
      "properties": {
        "journal_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "owner_actor_id": {
          "type": "string",
          "minLength": 1
        },
        "base_checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/journal_entry"
          }
        }
      }
    },
    "expected_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_ingest",
        "conflict_count",
        "conflict_event_ids"
      ],
      "properties": {
        "can_ingest": {
          "type": "boolean"
        },
        "conflict_count": {
          "type": "integer",
          "minimum": 0
        },
        "conflict_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
