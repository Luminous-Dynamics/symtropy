  "$id": "https://luminousdynamics.io/schemas/construction-integrated-dispatch-readiness-receipt-v0.1.json",
  "title": "Construction Integrated Dispatch Readiness Receipt v0.1",
  "description": "Full non-actuating readiness assessment receipt. The receipt is not a safety permit or actuator authorization; canonical signature verification and consume-time revalidation are required.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dispatchReadinessReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "package_sha256",
        "design_revision_sha256",
        "entity_id",
        "frame_sha256",
        "transform_sha256",
        "robot_id",
        "robot_configuration_sha256",
        "tool_configuration_sha256",
        "payload_configuration_sha256",
        "primitive_manifest_sha256",
        "trajectory_sha256",
        "envelope_sha256",
        "site_snapshot_sha256",
        "dynamic_occupancy_manifest_sha256",
        "actor_manifest_sha256",
        "occupancy_assessment_receipt_sha256",
        "occupancy_engine_build_sha256",
        "clearance_policy_sha256",
        "candidate_pair_count",
        "narrowphase_evaluated_pair_count",
        "site_ledger_sequence",
        "site_ledger_event_sha256",
        "site_clock_domain_id",
        "checked_at_tick",
        "valid_until_tick"
      ],
      "properties": {
        "schema_version": {
          "const": "construction-dispatch-readiness-receipt/0.1"
        },
