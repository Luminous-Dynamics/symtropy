    },
    "dispatch_context_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "work_package_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "station_id": {
      "type": "string",
      "minLength": 1
    },
    "station_qualification_event_id": {
      "type": "string",
      "minLength": 1
    },
    "station_qualification_event_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "task_plan_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stopping_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stopping_qualification_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "robot_brake_configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "operating_condition_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sensor_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "detection_qualification_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_condition_sha256": {
      "$ref": "#/$defs/sha256"
