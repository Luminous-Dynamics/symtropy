        "kind": {
          "enum": [
            "source_model",
            "source_entity",
            "ids_specification",
            "ids_engine_build",
            "ids_evaluation",
            "coordinate_context",
            "coordinate_frame",
            "survey_transform",
            "survey_calibration",
            "station_qualification",
            "robot_configuration",
            "tool_configuration",
