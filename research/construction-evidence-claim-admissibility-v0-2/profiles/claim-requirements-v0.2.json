{"schema_version":"construction-robot-claim-requirements/0.2.1","profiles":[{"profile_id":"synthetic-contract-behavior-v0.2","claim_kind":"synthetic_contract_behavior","description":"Admits claims about a frozen software contract under synthetic inputs only.","requirements":{"acceptable_origins":["synthetic"],"required_independence_status":["not_assessed"],"required_metrology_status":["not_applicable"],"required_digest_status":["digest_only","bytes_verified"],"required_authentication_status":["unsigned","signed","issuer_trust_verified"],"required_custody_status":["local_reference","custody_declared","custody_audited"],"required_odd_coverage_status":["declared_only","partially_measured","measured_by_stratum"],"minimum_replication_status":["single_trial","repeated_same_configuration"],"minimum_independent_encounters":1,"note":"This profile can never support a physical detection, stopping-distance, field-quality or certification claim.","required_replication_dimensions":["same_configuration_repeat"]}},{"profile_id":"bench-stopping-distance-v0.2","claim_kind":"bench_stopping_distance","description":"Admits a stopping-distance claim scoped to one declared bench setup.","requirements":{"acceptable_origins":["bench_measured"],"required_independence_status":["independent_under_profile"],"required_metrology_status":["uncertainty_reviewed","independently_audited"],"required_digest_status":["bytes_verified"],"required_authentication_status":["signed","issuer_trust_verified"],"required_custody_status":["custody_audited"],"required_odd_coverage_status":["measured_by_stratum"],"minimum_replication_status":["repeated_same_configuration","independent_site_replication","independent_configuration_replication"],"minimum_independent_encounters":30,"required_odd_strata":["payload","speed","surface","slope","brake_state","operating_mode"],"note":"The sample target is an initial benchmark protocol target, not a universal safety acceptance threshold.","required_replication_dimensions":["sa