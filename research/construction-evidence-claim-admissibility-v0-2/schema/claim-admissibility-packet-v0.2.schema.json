{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:construction-robot-claim-admissibility:0.2",
  "title": "Construction Robot Claim Admissibility Packet",
  "description": "A claim-by-claim evidence assessment packet. Evidence dimensions are orthogonal; no global evidence rank or composite confidence score exists.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "source_receipt",
    "evidence_units",
    "claims",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "construction-robot-claim-admissibility/0.2"
    },
    "packet_id": {
      "$ref": "#/$defs/id"
    },
    "source_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_schema",
        "receipt_sha256",
        "receipt_trial_id"
      ],
      "properties": {
        "receipt_schema": {
          "const": "construction-robot-physical-trial/0.1"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_trial_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "evidence_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_unit_id",
          "origin",
          "source_refs",
          "independence",
          "metrology",
          "provenance",
          "custody",
          "odd_coverage",
          "replication"
        ],
        "properties": {
          "evidence_unit_id": {
            "$ref": "#/$defs/id"
          },
          "origin": {
            "enum": [
              "synthetic",
              "simulated",
              "bench_measured",
              "hardware_in_loop",
              "field_observed"
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "sha256",
                "role"
              ],
              "properties": {
                "source_id": {
                  "$ref": "#/$defs/id"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            }
          },
          "independence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "profile_ref",
              "assessment_ref",
              "status"
            ],
            "properties": {
              "profile_ref": {
                "$ref": "#/$defs/id"
              },
              "assessment_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "status": {
                "enum": [
                  "not_assessed",
                  "independent_under_profile",
                  "partial",
                  "known_common_mode",
                  "dependence_indeterminate",
                  "same_evidence_path"
                ]
              },
              "unresolved_dependency_classes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "uniqueItems": true
              }
            }
          },
          "metrology": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "calibration_record_refs",
              "uncertainty_budget_ref"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_applicable",
                  "not_assessed",
                  "declared",
                  "calibration_verified",
                  "uncertainty_reviewed",
                  "independently_audited"
                ]
              },
              "calibration_record_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "uniqueItems": true
              },
              "uncertainty_budget_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "digest_status",
              "authentication_status",
              "issuer_ref"
            ],
            "properties": {
              "digest_status": {
                "enum": [
                  "absent",
                  "digest_only",
                  "bytes_verified"
                ]
              },
              "authentication_status": {
                "enum": [
                  "unsigned",
                  "signed",
                  "issuer_trust_verified"
                ]
              },
              "issuer_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              }
            }
          },
          "custody": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "custody_record_ref"
            ],
            "properties": {
              "status": {
                "enum": [
                  "local_reference",
                  "custody_declared",
                  "custody_audited"
                ]
              },
              "custody_record_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              }
            }
          },
          "odd_coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "profile_ref",
              "observed_strata",
              "unmeasured_strata"
            ],
            "properties": {
              "status": {
                "enum": [
                  "declared_only",
                  "partially_measured",
                  "measured_by_stratum"
                ]
              },
              "profile_ref": {
                "$ref": "#/$defs/id"
              },
              "observed_strata": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "uniqueItems": true
              },
              "unmeasured_strata": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "uniqueItems": true
              }
            }
          },
          "replication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "independent_encounters",
              "distinct_sites",
              "distinct_configurations",
              "sampling_policy_ref"
            ],
            "properties": {
              "status": {
                "enum": [
                  "single_trial",
                  "repeated_same_configuration",
                  "independent_site_replication",
                  "independent_configuration_replication"
                ]
              },
              "independent_encounters": {
                "type": "integer",
                "minimum": 0
              },
              "distinct_sites": {
                "type": "integer",
                "minimum": 0
              },
              "distinct_configurations": {
                "type": "integer",
                "minimum": 0
              },
              "sampling_policy_ref": {
                "$ref": "#/$defs/id"
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_kind",
          "statement",
          "requirements_profile_id",
          "requirements_profile_sha256",
          "supporting_evidence_unit_ids",
          "decision",
          "reason_codes",
          "limitations"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/id"
          },
          "claim_kind": {
            "enum": [
              "synthetic_contract_behavior",
              "simulation_conditional_behavior",
              "bench_stopping_distance",
              "hil_protective_stop_behavior",
              "field_human_detection",
              "field_task_quality",
              "field_productivity",
              "cross_site_generalization",
              "other_declared_claim"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "requirements_profile_id": {
            "$ref": "#/$defs/id"
          },
          "requirements_profile_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "supporting_evidence_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          },
          "decision": {
            "enum": [
              "admissible_for_named_claim",
              "inadmissible_for_named_claim",
              "indeterminate",
              "not_evaluated"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator_id",
        "validator_revision",
        "assessment_reference",
        "review_status"
      ],
      "properties": {
        "validator_id": {
          "$ref": "#/$defs/id"
        },
        "validator_revision": {
          "$ref": "#/$defs/id"
        },
        "assessment_reference": {
          "$ref": "#/$defs/id"
        },
        "review_status": {
          "enum": [
            "unreviewed",
            "internal_review",
            "independent_assessor_reviewed"
          ]
        },
        "assessor_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "record_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
