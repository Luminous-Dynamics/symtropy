  "family_decisions": {
    "wren_2": "first product-family research candidate; not a selected design",
    "wayfarer_4": "separate four-seat touring/utility mission family; do not inherit Wren 2 requirements",
    "wren_e": "gated electric-trainer demonstrator; advance only after sortie, reserve, turnaround, battery-life and ownership economics close",
    "ranger_4": "conditional utility/backcountry derivative; separate missions and loads must justify it"
  },
  "comparison_rules": [
    "All candidates compared on identical mission, payload, reserve, atmosphere, wind, surface, obstacle, configuration and lifecycle boundaries.",
    "A ground-roll figure is not an obstacle-clear distance.",
    "Range comparisons require matching payload, power setting, altitude, fuel or battery state, weather and reserve.",
    "Occupant capacity is not useful payload.",
    "Takeoff, landing and contingency mass, CG and inertia states are recomputed separately.",
    "Unknown or out-of-domain inputs yield indeterminate, never feasible.",
    "Hard constraints are not offset by a weighted aggregate score.",
    "The primary metric and total evaluation budget are preregistered before optimizer results are reviewed."
  ],
