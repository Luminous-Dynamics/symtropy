{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/rrvr/aerb-candidate-submission-v0.2.schema.json",
  "title": "AERB Candidate Submission v0.2",
  "description": "Candidate-visible prediction and non-actuating counterfactual policy plan. This schema contains no evaluator truth, actual probe-support partitions, likelihoods, or decision-loss rows. A policy-plan tree is a prediction only and must never be executed as a physical command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "episode_id",
    "candidate_snapshot_sha256",
    "decision_need_sha256",
    "decision_contract_sha256",
    "probe_catalogue_sha256",
    "model_sha256",
    "observer_profile_sha256",
    "actuation_guard",
    "initial_possible_world_support_ids",
    "candidate_predicted_probe_models",
    "counterfactual_policy",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "benchmark": {
      "const": "AERB"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision_need_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "decision_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "probe_catalogue_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "observer_profile_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "actuation_guard": {
      "const": "block_new_effect",
      "description": "The candidate cannot authorize a new physical effect. Independent execution-finality and authority controls own any later admission."
    },
    "initial_possible_world_support_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/world_id"
      },
      "contains": {
        "const": "open_world_residual"
      },
      "description": "Candidate-predicted possible histories at the frozen decision cut. The open-world residual cannot be dropped by a candidate assertion."
    },
    "candidate_predicted_probe_models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/probe_prediction"
      }
    },
    "counterfactual_policy": {
      "$ref": "#/$defs/counterfactual_policy"
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "explanation_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "world_id": {
      "type": "string",
      "enum": [
        "not_dispatched",
        "dispatched_no_effect",
        "applied_once_ack_lost",
        "partial_effect",
        "duplicate_effect",
        "stale_authority_effect",
        "unresolved_command_holder",
        "open_world_residual"
      ]
    },
    "probe_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "outcomes"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/outcome_prediction"
          }
        }
      }
    },
    "outcome_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "possible_world_support_ids"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "possible_world_support_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/world_id"
          }
        }
      }
    },
    "counterfactual_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_node_id",
        "nodes"
      ],
      "properties": {
        "root_node_id": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/policy_node"
          }
        }
      }
    },
    "policy_node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "node_type",
            "counterfactual_only",
            "probe_id",
            "outcome_branches"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "node_type": {
              "const": "probe"
            },
            "counterfactual_only": {
              "const": true
            },
            "probe_id": {
              "type": "string",
              "minLength": 1
            },
            "outcome_branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/outcome_branch"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_id",
            "node_type",
            "counterfactual_only",
            "terminal_disposition"
          ],
          "properties": {
            "node_id": {
              "type": "string",
              "minLength": 1
            },
            "node_type": {
              "const": "terminal"
            },
            "counterfactual_only": {
              "const": true
            },
            "terminal_disposition": {
              "enum": [
                "hold_reconcile",
                "abstain",
                "recommend_fresh_attempt"
              ]
            }
          }
        }
      ]
    },
    "outcome_branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "next_node_id"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1
        },
        "next_node_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
