{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wpt-exact-service-oracle-v0.schema.json",
  "title": "WPT exact temporal service-feasibility scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scenario_id", "evidence_kind", "interval_count",
    "segment_slots", "receivers", "receiver_slots", "transfer_links",
    "quality_flags"
  ],
  "properties": {
    "schema_version": { "const": "wpt-exact-service-oracle-v0" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "evidence_kind": { "const": "SYNTHETIC_KNOWN_TRUTH" },
    "interval_count": { "type": "integer", "minimum": 1, "maximum": 256 },
    "segment_slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "interval_index", "available_deliverable_energy_mwh"],
        "properties": {
          "segment_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "available_deliverable_energy_mwh": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "receivers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiver_id", "arrival_interval", "departure_interval", "minimum_service_mwh"],
        "properties": {
          "receiver_id": { "type": "string", "minLength": 1 },
          "arrival_interval": { "type": "integer", "minimum": 0 },
          "departure_interval": { "type": "integer", "minimum": 1 },
          "minimum_service_mwh": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "receiver_slots": {
      "type": "array",
      "maxItems": 16384,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receiver_id", "interval_index", "max_acceptance_mwh"],
        "properties": {
          "receiver_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "max_acceptance_mwh": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "transfer_links": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["link_id", "segment_id", "receiver_id", "interval_index", "max_deliverable_energy_mwh"],
        "properties": {
          "link_id": { "type": "string", "minLength": 1 },
          "segment_id": { "type": "string", "minLength": 1 },
          "receiver_id": { "type": "string", "minLength": 1 },
          "interval_index": { "type": "integer", "minimum": 0 },
          "max_deliverable_energy_mwh": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "quality_flags": {
      "type": "array",
      "const": ["SYNTHETIC_ONLY"]
    }
  }
}
