{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/black-box-driving-decision-quality-campaign-v1.schema.json",
  "title": "Black-box driving decision-quality campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_episode_ids",
    "expected_decision_ids",
    "expected_surrogate_event_ids",
    "expected_prediction_ids",
    "episodes",
    "decisions",
    "surrogate_events",
    "outcome_predictions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "expected_episode_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "expected_decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "expected_surrogate_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "expected_prediction_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "surrogate_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surrogate_event"
      }
    },
    "outcome_predictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prediction"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "disposition"
      ],
      "properties": {
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "disposition": {
          "enum": [
            "completed",
            "failed",
            "incomplete",
            "censored"
          ]
        }
      }
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "enter_timestamp_us",
        "exit_timestamp_us"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/id"
        },
        "enter_timestamp_us": {
          "type": "integer",
          "minimum": 0
        },
        "exit_timestamp_us": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "occupancy_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_a",
        "actor_b"
      ],
      "properties": {
        "actor_a": {
          "$ref": "#/$defs/occupancy"
        },
        "actor_b": {
          "$ref": "#/$defs/occupancy"
        }
      }
    },
    "surrogate_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "episode_id",
        "decision_id",
        "actor_a_id",
        "actor_b_id",
        "gap_m",
        "closing_speed_mps",
        "analysis_horizon_s",
        "measurement_source_revision",
        "evidence_sha256"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "actor_a_id": {
          "$ref": "#/$defs/id"
        },
        "actor_b_id": {
          "$ref": "#/$defs/id"
        },
        "gap_m": {
          "type": "number",
          "minimum": 0
        },
        "closing_speed_mps": {
          "type": "number"
        },
        "analysis_horizon_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "conflict_occupancy": {
          "oneOf": [
            {
              "$ref": "#/$defs/occupancy_pair"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_source_revision": {
          "$ref": "#/$defs/id"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_id",
        "episode_id",
        "decision_id",
        "action_id",
        "predicted_collision_probability",
        "realized_collision_within_horizon",
        "prediction_horizon_s",
        "outcome_source",
        "prediction_model_revision",
        "outcome_evidence_sha256"
      ],
      "properties": {
        "prediction_id": {
          "$ref": "#/$defs/id"
        },
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "predicted_collision_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "realized_collision_within_horizon": {
          "type": "boolean"
        },
        "prediction_horizon_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "outcome_source": {
          "enum": [
            "forward_simulation",
            "counterfactual_simulation",
            "observed_physical"
          ]
        },
        "prediction_model_revision": {
          "$ref": "#/$defs/id"
        },
        "outcome_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_family",
        "actor_class",
        "road_context",
        "weather",
        "visibility",
        "sensor_fault_family",
        "decision_mode"
      ],
      "properties": {
        "scenario_family": {
          "$ref": "#/$defs/id"
        },
        "actor_class": {
          "$ref": "#/$defs/id"
        },
        "road_context": {
          "$ref": "#/$defs/id"
        },
        "weather": {
          "$ref": "#/$defs/id"
        },
        "visibility": {
          "$ref": "#/$defs/id"
        },
        "sensor_fault_family": {
          "$ref": "#/$defs/id"
        },
        "decision_mode": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "action_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "objective_cost",
        "hard_safety_violation",
        "counterfactual_evidence_sha256"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "objective_cost": {
          "type": "number"
        },
        "hard_safety_violation": {
          "type": "boolean"
        },
        "counterfactual_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "episode_id",
        "decision_tick",
        "selected_action_id",
        "objective_id",
        "objective_revision",
        "counterfactual_evaluator_revision",
        "simulator_revision",
        "objective_cost_unit",
        "context",
        "diagnostic_tags",
        "actions"
      ],
      "properties": {
        "decision_id": {
          "$ref": "#/$defs/id"
        },
        "episode_id": {
          "$ref": "#/$defs/id"
        },
        "decision_tick": {
          "type": "integer",
          "minimum": 0
        },
        "selected_action_id": {
          "$ref": "#/$defs/id"
        },
        "objective_id": {
          "$ref": "#/$defs/id"
        },
        "objective_revision": {
          "$ref": "#/$defs/id"
        },
        "counterfactual_evaluator_revision": {
          "$ref": "#/$defs/id"
        },
        "simulator_revision": {
          "$ref": "#/$defs/id"
        },
        "objective_cost_unit": {
          "$ref": "#/$defs/id"
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "diagnostic_tags": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/action_outcome"
          }
        }
      }
    }
  },
  "x-invariants": [
    "Expected and observed episode, decision, surrogate-event and prediction IDs reconcile exactly; failures and incomplete/censored episodes remain in the denominator.",
    "TTC is only meaningful when gap and relative closing speed refer to the same conflict path and axis. Already-overlapping and non-closing states have explicit statuses.",
    "DRAC uses the constant relative-speed longitudinal formula and is a surrogate, not a full vehicle-dynamics/braking model.",
    "PET is calculated from conflict-zone occupancy intervals; missing occupancy must remain null rather than being inferred.",
    "Brier/log-loss/calibration outputs are separated by outcome source, prediction model revision and prediction horizon.",
    "Counterfactual action costs are compared only inside the decision's pinned objective, objective revision, evaluator revision and simulator revision.",
    "A selected hard-safety-violating action is not assigned feasible regret; avoidability is reported separately when a feasible alternative exists.",
    "Tier 4 groups include objective/evaluator/simulator identity and cost unit so incompatible counterfactual costs are never pooled.",
    "Evidence digests are unkeyed integrity references, not signatures or proof of physical truth."
  ]
}
