{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/cdaab/run-receipt/v0.1",
  "title": "CDAAB reproducible run receipt v0.1",
  "description": "Evidence-bearing receipt for one frozen benchmark run. A PASS label is not allowed without all required artifacts, counts, denominators and independent evaluator identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "version",
    "run_id",
    "plan_digest",
    "manifest_digest",
    "evaluator_digest",
    "candidate",
    "hardware_digest",
    "runtime_digest",
    "scenario_set_digest",
    "randomization_commitment",
    "episode_receipts",
    "aggregate_counts",
    "run_status"
  ],
  "properties": {
    "benchmark_id": {
      "const": "CDAAB"
    },
    "version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evaluator_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate": {
      "$ref": "#/$defs/build"
    },
    "hardware_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenario_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "randomization_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "episode_receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "aggregate_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numerator",
          "denominator"
        ],
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "excluded_episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "episode_id",
          "scenario_id",
          "reason_code",
          "reason"
        ],
        "properties": {
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "independent_evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "receipt_digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "run_status": {
      "enum": [
        "complete",
        "incomplete",
        "invalidated",
        "aborted"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"run_status": {"const": "complete"}},
        "required": ["run_status"]
      },
      "then": {
        "properties": {
          "episode_receipts": {"minItems": 1},
          "aggregate_counts": {"minProperties": 1}
        }
      }
    }
  ],
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "source_commit",
        "artifact_digest",
        "runtime_digest"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "scenario_id",
        "cluster_keys",
        "controller_event_log_digest",
        "evaluator_result_digest",
        "status"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "cluster_keys": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "controller_event_log_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evaluator_result_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": [
            "completed",
            "incomplete",
            "safety_stop",
            "integrity_stop"
          ]
        }
      }
    }
  }
}