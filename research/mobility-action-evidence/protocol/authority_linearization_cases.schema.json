{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/cdaab-mutation-linearization-v0-1/research/mobility-action-evidence/protocol/authority_linearization_cases.schema.json",
  "title": "CDAAB authority-linearized mutation public conformance cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tracking_issue",
    "status",
    "controller_visible",
    "evaluator_truth_embedded",
    "confirmatory_evaluation_requires_separate_hidden_schedule_set",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "cdaab-authority-linearization-cases/0.1"
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "const": "public_conformance_fixtures"
    },
    "controller_visible": {
      "const": true
    },
    "evaluator_truth_embedded": {
      "const": true
    },
    "confirmatory_evaluation_requires_separate_hidden_schedule_set": {
      "const": true
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "family",
          "schedule",
          "mutations",
          "expected_disposition",
          "expected_native_sink_calls"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^AL[0-9]{2}-[a-z0-9-]+$"
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "schedule": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mutations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_disposition": {
            "type": "string",
            "minLength": 1
          },
          "expected_native_sink_calls": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
