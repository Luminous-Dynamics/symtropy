      "native_sink_calls": 1,
      "pending_mutation": true
    },
    {
      "case_id": "configuration-drift",
      "class": "negative",
      "trigger": "Platform configuration digest changes after enqueue.",
      "expected": "RejectedBeforeSink",
      "native_sink_calls": 0,
      "pending_mutation": false
    },
    {
      "case_id": "odd-revision-drift",
      "class": "negative",
