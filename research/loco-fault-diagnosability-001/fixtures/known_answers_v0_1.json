    "physical_fault_set_digest": "fault-set-v1",
    "model_digest": "model-v1",
    "actuator_digest": "actuator-v1",
    "domain_digest": "domain-v1",
    "sensor_manifest_digest": "sensors-v1",
    "calibration_digest": "calibration-v1",
    "clock_map_digest": "clock-v1",
    "max_cross_channel_skew_ns": 20,
    "feature_schema_source_policy": "Each feature binds its own source ID, mapped monotonic timestamp and maximum age."
  },
  "feature_schema": [
    {
      "feature_id": "joint_velocity_residual",
      "source_id": "joint-encoder-source-1",
      "unit_id": "mrad_per_s",
      "max_age_ns": 100,
      "common_cause_group": "joint-encoder-1"
    },
    {
      "feature_id": "motor_current_residual",
      "source_id": "motor-current-source-1",
      "unit_id": "milliamp",
      "max_age_ns": 100,
      "common_cause_group": "current-sensor-1"
