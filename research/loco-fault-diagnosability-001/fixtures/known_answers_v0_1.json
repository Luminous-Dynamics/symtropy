          "features": [
            {
              "feature_id": "joint_velocity_residual",
              "unit_id": "mrad_per_s",
              "lower": 40,
              "upper": 60
            },
            {
              "feature_id": "motor_current_residual",
              "unit_id": "milliamp",
              "lower": 10,
              "upper": 30
            }
          ]
        }
      ],
      "expected": {
        "pair_status": "separable",
        "separating_feature": "joint_velocity_residual"
      }
    },
    {
