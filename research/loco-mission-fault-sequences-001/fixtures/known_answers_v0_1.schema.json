{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LOCO-MISSION-FAULT-SEQUENCES-001 known-answer corpus",
  "type": "object",
  "required": [
    "protocol",
    "version",
    "evidence_tier",
    "notes",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "LOCO-MISSION-FAULT-SEQUENCES-001"
    },
    "version": {
      "const": "0.1"
    },
    "evidence_tier": {
      "const": "synthetic_known_answer"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "str": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "required": [
        "soc_mwh",
        "thermal_headroom_mj",
        "actuator_authority_ppm",
        "recovery_energy_mwh",
        "topology_independent_routes",
        "recovery_energy_mwh",
        "terminal_safe_stop_required_energy_mwh"
      ],
      "additionalProperties": false,
      "properties": {
        "soc_mwh": {
          "type": "integer"
        },
        "thermal_headroom_mj": {
          "type": "integer"
        },
        "actuator_authority_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "recovery_energy_mwh": {
          "type": "integer",
          "minimum": 0
        },
        "topology_independent_routes": {
          "type": "integer",
          "minimum": 0
        },
        "terminal_safe_stop_required_energy_mwh": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "event_id",
        "energy_cost_mwh",
        "thermal_cost_mj",
        "authority_loss_ppm",
        "qualified",
        "minimum_authority_required_ppm",
        "recovery_budget_cost_mwh"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/str"
        },
        "energy_cost_mwh": {
          "type": "integer",
          "minimum": 0
        },
        "thermal_cost_mj": {
          "type": "integer"
        },
        "authority_loss_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "qualified": {
          "type": "boolean"
        },
        "minimum_authority_required_ppm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "recovery_budget_cost_mwh": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operation": {
      "type": [
        "object",
        "null"
      ]
    },
    "expected": {
      "type": "object",
      "required": [
        "qualification"
      ],
      "additionalProperties": true,
      "properties": {
        "qualification": {
          "enum": [
            "VALID",
            "REJECTED",
            "UNKNOWN",
            "INVALID"
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "initial_state",
        "events",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/str"
        },
        "initial_state": {
          "$ref": "#/$defs/state"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "event_sequences": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/event"
            }
          }
        },
        "operation_between_events": {
          "$ref": "#/$defs/operation"
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
