    ],
    "network_transport": [
      "transient_pressure",
      "defect_ingress"
    ],
    "chemical_fate": [
      "network_transport"
    ]
  },
  "required_observation_kinds": [
    "pressure_trace",
    "signed_defect_flow",
    "tracer_sample"
