{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/physical-storage/preservation_robust_portfolio_cases_v0_1.schema.json",
  "title": "Preservation Robust Portfolio Case Corpus v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scenario": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "bound": {
      "type": "object",
      "required": [
        "scenario_id",
        "cost_upper_microunits",
        "energy_upper_millijoules",
        "duration_upper_ms",
        "downtime_upper_ms",
        "evidence_status",
        "receipt_id",
        "receipt_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "cost_upper_microunits": {
          "type": "integer",
          "minimum": 0
        },
        "energy_upper_millijoules": {
          "type": "integer",
          "minimum": 0
        },
        "duration_upper_ms": {
          "type": "integer",
          "minimum": 0
        },
        "downtime_upper_ms": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_status": {
          "enum": [
            "verified",
            "unverified",
            "invalid"
          ]
        },
        "receipt_id": {
          "$ref": "#/$defs/id"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "addresses_alert_ids",
        "depends_on_action_ids",
        "prerequisite_evidence_ids",
        "required_approvals",
        "required_postcondition_evidence",
        "currency_code",
        "preserves_source_until_acceptance",
        "destructive",
        "scenario_bounds"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "addresses_alert_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "depends_on_action_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "prerequisite_evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "required_approvals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "required_postcondition_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "currency_code": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "preserves_source_until_acceptance": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "scenario_bounds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/bound"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "scenario_catalog",
        "policy",
        "actions",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "scenario_catalog": {
          "type": "object",
          "required": [
            "scenario_set_id",
            "scenario_set_sha256",
            "scenarios"
          ],
          "additionalProperties": false,
          "properties": {
            "scenario_set_id": {
              "$ref": "#/$defs/id"
            },
            "scenario_set_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "scenarios": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/scenario"
              }
            }
          }
        },
        "policy": {
          "type": "object",
          "required": [
            "target_id",
            "unresolved_alert_ids",
            "available_evidence_ids",
            "available_approval_ids",
            "currency_code",
            "max_cost_microunits",
            "max_energy_millijoules",
            "max_duration_ms",
            "max_downtime_ms",
            "max_actions"
          ],
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "$ref": "#/$defs/id"
            },
            "unresolved_alert_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "available_evidence_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "available_approval_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "currency_code": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "max_cost_microunits": {
              "type": "integer",
              "minimum": 0
            },
            "max_energy_millijoules": {
              "type": "integer",
              "minimum": 0
            },
            "max_duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "max_downtime_ms": {
              "type": "integer",
              "minimum": 0
            },
            "max_actions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "expected": {
          "type": "object",
          "required": [
            "disposition",
            "frontier",
            "excluded_action_ids"
          ],
          "additionalProperties": false,
          "properties": {
            "disposition": {
              "enum": [
                "NoActionRequired",
                "Feasible",
                "Infeasible",
                "EvidenceIncomplete",
                "InvalidEvidence"
              ]
            },
            "frontier": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "action_ids",
                  "worst_case_objectives",
                  "limiting_scenarios"
                ],
                "additionalProperties": false,
                "properties": {
                  "action_ids": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "uniqueItems": true
                  },
                  "worst_case_objectives": {
                    "type": "object",
                    "required": [
                      "cost_upper_microunits",
                      "energy_upper_millijoules",
                      "duration_upper_ms",
                      "downtime_upper_ms",
                      "action_count"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "cost_upper_microunits": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "energy_upper_millijoules": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "duration_upper_ms": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "downtime_upper_ms": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "action_count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "limiting_scenarios": {
                    "type": "object",
                    "required": [
                      "cost",
                      "energy",
                      "duration",
                      "downtime"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "cost": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/id"
                        },
                        "uniqueItems": true
                      },
                      "energy": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/id"
                        },
                        "uniqueItems": true
                      },
                      "duration": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/id"
                        },
                        "uniqueItems": true
                      },
                      "downtime": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/id"
                        },
                        "uniqueItems": true
                      }
                    }
                  }
                }
              }
            },
            "excluded_action_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}