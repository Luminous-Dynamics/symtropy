{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/water-service-engineering/observability-qualification/scenarios-v0.1.schema.json",
  "title": "Water Network Failure-Domain Observability Qualification Scenario Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "profile",
    "scenarios",
    "interpretation_rules",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "water-network-observability-qualification-v0.1"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "evidence_class",
        "required_state_ids",
        "minimum_estimator_coverage",
        "maximum_interval_width",
        "minimum_calibration_samples",
        "maximum_condition_number",
        "values_are_normative"
      ],
      "properties": {
        "profile_id": {
          "const": "SYNTHETIC-OBSERVABILITY-PROFILE-V0"
        },
        "evidence_class": {
          "const": "synthetic_design_profile"
        },
        "required_state_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "minimum_estimator_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_interval_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "minimum_calibration_samples": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_condition_number": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "values_are_normative": {
          "const": false
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "scenario_class",
          "required_state_ids",
          "topology",
          "sensors",
          "failed_domains",
          "structural_observability",
          "numerical_estimator",
          "note"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^OBS-[0-9]{3}$"
          },
          "scenario_class": {
            "enum": [
              "nominal_independent_direct",
              "single_sensor_dropout",
              "shared_calibration_common_cause",
              "shared_power_domain_failure",
              "shared_gateway_communications_failure",
              "common_clock_domain_drift",
              "topology_revision_mismatch",
              "structural_full_numeric_ill_conditioned",
              "incomplete_critical_state_mapping",
              "independent_measurement_survives_common_cause",
              "qualified_estimator_declared_scope",
              "topology_certificate_missing"
            ]
          },
          "required_state_ids": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "topology": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topology_ref",
              "topology_revision",
              "topology_digest",
              "certificate_topology_revision",
              "certificate_topology_digest",
              "certificate_status",
              "state_mapping_status"
            ],
            "properties": {
              "topology_ref": {
                "type": "string",
                "minLength": 1
              },
              "topology_revision": {
                "type": "string",
                "minLength": 1
              },
              "topology_digest": {
                "type": "string",
                "minLength": 1
              },
              "certificate_topology_revision": {
                "type": "string",
                "minLength": 1
              },
              "certificate_topology_digest": {
                "type": "string",
                "minLength": 1
              },
              "certificate_status": {
                "enum": [
                  "verified_for_exact_topology",
                  "revision_mismatch",
                  "not_verified"
                ]
              },
              "state_mapping_status": {
                "enum": [
                  "complete",
                  "incomplete"
                ]
              }
            }
          },
          "sensors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sensor_id",
                "state_id",
                "measurement_principle",
                "condition_state",
                "binding_status",
                "calibration_status",
                "time_status",
                "dependencies"
              ],
              "properties": {
                "sensor_id": {
                  "type": "string",
                  "minLength": 1
                },
                "state_id": {
                  "type": "string",
                  "minLength": 1
                },
                "measurement_principle": {
                  "enum": [
                    "radar_level",
                    "ultrasonic_level",
                    "float_level_switch",
                    "pressure_transducer",
                    "fiber_optic_pressure"
                  ]
                },
                "condition_state": {
                  "enum": [
                    "available",
                    "failed",
                    "stale",
                    "clock_invalid",
                    "calibration_invalid"
                  ]
                },
                "binding_status": {
                  "enum": [
                    "verified",
                    "unverified"
                  ]
                },
                "calibration_status": {
                  "enum": [
                    "current",
                    "expired",
                    "unknown"
                  ]
                },
                "time_status": {
                  "enum": [
                    "synchronized",
                    "unsynchronized",
                    "unknown"
                  ]
                },
                "dependencies": {
                  "type": "array",
                  "minItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "domain_type",
                      "domain_id"
                    ],
                    "properties": {
                      "domain_type": {
                        "enum": [
                          "physical_interface",
                          "calibration_lineage",
                          "power_supply",
                          "communications_path",
                          "clock_domain",
                          "measurement_principle"
                        ]
                      },
                      "domain_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "failed_domains": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "domain_type",
                "domain_id"
              ],
              "properties": {
                "domain_type": {
                  "enum": [
                    "physical_interface",
                    "calibration_lineage",
                    "power_supply",
                    "communications_path",
                    "clock_domain",
                    "measurement_principle"
                  ]
                },
                "domain_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "structural_observability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "proof_ref"
            ],
            "properties": {
              "status": {
                "enum": [
                  "full",
                  "partial",
                  "not_proven"
                ]
              },
              "proof_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "numerical_estimator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "qualification_claimed",
              "estimator_ref",
              "model_scope_ref",
              "calibration_ref",
              "heldout_ref",
              "ood_test_ref",
              "interval_coverage",
              "calibration_sample_count",
              "max_interval_width",
              "condition_number_bound",
              "validity_domain_ref"
            ],
            "properties": {
              "status": {
                "enum": [
                  "not_used",
                  "synthetic_qualified_contract",
                  "ill_conditioned",
                  "not_tested"
                ]
              },
              "qualification_claimed": {
                "const": false
              },
              "estimator_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "model_scope_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "calibration_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "heldout_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ood_test_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "interval_coverage": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "calibration_sample_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "max_interval_width": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "condition_number_bound": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "validity_domain_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
