{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/water-service-engineering/waterloop-safe-state-machine-v0.1.schema.json",
  "title": "WaterLoop Safe State Machine v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "qualification_status",
    "safety_authority",
    "ai_authority",
    "default_state",
    "states",
    "transitions",
    "global_fail_closed_conditions",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "waterloop-safe-state-machine-v0.1"
    },
    "status": {
      "const": "research_reference_only"
    },
    "qualification_status": {
      "const": "NotRun"
    },
    "safety_authority": {
      "const": "local_hardwired_interlocks_and_manual_isolation"
    },
    "ai_authority": {
      "const": "none_for_release_or_safety_isolation"
    },
    "default_state": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "outputs": {
            "type": "object"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "when",
          "automatic"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "when": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "automatic": {
            "type": "boolean"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "global_fail_closed_conditions": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    }
  }
}
