{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "WaterLoop Pilot Skid Preliminary BOM v0.1",
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "project",
    "skid_design_revision",
    "all_quantities_status",
    "items",
    "procurement_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "waterloop-pilot-skid-preliminary-bom-v0.1"
    },
    "evidence_class": {
      "const": "conceptual_design"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "skid_design_revision": {
      "type": "string",
      "minLength": 1
    },
    "all_quantities_status": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 27,
      "items": {
        "type": "object",
        "required": [
          "tag",
          "description",
          "quantity",
          "material_spec",
          "procurement_status",
          "module_ids"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "null"
          },
          "material_spec": {
            "type": "string",
            "minLength": 1
          },
          "procurement_status": {
            "enum": [
              "not_specified",
              "candidate_only"
            ]
          },
          "module_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "procurement_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
