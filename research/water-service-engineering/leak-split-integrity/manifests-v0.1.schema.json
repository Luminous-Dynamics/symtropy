{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/water-service-engineering/leak-split-integrity/manifests-v0.1.schema.json",
  "title": "Water Leak Dataset Split Integrity Manifest Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "dataset_id",
    "population_class",
    "source_revision",
    "source_digest",
    "rights_status",
    "split_policy",
    "pretraining_exposure_status",
    "pretraining_corpus_refs",
    "test_labels_used_for_selection",
    "samples",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "water-leak-split-integrity-v0.1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "population_class": {
      "enum": [
        "synthetic",
        "laboratory_testbed",
        "utility_retrospective",
        "supervised_field"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rights_status": {
      "enum": [
        "internal_synthetic_only",
        "open_verified",
        "restricted_authorized",
        "unknown"
      ]
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "generalization_claim",
        "group_key",
        "guard_gap_seconds",
        "train_end_utc",
        "validation_start_utc",
        "validation_end_utc",
        "test_start_utc"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "temporal_holdout",
            "leave_event_out",
            "leave_scenario_out",
            "leave_network_out",
            "leave_physical_run_out",
            "cross_domain_holdout"
          ]
        },
        "generalization_claim": {
          "type": "string",
          "minLength": 1
        },
        "group_key": {
          "enum": [
            "source_event_id",
            "scenario_family_seed_parent",
            "network_id",
            "physical_run_id",
            "domain_id",
            "sensor_stream_time"
          ]
        },
        "guard_gap_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "train_end_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_start_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_end_utc": {
          "type": [
            "string",
            "null"
          ]
        },
        "test_start_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "pretraining_exposure_status": {
      "enum": [
        "documented_no_overlap",
        "known_overlap",
        "unknown",
        "not_applicable"
      ]
    },
    "pretraining_corpus_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_labels_used_for_selection": {
      "type": "boolean"
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sample_id",
          "source_event_id",
          "scenario_family",
          "scenario_seed",
          "generation_parent_id",
          "network_id",
          "domain_id",
          "physical_run_id",
          "sensor_stream_id",
          "window_start_utc",
          "window_end_utc",
          "split",
          "augmentation_parent_ids",
          "source_revision",
          "sample_digest"
        ],
        "properties": {
          "sample_id": {
            "type": "string",
            "minLength": 1
          },
          "source_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenario_family": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenario_seed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "generation_parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "network_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "domain_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "physical_run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sensor_stream_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "window_start_utc": {
            "type": "string",
            "minLength": 20
          },
          "window_end_utc": {
            "type": "string",
            "minLength": 20
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test"
            ]
          },
          "augmentation_parent_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          },
          "sample_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
