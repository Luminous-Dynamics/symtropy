  "physical_safety_constraints": [
    "No direct potable-to-reclaimed cross-connection",
    "No module bypass that feeds untreated water into quarantine release or reuse distribution",
    "Potable make-up, if ever required, must use an approved physical air gap/break tank and backflow arrangement reviewed by the local authority/professional",
    "Critical fault causes physical output isolation; software state alone is not the sole barrier",
    "Feed, product, reject and drain connections are physically keyed or otherwise demonstrably resistant to misconnection",
    "Pressure-containing components require compatible ratings, relief strategy and qualified design review",
    "Ozone is excluded from A0 build pending an independent ozone/off-gas/exposure safety case"
  ],
  "acceptance_evidence": [
    "mechanical fit and removal without opening contaminated vessels",
    "port keying and misconnection challenge",
    "static and dynamic leak integrity within approved test envelope",
    "flow and pressure boundary measurement",
    "zero flow-path cross-connection under seeded single-fault conditions",
    "energy and all reject/overflow/cleaning flows metered",
    "isolation on loss of control power and loss of critical evidence",
    "configuration and module identity uniquely recorded"
  ],
  "unresolved_dimensions": [
