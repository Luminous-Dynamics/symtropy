{
  "schema_version": "waterloop-modular-icd-v0.1",
  "status": "preliminary_not_for_construction_or_procurement",
  "parent_issue": "Luminous-Dynamics/symtropy#5784",
  "design_reference": "research/water-service-engineering/WATERLOOP_MODULAR_PLATFORM_DESIGN_V0_1.md",
  "intended_use": {
    "profile_id": "nonpotable-toilet-flushing-v0.1",
    "potable_use": false,
    "first_feed_sources": [
      "shower",
      "hand_basin"
    ],
    "excluded_sources": [
      "toilet_blackwater",
      "kitchen_grease",
      "industrial_process",
      "laundry_normal_operation"
    ],
    "laundry_status": "isolated_challenge_inlet_only"
  },
  "physical_zones": [
    {
      "zone_id": "Z01",
      "name": "Source separation and capture",
      "inputs": [
        "shower_drain",
        "hand_basin_drain"
      ],
      "outputs": [
        "screened_greywater",
        "screenings"
      ],
      "required_isolation": true
    },
    {
      "zone_id": "Z02",
      "name": "Equalisation and feed conditioning",
      "inputs": [
        "screened_greywater"
      ],
      "outputs": [
        "conditioned_feed",
        "overflow_or_expired_batch"
      ],
      "required_isolation": true
    },
    {
      "zone_id": "Z03",
      "name": "Replaceable treatment cassette",
      "inputs": [
        "conditioned_feed"
      ],
      "outputs": [
        "cassette_treated_water",
        "reject_backwash",
        "drain"
      ],
      "required_isolation": true
    },
    {
      "zone_id": "Z04",
      "name": "Quarantine and sampling",
      "inputs": [
        "cassette_treated_water"
      ],
      "outputs": [
        "quarantined_batch",
        "failed_batch_to_authorized_waste"
      ],
      "required_isolation": true
    },
    {
      "zone_id": "Z05",
      "name": "Final barrier and use-specific distribution",
      "inputs": [
        "released_batch"
      ],
      "outputs": [
        "toilet_flushing_test_fixture",
        "distribution_drain"
      ],
      "required_isolation": true
    },
    {
      "zone_id": "Z06",
      "name": "Residual collection",
      "inputs": [
        "screenings",
        "sediment",
        "reject_backwash",
        "cleaning_water",
        "failed_batch"
      ],
      "outputs": [
        "authorized_residual_handling"
      ],
      "required_isolation": true
    }
  ],
  "module_interface": {
    "module_id": "treatment_cassette",
    "mechanical": {
      "mount": "removable_keyed_cartridge_or_skid",
      "envelope_dimensions_mm": null,
      "mass_kg": null,
