  "transitions": [
    {
      "from": "ISOLATED",
      "to": "CAPTURE",
      "condition": "source_identity_and_configuration_verified"
    },
    {
      "from": "CAPTURE",
      "to": "PRETREAT",
      "condition": "feed_source_admitted_and_level_valid"
    },
    {
      "from": "PRETREAT",
      "to": "TREAT",
      "condition": "pretreatment_permissives_valid"
    },
    {
      "from": "TREAT",
      "to": "VERIFY",
      "condition": "treatment_cycle_complete_and_no_barrier_fault"
    },
    {
      "from": "VERIFY",
      "to": "RELEASE",
      "condition": "all_required_quality_and_process_evidence_current_and_admitted"
    },
    {
      "from": "CAPTURE",
      "to": "BYPASS",
      "condition": "invalid_source_high_level_timeout_or_power_fault"
    },
    {
      "from": "PRETREAT",
      "to": "BYPASS",
      "condition": "screen_or_pressure_fault"
    },
    {
      "from": "TREAT",
      "to": "QUARANTINE",
      "condition": "barrier_fault_or_invalid_process_evidence"
    },
    {
      "from": "VERIFY",
      "to": "QUARANTINE",
      "condition": "failed_or_expired_release_evidence"
    },
    {
      "from": "RELEASE",
      "to": "ISOLATED",
      "condition": "quality_age_sensor_power_or_process_fault"
    },
    {
      "from": "QUARANTINE",
      "to": "MAINTENANCE",
      "condition": "authorized_service_lockout"
    },
    {
      "from": "MAINTENANCE",
      "to": "RECOVERY",
      "condition": "repair_complete_leak_electrical_and_flush_checks_pass"
    },
    {
      "from": "RECOVERY",
      "to": "VERIFY",
      "condition": "fresh_permissives_and_required_reverification"
    }
  ],
  "hard_interlocks": [
    "NO_POTABLE_NONPOTABLE_CROSS_CONNECTION",
    "APPROVED_AIR_GAP_AND_BACKFLOW_PROTECTION_BY_COMPETENT_DESIGNER",
    "REUSE_VALVE_FAILS_CLOSED_ON_POWER_OR_SENSOR_OR_PROCESS_FAULT",
    "NO_AUTOMATIC_QUARANTINE_TO_RELEASE",
    "NO_CLOUD_OR_AI_OVERRIDE_OF_LOCAL_INTERLOCK",
    "NO_UNTREATED_FEED_TO_REUSE_OUTLET",
    "NO_UNAPPROVED_STORMWATER_OR_ENVIRONMENTAL_DISCHARGE"
  ],
  "sizing_variables": {
    "capture_volume": "sum(source_flow_i * interval_i * measured_capture_fraction)",
    "qualified_volume": "feed - reject - backwash - overflow - offspec",
    "storage_balance": "previous_storage + inflow - use - reject, bounded by physical storage",
    "essential_demand": "sum(use_count_j * volume_per_use_j)",
    "hydraulic_power": "rho * g * flow * total_dynamic_head",
    "energy_intensity": "integrated_true_electrical_energy / independently_verified_useful_volume"
  },
  "t1_verification": {
    "stages": [
      "source_characterization",
      "matched_treatment_train_screening",
      "endurance_and_seeded_faults",
      "independent_verification"
    ],
    "initial_endurance_days": 30,
    "sampling": "at least three temporally separated source samples before train selection; independent lab cadence frozen by hazard plan",
    "seeded_faults": [
      "screen_blockage",
      "media_breakthrough",
      "pump_failure",
      "uv_fault_if_present",
      "membrane_integrity_fault_if_present",
      "stuck_high_low_level_sensor",
      "flowmeter_drift",
      "power_loss",
      "wrong_source_selection",
      "offspec_quality",
      "overflow"
    ],
    "acceptance_targets": [
      "zero_observed_potable_nonpotable_cross_connections",
      "all_seeded_faults_isolate_reuse_before_offspec_delivery",
      "water_balance_residual_within_combined_measurement_uncertainty",
      "every_released_volume_traceable_to_source_treatment_storage_and_use_class"
    ],
    "claim_ceiling": "T1 bench performance within tested source/use/operating envelope only"
  },
