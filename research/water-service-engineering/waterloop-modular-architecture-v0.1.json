  "fail_safe_state": {
    "on_invalid_quality_evidence": "ISOLATE_NONPOTABLE_DELIVERY_AND_HOLD_OR_REJECT_PRODUCT",
    "on_power_loss": "STOP_TREATMENT_AND_REUSE_DELIVERY; MAINS_REMAINS_PHYSICALLY_SEPARATE",
    "on_barrier_fault": "FAIL_CLOSED_NO_QUALITY_CREDIT",
    "on_unknown_source": "REJECT_OR_HOLD_BATCH",
    "on_overflow_or_blocked_reject": "STOP_FEED_AND_ALARM",
    "on_configuration_change": "REVOKE_PRIOR_TRAIN_QUALIFICATION_UNTIL_IMPACT_REVIEW",
    "note": "A reject/drain route may be used only after site-specific hydraulic and legal permission is reviewed."
