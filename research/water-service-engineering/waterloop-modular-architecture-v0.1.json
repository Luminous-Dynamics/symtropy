{
  "schema_version": "waterloop-modular-architecture-v0.1",
  "architecture_id": "WATERLOOP-MODULAR-T0-REF-001",
  "revision": "0.1",
  "date": "2026-11-16",
  "evidence_class": "design_reference_only",
  "qualification_status": "NotRun",
  "claim_ceiling": "source_segregation_and_module_interface_design_only_no_treatment_or_use_qualification",
  "design_principle": "source properties + intended use + exposure pathway determine a versioned process configuration; no single universal greywater train",
  "nonclaims": [
    "No module or process train is validated or selected for deployment.",
    "No treated-water quality or public-health safety is established.",
    "No plumbing installation, backflow arrangement, discharge route or regulatory compliance is approved.",
    "No water-saving, treatment-energy, lifecycle-cost or service-availability result is measured."
  ],
  "boundaries": {
    "system_scope": "source capture through use-specific fixture boundary and all residual/reject paths",
    "separate_authorities": [
      "water quality and use admission: Mycelix #6100",
      "measurands, instrument capability, calibration and uncertainty: Mycelix #6034/#6029/#6048/#6054/#6057",
      "water/material/energy/residual closure: Symtropy #2152",
      "service continuity: Symtropy #5364/#5368",
      "household water economics: Symtropy #5425",
      "whole-household affordability: Sol-Atlas #816"
    ],
    "hydraulic_sizing": "unassigned_pending_site_demand_feed_characterization_and_professional_design",
    "local_regulatory_review": "required_before_T1_site_connection_or_domestic_installation"
  },
  "source_classes": [
    {
      "id": "SRC-LGW-BATH-SHOWER",
      "status": "candidate_conditional",
      "description": "Bath and shower flows; retain source identity and batch/time context.",
      "admission_requirements": [
        "source_identity",
        "site_hygiene_review",
        "batch_characterization",
        "intended_use_review"
      ],
      "default_action": "segregated_collection_only_until_screened"
    },
    {
      "id": "SRC-LGW-HANDBASIN",
      "status": "conditional_excluded_by_default",
      "description": "Hand-basin flows; source-specific hygiene and cleaning chemistry can differ.",
      "admission_requirements": [
        "source_identity",
        "cleaning_chemical_profile",
        "site_hygiene_review",
        "batch_characterization"
      ],
      "default_action": "isolated_hold_for_review"
    },
    {
      "id": "SRC-LAUNDRY",
      "status": "segregated_challenge_only",
      "description": "Laundry wash/rinse batches; surfactants, fibres, suspended solids and detergent variation require a separate challenge population.",
