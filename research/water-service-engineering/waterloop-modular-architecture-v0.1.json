        "cycle_phase_identity",
        "detergent_profile",
        "surfactant_characterization",
        "TSS_characterization",
        "batch_identity"
      ],
      "default_action": "separate_hold_no_blending_into_LGW_train"
    },
    {
      "id": "SRC-KITCHEN-DISHWASHER",
      "status": "excluded_from_initial_reference_train",
      "description": "Kitchen and dishwasher flows have food solids, grease and stronger/variable cleaning chemistry.",
      "admission_requirements": [
        "separate_process_design_and_risk_assessment"
      ],
      "default_action": "separate_drainage"
    },
    {
      "id": "SRC-TOILET-BIDET-FAECAL",
      "status": "prohibited_from_greywater_inlet",
      "description": "Toilet/bidet and faecally contaminated flows are not greywater feed for this reference architecture.",
      "admission_requirements": [],
      "default_action": "sanitary_waste_route"
    },
    {
      "id": "SRC-ANIMAL-CHEMICAL-TRADE",
      "status": "prohibited_from_initial_reference",
      "description": "Animal wash, paint/solvent/vehicle/machinery cleaning and other trade/chemical flows are excluded.",
      "admission_requirements": [],
      "default_action": "separate_approved_waste_route"
    },
    {
      "id": "SRC-RAINWATER",
      "status": "separate_source_family",
      "description": "Roof rainwater/stormwater has its own first-flush, roof-material and microbial/chemical source risks; do not mix upstream with greywater.",
      "admission_requirements": [
        "roof_and_catchment_identity",
        "first_flush_and_storage_review",
        "source_quality_profile"
      ],
      "default_action": "separate_rainwater_process"
    },
    {
      "id": "SRC-MAINS-BACKUP",
      "status": "separate_potable_network",
      "description": "Mains backup remains physically separated from reclaimed-water tank and network.",
      "admission_requirements": [
        "professional_backflow_airgap_design",
        "local_authority_approval"
      ],
      "default_action": "isolated_potable_supply"
    }
