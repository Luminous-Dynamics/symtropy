  "design_principle": "source properties + intended use + exposure pathway determine a versioned process configuration; no single universal greywater train",
  "nonclaims": [
    "No module or process train is validated or selected for deployment.",
    "No treated-water quality or public-health safety is established.",
    "No plumbing installation, backflow arrangement, discharge route or regulatory compliance is approved.",
    "No water-saving, treatment-energy, lifecycle-cost or service-availability result is measured.",
    "Source-characterization minima are exploratory design targets, not proof of household-population representativeness.",
    "Backflow device selection, reject/overflow route and hydraulic dimensions remain unassigned until qualified local professional and authority review."
  ],
  "boundaries": {
    "system_scope": "source capture through use-specific fixture boundary and all residual/reject paths",
