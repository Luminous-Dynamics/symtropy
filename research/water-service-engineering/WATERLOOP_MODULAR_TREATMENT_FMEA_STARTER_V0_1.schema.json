{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "WaterLoop Modular Treatment FMEA Starter v0.1",
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "hazards",
    "invariants",
    "not_completed"
  ],
  "properties": {
    "schema_version": {
      "const": "waterloop-modular-train-fmea-starter-v0.1"
    },
    "evidence_class": {
      "const": "conceptual_hazard_analysis"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "hazards": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "hazard_id",
          "failure",
          "effect",
          "detection",
          "safe_state",
          "verification",
          "module_ids"
        ],
        "properties": {
          "hazard_id": {
            "type": "string",
            "minLength": 1
          },
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "detection": {
            "type": "string",
            "minLength": 1
          },
          "safe_state": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "module_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "not_completed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
