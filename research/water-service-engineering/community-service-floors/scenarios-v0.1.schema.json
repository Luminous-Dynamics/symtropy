{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/water-service-engineering/community-service-floors/scenarios-v0.1.schema.json",
  "title": "Community Water Service Floor Scenario Schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "profile",
    "scenarios",
    "interpretation_rules",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "community-water-service-floor-v0.1"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "evidence_class",
        "required_area_ids",
        "metric",
        "unit",
        "minimum_floor",
        "time_grid_id",
        "values_are_normative",
        "aggregation_authority"
      ],
      "properties": {
        "profile_id": {
          "const": "SYNTHETIC-COMMUNITY-FLOOR-V0"
        },
        "evidence_class": {
          "const": "synthetic_design_profile"
        },
        "required_area_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "metric": {
          "const": "delivered_demand_fraction"
        },
        "unit": {
          "const": "fraction_of_required_volume_over_declared_window"
        },
        "minimum_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "time_grid_id": {
          "type": "string",
          "minLength": 1
        },
        "values_are_normative": {
          "const": false
        },
        "aggregation_authority": {
          "const": "diagnostic_only_never_overrides_area_floor"
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "scenario_class",
          "areas",
          "aggregate_diagnostic",
          "expected_overall_disposition",
          "note"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^WSF-[0-9]{3}$"
          },
          "scenario_class": {
            "enum": [
              "all_floors_met",
              "weighted_average_masks_breach",
              "single_area_breach",
              "missing_evidence",
              "stale_evidence",
              "partial_coverage",
              "interval_crosses_floor",
              "breach_plus_unknown",
              "policy_missing",
              "unit_mismatch",
              "time_grid_mismatch",
              "boundary_equal_to_floor"
            ]
          },
          "areas": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "area_id",
                "required",
                "floor_ref",
                "metric",
                "unit",
                "minimum_floor",
                "observation_lower_bound",
                "observation_upper_bound",
                "coverage_numerator",
                "coverage_denominator",
                "evidence_state",
                "observation_ref",
                "validity_window_ref",
                "geometry_revision_ref",
                "time_grid_id",
                "diagnostic_weight",
                "expected_area_disposition"
              ],
              "properties": {
                "area_id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "const": true
                },
                "floor_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "minimum_floor": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "observation_lower_bound": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "observation_upper_bound": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "coverage_numerator": {
                  "type": "integer",
                  "minimum": 0
                },
                "coverage_denominator": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "evidence_state": {
                  "enum": [
                    "observed_current",
                    "missing",
                    "stale",
                    "conflicting",
                    "unknown"
                  ]
                },
                "observation_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "validity_window_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "geometry_revision_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "time_grid_id": {
                  "type": "string",
                  "minLength": 1
                },
                "diagnostic_weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "expected_area_disposition": {
                  "enum": [
                    "meets_floor",
                    "breached_floor",
                    "indeterminate",
                    "invalid"
                  ]
                }
              }
            }
          },
          "aggregate_diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "method",
              "authoritative"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "method": {
                "enum": [
                  "weighted_average_by_synthetic_connection_count",
                  "not_computable"
                ]
              },
              "authoritative": {
                "const": false
              }
            }
          },
          "expected_overall_disposition": {
            "enum": [
              "meets_all_floors",
              "breached_floor",
              "indeterminate",
              "breached_with_indeterminate",
              "invalid"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
