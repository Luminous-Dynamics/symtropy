{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "WaterLoop Greywater Challenge Profiles v0.1",
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "literature_context",
    "profiles",
    "scenarios",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "waterloop-greywater-challenge-profiles-v0.1"
    },
    "evidence_class": {
      "const": "synthetic_only"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "literature_context": {
      "type": "object"
    },
    "profiles": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "source_class",
          "synthetic",
          "values",
          "unmeasured_fields",
          "purpose"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "source_class": {
            "type": "string",
            "minLength": 1
          },
          "synthetic": {
            "const": true
          },
          "values": {
            "type": [
              "object",
              "null"
            ]
          },
          "storage_age_hours": {
            "type": "number",
            "minimum": 0
          },
          "unmeasured_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "profile_id",
          "expected_disposition"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_disposition": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
