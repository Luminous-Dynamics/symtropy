  },
  "fail_safe_states": [
    {
      "trigger": "source identity unknown or excluded",
      "action": "isolate source and divert to reject"
    },
    {
      "trigger": "untreated residence exceeds 24 h",
      "action": "reject or independently qualify a different treated route before use"
    },
    {
      "trigger": "quality admission absent, stale, failed or wrong use profile",
      "action": "close reuse delivery; divert; preserve municipal cistern backup"
    },
    {
      "trigger": "process barrier failure",
      "action": "isolate module; no bypass to use outlet"
    },
    {
      "trigger": "power or control loss",
      "action": "reuse pump off; source to reject by reviewed passive arrangement"
    },
    {
      "trigger": "high_high storage",
      "action": "stop capture or divert; no uncontrolled overflow"
    },
    {
      "trigger": "suspected cross_connection",
      "action": "quarantine both systems until qualified inspection and approval"
    },
    {
      "trigger": "pump failure or low pressure",
      "action": "disable reuse delivery; use independently compliant cistern backup"
    }
  ],
