{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/research/water-service-engineering/cyber-physical-qualification/pairs-v0.1.schema.json",
  "title": "Water cyber-physical causal matched-pair fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "protocol_revision",
    "evidence_class",
    "claim_ceiling",
    "design",
    "dataset_lanes",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "water-cyber-physical-causal-pairs-v0.1"
    },
    "protocol_revision": {
      "const": "WATER-CYBER-PHYSICAL-CAUSAL-0.1"
    },
    "evidence_class": {
      "const": "synthetic_design_fixture"
    },
    "claim_ceiling": {
      "const": "synthetic_contract_semantics_only_no_detector_control_hydraulic_or_field_claim"
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factors",
        "arms",
        "contrasts",
        "parity_rule"
      ],
      "properties": {
        "factors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "integrity_condition"
            },
            {
              "const": "protection_policy"
            }
          ],
          "items": false
        },
        "arms": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "arm_id",
              "integrity_condition",
              "protection_policy"
            ],
            "properties": {
              "arm_id": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "integrity_condition": {
                "enum": [
                  "nominal",
                  "disturbed"
                ]
              },
              "protection_policy": {
                "enum": [
                  "baseline",
                  "evidence_gated"
                ]
              }
            }
          }
        },
        "contrasts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contrast_id",
              "left_arm",
              "right_arm",
              "only_factor_changed"
            ],
            "properties": {
              "contrast_id": {
                "enum": [
                  "C-AB",
                  "C-CD",
                  "C-BD",
                  "C-AC"
                ]
              },
              "left_arm": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "right_arm": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D"
                ]
              },
              "only_factor_changed": {
                "enum": [
                  "integrity_condition",
                  "protection_policy"
                ]
              }
            }
          }
        },
        "parity_rule": {
          "const": "same_shared_deployment_inputs_within_each_case; one_registered_factor_changes_within_each_contrast"
        }
      }
    },
    "dataset_lanes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "population_class",
          "permitted_task",
          "exclusions",
          "admission_state"
        ],
        "properties": {
          "lane_id": {
            "enum": [
              "AQUASENSE-ICS-2026",
              "NET1-NET3-SIM",
              "BATADAL-CTOWN",
              "WDSEVENTDB-ACG",
              "BABELA-SLOVAK-2026"
            ]
          },
          "population_class": {
            "enum": [
              "hybrid_data_level",
              "synthetic_hydraulic",
              "historical_simulated_scada",
              "controlled_testbed",
              "retrospective_real_utility_weak_label"
            ]
          },
          "permitted_task": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "exclusions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "admission_state": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scenario_family",
          "integrity_profile",
          "pair_id",
          "shared_deployment_inputs",
          "arms",
          "evaluator_truth",
          "expected_semantics"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^WCP-[0-9]{3}$"
          },
          "scenario_family": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "integrity_profile": {
            "enum": [
              "equivalent_same_received_trace",
              "stale_authenticated",
              "plausible_multi_channel",
              "availability_loss",
              "shared_common_root",
              "command_actuator_mismatch",
              "physical_source_or_demand_shock",
              "mixed_event_and_nuisance",
              "service_floor_breach",
              "integrity_event_no_consequence",
              "physical_impact_unattributed",
              "recurrence_before_stable_dwell"
            ]
          },
          "pair_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "shared_deployment_inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "network_id",
              "topology_revision",
              "topology_digest",
              "geometry_revision",
              "geometry_digest",
              "demand_trace_digest",
              "physical_disturbance_trace_digest",
              "random_seed",
              "sensor_set",
              "sampling_period_seconds",
              "missingness_profile_ref",
              "time_grid_ref",
              "unit_system",
              "scoring_horizon_seconds",
              "service_floor_profile_digest",
              "required_service_area_ids",
              "actuator_envelope_digest",
              "local_protection_contract_digest",
              "decision_deadline_ms",
              "future_covariates_available"
            ],
            "properties": {
              "network_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "topology_revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "topology_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "geometry_revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "geometry_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "demand_trace_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "physical_disturbance_trace_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "random_seed": {
                "type": "integer",
                "minimum": 0
              },
              "sensor_set": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "sampling_period_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "missingness_profile_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "time_grid_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "unit_system": {
                "const": "SI"
              },
              "scoring_horizon_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "service_floor_profile_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "required_service_area_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "actuator_envelope_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "local_protection_contract_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "decision_deadline_ms": {
                "type": "integer",
                "minimum": 1
              },
              "future_covariates_available": {
                "const": false
              }
            }
          },
          "arms": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "arm_id",
                "integrity_condition",
                "protection_policy"
              ],
              "properties": {
                "arm_id": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D"
                  ]
                },
                "integrity_condition": {
                  "enum": [
                    "nominal",
                    "disturbed"
                  ]
                },
                "protection_policy": {
                  "enum": [
                    "baseline",
                    "evidence_gated"
                  ]
                }
              }
            }
          },
          "evaluator_truth": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "latent_cause_set",
              "independent_side_evidence",
              "physical_propagation",
              "visibility"
            ],
            "properties": {
              "latent_cause_set": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "independent_side_evidence": {
                "enum": [
                  "none",
                  "independent_integrity_indicator",
                  "independent_physical_measurement",
                  "independent_event_truth"
                ]
              },
              "physical_propagation": {
                "enum": [
                  "none",
                  "unknown",
                  "service_degradation",
                  "service_floor_breach"
                ]
              },
              "visibility": {
                "const": "evaluator_only"
              }
            }
          },
          "expected_semantics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "integrity_disposition",
              "cause_disposition",
              "protection_disposition",
              "restoration_disposition",
              "physical_trajectory_source",
              "service_outcome"
            ],
            "properties": {
              "integrity_disposition": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "cause_disposition": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "protection_disposition": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "restoration_disposition": {
                "enum": [
                  "verified_restored",
                  "candidate_restored",
                  "not_restored",
                  "breached_with_indeterminate",
                  "indeterminate",
                  "invalid",
                  "not_applicable"
                ]
              },
              "physical_trajectory_source": {
                "const": "external_solver_or_testbed_required"
              },
              "service_outcome": {
                "enum": [
                  "no_service_impact",
                  "external_per_area_trajectory_required"
                ]
              }
            }
          }
        }
      }
    }
  }
}
