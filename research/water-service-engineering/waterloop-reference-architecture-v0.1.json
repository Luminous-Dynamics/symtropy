  "controller": {
    "initial_state": "BYPASS_SAFE",
    "safe_states": [
      "BYPASS_SAFE",
      "MAINTENANCE_LOCKOUT"
    ],
    "states": [
      "BYPASS_SAFE",
      "SOURCE_CHECK",
      "PRETREATMENT",
      "TREATMENT_RUN",
      "QUALITY_HOLD",
      "REUSE_ADMITTED",
      "MAINTENANCE_LOCKOUT",
      "POWER_LOSS_SAFE",
      "SENSOR_OR_COMMS_LOSS_SAFE"
    ],
    "transitions": [
      {
        "from": "BYPASS_SAFE",
        "to": "SOURCE_CHECK",
        "trigger": "operator_reset_and_source_identity_present"
      },
      {
        "from": "SOURCE_CHECK",
        "to": "PRETREATMENT",
        "trigger": "source_profile_and_metering_admitted"
      },
      {
        "from": "PRETREATMENT",
        "to": "TREATMENT_RUN",
        "trigger": "pretreatment_and_hydraulic_envelope_admitted"
      },
      {
        "from": "TREATMENT_RUN",
        "to": "QUALITY_HOLD",
        "trigger": "batch_or_interval_complete"
      },
      {
        "from": "QUALITY_HOLD",
        "to": "REUSE_ADMITTED",
        "trigger": "quality_gate_admitted_and_metrology_admitted_and_storage_age_within_qualified_limit"
      },
      {
        "from": "QUALITY_HOLD",
        "to": "BYPASS_SAFE",
        "trigger": "quality_gate_rejected_or_evidence_missing"
      },
      {
        "from": "SOURCE_CHECK",
        "to": "BYPASS_SAFE",
        "trigger": "unknown_source_or_sensor_invalid"
      },
      {
        "from": "PRETREATMENT",
        "to": "BYPASS_SAFE",
        "trigger": "blocked_screen_or_out_of_profile"
      },
      {
        "from": "TREATMENT_RUN",
        "to": "BYPASS_SAFE",
        "trigger": "process_failure_or_power_loss"
      },
      {
        "from": "REUSE_ADMITTED",
        "to": "BYPASS_SAFE",
        "trigger": "quality_expiry_or_invalid_measurement_or_demand_outside_profile"
      },
      {
        "from": "REUSE_ADMITTED",
        "to": "POWER_LOSS_SAFE",
        "trigger": "power_loss"
      },
      {
        "from": "POWER_LOSS_SAFE",
        "to": "BYPASS_SAFE",
        "trigger": "physical_isolation_confirmed"
      },
      {
        "from": "BYPASS_SAFE",
        "to": "MAINTENANCE_LOCKOUT",
        "trigger": "service_required"
      },
      {
        "from": "MAINTENANCE_LOCKOUT",
        "to": "BYPASS_SAFE",
        "trigger": "service_complete_and_inspection_admitted"
      }
    ],
    "forbidden_transitions": [
      "Any state to REUSE_ADMITTED except QUALITY_HOLD with all explicit quality/metrology/age conditions.",
      "Any non-potable state to a potable circuit or potable outlet.",
      "Power loss or sensor/comms loss to REUSE_ADMITTED."
    ]
  },
  "sizing_contract": {
    "storage": "Derive each circuit's useful storage from time-resolved use demand and admitted source inflow over a declared design horizon; add dead storage/freeboard/uncertainty separately. Keep potable drinking reserve and non-potable reuse volumes as distinct ledgers.",
    "pump": "Select pump only after design flow, elevation, pipe losses, pressure/flow floor, efficiency curve, NPSH and outage duty are admitted.",
    "treatment": "Select treatment module from source-property distribution, peak/batch loading, target-use profile, temperature, residence time, maintenance envelope and residual outlet—not nominal average influent alone.",
    "equalization": "Size only to attenuate measured variability and process constraints; untreated greywater residence time must remain within an independently qualified envelope.",
    "overflow": "Every vessel requires a safe overflow/vent/cleanout design, with final route approved for site and local requirements."
  },
  "measurement_contract": [
    "Separate meters or quantified measurements for source inflow, treated output, admitted useful delivery, reject/purge, overflow and storage change.",
    "Electricity measured at the declared complete system boundary, including standby and auxiliaries.",
    "Quality samples linked to exact circuit, source profile, treatment revision, batch/time interval, outlet/use class, method and calibration.",
    "Storage level is not automatically volume; a calibrated level-volume relationship is required.",
    "All timebases, units, sampling intervals, uncertainty and missing-data semantics are explicit."
  ],
  "manufacturing_interfaces": {
    "required_ports": [
      "source_inlet",
      "process_outlet",
      "sample_point",
      "isolation",
      "drain_or_reject",
      "overflow",
      "vent",
      "cleanout",
      "metering"
    ],
    "candidate_material_families": [
      "UV-stabilised polymer tank candidates",
      "pressure-rated plastic pipe candidates",
      "corrosion-resistant metallic wetted-part candidates",
      "replaceable polymeric or mineral filter-media housings"
    ],
    "material_status": "candidate_families_only_no_material_grade_or_supplier_selected",
    "maintainability_rules": [
      "Screens and serviceable components accessible without opening sealed electrical enclosures.",
      "Treatment cassettes keyed against reversed or incorrect installation.",
      "Every component can be isolated, drained and replaced without cross-contaminating the potable circuit.",
      "Standardised unions, service ports and local spare availability are evaluated before design freeze.",
      "No sealed proprietary wet path without a defined repair/replacement path."
    ]
  },
  "qualification_gates": [
    "Physical cross-connection and backflow test by qualified plumbing authority.",
    "Bench challenge testing with source-specific variability and independent laboratory methods.",
    "Quality fail, sensor invalid, power loss, screen blockage, treatment failure, storage-age and maintenance-overdue fault injection.",
    "Complete water, energy, residual, service and cost boundary reconciliation.",
    "Independent review of site-specific installation, electrical, environmental and water-use requirements."
  ],
  "nonclaims": [
    "This is a design contract only; no physical device, process or installation has been built or tested.",
    "No water is declared potable or fit for a specific reuse by this architecture.",
    "No SANS, municipal, plumbing, electrical, environmental or water-use approval is claimed.",
    "No material grade, treatment recipe, storage size, pump, operating setpoint or sensor is selected.",
    "No model or controller is authorised to connect circuits, release drinking water or actuate field equipment."
  ]
}
