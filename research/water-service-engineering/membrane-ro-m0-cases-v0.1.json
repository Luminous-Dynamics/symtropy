{
  "schema_version": "membrane-ro-m0-cases-v0.1",
  "evidence_class": "synthetic_transport_arithmetic",
  "evidence_ceiling": "synthetic_transport_arithmetic_only_no_empirical_RO_performance_or_fouling_claim",
  "model": "solution_diffusion_with_film_concentration_polarization",
  "units": {
    "flux": "L m-2 h-1",
    "pressure": "bar",
    "osmotic_pressure": "bar",
    "mass_transfer_coefficient": "L m-2 h-1",
    "rejection": "fraction"
  },
  "formulas": {
    "net_driving_pressure_bar": "delta_pressure_bar - (osmotic_pressure_wall_bar - osmotic_pressure_permeate_bar)",
    "concentration_polarization_modulus": "(1 - rejection) + rejection * exp(flux / mass_transfer_coefficient)",
    "water_permeance_reference": "flux / net_driving_pressure_bar",
    "water_permeance_pressure_only": "flux / delta_pressure_bar",
    "solute_permeance_reference": "flux * (1 - rejection) / (rejection * exp(flux / mass_transfer_coefficient))",
    "solute_permeance_no_concentration_polarization": "flux * (1 - rejection) / rejection",
    "percent_error": "100 * (simplified - reference) / reference"
  },
