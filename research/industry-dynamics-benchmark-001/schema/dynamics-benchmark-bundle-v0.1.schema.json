{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/research/industry-dynamics-benchmark-001/schema/dynamics-benchmark-bundle-v0.1.schema.json",
  "title": "Luminous matched-semantics multibody dynamics benchmark bundle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_mode",
    "bundle_id",
    "physical_case",
    "oracle",
    "engine_runs",
    "comparison",
    "claim_boundary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "luminous.dynamics_benchmark_bundle.v0.1"
    },
    "fixture_mode": {
      "enum": [
        "synthetic_example",
        "admissible_benchmark"
      ]
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "physical_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "model_sha256",
        "topology_sha256",
        "inertial_parameters_sha256",
        "initial_state_sha256",
        "force_history_sha256",
        "constraint_semantics_sha256",
        "units_profile_id",
        "integrator",
        "observable_contract_sha256"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "topology_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inertial_parameters_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "initial_state_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "force_history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "constraint_semantics_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "units_profile_id": {
          "const": "SI-v1"
        },
        "integrator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "time_step_seconds",
            "order",
            "implicitness",
            "configuration_sha256"
          ],
          "properties": {
            "family": {
              "enum": [
                "semi_implicit_euler",
                "implicit_midpoint",
                "variational",
                "engine_native_fixed_step"
              ]
            },
            "time_step_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "order": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "implicitness": {
              "enum": [
                "explicit",
                "implicit",
                "symplectic",
                "engine_native"
              ]
            },
            "configuration_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "constraint_mode": {
          "enum": [
            "none",
            "hard_holonomic",
            "soft_holonomic",
            "contact_complementarity"
          ]
        },
        "observable_contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contact_model_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "friction_model_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "implementation_id",
        "source_sha256",
        "reference_status",
        "precision"
      ],
      "properties": {
        "method": {
          "enum": [
            "independent_high_precision",
            "verified_interval",
            "analytic_fixture",
            "cross_engine_consensus"
          ]
        },
        "implementation_id": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reference_status": {
          "enum": [
            "PASS",
            "INCONCLUSIVE",
            "NOT_AVAILABLE"
          ]
        },
        "precision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engine_runs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "engine",
          "engine_version",
          "adapter_commit_sha",
          "adapter_source_sha256",
          "configuration_sha256",
          "semantic_signature",
          "hardware",
          "compiler",
          "runtime_ns_samples",
          "peak_memory_bytes",
          "physical_metrics",
          "execution_status"
        ],
        "properties": {
          "engine": {
            "enum": [
              "symtropy",
              "mujoco",
              "drake",
              "pinocchio",
              "chrono"
            ]
          },
          "engine_version": {
            "type": "string",
            "minLength": 1
          },
          "adapter_commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "adapter_source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "semantic_signature": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model_sha256",
              "topology_sha256",
              "inertial_parameters_sha256",
              "initial_state_sha256",
              "force_history_sha256",
              "constraint_semantics_sha256",
              "units_profile_id",
              "integrator_configuration_sha256",
              "observable_contract_sha256"
            ],
            "properties": {
              "model_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "topology_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "inertial_parameters_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "initial_state_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "force_history_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "constraint_semantics_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "units_profile_id": {
                "const": "SI-v1"
              },
              "integrator_configuration_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "observable_contract_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "contact_model_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "friction_model_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "hardware": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpu_id",
              "physical_cores",
              "memory_bytes",
              "os_id",
              "thread_count"
            ],
            "properties": {
              "cpu_id": {
                "type": "string",
                "minLength": 1
              },
              "physical_cores": {
                "type": "integer",
                "minimum": 1
              },
              "memory_bytes": {
                "type": "integer",
                "minimum": 1
              },
              "os_id": {
                "type": "string",
                "minLength": 1
              },
              "thread_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "compiler": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "compiler_id",
              "compiler_version",
              "build_mode",
              "flags_sha256",
              "precision"
            ],
            "properties": {
              "compiler_id": {
                "type": "string",
                "minLength": 1
              },
              "compiler_version": {
                "type": "string",
                "minLength": 1
              },
              "build_mode": {
                "enum": [
                  "release",
                  "debug",
                  "optimized_native",
                  "engine_prebuilt"
                ]
              },
              "flags_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "precision": {
                "enum": [
                  "float32",
                  "float64",
                  "mixed",
                  "extended"
                ]
              }
            }
          },
          "runtime_ns_samples": {
            "type": "array",
            "minItems": 30,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "peak_memory_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "physical_metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "acceleration_sha256",
              "constraint_residual_inf",
              "energy_work_defect_abs",
              "linear_momentum_error",
              "angular_momentum_error",
              "trajectory_error_mass_norm",
              "mass_solve_backward_error",
              "constraint_rank_status"
            ],
            "properties": {
              "acceleration_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "constraint_residual_inf": {
                "type": "number",
                "minimum": 0
              },
              "energy_work_defect_abs": {
                "type": "number",
                "minimum": 0
              },
              "linear_momentum_error": {
                "type": "number",
                "minimum": 0
              },
              "angular_momentum_error": {
                "type": "number",
                "minimum": 0
              },
              "trajectory_error_mass_norm": {
                "type": "number",
                "minimum": 0
              },
              "mass_solve_backward_error": {
                "type": "number",
                "minimum": 0
              },
              "constraint_rank_status": {
                "enum": [
                  "FULL_ROW_RANK",
                  "RANK_DEFICIENT",
                  "INCONCLUSIVE",
                  "NOT_APPLICABLE"
                ]
              }
            }
          },
          "execution_status": {
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE"
            ]
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "semantic_match",
        "matched_engine_count",
        "latency_summary_method",
        "physical_error_comparison",
        "claim_ceiling"
      ],
      "properties": {
        "status": {
          "enum": [
            "MATCHED_COMPARISON",
            "NOT_COMPARABLE",
            "INCONCLUSIVE"
          ]
        },
        "semantic_match": {
          "type": "boolean"
        },
        "matched_engine_count": {
          "type": "integer",
          "minimum": 0
        },
        "latency_summary_method": {
          "const": "median_p95_p99_from_raw_samples"
        },
        "physical_error_comparison": {
          "type": "boolean"
        },
        "claim_ceiling": {
          "const": "DECLARED_FIXTURE_FAMILY_ONLY"
        }
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "limitations"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
