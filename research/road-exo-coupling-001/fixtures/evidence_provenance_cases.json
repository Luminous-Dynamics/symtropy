{
  "schema": "symtropy.road-reality-gap.fixtures.v0.1",
  "purpose": "Evidence-origin, lineage-independence, counterfactual-target and split-leakage conformance; not a real-world ADS benchmark dataset.",
  "reference_rules": {
    "factual_log": "supports only outcomes under the action actually observed",
    "controlled_intervention": "requires measured outcome, matching executed action, assignment protocol and calibration",
    "natural_experiment": "requires explicit estimand, assumptions digest, overlap evidence, sensitivity plan and preregistration",
    "simulator_or_model_output": "never independent real-world ground truth",
    "formal_reference": "scoped to exact formal domain",
    "human_adjudication": "requires rubric, assessor protocol, disagreement digest and assessor count",
    "unknown_lineage": "Incomplete, never independent by default"
  },
  "cases": [
    {
      "id": "factual-observation-same-action",
      "origin": "observed_factual",
      "target": "factual_outcome",
      "expected": "IndependentObservedAnchor"
    },
    {
      "id": "factual-observation-unexecuted-action",
      "origin": "observed_factual",
      "target": "unexecuted_action_outcome",
      "expected": "NotIdentified"
    },
    {
      "id": "controlled-measured-intervention",
      "origin": "controlled_intervention",
      "target": "unexecuted_action_outcome",
      "requires": [
        "matching_action",
        "assigned_and_executed",
        "assignment_protocol",
        "measurement_calibration"
      ],
      "expected": "ControlledInterventionOutcome"
    },
    {
      "id": "controlled-intervention-no-assignment",
      "origin": "controlled_intervention",
      "expected": "Incomplete"
    },
    {
      "id": "natural-experiment-no-package",
