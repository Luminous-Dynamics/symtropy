      "left_slot": "slot-1",
      "right_slot": "slot-1",
      "basis": "encounter_slot",
      "expected": "admissible_alternative_hypothesis"
    },
    {
      "id": "symmetric-two-pedestrians",
      "candidate_maps": [
        [
          [
            "l-a",
            "r-a"
          ],
          [
            "l-b",
            "r-b"
          ]
        ],
        [
          [
            "l-a",
            "r-b"
          ],
          [
            "l-b",
            "r-a"
          ]
        ]
      ],
      "expected": "retain_both_maps"
    },
    {
