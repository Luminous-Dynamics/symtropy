        "actor_id": "ped-004",
        "tick": 120,
        "event_kind": "policy-reaction-noise"
      },
      "right": {
        "actor_id": "ped-004",
        "tick": 120,
        "event_kind": "policy-reaction-noise"
      },
      "coupling": "shared_invariant",
      "expected": "same_address"
    },
    {
      "id": "scene-slot-versus-actor-identity",
      "identity_basis_left": "actor_event",
      "identity_basis_right": "scene_slot_event",
      "coupling": "sensitivity_hypotheses",
      "expected": "different_addresses_not_implicitly_matched"
    },
    {
      "id": "directed-pair-role-change",
      "identity_basis": "directed_pair_event",
