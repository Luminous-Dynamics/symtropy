      },
      "right": {
        "initiator": "ped-004",
        "recipient": "ego-1",
        "tick": 121,
        "event_kind": "gap-acceptance"
      },
      "coupling": "shared_invariant",
      "expected": "different_addresses"
    },
    {
      "id": "branch-local-policy-draw",
      "identity_basis": "actor_event",
      "left_branch": "continue",
      "right_branch": "yield",
      "coupling": "branch_specific",
      "expected": "different_addresses"
    },
    {
      "id": "conditional-event-not-realized",
      "left_presence": "realized",
      "right_presence": "not_realized_with_causal_condition_witness",
      "expected": "conditional_presence_not_value_mismatch"
    },
    {
      "id": "unreported-counterpart",
      "left_presence": "realized",
      "right_presence": "missing_record",
      "expected": "incomplete"
    },
    {
      "id": "control-flow-insertion",
      "left_extra_policy_draws": 0,
      "right_extra_policy_draws": 1,
      "expected": "unrelated_shared_address_unchanged"
    },
    {
      "id": "endogenous-key-contamination",
      "forbidden_identity_inputs": [
        "action",
        "cue_contents",
        "velocity",
        "current_pose",
        "planner_output",
        "collision_state"
      ],
      "expected": "reject_by_contract"
    },
    {
      "id": "philox-branch-key-counter-mapping",
      "expected": "same qualified shared canonical address maps to identical 64-bit key, 128-bit counter and four output words"
    },
    {
      "id": "philox-call-order-invariance",
      "extra_unrelated_draws": [
        "policy-local",
        "sensor-local"
      ],
      "expected": "target address output unchanged"
    },
    {
      "id": "experiment-seed-separation",
      "expected": "changing 32-byte experiment seed changes full derivation digest"
    },
    {
      "id": "draw-address-length-prefix",
      "expected": "seed and canonical address each have separate u64-le length prefix"
    },
    {
      "id": "philox-truncation-collision-detection",
      "expected": "same 192-bit key-counter with different 256-bit digest rejected by run registry"
    },
    {
      "id": "address-kdf-length-prefix",
      "seed_length": 32,
      "length_encoding": "u64-little-endian",
      "address_length": "canonical_address_byte_length",
      "expected": "distinct-length-delimited-fields"
    },
    {
      "id": "address-kdf-domain-separation",
      "context": "Symtropy ROAD-EXO-COUPLING-001 Philox4x32-10 draw-address v0.1",
      "expected": "different-context-changes-derived-key"
    }
  ],
  "prng": {
    "algorithm": "Philox4x32-10",
    "implementation": "rand_philox",
    "version": "0.2.1",
    "derivation": "BLAKE3 derive-key v0.1",
    "dependency_pins": {
      "blake3": "1.8.7",
      "rand_philox": "0.2.1"
    },
    "consumption": "one Philox4x32-10 block and four u32 words per semantic DrawAddress",
    "mapping": {
      "experiment_seed": "exactly 32 bytes",
      "address": "DrawAddress.canonical_bytes()",
      "key_material": "u64le(seed_length) || seed || u64le(address_length) || canonical_address",
      "context": "Symtropy ROAD-EXO-COUPLING-001 Philox4x32-10 draw-address v0.1",
      "digest_bytes_0_8": "two little-endian u32 key words",
      "digest_bytes_8_24": "one little-endian u128 Philox block counter",
      "digest_bytes_24_32": "retained collision audit tag; not part of the Philox block address",
      "collision_model": "192-bit Philox (key,counter) mapping derived from 256-bit digest; full digest retained and run-local registry detects conflicting truncations"
    }
  },
