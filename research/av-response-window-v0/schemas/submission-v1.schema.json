{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-response-window-submission-v1.schema.json",
  "title": "AV Response Window Candidate Submission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "policy_id",
    "run_id",
    "model_revision",
    "runtime_revision",
    "responses",
    "timing_evidence_mode",
    "clock_relation_ref",
    "renderer_lifecycle_events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "av-response-window-v0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "response_id",
          "episode_id",
          "assigned_trigger_ref",
          "response_start_tick",
          "content",
          "response_end_tick",
          "playback_start_event_ref",
          "playback_end_event_ref",
          "playback_end_kind",
          "session_epoch",
          "turn_id"
        ],
        "properties": {
          "response_id": {
            "type": "string",
            "minLength": 1
          },
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "response_start_tick": {
            "type": "integer",
            "minimum": 0
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "assigned_trigger_ref": {
            "type": "string",
            "minLength": 1
          },
          "response_end_tick": {
            "type": "integer",
            "minimum": 0
          },
          "playback_start_event_ref": {
            "type": "string",
            "minLength": 1
          },
          "playback_end_event_ref": {
            "type": "string",
            "minLength": 1
          },
          "playback_end_kind": {
            "enum": [
              "playback_ended",
              "output_stopped"
            ]
          },
          "output_stop_request_event_ref": {
            "type": "string",
            "minLength": 1
          },
          "controller_permission_event_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Optional controller permission receipt; this is intent only and is never scored as audible playback."
          },
          "session_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "turn_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "playback_end_kind": {
                  "const": "output_stopped"
                }
              },
              "required": [
                "playback_end_kind"
              ]
            },
            "then": {
              "required": [
                "output_stop_request_event_ref"
              ]
            }
          }
        ]
      }
    },
    "timing_evidence_mode": {
      "enum": [
        "synthetic_reference",
        "renderer_qualified"
      ]
    },
    "clock_relation_ref": {
      "type": "string",
      "minLength": 1
    },
    "renderer_lifecycle_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_ref",
          "session_epoch",
          "turn_id",
          "event_kind",
          "tick"
        ],
        "properties": {
          "event_ref": {
            "type": "string",
            "minLength": 1
          },
          "session_epoch": {
            "type": "integer",
            "minimum": 1
          },
          "turn_id": {
            "type": "string",
            "minLength": 1
          },
          "event_kind": {
            "enum": [
              "assistant_speech_permitted",
              "playback_started",
              "playback_ended",
              "output_stop_requested",
              "output_stopped"
            ]
          },
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "cause_event_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event_kind": {
                  "const": "output_stopped"
                }
              },
              "required": [
                "event_kind"
              ]
            },
            "then": {
              "required": [
                "cause_event_ref"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "timing_evidence_mode": {
            "const": "renderer_qualified"
          }
        },
        "required": [
          "timing_evidence_mode"
        ]
      },
      "then": {
        "properties": {
          "clock_relation_ref": {
            "pattern": "^(sha256:)?[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
