{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/sanitation-t0-accounting-case-0.1.0.json",
  "title": "Sanitation T0 accounting-only benchmark case",
  "description": "A runtime-neutral synthetic case for checking water and selected constituent accounting. It is not a treatment-process model or safety certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_class",
    "evidence_ceiling",
    "description",
    "model_scope",
    "water_balance",
    "conserved_constituent_balances",
    "nonconservative_performance_metrics",
    "energy",
    "effluent_disposition",
    "expected_disposition",
    "expected_reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "case_class": {
      "const": "synthetic_accounting_only"
    },
    "evidence_ceiling": {
      "const": "arithmetic_conformance_only_no_physical_or_safety_claim"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "model_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_kinetics",
        "pathogen_model",
        "physical_measurements",
        "purpose"
      ],
      "properties": {
        "process_kinetics": {
          "const": "not_modelled"
        },
        "pathogen_model": {
          "const": "not_modelled"
        },
        "physical_measurements": {
          "const": "none_synthetic_values_only"
        },
        "purpose": {
          "const": "check_declared_arithmetic_and_units"
        }
      }
    },
    "water_balance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "influent_l_day",
        "effluent_l_day",
        "sludge_water_l_day",
        "evaporation_l_day",
        "expected_closure_l_day",
        "closure_tolerance_l_day"
      ],
      "properties": {
        "unit": {
          "const": "L/day"
        },
        "influent_l_day": {
          "type": "number",
          "minimum": 0
        },
        "effluent_l_day": {
          "type": "number",
          "minimum": 0
        },
        "sludge_water_l_day": {
          "type": "number",
          "minimum": 0
        },
        "evaporation_l_day": {
          "type": "number",
          "minimum": 0
        },
        "expected_closure_l_day": {
          "type": "number"
        },
        "closure_tolerance_l_day": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "conserved_constituent_balances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constituent",
          "unit",
          "influent_kg_day",
          "effluent_kg_day",
          "sludge_kg_day",
          "other_outputs_kg_day",
          "expected_closure_kg_day",
          "closure_tolerance_kg_day"
        ],
        "properties": {
          "constituent": {
            "enum": [
              "TSS",
              "total_nitrogen",
              "total_phosphorus"
            ]
          },
          "unit": {
            "const": "kg/day"
          },
          "influent_kg_day": {
            "type": "number",
            "minimum": 0
          },
          "effluent_kg_day": {
            "type": "number",
            "minimum": 0
          },
          "sludge_kg_day": {
            "type": "number",
            "minimum": 0
          },
          "other_outputs_kg_day": {
            "type": "number",
            "minimum": 0
          },
          "expected_closure_kg_day": {
            "type": "number"
          },
          "closure_tolerance_kg_day": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "nonconservative_performance_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter",
          "unit",
          "influent_mg_l",
          "effluent_mg_l",
          "influent_flow_l_day",
          "effluent_flow_l_day",
          "expected_load_removal_percent",
          "interpretation"
        ],
        "properties": {
          "parameter": {
            "enum": [
              "BOD5",
              "COD"
            ]
          },
          "unit": {
            "const": "mg/L"
          },
          "influent_mg_l": {
            "type": "number",
            "minimum": 0
          },
          "effluent_mg_l": {
            "type": "number",
            "minimum": 0
          },
          "influent_flow_l_day": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "effluent_flow_l_day": {
            "type": "number",
            "minimum": 0
          },
          "expected_load_removal_percent": {
            "type": "number"
          },
          "interpretation": {
            "const": "calculated_metric_not_a_conserved_species_or_compliance_result"
          }
        }
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "gross_import_kwh_day",
        "recovered_kwh_day",
        "net_import_kwh_day",
        "meter_boundary",
        "status"
      ],
      "properties": {
        "unit": {
          "const": "kWh/day"
        },
        "gross_import_kwh_day": {
          "type": "number",
          "minimum": 0
        },
        "recovered_kwh_day": {
          "type": "number",
          "minimum": 0
        },
        "net_import_kwh_day": {
          "type": "number",
          "minimum": 0
        },
        "meter_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "const": "synthetic_arithmetic_only_not_an_energy_performance_claim"
        }
      }
    },
    "effluent_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "effluent_produced_l_day",
        "allocated_for_reuse_l_day",
        "discharged_l_day",
        "reuse_delivered_l_day",
        "reuse_storage_change_l_day"
      ],
      "properties": {
        "unit": {
          "const": "L/day"
        },
        "effluent_produced_l_day": {
          "type": "number",
          "minimum": 0
        },
        "allocated_for_reuse_l_day": {
          "type": "number",
          "minimum": 0
        },
        "discharged_l_day": {
          "type": "number",
          "minimum": 0
        },
        "reuse_delivered_l_day": {
          "type": "number",
          "minimum": 0
        },
        "reuse_storage_change_l_day": {
          "type": "number"
        }
      }
    },
    "expected_disposition": {
      "enum": [
        "Accepted",
        "Rejected",
        "Indeterminate",
        "Unsupported"
      ]
    },
    "expected_reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "WATER_BALANCE_EXCEEDS_TOLERANCE",
          "CONSTITUENT_BALANCE_EXCEEDS_TOLERANCE",
          "INVALID_OR_MISSING_REQUIRED_INPUT",
          "UNSUPPORTED_PROCESS_OR_EVIDENCE_CLASS"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}
