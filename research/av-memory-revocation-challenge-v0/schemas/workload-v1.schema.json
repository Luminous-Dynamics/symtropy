{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-revocation-challenge-workload-v1.schema.json",
  "title": "AV Memory Revocation Challenge Workload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "note",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "av-memory-revocation-challenge-v0"
    },
    "note": {
      "type": "string"
    },
    "episodes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "layer",
        "created_tick",
        "derived_from_refs",
        "storage_scope"
      ],
      "properties": {
        "item_ref": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "enum": [
            "summary",
            "embedding",
            "retrieval_index",
            "working_context",
            "response_cache",
            "cross_modal_summary",
            "replica",
            "backup"
          ]
        },
        "created_tick": {
          "type": "integer",
          "minimum": 0
        },
        "derived_from_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "storage_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "stage",
        "kind",
        "query",
        "after_tick"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "pre_revocation",
            "post_revocation",
            "unrelated_control"
          ]
        },
        "kind": {
          "enum": [
            "direct",
            "paraphrase",
            "semantic",
            "nearest_neighbor",
            "cross_modal",
            "cache_replay",
            "restart",
            "replica_recall",
            "unrelated_control"
          ]
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "after_tick": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "source",
        "derived_items",
        "revocation",
        "probes"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_ref",
            "modality",
            "availability_tick",
            "source_content",
            "source_dependency_group"
          ],
          "properties": {
            "observation_ref": {
              "type": "string",
              "minLength": 1
            },
            "modality": {
              "enum": [
                "audio",
                "video"
              ]
            },
            "availability_tick": {
              "type": "integer",
              "minimum": 0
            },
            "source_content": {
              "type": "string",
              "minLength": 1
            },
            "source_dependency_group": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "derived_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derived"
          }
        },
        "revocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "availability_tick",
            "target_observation_ref",
            "scope_profile_id",
            "in_scope_storage_classes",
            "maximum_time_to_policy_ineligibility"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "minLength": 1
            },
            "availability_tick": {
              "type": "integer",
              "minimum": 0
            },
            "target_observation_ref": {
              "type": "string",
              "minLength": 1
            },
            "scope_profile_id": {
              "type": "string",
              "minLength": 1
            },
            "in_scope_storage_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "maximum_time_to_policy_ineligibility": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "probes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/probe"
          }
        },
        "unrelated_control": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_ref",
            "modality",
            "availability_tick",
            "source_content",
            "source_dependency_group"
          ],
          "properties": {
            "observation_ref": {
              "type": "string",
              "minLength": 1
            },
            "modality": {
              "enum": [
                "audio",
                "video"
              ]
            },
            "availability_tick": {
              "type": "integer",
              "minimum": 0
            },
            "source_content": {
              "type": "string",
              "minLength": 1
            },
            "source_dependency_group": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
