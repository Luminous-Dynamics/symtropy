{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.org/schemas/jurisdiction-profile-v1.schema.json",
  "title": "Source-qualified jurisdiction traffic convention profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "jurisdiction_code",
    "profile_status",
    "traffic_side",
    "steering_wheel_side",
    "roundabout_circulation",
    "sign_standard",
    "effective_from",
    "effective_to",
    "rule_bundle_sha256",
    "sources",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "jurisdiction_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "profile_status": {
      "enum": [
        "draft",
        "reviewed",
        "policy_eligible"
      ]
    },
    "traffic_side": {
      "enum": [
        "left",
        "right"
      ]
    },
    "steering_wheel_side": {
      "enum": [
        "left_hand_drive",
        "right_hand_drive",
        "unknown"
      ]
    },
    "roundabout_circulation": {
      "enum": [
        "clockwise",
        "counterclockwise",
        "unknown"
      ]
    },
    "sign_standard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "rule_bundle_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "authority",
        "title",
        "url",
        "source_kind",
        "edition_or_revision",
        "published_date",
        "effective_from",
        "effective_to",
        "content_sha256",
        "verification_status",
        "supported_rule_ids"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_kind": {
          "enum": [
            "government_guidance",
            "statute",
            "traffic_sign_manual",
            "dataset"
          ]
        },
        "edition_or_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        },
        "published_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "content_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "verification_status": {
          "enum": [
            "not_reviewed",
            "cross_checked",
            "legal_reviewed"
          ]
        },
        "supported_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "x-invariants": [
    "Traffic side, steering-wheel side and roundabout circulation are independent fields; none is inferred from another.",
    "A policy_eligible profile requires an exact profile effective date, a rule-bundle SHA-256, and at least one legally reviewed statute and one legally reviewed traffic-sign manual; each legally reviewed source must have an edition/revision, effective_from date and content digest.",
    "Draft and reviewed profiles may be structurally valid while remaining non-policy-eligible.",
    "The validator checks supplied digest syntax only. It does not fetch URLs, authenticate authorities, verify legal interpretation or certify a rule bundle."
  ]
}
