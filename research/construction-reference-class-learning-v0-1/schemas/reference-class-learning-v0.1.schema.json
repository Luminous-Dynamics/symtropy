{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/construction-reference-class-learning-v0.1.schema.json",
  "title": "Construction Reference-Class Learning Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id", "study_digest", "functional_unit", "applicability",
    "cases", "study_design", "effects", "partition_assignments"
  ],
  "properties": {
    "study_id": { "type": "string", "minLength": 1 },
    "study_digest": { "type": "string", "minLength": 1 },
    "functional_unit": { "$ref": "#/$defs/functionalUnit" },
    "applicability": { "$ref": "#/$defs/applicability" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "study_design": { "$ref": "#/$defs/studyDesign" },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
    "partition_assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/partition" } },
    "replication": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/replication" }] }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "functionalUnit": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "contract_digest", "unit_class_id", "unit_symbol", "acceptance_contract_digest", "currency_code", "assessment_horizon_months"],
      "properties": {
        "contract_id": { "$ref": "#/$defs/nonEmpty" },
        "contract_digest": { "$ref": "#/$defs/nonEmpty" },
        "unit_class_id": { "$ref": "#/$defs/nonEmpty" },
        "unit_symbol": { "$ref": "#/$defs/nonEmpty" },
        "acceptance_contract_digest": { "$ref": "#/$defs/nonEmpty" },
        "currency_code": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "assessment_horizon_months": { "type": "integer", "minimum": 1 }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "site_id", "floor_or_zone_id", "work_package_id", "task_family_id", "design_revision_digest", "method_profile_digest", "fleet_profile_digest", "site_epoch", "target_frame_id", "attributes"],
      "properties": {
        "project_id": { "$ref": "#/$defs/nonEmpty" },
        "site_id": { "$ref": "#/$defs/nonEmpty" },
        "floor_or_zone_id": { "$ref": "#/$defs/nonEmpty" },
        "work_package_id": { "$ref": "#/$defs/nonEmpty" },
        "task_family_id": { "$ref": "#/$defs/nonEmpty" },
        "design_revision_digest": { "$ref": "#/$defs/nonEmpty" },
        "method_profile_digest": { "$ref": "#/$defs/nonEmpty" },
        "fleet_profile_digest": { "$ref": "#/$defs/nonEmpty" },
        "site_epoch": { "$ref": "#/$defs/nonEmpty" },
        "target_frame_id": { "$ref": "#/$defs/nonEmpty" },
        "attributes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["planned_units", "attempted_units", "first_pass_inspected_units", "first_pass_accepted_units", "finally_accepted_units", "finally_rejected_units", "unresolved_units", "rework_attempts", "total_workflow_crew_minutes", "elapsed_minutes", "direct_cost_minor_units", "shared_cost_minor_units", "energy_wh", "carbon_gco2e"],
      "properties": {
        "planned_units": { "type": "integer", "minimum": 0 },
        "attempted_units": { "type": "integer", "minimum": 0 },
        "first_pass_inspected_units": { "type": "integer", "minimum": 0 },
        "first_pass_accepted_units": { "type": "integer", "minimum": 0 },
        "finally_accepted_units": { "type": "integer", "minimum": 0 },
        "finally_rejected_units": { "type": "integer", "minimum": 0 },
        "unresolved_units": { "type": "integer", "minimum": 0 },
        "rework_attempts": { "type": "integer", "minimum": 0 },
        "total_workflow_crew_minutes": { "type": "integer", "minimum": 0 },
        "elapsed_minutes": { "type": "integer", "minimum": 0 },
        "direct_cost_minor_units": { "type": "integer", "minimum": 0 },
        "shared_cost_minor_units": { "type": "integer", "minimum": 0 },
        "energy_wh": { "type": "integer", "minimum": 0 },
        "carbon_gco2e": { "type": "integer", "minimum": 0 }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "artifact_ref", "content_digest", "supported_claim_ref", "status"],
      "properties": {
        "evidence_id": { "$ref": "#/$defs/nonEmpty" },
        "artifact_ref": { "$ref": "#/$defs/nonEmpty" },
        "content_digest": { "$ref": "#/$defs/nonEmpty" },
        "supported_claim_ref": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["AdmissibleForDeclaredClaim", "Unknown", "Invalidated", "Revoked"] }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "case_digest", "role", "functional_unit", "context", "outcome", "source_evidence"],
      "properties": {
        "case_id": { "$ref": "#/$defs/nonEmpty" },
        "case_digest": { "$ref": "#/$defs/nonEmpty" },
        "role": { "enum": ["Descriptive", "Treatment", "Control", "PreIntervention", "PostIntervention"] },
        "functional_unit": { "$ref": "#/$defs/functionalUnit" },
        "context": { "$ref": "#/$defs/context" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "source_evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["envelope_id", "dimensions", "excluded_values"],
      "properties": {
        "envelope_id": { "$ref": "#/$defs/nonEmpty" },
        "dimensions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } } },
        "excluded_values": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } } }
      }
    },
    "partition": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "partition"],
      "properties": {
        "case_id": { "$ref": "#/$defs/nonEmpty" },
        "partition": { "enum": ["Training", "Validation", "Test", "BlindChallenge"] }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "disposition", "evidence_ref"],
      "properties": {
        "kind": { "enum": ["PreInterventionTrend", "PlaceboOutcome", "ShuffledTreatment", "SensitivityAnalysis", "CommonCauseReview", "RandomizationIntegrity", "ContaminationAssessment", "IntentToTreatAnalysis", "ClusterCorrectedAnalysis"] },
        "disposition": { "enum": ["Passed", "Failed", "NotEvaluated"] },
        "evidence_ref": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "studyDesign": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "rationale_ref"],
          "properties": { "type": { "const": "Descriptive" }, "rationale_ref": { "$ref": "#/$defs/nonEmpty" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "treatment_case_ids", "control_case_ids", "matching_variable_ids", "balance_report_ref", "balance_disposition"],
          "properties": {
            "type": { "const": "MatchedObservational" },
            "treatment_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "control_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "matching_variable_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "balance_report_ref": { "$ref": "#/$defs/nonEmpty" },
            "balance_disposition": { "enum": ["Passed", "Failed", "NotEvaluated"] }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "method", "pre_case_ids", "post_case_ids", "assignment_unit", "preregistration_ref", "intervention_ref", "identification_assumptions", "diagnostics"],
          "properties": {
            "type": { "const": "QuasiExperimental" },
            "method": { "enum": ["DifferenceInDifferences", "InterruptedTimeSeries"] },
            "pre_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "post_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "assignment_unit": { "enum": ["Task", "WorkPackage", "Shift", "Floor", "Site", "Project"] },
            "preregistration_ref": { "$ref": "#/$defs/nonEmpty" },
            "intervention_ref": { "$ref": "#/$defs/nonEmpty" },
            "identification_assumptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "treatment_case_ids", "control_case_ids", "assignment_unit", "preregistration_ref", "allocation_protocol_ref", "allocation_record_ref", "intent_to_treat_ref", "diagnostics"],
          "properties": {
            "type": { "const": "Randomized" },
            "treatment_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "control_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
            "assignment_unit": { "enum": ["Task", "WorkPackage", "Shift", "Floor", "Site", "Project"] },
            "preregistration_ref": { "$ref": "#/$defs/nonEmpty" },
            "allocation_protocol_ref": { "$ref": "#/$defs/nonEmpty" },
            "allocation_record_ref": { "$ref": "#/$defs/nonEmpty" },
            "intent_to_treat_ref": { "$ref": "#/$defs/nonEmpty" },
            "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
          }
        }
      ]
    },
    "effect": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "unit_symbol", "scale", "estimate", "lower_bound", "upper_bound", "estimate_method_ref", "interval_method_ref", "source_report_ref", "observation_count", "independent_cluster_count"],
      "properties": {
        "metric_id": { "$ref": "#/$defs/nonEmpty" },
        "unit_symbol": { "$ref": "#/$defs/nonEmpty" },
        "scale": { "type": "integer", "minimum": 1 },
        "estimate": { "type": "integer" },
        "lower_bound": { "type": "integer" },
        "upper_bound": { "type": "integer" },
        "estimate_method_ref": { "$ref": "#/$defs/nonEmpty" },
        "interval_method_ref": { "$ref": "#/$defs/nonEmpty" },
        "source_report_ref": { "$ref": "#/$defs/nonEmpty" },
        "observation_count": { "type": "integer", "minimum": 1 },
        "independent_cluster_count": { "type": "integer", "minimum": 1 }
      }
    },
    "replication": {
      "type": "object", "additionalProperties": false,
      "required": ["replication_protocol_ref", "included_case_ids", "independent_assessor_refs"],
      "properties": {
        "replication_protocol_ref": { "$ref": "#/$defs/nonEmpty" },
        "included_case_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
        "independent_assessor_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    }
  }
}
