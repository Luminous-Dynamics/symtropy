  },
  "gate_definitions": [
    {
      "gate_id": "legal_and_operating_scope",
      "meaning": "The candidate's declared legal/product scope is explicitly admissible for this synthetic scenario.",
      "hard_gate": true
    },
    {
      "gate_id": "essential_access_fit",
      "meaning": "The option fits the declared trip, passenger/cargo and access needs in this synthetic scenario.",
      "hard_gate": true
    },
    {
      "gate_id": "energy_or_service_access",
      "meaning": "A compatible energy/replenishment or service commitment is explicitly present for this synthetic scenario.",
      "hard_gate": true
    },
    {
      "gate_id": "repair_and_recovery_path",
      "meaning": "A declared maintenance/repair/recovery path exists for this synthetic scenario.",
      "hard_gate": true
    },
    {
      "gate_id": "privacy_and_owner_control",
      "meaning": "Owner data/control and privacy obligations are met for this synthetic scenario.",
      "hard_gate": true
    }
  ],
  "metric_definitions": [
    {
      "metric_id": "monthly_budget_burden_ratio",
      "unit": "ratio",
      "direction": "minimize",
      "meaning": "Synthetic monthly mobility cost divided by a synthetic declared mobility budget; no price or income claim."
    },
    {
      "metric_id": "essential_trip_coverage",
      "unit": "fraction",
      "direction": "maximize",
      "meaning": "Synthetic fraction of defined essential trip demand served within declared requirements."
    },
    {
      "metric_id": "repair_downtime_hours_month",
      "unit": "hours_per_month",
      "direction": "minimize",
      "meaning": "Synthetic unavailable hours per month including repair/service delay."
    },
    {
      "metric_id": "p90_access_time_minutes",
      "unit": "minutes",
      "direction": "minimize",
      "meaning": "Synthetic 90th-percentile door-to-service access time in this scenario."
    },
    {
      "metric_id": "lifecycle_resource_index",
      "unit": "normalized_index",
      "direction": "minimize",
      "meaning": "Synthetic relative lifecycle resource-impact index. Not a measured emissions or environmental indicator."
    }
  ],
