      "meaning": "Applicable environmental assessment and authorization are documented.",
      "hard_gate": true
    },
    {
      "gate_id": "ant_spill_waste_control",
      "meaning": "Fuel, batteries, waste and spill response are controlled for the mission.",
      "hard_gate": true
    },
    {
