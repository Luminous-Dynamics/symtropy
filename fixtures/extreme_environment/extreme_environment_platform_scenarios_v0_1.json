      "environment_id": "congo_basin",
      "label": "Congo Basin",
      "design_constraints": [
        "saturated soil and forest/peatland sensitivity",
        "high humidity and biological contamination risk",
        "limited heavy-equipment recovery access",
        "local repairability and community impact"
      ],
      "ecological_no_go": [
        "no peatland crossing without site-specific approval",
        "no invasive-species transfer between sites",
        "no uncontained lubricants, fuel or batteries"
      ],
      "regional_caveat": "Do not infer safe routes, soil bearing capacity or community consent from a basin-wide label."
    },
    {
      "environment_id": "antarctica",
      "label": "Antarctica",
      "design_constraints": [
        "cold-soak and battery/actuator derating",
        "wind, whiteout and changing snow/ice conditions",
        "remote recovery and long resupply lead times",
        "environmental assessment, waste and spill prevention"
      ],
      "ecological_no_go": [
        "no deployment without applicable authorization and environmental assessment",
        "no unplanned waste/fuel release",
        "no unapproved approach to wildlife or protected areas"
      ],
      "regional_caveat": "This synthetic benchmark is not a permit. Applicable Antarctic Treaty System and national procedures control real operations."
    },
    {
      "environment_id": "sahara",
      "label": "Sahara",
      "design_constraints": [
        "high solar load and hot-soak limits",
        "fine dust ingress and abrasive surfaces",
        "soft sand, rock and wadi/flood risk",
        "water, cooling and recovery logistics"
      ],
      "ecological_no_go": [
        "no assumption of water availability",
        "no unrecovered disabled platform in remote terrain",
        "no dust/fuel/chemical release beyond approved handling"
      ],
      "regional_caveat": "The Sahara includes many climates and surfaces; a route/time/season-specific mission envelope is required."
    },
    {
      "environment_id": "afghanistan",
      "label": "Afghanistan",
      "design_constraints": [
        "mountainous routes, seasonal snow and poor road access",
        "remote medical/humanitarian resupply",
        "uncertain communications and recovery access",
        "explosive ordnance contamination must be treated as a no-go unless an authorized process establishes safe access"
      ],
      "ecological_no_go": [
        "no entry to suspected explosive-hazard areas",
        "no autonomous mine/ERW manipulation",
        "no armed payloads, targeting or tactical deployment"
      ],
      "regional_caveat": "Countrywide assumptions are inappropriate. Work only within a specific civilian mission, authorized route and local humanitarian coordination process."
    }
