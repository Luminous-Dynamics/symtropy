    {
      "gate_id": "sah_water_energy_plan",
      "meaning": "Water and energy supply assumptions match the mission logistics.",
      "hard_gate": true
    },
    {
      "gate_id": "sah_terrain_fit",
      "meaning": "Sand, rock, slope and wadi limits fit declared conditions.",
      "hard_gate": true
    },
    {
      "gate_id": "sah_recovery_plan",
      "meaning": "Recovery support, consumables and disabled-vehicle retrieval are planned.",
      "hard_gate": true
    },
    {
