  "gate_definitions": [
    {
      "gate_id": "amz_waterway_access",
      "meaning": "Local waterway, landing and access permission is confirmed.",
      "hard_gate": true
    },
    {
      "gate_id": "amz_water_containment",
      "meaning": "Energy system and cargo avoid unmanaged fuel/oil/chemical discharge.",
      "hard_gate": true
    },
    {
      "gate_id": "amz_habitat_disturbance",
      "meaning": "Ground/waterway and wildlife disturbance is within approved site limits.",
      "hard_gate": true
    },
    {
      "gate_id": "amz_community_consent",
      "meaning": "Affected community and responsible operator have approved the mission.",
      "hard_gate": true
    },
    {
      "gate_id": "amz_recovery_plan",
      "meaning": "A feasible recovery/tow/manual retrieval plan is present.",
      "hard_gate": true
    },
    {
