      "meaning": "Cleaning and biological transfer controls are defined and feasible.",
      "hard_gate": true
    },
    {
      "gate_id": "congo_local_repair_path",
      "meaning": "Parts, tools, and a locally supportable repair route exist.",
      "hard_gate": true
    },
    {
      "gate_id": "congo_community_consent",
      "meaning": "Community participation and consent for the use case are recorded.",
      "hard_gate": true
    },
    {
      "gate_id": "congo_recovery_plan",
      "meaning": "Recovery does not depend on unvalidated heavy equipment access.",
      "hard_gate": true
    },
    {
