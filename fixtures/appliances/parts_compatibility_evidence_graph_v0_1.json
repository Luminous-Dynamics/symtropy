  "benchmarks": [
    {
      "id": "PC-B-001",
      "metric_id": "exact_model_evidence_coverage",
      "target_hypothesis": "Every declared common-repair class has exact model/revision evidence or an explicit unknown/single-source marker.",
      "status": "proposal_not_frozen",
      "measurement_rule": "Denominator is the predeclared common-repair class set, not only classes with known parts."
    },
    {
      "id": "PC-B-002",
      "metric_id": "false_compatible_rate",
      "target_hypothesis": "Zero false-compatible claims on a frozen positive, negative, and ambiguous holdout corpus.",
      "status": "guardrail_contract_only",
      "measurement_rule": "A false-compatible result is presented as verified while independent fit/function evidence disagrees."
    },
    {
      "id": "PC-B-003",
      "metric_id": "wrong_order_rate",
      "target_hypothesis": "Reduce misfit orders and returns relative to a documented baseline; freeze a target after baseline data.",
      "status": "proposal_not_frozen",
      "measurement_rule": "Count all orders with the exact model/revision; preserve unknown outcomes separately."
    },
    {
      "id": "PC-B-004",
      "metric_id": "time_to_correct_part",
      "target_hypothesis": "Reduce median and P90 time from fault confirmation to correct part physically received and identity-checked.",
      "status": "proposal_not_frozen",
      "measurement_rule": "Use order-acceptance and delivery timestamps; listing and quote dates are not delivery."
    },
    {
      "id": "PC-B-005",
      "metric_id": "independent_source_count",
      "target_hypothesis": "Aim for two independent verified supply paths for critical/common repairs where feasible.",
      "status": "proposal_not_frozen",
      "measurement_rule": "Group distributors and suppliers by upstream dependency; same-source resellers count once."
    },
    {
      "id": "PC-B-006",
      "metric_id": "evidence_freshness",
      "target_hypothesis": "Every active claim has dated evidence and explicit applicability; stale/superseded claims are flagged.",
      "status": "guardrail_contract_only",
      "measurement_rule": "Report capture date, revision coverage, serial scope, recheck date and supersession."
    }
  ],
  "policy": {
    "identity_rule": "exact_model_revision_and_market_required_for_positive_fitment_claim",
    "evidence_hierarchy": "seller_claim_or_catalogue_listing_never_implies_physical_fit_function_or_safety_qualification",
    "unknown_policy": "absence_of_evidence_is_unknown_not_incompatible",
    "independence_rule": "supplier_paths_sharing_upstream_dependency_group_count_as_one_source",
    "freshness_rule": "expired_or_superseded_claim_cannot_be_current_fitment_evidence",
    "winner_claim_allowed": false
  }
