    },
    {
      "id": "RB-002",
      "metric_id": "p90_restoration_time",
      "target_statement": "At least 20% lower P90 time to verified restoration than the frozen matched control; hypothesis, not a result.",
      "status": "proposal_not_frozen",
      "comparison_scope": "Report sample size, bootstrap interval and all failed/abandoned attempts; do not omit the slow tail."
    },
    {
      "id": "RB-003",
      "metric_id": "same_fault_recurrence",
      "target_statement": "Target at least 20% relative reduction in same-fault recurrence after preregistered time and use-exposure windows; hypothesis, not a result.",
      "status": "proposal_not_frozen",
      "comparison_scope": "Use a product-appropriate exposure metric plus calendar follow-up; preserve right-censoring and loss-to-follow-up."
    },
    {
      "id": "RB-004",
      "metric_id": "false_safe_diagnostic",
      "target_statement": "Zero false-safe recommendations on the frozen finite hazard and contradictory-control corpus; software guardrail only, not a product-safety claim.",
      "status": "guardrail_contract_only",
      "comparison_scope": "Publish corpus digest, case census, negative controls and independent reviewer disposition."
    },
    {
      "id": "RB-005",
      "metric_id": "restoration_receipt_coverage",
      "target_statement": "100% of positive restoration claims carry both useful-function and safety-verification receipts.",
      "status": "guardrail_contract_only",
      "comparison_scope": "Every episode; missing receipts invalidate the positive claim rather than being imputed."
    },
    {
      "id": "RB-006",
      "metric_id": "safe_user_task_completion",
      "target_statement": "At least 90% completion of approved low-risk user tasks, counting correct safe referral as a valid outcome when the task crosses a hazard boundary; hypothesis.",
      "status": "proposal_not_frozen",
      "comparison_scope": "Representative participants, task definitions frozen in advance, and unsafe attempts recorded separately."
    },
    {
      "id": "RB-007",
      "metric_id": "whole_episode_cost_per_useful_output",
