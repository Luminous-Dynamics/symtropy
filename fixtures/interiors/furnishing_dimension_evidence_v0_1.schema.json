{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/fixtures/interiors/furnishing_dimension_evidence_v0_1.schema.json",
  "title": "Furnishing dimension evidence v0.1",
  "description": "Provenance and bounded uncertainty for room/product dimensions. Structural validity does not authenticate sources or prove measured truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "status", "units", "records"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["synthetic_fixture", "evidence_snapshot"] },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length"],
      "properties": { "length": { "const": "m" } }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_m", "max_m"],
      "properties": {
        "min_m": { "type": "number" },
        "max_m": { "type": "number" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id"],
      "properties": {
        "kind": { "enum": ["room", "product", "placement"] },
        "subject_id": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_kind", "captured_at"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "source_kind": {
          "enum": [
            "site_measurement",
            "manufacturer_document",
            "seller_listing",
            "catalog_nominal",
            "product_database",
            "unknown"
          ]
        },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "subject", "axis", "state", "recorded_at"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "subject": { "$ref": "#/$defs/subject" },
        "axis": { "enum": ["x", "y", "width", "depth", "height"] },
        "state": {
          "enum": [
            "measured",
            "manufacturer_specified",
            "seller_estimated",
            "nominal",
            "unknown"
          ]
        },
        "bounds_m": { "$ref": "#/$defs/bounds" },
        "method": {
          "enum": [
            "tape_measure",
            "laser_measure",
            "phone_scan",
            "survey",
            "manufacturer_specification",
            "catalog_import",
            "seller_estimate",
            "seller_dimension_note",
            "photo_estimate",
            "design_nominal",
            "catalog_nominal",
            "unavailable"
          ]
        },
        "source": { "$ref": "#/$defs/source" },
        "recorded_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["measured", "manufacturer_specified", "seller_estimated", "nominal"] } }, "required": ["state"] },
          "then": { "required": ["bounds_m", "method", "source"] }
        },
        {
          "if": { "properties": { "state": { "const": "unknown" } }, "required": ["state"] },
          "then": {
            "not": { "required": ["bounds_m"] },
            "properties": {
              "method": { "const": "unavailable" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "measured" } }, "required": ["state"] },
          "then": {
            "properties": {
              "source": { "properties": { "source_kind": { "const": "site_measurement" } }, "required": ["source_kind"] },
              "method": { "enum": ["tape_measure", "laser_measure", "phone_scan", "survey"] }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "manufacturer_specified" } }, "required": ["state"] },
          "then": {
            "properties": {
              "source": { "properties": { "source_kind": { "enum": ["manufacturer_document", "product_database"] } }, "required": ["source_kind"] },
              "method": { "enum": ["manufacturer_specification", "catalog_import"] }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "seller_estimated" } }, "required": ["state"] },
          "then": {
            "properties": {
              "source": { "properties": { "source_kind": { "const": "seller_listing" } }, "required": ["source_kind"] },
              "method": { "enum": ["seller_estimate", "seller_dimension_note", "photo_estimate"] }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "nominal" } }, "required": ["state"] },
          "then": {
            "properties": {
              "source": { "properties": { "source_kind": { "enum": ["catalog_nominal", "manufacturer_document", "product_database"] } }, "required": ["source_kind"] },
              "method": { "enum": ["design_nominal", "catalog_nominal"] }
            }
          }
        },
        {
          "if": { "properties": { "axis": { "enum": ["width", "depth", "height"] } }, "required": ["axis"] },
          "then": {
            "properties": {
              "bounds_m": {
                "properties": { "min_m": { "exclusiveMinimum": 0 }, "max_m": { "exclusiveMinimum": 0 } },
                "required": ["min_m", "max_m"]
              }
            }
          }
        }
      ]
    }
  }
}