                      "manifest_schema_version": {
                        "const": 1
                      },
                      "world_manifest_artifact": {
                        "type": "object"
                      },
                      "truth_crosswalk_sha256": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "properties": {
                      "scenario_id": {
                        "type": "string"
                      },
                      "world_generation": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "manifest_schema_version": {
                        "const": 1
                      },
                      "world_manifest_artifact": {
                        "type": "object"
                      },
                      "truth_crosswalk_sha256": {
                        "type": "string"
