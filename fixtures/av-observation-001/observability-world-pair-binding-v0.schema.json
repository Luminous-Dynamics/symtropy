          }
        },
        "required": [
          "registry_status"
        ]
      },
      "then": {
        "properties": {
          "pairs": {
            "items": {
              "properties": {
                "binding_status": {
                  "enum": [
                    "rendered_replay_verified",
                    "blind_ready"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry_status": {
            "const": "blind_ready"
          }
        },
        "required": [
          "registry_status"
        ]
      },
      "then": {
        "properties": {
          "pairs": {
            "items": {
