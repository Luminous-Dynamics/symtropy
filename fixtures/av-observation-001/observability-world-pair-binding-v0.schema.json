                  "const": "unbound"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry_status": {
            "const": "partially_bound"
          }
        },
        "required": [
          "registry_status"
        ]
      },
      "then": {
        "properties": {
          "pairs": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "binding_status": {
                      "enum": [
                        "manifest_bound",
                        "prefix_committed",
                        "rendered_replay_verified",
                        "blind_ready"
                      ]
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "binding_status": {
                      "const": "unbound"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "registry_status": {
            "const": "all_manifest_bound"
          }
        },
        "required": [
          "registry_status"
        ]
      },
      "then": {
        "properties": {
          "pairs": {
            "items": {
              "properties": {
                "binding_status": {
                  "enum": [
                    "manifest_bound",
                    "prefix_committed",
                    "rendered_replay_verified",
                    "blind_ready"
                  ]
                }
              }
            }
