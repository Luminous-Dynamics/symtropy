  "metrics":[
    {"id":"attempt_terminal_event_coverage","unit":"fraction","denominator":"started_attempts","scope":"Started attempts with exactly one valid terminal event and complete reconciliation.","target_hypothesis":">=0.9999","status":"proposal_target_only","hard_guardrails":["unknown_terminal_blocks_summary","attempt_count_reconciliation"]},
    {"id":"sop_step_boundary_coverage","unit":"fraction","denominator":"expected_sop_steps","scope":"Expected SOP steps with valid monotonic start/end and stable identity.","target_hypothesis":">=0.99","status":"proposal_target_only","hard_guardrails":["clock_quality_recorded","missing_step_not_silent"]},
    {"id":"failure_taxonomy_coverage","unit":"fraction","denominator":"failure_events","scope":"Failure events assigned to a versioned family; unknown remains unclassified and visible.","target_hypothesis":">=0.99","status":"proposal_target_only","hard_guardrails":["unknown_not_success","taxonomy_versioned"]},
    {"id":"adjudicated_label_agreement","unit":"cohen_kappa","denominator":"double_annotated_episode_sample","scope":"Agreement on outcome, step boundaries and failure class in a blinded/adjudicated sample.","target_hypothesis":">=0.85","status":"proposal_target_only","hard_guardrails":["sample_randomly_includes_success_and_failure","disagreement_retained"]},
    {"id":"promoted_artifact_integrity","unit":"fraction","denominator":"promoted_artifacts","scope":"Promoted artifacts with verified digest and upstream receipt before local deletion.","target_hypothesis":"1.0","status":"proposal_target_only","hard_guardrails":["digest_required","receipt_before_delete"]},
    {"id":"injected_fault_localization","unit":"fraction","denominator":"frozen_fault_injection_trials","scope":"Correct step/failure-family localization for injected faults including drift, network and evidence faults.","target_hypothesis":">=0.95","status":"proposal_target_only","hard_guardrails":["fault_ground_truth_frozen","no_posthoc_exclusion"]},
    {"id":"offline_event_retention","unit":"fraction","denominator":"started_attempts_during_network_outage","scope":"Started attempts preserved locally and reconciled after declared network interruption.","target_hypothesis":"1.0","status":"proposal_target_only","hard_guardrails":["local_first_recording","no_network_dependency_for_safe_recovery"]},
    {"id":"site_hardware_stratified_availability","unit":"fraction","denominator":"scheduled_operating_time","scope":"Operational availability by site, hardware revision and maintenance state.","target_hypothesis":"Report MTBF/MTTR and establish baseline before setting acceptance threshold.","status":"proposal_target_only","hard_guardrails":["planned_and_unplanned_downtime_separated","all_sites_reported"]},
    {"id":"event_chain_continuity","unit":"fraction","denominator":"episode_events","scope":"Events with monotonic sequence, previous digest and canonical event digest in a valid chain.","target_hypothesis":"1.0 within every promoted episode.","status":"proposal_target_only","hard_guardrails":["duplicate_sequence_fails","digest_chain_fail_closed"]},
    {"id":"reconciliation_completeness","unit":"fraction","denominator":"production_runs","scope":"Run totals reconcile across first-pass outcome, rework, terminal state, intervention and destination events.","target_hypothesis":"1.0","status":"proposal_target_only","hard_guardrails":["all_retries_linked","wrong_destination_rejected"]},
