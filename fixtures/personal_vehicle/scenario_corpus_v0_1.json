  "status_semantics": {
    "eligible_for_model_evaluation": "Input contract appears complete for a named model; this is not a physical result or safety pass.",
    "insufficient_evidence": "Required provenance, validation envelope or model capability is absent; abstain.",
    "reject_before_simulation": "Input/schema/units/configuration violates a hard precondition; do not invoke solver.",
    "simulation_failure_not_promoted": "The solver failed or did not converge; preserve failure evidence and emit no valid prediction.",
    "eligible_only_if_wet_profile_is_validated": "Evaluate only if independent evidence covers that exact surface/condition; otherwise abstain.",
    "eligible_only_for_validated_actuator_profile": "Evaluate only when the specified actuator-degradation profile is calibrated and validated.",
    "eligible_if_load_profile_is_in_bounds": "Evaluate only within the declared load/CG model envelope.",
    "reject_as_mismatched_configuration": "Exact hardware/configuration revisions do not match the calibration/compatibility manifest.",
    "reject_as_tampered_evidence": "The run result's provenance conflicts with the exact manifest.",
    "eligible_if_powertrain_profile_is_validated": "Evaluate only if the specified powertrain derating profile is validated.",
    "eligible_for_lifecycle_model_not_automatic_failure_claim": "Lifecycle accounting may represent overdue service; physical failure must remain a separate evidence-backed event.",
    "insufficient_evidence_if_transient_contact_is_unmodeled": "Abstain if the model cannot represent the transient contact profile.",
    "insufficient_evidence_if_split_mu_dynamics_are_unvalidated": "Abstain if split-friction steering/yaw dynamics have not been validated.",
    "insufficient_evidence_if_thermal_brake_model_unqualified": "Abstain if brake thermal/fade behavior is outside the validated profile.",
    "insufficient_evidence_if_brake_blending_unqualified": "Abstain if regenerative/friction brake handoff is not qualified.",
    "insufficient_evidence_if_relevant_suspension_dynamics_are_missing": "Abstain if the model lacks the required ride/suspension states.",
    "insufficient_evidence_if_contact_loss_is_unmodeled": "Abstain if contact loss is outside the model's represented state.",
    "eligible_only_for_model_evaluation": "Eligibility authorizes only model evaluation within its stated envelope."
  },
  "claim_ceiling": [
    "This corpus tests schema, manifest binding, expected statuses and declared invariants only.",
    "It contains synthetic, not measured, vehicle parameters.",
    "No case establishes physical braking, handling, crashworthiness, roadworthiness, vehicle lifetime, commercial cost savings or autonomous-driving safety."
