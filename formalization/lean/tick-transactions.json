  "invariants": [
    {
      "id": "tick.begin.monotonic",
      "theorem": "SymtropyFormal.begin_rejects_nonmonotonic_tick",
      "claim": "A tick ID not greater than the last finalized ID cannot begin."
    },
    {
      "id": "tick.begin.state-link",
      "theorem": "SymtropyFormal.begin_rejects_prior_state_mismatch",
      "claim": "A next tick whose prior-state digest does not equal the last result cannot begin."
    },
    {
      "id": "tick.physics.phase",
      "theorem": "SymtropyFormal.applyPhysics_rejects_non_begun_phase",
      "claim": "Physics cannot be marked applied for a tick that is not in the begun phase."
    },
    {
      "id": "tick.finalize.phase",
      "theorem": "SymtropyFormal.finalize_rejects_before_physics",
      "claim": "A tick in the begun phase cannot be finalized."
    },
    {
      "id": "tick.finalize.idempotent",
      "theorem": "SymtropyFormal.finalize_same_result_is_idempotent",
      "claim": "Repeating finalization with the same result digest leaves modeled state unchanged."
    },
    {
      "id": "tick.finalize.conflict",
      "theorem": "SymtropyFormal.finalize_conflicting_result_is_rejected",
      "claim": "A second finalization with a conflicting result digest is rejected."
    },
    {
      "id": "tick.physics.no-preexisting-result",
      "theorem": "SymtropyFormal.applyPhysics_rejects_prepopulated_result",
      "claim": "A begun tick carrying a pre-existing result digest cannot advance to physics-applied."
    },
    {
      "id": "tick.finalize.state-link",
      "theorem": "SymtropyFormal.finalize_rejects_unlinked_tick",
      "claim": "A finalization whose active tick prior-state digest disagrees with the last result is rejected."
    }
  ],
  "known_answer_cases": [
