  "theorem_bindings": [
    {
      "id": "allocation.nonnegative",
      "theorem": "SymtropyFormal.waterline_allocation_nonnegative",
      "claim": "A non-negative cap and waterline yield a non-negative per-recipient allocation."
    },
    {
      "id": "allocation.cap",
      "theorem": "SymtropyFormal.waterline_allocation_respects_cap",
      "claim": "No per-recipient allocation exceeds its cap."
    },
    {
      "id": "allocation.saturating-recipient",
      "theorem": "SymtropyFormal.waterline_saturates_constrained_recipient",
      "claim": "A cap at or below the waterline is saturated exactly at cap."
    },
    {
      "id": "allocation.equal-share",
      "theorem": "SymtropyFormal.waterline_equalizes_unsaturated_recipient",
      "claim": "A recipient whose cap is above the waterline receives exactly the waterline amount."
    },
    {
      "id": "allocation.permutation",
      "theorem": "SymtropyFormal.waterline_allocation_permutation_invariant",
      "claim": "Permuting cap input permutes allocations correspondingly."
    },
    {
      "id": "allocation.supply",
      "theorem": "SymtropyFormal.accepted_waterline_respects_supply",
      "claim": "An accepted certificate cannot allocate more than available supply."
    },
    {
      "id": "allocation.capacity",
      "theorem": "SymtropyFormal.accepted_waterline_respects_total_capacity",
      "claim": "An accepted certificate cannot allocate more than total recipient capacity."
    },
    {
      "id": "allocation.nonnegative-vector",
      "theorem": "SymtropyFormal.accepted_waterline_allocations_nonnegative",
      "claim": "Every allocation in an accepted certificate is non-negative."
    },
    {
      "id": "allocation.positive-control",
      "theorem": "SymtropyFormal.sample_waterline_certificate_is_accepted",
      "claim": "The constrained-plus-equal-share example is accepted."
    },
    {
      "id": "allocation.negative-control",
      "theorem": "SymtropyFormal.over_budget_waterline_certificate_is_rejected",
      "claim": "A certificate that over-allocates the source budget is rejected."
    },
    {
      "id": "allocation.empty-demand",
      "theorem": "SymtropyFormal.empty_demand_waterline_certificate_is_accepted",
      "claim": "Empty demand leaves supply unallocated and is accepted."
    },
    {
      "id": "allocation.zero-supply",
      "theorem": "SymtropyFormal.zero_supply_waterline_certificate_is_accepted",
      "claim": "Zero supply allocates zero even with positive caps."
    },
    {
      "id": "allocation.capacity-limited",
      "theorem": "SymtropyFormal.capacity_limited_waterline_certificate_is_accepted",
      "claim": "When supply exceeds total capacity, all recipients saturate and the certificate closes to total capacity."
    },
    {
      "id": "allocation.negative-cap-rejected",
      "theorem": "SymtropyFormal.negative_cap_waterline_certificate_is_rejected",
      "claim": "A negative recipient cap causes certificate rejection."
    }
  ],
