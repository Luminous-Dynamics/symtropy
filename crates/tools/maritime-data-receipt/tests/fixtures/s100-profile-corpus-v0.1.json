      "id": "source_native_profile_cannot_claim_transform_metadata",
      "base": "s104",
      "mutations": [
        {
          "op": "set",
          "path": "transform.input_crs",
          "value": "EPSG:4326"
        },
        {
          "op": "set",
          "path": "transform.output_crs",
          "value": "EPSG:4326"
        }
      ],
      "expected_code": "SOURCE_NATIVE_TRANSFORM_METADATA_FORBIDDEN"
