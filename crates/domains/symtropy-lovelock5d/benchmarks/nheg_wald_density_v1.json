  },
  "conventions": {
    "source_action": "R+alpha_NH*L_GB",
    "symtropy_action": "R+alpha_sym*L_GB/4",
    "coupling_map": "alpha_sym=4*alpha_NH",
    "beta": "2*a^2/alpha_sym",
    "domain": "alpha_sym>0, 0<beta<1, 0<epsilon<1",
    "epsilon": "cos(theta)"
  },
  "wald_jacobson_myers_density": {
    "formula": "s_W=sqrt(h)/(4G)*(1+2*alpha_NH*R[h])",
    "symtropy_multiplier": "1+alpha_sym*R[h]/2",
    "exact_intrinsic_R": "4*(beta^2*epsilon^8+10*beta*epsilon^4-3)/(alpha_sym*(1-beta*epsilon^4)^3)",
    "exact_multiplier": "(-5+17*beta*epsilon^4+5*beta^2*epsilon^8-beta^3*epsilon^12)/(1-beta*epsilon^4)^3",
    "exact_4G_density": "a*alpha_sym/(2*epsilon^3)*(-5+17*beta*epsilon^4+5*beta^2*epsilon^8-beta^3*epsilon^12)/(1-beta*epsilon^4)^2",
    "asymptotic_multiplier": "-5",
    "density_series": "-5*a*alpha_sym/(2*epsilon^3)+7*a*alpha_sym*beta*epsilon/2+O(epsilon^5)",
    "primitive_F": "(beta^2*epsilon^8+2*beta*epsilon^4+5)/(2*epsilon^2*(1-beta*epsilon^4))",
    "entropy_cutoff": "Delta_phi*Delta_psi*a*alpha_sym/(8*G)*(F(1)-F(epsilon))",
    "F_at_axis": "(beta^2+2*beta+5)/(2*(1-beta))",
    "leading_integrated_entropy": "-5*Delta_phi*Delta_psi*a*alpha_sym/(16*G*epsilon^2)",
    "statement": "local Wald/Jacobson-Myers density only; the standard integrated charge diverges and no finite physical entropy is claimed"
  },
  "regulator_sensitivity": {
    "defining_function": "delta=epsilon+s*epsilon^3+O(epsilon^5)",
    "inverse": "epsilon=delta-s*delta^3+3*s^2*delta^5+O(delta^7)",
    "area_expansion": "A/C_A=delta^-2+2*s-1-beta+(beta-3*s^2)*delta^2+O(delta^4)",
    "area_finite_part_shift": "2*s*C_A",
    "area_entropy_finite_part_shift": "s*Delta_phi*Delta_psi*a*alpha_sym/(8*G)",
    "wald_entropy_reexpanded": "F(1)-F(epsilon(delta))=F(1)-5/(2*delta^2)-5*s+(15*s^2/2-7*beta/2)*delta^2+O(delta^4)",
    "wald_entropy_finite_part_shift": "-5*s*Delta_phi*Delta_psi*a*alpha_sym/(8*G)",
    "comparison": "The Wald finite-part shift is -5 times the area-law entropy finite-part shift.",
    "gauge_caveat": "This is a smooth non-geodesic defining-function change. It demonstrates regulator sensitivity in the wider cutoff class, not dependence within a fixed geodesic-defining-function gauge and fixed conformal representative."
  },
