  "mutation_controls": [
    {
      "id": "TL-MUT-001",
      "description": "Replace the complete balance with boundary_inflows minus boundary_outflows, ignoring the initial/final stored-energy delta.",
      "must_be_detected_by": "TL-005-equal-flows-hide-storage-drift"
    },
    {
      "id": "TL-MUT-002",
      "description": "Encode regeneration as a negative heat/dissipation outflow.",
      "must_be_detected_by": "TL-102-negative-outflow-regeneration-mutation"
    },
    {
      "id": "TL-MUT-003",
      "description": "Count an internal transfer as external input or output.",
      "must_be_detected_by": "TL-004-internal-transfer-not-boundary-flow"
    },
    {
      "id": "TL-MUT-004",
      "description": "Accept duplicate event IDs or undocumented categories.",
      "must_be_detected_by": "TL-108-duplicate-boundary-event-id"
    },
    {
      "id": "TL-MUT-005",
      "description": "Ignore numeric validation or accept overflowed flow sums.",
      "must_be_detected_by": "TL-105-inflow-sum-overflow"
    }
  ]
