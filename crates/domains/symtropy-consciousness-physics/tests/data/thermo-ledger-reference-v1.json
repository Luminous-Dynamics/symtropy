{
  "schema": "symtropy-thermo-ledger-reference-v1",
  "profile": "BoundedEnergyBoundaryAccountingV1",
  "status": "research-only; validates a declared bookkeeping identity, not physical-model validity",
  "math": {
    "residual": "initial_stored_energy + sum(boundary_inflows) - sum(boundary_outflows) - final_stored_energy",
    "balanced": "abs(residual) <= relative_tolerance * max(1, initial_stored_energy + sum(boundary_inflows) + sum(boundary_outflows) + final_stored_energy)",
    "semantics": "Internal transfers between explicitly tracked stores are not boundary flows. All boundary flows are non-negative finite magnitudes with direction represented by the inflow/outflow collection. Regeneration is a boundary inflow, never negative dissipation."
  },
  "assumptions": [
    "The chosen model boundary and tracked stored-energy total are completely specified by the caller; the test cannot establish whether a real simulator has captured every physical reservoir.",
    "Each boundary event identifier is globally unique within one balance record.",
    "Every energy amount uses the same declared unit; this fixture currently uses a common abstract joule-equivalent scalar.",
    "The relative tolerance is finite and in (0, 1]."
  ],
  "allowed_categories": [
    "external_work",
    "regeneration",
    "electrical_import",
    "heat_rejected",
    "mechanical_export",
    "energy_export"
  ],
  "case_count": 24,
