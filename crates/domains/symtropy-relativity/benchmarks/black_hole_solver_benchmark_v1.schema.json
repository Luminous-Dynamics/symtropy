{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/bach-taylor-jets-2026-11-18/crates/domains/symtropy-relativity/benchmarks/black_hole_solver_benchmark_v1.schema.json",
  "title": "Black-hole solver and qualification benchmark v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "status",
    "physics",
    "solver",
    "environment",
    "numerics",
    "approximation",
    "qualification",
    "physical_validity",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "executed",
        "inconclusive",
        "rejected",
        "verified"
      ]
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theory_id",
        "action_digest",
        "equation_digest",
        "dimension",
        "symmetry",
        "chart",
        "signature",
        "coordinates",
        "units",
        "domain",
        "boundary_conditions",
        "couplings",
        "branch_id",
        "continuation_parameter"
      ],
      "properties": {
        "theory_id": {
          "type": "string",
          "minLength": 1
        },
        "action_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "equation_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "dimension": {
          "type": "integer",
          "minimum": 3
        },
        "symmetry": {
          "type": "string",
          "minLength": 1
        },
        "chart": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "enum": [
            "-+++",
            "+---",
            "other"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "domain": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "couplings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "branch_id": {
          "type": "string"
        },
        "continuation_parameter": {
          "type": "string"
        }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "candidate_generator",
        "refinement_method",
        "precision_bits",
        "basis",
        "truncation_order",
        "collocation_grid"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "candidate_generator": {
          "type": "string"
        },
        "refinement_method": {
          "type": "string"
        },
        "precision_bits": {
          "type": "integer",
          "minimum": 1
        },
        "basis": {
          "type": "string"
        },
        "truncation_order": {
          "type": "integer",
          "minimum": 0
        },
        "collocation_grid": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "toolchain",
        "cpu",
        "gpu",
        "memory_bytes",
        "wall_time_ms",
        "energy_joules"
      ],
      "properties": {
        "source_revision": {
          "type": "string"
        },
        "toolchain": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "wall_time_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "energy_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collocation_residual",
        "held_out_residual",
        "full_domain_residual_enclosure",
        "spectral_tail_enclosure",
        "boundary_residual_enclosures",
        "condition_estimate",
        "convergence_levels"
      ],
      "properties": {
        "collocation_residual": {
          "$ref": "#/$defs/metric"
        },
        "held_out_residual": {
          "$ref": "#/$defs/metric"
        },
        "full_domain_residual_enclosure": {
          "$ref": "#/$defs/enclosure"
        },
        "spectral_tail_enclosure": {
          "$ref": "#/$defs/enclosure"
        },
        "boundary_residual_enclosures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enclosure"
          }
        },
        "condition_estimate": {
          "$ref": "#/$defs/metric"
        },
        "convergence_levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "resolution",
              "residual"
            ],
            "properties": {
              "resolution": {
                "type": "string"
              },
              "residual": {
                "$ref": "#/$defs/metric"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "approximation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_solution_difference",
        "reference_source",
        "matched_conventions"
      ],
      "properties": {
        "reference_solution_difference": {
          "$ref": "#/$defs/metric"
        },
        "reference_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched_conventions": {
          "type": "boolean"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_backend",
        "interval_extension_digest",
        "operator_inverse_enclosure",
        "Y0",
        "Z0",
        "Z1",
        "Z2",
        "radii_polynomial",
        "theorem_status",
        "lean_theorem",
        "axiom_report_digest"
      ],
      "properties": {
        "interval_backend": {
          "type": "string"
        },
        "interval_extension_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "operator_inverse_enclosure": {
          "$ref": "#/$defs/enclosure"
        },
        "Y0": {
          "$ref": "#/$defs/enclosure"
        },
        "Z0": {
          "$ref": "#/$defs/enclosure"
        },
        "Z1": {
          "$ref": "#/$defs/enclosure"
        },
        "Z2": {
          "$ref": "#/$defs/enclosure"
        },
        "radii_polynomial": {
          "$ref": "#/$defs/enclosure"
        },
        "theorem_status": {
          "enum": [
            "not_attempted",
            "verified",
            "rejected",
            "inconclusive",
            "not_applicable"
          ]
        },
        "lean_theorem": {
          "type": [
            "string",
            "null"
          ]
        },
        "axiom_report_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "physical_validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chart_regular",
        "scalar_invariants_bounded",
        "observer_frame_tidal_bounded",
        "extra_fields_regular",
        "eft_expansion_ordered",
        "observationally_admissible",
        "observer_manifest_digest"
      ],
      "properties": {
        "chart_regular": {
          "$ref": "#/$defs/gate"
        },
        "scalar_invariants_bounded": {
          "$ref": "#/$defs/gate"
        },
        "observer_frame_tidal_bounded": {
          "$ref": "#/$defs/gate"
        },
        "extra_fields_regular": {
          "$ref": "#/$defs/gate"
        },
        "eft_expansion_ordered": {
          "$ref": "#/$defs/gate"
        },
        "observationally_admissible": {
          "$ref": "#/$defs/gate"
        },
        "observer_manifest_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_manifest_digest",
        "source_tree_digest",
        "replay_command",
        "stdout_digest",
        "exit_code",
        "artifact_digests"
      ],
      "properties": {
        "input_manifest_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_tree_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "replay_command": {
          "type": "string"
        },
        "stdout_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "artifact_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "norm",
        "status"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "norm": {
          "type": "string"
        },
        "status": {
          "enum": [
            "measured",
            "enclosed",
            "not_measured",
            "not_applicable"
          ]
        }
      }
    },
    "enclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "unit",
        "norm",
        "status",
        "proof_artifact_digest"
      ],
      "properties": {
        "lower": {
          "type": [
            "string",
            "null"
          ]
        },
        "upper": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "norm": {
          "type": "string"
        },
        "status": {
          "enum": [
            "enclosed",
            "inconclusive",
            "not_attempted",
            "not_applicable"
          ]
        },
        "proof_artifact_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "inconclusive",
            "not_attempted",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
