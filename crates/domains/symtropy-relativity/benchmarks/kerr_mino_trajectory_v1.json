    "source_revision": "8148014c04fcf4df33937eff0268b92f38346b5e",
    "api": "KerrSeparatedNullGeodesic::integrate_adaptive",
    "integrator": "RK4 step-doubling on the smooth second-order Mino equations",
    "local_error_estimate": "(two_half_steps - one_full_step)/15",
    "invariants": "v_r^2-R(r) and v_theta^2-Theta(theta); monitored separately from local truncation error",
    "chart": "Boyer-Lindquist exterior; fail-closed at horizon and polar-axis chart boundaries",
    "limitations": [
      "No canonical Hamiltonian trajectory integrator is implemented.",
      "No finite-radius observer tetrad is implemented.",
      "No Jacobi-field / variational ray-bundle integration is implemented.",
      "No caustic detection or image-branch topology tracking is implemented.",
      "No rigorous global error bound is claimed from the adaptive local estimator.",
      "Boyer-Lindquist trajectories stop at the horizon; the ingoing chart trajectory may cross the future outer horizon for inward rays.",
      "No event-detection stopping surface is implemented yet; callers choose the terminal Mino parameter.",
      "The ingoing chart is not claimed to be regular at the ring singularity or on the polar axis."
    ],
    "chart_modes": [
      {
        "id": "boyer_lindquist",
        "api": "integrate_adaptive",
        "domain": "r>r_plus, 0<theta<pi",
        "time_coordinate": "ct/M",
        "azimuth_coordinate": "phi"
      },
      {
        "id": "ingoing_kerr",
        "api": "integrate_adaptive_ingoing",
        "domain": "r>0, 0<theta<pi, future-ingoing branch",
        "time_coordinate": "v/M",
        "azimuth_coordinate": "phi_tilde"
      }
    ],
    "capture_qualification": {
      "api": "KerrMinoTrajectory::capture_status",
      "statuses": [
        "CapturedByHorizon",
        "NoCrossingWithinIntegratedInterval",
        "NotQualifiableInBoyerLindquist",
        "ConstraintDriftExceeded",
        "IncompleteTrajectory"
      ],
      "rule": "CapturedByHorizon requires an ingoing-chart trajectory with an observed outside-to-inside r+ transition and radial/polar first-integral residual maxima below the caller's ceiling.",
      "non_claim": "No crossing within the finite integrated interval is not evidence of escape."
    }
  },
  "conventions": {
    "dimensionless_units": "M=G*m/c^2=1",
    "coordinates": [
      "ct/M",
      "r/M",
      "theta_rad",
      "phi_rad"
    ],
    "constants": [
      "E=-p_t",
      "Lz/M",
      "Q/M^2"
    ],
    "radial_potential": "R(r) = [E(r^2+a^2)-a Lz]^2 - Delta*[Q+(Lz-aE)^2]",
    "polar_potential": "Theta(theta)=Q+a^2*E^2*cos(theta)^2-Lz^2*cot(theta)^2",
    "mino_parameter": "gamma, dimensionless",
    "future_directed_energy": "E > 0",
    "null_constraints": [
      "(dr/dgamma)^2=R(r)",
      "(dtheta/dgamma)^2=Theta(theta)"
    ],
    "second_order_equations": [
      "d2(r/M)/dgamma2 = 0.5*dR/d(r/M)",
      "d2(theta)/dgamma2 = 0.5*dTheta/dtheta"
    ]
  },
