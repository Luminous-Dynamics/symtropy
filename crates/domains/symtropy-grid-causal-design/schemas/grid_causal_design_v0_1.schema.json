{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/crates/domains/symtropy-grid-causal-design/schemas/grid_causal_design_v0_1.schema.json",
  "title": "Grid Causal Cluster Randomization Design v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "experiment_id",
    "design_class",
    "primary_estimand",
    "service_product_id",
    "primary_outcome_id",
    "primary_outcome_unit",
    "measurement_boundary_id",
    "protocol_reference",
    "pre_registration_digest",
    "frozen_covariate_digest",
    "baseline_partition_digest",
    "interference_mapping_digest",
    "minimum_clusters_per_arm",
    "baseline_window",
    "pretrend_windows",
    "placebo_windows",
    "dispatch_window",
    "recovery_window",
    "negative_control_outcome_ids",
    "plan_frozen_at_unix_ms",
    "randomization",
    "strata",
    "clusters",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "GRID-CAUSAL-DESIGN-AUDIT-001"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "design_class": {
      "const": "cluster_randomized_parallel"
    },
    "primary_estimand": {
      "const": "intention_to_treat"
    },
    "service_product_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "primary_outcome_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "measurement_boundary_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protocol_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "pre_registration_digest": {
      "$ref": "#/$defs/digest"
    },
    "frozen_covariate_digest": {
      "$ref": "#/$defs/digest"
    },
    "baseline_partition_digest": {
      "$ref": "#/$defs/digest"
    },
    "interference_mapping_digest": {
      "$ref": "#/$defs/digest"
    },
    "minimum_clusters_per_arm": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100000
    },
    "baseline_window": {
      "$ref": "#/$defs/window"
    },
    "pretrend_windows": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/window"
      }
    },
    "placebo_windows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/window"
      }
    },
    "dispatch_window": {
      "$ref": "#/$defs/window"
    },
    "recovery_window": {
      "$ref": "#/$defs/window"
    },
    "negative_control_outcome_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "plan_frozen_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "randomization": {
      "$ref": "#/$defs/randomization"
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "clusters": {
      "type": "array",
      "minItems": 4,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/cluster"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "primary_outcome_unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_unix_ms",
        "end_unix_ms"
      ],
      "properties": {
        "start_unix_ms": {
          "type": "integer",
          "minimum": 1
        },
        "end_unix_ms": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "seed_commitment_digest",
        "seed_reveal",
        "seed_commitment_recorded_at_unix_ms",
        "public_randomness_source_id",
        "public_randomness_value",
        "public_randomness_digest",
        "randomness_published_at_unix_ms",
        "assignment_issued_at_unix_ms"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256_rank_v1"
        },
        "seed_commitment_digest": {
          "$ref": "#/$defs/digest"
        },
        "seed_reveal": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "seed_commitment_recorded_at_unix_ms": {
          "type": "integer",
          "minimum": 1
        },
        "public_randomness_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "public_randomness_value": {
          "type": "string",
          "minLength": 8,
          "maxLength": 512
        },
        "public_randomness_digest": {
          "$ref": "#/$defs/digest"
        },
        "randomness_published_at_unix_ms": {
          "type": "integer",
          "minimum": 1
        },
        "assignment_issued_at_unix_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "treated_cluster_count",
        "control_cluster_count"
      ],
      "properties": {
        "stratum_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "treated_cluster_count": {
          "type": "integer",
          "minimum": 1
        },
        "control_cluster_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "stratum_id",
        "interference_domain_id",
        "assigned_arm",
        "site_ids",
        "asset_ids"
      ],
      "properties": {
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stratum_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "interference_domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "assigned_arm": {
          "enum": [
            "treatment",
            "control"
          ]
        },
        "site_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}
