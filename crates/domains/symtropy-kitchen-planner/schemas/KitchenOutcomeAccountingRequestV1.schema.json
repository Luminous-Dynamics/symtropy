{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/kitchen/KitchenOutcomeAccountingRequestV1.schema.json",
  "title": "KitchenOutcomeAccountingRequestV1",
  "description": "Frozen, read-only evidence input for exact mass, water and electrical energy accounting per accepted edible serving. Missing terms never become zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "recipe_id",
    "boundary_ref",
    "accepted_servings",
    "expected_mass_term_ids",
    "mass_terms",
    "required_water_stages",
    "water_terms",
    "required_electricity_stages",
    "electricity_terms",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "boundary_ref": {
      "type": "string",
      "minLength": 1
    },
    "accepted_servings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expected_mass_term_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mass_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/massTerm"
      }
    },
    "required_water_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "water_terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waterTerm"
      }
    },
    "required_electricity_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "electricity_terms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/electricityTerm"
      }
    },
    "claim_ceiling": {
      "const": "Deterministic arithmetic and evidence completeness for submitted kitchen flow records only; not proof of measurement truth, food safety, sanitation, sensory quality, energy savings, or product superiority."
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "source_ref",
        "method_ref",
        "calibration_ref"
      ],
      "properties": {
        "evidence_class": {
          "enum": [
            "measured",
            "allocated",
            "attested",
            "declared",
            "modelled",
            "simulated"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "method_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "calibration_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "massQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "decimal_places",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decimal_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "unit": {
          "enum": [
            "milligram",
            "gram",
            "kilogram"
          ]
        }
      }
    },
    "waterQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "decimal_places",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decimal_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "unit": {
          "enum": [
            "millilitre",
            "litre"
          ]
        }
      }
    },
    "energyQuantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "decimal_places",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decimal_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "unit": {
          "enum": [
            "watt_hour",
            "kilowatt_hour"
          ]
        }
      }
    },
    "stage": {
      "enum": [
        "preparation",
        "cooking",
        "holding",
        "cleaning",
        "packaging_cleaning"
      ]
    },
    "massTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term_id",
        "direction",
        "category",
        "observation"
      ],
      "properties": {
        "term_id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "category": {
          "enum": [
            "ingredient",
            "process_water",
            "process_aid",
            "packaging",
            "other_input",
            "accepted_edible",
            "trim",
            "rejected",
            "food_residue",
            "drainage",
            "evaporated",
            "other_output"
          ]
        },
        "observation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "quantity",
                "evidence"
              ],
              "properties": {
                "state": {
                  "const": "observed"
                },
                "quantity": {
                  "$ref": "#/$defs/massQuantity"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "justification"
              ],
              "properties": {
                "state": {
                  "const": "not_applicable"
                },
                "justification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "waterTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "observation"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "observation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "quantity",
                "evidence"
              ],
              "properties": {
                "state": {
                  "const": "observed"
                },
                "quantity": {
                  "$ref": "#/$defs/waterQuantity"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "justification"
              ],
              "properties": {
                "state": {
                  "const": "not_applicable"
                },
                "justification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "electricityTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "observation"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "observation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "quantity",
                "evidence"
              ],
              "properties": {
                "state": {
                  "const": "observed"
                },
                "quantity": {
                  "$ref": "#/$defs/energyQuantity"
                },
                "evidence": {
                  "$ref": "#/$defs/evidence"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "justification"
              ],
              "properties": {
                "state": {
                  "const": "not_applicable"
                },
                "justification": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "reason"
              ],
              "properties": {
                "state": {
                  "const": "unknown"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    }
  }
}
