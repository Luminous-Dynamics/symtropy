{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/kitchen/RecipeTaskGraphV1.schema.json",
  "title": "RecipeTaskGraphV1",
  "description": "Rights-aware, typed recipe action graph mapped into KitchenPlanV1. It is advisory only and does not validate food safety, allergens or culinary quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "revision",
    "title",
    "source",
    "evidence_class",
    "review_state",
    "ingredients",
    "tasks",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "rights_status",
        "permitted_uses",
        "permission_evidence_ref",
        "content_sha256",
        "attribution_ref"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "rights_status": {
          "enum": [
            "public_domain",
            "licensed",
            "user_supplied",
            "permission_granted",
            "unknown",
            "restricted"
          ]
        },
        "permitted_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local_processing",
              "redistribution",
              "model_training"
            ]
          }
        },
        "permission_evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "attribution_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "evidence_class": {
      "enum": [
        "declared",
        "modelled",
        "simulated"
      ]
    },
    "review_state": {
      "enum": [
        "unreviewed",
        "reviewed",
        "rejected"
      ]
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingredient_id",
          "display_name",
          "product_lot_ref"
        ],
        "properties": {
          "ingredient_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "product_lot_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schedule",
          "action_kind",
          "action_label",
          "ingredient_inputs",
          "output_refs",
          "instruction_ref"
        ],
        "properties": {
          "schedule": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "duration_ms",
              "resource_ids",
              "dependencies",
              "earliest_start_ms",
              "latest_finish_ms"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              },
              "resource_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "predecessor_task_id",
                    "min_lag_ms",
                    "max_lag_ms"
                  ],
                  "properties": {
                    "predecessor_task_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "min_lag_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_lag_ms": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                }
              },
              "earliest_start_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "latest_finish_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "action_kind": {
            "enum": [
              "wash",
              "peel",
              "trim",
              "chop",
              "slice",
              "dice",
              "grate",
              "shred",
              "mix",
              "knead",
              "blend",
              "emulsify",
              "saute",
              "boil",
              "simmer",
              "steam",
              "bake",
              "roast",
              "pressure_cook",
              "cool",
              "rest",
              "serve",
              "pour",
              "sprinkle",
              "stir",
              "pick",
              "place",
              "move",
              "other"
            ]
          },
          "action_label": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "ingredient_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ingredient_id",
                "quantity"
              ],
              "properties": {
                "ingredient_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "decimal_places",
                    "unit"
                  ],
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "decimal_places": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 6
                    },
                    "unit": {
                      "enum": [
                        "milligram",
                        "gram",
                        "kilogram",
                        "millilitre",
                        "litre",
                        "piece",
                        "count",
                        "teaspoon",
                        "tablespoon",
                        "cup"
                      ]
                    }
                  }
                }
              }
            }
          },
          "output_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "instruction_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "ontology_binding": {
            "$ref": "https://luminousdynamics.io/schemas/kitchen/ActionOntologyBindingV1.schema.json",
            "description": "Optional action-core/group enrichment. Absent means no ontology enrichment has been performed."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action_kind": {
                  "const": "other"
                }
              },
              "required": [
                "action_kind"
              ]
            },
            "then": {
              "required": [
                "action_label"
              ],
              "properties": {
                "action_label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "claim_ceiling": {
      "const": "Recipe task graph only; does not validate food safety, allergens, ingredient condition, or culinary quality."
    }
  }
}
