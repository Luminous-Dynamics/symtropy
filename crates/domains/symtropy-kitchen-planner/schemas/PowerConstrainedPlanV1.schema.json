{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/kitchen/PowerConstrainedPlanV1.schema.json",
  "title": "PowerConstrainedPlanV1",
  "description": "The runtime verifier additionally checks exact task/profile coverage, duplicate/unknown IDs, ordered contiguous power segments, overflow, source-plan validity, schedule integrity, aggregate peak watts and contiguous surge duration. JSON Schema alone cannot establish these cross-record and temporal invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan",
    "envelope",
    "task_profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "plan_id",
        "tasks"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "duration_ms",
              "resource_ids",
              "dependencies",
              "earliest_start_ms",
              "latest_finish_ms"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 1
              },
              "resource_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "predecessor_task_id",
                    "min_lag_ms",
                    "max_lag_ms"
                  ],
                  "properties": {
                    "predecessor_task_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "min_lag_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_lag_ms": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    }
                  }
                }
              },
              "earliest_start_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "latest_finish_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuous_real_power_limit_w",
        "surge_real_power_limit_w",
        "max_surge_duration_ms",
        "background_real_power_w"
      ],
      "properties": {
        "continuous_real_power_limit_w": {
          "type": "integer",
          "minimum": 1
        },
        "surge_real_power_limit_w": {
          "type": "integer",
          "minimum": 1
        },
        "max_surge_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "background_real_power_w": {
          "type": "integer",
          "minimum": 0,
          "description": "Continuous household baseline load. Runtime validation requires this to be no greater than continuous_real_power_limit_w."
        }
      }
    },
    "task_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "source_ref",
          "evidence_class",
          "segments"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "measured",
              "declared",
              "modelled",
              "simulated"
            ]
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_offset_ms",
                "end_offset_ms",
                "real_power_w"
              ],
              "properties": {
                "start_offset_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_offset_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "real_power_w": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
