{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/schemas/peace-infrastructure-resilience-v0.1.schema.json",
  "title": "Peace Infrastructure and Resilience Benchmark synthetic corpus v0.1",
  "description": "Structural contract for synthetic conformance fixtures only. It does not validate field evidence, consent legitimacy, causal effects, or deployment safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "corpus_kind",
    "field_evidence",
    "quantities_are_policy_thresholds",
    "claim_ceiling",
    "scenarios"
  ],
  "properties": {
    "corpus_version": {
      "const": "0.1"
    },
    "corpus_kind": {
      "const": "synthetic_reference_only"
    },
    "field_evidence": {
      "const": false
    },
    "quantities_are_policy_thresholds": {
      "const": false
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "track",
          "domain",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pirb-[a-z0-9-]+$"
          },
          "track": {
            "enum": [
              "PIRB-0",
              "PIRB-1",
              "PIRB-2",
              "PIRB-3",
              "PIRB-4",
              "PIRB-5"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "minProperties": 1
          }
        }
      }
    }
  }
}
