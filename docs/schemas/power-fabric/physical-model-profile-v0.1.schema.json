{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/schemas/power-fabric/physical-model-profile-v0.1.schema.json",
  "title": "Power Fabric Physical Model Profile v0.1",
  "description": "Strict, output-scoped applicability contract binding a physical model to an exact asset configuration and operating regime. Unknown is explicit; this schema does not certify physical truth.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "record_status",
    "owner",
    "model",
    "target",
    "boundary",
    "formulation",
    "operating_envelope",
    "numerical_envelope",
    "outputs",
    "assumptions",
    "exclusions",
    "out_of_domain_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "$ref": "#/$defs/identifier"
    },
    "record_status": {
      "enum": [
        "draft",
        "admitted",
        "retired"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization",
        "system"
      ],
      "properties": {
        "organization": {
          "$ref": "#/$defs/text"
        },
        "system": {
          "$ref": "#/$defs/text"
        },
        "contact_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "family",
        "revision",
        "solver",
        "source_artifact",
        "build_artifact",
        "dependency_artifact",
        "license_spdx"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/identifier"
        },
        "family": {
          "enum": [
            "dc_power_flow",
            "dc_opf",
            "ac_power_flow",
            "ac_opf",
            "rms_dynamic",
            "emt",
            "impedance_scan",
            "circuit_pdn",
            "quasi_static_em",
            "full_wave_em",
            "thermal_rc",
            "cfd",
            "electrochemical",
            "structural",
            "other"
          ]
        },
        "revision": {
          "$ref": "#/$defs/identityRef"
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "adapter_version"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/text"
            },
            "version": {
              "$ref": "#/$defs/identityRef"
            },
            "adapter_version": {
              "$ref": "#/$defs/identityRef"
            }
          }
        },
        "source_artifact": {
          "$ref": "#/$defs/artifactRef"
        },
        "build_artifact": {
          "$ref": "#/$defs/artifactRef"
        },
        "dependency_artifact": {
          "$ref": "#/$defs/artifactRef"
        },
        "license_spdx": {
          "$ref": "#/$defs/text"
        },
        "provenance_uri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "module_id",
        "hardware_revision",
        "firmware_revision",
        "parameter_set",
        "as_built_configuration",
        "service_graph_revision"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/identityRef"
        },
        "module_id": {
          "$ref": "#/$defs/identityRef"
        },
        "hardware_revision": {
          "$ref": "#/$defs/identityRef"
        },
        "firmware_revision": {
          "$ref": "#/$defs/identityRef"
        },
        "parameter_set": {
          "$ref": "#/$defs/artifactRef"
        },
        "as_built_configuration": {
          "$ref": "#/$defs/artifactRef"
        },
        "service_graph_revision": {
          "$ref": "#/$defs/identityRef"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "description",
        "topology_revision",
        "reference_frame",
        "ports"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "topology_revision": {
          "$ref": "#/$defs/identityRef"
        },
        "reference_frame": {
          "$ref": "#/$defs/text"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port_id",
              "direction",
              "quantity",
              "unit",
              "sign_convention"
            ],
            "properties": {
              "port_id": {
                "$ref": "#/$defs/identifier"
              },
              "direction": {
                "enum": [
                  "input",
                  "output",
                  "bidirectional"
                ]
              },
              "quantity": {
                "$ref": "#/$defs/text"
              },
              "unit": {
                "$ref": "#/$defs/text"
              },
              "sign_convention": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "formulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formulation_id",
        "revision",
        "description",
        "unit_system"
      ],
      "properties": {
        "formulation_id": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "$ref": "#/$defs/identityRef"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "unit_system": {
          "$ref": "#/$defs/text"
        },
        "standard_profile": {
          "$ref": "#/$defs/identityRef"
        }
      }
    },
    "operating_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes"
      ],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "unit",
              "coverage"
            ],
            "properties": {
              "quantity": {
                "$ref": "#/$defs/identifier"
              },
              "unit": {
                "$ref": "#/$defs/text"
              },
              "coverage": {
                "$ref": "#/$defs/rangeRef"
              }
            }
          }
        }
      }
    },
    "numerical_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_domain",
        "time_step",
        "sample_interval",
        "coupling_interval",
        "precision",
        "tolerances",
        "convergence_criteria"
      ],
      "properties": {
        "time_domain": {
          "enum": [
            "steady_state",
            "continuous_time",
            "discrete_time",
            "frequency_domain",
            "multi_rate",
            "not_applicable",
            "unknown"
          ]
        },
        "time_step": {
          "$ref": "#/$defs/measurementRef"
        },
        "sample_interval": {
          "$ref": "#/$defs/measurementRef"
        },
        "coupling_interval": {
          "$ref": "#/$defs/measurementRef"
        },
        "precision": {
          "$ref": "#/$defs/identityRef"
        },
        "tolerances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "unit",
              "absolute_tolerance"
            ],
            "properties": {
              "quantity": {
                "$ref": "#/$defs/identifier"
              },
              "unit": {
                "$ref": "#/$defs/text"
              },
              "absolute_tolerance": {
                "type": "number",
                "minimum": 0
              },
              "relative_tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "convergence_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output_id",
          "quantity",
          "unit",
          "sampling_semantics",
          "validity_axes",
          "uncertainty",
          "claim_ceiling"
        ],
        "properties": {
          "output_id": {
            "$ref": "#/$defs/identifier"
          },
          "quantity": {
            "$ref": "#/$defs/text"
          },
          "unit": {
            "$ref": "#/$defs/text"
          },
          "sampling_semantics": {
            "$ref": "#/$defs/text"
          },
          "validity_axes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "uncertainty": {
            "$ref": "#/$defs/uncertaintyRef"
          },
          "claim_ceiling": {
            "enum": [
              "structural_only",
              "analytical_only",
              "reference_differential",
              "laboratory",
              "hardware_in_loop",
              "field_observed"
            ]
          },
          "required_evidence_classes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ManufacturerDeclared",
                "Modelled",
                "AnalyticallyVerified",
                "ReferenceDifferential",
                "LaboratoryMeasured",
                "HardwareInLoop",
                "FieldObserved",
                "IndependentlyReviewed"
              ]
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "out_of_domain_policy": {
      "enum": [
        "abstain",
        "reject",
        "replan"
      ]
    },
    "evidence_classes_present": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ManufacturerDeclared",
          "Modelled",
          "AnalyticallyVerified",
          "ReferenceDifferential",
          "LaboratoryMeasured",
          "HardwareInLoop",
          "FieldObserved",
          "IndependentlyReviewed"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "sha256",
            "uri"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "uri": {
              "type": "string",
              "format": "uri"
            },
            "media_type": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "not_applicable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "identityRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "not_applicable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "rangeRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "lower",
            "upper"
          ],
          "properties": {
            "state": {
              "const": "bounded"
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "properties": {
                "lower": {},
                "upper": {}
              },
              "if": {
                "properties": {
                  "state": {
                    "const": "bounded"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "then": {
                "properties": {
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "not_applicable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "measurementRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value",
            "unit"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "not_applicable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "uncertaintyRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "method",
            "value",
            "unit"
          ],
          "properties": {
            "state": {
              "const": "quantified"
            },
            "method": {
              "$ref": "#/$defs/text"
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "$ref": "#/$defs/text"
            },
            "coverage_probability": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason"
          ],
          "properties": {
            "state": {
              "const": "not_applicable"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    }
  }
}
