{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/schemas/peacebuilding-outcome-governance-v0.2.schema.json",
  "title": "PIRB v0.2 Outcome Governance Metric Definition",
  "description": "Structural contract for versioned, locally governed outcome indicators. It does not prove authority legitimacy, consent, data truth, causal impact, or deployment safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_kind",
    "metric_id",
    "version",
    "status",
    "name",
    "purpose",
    "unit",
    "direction",
    "population_scope",
    "geographic_scope",
    "measurement_window",
    "denominator",
    "missingness_policy",
    "aggregation_policy",
    "disaggregation_policy",
    "authority",
    "approval",
    "challenge_policy",
    "version_control",
    "claim_ceiling",
    "governance_events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "contract_kind": {
      "const": "pirb_outcome_metric_definition"
    },
    "metric_id": {
      "type": "string",
      "pattern": "^pirb-metric-[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "approved",
        "active",
        "review_required",
        "blocked",
        "suspended",
        "superseded",
        "retired"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "lower_is_better",
        "higher_is_better",
        "context_dependent",
        "descriptive_only"
      ]
    },
    "population_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "inclusion_rule",
        "exclusion_rule"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inclusion_rule": {
          "type": "string",
          "minLength": 1
        },
        "exclusion_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "geographic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_description",
        "boundary_reference",
        "coverage_complete",
        "unassessed_scope_handling"
      ],
      "properties": {
        "scope_description": {
          "type": "string",
          "minLength": 1
        },
        "boundary_reference": {
          "type": "string",
          "minLength": 1
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "unassessed_scope_handling": {
          "enum": [
            "review_required",
            "blocked"
          ]
        }
      }
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "time_basis"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "time_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "unit",
        "source_reference"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "missingness_policy": {
      "enum": [
        "unknown_not_zero",
        "reported_missingness",
        "bounded_imputation_with_review"
      ]
    },
    "aggregation_policy": {
      "enum": [
        "disaggregate_then_aggregate",
        "distribution_vector",
        "aggregate_only_with_justification"
      ]
    },
    "disaggregation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_dimensions",
        "minimum_cell_size",
        "suppression_rule",
        "policy_reference"
      ],
      "properties": {
        "approved_dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "minimum_cell_size": {
          "type": "integer",
          "minimum": 1
        },
        "suppression_rule": {
          "type": "string",
          "minLength": 1
        },
        "policy_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_reference",
        "mandate_evidence_references",
        "decision_scope",
        "review_authority_reference"
      ],
      "properties": {
        "authority_reference": {
          "type": "string",
          "minLength": 1
        },
        "mandate_evidence_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "decision_scope": {
          "type": "string",
          "minLength": 1
        },
        "review_authority_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "approving_authority_reference",
        "approved_at",
        "consultation_reference",
        "dissent_record_reference",
        "safe_dissent_recording_available"
      ],
      "properties": {
        "state": {
          "enum": [
            "proposed",
            "approved",
            "contested",
            "revoked"
          ]
        },
        "approving_authority_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "consultation_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "dissent_record_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "safe_dissent_recording_available": {
          "type": "boolean"
        }
      }
    },
    "challenge_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_route_reference",
        "appeal_authority_reference",
        "response_window_hours",
        "withdrawal_supported",
        "nonparticipation_is_not_assent"
      ],
      "properties": {
        "challenge_route_reference": {
          "type": "string",
          "minLength": 1
        },
        "appeal_authority_reference": {
          "type": "string",
          "minLength": 1
        },
        "response_window_hours": {
          "type": "integer",
          "minimum": 0
        },
        "withdrawal_supported": {
          "type": "boolean"
        },
        "nonparticipation_is_not_assent": {
          "const": true
        }
      }
    },
    "version_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_version",
        "effective_from",
        "effective_until",
        "outcomes_observed",
        "preregistration_reference",
        "amendment_reason",
        "preserve_prior_versions",
        "post_observation_amendment"
      ],
      "properties": {
        "predecessor_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "effective_from": {
          "type": "string",
          "format": "date-time"
        },
        "effective_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "outcomes_observed": {
          "type": "boolean"
        },
        "preregistration_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "amendment_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "preserve_prior_versions": {
          "const": true
        },
        "post_observation_amendment": {
          "type": "boolean"
        }
      }
    },
    "claim_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "permitted_claims",
        "prohibited_claims"
      ],
      "properties": {
        "evidence_class": {
          "enum": [
            "synthetic",
            "historical_replay",
            "observational",
            "causal_evaluation"
          ]
        },
        "permitted_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "prohibited_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "governance_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "event_type",
          "metric_version",
          "event_at",
          "actor_authority_reference",
          "evidence_references",
          "decision"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,127}$"
          },
          "event_type": {
            "enum": [
              "proposed",
              "consultation_opened",
              "approved",
              "activated",
              "challenged",
              "review_required",
              "blocked",
              "suspended",
              "amended",
              "superseded",
              "retired"
            ]
          },
          "metric_version": {
            "type": "integer",
            "minimum": 1
          },
          "event_at": {
            "type": "string",
            "format": "date-time"
          },
          "actor_authority_reference": {
            "type": "string",
            "minLength": 1
          },
          "evidence_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "decision": {
            "enum": [
              "accepted",
              "refused",
              "review_required",
              "blocked",
              "withdrawn",
              "recorded_only"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "state": {
                "const": "approved"
              },
              "approving_authority_reference": {
                "type": "string",
                "minLength": 1
              },
              "approved_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "state",
              "approving_authority_reference",
              "approved_at"
            ]
          },
          "geographic_scope": {
            "properties": {
              "coverage_complete": {
                "const": true
              }
            },
            "required": [
              "coverage_complete"
            ]
          },
          "version_control": {
            "properties": {
              "preregistration_reference": {
                "type": "string",
                "minLength": 1
              },
              "preserve_prior_versions": {
                "const": true
              }
            },
            "required": [
              "preregistration_reference",
              "preserve_prior_versions"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version_control": {
            "properties": {
              "post_observation_amendment": {
                "const": true
              }
            },
            "required": [
              "post_observation_amendment"
            ]
          }
        },
        "required": [
          "version_control"
        ]
      },
      "then": {
        "properties": {
          "version_control": {
            "properties": {
              "outcomes_observed": {
                "const": true
              },
              "predecessor_version": {
                "type": "integer",
                "minimum": 1
              },
              "amendment_reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "outcomes_observed",
              "predecessor_version",
              "amendment_reason"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "minimum": 2
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "properties": {
          "version_control": {
            "properties": {
              "predecessor_version": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "predecessor_version"
            ]
          }
        }
      }
    }
  ]
}
