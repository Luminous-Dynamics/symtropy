{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symtropy://schemas/secret_content/v0.1",
  "title": "Symtropy Secret Content Record",
  "type": "object",
  "required": ["secret_id", "class", "discovery_predicates", "reward_policy", "worldline_scope", "privacy_scope"],
  "properties": {
    "secret_id": {"type": "string", "minLength": 1},
    "class": {"enum": ["private_joke", "personal_memory", "maintenance_fossil", "historical_contradiction", "machine_trace", "ordinary_absurdity", "worldline_echo", "nonhuman_interpretation", "hidden_route", "mechanical_curiosity", "rare_social_scene"]},
    "discovery_predicates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reward_policy": {"enum": ["understanding", "conversation", "chronicle_hypothesis", "cosmetic", "place_change", "private_iris_exchange", "optional_activity", "none"]},
    "worldline_scope": {"type": "string"},
    "privacy_scope": {"enum": ["public", "party", "relationship_scoped", "private", "institutional"]},
    "critical_information": {"type": "boolean", "const": false}
  },
  "additionalProperties": false
}
