{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "symtropy://schemas/vice_profession_benchmark_v0_1",
  "title": "Vice Profession Benchmark Scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "district",
    "days",
    "profession_anchors",
    "pressures",
    "hard_failures"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "district": {
      "type": "object",
      "required": [
        "legal_name",
        "sites"
      ],
      "properties": {
        "legal_name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sites": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "day",
          "events"
        ],
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "profession_anchors": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "profession_id",
          "name"
        ],
        "properties": {
          "profession_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "pressures": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "hard_failures": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    }
  }
}
