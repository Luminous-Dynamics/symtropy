{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:textile-empirical-evaluation:v0.1",
  "title": "Textile empirical evaluation record",
  "description": "Proposed field-study contract. JSON Schema validates shape; arithmetic ledgers, evidence authenticity, paired assignment, and causal inference require independent checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_id",
    "version",
    "trial_id",
    "status",
    "frozen_at",
    "design",
    "baseline_policy_id",
    "comparison_policy_id",
    "primary_endpoint",
    "target_effect",
    "guardrails",
    "profile_strata",
    "observation_window_days",
    "synthetic_only",
    "interpretation_boundary",
    "records"
  ],
  "properties": {
    "protocol_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$"},
    "trial_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "preregistered", "in_progress", "completed"]},
    "frozen_at": {"type": "string", "format": "date-time"},
    "design": {"enum": ["randomized_blocked", "cluster_crossover", "matched_observational"]},
    "baseline_policy_id": {"type": "string", "minLength": 1},
    "comparison_policy_id": {"type": "string", "minLength": 1},
    "primary_endpoint": {"const": "unsold_new_per_fulfilled_service_unit"},
    "target_effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "relative_reduction_bps"],
      "properties": {
        "direction": {"const": "reduce"},
        "relative_reduction_bps": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_on_time_regression_bps", "max_quality_acceptance_regression_bps", "max_stockout_increase_units"],
      "properties": {
        "max_on_time_regression_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_quality_acceptance_regression_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_stockout_increase_units": {"type": "integer", "minimum": 0}
      }
    },
    "profile_strata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
    },
    "observation_window_days": {"type": "integer", "minimum": 1},
    "synthetic_only": {"type": "boolean"},
    "interpretation_boundary": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/cohort_record"}
    }
  },
  "$defs": {
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "evidence_refs"],
          "properties": {
            "status": {"const": "observed"},
            "value": {"type": "number", "minimum": 0},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "missing"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"},
          "properties": {
            "status": {"const": "not_applicable"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "cohort_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "pair_id",
        "cluster_id",
        "profile_id",
        "functional_unit_id",
        "assigned_policy_id",
        "actual_policy_id",
        "confirmed_order_units",
        "frozen_forecast_units",
        "realized_uncancelled_demand_units",
        "planned_new_units",
        "completed_new_units",
        "accepted_new_units",
        "rejected_new_units",
        "fulfilled_from_new_units",
        "fulfilled_from_existing_units",
        "unsold_new_units_end_of_window",
        "other_accepted_new_fates",
        "eligible_existing_inventory_units",
        "existing_inventory_issued_units",
        "existing_inventory_remaining_units",
        "other_existing_inventory_fates",
        "on_time_fulfilled_units",
        "late_fulfilled_units",
        "stockout_units",
        "window_days",
        "resource_measurements",
        "evidence"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "pair_id": {"type": "string", "minLength": 1},
        "cluster_id": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "functional_unit_id": {"type": "string", "minLength": 1},
        "assigned_policy_id": {"type": "string", "minLength": 1},
        "actual_policy_id": {"type": "string", "minLength": 1},
        "confirmed_order_units": {"$ref": "#/$defs/nonnegative_integer"},
        "frozen_forecast_units": {"$ref": "#/$defs/nonnegative_integer"},
        "realized_uncancelled_demand_units": {"$ref": "#/$defs/nonnegative_integer"},
        "planned_new_units": {"$ref": "#/$defs/nonnegative_integer"},
        "completed_new_units": {"$ref": "#/$defs/nonnegative_integer"},
        "accepted_new_units": {"$ref": "#/$defs/nonnegative_integer"},
        "rejected_new_units": {"$ref": "#/$defs/nonnegative_integer"},
        "fulfilled_from_new_units": {"$ref": "#/$defs/nonnegative_integer"},
        "fulfilled_from_existing_units": {"$ref": "#/$defs/nonnegative_integer"},
        "unsold_new_units_end_of_window": {"$ref": "#/$defs/nonnegative_integer"},
        "other_accepted_new_fates": {"$ref": "#/$defs/nonnegative_integer"},
        "eligible_existing_inventory_units": {"$ref": "#/$defs/nonnegative_integer"},
        "existing_inventory_issued_units": {"$ref": "#/$defs/nonnegative_integer"},
        "existing_inventory_remaining_units": {"$ref": "#/$defs/nonnegative_integer"},
        "other_existing_inventory_fates": {"$ref": "#/$defs/nonnegative_integer"},
        "on_time_fulfilled_units": {"$ref": "#/$defs/nonnegative_integer"},
        "late_fulfilled_units": {"$ref": "#/$defs/nonnegative_integer"},
        "stockout_units": {"$ref": "#/$defs/nonnegative_integer"},
        "window_days": {"type": "integer", "minimum": 1},
        "resource_measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["energy_kwh", "water_litres", "material_kg", "direct_labor_hours"],
          "properties": {
            "energy_kwh": {"$ref": "#/$defs/measurement"},
            "water_litres": {"$ref": "#/$defs/measurement"},
            "material_kg": {"$ref": "#/$defs/measurement"},
            "direct_labor_hours": {"$ref": "#/$defs/measurement"}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assignment_ref",
            "order_snapshot_ref",
            "production_ledger_ref",
            "quality_record_ref",
            "demand_closeout_ref",
            "inventory_issue_receipt_ref"
          ],
          "properties": {
            "assignment_ref": {"type": "string", "minLength": 1},
            "order_snapshot_ref": {"type": "string", "minLength": 1},
            "production_ledger_ref": {"type": "string", "minLength": 1},
            "quality_record_ref": {"type": "string", "minLength": 1},
            "demand_closeout_ref": {"type": "string", "minLength": 1},
            "inventory_issue_receipt_ref": {"type": ["string", "null"], "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"existing_inventory_issued_units": {"minimum": 1}},
            "required": ["existing_inventory_issued_units"]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {"inventory_issue_receipt_ref": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      ]
    }
  }
}