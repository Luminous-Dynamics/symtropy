{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:textile-demand-surplus:v0.1",
  "title": "Textile demand and surplus scenarios v0.1",
  "description": "Paired demand, production-policy and inventory comparison contract. Evidence references are identifiers; this schema does not authenticate them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "version",
    "synthetic_only",
    "interpretation_boundary",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "synthetic_only": {
      "type": "boolean"
    },
    "interpretation_boundary": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "nonNegative": {
      "type": "integer",
      "minimum": 0
    },
    "positive": {
      "type": "integer",
      "minimum": 1
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture_ref",
        "profile_id",
        "functional_unit_id",
        "forecast_units",
        "confirmed_order_units",
        "realized_demand_units",
        "existing_accepted_inventory_units",
        "batch_size_units",
        "safety_stock_units",
        "production_lead_ticks",
        "maximum_customer_wait_ticks",
        "acceptance_rate_basis_points",
        "energy_unit_id",
        "energy_per_planned_unit",
        "water_unit_id",
        "water_per_planned_unit",
        "material_unit_id",
        "material_per_planned_unit",
        "forecast_evidence_ref",
        "order_evidence_ref",
        "realized_demand_evidence_ref",
        "inventory_condition_evidence_ref",
        "acceptance_rate_evidence_ref",
        "process_intensity_evidence_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "fixture_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "profile_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "functional_unit_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "forecast_units": {
          "$ref": "#/$defs/nonNegative"
        },
        "confirmed_order_units": {
          "$ref": "#/$defs/nonNegative"
        },
        "realized_demand_units": {
          "$ref": "#/$defs/nonNegative"
        },
        "existing_accepted_inventory_units": {
          "$ref": "#/$defs/nonNegative"
        },
        "batch_size_units": {
          "$ref": "#/$defs/positive"
        },
        "safety_stock_units": {
          "$ref": "#/$defs/nonNegative"
        },
        "production_lead_ticks": {
          "$ref": "#/$defs/nonNegative"
        },
        "maximum_customer_wait_ticks": {
          "$ref": "#/$defs/nonNegative"
        },
        "acceptance_rate_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "energy_unit_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "energy_per_planned_unit": {
          "$ref": "#/$defs/nonNegative"
        },
        "water_unit_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "water_per_planned_unit": {
          "$ref": "#/$defs/nonNegative"
        },
        "material_unit_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "material_per_planned_unit": {
          "$ref": "#/$defs/nonNegative"
        },
        "forecast_evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "order_evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "realized_demand_evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "inventory_condition_evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "acceptance_rate_evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        },
        "process_intensity_evidence_ref": {
          "$ref": "#/$defs/nonEmpty"
        }
      }
    }
  }
}
