{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminous-dynamics.org/symtropy/observer-knowledge-v0.1.schema.json",
  "title": "Symtropy Observer Knowledge Item",
  "type": "object",
  "required": ["knowledge_item_id", "worldline_id", "observer_id", "proposition", "kind", "confidence", "received_atlas_time", "privacy_scope"],
  "properties": {
    "knowledge_item_id": {"type": "string"},
    "worldline_id": {"type": "string"},
    "observer_id": {"type": "string"},
    "proposition": {"type": "string"},
    "kind": {"type": "string", "enum": ["direct_observation", "memory", "authenticated_record", "professional_inference", "testimony", "public_claim", "rumor", "propaganda", "iris_prediction", "cultural_teaching", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "observed_atlas_time": {"type": ["number", "null"]},
    "received_atlas_time": {"type": "number"},
    "privacy_scope": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "contradiction_refs": {"type": "array", "items": {"type": "string"}},
    "legally_usable": {"type": "boolean"}
  },
  "additionalProperties": false
}
