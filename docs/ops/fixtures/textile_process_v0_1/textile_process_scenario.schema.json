{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/ops/fixtures/textile_process_v0_1/textile_process_scenario.schema.json",
  "title": "Textile process optimization synthetic contract benchmark",
  "description": "Version 0.1 contract-case format. It records expected semantics, not measured factory performance or a solver's numerical schedule.",
  "type": "object",
  "required": [
    "benchmark_id",
    "version",
    "evidence_status",
    "cases"
  ],
  "properties": {
    "benchmark_id": {
      "const": "TEXTILE-PROC"
    },
    "version": {
      "const": "0.1"
    },
    "evidence_status": {
      "const": "synthetic_contract_cases"
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "field",
        "state"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "synthetic_declared",
            "synthetic_modelled",
            "unknown",
            "conflicting"
          ]
        },
        "value": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "category",
        "synthetic",
        "purpose",
        "facts",
        "expected_decision",
        "required_invariants",
        "forbidden_claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "enum": [
            "scheduling",
            "quality",
            "circularity",
            "durability",
            "resilience",
            "environmental_gate",
            "supply_closure",
            "provenance",
            "determinism",
            "uncertainty"
          ]
        },
        "synthetic": {
          "const": true
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "expected_decision": {
          "enum": [
            "feasible_pareto_set",
            "incomplete_assessment",
            "blocked",
            "partial_closure",
            "determinism_invariant"
          ]
        },
        "required_invariants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 8
          }
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "additionalProperties": false
    }
  }
}
