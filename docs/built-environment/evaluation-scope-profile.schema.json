{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:schemas:evaluation-scope-profile:1.0.0",
  "title": "Housing Engineering Evaluation Scope Profile V1",
  "description": "Defines the minimum inputs and evidence-gate artifacts for a specific evaluation class and project scope. The profile itself must be approved and its SHA-256 supplied out-of-band to the receipt verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "evaluation_class",
    "risk_tier",
    "allowed_project_scope",
    "required_input_roles",
    "required_gates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "profile_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "evaluation_class": {
      "enum": [
        "structural_linear_static_reference",
        "structural_assessment",
        "thermal_energy_assessment",
        "site_hydrology_assessment",
        "layout_geometry_assessment",
        "jurisdiction_applicability"
      ]
    },
    "risk_tier": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "allowed_project_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building_uses",
        "construction_systems",
        "design_stages"
      ],
      "properties": {
        "building_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "residential_dwelling",
              "multi_unit_residential",
              "mixed_use",
              "other"
            ]
          }
        },
        "construction_systems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "design_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "concept",
              "schematic",
              "detailed_design",
              "as_built",
              "existing_building_assessment"
            ]
          }
        }
      }
    },
    "required_input_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "site_survey",
          "geotechnical_report",
          "materials_schedule",
          "load_case",
          "climate_file",
          "drainage_assessment",
          "utility_service",
          "other"
        ]
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "evidence_purpose",
          "acceptance_criterion"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          },
          "evidence_purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "acceptance_criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  }
}
