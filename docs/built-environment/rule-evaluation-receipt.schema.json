{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:schemas:rule-evaluation-receipt:0.1.0",
  "title": "Rule Evaluation Receipt V1",
  "description": "Binds a producer-declared rule-evaluation result to exact registry, jurisdiction, source, implementation, corpus, project-input, evaluator and output artifacts. Receipt integrity does not reproduce or endorse the declared result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "evaluated_at",
    "evaluation_date",
    "producer_declared_status",
    "registry",
    "jurisdiction",
    "source_binding",
    "project_input_manifest",
    "evaluator",
    "output_artifact"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_date": {
      "type": "string",
      "format": "date"
    },
    "producer_declared_status": {
      "enum": [
        "NOT_EVALUATED",
        "CLAIMED_PASS",
        "CLAIMED_FAIL"
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "region",
        "municipality",
        "resolution_status"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "municipality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "resolution_status": {
          "const": "confirmed"
        }
      }
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "edition",
        "clause_location",
        "source_snapshot_sha256",
        "rule_id",
        "rule_version",
        "implementation_sha256",
        "test_corpus_sha256",
        "translation_review_sha256"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "clause_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "implementation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "test_corpus_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "translation_review_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "project_input_manifest": {
      "$ref": "#/$defs/artifact"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "executable_artifact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "executable_artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "output_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
