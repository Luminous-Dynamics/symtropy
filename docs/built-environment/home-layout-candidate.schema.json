{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:schemas:home-layout-candidate:0.1.0",
  "title": "Home Layout Candidate V1",
  "description": "Bounded 2D candidate plan tied to exact home-brief bytes. Contract validity is not a building safety or code-compliance result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate_revision",
    "created_at",
    "brief_ref",
    "coordinate_frame",
    "generator",
    "floors",
    "zones",
    "omissions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "candidate_revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "brief_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "brief_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of exact UTF-8 brief file bytes."
        }
      }
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "units",
        "origin_description",
        "axis_convention"
      ],
      "properties": {
        "kind": {
          "const": "local_cartesian_2d"
        },
        "units": {
          "const": "m"
        },
        "origin_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "axis_convention": {
          "const": "x_right_y_up_on_plan"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "algorithm_id",
        "version",
        "reproducibility_claim"
      ],
      "properties": {
        "system": {
          "enum": [
            "symthaea",
            "symtropy",
            "sol-atlas-bevy",
            "human",
            "synthetic_fixture",
            "other"
          ]
        },
        "algorithm_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "seed": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "reproducibility_claim": {
          "const": "not_claimed",
          "description": "V1 does not claim deterministic generation."
        }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "floor_id",
          "level_index",
          "elevation_m",
          "planning_bounds_m"
        ],
        "properties": {
          "floor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "level_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "elevation_m": {
            "type": "number"
          },
          "planning_bounds_m": {
            "$ref": "#/$defs/bounds_m"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "space_id",
          "instance_index",
          "floor_id",
          "zone_kind",
          "shape",
          "bounds_m"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "space_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "instance_index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "floor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "zone_kind": {
            "enum": [
              "interior",
              "covered_external",
              "open_external"
            ]
          },
          "shape": {
            "const": "axis_aligned_rectangle_v1"
          },
          "bounds_m": {
            "$ref": "#/$defs/bounds_m"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 800
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "space_id",
          "reason"
        ],
        "properties": {
          "space_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$defs": {
    "bounds_m": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max"
      ],
      "properties": {
        "x_min": {
          "type": "number"
        },
        "y_min": {
          "type": "number"
        },
        "x_max": {
          "type": "number"
        },
        "y_max": {
          "type": "number"
        }
      }
    }
  }
}
