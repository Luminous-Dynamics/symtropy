{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:schemas:housing-evidence-manifest:0.1.0",
  "title": "Housing Engineering Evidence Manifest",
  "description": "Draft evidence envelope for reproducible housing engineering evaluations. Does not encode or certify building-code requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "created_at",
    "jurisdiction",
    "model",
    "rule_pack",
    "claims",
    "overall_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "resolution_status"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "municipality": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_status": {
          "enum": [
            "confirmed",
            "provisional",
            "unresolved"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "revision_id",
        "format",
        "unit_system",
        "artifacts"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "schema_or_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit_system": {
          "enum": [
            "SI",
            "other_explicit"
          ]
        },
        "unit_mapping_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "rule_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_pack_id",
        "status"
      ],
      "properties": {
        "rule_pack_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft_unverified",
            "reviewed_for_use",
            "superseded",
            "unavailable"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_reference"
          }
        }
      }
    },
    "toolchain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "overall_status": {
      "enum": [
        "PASS",
        "FAIL",
        "REQUIRES_REVIEW",
        "NOT_EVALUATED",
        "BLOCKED",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes_case_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "media_type",
        "sha256",
        "role"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]+/[A-Za-z0-9.+-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "enum": [
            "model",
            "input",
            "output",
            "configuration",
            "raw_result",
            "analysis",
            "photo",
            "inspection",
            "other"
          ]
        },
        "uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "retention_class": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "uri",
        "source_type",
        "rights_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "source_type": {
          "enum": [
            "legislation",
            "standard",
            "regulation",
            "technical_guidance",
            "dataset",
            "benchmark",
            "other"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "clause_or_location": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "rights_status": {
          "enum": [
            "public",
            "licensed",
            "metadata_only",
            "permission_required",
            "unknown"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_id",
        "name",
        "version"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executable_or_container_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_artifact_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "statement",
        "status",
        "mandatory",
        "subject_element_ids",
        "limitations"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "code_compliance",
            "structural_analysis",
            "building_physics",
            "site",
            "material",
            "cost",
            "construction_sequence",
            "inspection",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "REQUIRES_REVIEW",
            "NOT_EVALUATED",
            "BLOCKED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "subject_element_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requirement": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "requirement_id",
            "source_id"
          ],
          "properties": {
            "requirement_id": {
              "type": "string",
              "minLength": 1
            },
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "applicability_notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "input_artifact_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "output_artifact_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          },
          "uniqueItems": true
        },
        "tool_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "validity_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "type": [
            "string",
            "null"
          ]
        },
        "measured_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "review_status"
          ],
          "properties": {
            "review_status": {
              "enum": [
                "not_requested",
                "pending",
                "accepted",
                "rejected",
                "not_applicable"
              ]
            },
            "reviewer_role": {
              "type": [
                "string",
                "null"
              ]
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "review_record_artifact_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "mandatory": {
          "type": "boolean",
          "description": "Whether this claim is required for an aggregate PASS."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "input_artifact_sha256",
              "output_artifact_sha256",
              "tool_id",
              "validity_domain",
              "acceptance_criteria",
              "measured_result"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "output_artifact_sha256": {
                "minItems": 1
              },
              "measured_result": {
                "minLength": 1
              },
              "acceptance_criteria": {
                "minLength": 1
              },
              "validity_domain": {
                "minLength": 1
              },
              "tool_id": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "PASS"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "required": [
          "jurisdiction",
          "rule_pack",
          "claims"
        ],
        "properties": {
          "jurisdiction": {
            "required": [
              "resolution_status"
            ],
            "properties": {
              "resolution_status": {
                "const": "confirmed"
              }
            }
          },
          "rule_pack": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "reviewed_for_use"
              }
            }
          },
          "claims": {
            "contains": {
              "type": "object",
              "properties": {
                "mandatory": {
                  "const": true
                },
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "mandatory",
                "status"
              ]
            },
            "minContains": 1,
            "items": {
              "if": {
                "properties": {
                  "mandatory": {
                    "const": true
                  }
                },
                "required": [
                  "mandatory"
                ]
              },
              "then": {
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
