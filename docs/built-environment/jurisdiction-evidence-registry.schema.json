{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:schemas:jurisdiction-evidence-registry:0.1.0",
  "title": "Jurisdiction Evidence Registry V1",
  "description": "A provenance-first catalog for source instruments and possible machine-readable rule translations. Contract validity is not legal applicability or compliance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "revision",
    "evaluation_date",
    "jurisdiction",
    "source_records"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_date": {
      "type": "string",
      "format": "date",
      "description": "Explicit date used for effective-window checks, rather than ambient current time."
    },
    "jurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "country_code",
        "resolution_status"
      ],
      "properties": {
        "country_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "region": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "municipality": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "parcel_reference": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "Opaque reference only; do not place precise addresses or coordinates in a shareable registry."
        },
        "resolution_status": {
          "enum": [
            "unresolved",
            "provisional",
            "confirmed"
          ]
        }
      }
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/sourceRecord"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "captured_at",
        "media_type",
        "access_status"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "access_status": {
          "enum": [
            "public",
            "licensed",
            "restricted",
            "not_assessed"
          ]
        },
        "rights_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "access_status": {
                "const": "licensed"
              }
            },
            "required": [
              "access_status"
            ]
          },
          "then": {
            "properties": {
              "rights_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "reviewer_role",
        "reviewed_at",
        "decision",
        "evidence_artifact"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reviewer_role": {
          "enum": [
            "architect",
            "engineer",
            "building_control_officer",
            "legal_reviewer",
            "standards_specialist",
            "qualified_professional",
            "other"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "applicable_for_evaluation",
            "not_applicable",
            "insufficient_evidence",
            "requires_follow_up"
          ]
        },
        "evidence_artifact": {
          "$ref": "#/$defs/artifact"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "status",
        "validity_domain",
        "acceptance_criteria",
        "implementation_artifact",
        "test_corpus_artifact",
        "author_reference"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "enum": [
            "draft",
            "independently_reviewed",
            "not_translated"
          ]
        },
        "validity_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "acceptance_criteria": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "implementation_artifact": {
          "$ref": "#/$defs/artifact"
        },
        "test_corpus_artifact": {
          "$ref": "#/$defs/artifact"
        },
        "author_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "translation_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/translationReview"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "independently_reviewed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "translation_review"
            ],
            "properties": {
              "translation_review": {
                "$ref": "#/$defs/translationReview"
              }
            }
          }
        }
      ]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "instrument_type",
        "title",
        "issuer",
        "source_url",
        "publication_date",
        "edition",
        "clause_location",
        "lifecycle_status",
        "effective_from",
        "effective_to",
        "comment_deadline",
        "applicability_status",
        "source_snapshot",
        "review_record",
        "rule_translation",
        "notes"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "instrument_type": {
          "enum": [
            "act",
            "regulation",
            "gazette_notice",
            "incorporated_standard",
            "municipal_by_law",
            "technical_guidance",
            "proposal",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2000
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "clause_location": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 300
        },
        "lifecycle_status": {
          "enum": [
            "reported_in_force",
            "proposed",
            "repealed",
            "superseded",
            "withdrawn",
            "unknown"
          ]
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "comment_deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "applicability_status": {
          "enum": [
            "confirmed_for_project",
            "provisional",
            "not_assessed",
            "not_applicable"
          ]
        },
        "source_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/snapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/review"
            },
            {
              "type": "null"
            }
          ]
        },
        "rule_translation": {
          "anyOf": [
            {
              "$ref": "#/$defs/translation"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 3000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle_status": {
                "const": "proposed"
              }
            },
            "required": [
              "lifecycle_status"
            ]
          },
          "then": {
            "properties": {
              "instrument_type": {
                "const": "proposal"
              },
              "comment_deadline": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "instrument_type": {
                "const": "proposal"
              }
            },
            "required": [
              "instrument_type"
            ]
          },
          "then": {
            "properties": {
              "lifecycle_status": {
                "const": "proposed"
              }
            }
          }
        }
      ]
    },
    "translationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "reviewer_reference",
        "reviewer_role",
        "reviewed_at",
        "decision",
        "evidence_artifact"
      ],
      "properties": {
        "review_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reviewer_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Stable pseudonymous identity reference for checking independence from the translation author."
        },
        "reviewer_role": {
          "$ref": "#/$defs/review/properties/reviewer_role"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "approved_for_evaluation",
            "rejected",
            "insufficient_evidence",
            "requires_follow_up"
          ]
        },
        "evidence_artifact": {
          "$ref": "#/$defs/artifact"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    }
  }
}
