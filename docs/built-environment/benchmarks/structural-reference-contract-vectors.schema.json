            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "load_case": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "midpoint_point_load",
                  "uniform_distributed_load"
