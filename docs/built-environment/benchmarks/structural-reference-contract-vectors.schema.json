              "force_N": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "load_N_per_m": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "expected": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
