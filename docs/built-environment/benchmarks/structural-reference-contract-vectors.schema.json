{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Symtropy structural-reference contract-vector corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "status",
    "description",
    "numeric_policy",
    "vectors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "corpus_id": {
      "const": "symtropy.structural-reference-contract-vectors.v1"
    },
    "status": {
      "const": "ANALYTICAL_REFERENCE_CONFORMANCE_ONLY"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "numeric_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_unit_system",
        "relative_tolerance",
        "comparison",
        "non_finite_actual_or_expected",
        "unit_conversion",
        "source_status"
      ],
      "properties": {
        "input_unit_system": {
          "const": "SI"
        },
        "relative_tolerance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.000001
        },
        "comparison": {
          "type": "string",
          "minLength": 1
        },
        "non_finite_actual_or_expected": {
          "const": "REJECT"
        },
        "unit_conversion": {
          "const": "NOT_PERFORMED_CALLERS_SUPPLY_SI"
        },
        "source_status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
