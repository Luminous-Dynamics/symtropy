utProviderConvexFallback"],"determinism_profile":["NativeFloatExactEnvironment","Q16DeterministicNet","PortableSemanticTolerance"],"dt_state":["FinitePositive","Zero","Negative","NonFinite"],"inertia_subject":["Isotropic","AsymmetricMeanApproximation"],"invariant_drift":["WithinDeclaredDiagnosticEnvelope","ExceededDeclaredDiagnosticEnvelope"],"linear_velocity_guard":["NotTriggered","Triggered"],"mesh_provider":["None","Declared","Undeclared"],"model_profile_binding":["Exact","Mismatch"],"penetration_bias_guard":["NotTriggered","Triggered"],"post_state":["Finite","NonFinite"],"replay":["NotRequested","ExactEnvironmentMatch","MismatchOrCorrupt"],"requested_phenomenon":["Supported","Unsupported"],"trace_behavior":["Invariant","ChangedByTraceLevel"]},"issue":1468,"nonclaims":["No physical model validity","No engineering requirement satisfaction","No article safety or certification","No design acceptance","No physical execution or actuation authority","No claim that deterministic replay implies physical accuracy","No claim that the current engine already emits all required anomaly records"],"profile":{"authored_nonfinite_policy":"RejectBeforeRun","default_callback_policy":"NoUndeclaredPhysicsCallback","default_mesh_provider_policy":"NoUndeclaredMeshProvider","evidence_admission_authority":false,"guard_event_policy":"RetainAndReview","name":"EngineeringDeterministic","physical_authority":false,"post_state_nonfinite_policy":"InvalidateRun","stage":"contract_only_no_runtime_enforcement","trace_requirement":"TraceLevelMustNotChangeCanonicalPhysicsBehavior","unknown_approximation_policy":"UnsupportedOrBlocked"},"run_health_states":["ExecutionRejected","ExecutionIncomplete","NumericallyInvalid","NumericallyHealthyUnderProfile","HealthyWithDeclaredLimitations","ReplayMismatch","ApplicabilityReviewRequired"],"schema":"eng-synth-cred-001a-engineering-deterministic-reference-v1","source_audit_blobs":{"crates/core/symtropy-math/src/halfspace.rs":"5ce17d01f793bc543037310bec737f463bb