{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/maritime-evidence-interchange-report-v0.1.json",
  "title": "Maritime Evidence Interchange Conformance Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "report_id",
    "profile_version",
    "validator_id",
    "validator_version",
    "fixture_corpus_sha256",
    "started_at",
    "completed_at",
    "environment_sha256",
    "overall_conformance",
    "summary",
    "hard_gates",
    "case_results",
    "claim_ceiling",
    "validator_scope_note",
    "elapsed_ms"
  ],
  "properties": {
    "report_version": {
      "const": "0.1.0"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_version": {
      "const": "0.1.0"
    },
    "validator_id": {
      "type": "string",
      "minLength": 1
    },
    "validator_version": {
      "type": "string",
      "minLength": 1
    },
    "fixture_corpus_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "overall_conformance": {
      "enum": [
        "pass",
        "fail",
        "incomplete"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases_total",
        "accepted",
        "rejected",
        "abstained",
        "payload_digest_match_rate",
        "native_identifier_retention_rate",
        "ambiguous_mapping_abstention_rate",
        "conflict_preservation_rate",
        "provenance_completeness_rate"
      ],
      "properties": {
        "cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "abstained": {
          "type": "integer",
          "minimum": 0
        },
        "payload_digest_match_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "native_identifier_retention_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mapping_precision": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "mapping_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "ambiguous_mapping_abstention_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "conflict_preservation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "provenance_completeness_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "event_order_preservation_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p95_processing_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "hard_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "passed",
          "failure_count"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "failure_count": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id",
          "expected_disposition",
          "actual_disposition",
          "passed",
          "reason_codes",
          "lost_fields",
          "payload_digest_match"
        ],
        "properties": {
          "fixture_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_disposition": {
            "enum": [
              "accept",
              "reject",
              "abstain"
            ]
          },
          "actual_disposition": {
            "enum": [
              "accept",
              "reject",
              "abstain"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lost_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payload_digest_match": {
            "type": "boolean"
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "synthetic_profile_semantics_only"
    },
    "validator_scope_note": {
      "type": "string",
      "minLength": 1
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    }
  }
}
