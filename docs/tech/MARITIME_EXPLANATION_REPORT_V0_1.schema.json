{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_EXPLANATION_REPORT_V0_1.schema.json",
  "title": "Maritime diagnostic explanation evidence report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "execution",
    "case_results",
    "metamorphic_results",
    "metrics",
    "authority_boundary",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "case_sha256",
        "model_sha256",
        "explainer_sha256",
        "background_set_sha256"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "explainer_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "background_set_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "case_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "disposition",
          "reason_codes",
          "accepted_feature_ids",
          "admissible_fault_ids",
          "claim_results"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accepted_feature_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "admissible_fault_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_id",
                "status",
                "reason_codes"
              ],
              "properties": {
                "claim_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "reason_codes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "metamorphic_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "status",
          "related_case_ids"
        ],
        "properties": {
          "assertion_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_EVALUATED"
            ]
          },
          "related_case_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "value",
          "unit",
          "stratum"
        ],
        "properties": {
          "metric_id": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "unit": {
            "type": "string"
          },
          "stratum": {
            "type": "string"
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "controller_write",
        "actuation",
        "maintenance_authorization",
        "mode_transition",
        "restriction_clearance"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "controller_write": {
          "const": false
        },
        "actuation": {
          "const": false
        },
        "maintenance_authorization": {
          "const": false
        },
        "mode_transition": {
          "const": false
        },
        "restriction_clearance": {
          "const": false
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 80
    }
  }
}
