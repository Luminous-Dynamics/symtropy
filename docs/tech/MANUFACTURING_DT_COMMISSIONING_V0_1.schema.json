{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task-scoped manufacturing digital-twin commissioning profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "task_profile",
    "components",
    "evaluated_at_ns"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "MANUFACTURING-DT-COMMISSIONING-001"
    },
    "task_profile": {
      "$ref": "#/$defs/task_profile"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "evaluated_at_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "task_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "revision",
        "clock_domain",
        "supported",
        "independent_sources_required",
        "requirements"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1
        },
        "supported": {
          "type": "boolean"
        },
        "independent_sources_required": {
          "type": "boolean"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "owner",
        "authority",
        "output_scope",
        "required",
        "maximum_sample_interval_ns",
        "maximum_update_interval_ns",
        "maximum_data_age_ns",
        "maximum_p99_latency_ns",
        "maximum_clock_uncertainty_ns",
        "expected_coordinate_frame",
        "maximum_registration_error_um",
        "minimum_coverage_permille",
        "maximum_occlusion_permille",
        "maximum_fidelity_error_units",
        "expected_revision"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "output_scope": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "maximum_sample_interval_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maximum_update_interval_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "maximum_data_age_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_p99_latency_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maximum_clock_uncertainty_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expected_coordinate_frame": {
          "type": [
            "string",
            "null"
          ]
        },
        "maximum_registration_error_um": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "minimum_coverage_permille": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "maximum_occlusion_permille": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "maximum_fidelity_error_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "revision",
        "owner",
        "authority",
        "output_scope",
        "source_sha256",
        "transform_receipt_sha256",
        "clock_domain",
        "observed_at_ns",
        "sample_interval_ns",
        "update_interval_ns",
        "p99_latency_ns",
        "clock_mapping_uncertainty_ns",
        "coordinate_frame",
        "registration_error_um",
        "coverage_permille",
        "occlusion_permille",
        "fidelity_error_units",
        "common_cause_domains"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "output_scope": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transform_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clock_domain": {
          "type": "string",
          "minLength": 1
        },
        "observed_at_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sample_interval_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "update_interval_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p99_latency_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "clock_mapping_uncertainty_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "coordinate_frame": {
          "type": [
            "string",
            "null"
          ]
        },
        "registration_error_um": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "coverage_permille": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "occlusion_permille": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "fidelity_error_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "common_cause_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}