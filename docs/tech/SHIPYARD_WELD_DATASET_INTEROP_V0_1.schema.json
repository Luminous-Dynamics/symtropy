{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rights-aware welding dataset interoperability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "retrieval_date",
    "raw_files_downloaded",
    "raw_files_vendored",
    "sources",
    "split_policy",
    "claim_policy",
    "controls"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SHIPYARD-WELD-DATASET-INTEROP-001"
    },
    "retrieval_date": {
      "const": "2026-11-11"
    },
    "raw_files_downloaded": {
      "const": false
    },
    "raw_files_vendored": {
      "const": false
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "split_policy": {
      "$ref": "#/$defs/split_policy"
    },
    "claim_policy": {
      "$ref": "#/$defs/claim_policy"
    },
    "controls": {
      "type": "array",
      "minItems": 46,
      "maxItems": 46,
      "items": {
        "$ref": "#/$defs/control"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "title",
        "source_uri",
        "doi",
        "version",
        "domain",
        "publisher",
        "access_mode",
        "raw_file_license",
        "rights_status",
        "article_doi",
        "article_license",
        "article_license_scope",
        "raw_files_downloaded",
        "raw_files_vendored",
        "reported_size_gb",
        "independent_unit",
        "independent_unit_count",
        "grouping_field",
        "sessions_or_runs",
        "sample_count_label",
        "modality_classes",
        "modalities_have_distinct_sample_rates",
        "label_authority_classes",
        "verified_ndt_labels_present",
        "expert_defect_labels_present",
        "known_limitations"
      ],
      "properties": {
        "dataset_id": {
          "enum": [
            "bam-tandem-gmaw-2026",
            "intel-robotic-welding-multimodal",
            "gmaw-thermography-profilometry-2025",
            "bam-scientific-tool-use-v0.1.0"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "access_mode": {
          "type": "string"
        },
        "raw_file_license": {
          "type": "string"
        },
        "rights_status": {
          "enum": [
            "RIGHTS_PENDING",
            "RESEARCH_ONLY_NONCOMMERCIAL_GATED",
            "RIGHTS_RECONCILIATION_REQUIRED"
          ]
        },
        "article_doi": {
          "type": "string"
        },
        "article_license": {
          "type": "string"
        },
        "article_license_scope": {
          "type": "string"
        },
        "raw_files_downloaded": {
          "const": false
        },
        "raw_files_vendored": {
          "const": false
        },
        "reported_size_gb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "independent_unit": {
          "type": "string"
        },
        "independent_unit_count": {
          "type": "integer",
          "minimum": 1
        },
        "grouping_field": {
          "type": "string"
        },
        "sessions_or_runs": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count_label": {
          "type": "string"
        },
        "modality_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "modalities_have_distinct_sample_rates": {
          "const": true
        },
        "label_authority_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "process_observation",
              "surface_geometry_metrology",
              "thermocouple_measurement",
              "intended_defect_category_annotation",
              "macrographic_measurement",
              "expert_annotation",
              "independent_ndt_disposition",
              "mechanical_structural_outcome",
              "derived_numerical_reference",
              "constructed_missing_file_control"
            ]
          }
        },
        "verified_ndt_labels_present": {
          "const": false
        },
        "expert_defect_labels_present": {
          "const": false
        },
        "label_count": {
          "type": "integer",
          "minimum": 1
        },
        "known_limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "task_count": {
          "type": "integer",
          "minimum": 1
        },
        "answerable_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "constructed_withheld_task_count": {
          "type": "integer",
          "minimum": 0
        },
        "introductory_sft_example_count": {
          "type": "integer",
          "minimum": 0
        },
        "heldout_test_workpiece_count": {
          "type": "integer",
          "minimum": 1
        },
        "published_models_all_solved_test_ceiling": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dataset_id": {
                "const": "bam-scientific-tool-use-v0.1.0"
              }
            },
            "required": [
              "dataset_id"
            ]
          },
          "then": {
            "required": [
              "task_count",
              "answerable_task_count",
              "constructed_withheld_task_count",
              "introductory_sft_example_count",
              "heldout_test_workpiece_count",
              "published_models_all_solved_test_ceiling"
            ],
            "properties": {
              "rights_status": {
                "const": "RIGHTS_RECONCILIATION_REQUIRED"
              },
              "raw_file_license": {
                "const": "DERIVATIVE_CLAIMS_CC-BY-4.0; OFFICIAL_ZENODO_SOURCE_RECORD_SHOWS_COPYRIGHT_AND_BLANK_LICENSE_FIELD"
              },
              "independent_unit_count": {
                "const": 5
              },
              "grouping_field": {
                "const": "workpiece_id"
              },
              "task_count": {
                "const": 160
              },
              "answerable_task_count": {
                "const": 130
              },
              "constructed_withheld_task_count": {
                "const": 30
              },
              "introductory_sft_example_count": {
                "const": 480
              },
              "heldout_test_workpiece_count": {
                "const": 1
              },
              "published_models_all_solved_test_ceiling": {
                "const": true
              },
              "raw_files_downloaded": {
                "const": false
              },
              "raw_files_vendored": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "bam_group",
        "intel_group",
        "thermography_group",
        "random_sample_split_allowed"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 20
        },
        "bam_group": {
          "const": "workpiece_id"
        },
        "intel_group": {
          "const": "welding_session_or_weld_id"
        },
        "thermography_group": {
          "const": "experiment_run_id"
        },
        "random_sample_split_allowed": {
          "const": false
        }
      }
    },
    "claim_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_observation_is_quality_truth",
        "intended_defect_annotation_is_expert_verified",
        "macrograph_is_ndt",
        "verified_ndt_labels_present_in_seed_sources",
        "cross_domain_accuracy_pooling_allowed",
        "leave_one_domain_out_requires_semantically_matched_target"
      ],
      "properties": {
        "process_observation_is_quality_truth": {
          "const": false
        },
        "intended_defect_annotation_is_expert_verified": {
          "const": false
        },
        "macrograph_is_ndt": {
          "const": false
        },
        "verified_ndt_labels_present_in_seed_sources": {
          "const": false
        },
        "cross_domain_accuracy_pooling_allowed": {
          "const": false
        },
        "leave_one_domain_out_requires_semantically_matched_target": {
          "const": true
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "class",
        "expected_disposition",
        "mutation",
        "rationale"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^WDINT-[0-9]{3}$"
        },
        "class": {
          "enum": [
            "positive_contract_control",
            "negative_control"
          ]
        },
        "expected_disposition": {
          "type": "string",
          "minLength": 5
        },
        "mutation": {
          "type": "string",
          "minLength": 15
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}