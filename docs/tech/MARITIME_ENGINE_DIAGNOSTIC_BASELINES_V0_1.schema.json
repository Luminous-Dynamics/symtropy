{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_ENGINE_DIAGNOSTIC_BASELINES_V0_1.schema.json",
  "title": "Marine engine diagnostic benchmark registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "registry_version",
    "claim_ceiling",
    "baselines"
  ],
  "properties": {
    "registry_id": {
      "const": "luminous.symtropy.marine-engine-diagnostic-baselines"
    },
    "registry_version": {
      "const": "0.1.0"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 80
    },
    "baselines": {
      "type": "array",
      "minItems": 14,
      "items": {
        "$ref": "#/$defs/baseline"
      }
    }
  },
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_type",
        "publication_date",
        "source_url",
        "data_domain",
        "task",
        "reported_metrics",
        "split_protocol",
        "reported_limitations",
        "reproducibility_status",
        "direct_comparison_to_aalto"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 10
        },
        "source_type": {
          "enum": [
            "peer_reviewed_article",
            "data_descriptor",
            "public_dataset",
            "preprint_or_other"
          ]
        },
        "publication_date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "data_domain": {
          "type": "string",
          "minLength": 10
        },
        "task": {
          "type": "string",
          "minLength": 10
        },
        "reported_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "value",
              "unit",
              "context",
              "source_location"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              },
              "unit": {
                "type": "string"
              },
              "context": {
                "type": "string",
                "minLength": 5
              },
              "source_location": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        },
        "split_protocol": {
          "type": "string",
          "minLength": 10
        },
        "reported_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reproducibility_status": {
          "enum": [
            "reported_not_reproduced",
            "source_code_found_payload_not_audited",
            "metadata_verified_payload_not_audited",
            "independently_reproduced"
          ]
        },
        "direct_comparison_to_aalto": {
          "enum": [
            "not_comparable",
            "candidate_after_protocol_alignment",
            "same_dataset"
          ]
        },
        "audit_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publication_date_precision": {
          "enum": [
            "day",
            "month",
            "year"
          ]
        }
      }
    }
  }
}
