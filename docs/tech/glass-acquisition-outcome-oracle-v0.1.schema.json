{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glass–Silicon Sealed Acquisition Outcome Oracle v0.1",
  "description": "Evaluator-owned latent scenarios, utilities, feasibility labels, frozen controls, and measurement outcomes. Never pass this object to a selector process.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "evidence_class",
    "scenarios",
    "actions",
    "constraint_controls",
    "measurement_outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "evidence_class": {
      "const": "synthetic_evaluator_only"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "utility_by_scenario",
          "feasible_by_scenario"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "utility_by_scenario": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          },
          "feasible_by_scenario": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "constraint_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "scenario_id",
          "must_be_feasible"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "scenario_id": {
            "type": "string"
          },
          "must_be_feasible": {
            "type": "boolean"
          }
        }
      }
    },
    "measurement_outcomes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_by_scenario"
        ],
        "properties": {
          "observation_by_scenario": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
