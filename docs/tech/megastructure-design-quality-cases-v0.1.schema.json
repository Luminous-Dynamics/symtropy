{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/megstructure-design-quality-cases-v0.1.schema.json",
  "title": "Synthetic Megastructure Design Quality Cases v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "claim_class",
    "aggregation_policy",
    "hard_gate_precedence",
    "dimension_vocabulary",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "suite_id": {
      "const": "MEGASTRUCTURE-DESIGN-QUALITY-SYNTHETIC-001"
    },
    "claim_class": {
      "const": "SYNTHETIC_REVIEW_POLICY_ONLY"
    },
    "aggregation_policy": {
      "const": "NO_UNIVERSAL_AESTHETIC_SCORE"
    },
    "hard_gate_precedence": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "structural_safety",
          "operational_safety",
          "accessibility",
          "maintainability",
          "rights",
          "environment",
          "ecology"
        ]
      }
    },
    "dimension_vocabulary": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "formal_coherence_legibility",
          "human_experience_dignity",
          "material_honesty_repairability",
          "ecological_planetary_orbital_relationship",
          "pluralism_place_cultural_authorship"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "gateStatus": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not_applicable"
      ]
    },
    "dimension": {
      "enum": [
        "formal_coherence_legibility",
        "human_experience_dignity",
        "material_honesty_repairability",
        "ecological_planetary_orbital_relationship",
        "pluralism_place_cultural_authorship"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "asset_family",
        "candidate",
        "expected_disposition",
        "expected_reason_codes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[A-Z0-9_-]+$"
        },
        "asset_family": {
          "enum": [
            "orbital_ring_service_node",
            "orbital_ring_support_station",
            "rotating_habitat_commons",
            "orbital_shipyard",
            "terrestrial_spaceport_ecosystem",
            "terrestrial_launch_integration_facility"
          ]
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "expected_disposition": {
          "enum": [
            "blocked_hard_gate",
            "design_review_incomplete",
            "admissible_for_multicriteria_review",
            "trade_study_required",
            "time_limited_deferment"
          ]
        },
        "expected_reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "design_identity",
        "design_intent",
        "hard_gates",
        "review",
        "physical_deltas",
        "synthetic_notes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "design_identity": {
          "type": "string",
          "pattern": "^SYNTHETIC-DESIGN-GENERATION-[A-Z][0-9]+$"
        },
        "design_intent": {
          "type": "string",
          "minLength": 1
        },
        "hard_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "structural_safety",
            "operational_safety",
            "accessibility",
            "maintainability",
            "rights",
            "environment",
            "ecology"
          ],
          "properties": {
            "structural_safety": {
              "$ref": "#/$defs/gateStatus"
            },
            "operational_safety": {
              "$ref": "#/$defs/gateStatus"
            },
            "accessibility": {
              "$ref": "#/$defs/gateStatus"
            },
            "maintainability": {
              "$ref": "#/$defs/gateStatus"
            },
            "rights": {
              "$ref": "#/$defs/gateStatus"
            },
            "environment": {
              "$ref": "#/$defs/gateStatus"
            },
            "ecology": {
              "$ref": "#/$defs/gateStatus"
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "views_complete",
            "reviewed_dimensions",
            "stakeholder_groups",
            "dissent_preserved"
          ],
          "properties": {
            "status": {
              "enum": [
                "complete",
                "incomplete",
                "deferred"
              ]
            },
            "views_complete": {
              "type": "boolean"
            },
            "reviewed_dimensions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/dimension"
              }
            },
            "stakeholder_groups": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dissent_preserved": {
              "type": "boolean"
            },
            "deferment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reason",
                "expires_at",
                "improvement_owner"
              ],
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "expires_at": {
                  "type": "string",
                  "format": "date"
                },
                "improvement_owner": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "deferred"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "deferment"
                ]
              }
            }
          ]
        },
        "physical_deltas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mass_delta_kg",
            "power_delta_kw",
            "thermal_delta_kw",
            "maintenance_time_delta_pct"
          ],
          "properties": {
            "mass_delta_kg": {
              "type": "number"
            },
            "power_delta_kw": {
              "type": "number"
            },
            "thermal_delta_kw": {
              "type": "number"
            },
            "maintenance_time_delta_pct": {
              "type": "number"
            }
          }
        },
        "synthetic_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
