{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/glass-eprocess-qualification-task-v0.1.schema.json",
  "title": "Glass mixture e-process task v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "target_success_probability",
    "familywise_alpha",
    "registration_rule",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "glass-anytime-eprocess-qualification-synthetic-v0-1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "Synthetic Bernoulli mixture-e-process mechanics only; no real-material, plant-yield, independence, adaptive-ledger-integrity, or industrial-performance claim is validated."
    },
    "target_success_probability": {
      "const": 0.95
    },
    "familywise_alpha": {
      "const": 0.05
    },
    "registration_rule": {
      "const": "append_only_one_based_registration_order"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_seq",
              "kind",
              "candidate_id",
              "candidate_spec",
              "candidate_spec_sha256"
            ],
            "properties": {
              "event_seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "kind": {
                "const": "register_candidate"
              },
              "candidate_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "candidate_spec": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "features"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "features": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "candidate_spec_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_seq",
              "kind",
              "candidate_id"
            ],
            "properties": {
              "event_seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "kind": {
                "const": "observe_trial"
              },
              "candidate_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            }
          }
        ]
      }
    }
  }
}
