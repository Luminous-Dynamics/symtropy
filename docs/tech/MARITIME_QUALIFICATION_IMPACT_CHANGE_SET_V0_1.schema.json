{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_QUALIFICATION_IMPACT_CHANGE_SET_V0_1.schema.json",
  "title": "Maritime qualification impact change set v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_set_id",
    "generated_at",
    "evidence_class",
    "asset_scope",
    "nodes",
    "dependency_edges",
    "changes",
    "authority_boundary",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "change_set_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "asset_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "configuration_revision",
        "configuration_sha256"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "node_kind",
          "sha256",
          "scope",
          "qualification_state"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "node_kind": {
            "enum": [
              "evidence",
              "qualification"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "qualification_state": {
            "enum": [
              "not_applicable",
              "qualified",
              "expired",
              "revoked",
              "not_evaluated"
            ]
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependent_id",
          "prerequisite_id",
          "dependency_type"
        ],
        "properties": {
          "dependent_id": {
            "type": "string",
            "minLength": 1
          },
          "prerequisite_id": {
            "type": "string",
            "minLength": 1
          },
          "dependency_type": {
            "enum": [
              "requires",
              "uses",
              "calibrated_against",
              "qualified_against",
              "derived_from"
            ]
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_id",
          "node_id",
          "previous_sha256",
          "new_sha256",
          "change_kind",
          "effective_at"
        ],
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "previous_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "new_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "change_kind": {
            "enum": [
              "ASSET_RECONFIGURATION",
              "SENSOR_REPLACEMENT",
              "CALIBRATION_CHANGE",
              "TIMEBASE_REQUALIFICATION",
              "MODEL_UPDATE",
              "SOFTWARE_UPDATE",
              "EVIDENCE_REVISION"
            ]
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "actuation",
        "maintenance_authorization",
        "mode_transition_authorization",
        "restriction_clearance"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "actuation": {
          "const": false
        },
        "maintenance_authorization": {
          "const": false
        },
        "mode_transition_authorization": {
          "const": false
        },
        "restriction_clearance": {
          "const": false
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 80
    }
  }
}
