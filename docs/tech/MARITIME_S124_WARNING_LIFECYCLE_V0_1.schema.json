{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/maritime/s124-warning-lifecycle-v0.1.json",
  "title": "Synthetic S-124 warning lifecycle contract corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "corpus_version",
    "source_profile",
    "claim_ceiling",
    "base_state",
    "cases"
  ],
  "properties": {
    "corpus_id": {
      "const": "luminous.symtropy.s124-warning-lifecycle"
    },
    "corpus_version": {
      "const": "0.1.0"
    },
    "source_profile": {
      "$ref": "#/$defs/profile"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "base_state": {
      "$ref": "#/$defs/state"
    },
    "cases": {
      "type": "array",
      "minItems": 17,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "product_edition",
        "s100_edition",
        "artifact_lock_state",
        "s158_maturity"
      ],
      "properties": {
        "product_id": {
          "const": "S-124"
        },
        "product_edition": {
          "const": "2.0.0"
        },
        "s100_edition": {
          "const": "5.2.0"
        },
        "artifact_lock_state": {
          "const": "pending_exact_artifact_lock"
        },
        "s158_maturity": {
          "const": "implementation_testing_only"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "message_series_id",
        "serial_number",
        "revision",
        "lifecycle_state",
        "issue_time_utc",
        "publication_time_utc",
        "retrieved_at_utc",
        "valid_from_utc",
        "valid_to_utc",
        "cancellation_time_utc",
        "location_precision",
        "location_text",
        "geometry_ref"
      ],
      "properties": {
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "message_series_id": {
          "type": "string",
          "minLength": 1
        },
        "serial_number": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "lifecycle_state": {
          "enum": [
            "active",
            "cancelled",
            "expired",
            "superseded",
            "scheduled"
          ]
        },
        "issue_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "publication_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from_utc": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to_utc": {
          "type": "string",
          "format": "date-time"
        },
        "cancellation_time_utc": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "location_precision": {
          "enum": [
            "source_geometry",
            "approximate_source_geometry",
            "qualitative_only",
            "precise_geometry_inferred_from_text"
          ]
        },
        "location_text": {
          "type": "string",
          "minLength": 1
        },
        "geometry_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "producer_id",
        "message_series_id",
        "serial_number",
        "event_sequence",
        "event_type",
        "event_time_utc",
        "publication_time_utc",
        "retrieved_at_utc",
        "target_message_series_id",
        "target_serial_number"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "message_series_id": {
          "type": "string",
          "minLength": 1
        },
        "serial_number": {
          "type": "string",
          "minLength": 1
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_type": {
          "enum": [
            "new",
            "update",
            "reissue",
            "cancellation",
            "self_cancelling"
          ]
        },
        "event_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "publication_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "target_message_series_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "target_serial_number": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bulletin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bulletin_id",
        "revision",
        "publication_time_utc",
        "retrieved_at_utc",
        "complete",
        "member_keys"
      ],
      "properties": {
        "bulletin_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "publication_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "member_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warning_key",
        "status",
        "source_ref",
        "artifact_sha256",
        "received_at_utc",
        "acknowledged_at_utc"
      ],
      "properties": {
        "warning_key": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unknown",
            "received",
            "displayed",
            "acknowledged"
          ]
        },
        "source_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_sha256": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "received_at_utc": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "acknowledged_at_utc": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_kind",
        "evaluation_cutoff_utc",
        "max_warning_age_s",
        "max_bulletin_age_s",
        "warnings",
        "events",
        "in_force_bulletin",
        "delivery_evidence"
      ],
      "properties": {
        "fixture_kind": {
          "const": "synthetic_fixture"
        },
        "evaluation_cutoff_utc": {
          "type": "string",
          "format": "date-time"
        },
        "max_warning_age_s": {
          "type": "integer",
          "minimum": 1
        },
        "max_bulletin_age_s": {
          "type": "integer",
          "minimum": 1
        },
        "warnings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/warning"
          }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "in_force_bulletin": {
          "$ref": "#/$defs/bulletin"
        },
        "delivery_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/delivery"
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "op",
        "value"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "const": "set"
        },
        "value": {}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mutations",
        "expected_code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutation"
          }
        },
        "expected_code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
