{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registered 2D cross-section profile comparison input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "reference",
    "measured",
    "registration",
    "minimum_coverage_permille",
    "maximum_station_gap_units"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SHIPYARD-PROFILE-GEOMETRY-ORACLE-001"
    },
    "reference": {
      "$ref": "#/$defs/reference_profile"
    },
    "measured": {
      "$ref": "#/$defs/measured_profile"
    },
    "registration": {
      "$ref": "#/$defs/registration_receipt"
    },
    "minimum_coverage_permille": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maximum_station_gap_units": {
      "type": "integer",
      "minimum": 1
    },
    "claim_ceiling": {
      "const": "REGISTERED_2D_CROSS_SECTION_PROFILE_DEVIATION_ONLY"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_units",
        "height_units"
      ],
      "properties": {
        "station_units": {
          "type": "integer",
          "minimum": 0
        },
        "height_units": {
          "type": "integer"
        }
      }
    },
    "measured_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_units",
        "height_units",
        "vertical_uncertainty_bound_units",
        "valid"
      ],
      "properties": {
        "station_units": {
          "type": "integer",
          "minimum": 0
        },
        "height_units": {
          "type": "integer"
        },
        "vertical_uncertainty_bound_units": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        }
      }
    },
    "reference_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workpiece_id",
        "joint_revision",
        "coordinate_frame",
        "profile_id",
        "sha256",
        "points"
      ],
      "properties": {
        "workpiece_id": {
          "type": "string",
          "minLength": 1
        },
        "joint_revision": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "measured_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workpiece_id",
        "joint_revision",
        "coordinate_frame",
        "profile_id",
        "sha256",
        "points"
      ],
      "properties": {
        "workpiece_id": {
          "type": "string",
          "minLength": 1
        },
        "joint_revision": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/measured_point"
          }
        }
      }
    },
    "registration_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "source_scan_sha256",
        "reference_profile_sha256",
        "transform_revision",
        "registration_error_bound_units"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_scan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reference_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transform_revision": {
          "type": "string",
          "minLength": 1
        },
        "registration_error_bound_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}