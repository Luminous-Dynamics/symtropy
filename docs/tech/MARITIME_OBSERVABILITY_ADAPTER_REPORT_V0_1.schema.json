{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_OBSERVABILITY_ADAPTER_REPORT_V0_1.schema.json",
  "title": "Maritime observability adapter report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "generated_at",
    "asset",
    "operating_domain",
    "evidence_digests",
    "sensor_inventory",
    "fault_assessments",
    "pair_assessments",
    "sensor_loss_scenarios",
    "metrics",
    "authority_boundary",
    "claim_ceiling",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "$ref": "#/$defs/ref"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_class",
        "vessel_id",
        "engine_id",
        "configuration_revision",
        "configuration_sha256"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/ref"
        },
        "asset_class": {
          "type": "string"
        },
        "vessel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_revision": {
          "$ref": "#/$defs/ref"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "operating_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime_id",
        "description",
        "qualification_state",
        "load_percent",
        "speed_rpm",
        "transient_state"
      ],
      "properties": {
        "regime_id": {
          "$ref": "#/$defs/ref"
        },
        "description": {
          "type": "string"
        },
        "qualification_state": {
          "enum": [
            "qualified",
            "unsupported",
            "not_evaluated"
          ]
        },
        "load_percent": {
          "type": [
            "number",
            "null"
          ]
        },
        "speed_rpm": {
          "type": [
            "number",
            "null"
          ]
        },
        "transient_state": {
          "enum": [
            "steady",
            "transient",
            "mixed",
            "unknown"
          ]
        }
      }
    },
    "evidence_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_topology_sha256",
        "fault_model_sha256",
        "evaluator_sha256",
        "dataset_sha256",
        "split_manifest_sha256",
        "model_sha256"
      ],
      "properties": {
        "sensor_topology_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fault_model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluator_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dataset_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "split_manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sensor_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "channel_id",
          "installed",
          "measurement_principle",
          "unit",
          "source_role",
          "quality_state",
          "calibration_state",
          "dependency_groups",
          "derived_from_channel_ids"
        ],
        "properties": {
          "sensor_id": {
            "$ref": "#/$defs/ref"
          },
          "channel_id": {
            "$ref": "#/$defs/ref"
          },
          "installed": {
            "type": "boolean"
          },
          "measurement_principle": {
            "$ref": "#/$defs/ref"
          },
          "unit": {
            "$ref": "#/$defs/ref"
          },
          "source_role": {
            "enum": [
              "measured",
              "derived",
              "reconstructed",
              "simulated",
              "synthetic"
            ]
          },
          "quality_state": {
            "enum": [
              "current",
              "missing",
              "stale",
              "rejected",
              "conflicted",
              "unknown"
            ]
          },
          "calibration_state": {
            "enum": [
              "current",
              "expired",
              "unknown",
              "not_applicable"
            ]
          },
          "dependency_groups": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "derived_from_channel_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "fault_assessments": {
      "type": "array",
      "maxItems": 0
    },
    "pair_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fault_a",
          "fault_b",
          "state",
          "method",
          "evidence_refs"
        ],
        "properties": {
          "fault_a": {
            "$ref": "#/$defs/ref"
          },
          "fault_b": {
            "$ref": "#/$defs/ref"
          },
          "state": {
            "enum": [
              "isolable",
              "non_isolable",
              "not_evaluated"
            ]
          },
          "method": {
            "const": "structural"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "sha256",
                "evidence_role",
                "channel_ids"
              ],
              "properties": {
                "artifact_id": {
                  "$ref": "#/$defs/ref"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "evidence_role": {
                  "enum": [
                    "measured",
                    "synthetic",
                    "derived",
                    "simulated",
                    "expert_authored"
                  ]
                },
                "channel_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ref"
                  }
                }
              }
            }
          }
        }
      }
    },
    "sensor_loss_scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "removed_sensor_ids",
          "removed_dependency_groups",
          "assessment_state",
          "lost_isolability_pairs"
        ],
        "properties": {
          "scenario_id": {
            "$ref": "#/$defs/ref"
          },
          "removed_sensor_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "removed_dependency_groups": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "assessment_state": {
            "const": "recomputed"
          },
          "lost_isolability_pairs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fault_a",
                "fault_b"
              ],
              "properties": {
                "fault_a": {
                  "$ref": "#/$defs/ref"
                },
                "fault_b": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "value",
          "unit",
          "stratum",
          "sample_count"
        ],
        "properties": {
          "metric_id": {
            "$ref": "#/$defs/ref"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "$ref": "#/$defs/ref"
          },
          "stratum": {
            "$ref": "#/$defs/ref"
          },
          "sample_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "actuation",
        "maintenance_authorization",
        "mode_transition_authorization",
        "restriction_clearance"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "actuation": {
          "const": false
        },
        "maintenance_authorization": {
          "const": false
        },
        "mode_transition_authorization": {
          "const": false
        },
        "restriction_clearance": {
          "const": false
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_commit",
        "case_sha256"
      ],
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "case_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
