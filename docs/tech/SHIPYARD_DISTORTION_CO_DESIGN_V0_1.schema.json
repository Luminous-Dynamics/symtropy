{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipyard distortion co-design benchmark corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SHIPYARD-DISTORTION-CO-DESIGN-001"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 30
    },
    "cases": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "pair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "release_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "cooling_complete",
        "all_restraints_removed"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "cooling_complete": {
          "type": "boolean"
        },
        "all_restraints_removed": {
          "type": "boolean"
        }
      }
    },
    "final_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "cooling_complete",
        "restraints_removed",
        "datum_id",
        "uncertainty_present",
        "evidence_class"
      ],
      "properties": {
        "phase": {
          "enum": [
            "final_free_state",
            "in_fixture",
            "intermediate"
          ]
        },
        "cooling_complete": {
          "type": "boolean"
        },
        "restraints_removed": {
          "type": "boolean"
        },
        "datum_id": {
          "type": "string"
        },
        "uncertainty_present": {
          "type": "boolean"
        },
        "evidence_class": {
          "enum": [
            "synthetic_contract",
            "measured_physical",
            "simulated"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "validation_state",
        "out_of_domain",
        "physical_claim"
      ],
      "properties": {
        "scope": {
          "enum": [
            "synthetic_toy",
            "qualified_physical",
            "unsupported"
          ]
        },
        "validation_state": {
          "enum": [
            "synthetic_contract_only",
            "independently_validated",
            "unqualified",
            "missing"
          ]
        },
        "out_of_domain": {
          "type": "boolean"
        },
        "physical_claim": {
          "type": "boolean"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_class",
        "panel_revision",
        "weld_tasks",
        "sequence",
        "precedence",
        "fixture_reaction_limit_units",
        "predicted_fixture_reaction_units",
        "release_events",
        "final_measurement",
        "model",
        "future_information_used",
        "resource_conflict",
        "objective_vector",
        "as_built_writeback",
        "expected_disposition"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^SDC-[0-9]{3}$"
        },
        "case_class": {
          "enum": [
            "positive_contract_control",
            "negative_control"
          ]
        },
        "panel_revision": {
          "type": "string",
          "minLength": 1
        },
        "weld_tasks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sequence": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "precedence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "fixture_reaction_limit_units": {
          "type": "integer",
          "minimum": 0
        },
        "predicted_fixture_reaction_units": {
          "type": "integer",
          "minimum": 0
        },
        "release_events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/release_event"
          }
        },
        "final_measurement": {
          "oneOf": [
            {
              "$ref": "#/$defs/final_measurement"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "future_information_used": {
          "type": "boolean"
        },
        "resource_conflict": {
          "type": "boolean"
        },
        "objective_vector": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "final_free_state_geometry",
              "production_time",
              "fixture_cost",
              "worst_case_robustness"
            ]
          }
        },
        "as_built_writeback": {
          "type": "boolean"
        },
        "expected_disposition": {
          "enum": [
            "SYNTHETIC_PLAN_CONTRACT_VALID",
            "BLOCK_SEQUENCE",
            "BLOCK_FIXTURE_LIMIT",
            "BLOCK_RELEASE_STATE",
            "BLOCK_FINAL_MEASUREMENT",
            "BLOCK_MODEL_SCOPE",
            "BLOCK_SCHEDULE",
            "BLOCK_OBJECTIVES",
            "BLOCK_AUTHORITY"
          ]
        }
      }
    }
  }
}