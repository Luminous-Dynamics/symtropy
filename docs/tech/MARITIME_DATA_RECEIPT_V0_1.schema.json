{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_DATA_RECEIPT_V0_1.schema.json",
  "title": "Maritime Data Receipt v0.1",
  "description": "Provenance and byte-integrity metadata only. Not a physical-observation or engineering-qualification certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "receipt_id",
    "source",
    "retrieval",
    "artifact",
    "data_context",
    "terms",
    "intended_use",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "luminous.symtropy.maritime-data-receipt"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "publisher",
        "dataset_id",
        "product",
        "source_uri",
        "dataset_revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "synthetic_fixture",
            "public_dataset"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product": {
          "enum": [
            "water_level",
            "water_level_prediction",
            "currents",
            "hydrography",
            "port_facility",
            "other"
          ]
        },
        "source_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "dataset_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "retrieved_at_utc",
        "request_uri",
        "http_status",
        "reported_content_type",
        "collector_version"
      ],
      "properties": {
        "method": {
          "enum": [
            "local_fixture",
            "http_get",
            "manual_download"
          ]
        },
        "retrieved_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "request_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 599
        },
        "reported_content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "collector_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "media_type",
        "byte_length",
        "hash_algorithm",
        "sha256",
        "bytes_scope"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "hash_algorithm": {
          "const": "sha-256"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes_scope": {
          "const": "exact_file_bytes"
        }
      }
    },
    "data_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "coordinate_reference_system",
        "vertical_datum",
        "units",
        "time_coverage_start_utc",
        "time_coverage_end_utc",
        "survey_or_observation_time_utc",
        "verification_state",
        "uncertainty_statement",
        "freshness_policy",
        "freshness_policy_description"
      ],
      "properties": {
        "domain": {
          "enum": [
            "water_level",
            "water_level_prediction",
            "currents",
            "hydrography",
            "port_facility",
            "other"
          ]
        },
        "coordinate_reference_system": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "vertical_datum": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "time_coverage_start_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "time_coverage_end_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "survey_or_observation_time_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verification_state": {
          "enum": [
            "preliminary",
            "verified",
            "prediction",
            "synthetic",
            "unknown"
          ]
        },
        "uncertainty_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "freshness_policy": {
          "enum": [
            "not_applicable_synthetic",
            "policy_required",
            "historical_only",
            "policy_defined"
          ]
        },
        "freshness_policy_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "license_name",
        "license_uri",
        "reviewer",
        "reviewed_at_utc",
        "terms_sha256",
        "permitted_use_statement"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "not_applicable_synthetic",
            "review_required",
            "reviewed_permitted"
          ]
        },
        "license_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "license_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "terms_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "permitted_use_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "navigation_use_authorized",
        "physical_truth_claim_authorized",
        "independent_review_required"
      ],
      "properties": {
        "scope": {
          "enum": [
            "provenance_test_only",
            "offline_research",
            "planning_only"
          ]
        },
        "navigation_use_authorized": {
          "const": false
        },
        "physical_truth_claim_authorized": {
          "const": false
        },
        "independent_review_required": {
          "const": true
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "synthetic_fixture"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "source_uri": {
                "type": "null"
              }
            }
          },
          "retrieval": {
            "properties": {
              "method": {
                "const": "local_fixture"
              },
              "retrieved_at_utc": {
                "type": "null"
              },
              "request_uri": {
                "type": "null"
              },
              "http_status": {
                "type": "null"
              }
            }
          },
          "data_context": {
            "properties": {
              "verification_state": {
                "const": "synthetic"
              },
              "freshness_policy": {
                "const": "not_applicable_synthetic"
              }
            }
          },
          "terms": {
            "properties": {
              "review_status": {
                "const": "not_applicable_synthetic"
              },
              "reviewer": {
                "type": "null"
              },
              "reviewed_at_utc": {
                "type": "null"
              },
              "terms_sha256": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "public_dataset"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "source_uri": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "retrieval": {
            "properties": {
              "method": {
                "enum": [
                  "http_get",
                  "manual_download"
                ]
              },
              "retrieved_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "request_uri": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "data_context": {
            "properties": {
              "verification_state": {
                "enum": [
                  "preliminary",
                  "verified",
                  "prediction"
                ]
              },
              "freshness_policy": {
                "enum": [
                  "policy_required",
                  "historical_only",
                  "policy_defined"
                ]
              }
            }
          },
          "terms": {
            "properties": {
              "review_status": {
                "const": "reviewed_permitted"
              },
              "license_uri": {
                "type": "string",
                "pattern": "^https://"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "terms_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_context": {
            "properties": {
              "domain": {
                "const": "water_level"
              }
            },
            "required": [
              "domain"
            ]
          }
        },
        "required": [
          "data_context"
        ]
      },
      "then": {
        "properties": {
          "data_context": {
            "properties": {
              "vertical_datum": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_context": {
            "properties": {
              "domain": {
                "const": "hydrography"
              }
            },
            "required": [
              "domain"
            ]
          }
        },
        "required": [
          "data_context"
        ]
      },
      "then": {
        "properties": {
          "data_context": {
            "properties": {
              "coordinate_reference_system": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
