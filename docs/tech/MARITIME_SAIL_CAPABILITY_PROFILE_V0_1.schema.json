{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/maritime-sail-capability-profile-v0.1.json",
  "title": "Maritime sail capability profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "evidence_class",
    "as_of_utc",
    "asset_configuration",
    "capability_graph",
    "authority_boundary",
    "claim_ceiling",
    "change_scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "maritime-sail-capability-profile-v0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "as_of_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "asset_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "configuration_sha256",
        "component_identity_policy"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "component_identity_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capability_graph": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "mutation_performed",
        "authorization_granted",
        "actuator_commands_emitted"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "mutation_performed": {
          "const": false
        },
        "authorization_granted": {
          "const": false
        },
        "actuator_commands_emitted": {
          "const": false
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "change_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/changeScenario"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "depends_on",
        "required_dependency_ids",
        "qualification_case_id",
        "operating_regime",
        "configuration_component_ids",
        "claim_ceiling"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^sail\\.[a-z0-9_]+$"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sail\\.[a-z0-9_]+$"
          }
        },
        "required_dependency_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sensor_topology",
              "calibration",
              "timebase",
              "source_payload",
              "diagnostic_model",
              "evaluator",
              "validation_profile"
            ]
          }
        },
        "qualification_case_id": {
          "type": "string",
          "minLength": 1
        },
        "operating_regime": {
          "type": "string",
          "minLength": 1
        },
        "configuration_component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changeScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "trigger_component_ids",
        "directly_invalidated_capability_ids",
        "expected_invalidated_capability_ids",
        "expected_preserved_capability_ids",
        "claim_ceiling"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "trigger_component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "directly_invalidated_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sail\\.[a-z0-9_]+$"
          }
        },
        "expected_invalidated_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sail\\.[a-z0-9_]+$"
          }
        },
        "expected_preserved_capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sail\\.[a-z0-9_]+$"
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
