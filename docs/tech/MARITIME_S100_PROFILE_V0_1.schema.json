{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_S100_PROFILE_V0_1.schema.json",
  "title": "Maritime S-100 product-profile envelope v0.1",
  "description": "Limited metadata contract for synthetic and reviewed profile integration. Not an IHO decoder or navigational qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "profile_id",
    "receipt_binding",
    "source_kind",
    "product",
    "coverage",
    "temporal",
    "quality",
    "terms",
    "transform",
    "intended_use"
  ],
  "properties": {
    "schema_id": {
      "const": "luminous.symtropy.maritime-s100-profile"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_kind": {
      "enum": [
        "synthetic_fixture",
        "public_dataset"
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "s100_edition",
        "specification_edition",
        "producer_code",
        "dataset_id",
        "revision",
        "native_encoding"
      ],
      "properties": {
        "code": {
          "enum": [
            "S-102",
            "S-104",
            "S-111"
          ]
        },
        "s100_edition": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "specification_edition": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "producer_code": {
          "type": "string",
          "minLength": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "native_encoding": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_id",
        "horizontal_crs",
        "vertical_reference",
        "measurement_units"
      ],
      "properties": {
        "coverage_id": {
          "type": "string",
          "minLength": 1
        },
        "horizontal_crs": {
          "type": "string",
          "minLength": 1
        },
        "vertical_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "measurement_units": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "m",
              "cm",
              "mm",
              "ft",
              "in",
              "m/s",
              "cm/s",
              "kn",
              "knot",
              "knots"
            ]
          }
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_epoch_start_utc",
        "data_epoch_end_utc",
        "valid_from_utc",
        "valid_until_utc",
        "assessment_time_utc",
        "freshness_policy_id"
      ],
      "properties": {
        "data_epoch_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "data_epoch_end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "valid_from_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_until_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "assessment_time_utc": {
          "type": "string",
          "format": "date-time"
        },
        "freshness_policy_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncertainty_state",
        "uncertainty_ref",
        "quality_metadata_ref",
        "statement"
      ],
      "properties": {
        "uncertainty_state": {
          "enum": [
            "provided",
            "not_provided",
            "not_applicable_synthetic"
          ]
        },
        "uncertainty_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality_metadata_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "terms_sha256",
        "reviewed_at_utc"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "reviewed_permitted",
            "review_required",
            "not_applicable_synthetic"
          ]
        },
        "terms_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "transform_receipt_id",
        "input_crs",
        "output_crs",
        "input_vertical_reference",
        "output_vertical_reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source_native",
            "derived"
          ]
        },
        "transform_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_crs": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_crs": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_vertical_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_vertical_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_authorized",
        "physical_truth_claim_authorized",
        "independent_review_required"
      ],
      "properties": {
        "navigation_authorized": {
          "const": false
        },
        "physical_truth_claim_authorized": {
          "const": false
        },
        "independent_review_required": {
          "const": true
        }
      }
    },
    "receipt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "product": {
            "properties": {
              "code": {
                "const": "S-102"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "vertical_reference": {
                "type": "string",
                "minLength": 1
              },
              "measurement_units": {
                "items": {
                  "enum": [
                    "m",
                    "cm",
                    "mm",
                    "ft",
                    "in"
                  ]
                }
              }
            }
          },
          "quality": {
            "properties": {
              "uncertainty_state": {
                "const": "provided"
              },
              "uncertainty_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "properties": {
              "code": {
                "const": "S-104"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "vertical_reference": {
                "type": "string",
                "minLength": 1
              },
              "measurement_units": {
                "items": {
                  "enum": [
                    "m",
                    "cm",
                    "mm",
                    "ft",
                    "in"
                  ]
                }
              }
            }
          },
          "temporal": {
            "properties": {
              "valid_from_utc": {
                "type": "string",
                "format": "date-time"
              },
              "valid_until_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "product": {
            "properties": {
              "code": {
                "const": "S-111"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "properties": {
              "measurement_units": {
                "items": {
                  "enum": [
                    "m/s",
                    "cm/s",
                    "kn",
                    "knot",
                    "knots"
                  ]
                }
              }
            }
          },
          "temporal": {
            "properties": {
              "valid_from_utc": {
                "type": "string",
                "format": "date-time"
              },
              "valid_until_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "public_dataset"
          }
        }
      },
      "then": {
        "properties": {
          "terms": {
            "properties": {
              "review_status": {
                "const": "reviewed_permitted"
              },
              "terms_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reviewed_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transform": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "transform": {
            "properties": {
              "transform_receipt_id": {
                "type": "string",
                "minLength": 1
              },
              "input_crs": {
                "type": "string",
                "minLength": 1
              },
              "output_crs": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transform": {
            "properties": {
              "kind": {
                "const": "derived"
              }
            }
          },
          "product": {
            "properties": {
              "code": {
                "enum": [
                  "S-102",
                  "S-104"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "transform": {
            "properties": {
              "input_vertical_reference": {
                "type": "string",
                "minLength": 1
              },
              "output_vertical_reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transform": {
            "properties": {
              "kind": {
                "const": "source_native"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "transform": {
            "properties": {
              "transform_receipt_id": {
                "type": "null"
              },
              "input_crs": {
                "type": "null"
              },
              "output_crs": {
                "type": "null"
              },
              "input_vertical_reference": {
                "type": "null"
              },
              "output_vertical_reference": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
