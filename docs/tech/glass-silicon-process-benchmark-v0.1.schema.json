{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/glass-silicon-process-benchmark-v0.1.schema.json",
  "title": "Glass and Silicon Process Benchmark v0.1",
  "description": "Synthetic contract/fault corpus only. This schema does not validate physical process models or product claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "status",
    "claim_ceiling",
    "suite_invariants",
    "research_references",
    "cases",
    "artifact_admission"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "glass-silicon-process-benchmark-v0.1"
    },
    "status": {
      "const": "synthetic_contract_corpus"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 20
    },
    "suite_invariants": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "research_references": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "title",
          "url",
          "published_or_reviewed",
          "use",
          "limitation"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published_or_reviewed": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "use": {
            "type": "string",
            "minLength": 5
          },
          "limitation": {
            "type": "string",
            "minLength": 8
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "route",
          "case_type",
          "expected_disposition",
          "fault_class",
          "synthetic_only",
          "evidence_status",
          "required_evidence",
          "purpose",
          "claim_ceiling"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "route": {
            "enum": [
              "glass_container_reference",
              "silicon_mg_reference",
              "cross_route",
              "evidence_contract"
            ]
          },
          "case_type": {
            "enum": [
              "valid_control",
              "negative_control",
              "hold_control"
            ]
          },
          "expected_disposition": {
            "enum": [
              "accept_contract_only",
              "reject",
              "abstain"
            ]
          },
          "fault_class": {
            "oneOf": [
              {
                "enum": [
                  "artifact_manifest_unpinned",
                  "evidence_class_laundering",
                  "hidden_quality_regression",
                  "incompatible_functional_unit",
                  "incomplete_or_failed_balance",
                  "invalid_quantity_or_unit",
                  "mismatched_process_boundary",
                  "missing_provenance",
                  "out_of_domain_acceptance",
                  "planned_pilot_treated_as_demonstrated",
                  "scenario_fragility_hidden",
                  "single_property_optimization_bypasses_constraints",
                  "stale_or_unlicensed_source",
                  "train_test_leakage",
                  "uncalibrated_model_bias_hidden",
                  "unknown_as_zero",
                  "unsupported_product_grade",
                  "unverified_coproduct_credit"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "synthetic_only": {
            "const": true
          },
          "evidence_status": {
            "const": "synthetic_test"
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "purpose": {
            "type": "string",
            "minLength": 10
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 10
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "case_type": {
                  "const": "valid_control"
                }
              },
              "required": [
                "case_type"
              ]
            },
            "then": {
              "properties": {
                "expected_disposition": {
                  "const": "accept_contract_only"
                },
                "fault_class": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "case_type": {
                  "const": "negative_control"
                }
              },
              "required": [
                "case_type"
              ]
            },
            "then": {
              "properties": {
                "expected_disposition": {
                  "const": "reject"
                },
                "fault_class": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "case_type": {
                  "const": "hold_control"
                }
              },
              "required": [
                "case_type"
              ]
            },
            "then": {
              "properties": {
                "expected_disposition": {
                  "const": "abstain"
                },
                "fault_class": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "artifact_admission": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "source_ref",
          "record_version",
          "published_on",
          "record_status",
          "rights_status",
          "sha256_status",
          "benchmark_admission_status",
          "claim_ceiling",
          "files"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "source_ref": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "record_version": {
            "type": "string",
            "minLength": 1
          },
          "published_on": {
            "type": "string",
            "format": "date"
          },
          "record_status": {
            "enum": [
              "publicly_listed_not_downloaded",
              "downloaded_pending_hash",
              "downloaded_hashed"
            ]
          },
          "rights_status": {
            "enum": [
              "unresolved",
              "resolved",
              "not_applicable"
            ]
          },
          "sha256_status": {
            "enum": [
              "pending",
              "complete",
              "not_applicable"
            ]
          },
          "benchmark_admission_status": {
            "enum": [
              "blocked",
              "admitted",
              "literature_only"
            ]
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 20
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "filename",
                "size_display",
                "published_checksum_algorithm",
                "published_checksum",
                "sha256"
              ],
              "properties": {
                "filename": {
                  "type": "string",
                  "minLength": 1
                },
                "size_display": {
                  "type": "string",
                  "minLength": 1
                },
                "published_checksum_algorithm": {
                  "const": "MD5"
                },
                "published_checksum": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                },
                "sha256": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "benchmark_admission_status": {
                  "const": "admitted"
                }
              },
              "required": [
                "benchmark_admission_status"
              ]
            },
            "then": {
              "properties": {
                "record_status": {
                  "const": "downloaded_hashed"
                },
                "rights_status": {
                  "const": "resolved"
                },
                "sha256_status": {
                  "const": "complete"
                },
                "files": {
                  "items": {
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
