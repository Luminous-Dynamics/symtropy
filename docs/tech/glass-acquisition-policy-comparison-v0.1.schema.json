{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glass–Silicon Acquisition Policy Comparison Input v0.1",
  "description": "Synthetic finite-pool input for comparing random, uncertainty, novelty, and cost-aware selection under the same budget. Passing this schema does not validate policy effectiveness or industrial outcomes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "utility_unit",
    "cost_unit",
    "max_measurement_cost",
    "max_duration_seconds",
    "producer_access",
    "scenarios",
    "actions",
    "constraint_controls",
    "measurements",
    "acquisition_policy_comparison"
  ],
  "properties": {
    "benchmark_id": {"const": "glass-silicon-decision-value-synthetic-v0.1"},
    "evidence_class": {"const": "synthetic"},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "utility_unit": {"type": "string", "minLength": 1},
    "cost_unit": {"type": "string", "minLength": 1},
    "max_measurement_cost": {"type": "number", "minimum": 0},
    "max_duration_seconds": {"type": "number", "minimum": 0},
    "producer_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ground_truth", "unobserved_utilities", "oracle_scores", "future_outcomes"],
      "properties": {
        "ground_truth": {"const": false},
        "unobserved_utilities": {"const": false},
        "oracle_scores": {"const": false},
        "future_outcomes": {"const": false}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}}
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "utility_by_scenario", "feasible_by_scenario"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "utility_by_scenario": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
          "feasible_by_scenario": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}}
        }
      }
    },
    "constraint_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action_id", "scenario_id", "must_be_feasible"],
        "properties": {
          "action_id": {"type": "string"},
          "scenario_id": {"type": "string"},
          "must_be_feasible": {"type": "boolean"}
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "cost_units", "duration_seconds", "observation_by_scenario", "selection_features"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "cost_units": {"type": "number", "exclusiveMinimum": 0},
          "duration_seconds": {"type": "number", "minimum": 0},
          "observation_by_scenario": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
          "selection_features": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uncalibrated_uncertainty", "calibrated_uncertainty", "novelty", "estimated_voi"],
            "properties": {
              "uncalibrated_uncertainty": {"type": "number", "minimum": 0},
              "calibrated_uncertainty": {"type": "number", "minimum": 0},
              "novelty": {"type": "number", "minimum": 0},
              "estimated_voi": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "acquisition_policy_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "random_seeds"],
      "properties": {
        "protocol_version": {"const": 1},
        "random_seeds": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
