{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glass–Silicon Registered Search Space v0.1",
  "description": "Immutable parent search-space contract for synthetic adaptive-space audits. Hard constraints are fixed for the lifetime of a space revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "space_id", "evidence_class", "claim_ceiling", "allowed_domains", "hard_constraints", "candidate_families"],
  "properties": {
    "schema_version": {"const": 1},
    "space_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "evidence_class": {"const": "synthetic"},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "allowed_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "hard_constraints": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "definition"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "definition": {"type": "string", "minLength": 1}}
      }
    },
    "candidate_families": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "domain", "description"],
        "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}, "domain": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}
      }
    }
  }
}
