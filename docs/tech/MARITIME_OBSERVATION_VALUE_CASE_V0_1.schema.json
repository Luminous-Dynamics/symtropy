{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_OBSERVATION_VALUE_CASE_V0_1.schema.json",
  "title": "Maritime passive observation value case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "evidence_class",
    "hypotheses",
    "decisions",
    "existing_evidence_dependency_groups",
    "candidates",
    "authority_boundary",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "prior_probability"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "prior_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "losses"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "losses": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": false,
            "patternProperties": {
              "^[A-Z0-9_-]+$": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "existing_evidence_dependency_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "observation_kind",
          "evidence_role",
          "read_only",
          "already_available",
          "availability_state",
          "measurement_quality_state",
          "sensor_calibration_state",
          "timebase_id",
          "timebase_qualification_state",
          "timebase_qualification_sha256",
          "dependency_groups",
          "likelihood_model_qualification_state",
          "likelihood_model_sha256",
          "acquisition_cost",
          "outcomes",
          "likelihood_scenarios"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "observation_kind": {
            "enum": [
              "EXISTING_CHANNEL_REVIEW",
              "ARCHIVED_SIGNAL_RETRIEVAL",
              "CALIBRATION_RECORD_REVIEW",
              "HUMAN_EXPERT_REVIEW"
            ]
          },
          "evidence_role": {
            "enum": [
              "MEASURED_EXISTING_RECORD",
              "CALIBRATION_RECORD",
              "DERIVED",
              "SIMULATED",
              "RECONSTRUCTED"
            ]
          },
          "read_only": {
            "const": true
          },
          "already_available": {
            "const": true
          },
          "availability_state": {
            "enum": [
              "AVAILABLE",
              "MISSING",
              "STALE",
              "UNKNOWN"
            ]
          },
          "measurement_quality_state": {
            "enum": [
              "CURRENT",
              "STALE",
              "REJECTED",
              "CONFLICTED",
              "UNKNOWN"
            ]
          },
          "sensor_calibration_state": {
            "enum": [
              "CURRENT",
              "NOT_APPLICABLE",
              "EXPIRED",
              "UNKNOWN"
            ]
          },
          "timebase_id": {
            "type": "string",
            "minLength": 1
          },
          "timebase_qualification_state": {
            "enum": [
              "QUALIFIED",
              "UNQUALIFIED",
              "UNKNOWN"
            ]
          },
          "timebase_qualification_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dependency_groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "likelihood_model_qualification_state": {
            "enum": [
              "QUALIFIED",
              "UNQUALIFIED",
              "UNKNOWN"
            ]
          },
          "likelihood_model_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "acquisition_cost": {
            "type": "number",
            "minimum": 0
          },
          "outcomes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome_id",
                "likelihoods"
              ],
              "properties": {
                "outcome_id": {
                  "type": "string",
                  "minLength": 1
                },
                "likelihoods": {
                  "type": "object",
                  "minProperties": 2,
                  "additionalProperties": false,
                  "patternProperties": {
                    "^[A-Z0-9_-]+$": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          },
          "likelihood_scenarios": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario_id",
                "likelihood_model_sha256",
                "qualification_state",
                "outcomes"
              ],
              "properties": {
                "scenario_id": {
                  "type": "string",
                  "minLength": 1
                },
                "likelihood_model_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "qualification_state": {
                  "enum": [
                    "QUALIFIED",
                    "UNQUALIFIED",
                    "UNKNOWN"
                  ]
                },
                "outcomes": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "outcome_id",
                      "likelihoods"
                    ],
                    "properties": {
                      "outcome_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "likelihoods": {
                        "type": "object",
                        "minProperties": 2,
                        "additionalProperties": false,
                        "patternProperties": {
                          "^[A-Z0-9_-]+$": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "new_measurement_initiated",
        "controller_write",
        "actuation",
        "maintenance_authorization",
        "mode_transition",
        "restriction_clearance"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "new_measurement_initiated": {
          "const": false
        },
        "controller_write": {
          "const": false
        },
        "actuation": {
          "const": false
        },
        "maintenance_authorization": {
          "const": false
        },
        "mode_transition": {
          "const": false
        },
        "restriction_clearance": {
          "const": false
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 80
    }
  }
}
