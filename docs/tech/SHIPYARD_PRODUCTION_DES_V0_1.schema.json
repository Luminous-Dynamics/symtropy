{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic shipyard production DES input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "resources",
    "tasks",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SHIPYARD-PRODUCTION-DES-001"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "claim_ceiling": {
      "const": "DETERMINISTIC_SYMBOLIC_RESOURCE_SCHEDULE_ONLY"
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "capacity"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "quantity"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "duration_ticks",
        "priority",
        "demands"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        },
        "demands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/demand"
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_id",
        "successor_id",
        "minimum_lag_ticks"
      ],
      "properties": {
        "predecessor_id": {
          "type": "string",
          "minLength": 1
        },
        "successor_id": {
          "type": "string",
          "minLength": 1
        },
        "minimum_lag_ticks": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}