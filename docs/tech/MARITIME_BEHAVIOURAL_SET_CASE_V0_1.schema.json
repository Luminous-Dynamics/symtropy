{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_BEHAVIOURAL_SET_CASE_V0_1.schema.json",
  "title": "Maritime bounded behavioural-set diagnosis corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "evidence_class",
    "cases",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 80
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outer_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_state",
        "certificate_kind",
        "certificate_sha256"
      ],
      "properties": {
        "certificate_state": {
          "enum": [
            "CERTIFIED",
            "UNVERIFIED"
          ]
        },
        "certificate_kind": {
          "const": "SYNTHETIC_KNOWN_TRUTH"
        },
        "certificate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inner_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_state",
        "certificate_kind",
        "certificate_sha256"
      ],
      "properties": {
        "certificate_state": {
          "enum": [
            "VERIFIED",
            "UNVERIFIED"
          ]
        },
        "certificate_kind": {
          "const": "SYNTHETIC_KNOWN_TRUTH"
        },
        "certificate_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "box_id",
        "lower",
        "upper"
      ],
      "properties": {
        "box_id": {
          "type": "string",
          "minLength": 1
        },
        "lower": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        },
        "upper": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "inner_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id",
        "lower",
        "upper",
        "certificate"
      ],
      "properties": {
        "region_id": {
          "type": "string",
          "minLength": 1
        },
        "lower": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        },
        "upper": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "items": {
            "type": "number"
          }
        },
        "certificate": {
          "$ref": "#/$defs/inner_certificate"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fault_id",
        "configuration_sha256",
        "regime_id",
        "model_sha256",
        "solver_sha256",
        "outer_set_certificate",
        "outer_boxes",
        "inner_regions"
      ],
      "properties": {
        "fault_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "regime_id": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "solver_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outer_set_certificate": {
          "$ref": "#/$defs/outer_certificate"
        },
        "outer_boxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/box"
          }
        },
        "inner_regions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/inner_region"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "schema_version",
        "evidence_class",
        "asset",
        "operating_domain",
        "trajectory",
        "output_dimensions",
        "fault_a",
        "fault_b",
        "expected_disposition",
        "authority_boundary",
        "claim_ceiling"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": "0.1.0"
        },
        "evidence_class": {
          "const": "SYNTHETIC_KNOWN_TRUTH"
        },
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asset_id",
            "configuration_revision",
            "configuration_sha256"
          ],
          "properties": {
            "asset_id": {
              "type": "string",
              "minLength": 1
            },
            "configuration_revision": {
              "type": "string",
              "minLength": 1
            },
            "configuration_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "operating_domain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "regime_id",
            "qualification_state"
          ],
          "properties": {
            "regime_id": {
              "type": "string",
              "minLength": 1
            },
            "qualification_state": {
              "enum": [
                "QUALIFIED",
                "UNSUPPORTED",
                "NOT_EVALUATED"
              ]
            }
          }
        },
        "trajectory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_trajectory_sha256",
            "uncertainty_set_sha256",
            "time_grid_ms"
          ],
          "properties": {
            "input_trajectory_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "uncertainty_set_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "time_grid_ms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4096,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "output_dimensions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fault_a": {
          "$ref": "#/$defs/hypothesis"
        },
        "fault_b": {
          "$ref": "#/$defs/hypothesis"
        },
        "expected_disposition": {
          "enum": [
            "SEPARATION_PROVEN",
            "INTERSECTION_WITNESS_FOUND",
            "NOT_PROVEN_SEPARABLE",
            "NOT_EVALUATED",
            "INVALID_CONTRACT"
          ]
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_only",
            "controller_write",
            "actuation",
            "maintenance_authorization",
            "mode_transition",
            "restriction_clearance"
          ],
          "properties": {
            "read_only": {
              "const": true
            },
            "controller_write": {
              "const": false
            },
            "actuation": {
              "const": false
            },
            "maintenance_authorization": {
              "const": false
            },
            "mode_transition": {
              "const": false
            },
            "restriction_clearance": {
              "const": false
            }
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 80
        }
      }
    }
  }
}
