{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic tandem-GMAW EDE integration contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "claim_ceiling",
    "workpiece_id",
    "pass_id",
    "start_time_ns",
    "end_time_ns",
    "maximum_sample_gap_ns",
    "weld_length_m",
    "density_kg_per_m3",
    "wire_diameter_m",
    "source_trace_sha256",
    "alignment_receipt_sha256",
    "leading_power",
    "trailing_power",
    "leading_wire_feed",
    "trailing_wire_feed",
    "uncertainty"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SHIPYARD-EDE-QUALITY-ADJUSTED-ENERGY-001"
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_EDE_CALCULATION_ONLY"
    },
    "workpiece_id": {
      "type": "string",
      "minLength": 1
    },
    "pass_id": {
      "type": "string",
      "minLength": 1
    },
    "start_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "end_time_ns": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_sample_gap_ns": {
      "type": "integer",
      "minimum": 1
    },
    "weld_length_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "density_kg_per_m3": {
      "type": "number",
      "minimum": 1000,
      "maximum": 30000
    },
    "wire_diameter_m": {
      "type": "number",
      "minimum": 0.0001,
      "maximum": 0.02
    },
    "source_trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "alignment_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "leading_power": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/power_sample"
      }
    },
    "trailing_power": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/power_sample"
      }
    },
    "leading_wire_feed": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/feed_sample"
      }
    },
    "trailing_wire_feed": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/feed_sample"
      }
    },
    "uncertainty": {
      "$ref": "#/$defs/uncertainty"
    }
  },
  "$defs": {
    "power_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_ns",
        "voltage_v",
        "current_a"
      ],
      "properties": {
        "timestamp_ns": {
          "type": "integer",
          "minimum": 0
        },
        "voltage_v": {
          "type": "number",
          "minimum": 0
        },
        "current_a": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "feed_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp_ns",
        "speed_m_per_s"
      ],
      "properties": {
        "timestamp_ns": {
          "type": "integer",
          "minimum": 0
        },
        "speed_m_per_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voltage",
        "current",
        "wire_feed",
        "density",
        "wire_diameter",
        "power_quadrature",
        "feed_quadrature",
        "clock_alignment"
      ],
      "properties": {
        "voltage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "current": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "wire_feed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "density": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "wire_diameter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "power_quadrature": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "feed_quadrature": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        },
        "clock_alignment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999999
        }
      }
    }
  }
}