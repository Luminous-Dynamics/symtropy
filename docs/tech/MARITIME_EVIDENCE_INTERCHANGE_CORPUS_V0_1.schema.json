{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/maritime-evidence-interchange-corpus-v0.1.json",
  "title": "Maritime Evidence Interchange Conformance Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "corpus_version",
    "claim_ceiling",
    "evaluation_time",
    "fixture_count",
    "fixtures"
  ],
  "properties": {
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_version": {
      "const": "0.1.0"
    },
    "claim_ceiling": {
      "const": "Synthetic conformance fixtures only; not physical diagnostic validation."
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time"
    },
    "fixture_count": {
      "type": "integer",
      "minimum": 1
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "expected_disposition",
        "expected_invariants",
        "record"
      ],
      "properties": {
        "fixture_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_disposition": {
          "enum": [
            "accept",
            "reject",
            "abstain"
          ]
        },
        "expected_invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "record": {
          "$ref": "#/$defs/record"
        },
        "companion_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      }
    },
    "record": {
      "$ref": "https://luminousdynamics.io/schemas/maritime-evidence-interchange-v0.1.json"
    }
  }
}
