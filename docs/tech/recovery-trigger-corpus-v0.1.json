    "coverage_boundary": "coverage_ratio >= minimum_coverage_ratio is sufficient",
    "deadline_boundary": "an active trigger is late when remaining_time_to_boundary_minutes < required_response_lead_time_minutes",
    "profile_change": "current_decision_regime_version different from trigger_profile.criteria_version forces reassessment before trigger evaluation",
    "trigger_authority": "review and re-evaluation only; no direct operation",
