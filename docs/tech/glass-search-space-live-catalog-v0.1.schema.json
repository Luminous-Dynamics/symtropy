{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glass–Silicon Live Policy Loop Catalog v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "budgets",
    "policy_contract",
    "candidate_families",
    "expansion_options"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "glass-space-expansion-live-loop-synthetic-v0-1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost_units",
        "max_duration_seconds"
      ],
      "properties": {
        "max_cost_units": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "policy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "classes",
        "thresholds",
        "note"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "classes": {
          "const": [
            "fixed_space",
            "gp_ei_fixed_space",
            "random_expansion",
            "rule_based_expansion",
            "prior_guided_expansion",
            "static_prior_expansion"
          ]
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "random_expansion",
            "rule_based_expansion",
            "prior_guided_expansion"
          ],
          "properties": {
            "random_expansion": {
              "type": "number"
            },
            "rule_based_expansion": {
              "type": "number"
            },
            "prior_guided_expansion": {
              "type": "number"
            }
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "initially_visible",
          "screen_priority",
          "predicted_feasible",
          "selector_scores",
          "failure_fallback_score",
          "features"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "initially_visible": {
            "type": "boolean"
          },
          "screen_priority": {
            "type": "number",
            "minimum": 0
          },
          "predicted_feasible": {
            "type": "boolean"
          },
          "selector_scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixed_space",
              "gp_ei_fixed_space",
              "random_expansion",
              "rule_based_expansion",
              "prior_guided_expansion",
              "static_prior_expansion"
            ],
            "properties": {
              "fixed_space": {
                "type": "number"
              },
              "random_expansion": {
                "type": "number"
              },
              "rule_based_expansion": {
                "type": "number"
              },
              "prior_guided_expansion": {
                "type": "number"
              },
              "static_prior_expansion": {
                "type": "number"
              },
              "gp_ei_fixed_space": {
                "type": "number"
              }
            }
          },
          "failure_fallback_score": {
            "type": "number"
          },
          "features": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "expansion_options": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "candidate_family_id",
          "proposal_sha256",
          "evidence_refs"
        ],
        "properties": {
          "method": {
            "enum": [
              "random",
              "rule_based",
              "prior_guided"
            ]
          },
          "candidate_family_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "proposal_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
