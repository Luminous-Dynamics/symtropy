{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/MARITIME_OBSERVABILITY_ADAPTER_CASE_V0_1.schema.json",
  "title": "Maritime observability adapter case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "generated_at",
    "evidence_class",
    "asset",
    "operating_domain",
    "evidence_digests",
    "layout_profile",
    "sensors",
    "states",
    "required_fault_pairs",
    "responses",
    "common_cause_scenarios",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "assessment_id": {
      "$ref": "#/$defs/ref"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC_CONFORMANCE_FIXTURE",
        "MEASURED"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_class",
        "vessel_id",
        "engine_id",
        "engine_model",
        "configuration_revision",
        "configuration_sha256"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/ref"
        },
        "asset_class": {
          "enum": [
            "main_engine",
            "auxiliary_engine",
            "generator",
            "propulsion_train",
            "cooling_system",
            "fuel_system",
            "electrical_system",
            "other"
          ]
        },
        "vessel_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine_model": {
          "$ref": "#/$defs/ref"
        },
        "configuration_revision": {
          "$ref": "#/$defs/ref"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "operating_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime_id",
        "description",
        "qualification_state",
        "transient_state",
        "measurement_timebase_id",
        "maximum_timestamp_uncertainty_ms"
      ],
      "properties": {
        "regime_id": {
          "$ref": "#/$defs/ref"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "qualification_state": {
          "enum": [
            "qualified",
            "unsupported",
            "not_evaluated"
          ]
        },
        "load_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "speed_rpm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "transient_state": {
          "enum": [
            "steady",
            "transient",
            "mixed",
            "unknown"
          ]
        },
        "measurement_timebase_id": {
          "$ref": "#/$defs/ref"
        },
        "maximum_timestamp_uncertainty_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_topology_sha256",
        "fault_model_sha256",
        "evaluator_sha256",
        "dataset_sha256",
        "split_manifest_sha256",
        "model_sha256"
      ],
      "properties": {
        "sensor_topology_sha256": {
          "type": "null"
        },
        "fault_model_sha256": {
          "type": "null"
        },
        "evaluator_sha256": {
          "type": "null"
        },
        "dataset_sha256": {
          "type": "null"
        },
        "split_manifest_sha256": {
          "type": "null"
        },
        "model_sha256": {
          "type": "null"
        }
      }
    },
    "layout_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_profile_ref",
        "state_taxonomy_ref",
        "required_pair_set_ref",
        "minimum_independent_principles_for_critical_pairs",
        "reference_state_id",
        "maximum_timestamp_uncertainty_ms",
        "minimum_common_window_overlap_ms"
      ],
      "properties": {
        "layout_profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "state_taxonomy_ref": {
          "$ref": "#/$defs/ref"
        },
        "required_pair_set_ref": {
          "$ref": "#/$defs/ref"
        },
        "minimum_independent_principles_for_critical_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "reference_state_id": {
          "$ref": "#/$defs/ref"
        },
        "maximum_timestamp_uncertainty_ms": {
          "type": "number",
          "minimum": 0
        },
        "minimum_common_window_overlap_ms": {
          "type": "number",
          "minimum": 1
        },
        "maximum_failure_atoms_for_exact_cut_analysis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maximum_failure_cut_order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        }
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "channel_id",
          "installed",
          "measurement_principle_ref",
          "measurand",
          "technique",
          "unit",
          "physical_location_ref",
          "calibration_ref",
          "calibration_state",
          "quality_state",
          "source_role",
          "dependency_groups",
          "derived_from_channel_ids",
          "source_artifact_ref",
          "clock_domain",
          "timebase_id",
          "timestamp_uncertainty_ms",
          "timestamp_uncertainty_source",
          "timebase_qualification_state",
          "timebase_qualification_artifact_id",
          "timebase_qualification_sha256",
          "dependency_review_state",
          "dependency_review_record_id",
          "dependency_review_record_sha256"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "minLength": 1
          },
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "installed": {
            "type": "boolean"
          },
          "measurement_principle_ref": {
            "$ref": "#/$defs/ref"
          },
          "measurand": {
            "type": "string",
            "minLength": 1
          },
          "technique": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "physical_location_ref": {
            "$ref": "#/$defs/ref"
          },
          "calibration_ref": {
            "$ref": "#/$defs/ref"
          },
          "calibration_state": {
            "enum": [
              "current",
              "expired",
              "unknown",
              "not_applicable"
            ]
          },
          "quality_state": {
            "enum": [
              "current",
              "missing",
              "stale",
              "rejected",
              "conflicted",
              "unknown"
            ]
          },
          "source_role": {
            "enum": [
              "measured",
              "derived",
              "reconstructed",
              "simulated",
              "synthetic"
            ]
          },
          "dependency_groups": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "derived_from_channel_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "source_artifact_ref": {
            "$ref": "#/$defs/ref"
          },
          "clock_domain": {
            "$ref": "#/$defs/ref"
          },
          "timebase_id": {
            "$ref": "#/$defs/ref"
          },
          "timestamp_uncertainty_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "timestamp_uncertainty_source": {
            "enum": [
              "measured_offset_bound",
              "instrument_specification",
              "vendor_specification",
              "estimated",
              "unknown",
              "synthetic_fixture"
            ]
          },
          "timebase_qualification_state": {
            "enum": [
              "qualified",
              "synthetic_conformance",
              "unqualified",
              "unknown"
            ]
          },
          "timebase_qualification_artifact_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "timebase_qualification_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "dependency_review_state": {
            "enum": [
              "synthetic_conformance",
              "independently_reviewed",
              "unreviewed",
              "unknown"
            ]
          },
          "dependency_review_record_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "dependency_review_record_sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "timebase_qualification_state": {
                  "enum": [
                    "qualified",
                    "synthetic_conformance"
                  ]
                }
              },
              "required": [
                "timebase_qualification_state"
              ]
            },
            "then": {
              "properties": {
                "timestamp_uncertainty_ms": {
                  "type": "number",
                  "minimum": 0
                },
                "timebase_qualification_artifact_id": {
                  "$ref": "#/$defs/ref"
                },
                "timebase_qualification_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "timebase_id",
                "timestamp_uncertainty_ms",
                "timebase_qualification_artifact_id",
                "timebase_qualification_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "dependency_review_state": {
                  "const": "synthetic_conformance"
                }
              },
              "required": [
                "dependency_review_state"
              ]
            },
            "then": {
              "properties": {
                "dependency_review_record_id": {
                  "type": "null"
                },
                "dependency_review_record_sha256": {
                  "type": "null"
                }
              },
              "required": [
                "dependency_review_record_id",
                "dependency_review_record_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "dependency_review_state": {
                  "const": "independently_reviewed"
                }
              },
              "required": [
                "dependency_review_state"
              ]
            },
            "then": {
              "properties": {
                "dependency_review_record_id": {
                  "$ref": "#/$defs/ref"
                },
                "dependency_review_record_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "dependency_review_record_id",
                "dependency_review_record_sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "dependency_review_state": {
                  "enum": [
                    "unreviewed",
                    "unknown"
                  ]
                }
              },
              "required": [
                "dependency_review_state"
              ]
            },
            "then": {
              "properties": {
                "dependency_review_record_id": {
                  "type": "null"
                },
                "dependency_review_record_sha256": {
                  "type": "null"
                }
              },
              "required": [
                "dependency_review_record_id",
                "dependency_review_record_sha256"
              ]
            }
          }
        ]
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state_id",
          "state_class",
          "faulted_sensor_ids"
        ],
        "properties": {
          "state_id": {
            "$ref": "#/$defs/ref"
          },
          "state_class": {
            "enum": [
              "PROCESS_STATE",
              "SENSOR_FAULT",
              "OUT_OF_DOMAIN"
            ]
          },
          "faulted_sensor_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      },
      "maxItems": 16
    },
    "required_fault_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "fault_a",
          "fault_b",
          "critical",
          "minimum_independent_principles"
        ],
        "properties": {
          "pair_id": {
            "$ref": "#/$defs/ref"
          },
          "fault_a": {
            "$ref": "#/$defs/ref"
          },
          "fault_b": {
            "$ref": "#/$defs/ref"
          },
          "critical": {
            "type": "boolean"
          },
          "minimum_independent_principles": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "response_id",
          "state_id",
          "channel_id",
          "availability",
          "value_lower",
          "value_upper",
          "unit",
          "evidence_role",
          "measurement_window_ref",
          "artifact_id",
          "source_sha256",
          "adjudication_ref",
          "window_start_ms",
          "window_end_ms"
        ],
        "properties": {
          "response_id": {
            "$ref": "#/$defs/ref"
          },
          "state_id": {
            "$ref": "#/$defs/ref"
          },
          "channel_id": {
            "$ref": "#/$defs/ref"
          },
          "availability": {
            "enum": [
              "VALID",
              "DEGRADED",
              "MISSING",
              "UNKNOWN"
            ]
          },
          "value_lower": {
            "type": [
              "number",
              "null"
            ]
          },
          "value_upper": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "evidence_role": {
            "enum": [
              "INDEPENDENT_MEASUREMENT",
              "SYNTHETIC_CONFORMANCE_FIXTURE",
              "MODEL_ESTIMATE",
              "OPERATOR_REPORTED"
            ]
          },
          "measurement_window_ref": {
            "$ref": "#/$defs/ref"
          },
          "artifact_id": {
            "$ref": "#/$defs/ref"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "adjudication_ref": {
            "$ref": "#/$defs/ref"
          },
          "window_start_ms": {
            "type": "number",
            "minimum": 0
          },
          "window_end_ms": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "common_cause_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "removed_sensor_ids",
          "removed_dependency_groups"
        ],
        "properties": {
          "scenario_id": {
            "$ref": "#/$defs/ref"
          },
          "removed_sensor_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          },
          "removed_dependency_groups": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 40
    }
  },
  "$defs": {
    "ref": {
      "$ref": "#/$defs/ref"
    }
  }
}
