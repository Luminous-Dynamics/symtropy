{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/maritime-sail-capability-impact-v0.1.json",
  "title": "Maritime sail capability change-impact cases v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "evidence_class",
    "as_of_utc",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "maritime-sail-capability-impact-v0.1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "as_of_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "changed_component_ids",
        "changed_dependency_ids",
        "expected_impacted_capability_ids",
        "expected_unaffected_capability_ids"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "changed_component_ids": {
          "$ref": "#/$defs/set"
        },
        "changed_dependency_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "sensor_topology",
              "calibration",
              "timebase",
              "source_payload",
              "diagnostic_model",
              "evaluator",
              "validation_profile"
            ]
          }
        },
        "expected_impacted_capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sail\\.[a-z0-9_]+$"
          }
        },
        "expected_unaffected_capability_ids": {
          "$ref": "#/$defs/set"
        }
      }
    }
  }
}
