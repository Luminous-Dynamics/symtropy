{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/tech/glass-selection-aware-qualification-task-v0.1.schema.json",
  "title": "Glass selection-aware qualification task v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "target_success_probability",
    "familywise_confidence_level",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "glass-selection-aware-qualification-synthetic-v0-1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "Synthetic Bonferroni-simultaneous binomial qualification mechanics only; no real-material, plant-yield, independence, or industrial-performance claim is validated."
    },
    "target_success_probability": {
      "const": 0.95
    },
    "familywise_confidence_level": {
      "const": 0.95
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
