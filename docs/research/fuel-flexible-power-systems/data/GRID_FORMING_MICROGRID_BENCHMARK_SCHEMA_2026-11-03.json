{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/grid-forming-microgrid-benchmarks-0.1.0.json",
  "title": "Grid-Forming and Microgrid Resilience Benchmark Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "accessed_at",
    "intended_use",
    "comparison_policy",
    "sources",
    "test_groups",
    "result_receipt_required",
    "non_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "research_test_matrix_not_certification"
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "comparison_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "test_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "result_receipt_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "uri",
        "evidence_class"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "evidence_class": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_id": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "doi": {
          "type": "string"
        },
        "board_approval_date": {
          "type": "string",
          "format": "date"
        }
      },
      "additionalProperties": true
    },
    "case": {
      "type": "object",
      "required": [
        "test_id",
        "name",
        "test_type",
        "measured_channels",
        "acceptance_threshold",
        "threshold_source_required"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "test_type": {
          "enum": [
            "HIL_or_physical",
            "HIL_then_physical",
            "physical_required_for_product_claim",
            "HIL_required"
          ]
        },
        "measured_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "acceptance_threshold": {
          "type": [
            "object",
            "number",
            "string",
            "null"
          ]
        },
        "threshold_source_required": {
          "const": true
        },
        "notes": {
          "type": "string"
        },
        "scan_method": {
          "type": "string"
        },
        "frequency_band_policy": {
          "type": "string"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_testbed": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "group": {
      "type": "object",
      "required": [
        "group_id",
        "name",
        "purpose",
        "source_ids",
        "cases"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
