  "reproducibility": {
    "recompute_chemical_input_energy": "sum_i(mass_flow_kg_per_s[i] * LHV_J_per_kg * (end_i - start_i))",
    "recompute_net_ac_energy": "sum_i(max(0, (mass_flow_i * LHV * engine_efficiency * generator_efficiency - auxiliary_power_i) * duration_i))",
    "recompute_common_service": "sum_i(min(required_i, reference_generated_i, candidate_generated_i))",
    "recompute_surplus": "sum_i(max(generated_i - required_i, 0))",
    "recompute_ffer": "(common_service / candidate_chemical_input_energy) / (common_service / reference_chemical_input_energy)",
    "caveat": "These formulas are for the explicit synthetic fixtures only. Real system models must also include fuel-batch evidence, calibration, measurement uncertainty, covariance, test boundary and topology-specific losses."
