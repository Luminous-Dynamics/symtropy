{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/well-to-service-0.1.0.json",
  "title": "Well-to-Service Energy Pathway Record",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "accessed_at",
    "intended_use",
    "claim_ceiling",
    "fixtures"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "synthetic_accounting_and_boundary_oracles"
    },
    "accessed_at": {
      "type": "string",
      "format": "date"
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "conventions": {
      "type": "object",
      "additionalProperties": true
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "functional_unit": {
      "type": "object",
      "required": [
        "quantity",
        "unit",
        "mission_or_profile_id"
      ],
      "properties": {
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "kWh_net_ac",
            "kWh_regulated_dc",
            "MJ_propulsion_work",
            "tonne_km",
            "tonne_nautical_mile",
            "critical_load_hour"
          ]
        },
        "mission_or_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "service_boundary": {
      "type": "object",
      "required": [
        "interface",
        "boundary_id",
        "specification_id"
      ],
      "properties": {
        "interface": {
          "enum": [
            "NetAc",
            "RegulatedDc",
            "PropulsionWork",
            "TransportWork",
            "CriticalLoadService"
          ]
        },
        "boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "specification_id": {
          "type": "string",
          "minLength": 1
        },
        "voltage_or_mechanical_point": {
          "type": [
            "string",
            "null"
          ]
        },
        "included_auxiliaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_auxiliaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "node_id",
        "carrier_type",
        "energy_quantity",
        "energy_unit",
        "basis",
        "geography",
        "period"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "carrier_type": {
          "enum": [
            "primary_feedstock",
            "electricity",
            "heat",
            "fuel",
            "hydrogen",
            "ammonia",
            "methanol",
            "natural_gas",
            "liquid_fuel",
            "gaseous_fuel",
            "stored_electricity",
            "net_ac",
            "regulated_dc",
            "propulsion_work",
            "transport_service",
            "co_product",
            "emissions",
            "net_ac",
            "regulated_dc",
            "propulsion_work",
            "transport_service"
          ]
        },
        "energy_quantity": {
          "type": "number",
          "minimum": 0
        },
        "energy_unit": {
          "enum": [
            "J",
            "MJ",
            "kWh",
            "MWh",
            "kg",
            "tonne",
            "m3",
            "tonne_km",
            "tonne_nautical_mile"
          ]
        },
        "basis": {
          "enum": [
            "LHV",
            "HHV",
            "metered_electricity",
            "stored_energy",
            "primary_energy",
            "useful_service",
            "mass",
            "volume",
            "emissions_mass",
            "not_applicable"
          ]
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "gwp_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "transformation": {
      "type": "object",
      "required": [
        "transformation_id",
        "technology",
        "input_node_ids",
        "output_node_ids",
        "energy_loss_quantity",
        "energy_loss_unit",
        "method_id",
        "geography",
        "period",
        "evidence_ids",
        "uncertainty_status",
        "allocation_method"
      ],
      "properties": {
        "transformation_id": {
          "type": "string",
          "minLength": 1
        },
        "technology": {
          "type": "string",
          "minLength": 1
        },
        "input_node_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "output_node_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "energy_loss_quantity": {
          "type": "number",
          "minimum": 0
        },
        "energy_loss_unit": {
          "enum": [
            "J",
            "MJ",
            "kWh",
            "MWh"
          ]
        },
        "process_emissions_kgco2e": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "emissions_factor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "uncertainty_status": {
          "enum": [
            "measured",
            "reported",
            "modelled",
            "unknown"
          ]
        },
        "allocation_method": {
          "enum": [
            "none",
            "energy",
            "mass",
            "economic",
            "system_expansion",
            "other"
          ]
        },
        "allocation_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "object",
      "required": [
        "well_to_tank_included",
        "tank_to_wake_included",
        "well_to_wake_included",
        "equipment_lifecycle_included",
        "grid_loss_treatment"
      ],
      "properties": {
        "well_to_tank_included": {
          "type": "boolean"
        },
        "tank_to_wake_included": {
          "type": "boolean"
        },
        "well_to_wake_included": {
          "type": "boolean"
        },
        "equipment_lifecycle_included": {
          "type": "boolean"
        },
        "grid_loss_treatment": {
          "enum": [
            "not_applicable",
            "included_in_factor",
            "separate_scope_3_factors",
            "excluded",
            "unknown"
          ]
        },
        "double_count_protection_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "evidence_class",
        "source_uri",
        "publisher",
        "retrieved_at",
        "claim_scope"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "physical_measurement",
            "third_party_test",
            "supplier_certificate",
            "official_government_factor",
            "published_literature",
            "validated_solver_output",
            "model_prediction",
            "analyst_scenario",
            "default_factor"
          ]
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "geography": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "gwp_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1
        },
        "document_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": [
        "energy_unit",
        "ghg_unit",
        "cost_unit",
        "energy_unit",
        "ghg_unit",
        "cost_unit",
        "converter_input_energy",
        "primary_energy",
        "well_to_tank_ghg",
        "tank_to_wake_ghg",
        "well_to_wake_ghg",
        "service_energy",
        "well_to_service_energy_intensity",
        "well_to_service_ghg_intensity",
        "lifecycle_cost",
        "uncertainty_status"
      ],
      "properties": {
        "converter_input_energy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "primary_energy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "well_to_tank_ghg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "tank_to_wake_ghg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "well_to_wake_ghg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "service_energy": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "well_to_service_energy_intensity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "well_to_service_ghg_intensity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lifecycle_cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "uncertainty_status": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "energy_unit": {
          "type": "string",
          "minLength": 1
        },
        "ghg_unit": {
          "type": "string",
          "minLength": 1
        },
        "cost_unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "fixture": {
      "type": "object",
      "required": [
        "record_id",
        "status",
        "functional_unit",
        "service_boundary",
        "pathway_nodes",
        "transformations",
        "accounting_boundaries",
        "evidence_register",
        "result_vector",
        "expected_result",
        "oracle"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "synthetic_fixture"
        },
        "functional_unit": {
          "$ref": "#/$defs/functional_unit"
        },
        "service_boundary": {
          "$ref": "#/$defs/service_boundary"
        },
        "pathway_nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "transformations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "accounting_boundaries": {
          "$ref": "#/$defs/boundaries"
        },
        "evidence_register": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "result_vector": {
          "$ref": "#/$defs/results"
        },
        "expected_result": {
          "enum": [
            "pass",
            "reject"
          ]
        },
        "oracle": {
          "type": "object",
          "required": [
            "interpretation"
          ],
          "properties": {
            "interpretation": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
