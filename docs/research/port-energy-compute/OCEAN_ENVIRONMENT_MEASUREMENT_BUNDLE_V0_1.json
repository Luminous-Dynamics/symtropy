  "fixture_id": "OCEAN-ENV-METROLOGY-SYNTH-001",
  "as_of": "2026-11-20",
  "synthetic_only": true,
  "claim_ceiling": "Synthetic paired sensor/laboratory measurements for software verification only. Not a field observation, permit result, ecological threshold, site clearance or environmental compliance finding.",
  "standards_context": {
    "uncertainty_method": "JCGM GUM first-order linearized uncertainty propagation",
    "uncertainty_method_reference": "https://www.bipm.org/en/committees/jc/jcgm/publications",
    "nonlinear_model_policy": "Use a validated nonlinear measurement model and distribution propagation (e.g. JCGM 101 Monte Carlo) where first-order linearization is not adequate; this v0.1 fixture only exercises an explicitly declared locally-linear model.",
    "water_sampling_reference": "ISO 5667-10:2026, representative sampling of urban/industrial wastewater including cooling water",
    "water_sampling_url": "https://www.iso.org/standard/86841.html",
    "observation_interoperability": "OGC SensorThings API 2.0 / Part 1 Sensing 1.1 compatible mapping",
    "observation_interoperability_url": "https://www.ogc.org/standards/sensorthings/"
  },
  "station_roles": [
    "intake",
    "outfall",
    "near_field_plume",
    "far_field_impact",
    "independent_reference_control"
  ],
  "pairing_contract": {
    "timestamp_format": "YYYY-MM-DDTHH:MM:SSZ",
    "required_time_sync_state": "synchronized",
    "maximum_clock_offset_ms": 250,
    "pair_rule": "Every flow, thermal and concentration observation in an interval must use the exact same interval_id, interval_start_utc and interval_end_utc; clock offset must not exceed the declared limit.",
    "water_balance_screen": {
      "method": "absolute outfall-minus-intake flow residual divided by combined standard uncertainty",
      "maximum_absolute_z_score": 2,
      "purpose": "instrument/boundary consistency screen only; not a discharge permit or ecological threshold"
    }
  },
  "equation_contract": {
    "thermal_power_kw": "rho_kg_m3 * cp_j_kg_k * outfall_flow_m3_s * (outfall_temperature_c - intake_temperature_c) / 1000",
    "temperature_difference_standard_uncertainty_c": "sqrt(u_outfall_temperature_c^2 + u_intake_temperature_c^2)",
    "thermal_power_standard_uncertainty_kw": "first-order partial-derivative propagation for independent rho, cp, flow and delta-temperature inputs",
    "pollutant_mass_flux_g_s": "concentration_mg_l * flow_m3_s",
    "pollutant_mass_flux_kg_day": "pollutant_mass_flux_g_s * 86.4",
    "net_pollutant_mass_flux_g_s": "outfall_concentration_mg_l * outfall_flow_m3_s - intake_concentration_mg_l * intake_flow_m3_s",
    "net_pollutant_mass_flux_standard_uncertainty_g_s": "root-sum-square of independently propagated intake and outfall concentration/flow uncertainties",
    "covariance_assumption": "Inputs are treated as independent for this synthetic fixture. Any shared calibration, common reference or correlated errors require covariance terms or Monte Carlo propagation; independence must not be assumed silently."
  },
  "ogc_sensorthings_mapping": {
    "standard": "OGC SensorThings API Part 1: Sensing 1.1",
    "entity_mapping": {
      "station_or_platform": "Thing",
      "station_location": "Location",
      "sensor_and_calibration_identity": "Sensor",
      "measured_property": "ObservedProperty",
      "sensor_and_property_series": "Datastream",
      "individual_measurement": "Observation",
      "intake_outfall_or_reference_station": "FeatureOfInterest"
    },
    "data_model_policy": "The fixture stores a local normalized representation; it is not yet a SensorThings API payload. Preserve units, resultTime/phenomenonTime, Datastream identity, FeatureOfInterest and sensor metadata during adapter implementation."
  },
