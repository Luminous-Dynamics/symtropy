{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.luminousdynamics.org/civbench/HIST_001_AMS_TABLE1_TRANSCRIPTION_V0_1.schema.json",
  "title": "HIST-001 published AMS Table 1 transcription",
  "description": "Typed transcription of the 15 Table 1 rows in Huffman and Woodborne (2021). This is not raw laboratory data or calibrated probability distributions.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "case_id",
    "artifact_id",
    "status",
    "source",
    "method",
    "field_semantics",
    "record_count",
    "records",
    "limitations",
    "next_steps"
  ],
  "properties": {
    "schema": {
      "const": "https://schemas.luminousdynamics.org/civbench/HIST_001_AMS_TABLE1_TRANSCRIPTION/0.1"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "const": "HIST-001"
    },
    "artifact_id": {
      "const": "HIST001-DERIVED-AMS-TABLE1"
    },
    "status": {
      "enum": [
        "transcribed_not_independently_reviewed",
        "independently_reviewed",
        "reproduced_from_source"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "citation",
        "pdf_uri",
        "html_uri",
        "locator",
        "retrieved_at",
        "license",
        "source_pdf_sha256",
        "table_image_uri",
        "table_image_sha256"
      ],
      "properties": {
        "source_id": {
          "const": "HIST001-SRC-AMS-2021"
        },
        "citation": {
          "type": "string",
          "minLength": 1
        },
        "pdf_uri": {
          "type": "string",
          "format": "uri"
        },
        "html_uri": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_pdf_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "table_image_uri": {
          "type": "string",
          "format": "uri"
        },
        "table_image_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "radiocarbon_calibration_software",
        "calibration_curve",
        "reported_interval",
        "authors_note",
        "crossed_out_intervals"
      ],
      "properties": {
        "radiocarbon_calibration_software": {
          "type": "string"
        },
        "calibration_curve": {
          "type": "string"
        },
        "reported_interval": {
          "type": "string"
        },
        "authors_note": {
          "type": "string"
        },
        "crossed_out_intervals": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "field_semantics": {
      "type": "object",
      "required": [
        "bp_age",
        "bp_sigma",
        "delta_13c_permil",
        "calibrated_ranges",
        "means_cal_ad"
      ],
      "properties": {
        "bp_age": {
          "type": "string"
        },
        "bp_sigma": {
          "type": "string"
        },
        "delta_13c_permil": {
          "type": "string"
        },
        "calibrated_ranges": {
          "type": "string"
        },
        "means_cal_ad": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "record_count": {
      "const": 15
    },
    "records": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "record_id",
          "facies",
          "site_label_as_printed",
          "laboratory_identifier",
          "material",
          "delta_13c_permil",
          "radiocarbon_age_bp",
          "radiocarbon_sigma_years",
          "calibrated_ranges_shcal20_1sigma",
          "reported_means_cal_ad"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^HIST001-AMS-T1-[0-9]{2}$"
          },
          "facies": {
            "enum": [
              "Mapungubwe",
              "Transitional K2",
              "K2",
              "Leokwe"
            ]
          },
          "site_label_as_printed": {
            "type": "string",
            "minLength": 1
          },
          "laboratory_identifier": {
            "type": "string",
            "pattern": "^IT-C-[0-9]+$"
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "delta_13c_permil": {
            "type": "number"
          },
          "radiocarbon_age_bp": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radiocarbon_sigma_years": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "calibrated_ranges_shcal20_1sigma": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "start_ad",
                "end_ad",
                "status"
              ],
              "properties": {
                "start_ad": {
                  "type": "integer"
                },
                "end_ad": {
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "retained",
                    "crossed_out"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "start_ad": {
                        "type": "integer"
                      },
                      "end_ad": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "start_ad",
                      "end_ad"
                    ]
                  },
                  "then": {
                    "properties": {
                      "end_ad": {
                        "exclusiveMinimum": 0
                      }
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "reported_means_cal_ad": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
