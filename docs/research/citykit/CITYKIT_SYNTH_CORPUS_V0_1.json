{
  "schema_id": "org.luminousdynamics.citykit.synthetic-corpus",
  "schema_version": "0.1.0",
  "corpus_id": "CITYKIT-SYNTH-CORPUS-V0.1",
  "classification": "synthetic_fixture_only",
  "units_policy": "Every numeric quantity is synthetic and local to its declared unit; no value is a vendor, site, city, engineering, cost, carbon, or field-performance claim.",
  "semantics": {
    "route_logic": "Each route.requires list is conjunctive (AND); routes listed for one capability are alternatives (OR). A required ID may resolve to a primitive or another declared capability.",
    "capability_origins": [
      "local",
      "imported"
    ],
    "availability_states": [
      "available",
      "unavailable"
    ],
    "evidence_states": [
      "synthetic_current",
      "unknown",
      "stale",
      "revoked"
    ],
    "disposition_rules": [
      "Any verified hard constraint violation yields Infeasible.",
      "Otherwise, a requested operation outside the evaluator's declared model yields Unsupported.",
      "Otherwise, missing, stale, revoked or ambiguous required evidence yields Unknown.",
      "Otherwise, the case may be FeasibleForSyntheticCase within the declared fixture scope only."
    ],
    "time_intervals": "Work package intervals are half-open [start_tick,end_tick); overlapping demands on a shared resource are summed.",
    "resource_balance": "available must be >= allocated + reserve; every amount must use the resource.unit. Optional allocated_unit/reserve_unit fields, when present, must match resource.unit.",
    "service_capacity": "declared_capacity must be >= peak_demand; all values use service.unit and non-current evidence cannot establish this claim.",
    "productive_closure": "An imported primitive may support operational reachability, but never local closure. A primitive marked unavailable cannot satisfy a route. Cycles without a reachable primitive seed cannot establish capability."
  },
