{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/bioprocess/bioprocess-closure-corpus-schema-v1.json",
  "title": "Synthetic engineered-protein process closure corpus",
  "type": "object",
  "required": [
    "corpus_id",
    "schema_version",
    "status",
    "created_at",
    "disclaimer",
    "case_schema_file",
    "unit_contract",
    "case_count",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "corpus_id": {
      "const": "BIOPROC-CLOSURE-CORPUS-V1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "synthetic_design_fixture_only"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    },
    "case_schema_file": {
      "const": "bioprocess-closure-case-schema-v1.json"
    },
    "unit_contract": {
      "type": "object",
      "required": [
        "mass",
        "water",
        "energy",
        "time"
      ],
      "additionalProperties": false,
      "properties": {
        "mass": {
          "const": "g"
        },
        "water": {
          "const": "mL"
        },
        "energy": {
          "const": "Wh"
        },
        "time": {
          "const": "s"
        }
      }
    },
    "case_count": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "bioprocess-closure-case-schema-v1.json"
      }
    }
  }
}
