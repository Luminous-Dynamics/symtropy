{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Johannesburg Water Service Cascade T0 Oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "oracle_independence",
    "evidence_class",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "JW-WATER-CASCADE-T0"
    },
    "oracle_independence": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "synthetic_only"
    },
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^C[0-9]{2}_"
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "disposition",
              "reported_status_vector",
              "reported_episode_count",
              "no_board_days_between_severe_reports",
              "censoring",
              "duration_hours_lower_bound",
              "asset_join",
              "temporal_join",
              "dependency_conclusion",
              "point_of_use_conclusion",
              "claim_result",
              "claim_ceiling",
              "notice_delay_lower_bound_hours",
              "notice_delay_upper_bound_hours"
            ],
            "properties": {
              "disposition": {
                "type": "string",
                "minLength": 1
              },
              "reported_status_vector": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reported_episode_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "no_board_days_between_severe_reports": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "censoring": {
                "enum": [
                  "NOT_APPLICABLE",
                  "NOT_CENSORED",
                  "RIGHT_CENSORED"
                ]
              },
              "duration_hours_lower_bound": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "asset_join": {
                "type": "string"
              },
              "temporal_join": {
                "type": "string"
              },
              "dependency_conclusion": {
                "type": "string"
              },
              "point_of_use_conclusion": {
                "type": "string"
              },
              "claim_result": {
                "enum": [
                  "RETAIN_SYNTHETIC_CEILING",
                  "REJECT_FIELD_CLAIM"
                ]
              },
              "claim_ceiling": {
                "const": "synthetic_contract_only"
              },
              "notice_delay_lower_bound_hours": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "notice_delay_upper_bound_hours": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
