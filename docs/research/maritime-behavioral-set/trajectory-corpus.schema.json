{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/maritime-behavioral-set/trajectory-corpus.schema.json",
  "title": "Uncertainty-bounded behavioral-set diagnosability corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "evidence_class",
    "cases",
    "authority_boundary",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "configuration_id",
          "operating_profile_id",
          "timebase",
          "maximum_timestamp_uncertainty_ms",
          "hypotheses",
          "required_pairs"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "configuration_id": {
            "type": "string",
            "minLength": 1
          },
          "operating_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "timebase": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timebase_id",
              "qualification_state",
              "qualification_sha256"
            ],
            "properties": {
              "timebase_id": {
                "type": "string",
                "minLength": 1
              },
              "qualification_state": {
                "enum": [
                  "qualified",
                  "unqualified",
                  "unknown"
                ]
              },
              "qualification_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maximum_timestamp_uncertainty_ms": {
            "type": "number",
            "minimum": 0
          },
          "hypotheses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fault_id",
                "trajectory_tubes"
              ],
              "properties": {
                "fault_id": {
                  "type": "string",
                  "minLength": 1
                },
                "trajectory_tubes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "tube_id",
                      "measurement_principle",
                      "independence_group_id",
                      "value_unit",
                      "dependency_groups",
                      "timebase_id",
                      "sample_offsets_ms",
                      "timestamp_uncertainty_ms",
                      "maximum_abs_slope_per_ms",
                      "value_lower",
                      "value_upper",
                      "evidence_role",
                      "artifact_sha256"
                    ],
                    "properties": {
                      "tube_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "measurement_principle": {
                        "type": "string",
                        "minLength": 1
                      },
                      "independence_group_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value_unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "dependency_groups": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "timebase_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sample_offsets_ms": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "integer"
                        }
                      },
                      "timestamp_uncertainty_ms": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "maximum_abs_slope_per_ms": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "value_lower": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "value_upper": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "number"
                        }
                      },
                      "evidence_role": {
                        "const": "SYNTHETIC_CONFORMANCE_FIXTURE"
                      },
                      "artifact_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            }
          },
          "required_pairs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pair_id",
                "fault_a",
                "fault_b",
                "minimum_independent_principles",
                "expected_status",
                "expected_marginal_envelope_separated"
              ],
              "properties": {
                "pair_id": {
                  "type": "string",
                  "minLength": 1
                },
                "fault_a": {
                  "type": "string",
                  "minLength": 1
                },
                "fault_b": {
                  "type": "string",
                  "minLength": 1
                },
                "minimum_independent_principles": {
                  "type": "integer",
                  "minimum": 1
                },
                "expected_status": {
                  "enum": [
                    "BEHAVIORALLY_SEPARABLE",
                    "BEHAVIORALLY_AMBIGUOUS",
                    "INSUFFICIENT_INDEPENDENT_PRINCIPLES",
                    "NOT_EVALUATED"
                  ]
                },
                "expected_marginal_envelope_separated": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "controller_write",
        "actuation",
        "maintenance_authorization",
        "mode_transition",
        "restriction_clearance"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "controller_write": {
          "const": false
        },
        "actuation": {
          "const": false
        },
        "maintenance_authorization": {
          "const": false
        },
        "mode_transition": {
          "const": false
        },
        "restriction_clearance": {
          "const": false
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 80
    }
  }
}
