{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/construction/HIGHRISE_CLIMBING_WORKCELL_PROFILE_SCHEMA_V0_1.json",
  "title": "High-rise climbing workcell benchmark profile",
  "description": "Closed structural schema for the v0.1 research profile. Validation establishes document shape only, not engineering or physical claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "profile_version",
    "document_status",
    "issue",
    "created_date",
    "purpose",
    "claim_ceiling",
    "evidence_classes",
    "source_register",
    "evaluation_scope",
    "system_boundary",
    "task_families",
    "benchmark_metrics",
    "protocol",
    "staged_validation",
    "non_compensable_gates",
    "target_ladder",
    "existing_owner_references",
    "unresolved_inputs"
  ],
  "properties": {
    "profile_id": {
      "const": "HIGHRISE-CLIMBING-WORKCELL-001"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^0\\.1\\.0$"
    },
    "document_status": {
      "const": "research_template_not_project_qualified"
    },
    "issue": {
      "type": "string",
      "format": "uri"
    },
    "created_date": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "$ref": "#/$defs/claimCeiling"
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "manufacturer_declared",
          "project_reported",
          "peer_reviewed_study",
          "bench_measured",
          "hardware_in_loop",
          "supervised_field",
          "independently_adjudicated",
          "synthetic",
          "simulated",
          "unknown"
        ]
      }
    },
    "source_register": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evaluation_scope": {
      "$ref": "#/$defs/evaluationScope"
    },
    "system_boundary": {
      "$ref": "#/$defs/systemBoundary"
    },
    "task_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taskFamily"
      }
    },
    "benchmark_metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "protocol": {
      "$ref": "#/$defs/protocol"
    },
    "staged_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "non_compensable_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_ladder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "existing_owner_references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "unresolved_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "claimCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "not_established"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_established": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reportedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "baseline",
            "comparison",
            "unit"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "baseline": {
              "type": "number"
            },
            "comparison": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "value",
            "unit"
          ],
          "properties": {
            "metric": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "source_type",
        "publication_date",
        "url",
        "reported_values",
        "scope_note",
        "admissibility"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "peer_reviewed_study",
            "project_reported_trade_press",
            "manufacturer_declared",
            "independently_measured",
            "unknown"
          ]
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "reported_values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportedValue"
          }
        },
        "scope_note": {
          "type": "string",
          "minLength": 1
        },
        "admissibility": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_name",
        "jurisdiction",
        "building_design_revision",
        "building_geometry_digest",
        "floor_or_zone_ids",
        "site_epoch",
        "work_package_revision",
        "temporary_works_design_revision",
        "baseline_definition",
        "baseline_data_digest",
        "comparison_protocol_revision",
        "independent_assessor",
        "qualified_structural_engineer_reference",
        "safety_case_reference",
        "null_policy"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/nullableString"
        },
        "project_name": {
          "$ref": "#/$defs/nullableString"
        },
        "jurisdiction": {
          "$ref": "#/$defs/nullableString"
        },
        "building_design_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "building_geometry_digest": {
          "$ref": "#/$defs/nullableString"
        },
        "floor_or_zone_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "site_epoch": {
          "$ref": "#/$defs/nullableString"
        },
        "work_package_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "temporary_works_design_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "baseline_definition": {
          "$ref": "#/$defs/nullableString"
        },
        "baseline_data_digest": {
          "$ref": "#/$defs/nullableString"
        },
        "comparison_protocol_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "independent_assessor": {
          "$ref": "#/$defs/nullableString"
        },
        "qualified_structural_engineer_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "safety_case_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "null_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "systemBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_subsystems",
        "external_interfaces",
        "lifecycle_phases"
      ],
      "properties": {
        "included_subsystems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle_phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "taskFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_family_id",
        "functional_unit",
        "acceptance_owner",
        "acceptance_inputs",
        "never_equate"
      ],
      "properties": {
        "task_family_id": {
          "type": "string",
          "minLength": 1
        },
        "functional_unit": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_owner": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "never_equate": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "family",
        "unit",
        "aggregation",
        "requires"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "aggregation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preregistration_required",
        "freeze_before_trial",
        "comparison_designs_preferred",
        "required_reporting",
        "independence_rules"
      ],
      "properties": {
        "preregistration_required": {
          "type": "boolean"
        },
        "freeze_before_trial": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparison_designs_preferred": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_reporting": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independence_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "name",
        "physical_motion_allowed",
        "required_exit"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "pattern": "^P[0-5]$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "physical_motion_allowed": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "required_exit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "name",
        "target",
        "status"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "prospective"
        }
      }
    }
  }
}
