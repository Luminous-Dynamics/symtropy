  "task_families": [
    {
      "task_family_id": "TEMPORARY_WORKS",
      "functional_unit": "project-defined accepted platform configuration or completed climb cycle",
      "acceptance_owner": "qualified temporary-works engineer and authorized project inspection process",
      "acceptance_inputs": [
        "approved configuration revision",
        "load-case and support-state evidence",
        "independent geometry and condition measurements",
        "inspection disposition"
      ],
      "never_equate": [
        "platform positioned",
        "actuator reports complete",
        "software simulation passed"
      ]
    },
    {
      "task_family_id": "SYNCHRONIZED_LIFT",
      "functional_unit": "one project-defined accepted lift/reposition operation",
      "acceptance_owner": "authorized lifting process and competent independent verification",
      "acceptance_inputs": [
        "approved lift plan",
        "payload and support configuration",
        "independent position/load/tilt measurements",
        "stop and recovery disposition"
      ],
      "never_equate": [
        "command sent",
        "encoder target reached",
        "VDA order complete"
      ]
    },
    {
      "task_family_id": "REINFORCEMENT_INSTALLATION",
      "functional_unit": "project-defined accepted reinforcement work package",
      "acceptance_owner": "project engineer and inspection authority",
      "acceptance_inputs": [
        "bar/mesh identity and lot",
        "design revision and placement geometry",
        "cover, spacing, anchorage and connection evidence as specified",
        "inspection disposition"
      ],
      "never_equate": [
        "bars counted by robot",
        "gripper released",
        "camera classifier confidence"
      ]
    },
    {
      "task_family_id": "FORMWORK_INSTALLATION",
      "functional_unit": "project-defined accepted formwork segment",
      "acceptance_owner": "qualified temporary-works/formwork authority",
      "acceptance_inputs": [
        "approved formwork configuration",
        "independent location and geometry",
        "connection and support inspection",
        "readiness disposition"
      ],
      "never_equate": [
        "robot task finished",
        "position estimate within robot controller"
      ]
    },
    {
      "task_family_id": "MATERIAL_LOGISTICS",
      "functional_unit": "correctly identified material lot delivered to accepted destination and condition",
      "acceptance_owner": "authorized receiving/work-package process",
      "acceptance_inputs": [
        "material identity and batch",
        "origin and destination",
        "quantity and condition",
        "custody and delivery evidence"
      ],
      "never_equate": [
        "lift slot granted",
        "route traversed",
        "payload released"
      ]
    },
    {
      "task_family_id": "FACADE_OR_MEP_INSTALLATION",
