  "protocol": {
    "preregistration_required": true,
    "freeze_before_trial": [
      "design_and_work_package_revision",
      "temporary_works_configuration",
      "machine_and_tool_configuration",
      "ODD_and_environmental_stratum",
      "functional_unit_and_acceptance_predicate",
      "reference_instruments_and_calibration",
      "primary_metrics_and_analysis_plan",
      "exclusion_and_stopping_rules"
    ],
    "comparison_designs_preferred": [
      "randomized_work_package_allocation",
      "balanced_within_site_crossover",
      "matched_same_scope_conventional_baseline"
    ],
    "required_reporting": [
      "raw_numerators_and_denominators",
      "p50_p90_and_relevant_tail_statistics",
      "uncertainty_and_reference_measurement_budget",
      "all_attempted_invalid_aborted_and_missing_runs",
      "site_serial_operator_configuration_and_ODD_strata",
      "setup_supervision_inspection_rework_and_recovery_labor",
      "confounders_and_unidentified_effects"
    ],
    "independence_rules": [
      "robot_self_report_is_not_independent_acceptance",
      "robot_navigation_reference_is_not_referee_ground_truth",
      "simulator_output_is_not_physical_validation",
      "shared_sensor_clock_power_network_or_processing_fault_domain_must_be_disclosed",
      "frames_within_one_encounter_are_not_independent_trials"
    ]
  },
  "staged_validation": [
    {
      "stage": "P0",
      "name": "desk_study_and_requirements",
      "physical_motion_allowed": false,
      "required_exit": "source register, system boundary, concept of operations, hazard log, ODD and engineering-review plan"
    },
    {
      "stage": "P1",
      "name": "model_and_software_in_the_loop",
      "physical_motion_allowed": false,
      "required_exit": "model verification/validation plan, deterministic scenarios, uncertainty and fault/recovery coverage"
    },
    {
      "stage": "P2",
      "name": "instrumented_component_rig",
      "physical_motion_allowed": "only under an approved isolated test plan",
      "required_exit": "independent instrumentation, qualified fixture, approved loads, protective systems and test review"
    },
    {
      "stage": "P3",
      "name": "guarded_partial_scale_workcell",
      "physical_motion_allowed": "only under approved engineering and safety authorization",
      "required_exit": "task-specific capability/safety qualification, stop/recovery evidence and independent inspection"
    },
    {
      "stage": "P4",
      "name": "non_occupied_site_mockup",
      "physical_motion_allowed": "only under approved site-specific design, permits and competent supervision",
      "required_exit": "accepted matched work packages, full-workflow cost/labor and as-built reconciliation"
    },
    {
      "stage": "P5",
      "name": "project_pilot",
      "physical_motion_allowed": "only after earlier stage approvals",
      "required_exit": "matched baseline, independent adjudication and transferability study"
    }
  ],
