  "functional_output_contracts": [
    {
      "task_id": "CONTROL_LAYOUT",
      "functional_unit": "accepted survey/control/layout package",
      "acceptance_predicate": "exact source revision and frame bound; independent reference survey and required control/checkpoint evidence accepted",
      "acceptance_authority": "project survey authority",
      "credit_rule": "no credit from robot position estimate alone"
    },
    {
      "task_id": "TEMP_WORKS_READY",
      "functional_unit": "accepted temporary-works readiness package",
      "acceptance_predicate": "project-specific engineer approval and required independent inspection recorded for exact configuration",
      "acceptance_authority": "qualified temporary-works engineer and authorized inspection process",
      "credit_rule": "no schedule gate substitutes for an actual approval"
    },
    {
      "task_id": "REBAR_INSTALL",
      "functional_unit": "accepted reinforcement work package",
      "acceptance_predicate": "material identity, position, cover/spacing and specified connections inspected against frozen design",
      "acceptance_authority": "project engineer and authorized inspection process",
      "credit_rule": "attempted placement is not accepted reinforcement"
    },
    {
      "task_id": "MEP_EMBEDS",
      "functional_unit": "accepted MEP embed/interface package",
      "acceptance_predicate": "identity, location, orientation, interface and specified inspection evidence accepted",
      "acceptance_authority": "discipline engineer and authorized inspection process",
      "credit_rule": "BIM presence or robot action completion is not physical acceptance"
    },
    {
      "task_id": "FORMWORK_CLOSE",
      "functional_unit": "accepted formwork work package",
      "acceptance_predicate": "exact approved configuration, connection/support inspection and as-built geometry accepted",
      "acceptance_authority": "qualified temporary-works/formwork authority",
      "credit_rule": "positioning event is not formwork release"
    },
    {
      "task_id": "PREPOUR_INSPECT",
      "functional_unit": "pre-pour inspection disposition",
      "acceptance_predicate": "required inspection completed with typed pass/reject/unknown outcome",
      "acceptance_authority": "authorized inspection authority",
      "credit_rule": "inspection attempt is not a hold-point release"
    },
    {
      "task_id": "CONCRETE_PLACE",
      "functional_unit": "accepted concrete placement work package",
      "acceptance_predicate": "required upstream release, material/lot traceability and project-specific placement/QA evidence accepted",
      "acceptance_authority": "project engineer and authorized QA process",
      "credit_rule": "pump/placement complete does not imply concrete acceptance"
    },
    {
      "task_id": "STRENGTH_RELEASE",
      "functional_unit": "accepted strength/inspection release",
      "acceptance_predicate": "project-specified evidence and competent approval support the exact release decision",
      "acceptance_authority": "project engineer and authorized inspection process",
      "credit_rule": "elapsed abstract cure duration is not strength evidence"
    },
    {
      "task_id": "FORMWORK_STRIP",
      "functional_unit": "accepted strip/reposition operation",
      "acceptance_predicate": "separate project-approved release, configuration, inspection and disposition exist",
      "acceptance_authority": "authorized temporary-works/lifting process",
      "credit_rule": "schedule completion never grants strip or lift authority"
    },
    {
      "task_id": "CORRECTIVE_REWORK",
      "functional_unit": "accepted corrective work package",
      "acceptance_predicate": "identified defect corrected under the frozen revision and submitted for independent reinspection",
      "acceptance_authority": "discipline engineer and authorized inspection process",
      "credit_rule": "rework performed remains unaccepted until reinspection"
    },
    {
      "task_id": "PREPOUR_REINSPECT",
      "functional_unit": "accepted reinspection disposition",
      "acceptance_predicate": "original defect and corrective evidence reconciled; hold point independently released",
      "acceptance_authority": "authorized inspection authority",
      "credit_rule": "no downstream pour task may rely on rejected first-pass inspection"
    }
  ],
