{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/rock-extraction-portfolio/excavation_decision_case.schema.json",
  "title": "Excavation Decision Benchmark Case v0.1",
  "description": "Validates the shape of an evidence-bounded method-selection case. Schema validity does not qualify a strategy, establish physical safety, or authenticate measurements.",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "profile",
    "strategies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/strategy"
      }
    },
    "experiment_options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment_option"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "status": {
      "enum": [
        "SUPPORTED",
        "UNSUPPORTED",
        "UNKNOWN"
      ]
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_id",
        "task_profile_ref",
        "energy_boundary_ref",
        "minimum_evidence_tier",
        "objectives",
        "constraints",
        "primary_outcomes_require_independent_measurements"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "task_profile_ref": {
          "type": "string",
          "minLength": 1
        },
        "energy_boundary_ref": {
          "type": "string",
          "minLength": 1
        },
        "minimum_evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "primary_outcomes_require_independent_measurements": {
          "type": "boolean"
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "metric_id",
              "unit",
              "direction"
            ],
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "MAXIMIZE",
                  "MINIMIZE"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "metric_id",
              "unit",
              "relation",
              "threshold"
            ],
            "properties": {
              "metric_id": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": [
                  "AT_LEAST",
                  "AT_MOST"
                ]
              },
              "threshold": {
                "type": "number"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "metric_id",
        "lower",
        "upper",
        "unit",
        "evidence_role",
        "source_ref"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_role": {
          "enum": [
            "IndependentMeasurement",
            "DerivedFromIndependentMeasurements",
            "ModelEstimate",
            "Simulation",
            "OperatorReported",
            "ProcessSensor"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "lineage_ref": {
          "type": "string",
          "minLength": 1
        },
        "calibration_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_role": {
                "const": "IndependentMeasurement"
              }
            },
            "required": [
              "evidence_role"
            ]
          },
          "then": {
            "required": [
              "calibration_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evidence_role": {
                "const": "DerivedFromIndependentMeasurements"
              }
            },
            "required": [
              "evidence_role"
            ]
          },
          "then": {
            "required": [
              "lineage_ref",
              "calibration_ref"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "required": [
        "strategy_id",
        "strategy_type",
        "evidence_tier",
        "geology_support",
        "machine_support",
        "engineering_qualification_status",
        "resource_boundary_status",
        "energy_boundary_ref",
        "configuration_ref",
        "outcomes",
        "source_refs"
      ],
      "properties": {
        "strategy_id": {
          "type": "string",
          "minLength": 1
        },
        "strategy_type": {
          "enum": [
            "MECHANICAL_BASELINE",
            "NO_ASSIST",
            "HYBRID",
            "ASSIST_ONLY",
            "CUTTING_AND_SPLITTING",
            "OTHER"
          ]
        },
        "evidence_tier": {
          "$ref": "#/$defs/tier"
        },
        "geology_support": {
          "$ref": "#/$defs/status"
        },
        "machine_support": {
          "$ref": "#/$defs/status"
        },
        "engineering_qualification_status": {
          "enum": [
            "QUALIFIED_FOR_DECLARED_TASK",
            "NOT_QUALIFIED",
            "UNKNOWN"
          ]
        },
        "engineering_qualification_ref": {
          "type": "string",
          "minLength": 1
        },
        "resource_boundary_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNKNOWN"
          ]
        },
        "energy_boundary_ref": {
          "type": "string",
          "minLength": 1
        },
        "configuration_ref": {
          "type": "string",
          "minLength": 1
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engineering_qualification_status": {
                "const": "QUALIFIED_FOR_DECLARED_TASK"
              }
            },
            "required": [
              "engineering_qualification_status"
            ]
          },
          "then": {
            "required": [
              "engineering_qualification_ref"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "experiment_option": {
      "type": "object",
      "required": [
        "experiment_id",
        "targets",
        "cost_ref",
        "protocol_ref"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cost_ref": {
          "type": "string",
          "minLength": 1
        },
        "protocol_ref": {
          "type": "string",
          "minLength": 1
        },
        "expected_result_model_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
