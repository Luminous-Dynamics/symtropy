{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symtropy/sensor-placement-case-v0.1.json",
  "title": "Symtropy Sensor Placement Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "observability_case_id",
    "evidence_class",
    "placement_profile",
    "candidates",
    "outage_scenarios"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "channel_id",
        "lifecycle_cost_units",
        "cost_unit",
        "maintenance_hours_per_year",
        "planned_unavailability_hours_per_year",
        "source_class",
        "cost_source_ref"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/ref"
        },
        "channel_id": {
          "$ref": "#/$defs/ref"
        },
        "lifecycle_cost_units": {
          "type": "number",
          "minimum": 0
        },
        "cost_unit": {
          "$ref": "#/$defs/ref"
        },
        "maintenance_hours_per_year": {
          "type": "number",
          "minimum": 0
        },
        "planned_unavailability_hours_per_year": {
          "type": "number",
          "minimum": 0
        },
        "source_class": {
          "enum": [
            "SYNTHETIC_COST_FIXTURE",
            "VENDOR_QUOTE",
            "FIELD_MAINTENANCE_LOG",
            "ENGINEERING_ESTIMATE"
          ]
        },
        "cost_source_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "outage_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "failed_channel_ids",
        "failed_independence_group_refs"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/ref"
        },
        "failed_channel_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "failed_independence_group_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "$ref": "#/$defs/ref"
    },
    "observability_case_id": {
      "$ref": "#/$defs/ref"
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC_CONFORMANCE_FIXTURE",
        "MEASURED_COSTS_AND_RESPONSES"
      ]
    },
    "placement_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_ref",
        "cost_unit",
        "exact_search_limit",
        "maximum_selected_channels",
        "max_lifecycle_cost_units",
        "require_all_critical_pairs_nominal",
        "require_all_critical_pairs_under_outages"
      ],
      "properties": {
        "profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "cost_unit": {
          "$ref": "#/$defs/ref"
        },
        "exact_search_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maximum_selected_channels": {
          "type": "integer",
          "minimum": 1
        },
        "max_lifecycle_cost_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "require_all_critical_pairs_nominal": {
          "type": "boolean"
        },
        "require_all_critical_pairs_under_outages": {
          "type": "boolean"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "outage_scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outage_scenario"
      }
    }
  }
}
