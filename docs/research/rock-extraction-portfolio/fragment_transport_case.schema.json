{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/rock-extraction-portfolio/fragment_transport_case.schema.json",
  "title": "Fragmentation Transport Case v0.1",
  "description": "Measured-window contract for fragment distribution, mass balance and installed-path capacity comparison. Shape validation does not authenticate sources or qualify equipment.",
  "type": "object",
  "required": ["schema_version", "case_id", "evidence_class", "profile", "intervals"],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "evidence_class": { "enum": ["SYNTHETIC_CONFORMANCE_FIXTURE", "MEASURED_CAMPAIGN"] },
    "profile": { "$ref": "#/$defs/profile" },
    "intervals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/interval" } }
  },
  "additionalProperties": false,
  "$defs": {
    "reference": { "type": "string", "minLength": 1 },
    "measurement": {
      "type": "object",
      "required": ["value_kg", "standard_uncertainty_kg", "evidence_role", "calibration_ref", "source_ref"],
      "properties": {
        "value_kg": { "type": "number", "minimum": 0 },
        "standard_uncertainty_kg": { "type": "number", "minimum": 0 },
        "evidence_role": { "enum": ["INDEPENDENT_MEASUREMENT", "DERIVED_FROM_INDEPENDENT_MEASUREMENTS", "PROCESS_SENSOR", "OPERATOR_REPORTED", "MODEL_ESTIMATE", "SIMULATION"] },
        "calibration_ref": { "$ref": "#/$defs/reference" },
        "source_ref": { "$ref": "#/$defs/reference" },
        "lineage_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fragment_bin": {
      "type": "object",
      "required": ["lower_mm", "upper_mm", "mass_kg", "standard_uncertainty_kg", "evidence_role", "calibration_ref", "source_ref"],
      "properties": {
        "lower_mm": { "type": "number", "minimum": 0 },
        "upper_mm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "mass_kg": { "type": "number", "minimum": 0 },
        "standard_uncertainty_kg": { "type": "number", "minimum": 0 },
        "evidence_role": { "enum": ["INDEPENDENT_MEASUREMENT", "DERIVED_FROM_INDEPENDENT_MEASUREMENTS", "PROCESS_SENSOR", "OPERATOR_REPORTED", "MODEL_ESTIMATE", "SIMULATION"] },
        "calibration_ref": { "$ref": "#/$defs/reference" },
        "source_ref": { "$ref": "#/$defs/reference" },
        "lineage_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "stage_capacity": {
      "type": "object",
      "required": ["stage", "capacity_lower_kg_s", "capacity_upper_kg_s", "transport_configuration_ref", "transport_capacity_profile_ref", "capacity_window_ref", "evidence_role", "calibration_ref", "source_ref"],
      "properties": {
        "stage": { "enum": ["CAPTURE", "CONVEY", "SEPARATE", "DISCHARGE"] },
        "capacity_lower_kg_s": { "type": "number", "minimum": 0 },
        "capacity_upper_kg_s": { "type": "number", "minimum": 0 },
        "transport_configuration_ref": { "$ref": "#/$defs/reference" },
        "transport_capacity_profile_ref": { "$ref": "#/$defs/reference" },
        "capacity_window_ref": { "$ref": "#/$defs/reference" },
        "evidence_role": { "enum": ["INDEPENDENT_MEASUREMENT", "DERIVED_FROM_INDEPENDENT_MEASUREMENTS", "PROCESS_SENSOR", "OPERATOR_REPORTED", "MODEL_ESTIMATE", "SIMULATION"] },
        "calibration_ref": { "$ref": "#/$defs/reference" },
        "source_ref": { "$ref": "#/$defs/reference" },
        "lineage_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["profile_id", "task_profile_ref", "material_cohort_ref", "acceptance_profile_ref", "site_context_ref", "machine_configuration_ref", "transport_configuration_ref", "transport_capacity_profile_ref", "energy_boundary_ref", "resource_ledger_ref", "mass_basis", "clock_sync_protocol_ref", "stage_order"],
      "properties": {
        "profile_id": { "$ref": "#/$defs/reference" },
        "task_profile_ref": { "$ref": "#/$defs/reference" },
        "material_cohort_ref": { "$ref": "#/$defs/reference" },
        "acceptance_profile_ref": { "$ref": "#/$defs/reference" },
        "site_context_ref": { "$ref": "#/$defs/reference" },
        "machine_configuration_ref": { "$ref": "#/$defs/reference" },
        "transport_configuration_ref": { "$ref": "#/$defs/reference" },
        "transport_capacity_profile_ref": { "$ref": "#/$defs/reference" },
        "energy_boundary_ref": { "$ref": "#/$defs/reference" },
        "resource_ledger_ref": { "$ref": "#/$defs/reference" },
        "mass_basis": { "const": "DRY_SOLID_MASS" },
        "clock_sync_protocol_ref": { "$ref": "#/$defs/reference" },
        "stage_order": {
          "type": "array",
          "items": { "enum": ["CAPTURE", "CONVEY", "SEPARATE", "DISCHARGE"] },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["interval_id", "trial_id", "configuration_ref", "start_ms", "end_ms", "time_uncertainty_ms", "clock_sync_ref", "generated_mass", "recovered_mass", "residual_mass", "rejected_mass", "fragment_bins", "stage_capacities"],
      "properties": {
        "interval_id": { "$ref": "#/$defs/reference" },
        "trial_id": { "$ref": "#/$defs/reference" },
        "configuration_ref": { "$ref": "#/$defs/reference" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 1 },
        "time_uncertainty_ms": { "type": "number", "minimum": 0 },
        "clock_sync_ref": { "$ref": "#/$defs/reference" },
        "generated_mass": { "$ref": "#/$defs/measurement" },
        "recovered_mass": { "$ref": "#/$defs/measurement" },
        "residual_mass": { "$ref": "#/$defs/measurement" },
        "rejected_mass": { "$ref": "#/$defs/measurement" },
        "fragment_bins": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fragment_bin" } },
        "stage_capacities": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/stage_capacity" } }
      },
      "additionalProperties": false
    }
  }
}
