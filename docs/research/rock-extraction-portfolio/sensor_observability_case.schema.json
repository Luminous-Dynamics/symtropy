{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symtropy/sensor-observability-case-v0.1.json",
  "title": "Symtropy Sensor Observability Case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "evidence_class",
    "parent_context",
    "measurement_system_case_id",
    "layout_profile",
    "channels",
    "states",
    "required_state_pairs",
    "responses"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_cohort_ref",
        "path_configuration_ref",
        "geometry_profile_ref"
      ],
      "properties": {
        "material_cohort_ref": {
          "$ref": "#/$defs/ref"
        },
        "path_configuration_ref": {
          "$ref": "#/$defs/ref"
        },
        "geometry_profile_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "measurand",
        "technique",
        "unit",
        "physical_location_ref",
        "calibration_ref",
        "independence_group_ref",
        "dependency_domain_ref",
        "domain",
        "source_artifact_ref"
      ],
      "properties": {
        "channel_id": {
          "$ref": "#/$defs/ref"
        },
        "measurand": {
          "$ref": "#/$defs/ref"
        },
        "technique": {
          "$ref": "#/$defs/ref"
        },
        "unit": {
          "$ref": "#/$defs/ref"
        },
        "physical_location_ref": {
          "$ref": "#/$defs/ref"
        },
        "calibration_ref": {
          "$ref": "#/$defs/ref"
        },
        "independence_group_ref": {
          "$ref": "#/$defs/ref"
        },
        "dependency_domain_ref": {
          "$ref": "#/$defs/ref"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "source_artifact_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "state_class",
        "faulted_channel_ids"
      ],
      "properties": {
        "state_id": {
          "enum": [
            "NORMAL_STABLE",
            "STARTUP_SHUTDOWN_TRANSIENT",
            "HIGH_SOLIDS_LOADING",
            "STRATIFIED_FLOW",
            "DUNE_DEPOSITION",
            "PARTIAL_RESTRICTION",
            "DEVELOPING_BLOCKAGE",
            "COMPLETE_BLOCKAGE",
            "WATER_ACCUMULATION",
            "FILTER_CYCLONE_LOADING",
            "AIR_LEAK_DISCONNECTION",
            "BLOWER_VFD_FAULT",
            "PRESSURE_SENSOR_FAULT",
            "AIRFLOW_SENSOR_FAULT",
            "CURRENT_SENSOR_FAULT",
            "UNKNOWN_OUT_OF_DOMAIN"
          ]
        },
        "state_class": {
          "enum": [
            "PROCESS_STATE",
            "SENSOR_FAULT",
            "OUT_OF_DOMAIN"
          ]
        },
        "faulted_channel_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "required_pair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pair_id",
        "state_a_id",
        "state_b_id",
        "critical",
        "minimum_independent_principles"
      ],
      "properties": {
        "pair_id": {
          "$ref": "#/$defs/ref"
        },
        "state_a_id": {
          "$ref": "#/$defs/ref"
        },
        "state_b_id": {
          "$ref": "#/$defs/ref"
        },
        "critical": {
          "type": "boolean"
        },
        "minimum_independent_principles": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_id",
        "state_id",
        "channel_id",
        "availability",
        "value_lower",
        "value_upper",
        "unit",
        "evidence_role",
        "domain",
        "measurement_window_ref",
        "source_ref",
        "adjudication_ref"
      ],
      "properties": {
        "response_id": {
          "$ref": "#/$defs/ref"
        },
        "state_id": {
          "$ref": "#/$defs/ref"
        },
        "channel_id": {
          "$ref": "#/$defs/ref"
        },
        "availability": {
          "enum": [
            "VALID",
            "DEGRADED",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "value_lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "value_upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/ref"
        },
        "evidence_role": {
          "enum": [
            "INDEPENDENT_MEASUREMENT",
            "SYNTHETIC_CONFORMANCE_FIXTURE",
            "MODEL_ESTIMATE",
            "OPERATOR_REPORTED"
          ]
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "measurement_window_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_ref": {
          "$ref": "#/$defs/ref"
        },
        "adjudication_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "$ref": "#/$defs/ref"
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC_CONFORMANCE_FIXTURE",
        "MEASURED"
      ]
    },
    "parent_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_case_id",
        "parent_interval_id",
        "trial_id",
        "material_cohort_ref",
        "machine_configuration_ref",
        "transport_configuration_ref"
      ],
      "properties": {
        "parent_case_id": {
          "$ref": "#/$defs/ref"
        },
        "parent_interval_id": {
          "$ref": "#/$defs/ref"
        },
        "trial_id": {
          "$ref": "#/$defs/ref"
        },
        "material_cohort_ref": {
          "$ref": "#/$defs/ref"
        },
        "machine_configuration_ref": {
          "$ref": "#/$defs/ref"
        },
        "transport_configuration_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "measurement_system_case_id": {
      "$ref": "#/$defs/ref"
    },
    "layout_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout_profile_ref",
        "minimum_independent_principles_for_critical_pairs",
        "required_pair_set_ref"
      ],
      "properties": {
        "layout_profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "minimum_independent_principles_for_critical_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "required_pair_set_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "required_state_pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/required_pair"
      }
    },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/response"
      }
    }
  }
}
