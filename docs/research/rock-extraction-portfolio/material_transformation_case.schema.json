{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symtropy/material-transformation-case-v0.1.json",
  "title": "Symtropy Material Transformation Case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "evidence_class",
    "parent_context",
    "stations",
    "streams",
    "transitions"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "positive_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0
        },
        "upper": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_role",
        "calibration_ref",
        "source_ref"
      ],
      "properties": {
        "evidence_role": {
          "enum": [
            "INDEPENDENT_MEASUREMENT",
            "DERIVED_FROM_INDEPENDENT_MEASUREMENTS",
            "PROCESS_SENSOR",
            "OPERATOR_REPORTED",
            "MODEL_ESTIMATE",
            "SIMULATION"
          ]
        },
        "calibration_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_ref": {
          "$ref": "#/$defs/ref"
        },
        "lineage_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "bin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_mm",
        "upper_mm",
        "dry_mass_flow_lower_kg_s",
        "dry_mass_flow_upper_kg_s",
        "provenance"
      ],
      "properties": {
        "lower_mm": {
          "type": "number",
          "minimum": 0
        },
        "upper_mm": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "dry_mass_flow_lower_kg_s": {
          "type": "number",
          "minimum": 0
        },
        "dry_mass_flow_upper_kg_s": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "station_id",
        "stage",
        "physical_location_ref",
        "configuration_ref"
      ],
      "properties": {
        "station_id": {
          "$ref": "#/$defs/ref"
        },
        "stage": {
          "enum": [
            "CUTTER_DISCHARGE",
            "CAPTURE_INLET",
            "CONVEYANCE_INLET",
            "CONVEYANCE_OUTLET",
            "SEPARATOR_INLET",
            "SEPARATOR_COARSE_OUTLET",
            "FILTER_FINE_OUTLET",
            "ACCEPTED_DISCHARGE",
            "FLOOR_RESIDUAL",
            "LINE_DEPOSIT",
            "REJECT_DISCHARGE",
            "OTHER"
          ]
        },
        "physical_location_ref": {
          "$ref": "#/$defs/ref"
        },
        "configuration_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_id",
        "station_id",
        "role",
        "start_ms",
        "end_ms",
        "clock_sync_ref",
        "time_uncertainty_ms",
        "dry_mass_flow_lower_kg_s",
        "dry_mass_flow_upper_kg_s",
        "provenance",
        "bins"
      ],
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/ref"
        },
        "station_id": {
          "$ref": "#/$defs/ref"
        },
        "role": {
          "enum": [
            "GENERATED",
            "CAPTURED",
            "FLOOR_RESIDUAL",
            "CONVEYED",
            "LINE_DEPOSIT",
            "SEPARATOR_COARSE",
            "FILTER_FINES",
            "REJECTED",
            "ACCEPTED_DISCHARGE",
            "OTHER"
          ]
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "clock_sync_ref": {
          "$ref": "#/$defs/ref"
        },
        "time_uncertainty_ms": {
          "type": "number",
          "minimum": 0
        },
        "dry_mass_flow_lower_kg_s": {
          "type": "number",
          "minimum": 0
        },
        "dry_mass_flow_upper_kg_s": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "bins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bin"
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "stage",
        "path_segment_ref",
        "input_stream_ids",
        "output_stream_ids",
        "residence_time_lower_ms",
        "residence_time_upper_ms",
        "alignment_tolerance_ms",
        "clock_sync_ref"
      ],
      "properties": {
        "transition_id": {
          "$ref": "#/$defs/ref"
        },
        "stage": {
          "enum": [
            "CAPTURE",
            "CONVEY",
            "SEPARATE",
            "DISCHARGE",
            "OTHER"
          ]
        },
        "path_segment_ref": {
          "$ref": "#/$defs/ref"
        },
        "input_stream_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "output_stream_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "residence_time_lower_ms": {
          "type": "integer",
          "minimum": 0
        },
        "residence_time_upper_ms": {
          "type": "integer",
          "minimum": 0
        },
        "alignment_tolerance_ms": {
          "type": "number",
          "minimum": 0
        },
        "clock_sync_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "$ref": "#/$defs/ref"
    },
    "evidence_class": {
      "enum": [
        "SYNTHETIC_CONFORMANCE_FIXTURE",
        "MEASURED"
      ]
    },
    "parent_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_case_id",
        "parent_interval_id",
        "trial_id",
        "site_context_ref",
        "material_cohort_ref",
        "machine_configuration_ref",
        "transport_configuration_ref",
        "clock_sync_protocol_ref"
      ],
      "properties": {
        "parent_case_id": {
          "$ref": "#/$defs/ref"
        },
        "parent_interval_id": {
          "$ref": "#/$defs/ref"
        },
        "trial_id": {
          "$ref": "#/$defs/ref"
        },
        "site_context_ref": {
          "$ref": "#/$defs/ref"
        },
        "material_cohort_ref": {
          "$ref": "#/$defs/ref"
        },
        "machine_configuration_ref": {
          "$ref": "#/$defs/ref"
        },
        "transport_configuration_ref": {
          "$ref": "#/$defs/ref"
        },
        "clock_sync_protocol_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "stations": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/station"
      }
    },
    "streams": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  }
}
