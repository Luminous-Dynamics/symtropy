      "material_grade_matches",
      "calibration_valid",
      "inspection_route_valid",
      "human_authorization_present"
    ],
    "unknown_precondition_means": "blocked; never assume true",
    "future_information_rule": "A policy at step t may use only observations available at or before t. Hidden event schedule and scenario identifiers are not policy inputs.",
