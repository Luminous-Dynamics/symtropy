{
  "schema_version": "civ-resilience-restart-fixture/0.1",
  "title": "CIV-RES-IND-001 hand-checkable reference corpus",
  "status": "proposed synthetic fixture; not executable or physically validated",
  "claim_ceiling": "Tests only the declared abstract accounting rules. It is not a site model, process recipe, safety case, or evidence of real-world resilience.",
  "units": {
    "time": "discrete_step",
