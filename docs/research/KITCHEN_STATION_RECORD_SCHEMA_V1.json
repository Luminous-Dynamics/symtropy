{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symtropy:kitchen-station-record:1.0.0",
  "title": "Kitchen Station Benchmark Trial Record",
  "description": "One immutable candidate × scenario × trial record. This is a data contract, not evidence of product performance or certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "candidate_id",
    "scenario_id",
    "trial_id",
    "run_status",
    "evidence_class",
    "recorded_at",
    "conditions",
    "candidate_spec",
    "protocol",
    "metrics",
    "safety_gates",
    "deviations",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "run_status": {
      "enum": [
        "complete",
        "not_run",
        "blocked",
        "invalid"
      ]
    },
    "evidence_class": {
      "enum": [
        "physical_observation",
        "derived_from_physical",
        "simulation",
        "synthetic_fixture",
        "literature",
        "documentation"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "operator_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "Use a pseudonymous code where human participation is recorded; do not place direct personal identifiers in public trial records."
    },
    "conditions": {
      "type": "object",
      "minProperties": 1,
      "description": "Frozen test conditions with values and units where applicable. Required condition set is defined by the selected scenario."
    },
    "candidate_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metrics": {
      "type": "array",
      "description": "Include every metric expected by the scenario; do not silently omit inconvenient, missing, invalid or blocked measurements.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "safety_gates": {
      "type": "array",
      "description": "Safety/food-contact/plumbing/electrical gates are non-compensatory. Unknown is not pass.",
      "items": {
        "$ref": "#/$defs/safetyGate"
      }
    },
    "raw_artifacts": {
      "type": "array",
      "description": "Top-level photos, videos, instrument logs or files shared across measurements. Each artifact is content-addressed.",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "default": []
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Report protocol departures. Use an empty array only when no deviations occurred."
    },
    "exclusion_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim_limit": {
      "type": "string",
      "minLength": 1,
      "description": "The narrowest supported interpretation of this record."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_status": {
            "const": "complete"
          }
        },
        "required": [
          "run_status"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {
            "enum": [
              "not_run",
              "blocked",
              "invalid"
            ]
          }
        },
        "required": [
          "run_status"
        ]
      },
      "then": {
        "required": [
          "exclusion_reason"
        ],
        "properties": {
          "exclusion_reason": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "run_status": {
            "const": "complete"
          }
        },
        "required": [
          "run_status"
        ]
      },
      "then": {
        "properties": {
          "metrics": {
            "contains": {
              "type": "object",
              "properties": {
                "metric_status": {
                  "enum": [
                    "measured",
                    "derived"
                  ]
                }
              },
              "required": [
                "metric_status"
              ]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "sha256",
        "media_type"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit",
        "method"
      ],
      "properties": {
        "kind": {
          "enum": [
            "standard",
            "expanded",
            "confidence_interval",
            "resolution_bound",
            "other"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "coverage_factor": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "metric_status",
        "unit"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1
        },
        "metric_status": {
          "enum": [
            "measured",
            "derived",
            "missing",
            "invalid",
            "blocked",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "description": "Use '1' for dimensionless numeric metrics and a documented label unit for categorical outputs."
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "minItems": 1
        },
        "formula_id": {
          "type": "string",
          "minLength": 1
        },
        "input_metric_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "status_reason": {
          "type": "string",
          "minLength": 3
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric_status": {
                "enum": [
                  "measured",
                  "derived"
                ]
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "required": [
              "value",
              "uncertainty",
              "sample_count",
              "artifact_refs"
            ],
            "properties": {
              "uncertainty": {
                "$ref": "#/$defs/uncertainty"
              },
              "sample_count": {
                "minimum": 1
              },
              "artifact_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "const": "measured"
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "required": [
              "method_id",
              "instrument_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "const": "derived"
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "required": [
              "formula_id",
              "input_metric_record_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "metric_status": {
                "enum": [
                  "missing",
                  "invalid",
                  "blocked",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "metric_status"
            ]
          },
          "then": {
            "required": [
              "status_reason"
            ]
          }
        }
      ]
    },
    "safetyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "status",
        "basis"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "default": []
        }
      }
    }
  }
}
