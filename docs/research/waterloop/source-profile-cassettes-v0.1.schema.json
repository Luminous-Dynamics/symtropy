{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/waterloop/source-profile-cassettes-v0.1.schema.json",
  "title": "WaterLoop Source Profile and Treatment Cassette Architecture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "evidence_class",
    "claim_ceiling",
    "parent_issue",
    "work_package_issue",
    "source_profiles",
    "candidate_trains",
    "module_interfaces",
    "fail_closed_conditions",
    "safe_state",
    "comparison_metrics",
    "release_gates",
    "nonclaims",
    "qualification_envelopes"
  ],
  "properties": {
    "schema_version": {
      "const": "waterloop-source-profile-cassettes-v0.1"
    },
    "status": {
      "const": "research_architecture_not_released_for_construction"
    },
    "evidence_class": {
      "const": "literature_context_and_unqualified_design_candidates"
    },
    "claim_ceiling": {
      "const": "source_segregation_module_interfaces_candidate_processes_and_test_protocol_only"
    },
    "parent_issue": {
      "type": "integer",
      "const": 5335
    },
    "work_package_issue": {
      "type": "integer",
      "const": 5671
    },
    "source_profiles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "source_boundary",
          "mixing_policy",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "source_boundary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mixing_policy": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "candidate_trains": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "stages",
          "critical_evidence",
          "residuals",
          "risks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "critical_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "residuals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "module_interfaces": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "string"
      }
    },
    "fail_closed_conditions": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "safe_state": {
      "type": "object",
      "required": [
        "product_use_outlet",
        "process_flow",
        "reset",
        "return_to_service",
        "autonomous_dosing",
        "remote_actuation",
        "municipal_connection",
        "occupied_use",
        "potable_use"
      ],
      "properties": {
        "product_use_outlet": {
          "const": "ISOLATED"
        },
        "process_flow": {
          "const": "CONTAINED_QUARANTINE_OR_RESIDUAL_PATH"
        },
        "reset": {
          "const": "INSPECTION_AND_AUTHORISED_MANUAL_RESET"
        },
        "return_to_service": {
          "type": "string"
        },
        "autonomous_dosing": {
          "const": false
        },
        "remote_actuation": {
          "const": false
        },
        "municipal_connection": {
          "const": false
        },
        "occupied_use": {
          "const": false
        },
        "potable_use": {
          "const": false
        }
      }
    },
    "comparison_metrics": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "string"
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string"
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "qualification_envelopes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "train_id",
          "envelope_revision",
          "qualification_status",
          "allowed_source_profile_ids",
          "allowed_intended_use_profile_ids",
          "feed_envelope",
          "hydraulic_envelope",
          "operating_envelope",
          "process_specific_limits",
          "critical_barriers",
          "required_evidence",
          "release_rule"
        ],
        "properties": {
          "train_id": {
            "type": "string"
          },
          "envelope_revision": {
            "type": "string"
          },
          "qualification_status": {
            "const": "NOT_QUALIFIED"
          },
          "allowed_source_profile_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "allowed_intended_use_profile_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "feed_envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flow_weighted_quality_limits",
              "temperature_min_c",
              "temperature_max_c",
              "pH_min",
              "pH_max",
              "turbidity_max_NTU",
              "COD_max_mg_L",
              "TSS_max_mg_L"
            ],
            "properties": {
              "flow_weighted_quality_limits": {
                "$ref": "#/$defs/unestablished"
              },
              "temperature_min_c": {
                "$ref": "#/$defs/unestablished"
              },
              "temperature_max_c": {
                "$ref": "#/$defs/unestablished"
              },
              "pH_min": {
                "$ref": "#/$defs/unestablished"
              },
              "pH_max": {
                "$ref": "#/$defs/unestablished"
              },
              "turbidity_max_NTU": {
                "$ref": "#/$defs/unestablished"
              },
              "COD_max_mg_L": {
                "$ref": "#/$defs/unestablished"
              },
              "TSS_max_mg_L": {
                "$ref": "#/$defs/unestablished"
              }
            }
          },
          "hydraulic_envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum_flow_L_min",
              "maximum_flow_L_min",
              "minimum_inlet_pressure_kPa",
              "maximum_inlet_pressure_kPa",
              "maximum_stage_differential_pressure_kPa",
              "hydraulic_loading_L_m2_day",
              "residence_time_days"
            ],
            "properties": {
              "minimum_flow_L_min": {
                "$ref": "#/$defs/unestablished"
              },
              "maximum_flow_L_min": {
                "$ref": "#/$defs/unestablished"
              },
              "minimum_inlet_pressure_kPa": {
                "$ref": "#/$defs/unestablished"
              },
              "maximum_inlet_pressure_kPa": {
                "$ref": "#/$defs/unestablished"
              },
              "maximum_stage_differential_pressure_kPa": {
                "$ref": "#/$defs/unestablished"
              },
              "hydraulic_loading_L_m2_day": {
                "$ref": "#/$defs/unestablished"
              },
              "residence_time_days": {
                "$ref": "#/$defs/unestablished"
              }
            }
          },
          "operating_envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "continuous_duty_hours",
              "maximum_idle_hours",
              "maximum_media_or_membrane_hours_before_changeout",
              "cleaning_interval_hours",
              "ambient_temperature_min_c",
              "ambient_temperature_max_c"
            ],
            "properties": {
              "continuous_duty_hours": {
                "$ref": "#/$defs/unestablished"
              },
              "maximum_idle_hours": {
                "$ref": "#/$defs/unestablished"
              },
              "maximum_media_or_membrane_hours_before_changeout": {
                "$ref": "#/$defs/unestablished"
              },
              "cleaning_interval_hours": {
                "$ref": "#/$defs/unestablished"
              },
              "ambient_temperature_min_c": {
                "$ref": "#/$defs/unestablished"
              },
              "ambient_temperature_max_c": {
                "$ref": "#/$defs/unestablished"
              }
            }
          },
          "process_specific_limits": {
            "type": "object"
          },
          "critical_barriers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 5,
            "items": {
              "type": "string"
            }
          },
          "release_rule": {
            "const": "NO_PRODUCT_USE_OR_QUALITY_CREDIT_UNTIL_THIS_EXACT_CONFIGURATION_ENVELOPE_IS_ADMITTED"
          }
        }
      }
    }
  },
  "$defs": {
    "unestablished": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "units",
        "source_evidence_id",
        "uncertainty",
        "notes"
      ],
      "properties": {
        "status": {
          "const": "NOT_ESTABLISHED"
        },
        "value": {
          "type": "null"
        },
        "units": {
          "type": "null"
        },
        "source_evidence_id": {
          "type": "null"
        },
        "uncertainty": {
          "type": "null"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
