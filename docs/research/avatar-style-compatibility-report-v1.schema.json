{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symtropy:avatar-style-compatibility-report:1",
  "title": "Avatar Style Renderer Compatibility Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_digest_blake3",
    "renderer_id",
    "renderer_version",
    "renderer_manifest_digest_blake3",
    "status",
    "satisfied_required_features",
    "missing_required_features",
    "satisfied_optional_features",
    "missing_optional_features",
    "canonical_digest_blake3"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile_digest_blake3": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "renderer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "renderer_manifest_digest_blake3": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "status": {
      "enum": [
        "ready",
        "degraded",
        "unsupported"
      ]
    },
    "satisfied_required_features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "missing_required_features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "satisfied_optional_features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "missing_optional_features": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "canonical_digest_blake3": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
