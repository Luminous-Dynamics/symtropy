{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/grid-transmission-portfolio/data/global-portability-v0.1.schema.json",
  "title": "Power Fabric Global Portability v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_date",
    "principles",
    "standards_register",
    "regional_profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "standards_register": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "record_id",
          "designation",
          "title",
          "publisher",
          "edition",
          "status",
          "scope",
          "source_uri",
          "verified_on",
          "jurisdiction_scope",
          "national_adoption_status",
          "notes"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "designation": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "published_active",
              "published_status_to_confirm",
              "approved_work_item",
              "filed_pending_approval",
              "withdrawn_or_superseded",
              "unknown"
            ]
          },
          "publication_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "status_checked_on": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          },
          "jurisdiction_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "national_adoption_status": {
            "enum": [
              "not_checked",
              "adopted",
              "modified_adoption",
              "not_adopted",
              "not_applicable",
              "unknown"
            ]
          },
          "adoption_authority_uri": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "known_supersession_or_work_item": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "regional_profiles": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "name",
          "countries_or_scope",
          "maturity",
          "grid_contexts",
          "hazards_to_assess",
          "standards_references",
          "data_gaps",
          "local_cost_data_status"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "countries_or_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "maturity": {
            "enum": [
              "template_unpopulated",
              "source_reviewed",
              "locally_reviewed",
              "field_referenced"
            ]
          },
          "grid_contexts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hazards_to_assess": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "standards_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "local_cost_data_status": {
            "enum": [
              "unknown",
              "public_partial",
              "rights_cleared_dataset",
              "utility_validated"
            ]
          }
        }
      }
    },
    "claim_boundary": {
      "type": "string"
    }
  }
}
