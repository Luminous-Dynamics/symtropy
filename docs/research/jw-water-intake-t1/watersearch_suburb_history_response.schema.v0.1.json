{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/jw-water-intake-t1/watersearch_suburb_history_response.schema.v0.1.json",
  "title": "Watersearch suburb history response envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "licence",
    "release",
    "source_view",
    "caveat",
    "suburb",
    "suburb_name",
    "days"
  ],
  "properties": {
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "source_view": {
      "const": "api.suburb_history"
    },
    "caveat": {
      "type": "string",
      "minLength": 1
    },
    "suburb": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "suburb_name": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "day",
          "asset_id",
          "asset_name",
          "level",
          "bad",
          "on_bypass",
          "boards",
          "wording"
        ],
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "asset_name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "adequate",
              "fair",
              "pressure",
              "low",
              "no_water",
              "critical",
              "warned",
              "no_report"
            ]
          },
          "bad": {
            "type": "boolean"
          },
          "on_bypass": {
            "type": "boolean"
          },
          "boards": {
            "type": "integer",
            "minimum": 0
          },
          "wording": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
