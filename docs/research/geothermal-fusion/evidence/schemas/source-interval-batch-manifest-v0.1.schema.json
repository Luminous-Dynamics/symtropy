{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/geofusion-source-interval-batch-manifest-v0.1.schema.json",
  "title": "GeoFusion Source Interval Batch Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payload_path",
          "evidence_path",
          "allocation_path"
        ],
        "properties": {
          "payload_path": {
            "type": "string",
            "minLength": 1
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          },
          "allocation_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
