{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/beverage-abnormal-adaptation-scenarios-v1.schema.json",
  "title": "Beverage Abnormal Adaptation Scenario Corpus V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "description",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "beverage-abnormal-adaptation-scenarios-v1"
    },
    "status": {
      "const": "synthetic_policy_contract_not_physical_fermentation_evidence"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "available_post_detection_hours",
          "evidence_class",
          "expected_disposition",
          "guards",
          "claim_ceiling"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ABN-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "available_post_detection_hours": {
            "type": "number",
            "minimum": 0
          },
          "evidence_class": {
            "const": "SYNTHETIC"
          },
          "expected_disposition": {
            "enum": [
              "USE_EARLY_DATA_SPARSE_ESTIMATOR",
              "ALLOW_LATER_PHASE_ESTIMATOR_IF_QUALIFIED",
              "ABSTAIN_AND_REQUEST_MORE_EVIDENCE",
              "INDETERMINATE_AND_DIAGNOSE_SENSOR",
              "REJECT",
              "FAIL_CALIBRATION_GATE",
              "INDETERMINATE",
              "OUT_OF_DOMAIN_NO_AUTOMATIC_RECOMMENDATION",
              "ALLOW_SWITCH_WITH_AUDIT_TRAIL",
              "REJECT_ACTION_AND_ESCALATE",
              "SCORE_BOTH_DELAY_AND_FALSE_ALARMS",
              "REJECT_EMPIRICAL_CLAIM",
              "RETAIN_SAFE_FALLBACK"
            ]
          },
          "guards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claim_ceiling": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
