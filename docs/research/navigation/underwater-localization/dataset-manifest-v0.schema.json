{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/navigation/underwater-localization/dataset-manifest-v0.schema.json",
  "title": "Underwater Navigation Dataset Manifest v0",
  "description": "Source-, rights-, frame-, clock-, sensor- and ground-truth-aware manifest for underwater localization and SLAM benchmark inputs. A structurally valid manifest is not by itself dataset admission or permission to use the data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "source",
    "rights",
    "admission",
    "environment",
    "platform",
    "sensors",
    "frames",
    "clocks",
    "ground_truth",
    "sequences",
    "split_policy",
    "claim_ceiling"
  ],
  "properties": {
    "manifest_version": {
      "const": 0
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custodian",
        "title",
        "canonical_uri",
        "source_revision",
        "retrieved_at_utc",
        "artifacts"
      ],
      "properties": {
        "custodian": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "canonical_uri": {
          "type": "string",
          "format": "uri"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "uri",
              "sha256"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              },
              "byte_length": {
                "type": "integer",
                "minimum": 0
              },
              "media_type": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "license_expression",
        "commercial_use",
        "redistribution",
        "review_evidence"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "pending_review",
            "verified",
            "restricted",
            "excluded",
            "unknown"
          ]
        },
        "license_expression": {
          "type": [
            "string",
            "null"
          ]
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "prohibited",
            "conditional",
            "unknown"
          ]
        },
        "redistribution": {
          "enum": [
            "allowed",
            "prohibited",
            "conditional",
            "unknown"
          ]
        },
        "review_evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "admission": {
      "enum": [
        "candidate",
        "reviewed_not_admitted",
        "admitted",
        "excluded"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_class",
        "water_body_class",
        "observability_notes"
      ],
      "properties": {
        "environment_class": {
          "enum": [
            "tank",
            "pool",
            "harbour",
            "coastal",
            "open_sea",
            "cave",
            "pipeline_or_conduit",
            "reservoir",
            "other",
            "unknown"
          ]
        },
        "water_body_class": {
          "enum": [
            "freshwater",
            "saltwater",
            "brackish",
            "mixed",
            "not_applicable",
            "unknown"
          ]
        },
        "depth_min_m": {
          "type": "number",
          "minimum": 0
        },
        "depth_max_m": {
          "type": "number",
          "minimum": 0
        },
        "visibility_notes": {
          "type": "string"
        },
        "turbidity_notes": {
          "type": "string"
        },
        "current_profile_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "observability_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vehicle_class",
        "tether_state",
        "platform_identity"
      ],
      "properties": {
        "vehicle_class": {
          "enum": [
            "auv",
            "rov",
            "towfish",
            "fixed_sensor_rig",
            "other",
            "unknown"
          ]
        },
        "tether_state": {
          "enum": [
            "untethered",
            "tethered",
            "intermittent",
            "not_applicable",
            "unknown"
          ]
        },
        "platform_identity": {
          "type": "string",
          "minLength": 1
        },
        "mass_kg": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "model_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sensor_id",
          "modality",
          "stream_id",
          "frame_id",
          "clock_id",
          "calibration_status"
        ],
        "properties": {
          "sensor_id": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "enum": [
              "imu",
              "dvl",
              "pressure_depth",
              "monocular_camera",
              "stereo_camera",
              "scanning_sonar",
              "imaging_sonar",
              "multibeam_sonar",
              "side_scan_sonar",
              "altimeter",
              "magnetometer",
              "acoustic_beacon",
              "usbl",
              "lbl",
              "sbl",
              "ctd_sound_speed",
              "other"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "stream_id": {
            "type": "string",
            "minLength": 1
          },
          "frame_id": {
            "type": "string",
            "minLength": 1
          },
          "clock_id": {
            "type": "string",
            "minLength": 1
          },
          "calibration_status": {
            "enum": [
              "source_calibrated",
              "independently_calibrated",
              "uncalibrated",
              "unknown"
            ]
          },
          "calibration_artifact_uri": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "calibration_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame_id",
          "frame_kind",
          "axes",
          "linear_units",
          "angular_units"
        ],
        "properties": {
          "frame_id": {
            "type": "string",
            "minLength": 1
          },
          "parent_frame_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "frame_kind": {
            "enum": [
              "body",
              "sensor",
              "local_ned",
              "local_enu",
              "local_tangent",
              "ecef",
              "geodetic",
              "bathymetric",
              "map",
              "ground_truth",
              "other"
            ]
          },
          "axes": {
            "type": "string",
            "minLength": 1
          },
          "linear_units": {
            "enum": [
              "m",
              "cm",
              "mm",
              "unknown",
              "not_applicable"
            ]
          },
          "angular_units": {
            "enum": [
              "rad",
              "deg",
              "unknown",
              "not_applicable"
            ]
          },
          "horizontal_crs": {
            "type": [
              "string",
              "null"
            ]
          },
          "vertical_datum": {
            "type": [
              "string",
              "null"
            ]
          },
          "coordinate_epoch": {
            "type": [
              "string",
              "null"
            ]
          },
          "transform_artifact_uri": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "uncertainty_notes": {
            "type": "string"
          }
        }
      }
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clock_id",
          "time_scale",
          "monotonic",
          "correlation_status",
          "uncertainty_notes"
        ],
        "properties": {
          "clock_id": {
            "type": "string",
            "minLength": 1
          },
          "time_scale": {
            "enum": [
              "UTC",
              "TAI",
              "TT",
              "TDB",
              "GPST",
              "SCLK",
              "MONOTONIC",
              "UNIX_PROFILE",
              "UNKNOWN"
            ]
          },
          "monotonic": {
            "type": "boolean"
          },
          "epoch_or_boot_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "correlation_status": {
            "enum": [
              "correlated",
              "uncorrelated",
              "partial",
              "unknown"
            ]
          },
          "correlation_artifact_uri": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "offset_uncertainty_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "uncertainty_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "reference_method",
        "reference_frame_id",
        "independence_status",
        "uncertainty_notes"
      ],
      "properties": {
        "availability": {
          "enum": [
            "full",
            "partial",
            "none",
            "unknown"
          ]
        },
        "reference_method": {
          "type": "string",
          "minLength": 1
        },
        "reference_frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "independence_status": {
          "enum": [
            "independent",
            "partially_independent",
            "shares_sensor_or_model",
            "unknown",
            "not_applicable"
          ]
        },
        "position_uncertainty_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "attitude_uncertainty_deg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "coverage_notes": {
          "type": "string"
        },
        "uncertainty_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence_id",
          "group_id",
          "split",
          "environment_condition",
          "sensor_streams",
          "has_ground_truth",
          "artifact_ids"
        ],
        "properties": {
          "sequence_id": {
            "type": "string",
            "minLength": 1
          },
          "group_id": {
            "type": "string",
            "minLength": 1,
            "description": "Leakage-control grouping key such as site, dive, route, platform or collection session."
          },
          "split": {
            "enum": [
              "train",
              "validation",
              "test",
              "holdout",
              "unassigned"
            ]
          },
          "environment_condition": {
            "type": "string",
            "minLength": 1
          },
          "start_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "end_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sensor_streams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "has_ground_truth": {
            "type": "boolean"
          },
          "ground_truth_coverage_fraction": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "artifact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "grouping_fields",
        "adjacent_frame_random_split",
        "policy_notes"
      ],
      "properties": {
        "method": {
          "enum": [
            "by_site",
            "by_dive",
            "by_route",
            "by_platform",
            "by_environment",
            "by_time",
            "composite",
            "not_yet_defined"
          ]
        },
        "grouping_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adjacent_frame_random_split": {
          "const": false
        },
        "policy_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$comment": "A dataset must not be admitted to benchmark scoring while rights, sensor/time/frame semantics, or ground-truth independence remain unknown. A schema-valid manifest is not independent physical truth."
}
