{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power Fabric transport modality baseline record",
  "$ref": "#/$defs/record",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url",
        "publication_date"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "publication_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_kind",
        "application",
        "medium"
      ],
      "properties": {
        "service_kind": {
          "type": "string",
          "minLength": 1
        },
        "application": {
          "type": "string",
          "minLength": 1
        },
        "medium": {
          "type": "string",
          "minLength": 1
        },
        "distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "relation",
        "measurement_plane",
        "boundary",
        "source_reported",
        "conditions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "value_upper": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "exact",
            "approximate",
            "greater_than",
            "range",
            "less_than"
          ]
        },
        "measurement_plane": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "source_reported": {
          "const": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "enum": [
                  "exact",
                  "approximate",
                  "greater_than"
                ]
              }
            },
            "required": [
              "relation"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value_upper"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation": {
                "const": "range"
              }
            },
            "required": [
              "relation"
            ]
          },
          "then": {
            "required": [
              "value_upper"
            ],
            "properties": {
              "value_upper": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modality",
        "study_type",
        "comparison_group",
        "source",
        "service",
        "measurements",
        "known_unknowns",
        "reproduction_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "modality": {
          "enum": [
            "inductive_wpt",
            "optical_laser_wpt",
            "acoustic_ultrasonic_wpt",
            "dynamic_roadway_wpt"
          ]
        },
        "study_type": {
          "enum": [
            "paper_reported_prototype",
            "government_demonstration",
            "industry_pilot",
            "industry_demonstration"
          ]
        },
        "comparison_group": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "service": {
          "$ref": "#/$defs/service"
        },
        "measurements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/measurement"
          }
        },
        "known_unknowns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reproduction_status": {
          "const": "not_independently_reproduced_by_luminous"
        }
      }
    }
  }
}
