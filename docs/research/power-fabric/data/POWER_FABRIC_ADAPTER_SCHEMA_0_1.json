{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/power-fabric-adapter-conformance-0.1.schema.json",
  "title": "Power Fabric Adapter Conformance Fixture v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "source_inventory", "mapping_entries", "expected_ledger_status", "expected_round_trip_status"],
  "properties": {
    "profile": { "$ref": "#/$defs/profile" },
    "source_inventory": { "$ref": "#/$defs/inventory" },
    "mapping_entries": { "type": "array", "items": { "$ref": "#/$defs/mapping_entry" } },
    "expected_ledger_status": { "enum": ["complete", "complete_with_explicit_losses", "incomplete_unsupported", "incomplete_ambiguous"] },
    "expected_round_trip_status": { "enum": ["semantically_equivalent", "equivalent_with_explicit_losses", "incomplete"] }
  },
  "$defs": {
    "standard": {
      "type": "object", "additionalProperties": false,
      "required": ["designation", "part", "edition", "amendment", "publication_status", "jurisdiction"],
      "properties": {
        "designation": { "type": "string", "minLength": 1 }, "part": { "type": ["string", "null"] },
        "edition": { "type": "string", "minLength": 1 }, "amendment": { "type": ["string", "null"] },
        "publication_status": { "enum": ["published", "working_draft", "technical_report"] },
        "jurisdiction": { "type": ["string", "null"] }
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "profile_version", "adapter_version", "direction", "standard"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 }, "profile_version": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 }, "direction": { "enum": ["import", "export", "round_trip"] },
        "standard": { "$ref": "#/$defs/standard" }
      }
    },
    "semantic_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "kind", "namespace", "semantic_digest", "in_scope"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["object", "relationship", "property", "extension", "namespace", "other"] },
        "namespace": { "type": "string", "minLength": 1 },
        "semantic_digest": { "type": "string", "minLength": 1 },
        "in_scope": { "type": "boolean" }
      }
    },
    "inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "document_digest", "items"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "document_digest": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "items": { "$ref": "#/$defs/semantic_item" } }
      }
    },
    "loss": {
      "type": "object", "additionalProperties": false,
      "required": ["loss_id", "category", "description"],
      "properties": {
        "loss_id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["identity", "relationship", "property", "unit", "precision", "namespace", "extension", "ordering", "signature", "external_reference", "other"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "mapping_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["source_item_id", "outcome", "target_item_ids", "mapping_rule_id", "information_losses", "explanation"],
      "properties": {
        "source_item_id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["exact_preservation", "semantically_equivalent", "explicitly_lossy", "unsupported", "ambiguous", "not_in_scope"] },
        "target_item_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "mapping_rule_id": { "type": ["string", "null"] },
        "information_losses": { "type": "array", "items": { "$ref": "#/$defs/loss" } },
        "explanation": { "type": ["string", "null"] }
      }
    }
  }
}
