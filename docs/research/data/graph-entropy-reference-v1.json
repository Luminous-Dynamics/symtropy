  },
  "definition": "D(h) = sum over edges e of c_e * (h[src_e]-h[dst_e]) * (ln(h[src_e])-ln(h[dst_e]))",
  "numeric_policy": {
    "expected_values": "symbolic expressions and sign relations; not platform-specific decimal approximations",
    "valid_domain": "all node states strictly positive; all edge conductances nonnegative; finite graph",
    "comparison": "exact expression/equality where stated; otherwise strict/non-strict sign",
    "caveat": "fixture specification only; no implementation has been run against this corpus"
  },
  "cases": [
    {
      "id": "GE-001-two-node-strict",
      "nodes": 2,
      "state": [
        "2",
        "1"
      ],
      "edges": [
        {
          "src": 0,
          "dst": 1,
          "conductance": "1"
        }
      ],
      "expected": {
        "valid": true,
        "dissipation_expression": "ln(2)",
        "relation_to_zero": "strictly_positive"
      },
      "checks": [
        "sign"
      ]
    },
    {
      "id": "GE-002-equal-state-zero",
      "nodes": 2,
      "state": [
        "2",
        "2"
      ],
      "edges": [
        {
          "src": 0,
          "dst": 1,
          "conductance": "1"
        }
