  "mutation_controls": [
    {
      "id": "GE-MUT-001-reverse-log-difference-only",
      "mutation": "replace (ln(h_src)-ln(h_dst)) with (ln(h_dst)-ln(h_src)) but retain the state difference",
      "witness_case": "GE-001-two-node-strict",
      "expected": "negative value; reject mutated implementation"
    },
    {
      "id": "GE-MUT-002-remove-conductance-premise",
      "mutation": "allow a negative conductance while claiming D(h) >= 0",
      "witness_case": "GE-NEG-001-negative-conductance",
      "expected": "input contract rejects; sign theorem is not applied"
    },
    {
      "id": "GE-MUT-003-relax-positive-state",
      "mutation": "allow zero or negative node state into log",
      "witness_case": "GE-NEG-002-zero-state",
      "expected": "input contract rejects before log evaluation"
    }
  ],
  "claim_ceiling": [
    "The sign theorem applies only to the frozen finite-graph functional and its stated domain.",
    "The derivative theorem additionally requires the exact compatible graph heat-flow dynamics and regularity assumptions.",
    "This corpus does not prove production Symtropy correspondence, rigid-body stability, whole-system energy conservation, or physical validity."
  ]
