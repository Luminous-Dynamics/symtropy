  "description": "Synthetic stress cases for adaptive selection of fermentation measurements under cost, delay, uncertainty, missingness, and safety constraints. They are evaluator contracts only, not measured beverage data.",
  "scenarios": [
    {
      "id": "SENSE-001",
      "name": "stable_nominal_batch_with_low_decision_uncertainty",
