      ],
      "sample_budget_fraction": 0.75,
      "critical_test_due": false,
      "expected_disposition": "DEFER_DISCRETIONARY_SAMPLE",
      "guards": [
        "minimum_sampling_schedule_preserved",
        "decision_risk_below_preregistered_threshold",
        "next_review_time_bounded"
      ],
      "claim_ceiling": "Deferring a discretionary sample in this synthetic case does not justify reducing any validated plant-required test."
    },
    {
