  "task_profiles": {
    "J1_JUMP_BENCH": {
      "task_id": "J1-TWO-DOF-VERTICAL-GUIDE-JUMP",
      "physical_bench": true,
      "degrees_of_freedom": 2,
      "bench_load_kg": 5.5,
      "dc_bus_voltage_v": 48,
      "whole_humanoid_validation": false,
      "excluded_dynamics": [
        "whole_body_balance",
        "lateral_dynamics"
      ],
      "simulated_source_tasks": [
        "fast_walking",
        "jumping",
        "stair_ascent"
      ],
      "task_trace_and_initial_condition_digest": null,
      "freeze_required_before_comparison": true,
      "task_model_contract": {
        "q_definition": "q1 = absolute shank angle; q2 = included knee angle",
        "equal_segment_case": "l_shank = l_thigh",
        "vertical_guide_constraint": "x_h(q) = l_s*cos(q1) - l_t*cos(q1-q2) = 0",
        "slider_height": "y_h(q) = l_s*sin(q1) - l_t*sin(q1-q2)",
        "constrained_dynamics": "M(q) q_ddot + h(q,q_dot) + G(q) = B*tau + A(q)^T*lambda",
        "generalized_torque_map": "B*tau = [-tau_hip, tau_hip + tau_knee]^T",
        "torque_profile": "tau_j(s) = alpha_j(s) * tau_available_j; alpha_j is a fifth-order Bezier curve with six coefficients in [0,1] for each of hip and knee",
        "contact_constraints": [
          "normal_force >= 0",
          "abs(tangential_force) <= friction_coefficient * normal_force"
        ],
        "predictive_braking": "d_stop = omega_positive*t_delay + J_effective*omega_positive^2/(2*braking_torque) + position_margin",
        "exclusions": [
          "whole_body_balance",
          "lateral_dynamics"
        ],
        "source_status": "source_equations_transcribed_not_implemented"
      }
    },
    "J2_WRIST": {
      "task_id": "J2-PITCH-YAW-TRACKING-AND-INTERACTION",
      "physical_bench_reference_required": true,
      "load_pose_and_orientation": null,
      "workspace_and_task_trajectory": null,
      "task_boundary_status": "source_protocol_extraction_required"
    },
    "J3_GRIPPER": {
