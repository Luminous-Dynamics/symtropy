{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/beverage-adaptive-sensing-scenarios-v1.schema.json",
  "title": "Beverage adaptive-sensing synthetic policy scenarios v1",
  "description": "Contract schema for synthetic tests of sampling-policy behavior. These scenarios are not plant evidence, food-safety decisions, or evidence of an operational win.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "description",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "beverage-adaptive-sensing-scenarios-v1"
    },
    "status": {
      "const": "synthetic_policy_contract_not_plant_evidence"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "scenarios": {
      "type": "array",
      "minItems": 22,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scenario_family",
        "evidence_class",
        "available_channels",
        "sample_budget_fraction",
        "critical_test_due",
        "expected_disposition",
        "guards",
        "claim_ceiling"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SENSE-[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "minLength": 5
        },
        "scenario_family": {
          "enum": [
            "nominal_efficiency",
            "consequence_weighted_value",
            "sensor_fault",
            "spatial_heterogeneity",
            "sampling_delay",
            "missingness",
            "safety_floor",
            "budget_allocation",
            "distribution_shift",
            "temporal_leakage",
            "channel_feasibility",
            "reference_data",
            "policy_auditability",
            "evaluation_integrity"
          ]
        },
        "evidence_class": {
          "const": "SYNTHETIC"
        },
        "available_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "sample_budget_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critical_test_due": {
          "type": "boolean"
        },
        "expected_disposition": {
          "enum": [
            "DEFER_DISCRETIONARY_SAMPLE",
            "SAMPLE_HIGH_VALUE_CHANNEL",
            "SAMPLE_INDEPENDENT_CHANNEL",
            "ESCALATE_AND_SAMPLE",
            "ABSTAIN_UNTIL_EVIDENCE",
            "PRESERVE_FIXED_SAFETY_TEST",
            "REJECT_POLICY",
            "USE_SAFE_FIXED_FALLBACK",
            "ACCEPT_WITH_AUDIT_TRAIL",
            "INDETERMINATE"
          ]
        },
        "guards": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 20
        }
      }
    }
  }
}