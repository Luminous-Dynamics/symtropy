{
  "schema_version": "luminous.habitat_revalidation_scale_benchmark.v0.1",
  "suite_id": "habitat-revalidation-scale-suite-001",
  "status": "proposed_unmeasured_synthetic_benchmark_contract",
  "synthetic_only": true,
  "claim_ceiling": "benchmark_design_not_measured_scalability_or_real_world_authority",
  "generator_contract": {
    "version": "0.1",
    "determinism_key": [
      "generator_version",
      "profile_id",
      "seed",
      "generator_config"
    ],
    "required_materialized_receipts": [
      "exact_input_sha256",
      "exact_input_bytes",
      "generator_source_commit",
      "profile_id",
      "seed"
    ],
    "stable_id_ordering": "lexicographic_utf8",
    "randomness_contract": "Use a documented, fixed algorithm and fixed-width arithmetic; never depend on map iteration order or runtime-default randomness."
  },
  "measurement_protocol": {
    "warmup_trials": 5,
    "measured_trials": 30,
    "required_percentiles": [
      50,
      95
    ],
    "required_environment": [
      "repository_commit_sha",
      "dirty_tree_state",
      "rustc_version",
      "cargo_profile",
      "os_and_kernel",
      "cpu_model",
      "logical_core_count",
      "memory_limit_bytes",
      "command_line",
      "workload_sha256"
    ],
    "phase_timings": [
      "decode",
      "structural_validation",
      "reachability_and_reduction",
      "search",
      "report_serialization",
      "end_to_end"
    ],
    "raw_trials_required": true,
    "timing_fields_excluded_from_deterministic_report_digest": true,
    "conditional_percentile_reporting": {
      "percentile": 99,
      "minimum_sample_count": 1000,
      "when_below_minimum": "mark_p99_unavailable_report_observed_max_and_sample_count"
    }
  },
  "correctness_gates": {
    "micro_oracle_frontier_agreement_fraction_min": 1,
    "independent_plan_feasibility_fraction_min": 1,
    "false_optimality_count_max": 0,
    "false_impossibility_count_max": 0,
    "budget_exhaustion_misclassified_count_max": 0,
    "fixed_seed_canonical_report_mismatch_count_max": 0,
    "negative_controls_may_be_removed": false
  },
  "provisional_performance_targets": {
    "environment_must_be_disclosed": true,
    "large_graph_artifact_count": 10000,
    "large_graph_task_count_max": 64,
    "validation_p95_ms_max": 1000,
    "search_state_budget": 100000,
    "bounded_search_p95_ms_max": 2000,
    "peak_rss_bytes_max": 536870912,
    "repeatability_trials": 100,
    "performance_targets_are_measured_facts": false
  },
