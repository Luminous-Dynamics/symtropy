{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.luminousdynamics.io/schemas/humanity-atlas/run-v0.1.schema.json",
  "title": "Humanity Atlas Scenario Run v0.1",
  "description": "Reproducible simulation output envelope; output classification is separate from scientific validation status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "inputs",
    "engine",
    "run_status",
    "output_classification",
    "deterministic",
    "seed",
    "replicates",
    "outputs",
    "validation",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "humanity-atlas.run.v0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "scenario_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_sha256",
        "dataset_sha256"
      ],
      "properties": {
        "scenario_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null means a separately identified dataset digest was not established; it must not be interpreted as proof that no data influenced the engine."
        },
        "scenario_identity_kind": {
          "oneOf": [
            {
              "enum": [
                "scenario_document_bytes",
                "canonical_effective_scenario"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional convention for interpreting scenario_sha256. Null means the convention was not declared."
        },
        "resolved_config_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_params_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected_definition_source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "engine_version",
        "model_sha256"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_identity_kind": {
          "oneOf": [
            {
              "enum": [
                "full_model",
                "technology_tree_definition",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Scope of model_sha256. Null means the scope was not declared; technology_tree_definition is not the complete executable/source tree."
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Source revision reported by the producer; null means it was not supplied.",
          "maxLength": 120
        },
        "definition_source": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "run_status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "description": "Execution status only. completed means the computation finished successfully; it does not imply that the scenario or simulated civilization survived."
    },
    "output_classification": {
      "enum": [
        "synthetic_fixture",
        "illustrative_scenario",
        "unvalidated_simulation",
        "calibrated_simulation",
        "prospective_forecast"
      ]
    },
    "deterministic": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "True only when repeatability is supported by evidence, false when known not to be deterministic, null when determinism has not been established."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replicates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "year",
          "unit",
          "statistic",
          "value",
          "sample_count"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "year": {
            "type": "integer",
            "minimum": -100000,
            "maximum": 100000
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "statistic": {
            "enum": [
              "value",
              "mean",
              "median",
              "min",
              "max",
              "p05",
              "p95"
            ]
          },
          "value": {
            "type": "number"
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "time_basis": {
            "enum": [
              "calendar_year",
              "scenario_relative_year",
              null
            ],
            "description": "Optional time-coordinate semantics for year; scenario_relative_year is measured from the simulated scenario start and is not a calendar date."
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "notes",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "contract_smoke",
            "retrospective",
            "prospective",
            "external_review"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validationEvidence"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "media_type",
          "artifact_ref",
          "artifact_sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "artifact_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "json_pointer": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "description": "Optional RFC 6901 JSON Pointer selecting an embedded payload in the exact artifact bytes; artifact_sha256 binds the complete referenced artifact."
          }
        }
      },
      "description": "Optional content-addressed source or domain artifacts. Digests bind bytes, not publisher identity, accessibility, or scientific validity."
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "kind",
        "artifact_ref",
        "artifact_sha256",
        "description"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "reproducibility",
            "retrospective_evaluation",
            "prospective_forecast",
            "independent_review"
          ]
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      }
    },
    "retrospectiveEvidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "retrospective_evaluation"
        }
      }
    },
    "forecastEvidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "prospective_forecast"
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "output_classification": {
            "const": "calibrated_simulation"
          }
        },
        "required": [
          "output_classification"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "status": {
                "enum": [
                  "retrospective",
                  "external_review"
                ]
              },
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/retrospectiveEvidence"
                },
                "minContains": 1
              }
            }
          },
          "run_status": {
            "const": "completed"
          },
          "outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "output_classification": {
            "const": "prospective_forecast"
          }
        },
        "required": [
          "output_classification"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "status": {
                "enum": [
                  "prospective",
                  "external_review"
                ]
              },
              "evidence": {
                "contains": {
                  "$ref": "#/$defs/forecastEvidence"
                },
                "minContains": 1
              }
            }
          },
          "run_status": {
            "const": "completed"
          },
          "outputs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine": {
            "properties": {
              "model_identity_kind": {
                "const": "technology_tree_definition"
              }
            },
            "required": [
              "model_identity_kind"
            ]
          }
        },
        "required": [
          "engine"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "required": [
              "scenario_identity_kind",
              "selected_definition_source",
              "resolved_config_sha256",
              "resolved_params_sha256"
            ],
            "properties": {
              "scenario_identity_kind": {
                "const": "canonical_effective_scenario"
              },
              "selected_definition_source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "resolved_config_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "resolved_params_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "engine": {
            "required": [
              "definition_source"
            ],
            "properties": {
              "definition_source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  ]
}
