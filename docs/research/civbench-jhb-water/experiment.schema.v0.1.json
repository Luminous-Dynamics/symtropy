{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/civbench-jhb-water/experiment.schema.v0.1.json",
  "title": "CivBench Johannesburg Water Experiment Protocol v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_id",
    "version",
    "date",
    "status",
    "scope",
    "factors",
    "stages",
    "matching_contract",
    "estimands",
    "hard_gates",
    "statistical_plan",
    "benchmark_targets",
    "provenance_receipt",
    "promotion_gates",
    "limitations",
    "outcome_contract",
    "leak_benchmark_contract"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "protocol_id": {
      "const": "CIVBENCH-JHB-WATER-EXPERIMENT-001"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.0$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "design_only_pre_registration_pending",
        "locked_pre_registration",
        "retired"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "geography",
        "domain",
        "claim_ceiling",
        "reference_sources",
        "evidence_classes",
        "prohibited_inference"
      ],
      "properties": {
        "geography": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "claim_ceiling": {
          "type": "string"
        },
        "reference_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "uri",
              "period",
              "evidence_class",
              "assurance",
              "snapshot_status"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "uri": {
                "type": "string",
                "format": "uri"
              },
              "period": {
                "type": "string"
              },
              "evidence_class": {
                "type": "string"
              },
              "assurance": {
                "type": "string"
              },
              "snapshot_status": {
                "type": "string"
              },
              "render_verification": {
                "type": "string"
              }
            }
          }
        },
        "evidence_classes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "observed_reported",
              "derived",
              "assumption",
              "synthetic_truth"
            ]
          }
        },
        "prohibited_inference": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "factors": {
      "type": "object",
      "required": [
        "G",
        "M",
        "I",
        "H"
      ],
      "properties": {
        "G": {
          "$ref": "#/$defs/factor"
        },
        "M": {
          "$ref": "#/$defs/factor"
        },
        "I": {
          "$ref": "#/$defs/factor"
        },
        "H": {
          "$ref": "#/$defs/factor"
        }
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "confirmatory"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "confirmatory": {
            "type": "boolean"
          },
          "comparisons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "three_way_interaction": {
            "type": "string"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "matching_contract": {
      "type": "object",
      "required": [
        "pairing",
        "fixed_between_arms",
        "resource_ledgers",
        "no_double_spend",
        "endogenous_failures"
      ],
      "properties": {
        "pairing": {
          "type": "string"
        },
        "fixed_between_arms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_ledgers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "no_double_spend": {
          "type": "boolean",
          "const": true
        },
        "endogenous_failures": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "estimands": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "unit",
          "direction"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "distributional": {
            "type": "boolean"
          },
          "requires_water_balance": {
            "type": "boolean"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "hard_gates": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "statistical_plan": {
      "type": "object",
      "required": [
        "unit_of_analysis",
        "pilot_use",
        "minimum_detectable_effect",
        "sample_count",
        "interval",
        "multiple_testing",
        "confirmatory_holdout",
        "uncertainty_types"
      ],
      "properties": {
        "unit_of_analysis": {
          "type": "string"
        },
        "pilot_use": {
          "type": "string"
        },
        "minimum_detectable_effect": {
          "type": "string"
        },
        "sample_count": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "multiple_testing": {
          "type": "string"
        },
        "confirmatory_holdout": {
          "type": "string"
        },
        "uncertainty_types": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "benchmark_targets": {
      "type": "object",
      "required": [
        "accounting_correctness",
        "hydraulic_fidelity",
        "leak_detection",
        "leak_localization",
        "competitive_improvement",
        "sensor_placement",
        "robustness",
        "resilience_performance_curves",
        "hierarchical_hydroinformatics",
        "digital_twin_maturity",
        "leak_validation_integrity"
      ],
      "properties": {
        "accounting_correctness": {
          "type": "string"
        },
        "hydraulic_fidelity": {
          "type": "string"
        },
        "leak_detection": {
          "type": "string"
        },
        "leak_localization": {
          "type": "string"
        },
        "competitive_improvement": {
          "type": "string"
        },
        "sensor_placement": {
          "type": "string"
        },
        "robustness": {
          "type": "string"
        },
        "resilience_performance_curves": {
          "type": "string"
        },
        "hierarchical_hydroinformatics": {
          "type": "string"
        },
        "digital_twin_maturity": {
          "type": "string"
        },
        "leak_validation_integrity": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance_receipt": {
      "type": "object",
      "required": [
        "required_digests",
        "required_versions",
        "missing_digest_behavior",
        "replay"
      ],
      "properties": {
        "required_digests": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "required_versions": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing_digest_behavior": {
          "const": "fail_closed"
        },
        "replay": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "promotion_gates": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      }
    },
    "outcome_contract": {
      "type": "object",
      "required": [
        "metric_evidence_statuses",
        "numeric_value_required_for",
        "numeric_value_absent_for",
        "missing_value_behavior",
        "paired_difference",
        "worst_group_service_ppm_max",
        "cross_status_comparison"
      ],
      "properties": {
        "metric_evidence_statuses": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "numeric_value_required_for": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "numeric_value_absent_for": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "missing_value_behavior": {
          "const": "no_zero_fill"
        },
        "paired_difference": {
          "type": "string"
        },
        "worst_group_service_ppm_max": {
          "type": "integer",
          "const": 1000000
        },
        "cross_status_comparison": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "leak_benchmark_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "dataset_inventory",
        "evaluation_lanes",
        "split_contract",
        "metrics",
        "published_baselines",
        "confidence_contract"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "dataset_inventory": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/leakDataset"
          }
        },
        "evaluation_lanes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "L0_paper_reproduction",
            "L1_full_corpus_scenario_holdout",
            "L2_cross_topology_transfer"
          ],
          "properties": {
            "L0_paper_reproduction": {
              "type": "object",
              "required": [
                "dataset_id",
                "rule",
                "comparison_claim"
              ],
              "properties": {
                "dataset_id": {
                  "type": "string"
                },
                "rule": {
                  "type": "string"
                },
                "comparison_claim": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "L1_full_corpus_scenario_holdout": {
              "type": "object",
              "required": [
                "dataset_ids",
                "rule"
              ],
              "properties": {
                "dataset_ids": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "string"
                  }
                },
                "rule": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "L2_cross_topology_transfer": {
              "type": "object",
              "required": [
                "topology_pairs",
                "rule",
                "claim_limit"
              ],
              "properties": {
                "topology_pairs": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "rule": {
                  "type": "string"
                },
                "claim_limit": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "split_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit_of_split",
            "group_related_scenario_families",
            "related_fields",
            "split_before",
            "partitions",
            "fit_rules",
            "test_label_access",
            "frozen_split_manifest_required",
            "source_archive_digest_required",
            "adaptive_submission_budget"
          ],
          "properties": {
            "unit_of_split": {
              "type": "string",
              "const": "complete_scenario"
            },
            "group_related_scenario_families": {
              "type": "boolean",
              "const": true
            },
            "related_fields": {
              "type": "array",
              "minItems": 6,
              "items": {
                "type": "string"
              }
            },
            "split_before": {
              "type": "array",
              "minItems": 7,
              "items": {
                "type": "string"
              }
            },
            "partitions": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "string"
              }
            },
            "fit_rules": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transforms",
                "hyperparameters",
                "probability_calibration",
                "operating_threshold",
                "sensor_placement",
                "sealed_test"
              ],
              "properties": {
                "transforms": {
                  "type": "string"
                },
                "hyperparameters": {
                  "type": "string"
                },
                "probability_calibration": {
                  "type": "string"
                },
                "operating_threshold": {
                  "type": "string"
                },
                "sensor_placement": {
                  "type": "string"
                },
                "sealed_test": {
                  "type": "string"
                }
              }
            },
            "test_label_access": {
              "type": "string"
            },
            "frozen_split_manifest_required": {
              "type": "boolean",
              "const": true
            },
            "source_archive_digest_required": {
              "type": "boolean",
              "const": true
            },
            "adaptive_submission_budget": {
              "type": "string"
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenario_event_detection",
            "time_series",
            "localization",
            "operations"
          ],
          "properties": {
            "scenario_event_detection": {
              "type": "array",
              "minItems": 10,
              "items": {
                "type": "string"
              }
            },
            "time_series": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string"
              }
            },
            "localization": {
              "type": "array",
              "minItems": 8,
              "items": {
                "type": "string"
              }
            },
            "operations": {
              "type": "array",
              "minItems": 8,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "published_baselines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "paper_id",
              "dataset_id",
              "reported",
              "threshold_calibration_status",
              "code_status",
              "comparability_limit"
            ],
            "properties": {
              "paper_id": {
                "type": "string"
              },
              "dataset_id": {
                "type": "string"
              },
              "reported": {
                "type": "object",
                "additionalProperties": true
              },
              "threshold_calibration_status": {
                "type": "string"
              },
              "code_status": {
                "type": "string"
              },
              "comparability_limit": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "confidence_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "zero_false_positive_interpretation",
            "example_0_of_120_one_sided_95_percent_exact_upper_bound_percent",
            "report_exact_binomial_interval"
          ],
          "properties": {
            "zero_false_positive_interpretation": {
              "type": "string"
            },
            "example_0_of_120_one_sided_95_percent_exact_upper_bound_percent": {
              "type": "number"
            },
            "report_exact_binomial_interval": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "factor": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "levels"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "leakDataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "topology",
        "scenario_count",
        "label_resolution",
        "role",
        "source_refs"
      ],
      "properties": {
        "dataset_id": {
          "type": "string"
        },
        "topology": {
          "type": "string"
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 1
        },
        "label_resolution": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "subset_identity": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
