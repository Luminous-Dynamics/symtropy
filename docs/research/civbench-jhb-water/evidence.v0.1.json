  "sources": [
    {
      "source_id": "DWS_NODROP_RELEASE_2023",
      "publisher": "South African Department of Water and Sanitation",
      "title": "Water and Sanitation releases 2023 full Blue Drop Report",
      "published_at": "2023-12-05",
      "url": "https://www.gov.za/news/media-statements/water-and-sanitation-releases-2023-full-blue-drop-report-05-dec-2023",
      "source_class": "official_government_release",
      "content_digest_status": "not_snapshotted",
      "notes": "Release summary reports national NRW changing from 37% in 2014 to 47% in 2023. Full report should be retrieved before reproducing detailed definitions or municipal tables."
    },
    {
      "source_id": "GOVZA_JOBURG_JOINT_STATEMENT_2024",
      "publisher": "South African Government; joint statement by DWS, Gauteng Office of the Premier, City of Johannesburg and Rand Water",
      "title": "Water and Sanitation, Gauteng Office of the Premier, City of Johannesburg and Rand Water on water challenges in Johannesburg",
      "published_at": "2024-11-11",
      "url": "https://www.gov.za/news/media-statements/water-and-sanitation-gauteng-office-premier-city-johannesburg-and-rand-water",
      "source_class": "official_joint_statement",
      "content_digest_status": "not_snapshotted",
      "notes": "Describes the IVRS-to-Rand Water-to-municipal-reservoir-to-customer supply chain, demand near available bulk supply, and a 35% Johannesburg 'water losses' figure attributed to the 2023 No Drop report. The statement does not reproduce the full metric definition."
    },
    {
      "source_id": "PRESIDENCY_GAUTENG_WATER_TASK_TEAM_2026",
      "publisher": "The Presidency of the Republic of South Africa",
      "title": "Deputy President Paul Mashatile convenes Water Task Team on intervention to stabilise Gauteng water supply",
      "published_at": "2026-02-13",
      "url": "https://www.presidency.gov.za/deputy-president-paul-mashatile-convenes-water-task-team-intervention-stabilise-gauteng-water",
      "source_class": "official_government_statement",
      "content_digest_status": "not_snapshotted",
      "notes": "Reports municipal systems, particularly Johannesburg, remaining under pressure and uses the phrase 'water losses averaging 33%'. The precise denominator, utility scope and accounting definition are not supplied in the statement."
    },
    {
      "source_id": "DWS_IVRS_STORAGE_2026_09",
      "publisher": "South African Department of Water and Sanitation",
      "title": "Water and Sanitation on significant improvement in water storage across the Integrated Vaal River System",
      "published_at": "2026-09-28",
      "url": "https://www.gov.za/news/media-statements/water-and-sanitation-significant-improvement-water-storage-across-integrated",
      "source_class": "official_government_statement",
      "content_digest_status": "not_snapshotted",
      "notes": "Reports IVRS aggregate storage moving from 96.7% in the prior week to 99.7% in the current week. This is an upstream multi-reservoir system indicator, not Johannesburg municipal reservoir level or household continuity."
    },
    {
      "source_id": "SANEWS_GAUTENG_WATER_FRAMEWORK_2026",
      "publisher": "SAnews / Government Communication and Information System",
      "title": "Gauteng adopts plan to cut high water losses",
      "published_at": "2026-10-27",
      "url": "https://www.sanews.gov.za/south-africa/gauteng-adopts-plan-cut-high-water-losses",
      "source_class": "official_government_news_reporting_ministerial_remarks",
      "content_digest_status": "not_snapshotted",
      "notes": "Reports ministerial remarks: Johannesburg NRW about 49%, including physical losses of 26%; also gives national and sector policy targets. Report does not state the underlying measurement period or reproduce the underlying water-balance worksheet."
    },
    {
      "source_id": "JOBURG_WATER_SYSTEMS_STATEMENT_2026_10",
      "publisher": "Johannesburg Water",
      "title": "Johannesburg Water implements urgent interventions to stabilise severely constrained systems",
      "published_at": "2026-10-29",
      "url": "https://www.johannesburgwater.co.za/blog/2026/10/29/johannesburg-water-implements-urgent-interventions-to-stabilise-severely-constrained-systems/",
      "source_class": "official_utility_operational_statement",
      "content_digest_status": "not_snapshotted",
      "notes": "Reports high demand and excessive draw-off limiting reservoir and tower recovery, low pressure, intermittent supply and prolonged outages across named supply systems. It describes network reconfiguration, targeted throttling, leak detection and repairs as interventions; it is not an independently audited outcome evaluation."
    },
    {
      "source_id": "AWWA_WATER_LOSS_CONTROL",
      "publisher": "American Water Works Association",
      "title": "Water Loss Control",
      "published_at": null,
      "url": "https://www.awwa.org/resource/water-loss-control/",
      "source_class": "industry_methodology",
      "content_digest_status": "not_snapshotted",
      "notes": "AWWA describes its M36 Water Audits and Loss Control Program and Water Audit Software; its page reports Water Audit Software v6.1 released in 2025 with carbon calculations and carbon balance."
    },
    {
      "source_id": "WORLDBANK_IWA_NEWIBNET_2025",
      "publisher": "World Bank / International Water Association NewIBNET",
      "title": "Data Pioneers in Water Utilities - Bangkok",
      "published_at": "2025",
      "url": "https://connect4impact.worldbank.org/bangkok_initiative",
      "source_class": "industry_benchmarking_framework",
      "content_digest_status": "not_snapshotted",
      "notes": "Describes 15 utility KPIs including coverage, continuity, 24/7 supply, NRW percentage and litres per connection per hour, metering, water quality, complaints resolved and operation-cost coverage."
    },
    {
      "source_id": "DWS_BENCHMARKING_2023_WATER_BALANCE",
      "publisher": "South African Department of Water and Sanitation",
      "title": "The Status of Water Losses, Non-Revenue Water & Water Use Efficiency in South African Municipalities (2012/13 to 2022/23)",
      "published_at": "2023-11",
      "url": "https://www.dws.gov.za/Projects/wueew/documents/webinfo/2023%20Benchmarking%20Report.pdf",
      "source_class": "official_technical_benchmarking_report",
      "content_digest_status": "not_snapshotted",
      "notes": "The report presents 2022/23 municipal water balances, NRW, water losses, consumption and Infrastructure Leakage Index. It describes confidence grading and limitations: 88 datasets (61% of the 144 WSAs) were received; confidence among received datasets was reported as 55% high, 18% medium and 27% low. City of Johannesburg's Table 10 metro row reports SIV 634,461,668 kL/year, revenue water 328,709,771 kL/year, NRW 305,751,897 kL/year, NRW share 48.2%, 280 litres/capita/day and ILI 9.3. Source bytes have not yet been snapshotted."
    },
    {
      "source_id": "DWS_NO_DROP_AUDIT_2023",
      "publisher": "South African Department of Water and Sanitation",
      "title": "2023 No Drop Report",
      "published_at": "2023-12-05",
      "url": "https://www.dws.gov.za/Projects/wueew/documents/webinfo/ND_2023_Report.pdf",
      "source_class": "official_regulatory_audit_report",
      "content_digest_status": "not_snapshotted",
      "notes": "Johannesburg scorecard is based on the 2021/22 audit period. The City received an overall No Drop score of 72%: strategy/planning/implementation 91%, asset management 50%, technical skills 80%, compliance/performance 24%, weighted subtotal 62%, plus a 10% bonus. It notes high-integrity IWA water balance, insufficient consumer meter maintenance interventions and no evidence of a leak-repair schedule for the audit period. The No Drop score is an institutional/regulatory assessment, not a water-loss percentage."
    },
    {
      "source_id": "JOHANNESBURG_WATER_AR_2023_24",
      "publisher": "Johannesburg Water (SOC) Limited",
      "title": "Johannesburg Water Annual Report 2023/2024",
      "published_at": "2025-02-20",
      "url": "https://www.johannesburgwater.co.za/wp-content/uploads/2025/02/FINAL-JOHANNESBURG-WATER-ANNUAL-REPORT-23_2024-20-02-2025.pdf",
      "source_class": "official_utility_annual_report_and_audited_financial_statements",
      "content_digest_status": "not_snapshotted",
      "notes": "The report's annual performance narrative and Note 27 report FY2023/24 NRW 46.18% (2023: 46.11%), comprising 24.83% physical losses, 9.66% commercial losses and 11.69% unbilled authorised consumption. Combined physical and commercial losses are 34.49% (2023: 33.41%); these are part of NRW, not the same metric as total NRW. The annual report also states a 35% NRW target, which is distinct from the approximately 35% water-loss shorthand."
    }
  ],
