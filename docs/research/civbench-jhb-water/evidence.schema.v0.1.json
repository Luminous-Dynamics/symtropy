{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/civbench.jhb_water_evidence.v0.1.schema.json",
  "title": "CivBench Johannesburg Water Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiled_at",
    "retrieved_at",
    "claim_ceiling",
    "sources",
    "observations",
    "relationships",
    "targets",
    "comparability_rules",
    "benchmark_alignment"
  ],
  "properties": {
    "schema_version": {
      "const": "civbench.jhb_water_evidence.v0.1"
    },
    "compiled_at": {
      "type": "string",
      "format": "date"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "publisher",
          "title",
          "published_at",
          "url",
          "source_class",
          "content_digest_status",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source_class": {
            "type": "string",
            "minLength": 1
          },
          "content_digest_status": {
            "enum": [
              "not_snapshotted",
              "snapshotted",
              "digest_verified"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "source_id",
          "metric_code",
          "value",
          "unit",
          "geography",
          "system_boundary",
          "observation_period",
          "publication_date",
          "evidence_status",
          "denominator",
          "definition_status",
          "comparability_group"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "source_id": {
            "type": "string"
          },
          "metric_code": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "geography": {
            "type": "string"
          },
          "system_boundary": {
            "type": "string"
          },
          "observation_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_date": {
            "type": "string",
            "format": "date"
          },
          "evidence_status": {
            "type": "string"
          },
          "denominator": {
            "type": [
              "string",
              "null"
            ]
          },
          "definition_status": {
            "type": "string"
          },
          "comparability_group": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relationship",
          "subject_observation_id",
          "object_observation_id",
          "interpretation"
        ],
        "additionalProperties": false,
        "properties": {
          "relationship": {
            "type": "string"
          },
          "subject_observation_id": {
            "type": "string"
          },
          "object_observation_id": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "source_id",
          "metric_code",
          "operator",
          "value",
          "unit",
          "geography",
          "target_date",
          "status"
        ],
        "properties": {
          "target_id": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "metric_code": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "geography": {
            "type": "string"
          },
          "target_date": {
            "type": "string"
          },
          "status": {
            "const": "policy_target"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "comparability_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "benchmark_alignment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
