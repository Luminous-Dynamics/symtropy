{
  "schema": "AeroIndependentAssuranceBenchmarkV0_3",
  "benchmark_id": "AERO-IAB-STRUCTURAL-COMPONENT-001",
  "status": "PROSPECTIVE_NOT_EXECUTED",
  "oracle_status": "NOT_INDEPENDENTLY_ADJUDICATED",
  "domain": "structural_material_component_evidence",
  "authority_ceiling": "research_only_no_physical_qualification_or_certification",
  "independence_unit": "independently_sourced_engineering_episode_or_root_cause_family",
  "partitions": {
    "train": "root-cause-family-disjoint",
    "development": "root-cause-family-disjoint",
    "visible_challenge": "root-cause-family-disjoint",
    "blind_test": "custodian-held-root-cause-family-disjoint"
  },
  "families": [
    {
      "id": "claim_context",
      "primary_metrics": [
        "hard_gate_false_review_rate",
        "cross_context_substitution_acceptance_rate",
        "mandatory_obligation_bypass_rate",
        "reason_code_agreement"
      ]
    },
    {
      "id": "provenance_authority",
      "primary_metrics": [
        "unauthorized_producer_acceptance_rate",
        "payload_record_binding_error_rate",
        "receipt_replay_acceptance_rate"
      ]
    },
    {
      "id": "temporal_policy",
      "primary_metrics": [
        "historical_disposition_agreement",
        "late_evidence_historical_knowledge_error_rate",
        "correction_chain_preservation_rate"
      ]
    },
    {
      "id": "model_applicability",
      "primary_metrics": [
        "unsupported_model_domain_false_review_rate",
        "missing_required_stratum_acceptance_rate",
        "validation_split_leakage_detection_rate",
        "applicability_boundary_agreement"
      ]
    },
    {
      "id": "change_impact_observation",
      "primary_metrics": [
        "affected_claim_recall",
        "false_preservation_under_unknown_coverage_rate",
        "unnecessary_requalification_rate",
        "observer_unknown_propagation_rate"
      ]
    },
    {
      "id": "reproducibility",
      "primary_metrics": [
        "fully_disclosed_independent_replay_success_rate",
        "undeclared_replay_dependency_rate",
        "reproducibility_classification_correctness"
      ]
    },
    {
      "id": "evidence_acquisition",
      "primary_metrics": [
        "expert_top_k_action_agreement",
        "cost_adjusted_information_gain",
        "unauthorized_action_recommendation_rate"
      ]
    }
  ],
  "thresholds": [
    {
      "metric": "hard_gate_false_review_rate",
      "target": 0,
      "unit": "proportion",
      "operator": "maximum",
      "critical": true
    },
    {
      "metric": "cross_context_substitution_acceptance_rate",
      "target": 0,
      "unit": "proportion",
      "operator": "maximum",
      "critical": true
    },
    {
      "metric": "unauthorized_producer_acceptance_rate",
      "target": 0,
      "unit": "proportion",
      "operator": "maximum",
      "critical": true
    },
    {
      "metric": "mandatory_obligation_bypass_rate",
      "target": 0,
      "unit": "proportion",
      "operator": "maximum",
      "critical": true
    },
    {
      "metric": "unsupported_model_domain_false_review_rate",
      "target": 0,
      "unit": "proportion",
