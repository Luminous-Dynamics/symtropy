          "type": "string",
          "minLength": 1,
          "pattern": "^\\\\S.*\\\\S$|^\\\\S$"
        },
        "configuration_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\\\S.*\\\\S$|^\\\\S$"
