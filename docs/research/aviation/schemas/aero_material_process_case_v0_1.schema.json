{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-material-process-case-v0.1.json",
  "title": "AERO Material and Process Qualification Case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "profile_id",
    "synthetic_only",
    "claim_ceiling",
    "hierarchy",
    "observations",
    "partition_contract",
    "known_truth"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "const": "aero-material-process-qual-v0.1"
    },
    "synthetic_only": {
      "const": true
    },
    "claim_ceiling": {
      "const": "synthetic_contract_test_only"
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_lots",
        "process_batches",
        "panels",
        "specimens",
        "test_campaigns",
        "configurations"
      ],
      "properties": {
        "material_lots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/materialLot"
          }
        },
        "process_batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/processBatch"
          }
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "specimens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specimen"
          }
        },
        "test_campaigns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/campaign"
          }
        },
        "configurations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/configuration"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "partition_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_id",
        "grouping_levels",
        "assignments"
      ],
      "properties": {
        "partition_id": {
          "type": "string",
          "minLength": 1
        },
        "grouping_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "material_lot",
              "process_batch",
              "panel",
              "test_campaign",
              "configuration"
            ]
          }
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "specimen_id",
              "partition"
            ],
            "properties": {
              "specimen_id": {
                "type": "string",
                "minLength": 1
              },
              "partition": {
                "enum": [
                  "train",
                  "holdout",
                  "challenge"
                ]
              }
            }
          }
        }
      }
    },
    "known_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_id",
        "not_a_physical_model",
        "baseline_index",
        "lot_effects",
        "batch_effects",
        "panel_effects",
        "measurement_noise_index",
        "out_of_domain_offset_index"
      ],
      "properties": {
        "generator_id": {
          "type": "string",
          "minLength": 1
        },
        "not_a_physical_model": {
          "const": true
        },
        "baseline_index": {
          "type": "number"
        },
        "lot_effects": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "batch_effects": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "panel_effects": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "measurement_noise_index": {
          "type": "number",
          "minimum": 0
        },
        "out_of_domain_offset_index": {
          "type": "number"
        }
      }
    }
  },
  "$defs": {
    "materialLot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "supplier_label",
        "material_system_label",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "supplier_label": {
          "type": "string",
          "minLength": 1
        },
        "material_system_label": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "disputed",
            "unknown"
          ]
        }
      }
    },
    "processBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "material_lot_id",
        "recipe_revision_id",
        "machine_id",
        "tooling_id",
        "site_id",
        "process_state",
        "nominal_control_index",
        "realized_control_index"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "material_lot_id": {
          "type": "string",
          "minLength": 1
        },
        "recipe_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "machine_id": {
          "type": "string",
          "minLength": 1
        },
        "tooling_id": {
          "type": "string",
          "minLength": 1
        },
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "process_state": {
          "enum": [
            "in_domain",
            "out_of_domain",
            "unknown"
          ]
        },
        "nominal_control_index": {
          "type": "number"
        },
        "realized_control_index": {
          "type": "number"
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "process_batch_id",
        "panel_revision_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "process_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "panel_revision_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "specimen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "panel_id",
        "configuration_id",
        "geometry_profile_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "panel_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "geometry_profile_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol_revision_id",
        "instrument_id",
        "calibration_id",
        "calibration_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "protocol_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_state": {
          "enum": [
            "active",
            "expired",
            "unknown"
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "product_definition_revision_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "product_definition_revision_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "specimen_id",
        "campaign_id",
        "quantity",
        "unit",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "const": "response_index"
        },
        "unit": {
          "const": "synthetic_index"
        },
        "status": {
          "enum": [
            "observed",
            "censored",
            "excluded",
            "missing"
          ]
        },
        "value_index": {
          "type": "number"
        },
        "censoring_limit_index": {
          "type": "number"
        },
        "standard_uncertainty_index": {
          "type": "number",
          "minimum": 0
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            }
          },
          "then": {
            "required": [
              "value_index",
              "standard_uncertainty_index"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "censored"
              }
            }
          },
          "then": {
            "required": [
              "censoring_limit_index",
              "reason_code"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "excluded",
                  "missing"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason_code"
            ]
          }
        }
      ]
    }
  }
}
