{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-independent-assurance-benchmark-v0.3.schema.json",
  "title": "AERO Independent Assurance Benchmark Registry v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "status",
    "oracle_status",
    "domain",
    "authority_ceiling",
    "independence_unit",
    "partitions",
    "families",
    "thresholds",
    "statistical_notes",
    "baselines",
    "release_gates",
    "metric_definitions",
    "statistical_protocol"
  ],
  "properties": {
    "schema": {
      "const": "AeroIndependentAssuranceBenchmarkV0_3"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PROSPECTIVE_NOT_EXECUTED"
    },
    "oracle_status": {
      "const": "NOT_INDEPENDENTLY_ADJUDICATED"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "authority_ceiling": {
      "const": "research_only_no_physical_qualification_or_certification"
    },
    "independence_unit": {
      "type": "string",
      "minLength": 1
    },
    "partitions": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "families": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "primary_metrics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "primary_metrics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "target",
          "unit",
          "critical",
          "operator"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "target": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "operator": {
            "enum": [
              "minimum",
              "maximum"
            ]
          },
          "applies_after": {
            "type": "string"
          }
        }
      }
    },
    "statistical_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zero_failure_upper_95_approx",
        "n_for_1_percent",
        "n_for_0_1_percent",
        "n_for_0_01_percent",
        "caveat"
      ],
      "properties": {
        "zero_failure_upper_95_approx": {
          "type": "string",
          "minLength": 10
        },
        "n_for_1_percent": {
          "const": 299
        },
        "n_for_0_1_percent": {
          "const": 2995
        },
        "n_for_0_01_percent": {
          "const": 29956
        },
        "caveat": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metric_definitions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "numerator",
          "denominator",
          "unit",
          "optimization",
          "population",
          "independence_unit",
          "gating",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "numerator": {
            "type": "string",
            "minLength": 10
          },
          "denominator": {
            "type": "string",
            "minLength": 10
          },
          "unit": {
            "enum": [
              "proportion",
              "ratio",
              "normalized_utility_per_cost",
              "seconds",
              "minutes",
              "currency"
            ]
          },
          "optimization": {
            "enum": [
              "minimize",
              "maximize"
            ]
          },
          "population": {
            "type": "string",
            "minLength": 3
          },
          "independence_unit": {
            "type": "string",
            "minLength": 3
          },
          "gating": {
            "enum": [
              "hard_gate",
              "qualification",
              "economic",
              "diagnostic"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "statistical_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "confidence_level",
        "alpha",
        "zero_adverse_event_upper_bound_formula",
        "sample_size_for_zero_adverse_events_formula",
        "required_independent_units_for_zero_adverse_events",
        "statistical_unit",
        "cluster_policy",
        "stratum_policy",
        "confidence_reporting",
        "zero_denominator",
        "nonzero_events",
        "status"
      ],
      "properties": {
        "method": {
          "const": "one_sided_exact_binomial_clopper_pearson"
        },
        "confidence_level": {
          "const": 0.95
        },
        "alpha": {
          "const": 0.05
        },
        "zero_adverse_event_upper_bound_formula": {
          "const": "1 - alpha^(1/n)"
        },
        "sample_size_for_zero_adverse_events_formula": {
          "const": "ceil(log(alpha) / log(1 - target_adverse_event_probability))"
        },
        "required_independent_units_for_zero_adverse_events": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_upper_adverse_event_probability",
              "required_independent_units"
            ],
            "properties": {
              "target_upper_adverse_event_probability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 1
              },
              "required_independent_units": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "statistical_unit": {
          "type": "string",
          "minLength": 20
        },
        "cluster_policy": {
          "type": "string",
          "minLength": 20
        },
        "stratum_policy": {
          "type": "string",
          "minLength": 20
        },
        "confidence_reporting": {
          "type": "string",
          "minLength": 20
        },
        "zero_denominator": {
          "type": "string",
          "minLength": 10
        },
        "nonzero_events": {
          "type": "string",
          "minLength": 10
        },
        "status": {
          "const": "PROSPECTIVE_PREREGISTERED_NOT_EXECUTED"
        }
      }
    }
  }
}
