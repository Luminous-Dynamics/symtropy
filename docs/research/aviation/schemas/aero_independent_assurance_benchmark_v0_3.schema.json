{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-independent-assurance-benchmark-v0.3.schema.json",
  "title": "AERO Independent Assurance Benchmark Registry v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "status",
    "oracle_status",
    "domain",
    "authority_ceiling",
    "independence_unit",
    "partitions",
    "families",
    "thresholds",
    "statistical_notes",
    "baselines",
    "release_gates",
    "metric_definitions"
  ],
  "properties": {
    "schema": {
      "const": "AeroIndependentAssuranceBenchmarkV0_3"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PROSPECTIVE_NOT_EXECUTED"
    },
    "oracle_status": {
      "const": "NOT_INDEPENDENTLY_ADJUDICATED"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "authority_ceiling": {
      "const": "research_only_no_physical_qualification_or_certification"
    },
    "independence_unit": {
      "type": "string",
      "minLength": 1
    },
    "partitions": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "families": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "primary_metrics"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "primary_metrics": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "target",
          "unit",
          "critical",
          "operator"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "target": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "operator": {
            "enum": [
              "minimum",
              "maximum"
            ]
          },
          "applies_after": {
            "type": "string"
          }
        }
      }
    },
    "statistical_notes": {
      "type": "object",
      "required": [
        "zero_failure_upper_95_approx",
        "n_for_1_percent",
        "n_for_0_1_percent",
        "n_for_0_01_percent",
        "caveat"
      ],
      "properties": {
        "zero_failure_upper_95_approx": {
          "type": "string"
        },
        "n_for_1_percent": {
          "type": "integer",
          "minimum": 1
        },
        "n_for_0_1_percent": {
          "type": "integer",
          "minimum": 1
        },
        "n_for_0_01_percent": {
          "type": "integer",
          "minimum": 1
        },
        "caveat": {
          "type": "string"
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "metric_definitions": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "numerator",
          "denominator",
          "unit",
          "optimization",
          "population",
          "independence_unit",
          "gating",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "numerator": {
            "type": "string",
            "minLength": 10
          },
          "denominator": {
            "type": "string",
            "minLength": 10
          },
          "unit": {
            "enum": [
              "proportion",
              "ratio",
              "normalized_utility_per_cost",
              "seconds",
              "minutes",
              "currency"
            ]
          },
          "optimization": {
            "enum": [
              "minimize",
              "maximize"
            ]
          },
          "population": {
            "type": "string",
            "minLength": 3
          },
          "independence_unit": {
            "type": "string",
            "minLength": 3
          },
          "gating": {
            "enum": [
              "hard_gate",
              "qualification",
              "economic",
              "diagnostic"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
