{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-assurance-source-binding-v0.1.schema.json",
  "title": "AERO Assurance Source Binding v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "authority_ceiling",
    "claim_specification",
    "decision_context",
    "trust_policy",
    "model_credibility_cut",
    "observer_coverage",
    "obligations",
    "case_partition",
    "owner_evidence_cuts",
    "replay_mode"
  ],
  "properties": {
    "schema": {
      "const": "AeroAssuranceSourceBindingV0_1"
    },
    "version": {
      "const": "0.1"
    },
    "status": {
      "const": "PROPOSED_NOT_INDEPENDENTLY_ADJUDICATED"
    },
    "authority_ceiling": {
      "const": "research_only_no_physical_qualification_certification_or_work_authorization"
    },
    "claim_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification_id",
        "claim_id",
        "sha256",
        "canonicalization_profile",
        "assessment_disposition",
        "acceptance_authority_role_ref"
      ],
      "properties": {
        "specification_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "canonicalization_profile": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "assessment_disposition": {
          "enum": [
            "FORMALLY_WELL_SPECIFIED",
            "INCOMPLETE",
            "REJECTED",
            "UNSUPPORTED_PROFILE"
          ]
        },
        "acceptance_authority_role_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        }
      }
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "claim_id",
        "subject_ref",
        "configuration_ref",
        "operating_envelope_ref",
        "acquisition_interval",
        "as_known_at_unix_ms",
        "source_scope_manifest_sha256",
        "evidence_knowledge_cut_sha256",
        "required_evidence_manifest_sha256",
        "risk_classification_sha256",
        "model_applicability_profile_sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "configuration_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "operating_envelope_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "acquisition_interval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "earliest_unix_ms",
            "latest_unix_ms"
          ],
          "properties": {
            "earliest_unix_ms": {
              "type": "integer",
              "minimum": 0
            },
            "latest_unix_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "as_known_at_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "source_scope_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "evidence_knowledge_cut_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "required_evidence_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "risk_classification_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "model_applicability_profile_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "trust_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_sha256",
        "effective_from_unix_ms",
        "effective_until_unix_ms",
        "receiver_first_seen_at_unix_ms",
        "policy_events"
      ],
      "properties": {
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "effective_from_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "effective_until_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "receiver_first_seen_at_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "policy_events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_ref",
              "event_type",
              "subject_ref",
              "asserted_at_unix_ms",
              "effective_at_unix_ms",
              "receiver_first_seen_at_unix_ms"
            ],
            "properties": {
              "event_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S.*\\S$|^\\S$"
              },
              "event_type": {
                "enum": [
                  "KEY_ISSUED",
                  "KEY_ROTATED",
                  "KEY_REVOKED",
                  "ROLE_GRANTED",
                  "ROLE_REVOKED",
                  "POLICY_AMENDED",
                  "POLICY_WITHDRAWN"
                ]
              },
              "subject_ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\S.*\\S$|^\\S$"
              },
              "asserted_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "effective_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              },
              "receiver_first_seen_at_unix_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "model_credibility_cut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "sha256",
        "model_ref",
        "model_artifact_sha256",
        "solver_configuration_sha256",
        "validation_package_sha256",
        "validation_protocol_sha256",
        "applicability_profile_sha256",
        "domain_coverage_status",
        "split_integrity_status"
      ],
      "properties": {
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "model_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "model_artifact_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "solver_configuration_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "validation_package_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "validation_protocol_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "applicability_profile_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "domain_coverage_status": {
          "enum": [
            "QUALIFIED_COMPLETE_FOR_SCOPE",
            "INCOMPLETE",
            "UNVERIFIED",
            "OUT_OF_SCOPE"
          ]
        },
        "split_integrity_status": {
          "enum": [
            "INTACT",
            "LEAKAGE_DETECTED",
            "UNVERIFIED",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "observer_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "receipt_sha256",
        "status",
        "scope_manifest_sha256",
        "watermark_unix_ms",
        "covered_change_classes"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "QUALIFIED_COMPLETE_FOR_SCOPE",
            "INCOMPLETE",
            "UNVERIFIED",
            "OUT_OF_SCOPE"
          ]
        },
        "scope_manifest_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "watermark_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "covered_change_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S.*\\S$|^\\S$"
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_id",
          "kind",
          "requirement_source_ref",
          "mandatory",
          "hard_gate",
          "evidence_bindings"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S.*\\S$|^\\S$"
          },
          "kind": {
            "enum": [
              "CLAIM_IDENTITY",
              "EVIDENCE_INTEGRITY",
              "PRODUCER_AUTHORITY",
              "SEMANTIC_VALIDITY",
              "MODEL_APPLICABILITY",
              "MODEL_CREDIBILITY",
              "TEMPORAL_KNOWLEDGE",
              "DEPENDENCY_OBSERVATION",
              "DEFEATER_RESOLUTION",
              "INDEPENDENT_REPLAY"
            ]
          },
          "requirement_source_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S.*\\S$|^\\S$"
          },
          "mandatory": {
            "type": "boolean"
          },
          "hard_gate": {
            "type": "boolean"
          },
          "evidence_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_ref",
                "owner_namespace",
                "owner_record_sha256",
                "subject_ref",
                "configuration_ref",
                "producer_ref",
                "producer_role_ref",
                "payload_sha256",
                "issuer_asserted_at_unix_ms",
                "receiver_first_seen_at_unix_ms",
                "owner_receipt_ref",
                "owner_receipt_sha256",
                "lifecycle",
                "freshness",
                "dependency_coverage",
                "admission_state",
                "verification_state",
                "verification_report_sha256"
              ],
              "properties": {
                "evidence_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S.*\\S$|^\\S$"
                },
                "owner_namespace": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S.*\\S$|^\\S$"
                },
                "owner_record_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "subject_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S.*\\S$|^\\S$"
                },
                "configuration_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S.*\\S$|^\\S$"
                },
                "producer_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S.*\\S$|^\\S$"
                },
                "producer_role_ref": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S.*\\S$|^\\S$"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "issuer_asserted_at_unix_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "receiver_first_seen_at_unix_ms": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "owner_receipt_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "owner_receipt_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "lifecycle": {
                  "enum": [
                    "ACTIVE",
                    "SUPERSEDED",
                    "DISPUTED",
                    "REVOKED",
                    "WITHDRAWN"
                  ]
                },
                "freshness": {
                  "enum": [
                    "FRESH",
                    "STALE_DIRECT",
                    "STALE_TRANSITIVE"
                  ]
                },
                "dependency_coverage": {
                  "enum": [
                    "COMPLETE",
                    "INCOMPLETE",
                    "UNKNOWN"
                  ]
                },
                "admission_state": {
                  "enum": [
                    "ADMITTED",
                    "UNVERIFIED",
                    "REJECTED",
                    "NOT_RECEIVED"
                  ]
                },
                "verification_state": {
                  "enum": [
                    "VERIFIED",
                    "FAILED",
                    "UNVERIFIED",
                    "NOT_RUN"
                  ]
                },
                "verification_report_sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "event_effective_interval": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "earliest_unix_ms",
                    "latest_unix_ms"
                  ],
                  "properties": {
                    "earliest_unix_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "latest_unix_ms": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "case_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause_family_id",
        "partition",
        "independence_unit"
      ],
      "properties": {
        "root_cause_family_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\S.*\\S$|^\\S$"
        },
        "partition": {
          "enum": [
            "TRAIN",
            "DEVELOPMENT",
            "VISIBLE_CHALLENGE",
            "BLIND_TEST"
          ]
        },
        "independence_unit": {
          "const": "INDEPENDENT_ENGINEERING_EPISODE_OR_ROOT_CAUSE_FAMILY"
        }
      }
    },
    "owner_evidence_cuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha256",
          "owner_namespace",
          "receiver_receipt_manifest_sha256",
          "receiver_receipt_watermark_unix_ms"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "owner_namespace": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S.*\\S$|^\\S$"
          },
          "receiver_receipt_manifest_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "receiver_receipt_watermark_unix_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "replay_mode": {
      "enum": [
        "HISTORICAL_AS_KNOWN",
        "CURRENT_POLICY_COUNTERFACTUAL",
        "CURRENT_AS_KNOWN"
      ]
    }
  }
}
