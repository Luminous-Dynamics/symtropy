{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-model-evidence-challenge-corpus-v0.1.schema.json",
  "title": "AERO Model-Evidence Independent Challenge Corpus v0.1",
  "description": "Public development seed. Proposed dispositions are not independent adjudications or executed results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "corpus_id",
    "oracle_review_status",
    "execution_status",
    "corpus_scope",
    "case_count",
    "temporal_modes",
    "cases"
  ],
  "properties": {
    "schema_id": {
      "const": "AERO_MODEL_EVIDENCE_CHALLENGE_CORPUS_V0_1"
    },
    "schema_version": {
      "const": "0.1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_review_status": {
      "const": "NOT_INDEPENDENTLY_REVIEWED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "corpus_scope": {
      "const": "PUBLIC_DEVELOPMENT_SEED_NOT_BLINDED_HOLDOUT"
    },
    "case_count": {
      "const": 24
    },
    "temporal_modes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AS_KNOWN_AT",
          "RECOMPUTED_WITH_CURRENT_TRUST",
          "RECOMPUTED_WITH_CURRENT_EVIDENCE_AND_TRUST"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "disposition": {
      "enum": [
        "ELIGIBLE_FOR_AERO_COMPOSITION",
        "REJECTED",
        "UNVERIFIED",
        "INCOMPLETE",
        "OUT_OF_SCOPE",
        "NOT_KNOWN_AT_SNAPSHOT"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "case_type",
        "mutations",
        "proposed_disposition",
        "proposed_reason_codes",
        "oracle_rationale",
        "owner_boundary",
        "adjudication_status",
        "execution_status",
        "partition"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
        },
        "family": {
          "enum": [
            "payload_integrity",
            "producer_authority",
            "semantic_validation",
            "applicability",
            "receiver_time",
            "owner_freshness",
            "historical_trust"
          ]
        },
        "case_type": {
          "enum": [
            "positive_control",
            "single_fault",
            "coupled_fault",
            "metamorphic"
          ]
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 5
        },
        "proposed_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "proposed_reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "oracle_rationale": {
          "type": "string",
          "minLength": 20
        },
        "owner_boundary": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_status": {
          "const": "PROPOSED_NOT_ADJUDICATED"
        },
        "execution_status": {
          "const": "NOT_EXECUTED"
        },
        "partition": {
          "const": "PUBLIC_DEVELOPMENT"
        },
        "expected_by_temporal_mode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "AS_KNOWN_AT",
            "RECOMPUTED_WITH_CURRENT_TRUST",
            "RECOMPUTED_WITH_CURRENT_EVIDENCE_AND_TRUST"
          ],
          "properties": {
            "AS_KNOWN_AT": {
              "$ref": "#/$defs/disposition"
            },
            "RECOMPUTED_WITH_CURRENT_TRUST": {
              "$ref": "#/$defs/disposition"
            },
            "RECOMPUTED_WITH_CURRENT_EVIDENCE_AND_TRUST": {
              "$ref": "#/$defs/disposition"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "case_type": {
                "const": "positive_control"
              }
            },
            "required": [
              "case_type"
            ]
          },
          "then": {
            "properties": {
              "mutations": {
                "maxItems": 0
              },
              "proposed_reason_codes": {
                "maxItems": 0
              },
              "proposed_disposition": {
                "const": "ELIGIBLE_FOR_AERO_COMPOSITION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_type": {
                "enum": [
                  "single_fault",
                  "coupled_fault"
                ]
              }
            },
            "required": [
              "case_type"
            ]
          },
          "then": {
            "properties": {
              "mutations": {
                "minItems": 1
              },
              "proposed_reason_codes": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
