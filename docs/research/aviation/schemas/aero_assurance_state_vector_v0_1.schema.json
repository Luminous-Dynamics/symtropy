{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-assurance-state-vector-v0.1.schema.json",
  "title": "AERO Assurance State Vector v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "semantics_version",
    "status",
    "authority_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "AeroAssuranceStateVectorV0_1"
    },
    "semantics_version": {
      "const": "0.1"
    },
    "status": {
      "const": "PROPOSED_NOT_INDEPENDENTLY_ADJUDICATED"
    },
    "authority_ceiling": {
      "const": "review_only_no_physical_qualification_certification_or_work_authorization"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "description",
          "replay_mode",
          "claim_context",
          "obligations",
          "defeaters",
          "expected_disposition",
          "expected_blocking_obligation_ids",
          "expected_reason_codes"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^ASV[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 12
          },
          "replay_mode": {
            "enum": [
              "HISTORICAL_AS_KNOWN",
              "CURRENT_POLICY_COUNTERFACTUAL",
              "CURRENT_AS_KNOWN"
            ]
          },
          "claim_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "physical_subject_ref",
              "configuration_ref",
              "as_known_cutoff",
              "trust_policy_snapshot_digest"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "physical_subject_ref": {
                "type": "string",
                "minLength": 1
              },
              "configuration_ref": {
                "type": "string",
                "minLength": 1
              },
              "as_known_cutoff": {
                "type": "string",
                "format": "date-time"
              },
              "trust_policy_snapshot_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "obligation_id",
                "kind",
                "mandatory",
                "hard_gate",
                "proposition_evidence",
                "applicability",
                "authority",
                "temporal_knowledge",
                "observer_coverage",
                "verification",
                "evidence_refs",
                "reason_codes"
              ],
              "properties": {
                "obligation_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "CLAIM_IDENTITY",
                    "EVIDENCE_INTEGRITY",
                    "PRODUCER_AUTHORITY",
                    "SEMANTIC_VALIDITY",
                    "MODEL_APPLICABILITY",
                    "MODEL_CREDIBILITY",
                    "TEMPORAL_KNOWLEDGE",
                    "DEPENDENCY_OBSERVATION",
                    "DEFEATER_RESOLUTION",
                    "INDEPENDENT_REPLAY"
                  ]
                },
                "mandatory": {
                  "type": "boolean"
                },
                "hard_gate": {
                  "type": "boolean"
                },
                "proposition_evidence": {
                  "enum": [
                    "NEITHER",
                    "SUPPORTED_ONLY",
                    "REFUTED_ONLY",
                    "BOTH"
                  ]
                },
                "applicability": {
                  "enum": [
                    "IN_SCOPE",
                    "OUT_OF_SCOPE",
                    "UNKNOWN"
                  ]
                },
                "authority": {
                  "enum": [
                    "AUTHORIZED",
                    "DENIED",
                    "UNKNOWN",
                    "NOT_REQUIRED"
                  ]
                },
                "temporal_knowledge": {
                  "enum": [
                    "KNOWN_AT_CUTOFF",
                    "NOT_KNOWN_AT_CUTOFF",
                    "TEMPORAL_CONFLICT",
                    "NOT_TEMPORAL"
                  ]
                },
                "observer_coverage": {
                  "enum": [
                    "COMPLETE",
                    "INCOMPLETE",
                    "UNKNOWN",
                    "NOT_APPLICABLE"
                  ]
                },
                "verification": {
                  "enum": [
                    "VERIFIED",
                    "FAILED",
                    "UNVERIFIED",
                    "NOT_RUN"
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "reason_codes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "defeaters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "defeater_id",
                "status",
                "materiality",
                "evidence_refs",
                "reason_codes"
              ],
              "properties": {
                "defeater_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "CANDIDATE",
                    "UNRESOLVED",
                    "CONFIRMED",
                    "REFUTED",
                    "DISMISSED"
                  ]
                },
                "materiality": {
                  "enum": [
                    "BLOCKING",
                    "ADVISORY"
                  ]
                },
                "evidence_refs": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "reason_codes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "expected_disposition": {
            "enum": [
              "REJECTED",
              "OUT_OF_SCOPE",
              "NOT_KNOWN_AT_SNAPSHOT",
              "UNVERIFIED",
              "INCOMPLETE",
              "REVIEWABLE_FOR_INDEPENDENT_DECISION"
            ]
          },
          "expected_blocking_obligation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "expected_reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
