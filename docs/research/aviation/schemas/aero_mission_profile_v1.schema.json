{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminousdynamics:aero:mission-profile:v1",
  "title": "Aero mission profile v1",
  "description": "A frozen service and operating-envelope contract for matched aircraft-family comparisons. It contains no aircraft performance claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "revision",
    "data_origin",
    "claim_ceiling",
    "service",
    "route",
    "operating_envelope",
    "reserve",
    "infrastructure",
    "ground_comparator",
    "candidate_families",
    "hard_constraints",
    "sources",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "aero-mission-profile/v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "data_origin": {
      "enum": [
        "synthetic",
        "measured",
        "manufacturer",
        "public_dataset",
        "mixed"
      ]
    },
    "claim_ceiling": {
      "enum": [
        "synthetic_architecture_screening",
        "analytic_bounded_fixture",
        "model_based_research",
        "sil_research",
        "hil_research",
        "component_bench_research",
        "flight_test_research",
        "externally_accepted"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_class",
        "payload",
        "frequency_per_day",
        "service_deadline_seconds"
      ],
      "properties": {
        "service_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "mass_kg",
            "volume_m3"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "mass_kg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "volume_m3": {
              "type": "number",
              "minimum": 0
            },
            "temperature_controlled": {
              "type": "boolean"
            },
            "handling_constraints": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "frequency_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "service_deadline_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "required_completion_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_site_id",
        "destination_site_id",
        "route_distance_m",
        "ground_transfer_origin_seconds",
        "ground_transfer_destination_seconds"
      ],
      "properties": {
        "origin_site_id": {
          "type": "string",
          "minLength": 1
        },
        "destination_site_id": {
          "type": "string",
          "minLength": 1
        },
        "route_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "route_geometry_ref": {
          "type": "string",
          "minLength": 1
        },
        "ground_transfer_origin_seconds": {
          "type": "number",
          "minimum": 0
        },
        "ground_transfer_destination_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "operating_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "altitude_m",
        "density_altitude_m",
        "temperature_c",
        "wind_speed_mps",
        "gust_speed_mps",
        "visibility_m",
        "precipitation",
        "operating_period"
      ],
      "properties": {
        "altitude_m": {
          "$ref": "#/$defs/closedRange"
        },
        "density_altitude_m": {
          "$ref": "#/$defs/closedRange"
        },
        "temperature_c": {
          "$ref": "#/$defs/closedRange"
        },
        "wind_speed_mps": {
          "$ref": "#/$defs/nonNegativeRange"
        },
        "gust_speed_mps": {
          "$ref": "#/$defs/nonNegativeRange"
        },
        "visibility_m": {
          "$ref": "#/$defs/positiveRange"
        },
        "precipitation": {
          "enum": [
            "none",
            "light",
            "moderate",
            "heavy",
            "unknown"
          ]
        },
        "operating_period": {
          "enum": [
            "day",
            "night",
            "mixed",
            "unknown"
          ]
        },
        "scenario_set_ref": {
          "type": "string"
        }
      }
    },
    "reserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_energy_fraction",
        "minimum_time_seconds",
        "diversion_required",
        "diversion_site_ids"
      ],
      "properties": {
        "minimum_energy_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "diversion_required": {
          "type": "boolean"
        },
        "diversion_site_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sites",
        "charging_policy"
      ],
      "properties": {
        "sites": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "site_id",
              "role",
              "facility_options"
            ],
            "properties": {
              "site_id": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "origin",
                  "destination",
                  "diversion",
                  "charging_hub",
                  "maintenance_hub"
                ]
              },
              "facility_options": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "facility_class",
                    "availability",
                    "turnaround_seconds"
                  ],
                  "properties": {
                    "facility_class": {
                      "enum": [
                        "runway",
                        "prepared_strip",
                        "unprepared_strip",
                        "vertiport",
                        "landing_pad",
                        "open_area",
                        "charging_station",
                        "maintenance_facility"
                      ]
                    },
                    "availability": {
                      "enum": [
                        "available",
                        "conditional",
                        "unavailable",
                        "unknown"
                      ]
                    },
                    "turnaround_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "charging_power_kw": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "charging_energy_source": {
                      "enum": [
                        "grid",
                        "renewable",
                        "hybrid",
                        "unknown",
                        "not_applicable"
                      ]
                    },
                    "cost_reference": {
                      "type": "string"
                    }
                  }
                }
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        },
        "charging_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "charging_allowed",
            "maximum_grid_power_kw",
            "queue_model_ref"
          ],
          "properties": {
            "charging_allowed": {
              "type": "boolean"
            },
            "maximum_grid_power_kw": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "queue_model_ref": {
              "type": "string"
            }
          }
        }
      }
    },
    "ground_comparator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "door_to_door_time_seconds",
        "cost_basis"
      ],
      "properties": {
        "mode": {
          "enum": [
            "road",
            "rail",
            "multimodal",
            "not_available",
            "unknown"
          ]
        },
        "door_to_door_time_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_basis": {
          "enum": [
            "per_mission",
            "per_payload_kg",
            "per_payload_km",
            "per_passenger_km",
            "unknown"
          ]
        },
        "cost_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "energy_mj": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "emissions_kgco2e": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source_ref": {
          "type": "string"
        }
      }
    },
    "candidate_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "battery_fixed_wing",
          "electric_stol",
          "multirotor",
          "lift_plus_cruise",
          "tilt_wing_or_tiltrotor",
          "electric_rotorcraft",
          "hybrid_fixed_wing",
          "hybrid_vtol",
          "glider_or_solar_assisted",
          "solar_haps",
          "buoyant_haps"
        ]
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "constraint_id",
          "metric_key",
          "operator",
          "limit_value",
          "unit",
          "scope"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "metric_key": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "<",
              "<=",
              "=",
              ">=",
              ">",
              "in_closed_interval",
              "not_in"
            ]
          },
          "limit_value": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "service",
              "vehicle",
              "environment",
              "infrastructure",
              "noise",
              "energy",
              "operations"
            ]
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "rights_status"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "synthetic_fixture",
              "measurement",
              "manufacturer_document",
              "public_dataset",
              "regulatory_document",
              "spatial_dataset",
              "engineering_analysis"
            ]
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time"
          },
          "rights_status": {
            "enum": [
              "synthetic",
              "open",
              "licensed",
              "restricted",
              "unknown"
            ]
          },
          "digest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependency_manifest_ref": {
      "type": "string"
    },
    "profile_digest_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "$defs": {
    "closedRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "nonNegativeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "positiveRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
