{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-claim-model-metric-binding-challenge-v0.1.schema.json",
  "title": "AERO Claim-to-Model Metric Binding Challenge Seed v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "oracle_status",
    "execution_status",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "AeroClaimMetricBindingChallengeCorpusV0_1"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "oracle_status": {
      "const": "NOT_INDEPENDENTLY_REVIEWED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_class",
          "mutation",
          "expected_disposition",
          "expected_reason_codes"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]+$"
          },
          "case_class": {
            "type": "string",
            "enum": [
              "positive_control",
              "single_fault",
              "coupled_fault",
              "metamorphic"
            ]
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "expected_disposition": {
            "type": "string",
            "enum": [
              "SEMANTICS_BOUND",
              "INCOMPLETE",
              "UNVERIFIED",
              "NOT_KNOWN_AT_SNAPSHOT",
              "OUT_OF_SCOPE",
              "REJECTED",
              "UNSUPPORTED_PROFILE"
            ]
          },
          "expected_reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
