{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aero-independent-assurance-challenge-v0.3.schema.json",
  "title": "AERO Independent Assurance Challenge Seed v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_id",
    "status",
    "execution_status",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "AeroIndependentAssuranceChallengeV0_3"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "NOT_INDEPENDENTLY_ADJUDICATED"
    },
    "execution_status": {
      "const": "NOT_EXECUTED"
    },
    "cases": {
      "type": "array",
      "minItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_class",
          "mutation",
          "expected_disposition",
          "expected_reason_codes"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^IAB[0-9]{2}$"
          },
          "case_class": {
            "enum": [
              "positive_control",
              "single_fault",
              "coupled_fault",
              "metamorphic"
            ]
          },
          "mutation": {
            "type": "string",
            "minLength": 10
          },
          "expected_disposition": {
            "enum": [
              "REVIEWABLE_FOR_INDEPENDENT_DECISION",
              "REJECTED",
              "INCOMPLETE",
              "UNVERIFIED",
              "OUT_OF_SCOPE",
              "NOT_KNOWN_AT_SNAPSHOT",
              "STRUCTURALLY_VALID"
            ]
          },
          "expected_reason_codes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "expected_impact_outcome": {
            "enum": [
              "NO_REQUALIFICATION_REQUIRED",
              "REQUALIFICATION_REQUIRED",
              "UNKNOWN_IMPACT"
            ]
          },
          "replay_mode": {
            "enum": [
              "HISTORICAL_AS_KNOWN",
              "CURRENT_POLICY_COUNTERFACTUAL",
              "CURRENT_AS_KNOWN"
            ]
          }
        }
      }
    }
  }
}
