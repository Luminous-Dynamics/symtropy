{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminousdynamics:aero:haps-network-allocation-case:v1",
  "title": "HAPS network allocation case v1",
  "description": "A provenance-aware input/output contract for cell-level critical-excess-traffic selection under finite HAPS beam resources. This is service scheduling metadata, not a radio propagation or physical beamforming model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "revision",
    "evidence_class",
    "claim_ceiling",
    "demand_source",
    "evaluation",
    "radio_resource_budget",
    "cells",
    "intervals",
    "expected_oracle",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "haps-network-allocation-case/v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_class": {
      "enum": [
        "synthetic",
        "measured_trace",
        "replayed_operator_trace"
      ]
    },
    "claim_ceiling": {
      "enum": [
        "synthetic_allocation_oracle",
        "offline_trace_replay"
      ]
    },
    "demand_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "trace_ref",
        "source_digest",
        "rights_or_license_ref",
        "initialization_time_utc",
        "available_at_decision_time",
        "reanalysis_not_used_as_live_forecast",
        "time_basis"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "synthetic_generator",
            "operator_traffic_trace",
            "measured_network_telemetry",
            "forecast_model",
            "reanalysis"
          ]
        },
        "trace_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_or_license_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "initialization_time_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "available_at_decision_time": {
          "type": "boolean"
        },
        "reanalysis_not_used_as_live_forecast": {
          "const": true
        },
        "time_basis": {
          "enum": [
            "valid_time",
            "observation_time",
            "issue_time"
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_ref",
        "horizon_s",
        "interval_duration_s",
        "critical_excess_definition"
      ],
      "properties": {
        "region_ref": {
          "type": "string",
          "minLength": 1
        },
        "horizon_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "interval_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "critical_excess_definition": {
          "const": "max(offered_load_mbps - terrestrial_available_mbps, 0)"
        }
      }
    },
    "radio_resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beam_budget",
        "optimization_objective",
        "per_beam_capacity_mbps",
        "allocation_policy",
        "tie_break_policy",
        "beam_reallocation_interval_s"
      ],
      "properties": {
        "beam_budget": {
          "type": "integer",
          "minimum": 1
        },
        "per_beam_capacity_mbps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "allocation_policy": {
          "enum": [
            "critical_excess_weighted_greedy",
            "round_robin",
            "static_fixed_assignment",
            "oracle_optimal"
          ]
        },
        "tie_break_policy": {
          "enum": [
            "cell_id_ascending",
            "stable_input_order"
          ]
        },
        "beam_reallocation_interval_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "static_assignment_cell_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Required only for static_fixed_assignment. The same listed cells are served in every interval; the count must not exceed beam_budget."
        },
        "optimization_objective": {
          "type": "string",
          "enum": [
            "critical_excess_served_mbps",
            "priority_weighted_critical_excess_served_mbps"
          ],
          "description": "The declared objective used to rank allocations. Every comparator in a matched case must use the same objective."
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "latitude_deg",
          "longitude_deg",
          "priority_weight",
          "service_class"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "latitude_deg": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude_deg": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "priority_weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "service_class": {
            "enum": [
              "public_broadband",
              "emergency",
              "health",
              "critical_infrastructure",
              "iot",
              "other"
            ]
          }
        }
      }
    },
    "intervals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "offset_s",
          "cell_loads"
        ],
        "properties": {
          "offset_s": {
            "type": "number",
            "minimum": 0
          },
          "cell_loads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cell_id",
                "offered_load_mbps",
                "terrestrial_available_mbps"
              ],
              "properties": {
                "cell_id": {
                  "type": "string",
                  "minLength": 1
                },
                "offered_load_mbps": {
                  "type": "number",
                  "minimum": 0
                },
                "terrestrial_available_mbps": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          "source_offset_s": {
            "type": "number",
            "minimum": 0,
            "description": "Optional offset in the original source trace; offset_s remains relative to this case's evaluation horizon."
          }
        }
      }
    },
    "expected_oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracle_status",
        "intervals",
        "total_critical_excess_offered_mbps_intervals",
        "total_critical_excess_served_mbps_intervals",
        "total_critical_excess_unserved_mbps_intervals",
        "critical_excess_offload_fraction",
        "beam_utilization_fraction",
        "deterministic_allocation"
      ],
      "properties": {
        "oracle_status": {
          "enum": [
            "independently_calculated",
            "not_evaluated"
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset_s",
              "selected_cell_ids",
              "critical_excess_offered_mbps",
              "critical_excess_served_mbps",
              "critical_excess_unserved_mbps"
            ],
            "properties": {
              "offset_s": {
                "type": "number",
                "minimum": 0
              },
              "selected_cell_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "critical_excess_offered_mbps": {
                "type": "number",
                "minimum": 0
              },
              "critical_excess_served_mbps": {
                "type": "number",
                "minimum": 0
              },
              "critical_excess_unserved_mbps": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "total_critical_excess_offered_mbps_intervals": {
          "type": "number",
          "minimum": 0
        },
        "total_critical_excess_served_mbps_intervals": {
          "type": "number",
          "minimum": 0
        },
        "total_critical_excess_unserved_mbps_intervals": {
          "type": "number",
          "minimum": 0
        },
        "critical_excess_offload_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beam_utilization_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deterministic_allocation": {
          "type": "boolean"
        },
        "total_priority_weighted_critical_excess_offered_mbps_intervals": {
          "type": "number",
          "minimum": 0
        },
        "total_priority_weighted_critical_excess_served_mbps_intervals": {
          "type": "number",
          "minimum": 0
        },
        "total_priority_weighted_critical_excess_unserved_mbps_intervals": {
          "type": "number",
          "minimum": 0
        },
        "priority_weighted_offload_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "source_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$comment": "Semantic checks: cell IDs unique; each interval contains exactly one load row per declared cell; offsets strictly increase and fit inside horizon; intervals align with declared interval duration; critical excess is recomputed from offered minus terrestrial capacity; each cell can receive at most one beam per interval; selected cells do not exceed beam budget; the oracle is independently recomputed; no radio SINR/interference, propagation, spectrum or link feasibility is implied. Static fixed assignment requires declared static_assignment_cell_ids, no more than beam_budget; selected cells remain fixed across every interval. For a held-out window sliced from a longer traffic trace, offset_s is relative to the holdout case while source_offset_s records the original trace offset. The optimization_objective must be frozen across matched policies. For priority_weighted_critical_excess_served_mbps, the exact oracle maximizes sum(priority_weight × min(cell critical excess, per-beam capacity)) subject to the beam budget; ties are broken by the lexicographically ascending sorted cell-ID set.",
  "allOf": [
    {
      "if": {
        "properties": {
          "radio_resource_budget": {
            "properties": {
              "allocation_policy": {
                "const": "static_fixed_assignment"
              }
            },
            "required": [
              "allocation_policy"
            ]
          }
        },
        "required": [
          "radio_resource_budget"
        ]
      },
      "then": {
        "properties": {
          "radio_resource_budget": {
            "required": [
              "static_assignment_cell_ids"
            ]
          }
        }
      }
    }
  ]
}
