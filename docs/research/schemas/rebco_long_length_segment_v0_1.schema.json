{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/research/schemas/rebco_long_length_segment_v0_1.schema.json",
  "title": "REBCO Long-Length Spatial Qualification Record v0.1",
  "description": "Condition-bound, spatially registered conductor observations and genealogy. Initial examples are synthetic; this schema does not qualify a real product.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "reel",
    "segments",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "rebco-long-length-spatial-qualification.v0.1"
    },
    "evidence_class": {
      "enum": [
        "synthetic",
        "source_reported",
        "measured",
        "derived"
      ]
    },
    "claim_ceiling": {
      "const": "spatial-genealogy-and-evidence-semantics-only"
    },
    "reel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reel_id",
        "lot_id",
        "campaign_id",
        "process_run_id",
        "architecture_id",
        "total_length_mm",
        "width_mm",
        "longitudinal_datum",
        "positive_direction",
        "width_datum",
        "coordinate_units"
      ],
      "properties": {
        "reel_id": {
          "$ref": "#/$defs/identifier"
        },
        "lot_id": {
          "$ref": "#/$defs/identifier"
        },
        "campaign_id": {
          "$ref": "#/$defs/identifier"
        },
        "process_run_id": {
          "$ref": "#/$defs/identifier"
        },
        "architecture_id": {
          "$ref": "#/$defs/identifier"
        },
        "total_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "longitudinal_datum": {
          "type": "string",
          "minLength": 1
        },
        "positive_direction": {
          "enum": [
            "winding_direction",
            "unwinding_direction",
            "declared_axis_positive"
          ]
        },
        "width_datum": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_units": {
          "const": "mm"
        },
        "face_convention": {
          "enum": [
            "substrate_face_reference",
            "superconductor_face_reference",
            "declared_face_reference"
          ]
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "parent_reel_id",
          "longitudinal_start_mm",
          "longitudinal_end_mm",
          "width_start_mm",
          "width_end_mm",
          "face",
          "genealogy_state"
        ],
        "properties": {
          "segment_id": {
            "$ref": "#/$defs/identifier"
          },
          "parent_reel_id": {
            "$ref": "#/$defs/identifier"
          },
          "parent_segment_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "longitudinal_start_mm": {
            "type": "number",
            "minimum": 0
          },
          "longitudinal_end_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width_start_mm": {
            "type": "number",
            "minimum": 0
          },
          "width_end_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "face": {
            "enum": [
              "a",
              "b",
              "both",
              "unknown"
            ]
          },
          "genealogy_state": {
            "enum": [
              "original",
              "cut",
              "split",
              "merged",
              "spliced",
              "reworked",
              "scrapped",
              "unknown"
            ]
          },
          "transformation_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "splice_or_joint_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "application_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "intended_use",
          "temperature_k",
          "field_magnitude_t",
          "field_orientation",
          "current_criterion",
          "acceptance_rule_id"
        ],
        "properties": {
          "profile_id": {
            "$ref": "#/$defs/identifier"
          },
          "intended_use": {
            "enum": [
              "high_field_magnet",
              "power_cable",
              "busbar",
              "rf_component",
              "other_declared"
            ]
          },
          "temperature_k": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "field_magnitude_t": {
            "type": "number",
            "minimum": 0
          },
          "field_orientation": {
            "type": "string",
            "minLength": 1
          },
          "current_criterion": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_rule_id": {
            "$ref": "#/$defs/identifier"
          },
          "strain_limit": {
            "type": "number",
            "minimum": 0
          },
          "geometry_convention": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "producer",
        "rights_status"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "rights_status": {
          "enum": [
            "public",
            "restricted",
            "permission_required",
            "unknown"
          ]
        },
        "source_uri": {
          "type": "string",
          "format": "uri"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "numericValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "segment_id",
        "property",
        "evidence_state",
        "authority",
        "measurement_basis",
        "coordinate_footprint",
        "source"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/identifier"
        },
        "segment_id": {
          "$ref": "#/$defs/identifier"
        },
        "property": {
          "enum": [
            "ic",
            "jc",
            "je",
            "n_value",
            "tc_onset",
            "tc_zero_resistance",
            "tc_bulk_thermodynamic",
            "layer_thickness",
            "texture_metric",
            "defect_density",
            "crack_presence",
            "delamination",
            "phase_fraction",
            "strain_response",
            "ac_loss",
            "joint_resistance",
            "other_declared"
          ]
        },
        "evidence_state": {
          "enum": [
            "measured",
            "not_detected",
            "unmeasured",
            "inferred",
            "disputed",
            "not_applicable"
          ]
        },
        "authority": {
          "enum": [
            "direct_measurement",
            "derived_measurement",
            "model_inference",
            "literature_reported",
            "synthetic_fixture",
            "unresolved"
          ]
        },
        "value": {
          "$ref": "#/$defs/numericValue"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "detection_limit": {
          "type": "number",
          "minimum": 0
        },
        "coordinate_footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "longitudinal_start_mm",
            "longitudinal_end_mm",
            "width_start_mm",
            "width_end_mm",
            "face"
          ],
          "properties": {
            "longitudinal_start_mm": {
              "type": "number",
              "minimum": 0
            },
            "longitudinal_end_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width_start_mm": {
              "type": "number",
              "minimum": 0
            },
            "width_end_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "face": {
              "enum": [
                "a",
                "b",
                "both",
                "unknown"
              ]
            },
            "spatial_resolution_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "registration_uncertainty_mm": {
              "type": "number",
              "minimum": 0
            },
            "sampling_spacing_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Distance between observation centers; distinct from the physical measurement footprint and not evidence that the gap was measured."
            }
          }
        },
        "conditions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "temperature_k": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "field_magnitude_t": {
              "type": "number",
              "minimum": 0
            },
            "field_vector_t": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "field_orientation": {
              "type": "string"
            },
            "current_criterion": {
              "type": "string"
            },
            "test_current_a": {
              "type": "number",
              "minimum": 0
            },
            "electric_field_criterion_uv_per_cm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "strain": {
              "type": "number"
            },
            "geometry": {
              "type": "string"
            },
            "frequency_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "description": "For Ic observations this declares the exact operating-condition profile. Coverage is partitioned by temperature, applied field/vector/orientation, current criterion and other operating values; measurement geometry remains source-specific and does not merge unlike test profiles."
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "standard_uncertainty",
                "expanded_uncertainty",
                "interval",
                "qualitative",
                "unknown"
              ]
            },
            "standard_uncertainty": {
              "type": "number",
              "minimum": 0
            },
            "coverage_factor": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "confidence_level": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "lower_bound": {
              "type": "number"
            },
            "upper_bound": {
              "type": "number"
            },
            "covariance_group_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "measurement_system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instrument_id",
            "calibration_revision"
          ],
          "properties": {
            "instrument_id": {
              "$ref": "#/$defs/identifier"
            },
            "calibration_revision": {
              "$ref": "#/$defs/identifier"
            },
            "calibration_valid_at_measurement": {
              "type": "boolean"
            },
            "operator_or_automation_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_sha256",
            "rights_status"
          ],
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "source_uri": {
              "type": "string",
              "format": "uri"
            },
            "source_locator": {
              "type": "string"
            },
            "rights_status": {
              "enum": [
                "public",
                "restricted",
                "permission_required",
                "unknown"
              ]
            },
            "review_state": {
              "enum": [
                "unreviewed",
                "reviewed",
                "disputed",
                "withdrawn"
              ]
            },
            "acquisition_time": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "measurement_basis": {
          "enum": [
            "direct_transport",
            "noncontact_magnetization_proxy",
            "structural_inspection",
            "model_inference",
            "other"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "measured",
                  "inferred"
                ]
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "required": [
              "value",
              "unit",
              "method",
              "conditions",
              "uncertainty",
              "measurement_system"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "const": "not_detected"
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "required": [
              "detection_limit",
              "unit",
              "method",
              "conditions",
              "measurement_system"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evidence_state": {
                "enum": [
                  "unmeasured",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "evidence_state"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "property": {
                "const": "ic"
              },
              "evidence_state": {
                "enum": [
                  "measured",
                  "inferred"
                ]
              }
            },
            "required": [
              "property",
              "evidence_state"
            ]
          },
          "then": {
            "required": [
              "unit",
              "conditions"
            ],
            "properties": {
              "conditions": {
                "required": [
                  "temperature_k",
                  "current_criterion",
                  "geometry"
                ],
                "anyOf": [
                  {
                    "required": [
                      "field_magnitude_t",
                      "field_orientation"
                    ]
                  },
                  {
                    "required": [
                      "field_vector_t"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
