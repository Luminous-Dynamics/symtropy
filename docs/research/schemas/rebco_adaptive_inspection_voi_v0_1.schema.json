{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/research/sc-adaptive-inspection-voi-v0.1/docs/research/schemas/rebco_adaptive_inspection_voi_v0_1.schema.json",
  "title": "REBCO Adaptive Inspection VOI v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "claim_ceiling",
    "application_profile",
    "cell_count",
    "prior_scenarios",
    "candidate_actions",
    "observed_results"
  ],
  "properties": {
    "schema_version": {
      "const": "rebco-adaptive-inspection-voi.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "single-step-posterior-decision-voi-only"
    },
    "application_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "condition_profile_id",
        "minimum_contiguous_weak_cells",
        "false_accept_loss",
        "false_reject_loss",
        "total_inspection_budget_loss_units",
        "minimum_positive_net_voi"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "condition_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "minimum_contiguous_weak_cells": {
          "type": "integer",
          "minimum": 1
        },
        "false_accept_loss": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "false_reject_loss": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "total_inspection_budget_loss_units": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_positive_net_voi": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "cell_count": {
      "type": "integer",
      "minimum": 1
    },
    "prior_scenarios": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "prior_weight",
          "weak_cells"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "prior_weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "weak_cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "candidate_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "method",
          "cell_index",
          "condition_profile_id",
          "sensitivity",
          "specificity",
          "cost_loss_units",
          "calibration_status",
          "instrument_id",
          "calibration_revision",
          "validation_artifact_sha256"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "direct_transport",
              "calibrated_noncontact_proxy"
            ]
          },
          "cell_index": {
            "type": "integer",
            "minimum": 0
          },
          "condition_profile_id": {
            "type": "string",
            "minLength": 1
          },
          "sensitivity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "specificity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cost_loss_units": {
            "type": "number",
            "minimum": 0
          },
          "calibration_status": {
            "enum": [
              "valid",
              "qualified"
            ]
          },
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "calibration_revision": {
            "type": "string",
            "minLength": 1
          },
          "validation_artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "method": {
                  "const": "direct_transport"
                }
              },
              "required": [
                "method"
              ]
            },
            "then": {
              "properties": {
                "calibration_status": {
                  "const": "valid"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "method": {
                  "const": "calibrated_noncontact_proxy"
                }
              },
              "required": [
                "method"
              ]
            },
            "then": {
              "properties": {
                "calibration_status": {
                  "const": "qualified"
                }
              }
            }
          }
        ]
      }
    },
    "observed_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "outcome"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "positive",
              "negative"
            ]
          }
        }
      }
    }
  }
}
