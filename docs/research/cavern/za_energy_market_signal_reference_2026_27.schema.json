{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symtropy/za-energy-market-signal-reference-v0.1.json",
  "title": "South African Energy Market Signal Reference v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_status",
    "sources",
    "city_power_industrial_tou",
    "dffe_grid_emission_factors",
    "south_african_greenhouse_comparator",
    "derived_checks",
    "interpretation_rules",
    "claim_ceiling"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "title",
        "url",
        "publication_date",
        "source_type",
        "document_locator",
        "notes"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "document_locator": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rate_value": {
      "type": "number",
      "minimum": 0
    },
    "time_window": {
      "type": "object",
      "required": [
        "start",
        "end",
        "source_literal",
        "normalization_status"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "source_literal": {
          "type": "string"
        },
        "normalization_status": {
          "type": "string"
        }
      }
    },
    "time_band": {
      "type": "object",
      "required": [
        "peak",
        "standard",
        "off_peak"
      ],
      "properties": {
        "peak": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_window"
          }
        },
        "standard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_window"
          }
        },
        "off_peak": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_window"
          }
        },
        "source_status": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "check_id",
        "formula",
        "result",
        "unit",
        "interpretation",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_status": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "city_power_industrial_tou": {
      "type": "object",
      "required": [
        "utility",
        "tariff_name",
        "tariff_year",
        "schedule_status",
        "budget_effective_date",
        "eligibility",
        "source_rate_basis",
        "additional_charges",
        "voltage_classes",
        "energy_charges",
        "demand_floor",
        "reactive_energy",
        "season_definition",
        "time_bands",
        "source_ambiguities"
      ],
      "properties": {
        "utility": {
          "const": "City Power Johannesburg"
        },
        "tariff_name": {
          "type": "string"
        },
        "tariff_year": {
          "type": "string"
        },
        "schedule_status": {
          "type": "string"
        },
        "budget_effective_date": {
          "type": "string",
          "format": "date"
        },
        "eligibility": {
          "type": "object",
          "required": [
            "minimum_supply_capacity_kva_exclusive",
            "application_required",
            "city_power_approval_required",
            "large_consumer_load_shifting_profile_required",
            "site_eligibility_status"
          ],
          "properties": {
            "minimum_supply_capacity_kva_exclusive": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "application_required": {
              "type": "boolean"
            },
            "city_power_approval_required": {
              "type": "boolean"
            },
            "large_consumer_load_shifting_profile_required": {
              "type": "boolean"
            },
            "site_eligibility_status": {
              "type": "string"
            },
            "legacy_exception": {
              "type": "string"
            }
          }
        },
        "source_rate_basis": {
          "type": "object"
        },
        "additional_charges": {
          "type": "object"
        },
        "voltage_classes": {
          "type": "object",
          "required": [
            "LV",
            "MV",
            "HV"
          ],
          "properties": {
            "LV": {
              "type": "object"
            },
            "MV": {
              "type": "object"
            },
            "HV": {
              "type": "object"
            }
          }
        },
        "energy_charges": {
          "type": "object",
          "required": [
            "summer",
            "winter"
          ],
          "properties": {
            "summer": {
              "type": "object"
            },
            "winter": {
              "type": "object"
            }
          }
        },
        "demand_floor": {
          "type": "object"
        },
        "reactive_energy": {
          "type": "object"
        },
        "season_definition": {
          "type": "object"
        },
        "time_bands": {
          "type": "object",
          "required": [
            "weekday",
            "saturday_public_holiday",
            "sunday"
          ],
          "properties": {
            "weekday": {
              "$ref": "#/$defs/time_band"
            },
            "saturday_public_holiday": {
              "$ref": "#/$defs/time_band"
            },
            "sunday": {
              "$ref": "#/$defs/time_band"
            }
          }
        },
        "source_ambiguities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dffe_grid_emission_factors": {
      "type": "object",
      "required": [
        "report_title",
        "report_publication_date",
        "data_year",
        "unit",
        "factors",
        "intended_use",
        "data_lag_years_approx",
        "interval_marginal_factor_available",
        "notes"
      ],
      "properties": {
        "report_title": {
          "type": "string"
        },
        "report_publication_date": {
          "type": "string",
          "format": "date"
        },
        "data_year": {
          "type": "integer"
        },
        "unit": {
          "const": "tCO2e/MWh"
        },
        "factors": {
          "type": "object",
          "required": [
            "DGGEF",
            "NGGEF",
            "TLGEF",
            "DLGEF"
          ],
          "properties": {
            "DGGEF": {
              "type": "number"
            },
            "NGGEF": {
              "type": "number"
            },
            "TLGEF": {
              "type": "number"
            },
            "DLGEF": {
              "type": "number"
            }
          }
        },
        "intended_use": {
          "type": "object"
        },
        "data_lag_years_approx": {
          "type": "number",
          "minimum": 0
        },
        "interval_marginal_factor_available": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_admission_status": {
          "type": "string"
        },
        "primary_pdf_audit": {
          "type": "object"
        },
        "historical_comparison": {
          "type": "object"
        }
      }
    },
    "south_african_greenhouse_comparator": {
      "type": "object",
      "required": [
        "doi",
        "publication_date",
        "study_type",
        "weather_location",
        "grid_factor_assumption_kgco2e_per_kwh",
        "social_cost_carbon_zar_per_tco2e",
        "groundwater_penalty_type",
        "reported_outcomes",
        "claim_limitations"
      ],
      "properties": {
        "doi": {
          "type": "string"
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "study_type": {
          "type": "string"
        },
        "weather_location": {
          "type": "string"
        },
        "grid_factor_assumption_kgco2e_per_kwh": {
          "type": "number"
        },
        "social_cost_carbon_zar_per_tco2e": {
          "type": "number"
        },
        "groundwater_penalty_type": {
          "type": "string"
        },
        "reported_outcomes": {
          "type": "object"
        },
        "claim_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "derived_checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "interpretation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
