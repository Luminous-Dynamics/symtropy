{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symtropy/cea-demand-memory-case-v0.1.json",
  "title": "CEA rolling demand-memory benchmark case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","case_id","evidence_class","tariff_rule","billing_state","current_month","next_month_transition","comparators","metrics","claim_ceiling"],
  "$defs": {
    "month_peak": {
      "type":"object","additionalProperties":false,
      "required":["month","peak_kva","evidence_status","source_ref"],
      "properties":{
        "month":{"type":"string","pattern":"^\\d{4}-(0[1-9]|1[0-2])$"},
        "peak_kva":{"type":"number","minimum":0},
        "evidence_status":{"enum":["MEASURED_ACCOUNT","SOURCE_REPORTED","SYNTHETIC"]},
        "source_ref":{"type":"string","minLength":1}
      }
    },
    "calculation": {
      "type":"object","additionalProperties":false,
      "required":["top_three_months","top_three_average_kva","ratchet_fraction","ratchet_floor_kva","minimum_floor_kva","current_measured_peak_kva","billed_demand_kva","status"],
      "properties":{
        "top_three_months":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/month_peak"}},
        "top_three_average_kva":{"type":"number","minimum":0},
        "ratchet_fraction":{"const":0.8},
        "ratchet_floor_kva":{"type":"number","minimum":0},
        "minimum_floor_kva":{"const":70},
        "current_measured_peak_kva":{"type":"number","minimum":0},
        "billed_demand_kva":{"type":"number","minimum":0},
        "status":{"enum":["ARITHMETIC_CHECK","SOURCE_REPORTED_RULE","SYNTHETIC_TRANSITION"]}
      }
    }
  },
  "properties":{
    "schema_version":{"const":1},
    "case_id":{"type":"string","minLength":1},
    "evidence_class":{"enum":["PUBLISHED_TARIFF_RULE_WITH_SYNTHETIC_STATE","MEASURED_ACCOUNT_STATE","MODEL_SCENARIO"]},
    "tariff_rule":{
      "type":"object","additionalProperties":false,
      "required":["utility","tariff_name","source_url","eligibility_rule","demand_rule","demand_meter_interval_status"],
      "properties":{
        "utility":{"const":"City Power Johannesburg"},
        "tariff_name":{"type":"string"},
        "source_url":{"type":"string","format":"uri"},
        "eligibility_rule":{"type":"string"},
        "demand_rule":{"const":"Billed kVA = max(current measured monthly peak, 70 kVA, 80% × average of the three highest monthly peaks in the preceding twelve months)"},
        "demand_meter_interval_status":{"enum":["ACCOUNT_SPECIFIC_CONFIRMATION_REQUIRED","PRIMARY_SOURCE_CONFIRMED","SECONDARY_COMPARATOR_ONLY"]}
      }
    },
    "billing_state":{
      "type":"object","additionalProperties":false,
      "required":["billing_month","prior_month_peaks","calculation"],
      "properties":{
        "billing_month":{"type":"string","pattern":"^\\d{4}-(0[1-9]|1[0-2])$"},
        "prior_month_peaks":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/month_peak"}},
        "calculation":{"$ref":"#/$defs/calculation"}
      }
    },
    "current_month":{
      "type":"object","additionalProperties":false,
      "required":["month","measured_peak_kva","evidence_status","note"],
      "properties":{
        "month":{"type":"string","pattern":"^\\d{4}-(0[1-9]|1[0-2])$"},
        "measured_peak_kva":{"type":"number","minimum":0},
        "evidence_status":{"enum":["MEASURED_ACCOUNT","MODEL_OUTPUT","SYNTHETIC"]},
        "note":{"type":"string"}
      }
    },
    "next_month_transition":{
      "type":"object","additionalProperties":false,
      "required":["next_billing_month","history_after_rollover","calculation","transition_note"],
      "properties":{
        "next_billing_month":{"type":"string","pattern":"^\\d{4}-(0[1-9]|1[0-2])$"},
        "history_after_rollover":{"type":"array","minItems":12,"maxItems":12,"items":{"$ref":"#/$defs/month_peak"}},
        "calculation":{"$ref":"#/$defs/calculation"},
        "transition_note":{"type":"string"}
      }
    },
    "comparators":{"type":"array","minItems":1,"items":{"type":"string"}},
    "metrics":{"type":"array","minItems":1,"items":{"type":"string"}},
    "claim_ceiling":{"type":"string","minLength":1}
  }
}