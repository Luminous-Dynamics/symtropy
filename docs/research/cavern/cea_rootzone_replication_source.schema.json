{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/symtropy/cea-rootzone-replication-source-case-v0.1.json",
  "title":"CEA root-zone replication source case v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","case_id","source","system_design","experimental_unit_audit","environmental_envelope","management_arms","reported_results","measurement_and_missingness","replication_requirements","claim_ceiling"],
  "$defs":{
    "ref":{"type":"string","minLength":1},
    "study_period":{
      "type":"object","additionalProperties":false,
      "required":["study_id","cycles","cycle_days","campaign_days","planting_period"],
      "properties":{
        "study_id":{"$ref":"#/$defs/ref"},
        "cycles":{"type":"integer","minimum":1},
        "cycle_days":{"type":"integer","minimum":1},
        "campaign_days":{"type":"integer","minimum":1},
        "planting_period":{"$ref":"#/$defs/ref"}
      }
    },
    "element_result":{
      "type":"object","additionalProperties":false,
      "required":["element","reported_recovery_percent","interpretation","evidence_status"],
      "properties":{
        "element":{"$ref":"#/$defs/ref"},
        "reported_recovery_percent":{"type":"number","minimum":0},
        "interpretation":{"$ref":"#/$defs/ref"},
        "evidence_status":{"enum":["SOURCE_REPORTED","SOURCE_DERIVED","UNKNOWN"]}
      }
    }
  },
  "properties":{
    "schema_version":{"const":1},
    "case_id":{"$ref":"#/$defs/ref"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["title","authors","journal","publication_date","doi","url"],
      "properties":{
        "title":{"$ref":"#/$defs/ref"},
        "authors":{"$ref":"#/$defs/ref"},
        "journal":{"$ref":"#/$defs/ref"},
        "publication_date":{"type":"string","format":"date"},
        "doi":{"$ref":"#/$defs/ref"},
        "url":{"type":"string","format":"uri"}
      }
    },
    "system_design":{
      "type":"object","additionalProperties":false,
      "required":["system_type","container_volume_l","plants_per_container","cultivars","cultivar_units","aeration_l_min_container","solution_replacement_policy"],
      "properties":{
        "system_type":{"$ref":"#/$defs/ref"},
        "container_volume_l":{"type":"number","exclusiveMinimum":0},
        "plants_per_container":{"type":"integer","minimum":1},
        "cultivars":{"type":"array","minItems":1,"items":{"type":"string"}},
        "cultivar_units":{"type":"string","minLength":1},
        "aeration_l_min_container":{"type":"number","minimum":0},
        "solution_replacement_policy":{"type":"string","minLength":1},
        "replication_note":{"type":"string"}
      }
    },
    "experimental_unit_audit":{
      "type":"object","additionalProperties":false,
      "required":["treatment_assignment_unit","independent_reservoir_replicates_reported","plants_are_subsamples","cycles_are_repeated_measures","source_author_pseudoreplication_note"],
      "properties":{
        "treatment_assignment_unit":{"$ref":"#/$defs/ref"},
        "independent_reservoir_replicates_reported":{"type":["integer","null"],"minimum":1},
        "plants_are_subsamples":{"type":"boolean"},
        "cycles_are_repeated_measures":{"type":"boolean"},
        "source_author_pseudoreplication_note":{"$ref":"#/$defs/ref"},
        "reported_plot_n":{"type":"integer","minimum":1}
      }
    },
    "environmental_envelope":{
      "type":"object","additionalProperties":false,
      "required":["temperature_day_night_c","relative_humidity_mean_percent","relative_humidity_spread_percent","dli_range_mol_m2_day","photoperiod_h","wue_recipe_value_g_dry_matter_l_transpired_water"],
      "properties":{
        "temperature_day_night_c":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2},
        "relative_humidity_mean_percent":{"type":"number","minimum":0,"maximum":100},
        "relative_humidity_spread_percent":{"type":"number","minimum":0,"maximum":100},
        "dli_range_mol_m2_day":{"type":"array","prefixItems":[{"type":"number","minimum":0},{"type":"number","minimum":0}],"minItems":2,"maxItems":2},
        "photoperiod_h":{"type":"number","minimum":0,"maximum":24},
        "wue_recipe_value_g_dry_matter_l_transpired_water":{"type":"number","exclusiveMinimum":0},
        "wue_assumption_context":{"type":"string"},
        "elevated_co2_wue_note":{"type":"string"}
      }
    },
    "management_arms":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["arm_id","policy","evidence_status"],
        "properties":{
          "arm_id":{"$ref":"#/$defs/ref"},
          "policy":{"$ref":"#/$defs/ref"},
          "evidence_status":{"enum":["SOURCE_REPORTED","PROPOSED_REPLICATION"]}
        }
      }
    },
    "reported_results":{
      "type":"object","additionalProperties":false,
      "required":["study_periods","zero_discharge_reported","yield_and_wue_difference_reported","mass_balance_recovery","non_significant_control_result","evidence_status"],
      "properties":{
        "study_periods":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/study_period"}},
        "zero_discharge_reported":{"type":"boolean"},
        "yield_and_wue_difference_reported":{"type":"string"},
        "mass_balance_recovery":{"type":"array","items":{"$ref":"#/$defs/element_result"}},
        "non_significant_control_result":{"type":"string"},
        "evidence_status":{"enum":["PUBLISHED_RESULT","SUPPLEMENTARY_RESULT","SOURCE_SUMMARY_ONLY"]}
      }
    },
    "measurement_and_missingness":{
      "type":"object","additionalProperties":false,
      "required":["solution_assay_method","tissue_assay_method","ph_control_input_accounting","source_reported_missing_or_estimated_values","boundary_caveats"],
      "properties":{
        "solution_assay_method":{"$ref":"#/$defs/ref"},
        "tissue_assay_method":{"$ref":"#/$defs/ref"},
        "ph_control_input_accounting":{"$ref":"#/$defs/ref"},
        "source_reported_missing_or_estimated_values":{"type":"array","items":{"type":"string"}},
        "boundary_caveats":{"type":"array","items":{"type":"string"}}
      }
    },
    "replication_requirements":{
      "type":"array","minItems":1,"items":{"type":"string"}
    },
    "claim_ceiling":{"$ref":"#/$defs/ref"}
  }
}