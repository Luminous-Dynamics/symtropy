{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/symtropy/cea-rootzone-adversarial-corpus-v0.1.json",
  "title": "CEA Root-Zone Adversarial Benchmark Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "created_on",
    "evidence_class",
    "cases",
    "corpus_claim_ceiling"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family",
        "scenario",
        "evidence_class",
        "input_facts",
        "expected_decision",
        "must_not_infer",
        "reason",
        "claim_ceiling"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/text"
        },
        "family": {
          "enum": [
            "ELEMENTAL_BALANCE",
            "SENSOR_PROXY",
            "SOURCE_WATER",
            "PATHOGEN_EVIDENCE",
            "MICROBIOME",
            "PLANT_DISEASE",
            "SAMPLE_COVERAGE",
            "SANITATION_VERIFICATION",
            "LOOP_TOPOLOGY",
            "ZERO_DISCHARGE_BOUNDARY",
            "WATER_RECOVERY",
            "FOOD_RELEASE"
          ]
        },
        "scenario": {
          "$ref": "#/$defs/text"
        },
        "evidence_class": {
          "enum": [
            "SYNTHETIC_KNOWN_TRUTH",
            "PUBLISHED_SOURCE_SUMMARY"
          ]
        },
        "input_facts": {
          "type": "object"
        },
        "expected_decision": {
          "enum": [
            "ACCEPT_SYNTHETIC_BALANCE",
            "INCOMPLETE",
            "HOLD_BATCH",
            "ISOLATE_DOMAIN",
            "HUMAN_REVIEW",
            "INDETERMINATE",
            "REJECT_CLAIM"
          ]
        },
        "must_not_infer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "claim_ceiling": {
          "$ref": "#/$defs/text"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "corpus_id": {
      "$ref": "#/$defs/text"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "evidence_class": {
      "const": "SYNTHETIC_KNOWN_TRUTH"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "corpus_claim_ceiling": {
      "$ref": "#/$defs/text"
    }
  }
}
