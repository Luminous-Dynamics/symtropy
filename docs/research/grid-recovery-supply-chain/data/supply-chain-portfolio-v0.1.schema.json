{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:grid-recovery:supply-chain-portfolio:0.1.0",
  "title": "Grid Recovery Supply-Chain Portfolio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "portfolioId",
    "snapshotAt",
    "maturity",
    "sourceArtifacts",
    "suppliers",
    "capacityResources",
    "leadTimeClaims",
    "projects",
    "reservations",
    "disruptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "portfolioId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "synthetic",
        "modelled",
        "measured",
        "mixed",
        "unknown"
      ]
    },
    "jurisdictionProfileId": {
      "type": "string",
      "minLength": 1
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "kind",
          "sourceRef",
          "revision",
          "digest",
          "evidenceClass",
          "status"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "supplier_statement",
              "contract",
              "purchase_order",
              "capacity_record",
              "qualification_record",
              "delivery_history",
              "industry_survey",
              "synthetic_fixture",
              "other"
            ]
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "declared",
              "observed",
              "inferred",
              "simulated",
              "unknown"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "stale",
              "conflicted",
              "unverified",
              "unknown"
            ]
          },
          "geography": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "licenseStatus": {
            "type": "string",
            "enum": [
              "open",
              "restricted",
              "review_required",
              "not_applicable",
              "unknown"
            ]
          }
        }
      }
    },
    "suppliers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "supplierId",
          "supplierType",
          "geography",
          "qualificationRecords"
        ],
        "properties": {
          "supplierId": {
            "type": "string",
            "minLength": 1
          },
          "supplierType": {
            "type": "string",
            "enum": [
              "oem",
              "component_supplier",
              "manufacturer",
              "logistics_provider",
              "port_operator",
              "vessel_operator",
              "contractor",
              "other"
            ]
          },
          "geography": {
            "type": "string",
            "minLength": 1
          },
          "qualificationRecords": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetFamily",
                "interfaceProfileId",
                "status",
                "evidenceRefs"
              ],
              "properties": {
                "assetFamily": {
                  "type": "string",
                  "minLength": 1
                },
                "interfaceProfileId": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "qualified",
                    "conditional",
                    "expired",
                    "not_qualified",
                    "unknown"
                  ]
                },
                "validUntil": {
                  "type": "string",
                  "format": "date"
                },
                "evidenceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          },
          "sourceArtifactIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "capacityResources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resourceId",
          "supplierId",
          "resourceType",
          "unit",
          "capacityWindows",
          "sourceArtifactIds"
        ],
        "properties": {
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "supplierId": {
            "type": "string",
            "minLength": 1
          },
          "facilityId": {
            "type": "string",
            "minLength": 1
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "factory_line",
              "production_slot",
              "material_lot",
              "factory_test_bay",
              "port_berth",
              "heavy_haul_route",
              "cable_laying_vessel",
              "specialist_crew",
              "commissioning_team",
              "other"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "capacityWindows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "capacityUnits"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": "string",
                  "format": "date-time"
                },
                "capacityUnits": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "failureDomainIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sourceArtifactIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "leadTimeClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "supplierId",
          "assetFamily",
          "basis",
          "evidenceClass",
          "sourceArtifactId",
          "status"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "supplierId": {
            "type": "string",
            "minLength": 1
          },
          "assetFamily": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "enum": [
              "contractual_quote",
              "observed_distribution",
              "expert_interval",
              "scenario_delay",
              "right_censored_backlog",
              "unknown"
            ]
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "declared",
              "observed",
              "inferred",
              "simulated",
              "unknown"
            ]
          },
          "sourceArtifactId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "current",
              "stale",
              "conflicted",
              "unverified",
              "unknown"
            ]
          },
          "quoteRef": {
            "type": "string",
            "minLength": 1
          },
          "promisedDeliveryAt": {
            "type": "string",
            "format": "date-time"
          },
          "bookedThrough": {
            "type": "string",
            "format": "date"
          },
          "lowerBoundHours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "upperBoundHours": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sampleCount": {
            "type": "integer",
            "minimum": 1
          },
          "scenarioId": {
            "type": "string",
            "minLength": 1
          },
          "delayHours": {
            "type": "number",
            "minimum": 0
          },
          "censoringDefinition": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "contractual_quote"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "quoteRef",
                "promisedDeliveryAt"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "observed_distribution"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "sampleCount"
              ],
              "properties": {
                "evidenceClass": {
                  "const": "observed"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "expert_interval"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "lowerBoundHours",
                "upperBoundHours"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "scenario_delay"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "scenarioId",
                "delayHours"
              ],
              "properties": {
                "evidenceClass": {
                  "const": "simulated"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "right_censored_backlog"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "required": [
                "bookedThrough",
                "censoringDefinition"
              ],
              "not": {
                "required": [
                  "promisedDeliveryAt"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "basis": {
                  "const": "unknown"
                }
              },
              "required": [
                "basis"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "promisedDeliveryAt"
                    ]
                  },
                  {
                    "required": [
                      "lowerBoundHours"
                    ]
                  },
                  {
                    "required": [
                      "upperBoundHours"
                    ]
                  },
                  {
                    "required": [
                      "delayHours"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectId",
          "incidentId",
          "servicePriority",
          "requiredAssetFamily",
          "status"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "incidentId": {
            "type": "string",
            "minLength": 1
          },
          "servicePriority": {
            "type": "string",
            "enum": [
              "life_safety",
              "essential",
              "important",
              "deferrable",
              "unclassified"
            ]
          },
          "requiredAssetFamily": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "planned",
              "paused",
              "completed",
              "cancelled",
              "unknown"
            ]
          },
          "minimumServiceFloorId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reservationId",
          "projectId",
          "resourceId",
          "start",
          "end",
          "units",
          "state",
          "idempotencyKey",
          "sourceArtifactId"
        ],
        "properties": {
          "reservationId": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "resourceId": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "units": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "proposed",
              "held",
              "confirmed",
              "released",
              "fulfilled",
              "conflicted",
              "unknown"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1
          },
          "sourceArtifactId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disruptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disruptionId",
          "causeId",
          "correlationGroupId",
          "description",
          "affectedResourceIds",
          "start",
          "end",
          "evidenceClass"
        ],
        "properties": {
          "disruptionId": {
            "type": "string",
            "minLength": 1
          },
          "causeId": {
            "type": "string",
            "minLength": 1
          },
          "correlationGroupId": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "affectedResourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "evidenceClass": {
            "type": "string",
            "enum": [
              "declared",
              "observed",
              "inferred",
              "simulated",
              "unknown"
            ]
          },
          "scenarioId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
