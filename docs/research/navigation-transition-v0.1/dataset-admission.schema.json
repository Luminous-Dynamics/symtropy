{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/navigation-dataset-admission-v0.1.json",
  "title": "Navigation benchmark dataset admission manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "manifest_status",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "const": "navigation-dataset-admission/v0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_status": {
      "enum": [
        "rights_and_snapshot_candidates_only",
        "partially_admitted",
        "admitted"
      ]
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "name",
        "domain",
        "source_url",
        "status",
        "snapshot",
        "rights",
        "metadata",
        "admission_scope"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "indoor",
            "urban_land",
            "underground",
            "underwater",
            "airborne",
            "space",
            "cooperative_localization"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "enum": [
            "candidate_not_admitted",
            "admitted",
            "quarantined"
          ]
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "immutable",
            "release_tag",
            "repository_commit",
            "file_sha256"
          ],
          "properties": {
            "immutable": {
              "type": "boolean"
            },
            "release_tag": {
              "type": [
                "string",
                "null"
              ]
            },
            "repository_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
            },
            "file_sha256": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "license_id",
            "status",
            "scope",
            "evidence_url",
            "research_use",
            "commercial_use",
            "redistribution"
          ],
          "properties": {
            "license_id": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "explicit",
                "paper_or_repository_claim_only",
                "unknown"
              ]
            },
            "scope": {
              "enum": [
                "dataset_payload",
                "repository_code_only",
                "article_text_only",
                "unknown"
              ]
            },
            "evidence_url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "research_use": {
              "enum": [
                "permitted",
                "prohibited",
                "unknown"
              ]
            },
            "commercial_use": {
              "enum": [
                "permitted",
                "prohibited",
                "unknown"
              ]
            },
            "redistribution": {
              "enum": [
                "permitted",
                "prohibited",
                "unknown"
              ]
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "time_basis_status",
            "spatial_reference_status",
            "calibration_status",
            "ground_truth_status",
            "split_basis",
            "train_group_ids",
            "test_group_ids",
            "split_sha256",
            "clock_state_truth_status"
          ],
          "properties": {
            "time_basis_status": {
              "enum": [
                "qualified",
                "unqualified",
                "unknown"
              ]
            },
            "spatial_reference_status": {
              "enum": [
                "qualified",
                "unqualified",
                "unknown"
              ]
            },
            "calibration_status": {
              "enum": [
                "complete",
                "partial",
                "not_provided",
                "unknown"
              ]
            },
            "ground_truth_status": {
              "enum": [
                "mocap",
                "high_grade_gnss_ins",
                "surveyed",
                "partial",
                "unavailable",
                "unknown"
              ]
            },
            "split_basis": {
              "enum": [
                "experiment_id",
                "session_id",
                "route_id",
                "vehicle_id",
                "collection_day",
                "none"
              ]
            },
            "train_group_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "test_group_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "split_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "clock_state_truth_status": {
              "enum": [
                "available",
                "not_provided",
                "unknown"
              ]
            }
          }
        },
        "admission_scope": {
          "enum": [
            "none",
            "research_noncommercial",
            "commercial",
            "both"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
