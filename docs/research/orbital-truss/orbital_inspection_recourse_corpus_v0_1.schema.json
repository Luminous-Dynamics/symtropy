{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital_inspection_recourse_corpus_v0_1.schema.json",
  "title": "Orbital Inspection Recourse Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-inspection-recourse.corpus.v0.1"
    },
    "benchmark_id": {
      "const": "ORBITAL-INSPECTION-RECOURSE-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic_finite_contingent_policy_over_declared_outcome_support_only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "worlds",
          "actions",
          "max_actions",
          "max_search_states",
          "budget_time_ms",
          "budget_energy_mj",
          "expected_status",
          "expected_root_action"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "worlds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "world_id",
                "decision_class"
              ],
              "properties": {
                "world_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_class": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "actions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action_id",
                "duration_ms",
                "energy_mj",
                "model_receipt_sha256",
                "gates",
                "outcomes_by_world"
              ],
              "properties": {
                "action_id": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "energy_mj": {
                  "type": "integer",
                  "minimum": 0
                },
                "model_receipt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{64}$"
                },
                "gates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "gate_id",
                      "state",
                      "receipt_sha256"
                    ],
                    "properties": {
                      "gate_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "state": {
                        "enum": [
                          "PASS",
                          "FAIL",
                          "UNKNOWN"
                        ]
                      },
                      "receipt_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      }
                    }
                  }
                },
                "outcomes_by_world": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "world_id",
                      "mapping_state",
                      "possible_outcomes",
                      "receipt_sha256"
                    ],
                    "properties": {
                      "world_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mapping_state": {
                        "enum": [
                          "KNOWN",
                          "UNKNOWN"
                        ]
                      },
                      "possible_outcomes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uniqueItems": true
                      },
                      "receipt_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      }
                    }
                  }
                }
              }
            }
          },
          "max_actions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "max_search_states": {
            "type": "integer",
            "minimum": 1
          },
          "budget_time_ms": {
            "type": "integer",
            "minimum": 0
          },
          "budget_energy_mj": {
            "type": "integer",
            "minimum": 0
          },
          "expected_status": {
            "enum": [
              "RESOLVED",
              "ABSTAIN",
              "SEARCH_LIMIT_NOT_PROVEN"
            ]
          },
          "expected_root_action": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
