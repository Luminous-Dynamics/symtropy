{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital Truss Planning Corpus v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-truss-inspectability.planning-corpus.v0.2"
    },
    "benchmark_id": {
      "const": "ORBITAL-TRUSS-PLANNING-002"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic_2d_geometric_observability_and_view_selection_only"
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Disposition": {
      "type": "string",
      "enum": [
        "FEASIBLE",
        "INFEASIBLE",
        "INDETERMINATE"
      ]
    },
    "PlanningDisposition": {
      "type": "string",
      "enum": [
        "FEASIBLE",
        "INFEASIBLE",
        "INDETERMINATE",
        "BUDGET_INFEASIBLE"
      ]
    },
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "required_view_count",
        "required_failure_domains"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "required_view_count": {
          "type": "integer",
          "minimum": 1
        },
        "required_failure_domains": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "failure_domain_id",
        "cost_units",
        "nominal_feature_ids",
        "robust_feature_ids"
      ],
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "cost_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709552000
        },
        "nominal_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "robust_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "coordinate_frame_id",
        "features",
        "views",
        "max_selected_views",
        "max_total_cost_units"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Feature"
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/View"
          }
        },
        "max_selected_views": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "max_total_cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709552000
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "expected_candidate_geometry_disposition",
        "expected_planning_disposition",
        "problem"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_candidate_geometry_disposition": {
          "$ref": "#/$defs/Disposition"
        },
        "expected_planning_disposition": {
          "$ref": "#/$defs/PlanningDisposition"
        },
        "problem": {
          "$ref": "#/$defs/Problem"
        }
      }
    }
  }
}
