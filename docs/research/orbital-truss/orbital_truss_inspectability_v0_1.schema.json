{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital_truss_inspectability_v0_1.schema.json",
  "title": "Orbital Truss Inspectability Synthetic Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-truss-inspectability.corpus.v0.1"
    },
    "benchmark_id": {
      "const": "ORBITAL-TRUSS-INSPECTABILITY-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic_2d_geometric_observability_only"
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "Perturbation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dx_m",
        "dy_m",
        "heading_delta_rad"
      ],
      "properties": {
        "dx_m": {
          "type": "number"
        },
        "dy_m": {
          "type": "number"
        },
        "heading_delta_rad": {
          "type": "number"
        }
      }
    },
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "position_m",
        "outward_normal",
        "minimum_distinct_failure_domains"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "position_m": {
          "$ref": "#/$defs/Point"
        },
        "outward_normal": {
          "$ref": "#/$defs/Point"
        },
        "minimum_distinct_failure_domains": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "sensor_id",
        "failure_domain_id",
        "origin_m",
        "heading_rad",
        "half_fov_deg",
        "min_standoff_m",
        "max_standoff_m",
        "max_incidence_deg",
        "pose_perturbations"
      ],
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_m": {
          "$ref": "#/$defs/Point"
        },
        "heading_rad": {
          "type": "number"
        },
        "half_fov_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "min_standoff_m": {
          "type": "number",
          "minimum": 0
        },
        "max_standoff_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_incidence_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "pose_perturbations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Perturbation"
          }
        }
      }
    },
    "Occluder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occluder_id",
        "start_m",
        "end_m"
      ],
      "properties": {
        "occluder_id": {
          "type": "string",
          "minLength": 1
        },
        "start_m": {
          "$ref": "#/$defs/Point"
        },
        "end_m": {
          "$ref": "#/$defs/Point"
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "case_class",
        "expected_disposition",
        "features",
        "views",
        "occluders"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_class": {
          "enum": [
            "POSITIVE_CONTROL",
            "NEGATIVE_CONTROL",
            "METAMORPHIC"
          ]
        },
        "expected_disposition": {
          "enum": [
            "FEASIBLE",
            "INFEASIBLE",
            "INDETERMINATE"
          ]
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Feature"
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/View"
          }
        },
        "occluders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Occluder"
          }
        }
      }
    }
  }
}
