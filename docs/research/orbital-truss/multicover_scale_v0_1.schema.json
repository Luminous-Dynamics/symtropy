{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital Truss Sparse Multicover Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "problem"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-truss.multicover-scale-corpus.v0.1"
    },
    "benchmark_id": {
      "const": "ORBITAL-MULTICOVER-SCALE-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic_sparse_nominal_k_multicover_with_robust_diagnostics_only"
    },
    "problem": {
      "$ref": "#/$defs/Problem"
    }
  },
  "$defs": {
    "Feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "requested_k"
      ],
      "properties": {
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "View": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "failure_domain_id",
        "nominal_feature_ids",
        "robust_feature_ids"
      ],
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "failure_domain_id": {
          "type": "string",
          "minLength": 1
        },
        "nominal_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "robust_feature_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "coordinate_frame_id",
        "features",
        "views"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 250000,
          "items": {
            "$ref": "#/$defs/Feature"
          }
        },
        "views": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/View"
          }
        }
      }
    }
  }
}
