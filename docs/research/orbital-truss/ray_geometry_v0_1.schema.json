{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinhole Pixel-Centre Triangle Ray Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-sampling-density.geometry-corpus.v0.1"
    },
    "benchmark_id": {
      "const": "ORBITAL-RAY-TRIANGLE-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic_pinhole_pixel_centre_rays_and_nearest_triangle_intersections_only"
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/Case"
      }
    }
  },
  "$defs": {
    "Vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "Triangle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangle_id",
        "vertices_m"
      ],
      "properties": {
        "triangle_id": {
          "type": "string",
          "minLength": 1
        },
        "vertices_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Vec3"
          }
        }
      }
    },
    "Camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_id",
        "origin_m",
        "forward_axis",
        "right_axis",
        "up_axis",
        "horizontal_fov_rad",
        "width_px",
        "height_px"
      ],
      "properties": {
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_m": {
          "$ref": "#/$defs/Vec3"
        },
        "forward_axis": {
          "$ref": "#/$defs/Vec3"
        },
        "right_axis": {
          "$ref": "#/$defs/Vec3"
        },
        "up_axis": {
          "$ref": "#/$defs/Vec3"
        },
        "horizontal_fov_rad": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 3.141592653589793
        },
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    },
    "Element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "mesh_revision_id",
        "area_um2",
        "triangles"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "mesh_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "area_um2": {
          "type": "integer",
          "minimum": 1
        },
        "triangles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Triangle"
          }
        }
      }
    },
    "Expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id",
        "view_id",
        "hit_pixel_count"
      ],
      "properties": {
        "element_id": {
          "type": "string",
          "minLength": 1
        },
        "view_id": {
          "type": "string",
          "minLength": 1
        },
        "hit_pixel_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "coordinate_frame_id",
        "area_unit",
        "cameras",
        "elements",
        "expected_hit_counts"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "area_unit": {
          "const": "SQUARE_MICROMETRE"
        },
        "cameras": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Camera"
          }
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Element"
          }
        },
        "expected_hit_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Expected"
          }
        }
      }
    }
  }
}
