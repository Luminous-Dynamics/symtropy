{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital_projective_acquisition_corpus_v0_1.schema.json",
  "title": "Orbital Projective Acquisition Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-projective-acquisition.corpus.v0.1"
    },
    "benchmark_id": {
      "const": "ORBITAL-PROJECTIVE-ACQUISITION-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic_outward_rounded_projective_motion_bounds_only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "model",
          "expected_status"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_status": {
            "enum": [
              "WITHIN_DECLARED_BUDGET",
              "BUDGET_EXCEEDED",
              "BLOCKED",
              "INDETERMINATE",
              "INVALID_INPUT"
            ]
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relative_translation_speed_um_s",
              "relative_angular_speed_urad_s",
              "max_point_radius_um",
              "min_depth_um",
              "max_abs_x_um",
              "max_abs_y_um",
              "focal_x_micro_px",
              "focal_y_micro_px",
              "row_exposure_duration_ns",
              "first_to_last_row_midpoint_span_ns",
              "exposure_budget_x_micro_px",
              "exposure_budget_y_micro_px",
              "row_time_budget_x_micro_px",
              "row_time_budget_y_micro_px",
              "combined_frame_budget_x_micro_px",
              "combined_frame_budget_y_micro_px",
              "relative_motion_state",
              "support_envelope_state",
              "timing_state",
              "motion_receipt_sha256",
              "support_receipt_sha256",
              "timing_receipt_sha256"
            ],
            "properties": {
              "relative_translation_speed_um_s": {
                "type": "integer",
                "minimum": 0
              },
              "relative_angular_speed_urad_s": {
                "type": "integer",
                "minimum": 0
              },
              "max_point_radius_um": {
                "type": "integer",
                "minimum": 0
              },
              "min_depth_um": {
                "type": "integer",
                "minimum": 0
              },
              "max_abs_x_um": {
                "type": "integer",
                "minimum": 0
              },
              "max_abs_y_um": {
                "type": "integer",
                "minimum": 0
              },
              "focal_x_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "focal_y_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "row_exposure_duration_ns": {
                "type": "integer",
                "minimum": 0
              },
              "first_to_last_row_midpoint_span_ns": {
                "type": "integer",
                "minimum": 0
              },
              "exposure_budget_x_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "exposure_budget_y_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "row_time_budget_x_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "row_time_budget_y_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "combined_frame_budget_x_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "combined_frame_budget_y_micro_px": {
                "type": "integer",
                "minimum": 0
              },
              "relative_motion_state": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "support_envelope_state": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "timing_state": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "motion_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "support_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "timing_receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
