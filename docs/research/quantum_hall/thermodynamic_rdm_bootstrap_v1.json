  "RDM_validation": {
    "required_checks": [
      "Hermiticity residual",
      "Trace normalization",
      "Positive semidefiniteness and minimum eigenvalue",
      "Particle number / charge and symmetry sectors",
      "Fermionic antisymmetry and CAR consistency",
      "Consistency of nested-window marginals",
      "Consistency between RDM and declared operator expectations",
      "Gauge, orbital-order and basis convention identity"
    ],
    "exact_vs_numeric": {
      "exact": "Finite rational/algebraic identities and exact positivity certificates where available.",
      "numeric": "Floating-point eigenvalue floor, solver primal/dual residual and conditioning with declared precision.",
      "rule": "Never report numerical PSD within tolerance as exact PSD without a certificate."
    }
