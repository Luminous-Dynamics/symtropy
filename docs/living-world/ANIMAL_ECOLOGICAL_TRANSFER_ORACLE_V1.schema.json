{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/living-world/ANIMAL_ECOLOGICAL_TRANSFER_ORACLE_V1.schema.json",
  "title": "Animal Ecological Transfer Oracle V1",
  "description": "Frozen structural schema for 51 synthetic expected-contract cases. A consumer must also validate unique case IDs and cross-field/run-identity invariants; JSON Schema alone does not enforce those corpus-level checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "research_snapshot",
    "tracking_issue",
    "note",
    "case_count",
    "independent_unit",
    "required_run_identity",
    "comparison_policy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "ANIMAL-ECOLOGICAL-TRANSFER-ORACLE-V1",
      "type": "string"
    },
    "status": {
      "const": "synthetic_contract_fixture",
      "type": "string"
    },
    "research_snapshot": {
      "type": "string",
      "format": "date",
      "minLength": 10
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "case_count": {
      "const": 51,
      "type": "integer"
    },
    "independent_unit": {
      "type": "string",
      "minLength": 1
    },
    "required_run_identity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparison_policy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "setup",
          "perturbation",
          "expected",
          "fail_if",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "perturbation": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_properties"
            ],
            "properties": {
              "required_properties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "fail_if": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Corpus-level validation must also assert case_count equals cases.length, IDs are unique, and each run receipt satisfies required_run_identity/comparison_policy."
}
