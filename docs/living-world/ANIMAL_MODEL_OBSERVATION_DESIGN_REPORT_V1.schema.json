{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/living-world/ANIMAL_MODEL_OBSERVATION_DESIGN_REPORT_V1.schema.json",
  "title": "Animal Model Observation Design Report V1",
  "description": "Structural contract for expected decision-loss reduction from declared candidate observations. Each outcome includes posterior model weights for audit. Every report marks model-set adequacy and empirical validation not_assessed; it is conditional analysis, not a field recommendation or ecological validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "qualification",
    "scenario",
    "input_sha256",
    "model_ids",
    "model_weights",
    "observation_count",
    "ranked_observations"
  ],
  "properties": {
    "schema_version": {
      "const": "ANIMAL-MODEL-OBSERVATION-DESIGN-REPORT-V1"
    },
    "status": {
      "const": "scored_observation_designs_conditional_on_declared_model_set"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "model_weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "weight"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "observation_count": {
      "type": "integer",
      "minimum": 1
    },
    "ranked_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "baseline_action",
          "baseline_expected_loss",
          "expected_post_observation_loss",
          "gross_value_of_information",
          "loss_equivalent_cost",
          "net_decision_value",
          "outcomes"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "baseline_action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "baseline_expected_loss": {
            "type": "number",
            "minimum": 0
          },
          "expected_post_observation_loss": {
            "type": "number",
            "minimum": 0
          },
          "gross_value_of_information": {
            "type": "number",
            "minimum": 0
          },
          "loss_equivalent_cost": {
            "type": "number",
            "minimum": 0
          },
          "net_decision_value": {
            "type": "number"
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome",
                "probability",
                "selected_action",
                "expected_loss_after_observation",
                "posterior_model_weights"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "probability": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "selected_action": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "expected_loss_after_observation": {
                  "type": "number",
                  "minimum": 0
                },
                "posterior_model_weights": {
                  "type": "object",
                  "minProperties": 1,
                  "patternProperties": {
                    "^[a-z][a-z0-9_]*$": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_set_adequacy",
        "empirical_validation",
        "use_scope"
      ],
      "properties": {
        "model_set_adequacy": {
          "const": "not_assessed"
        },
        "empirical_validation": {
          "const": "not_assessed"
        },
        "use_scope": {
          "const": "conditional_model_set_analysis_only"
        }
      }
    }
  },
  "$comment": "A strict semantic checker should verify model_ids and model_weights align, observation_count equals ranked_observations.length, each design ID is unique, outcome probabilities sum to one, expected_post_observation_loss equals the probability-weighted outcome losses, gross value equals baseline minus expected post-observation loss within tolerance, net value equals gross value minus cost, and ranking is descending by net value with deterministic ID tie-breaks. The mandatory qualification object must remain not_assessed for model-set adequacy and empirical validation in this CLI; posterior model weights must be non-negative, normalized across each outcome, and correspond to the declared model_ids. "
}
