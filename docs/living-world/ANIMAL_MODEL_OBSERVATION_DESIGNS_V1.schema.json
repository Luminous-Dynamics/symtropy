{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/living-world/ANIMAL_MODEL_OBSERVATION_DESIGNS_V1.schema.json",
  "title": "Animal Model Observation Designs V1",
  "description": "Strict structural contract for expected decision-value observation designs. The Rust scorer additionally enforces cross-field model identity, normalized likelihoods per model, common admissible actions, unique design IDs, and finite values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "scenario",
    "note",
    "models",
    "designs"
  ],
  "properties": {
    "schema_version": {
      "const": "ANIMAL-MODEL-OBSERVATION-DESIGNS-V1"
    },
    "status": {
      "const": "synthetic_model_discriminating_observation_designs_not_empirical"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "weight",
          "action_losses",
          "admissible_actions"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "action_losses": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "admissible_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        }
      }
    },
    "designs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "loss_equivalent_cost",
          "outcome_likelihoods"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "loss_equivalent_cost": {
            "type": "number",
            "minimum": 0
          },
          "outcome_likelihoods": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
              "^[a-z][a-z0-9_]*$": {
                "type": "object",
                "minProperties": 1,
                "patternProperties": {
                  "^[a-z][a-z0-9_]*$": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "$comment": "JSON Schema defines shape only. Semantic validation must verify weights sum to one; all models share the full action-loss key set; admissible actions are declared actions; every observation outcome lists exactly all registered model IDs; likelihoods sum to one per model across outcomes; and outcomes have nonzero prior probability."
}
