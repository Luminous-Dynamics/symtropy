{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/living-world/ANIMAL_MODEL_STRUCTURE_UNCERTAINTY_ORACLE_V1.schema.json",
  "title": "Animal Model-Structure Uncertainty Oracle V1",
  "description": "Frozen structural schema; unique IDs and receipt semantics additionally require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "research_snapshot",
    "tracking_issue",
    "note",
    "case_count",
    "independent_unit",
    "required_run_identity",
    "uncertainty_components",
    "validation_levels",
    "comparison_policy",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "ANIMAL-MODEL-STRUCTURE-UNCERTAINTY-ORACLE-V1"
    },
    "status": {
      "const": "synthetic_contract_fixture"
    },
    "research_snapshot": {
      "type": "string",
      "format": "date"
    },
    "tracking_issue": {
      "type": "string",
      "format": "uri"
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "case_count": {
      "const": 35
    },
    "independent_unit": {
      "type": "string",
      "minLength": 1
    },
    "required_run_identity": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty_components": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "aleatoric",
          "parameter",
          "structural_model",
          "observation_or_state"
        ]
      }
    },
    "validation_levels": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "conceptual_structure",
          "state",
          "process",
          "system",
          "decision_robustness"
        ]
      }
    },
    "comparison_policy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "setup",
          "perturbation",
          "expected",
          "fail_if",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "perturbation": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required_properties"
            ],
            "properties": {
              "required_properties": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "fail_if": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Semantic validation must also check unique case IDs, model-set completeness, missing outputs and receipt-field presence."
}
