{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/living-world/ANIMAL_MODEL_DECISION_OUTCOMES_V1.schema.json",
  "title": "Animal Model Decision Outcomes V1",
  "description": "Shape constraints for declared per-model action losses. Weight sums, matching action sets, model ID uniqueness, and loss semantics are validated by the Rust decision kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "cvar_alpha",
    "scenario",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": "ANIMAL-MODEL-DECISION-OUTCOMES-V1"
    },
    "status": {
      "const": "synthetic_fixture_not_ecological_validation"
    },
    "cvar_alpha": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "weight",
          "action_losses",
          "admissible_actions"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "action_losses": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "admissible_actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$comment": "Schema does not check sums of model weights, equal action sets across models, valid admissible-action references, finite model values in all language bindings, or scientific adequacy. The Rust decision kernel enforces the applicable numeric/action-set invariants."
}
