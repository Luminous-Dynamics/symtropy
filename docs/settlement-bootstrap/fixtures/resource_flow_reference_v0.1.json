          "population": 8000,
          "rated_capacity_u_per_day": 18000,
          "delivered_capacity_u_per_day": 18000
        }
      ],
      "inter_group_transfer_paths": [
        {
          "from": "habitat-south",
          "to": "habitat-central",
          "available": false,
          "capacity_u_per_day": 0
