        "total_demand_u_per_day": 60000,
        "total_delivered_capacity_u_per_day": 60000,
        "total_rated_capacity_u_per_day": 62000,
        "aggregate_delivered_covers_total": true,
        "all_groups_covered": false,
        "uncovered_groups": [
          "habitat-central"
        ],
        "surplus_groups": [
          "habitat-south"
        ],
        "status": "FAIL_LOCAL_COVERAGE",
        "reason": "Aggregate delivery equals total demand, but the central habitat is 2,000 units/day short and south-habitat surplus cannot traverse a disabled transfer path."
      }
