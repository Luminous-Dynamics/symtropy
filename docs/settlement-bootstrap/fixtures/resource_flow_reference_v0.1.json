  "dependency_graph_reference": {
    "contract_version": "0.1.0",
    "node_state_semantics": {
      "VERIFIED_AVAILABLE": "Counts as available for these synthetic logic checks only.",
      "FAILED": "Unavailable until repaired and requalified.",
      "REPORTED_REPAIRED_UNVERIFIED": "Does not count as available until verification evidence changes the state.",
      "UNKNOWN": "Not certifiable as available; must remain unknown rather than be optimistically counted."
    },
    "edge_semantics": {
      "required_dependencies": "All listed dependencies are required. If any required dependency is unavailable or not certifiable, the dependent cannot be counted as available.",
      "alternative_groups": "A service is supported if at least one alternative group has every member VERIFIED_AVAILABLE. A group is an all-of path; groups are alternatives.",
      "cycle_policy": "Reject dependency cycles rather than guessing a fixed point."
    },
    "cases": [
      {
        "id": "transitive_shared_bus_outage",
