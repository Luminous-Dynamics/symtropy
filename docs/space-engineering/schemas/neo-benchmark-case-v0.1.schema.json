{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/docs/space-engineering/schemas/neo-benchmark-case-v0.1.schema.json",
  "title": "NEO Historical Benchmark Case v0.1",
  "description": "A source-bound historical reference case. It records observations and conditional inferences; it is not an orbit solver or an operational hazard assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "target",
    "event",
    "reference_observables",
    "derived_inferences",
    "sources",
    "claim_ceiling",
    "not_established"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "case_type": {
      "const": "historical_mission_observation_replay"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "designation",
        "primary",
        "system"
      ],
      "properties": {
        "name": {
          "const": "Dimorphos"
        },
        "designation": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "const": "65803 Didymos"
        },
        "system": {
          "const": "Didymos binary asteroid system"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission",
        "impactor",
        "event_type",
        "epoch_utc"
      ],
      "properties": {
        "mission": {
          "const": "NASA Double Asteroid Redirection Test (DART)"
        },
        "impactor": {
          "const": "DART spacecraft"
        },
        "event_type": {
          "const": "kinetic_impact"
        },
        "epoch_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reference_observables": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observable_id",
          "value",
          "unit",
          "uncertainty",
          "evidence_status",
          "method",
          "source_id"
        ],
        "properties": {
          "observable_id": {
            "enum": [
              "dimorphos_binary_period_change",
              "dimorphos_along_track_velocity_change"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "min",
              "mm/s"
            ]
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit",
              "sigma_multiplier"
            ],
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "min",
                  "mm/s"
                ]
              },
              "sigma_multiplier": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "evidence_status": {
            "enum": [
              "directly_observed",
              "derived_from_observations_and_geometry"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 8
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "derived_inferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inference_id",
          "value",
          "unit",
          "asymmetric_uncertainty",
          "conditioning",
          "sensitivity",
          "source_id"
        ],
        "properties": {
          "inference_id": {
            "const": "momentum_enhancement_factor_beta"
          },
          "value": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "const": "dimensionless"
          },
          "asymmetric_uncertainty": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lower",
              "upper",
              "sigma_multiplier"
            ],
            "properties": {
              "lower": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "upper": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "sigma_multiplier": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "conditioning": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimorphos_bulk_density_kg_m3",
              "interpretation"
            ],
            "properties": {
              "dimorphos_bulk_density_kg_m3": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "interpretation": {
                "type": "string",
                "minLength": 8
              }
            }
          },
          "sensitivity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "density_range_kg_m3",
              "beta_range",
              "interpretation"
            ],
            "properties": {
              "density_range_kg_m3": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "beta_range": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "interpretation": {
                "type": "string",
                "minLength": 8
              }
            }
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "published_date",
          "doi",
          "url",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 8
          },
          "published_date": {
            "type": "string",
            "format": "date"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "role": {
            "enum": [
              "primary_measurement",
              "momentum_inference"
            ]
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "historical_reference_only_not_operational_validation"
    },
    "not_established": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 8
      }
    }
  }
}
