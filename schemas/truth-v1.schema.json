{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-evidence-certificate-truth-v1.schema.json",
  "title": "AV Evidence Certificate Evaluator Truth v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "schema_version", "episode_id", "claims"],
  "properties": {
    "benchmark_id": {"const": "av-evidence-certificate-v0"},
    "schema_version": {"const": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "answerable", "acceptable_answer_values", "minimal_sufficient_evidence_sets", "supporting_spans", "supporting_boxes"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "answerable": {"type": "boolean"},
          "acceptable_answer_values": {"type": "array"},
          "minimal_sufficient_evidence_sets": {
            "type": "array",
            "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "supporting_spans": {"type": "array", "items": {"$ref": "#/$defs/evidenceSpan"}},
          "supporting_boxes": {"type": "array", "items": {"$ref": "#/$defs/evidenceBox"}},
          "temporal_iou_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.3},
          "spatial_iou_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.3}
        }
      }
    }
  },
  "$defs": {
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_ref", "start_ms", "end_ms"],
      "properties": {
        "observation_ref": {"type": "string", "minLength": 1},
        "start_ms": {"type": "number", "minimum": 0},
        "end_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "evidenceBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_ref", "start_ms", "end_ms", "frame_id", "bbox_xyxy"],
      "properties": {
        "observation_ref": {"type": "string", "minLength": 1},
        "start_ms": {"type": "number", "minimum": 0},
        "end_ms": {"type": "number", "exclusiveMinimum": 0},
        "frame_id": {"type": "string", "minLength": 1},
        "bbox_xyxy": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number", "minimum": 0, "maximum": 1}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
