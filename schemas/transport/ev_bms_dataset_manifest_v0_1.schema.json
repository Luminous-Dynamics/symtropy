{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transport/ev-bms-dataset-manifest/0.1",
  "title": "EV BMS fault dataset manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "title",
    "doi",
    "source_record_url",
    "source_repository",
    "source_version",
    "source_published_on",
    "metadata_retrieved_on",
    "license_spdx",
    "evidence_class",
    "source_domain",
    "measurement_boundary",
    "sample_interval_seconds",
    "counts",
    "label_contract",
    "asset_group_keys",
    "assets",
    "admission_state",
    "claim_ceiling"
  ],
  "properties": {
    "manifest_version": {
      "const": "ev-bms-dataset-manifest/v0.1"
    },
    "dataset_id": {
      "enum": [
        "cao-onboard-bms-zenodo-10656500",
        "shenzhen-charger-side-mendeley-c7gg94tmvz-v3"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "doi": {
      "type": "string",
      "minLength": 8
    },
    "source_record_url": {
      "type": "string",
      "format": "uri"
    },
    "source_repository": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "type": "string",
      "minLength": 1
    },
    "source_published_on": {
      "type": "string",
      "format": "date"
    },
    "metadata_retrieved_on": {
      "type": "string",
      "format": "date"
    },
    "license_spdx": {
      "const": "CC-BY-4.0"
    },
    "evidence_class": {
      "const": "operator_collected_field_observation"
    },
    "source_domain": {
      "enum": [
        "onboard_bms",
        "charger_side"
      ]
    },
    "measurement_boundary": {
      "enum": [
        "vehicle_bms",
        "charging_station_metering"
      ]
    },
    "sample_interval_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "sample_count_is_approximate",
        "vehicle_count",
        "session_count",
        "station_count",
        "manufacturer_group_count",
        "data_owner_group_count"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count_is_approximate": {
          "type": "boolean"
        },
        "vehicle_count": {
          "type": "integer",
          "minimum": 1
        },
        "session_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "station_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "manufacturer_group_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "data_owner_group_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "label_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "granularity",
        "classes",
        "label_sources",
        "limitations"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "granularity": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "label_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asset_group_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source_md5",
          "local_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_md5": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{32}$"
          },
          "local_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "admission_state": {
      "enum": [
        "metadata_only",
        "snapshot_admitted"
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
