{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/transport/terrain_mobility_scenario_v0_1.schema.json",
  "title": "Terrain Mobility Scenario Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "provenance",
    "claim_ceiling",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "corpus_id": {
      "const": "terrain-mobility-portfolio-v0.1"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_on",
        "kind",
        "external_measurements_included"
      ],
      "properties": {
        "created_on": {
          "type": "string",
          "format": "date"
        },
        "kind": {
          "const": "hand_authored_synthetic_test_vectors"
        },
        "external_measurements_included": {
          "const": false
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "claim_ceiling": {
      "const": "synthetic_fixtures_are_not_platform_performance_or_safety_evidence"
    },
    "scenarios": {
      "type": "array",
      "minItems": 24,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "domain",
        "mission_class",
        "terrain",
        "environment",
        "mission",
        "platform_classes_in_scope",
        "required_gates",
        "metric_tracks",
        "expected_behavior",
        "negative_control",
        "human_context",
        "rationale"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]{2,79}$"
        },
        "domain": {
          "enum": [
            "personal_vehicle",
            "ground_robotics",
            "cross_platform"
          ]
        },
        "mission_class": {
          "enum": [
            "essential_passenger_trip",
            "cargo_delivery",
            "field_inspection",
            "terrain_scouting",
            "site_logistics",
            "repair_return",
            "owner_personalization",
            "accessible_entry",
            "resource_recovery"
          ]
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "surface",
            "longitudinal_slope_deg",
            "cross_slope_deg",
            "step_height_m",
            "rut_depth_m",
            "surface_uncertainty",
            "drop_or_void_hazard"
          ],
          "properties": {
            "surface": {
              "enum": [
                "paved_dry",
                "paved_wet",
                "gravel",
                "washboard",
                "pothole_road",
                "grass",
                "sand",
                "mud",
                "snow_ice",
                "rock",
                "wet_rock",
                "forest_floor",
                "rubble",
                "soft_soil",
                "loose_slope",
                "indoor_ramp",
                "shallow_water_edge",
                "mixed",
                "unknown"
              ]
            },
            "longitudinal_slope_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 60
            },
            "cross_slope_deg": {
              "type": "number",
              "minimum": 0,
              "maximum": 45
            },
            "step_height_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "rut_depth_m": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "surface_uncertainty": {
              "enum": [
                "known",
                "variable",
                "unknown"
              ]
            },
            "drop_or_void_hazard": {
              "type": "boolean"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lighting",
            "weather",
            "localization",
            "communications",
            "surface_dynamics",
            "faults"
          ],
          "properties": {
            "lighting": {
              "enum": [
                "daylight",
                "dusk",
                "night",
                "low_contrast",
                "occluded"
              ]
            },
            "weather": {
              "enum": [
                "dry",
                "rain",
                "snow",
                "dust",
                "mixed"
              ]
            },
            "localization": {
              "enum": [
                "nominal",
                "gnss_denied",
                "degraded",
                "conflicting"
              ]
            },
            "communications": {
              "enum": [
                "connected",
                "intermittent",
                "lost"
              ]
            },
            "surface_dynamics": {
              "enum": [
                "stable",
                "changing",
                "unknown"
              ]
            },
            "faults": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "camera_occlusion",
                  "lidar_dropout",
                  "wheel_encoder_dropout",
                  "imu_bias",
                  "stale_map",
                  "battery_estimator_conflict",
                  "actuator_fault",
                  "tire_pressure_loss",
                  "missing_calibration",
                  "configuration_mismatch",
                  "missing_capability_evidence",
                  "owner_profile_conflict",
                  "parts_availability_unknown",
                  "low_energy_reserve",
                  "communications_loss"
                ]
              }
            }
          }
        },
        "mission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "useful_work_unit",
            "useful_work_target",
            "payload_kg",
            "load_state",
            "distance_m",
            "return_required",
            "energy_budget_wh",
            "return_margin_requirement_pct",
            "deadline_s"
          ],
          "properties": {
            "useful_work_unit": {
              "enum": [
                "passenger_trip",
                "cargo_kg",
                "tonne_km",
                "inspected_targets",
                "service_task",
                "repair_task",
                "configuration_task"
              ]
            },
            "useful_work_target": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "payload_kg": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "load_state": {
              "enum": [
                "nominal",
                "max_declared",
                "cg_shifted",
                "unknown",
                "not_applicable"
              ]
            },
            "distance_m": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "return_required": {
              "type": "boolean"
            },
            "energy_budget_wh": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "return_margin_requirement_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "deadline_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "platform_classes_in_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "personal_road_vehicle",
              "compact_aw_drive_vehicle",
              "articulated_wheeled_ugv",
              "tracked_ugv",
              "wheel_leg_hybrid_ugv",
              "legged_ugv",
              "surface_amphibious_ugv",
              "other_declared_platform"
            ]
          }
        },
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "capability_declared",
              "configuration_identity_matches",
              "safe_dispatch",
              "stability_envelope",
              "energy_or_retreat_feasible",
              "human_override",
              "hazard_unknown_abstention",
              "owner_consent_and_profile_opt_in",
              "service_isolation_verified",
              "repair_verification",
              "no_unauthorized_water_entry"
            ]
          }
        },
        "metric_tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "safety_disposition",
              "mission_completion",
              "energy_per_useful_work",
              "terrain_contact_and_progress",
              "stopping_and_stability",
              "localization_and_sensing",
              "recovery_and_retreat",
              "repairability",
              "lifecycle_cost",
              "availability",
              "ride_comfort",
              "noise_vibration",
              "accessibility",
              "cargo_fit",
              "owner_control",
              "privacy",
              "human_override",
              "essential_trip_continuity"
            ]
          }
        },
        "expected_behavior": {
          "enum": [
            "run_within_declared_envelope",
            "abort_or_retreat_safely",
            "reject_as_out_of_domain",
            "require_explicit_human_choice",
            "keep_unknown_unresolved"
          ]
        },
        "negative_control": {
          "type": "boolean"
        },
        "human_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_type",
            "consent_required",
            "owner_selected_profile",
            "outcomes"
          ],
          "properties": {
            "context_type": {
              "enum": [
                "none",
                "passenger",
                "robot_operator",
                "field_worker",
                "accessibility_task"
              ]
            },
            "consent_required": {
              "type": "boolean"
            },
            "owner_selected_profile": {
              "type": "boolean"
            },
            "outcomes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "ride_comfort",
                  "noise_vibration",
                  "accessible_entry_exit",
                  "cargo_fit",
                  "profile_restore",
                  "owner_control",
                  "privacy",
                  "essential_trip_continuity",
                  "repair_information_usability"
                ]
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 12
        }
      }
    }
  }
}
