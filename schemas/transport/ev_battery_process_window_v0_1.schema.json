{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/transport/ev_battery_process_window_v0_1.schema.json",
  "title": "EV battery process window and cell conformance manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "recipe_ref",
    "recipe_revision",
    "cell_configuration_ref",
    "process_parameters",
    "quality_specs",
    "evidence",
    "production_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_ref": {
      "type": "string",
      "minLength": 1
    },
    "recipe_revision": {
      "type": "string",
      "minLength": 1
    },
    "cell_configuration_ref": {
      "type": "string",
      "minLength": 1
    },
    "process_parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "parameter_id",
          "unit",
          "lower_bound",
          "upper_bound"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "lower_bound": {
            "type": "number"
          },
          "upper_bound": {
            "type": "number"
          }
        }
      }
    },
    "quality_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_id",
          "unit",
          "boundary"
        ],
        "properties": {
          "metric_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "lower_limit": {
            "type": [
              "number",
              "null"
            ]
          },
          "upper_limit": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_class",
          "source_digest",
          "claim_scope",
          "validity_domain",
          "admission"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "simulation",
              "surrogate",
              "calculation",
              "physical_measurement",
              "independent_laboratory"
            ]
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "validity_domain": {
            "type": "string",
            "minLength": 1
          },
          "admission": {
            "enum": [
              "candidate",
              "admitted_for_research",
              "admitted_for_evaluation",
              "blocked",
              "unknown"
            ]
          }
        }
      }
    },
    "production_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "cell_id",
          "lot_id",
          "production_line_id",
          "equipment_id",
          "recipe_ref",
          "recipe_revision",
          "cell_configuration_ref",
          "process_parameters",
          "quality_observations"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "production_line_id": {
            "type": "string",
            "minLength": 1
          },
          "equipment_id": {
            "type": "string",
            "minLength": 1
          },
          "recipe_ref": {
            "type": "string",
            "minLength": 1
          },
          "recipe_revision": {
            "type": "string",
            "minLength": 1
          },
          "cell_configuration_ref": {
            "type": "string",
            "minLength": 1
          },
          "process_parameters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parameter_id",
                "unit",
                "value",
                "evidence_id"
              ],
              "properties": {
                "parameter_id": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "quality_observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric_id",
                "unit",
                "boundary",
                "status",
                "value",
                "evidence_id"
              ],
              "properties": {
                "metric_id": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "boundary": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "observed",
                    "not_measured",
                    "invalid_measurement"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
