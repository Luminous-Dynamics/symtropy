{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/transport/battery_process_genealogy_v0_1.schema.json",
  "title": "EV battery lineage-to-outcome adapter v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "evidence_class",
    "cells",
    "cell_tests",
    "packs",
    "mission_outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "synthetic_fixture",
        "declared_physical_records"
      ]
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "configuration_ref",
          "process_window_ref",
          "material_lineage",
          "process_structure_projection",
          "interface_refs"
        ],
        "properties": {
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "configuration_ref": {
            "type": "string",
            "minLength": 1
          },
          "process_window_ref": {
            "type": "string",
            "minLength": 1
          },
          "material_lineage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sample_lineage_id",
              "mat013_schema_version",
              "sample_scale",
              "lineage_digest",
              "source_evidence_ref"
            ],
            "properties": {
              "sample_lineage_id": {
                "type": "string",
                "minLength": 1
              },
              "mat013_schema_version": {
                "type": "string",
                "minLength": 1
              },
              "sample_scale": {
                "enum": [
                  "coupon",
                  "lab_batch",
                  "device",
                  "pilot",
                  "industrial"
                ]
              },
              "lineage_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "process_structure_projection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pspp_subject_id",
              "pspp_schema_version",
              "sample_lineage_id",
              "process_window_ref",
              "realized_structure_ref",
              "conditioned_property_evidence_refs",
              "mat_uq_profile_ref"
            ],
            "properties": {
              "pspp_subject_id": {
                "type": "string",
                "minLength": 1
              },
              "pspp_schema_version": {
                "type": "string",
                "minLength": 1
              },
              "sample_lineage_id": {
                "type": "string",
                "minLength": 1
              },
              "process_window_ref": {
                "type": "string",
                "minLength": 1
              },
              "realized_structure_ref": {
                "type": "string",
                "minLength": 1
              },
              "conditioned_property_evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mat_uq_profile_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "interface_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "interface_subject_id",
                "mat_interface_schema_version",
                "interface_class",
                "condition_state_ref",
                "evidence_refs",
                "mat_uq_profile_ref"
              ],
              "properties": {
                "interface_subject_id": {
                  "type": "string",
                  "minLength": 1
                },
                "mat_interface_schema_version": {
                  "type": "string",
                  "minLength": 1
                },
                "interface_class": {
                  "type": "string",
                  "minLength": 1
                },
                "condition_state_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "mat_uq_profile_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "cell_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "cell_id",
          "configuration_ref",
          "protocol_evidence_ref",
          "metrology_evidence_ref",
          "raw_data_sha256",
          "result_evidence_class"
        ],
        "properties": {
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "configuration_ref": {
            "type": "string",
            "minLength": 1
          },
          "protocol_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "metrology_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "raw_data_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result_evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "simulation",
              "physical_measurement",
              "independent_laboratory"
            ]
          }
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pack_id",
          "configuration_ref",
          "topology_ref",
          "cell_members"
        ],
        "properties": {
          "pack_id": {
            "type": "string",
            "minLength": 1
          },
          "configuration_ref": {
            "type": "string",
            "minLength": 1
          },
          "topology_ref": {
            "type": "string",
            "minLength": 1
          },
          "cell_members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cell_id",
                "cell_configuration_ref"
              ],
              "properties": {
                "cell_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cell_configuration_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "mission_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission_id",
          "pack_id",
          "duty_cycle_ref",
          "test_campaign_ref",
          "system_boundary",
          "outcome_evidence_ref",
          "metrology_evidence_ref",
          "raw_data_sha256",
          "evidence_class"
        ],
        "properties": {
          "mission_id": {
            "type": "string",
            "minLength": 1
          },
          "pack_id": {
            "type": "string",
            "minLength": 1
          },
          "duty_cycle_ref": {
            "type": "string",
            "minLength": 1
          },
          "test_campaign_ref": {
            "type": "string",
            "minLength": 1
          },
          "system_boundary": {
            "enum": [
              "pack",
              "installed_vehicle",
              "installed_system"
            ]
          },
          "outcome_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "metrology_evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "raw_data_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "simulation",
              "physical_measurement",
              "independent_laboratory"
            ]
          }
        }
      }
    }
  }
}
