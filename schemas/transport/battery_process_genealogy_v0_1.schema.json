{"$schema":"https://json-schema.org/draft/2020-12/schema",
"$id":"https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/transport/battery_process_genealogy_v0_1.schema.json",
"title":"Battery process genealogy manifest v0.1",
"type":"object","additionalProperties":false,
"required":["schema_version","manifest_id","evidence_class","material_lots","process_events","specimens","cell_builds","test_links"],
"properties":{
"schema_version":{"const":"0.1.0"},
"manifest_id":{"type":"string","minLength":1},
"evidence_class":{"enum":["synthetic_fixture","physical_record"]},
"material_lots":{"type":"array","minItems":1,"items":{"type":"object","required":["lot_id","material_family","source_ref","disposition"]}},
"process_events":{"type":"array","minItems":1,"items":{"type":"object","required":["event_id","stage","recipe_revision","equipment_id","timestamp","parent_ids","child_ids","field_records"]}},
"specimens":{"type":"array","minItems":1,"items":{"type":"object","required":["specimen_id","specimen_type","parent_ids"]}},
"cell_builds":{"type":"array","items":{"type":"object","required":["cell_id","configuration_ref","electrode_specimen_ids","assembly_event_id","formation_event_id"]}},
"test_links":{"type":"array","items":{"type":"object","required":["test_id","cell_id","protocol_evidence_ref","metrology_evidence_ref","raw_data_digest","result_evidence_class"]}}
}
}
