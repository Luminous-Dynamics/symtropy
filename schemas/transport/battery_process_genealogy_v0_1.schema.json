{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/transport/battery_process_genealogy_v0_1.schema.json",
  "title": "Battery process genealogy manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "evidence_class",
    "material_lots",
    "process_events",
    "specimens",
    "cell_builds",
    "test_links"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "synthetic_fixture",
        "physical_record"
      ]
    },
    "material_lots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lot_id",
          "material_family",
          "source_ref",
          "received_at_ns"
        ],
        "properties": {
          "lot_id": {
            "type": "string",
            "minLength": 1
          },
          "material_family": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "received_at_ns": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "process_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "stage",
          "recipe_revision",
          "equipment_id",
          "timestamp_ns",
          "parent_ids",
          "child_ids",
          "field_records"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "slurry_preparation",
              "coating",
              "drying",
              "calendering",
              "slitting",
              "cell_assembly",
              "formation",
              "aging",
              "inspection"
            ]
          },
          "recipe_revision": {
            "type": "string",
            "minLength": 1
          },
          "equipment_id": {
            "type": "string",
            "minLength": 1
          },
          "timestamp_ns": {
            "type": "integer",
            "minimum": 0
          },
          "parent_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "child_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "field_records": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "value",
                "unit",
                "kind",
                "evidence_ref"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "measured",
                    "calculated",
                    "model_predicted",
                    "operator_declared",
                    "unknown",
                    "synthetic_fixture"
                  ]
                },
                "evidence_ref": {
                  "type": "string"
                },
                "instrument_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "calibration_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "specimens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "specimen_id",
          "specimen_type",
          "created_at_ns",
          "created_by_event_id",
          "parent_ids"
        ],
        "properties": {
          "specimen_id": {
            "type": "string"
          },
          "specimen_type": {
            "type": "string"
          },
          "created_at_ns": {
            "type": "integer",
            "minimum": 0
          },
          "created_by_event_id": {
            "type": "string"
          },
          "parent_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "cell_builds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cell_id",
          "created_at_ns",
          "configuration_ref",
          "electrode_specimen_ids",
          "assembly_event_id",
          "formation_event_id",
          "parent_ids"
        ],
        "properties": {
          "cell_id": {
            "type": "string"
          },
          "created_at_ns": {
            "type": "integer",
            "minimum": 0
          },
          "configuration_ref": {
            "type": "string"
          },
          "electrode_specimen_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "assembly_event_id": {
            "type": "string"
          },
          "formation_event_id": {
            "type": "string"
          },
          "parent_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "test_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "cell_id",
          "configuration_ref",
          "protocol_evidence_ref",
          "metrology_evidence_ref",
          "raw_data_sha256",
          "result_evidence_class"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          },
          "configuration_ref": {
            "type": "string"
          },
          "protocol_evidence_ref": {
            "type": "string"
          },
          "metrology_evidence_ref": {
            "type": "string"
          },
          "raw_data_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result_evidence_class": {
            "enum": [
              "synthetic_fixture",
              "assumption",
              "vendor_claim",
              "literature_reported",
              "simulation",
              "physical_measurement",
              "independent_laboratory"
            ]
          }
        }
      }
    }
  }
}
