{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/transport/ev_bms_signed_event_v0_1",
  "title": "Signed EV BMS event evidence corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_version",
    "policy",
    "trusted_keys",
    "asset_bindings",
    "events"
  ],
  "properties": {
    "corpus_version": {
      "const": "ev-bms-evidence-auth-corpus/0.1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_clock_uncertainty_ms",
        "trusted_clock_sources",
        "admitted_boot_epochs"
      ],
      "properties": {
        "maximum_clock_uncertainty_ms": {
          "type": "integer",
          "minimum": 0
        },
        "trusted_clock_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "admitted_boot_epochs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_ref",
              "producer_id",
              "boot_epoch_id",
              "firmware_sha256",
              "vehicle_ref",
              "pack_ref",
              "configuration_sha256"
            ],
            "properties": {
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              },
              "producer_id": {
                "type": "string",
                "minLength": 1
              },
              "boot_epoch_id": {
                "type": "string",
                "minLength": 1
              },
              "firmware_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "vehicle_ref": {
                "type": "string",
                "minLength": 1
              },
              "pack_ref": {
                "type": "string",
                "minLength": 1
              },
              "configuration_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "trusted_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "producer_id",
          "producer_role",
          "public_key_hex",
          "valid_from_ms",
          "valid_until_ms",
          "revoked",
          "authorized_event_types"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_id": {
            "type": "string",
            "minLength": 1
          },
          "producer_role": {
            "enum": [
              "BMS",
              "CELL_MONITOR",
              "GATEWAY",
              "SERVICE_TESTER",
              "OPERATOR"
            ]
          },
          "public_key_hex": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "valid_from_ms": {
            "type": "integer",
            "minimum": 0
          },
          "valid_until_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "revoked": {
            "type": "boolean"
          },
          "authorized_event_types": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "asset_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "vehicle_ref",
          "pack_ref",
          "configuration_sha256"
        ],
        "properties": {
          "vehicle_ref": {
            "type": "string",
            "minLength": 1
          },
          "pack_ref": {
            "type": "string",
            "minLength": 1
          },
          "configuration_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claims",
          "signature_hex"
        ],
        "properties": {
          "claims": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "producer_id",
              "producer_role",
              "vehicle_ref",
              "pack_ref",
              "configuration_sha256",
              "key_id",
              "boot_epoch_id",
              "boot_attestation_ref",
              "sequence",
              "nonce_hex",
              "observed_at_ms",
              "clock_source",
              "clock_uncertainty_ms",
              "firmware_sha256",
              "payload"
            ],
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "producer_id": {
                "type": "string",
                "minLength": 1
              },
              "producer_role": {
                "enum": [
                  "BMS",
                  "CELL_MONITOR",
                  "GATEWAY",
                  "SERVICE_TESTER",
                  "OPERATOR"
                ]
              },
              "vehicle_ref": {
                "type": "string",
                "minLength": 1
              },
              "pack_ref": {
                "type": "string",
                "minLength": 1
              },
              "configuration_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "key_id": {
                "type": "string",
                "minLength": 1
              },
              "boot_epoch_id": {
                "type": "string",
                "minLength": 1
              },
              "boot_attestation_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "nonce_hex": {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              "observed_at_ms": {
                "type": "integer",
                "minimum": 0
              },
              "clock_source": {
                "type": "string",
                "minLength": 1
              },
              "clock_uncertainty_ms": {
                "type": "integer",
                "minimum": 0
              },
              "firmware_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_type",
                  "channel",
                  "sensor_ref",
                  "value",
                  "unit",
                  "evidence_class",
                  "calibration_status",
                  "calibration_ref",
                  "calibration_sha256",
                  "sensor_valid",
                  "out_of_domain",
                  "protocol_ref",
                  "observation_digest"
                ],
                "properties": {
                  "event_type": {
                    "enum": [
                      "soc_snapshot",
                      "soh_estimate",
                      "cell_voltage_sample",
                      "temperature_sample",
                      "fault_diagnostic",
                      "service_test_result",
                      "service_completion"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sensor_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "unit": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "evidence_class": {
                    "enum": [
                      "direct_sensor_measurement",
                      "reference_test_measurement",
                      "bms_reported",
                      "derived_estimate",
                      "model_prediction",
                      "simulation_output",
                      "vendor_claim",
                      "service_attestation"
                    ]
                  },
                  "calibration_status": {
                    "enum": [
                      "current",
                      "expired",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "calibration_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "calibration_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "sensor_valid": {
                    "type": "boolean"
                  },
                  "out_of_domain": {
                    "type": "boolean"
                  },
                  "protocol_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "observation_digest": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          },
          "signature_hex": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{128}$"
          }
        }
      }
    }
  }
}
