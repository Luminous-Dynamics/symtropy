{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/transport/multimodal_mission_chain_v0_1.schema.json",
  "title": "Synthetic Multimodal Mission Chain v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "provenance",
    "claim_ceiling",
    "environments",
    "payload_profiles",
    "platform_profiles",
    "hub_profiles",
    "mission_scenarios",
    "assessments"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark_id": {
      "const": "multimodal-mission-chain-v0.1"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "claim_ceiling": {
      "const": "synthetic_chain_feasibility_is_not_route_authorization_or_real_world_transport_validation"
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "payload_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/payload"
      }
    },
    "platform_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "hub_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hub"
      }
    },
    "mission_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mission"
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessment"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "external_real_world_data_included",
        "notes"
      ],
      "properties": {
        "kind": {
          "const": "synthetic_only"
        },
        "external_real_world_data_included": {
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "min_ambient_temp_c",
        "max_ambient_temp_c"
      ],
      "properties": {
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "min_ambient_temp_c": {
          "type": "number"
        },
        "max_ambient_temp_c": {
          "type": "number"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_id",
        "payload_class",
        "mass_kg_max",
        "temperature_range_c",
        "securement_required",
        "occupants",
        "occupant_class",
        "accessible_transfer_required",
        "wheelchair_securement_required",
        "patient_support_required",
        "caregiver_access_required",
        "privacy_sensitive"
      ],
      "properties": {
        "payload_id": {
          "type": "string",
          "minLength": 1
        },
        "payload_class": {
          "enum": [
            "bulk_cargo",
            "cold_chain",
            "fragile_instrument",
            "contained_liquid",
            "seated_passengers",
            "wheelchair_user",
            "stretcher_patient",
            "field_crew"
          ]
        },
        "mass_kg_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temperature_range_c": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/range"
            }
          ]
        },
        "securement_required": {
          "type": "boolean"
        },
        "occupants": {
          "type": "integer",
          "minimum": 0
        },
        "occupant_class": {
          "enum": [
            "none",
            "seated",
            "wheelchair",
            "stretcher_patient",
            "field_crew"
          ]
        },
        "accessible_transfer_required": {
          "type": "boolean"
        },
        "wheelchair_securement_required": {
          "type": "boolean"
        },
        "patient_support_required": {
          "type": "boolean"
        },
        "caregiver_access_required": {
          "type": "boolean"
        },
        "privacy_sensitive": {
          "type": "boolean"
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_id",
        "mode",
        "environment_ids",
        "supported_payload_classes",
        "max_payload_kg",
        "ambient_temp_min_c",
        "ambient_temp_max_c",
        "controlled_temp_min_c",
        "controlled_temp_max_c",
        "has_securement",
        "has_occupant_restraints",
        "has_accessible_transfer",
        "has_wheelchair_securement",
        "has_patient_support",
        "has_caregiver_access",
        "has_emergency_egress",
        "has_privacy_controls",
        "has_recovery_plan",
        "has_emergency_stop"
      ],
      "properties": {
        "platform_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "watercraft",
            "wheeled_rover",
            "tracked_carrier",
            "sled",
            "ground_carrier",
            "aerial"
          ]
        },
        "environment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "supported_payload_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bulk_cargo",
              "cold_chain",
              "fragile_instrument",
              "contained_liquid",
              "seated_passengers",
              "wheelchair_user",
              "stretcher_patient",
              "field_crew"
            ]
          }
        },
        "max_payload_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ambient_temp_min_c": {
          "type": "number"
        },
        "ambient_temp_max_c": {
          "type": "number"
        },
        "controlled_temp_min_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "controlled_temp_max_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "has_securement": {
          "type": "boolean"
        },
        "has_occupant_restraints": {
          "type": "boolean"
        },
        "has_accessible_transfer": {
          "type": "boolean"
        },
        "has_wheelchair_securement": {
          "type": "boolean"
        },
        "has_patient_support": {
          "type": "boolean"
        },
        "has_caregiver_access": {
          "type": "boolean"
        },
        "has_emergency_egress": {
          "type": "boolean"
        },
        "has_privacy_controls": {
          "type": "boolean"
        },
        "has_recovery_plan": {
          "type": "boolean"
        },
        "has_emergency_stop": {
          "type": "boolean"
        }
      }
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hub_id",
        "environment_id",
        "accepted_payload_classes",
        "max_handling_mass_kg",
        "storage_temperature_zones",
        "has_securement",
        "has_condition_control",
        "has_accessible_transfer",
        "has_patient_support",
        "has_caregiver_access",
        "has_privacy_custody",
        "has_operator_staffing",
        "has_recovery_support"
      ],
      "properties": {
        "hub_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_payload_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bulk_cargo",
              "cold_chain",
              "fragile_instrument",
              "contained_liquid",
              "seated_passengers",
              "wheelchair_user",
              "stretcher_patient",
              "field_crew"
            ]
          }
        },
        "max_handling_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "storage_temperature_zones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "has_securement": {
          "type": "boolean"
        },
        "has_condition_control": {
          "type": "boolean"
        },
        "has_accessible_transfer": {
          "type": "boolean"
        },
        "has_patient_support": {
          "type": "boolean"
        },
        "has_caregiver_access": {
          "type": "boolean"
        },
        "has_privacy_custody": {
          "type": "boolean"
        },
        "has_operator_staffing": {
          "type": "boolean"
        },
        "has_recovery_support": {
          "type": "boolean"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "mission_class",
        "origin_hub_id",
        "destination_hub_id",
        "payload_ids",
        "deadline_minutes",
        "operating_notes"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_class": {
          "type": "string",
          "minLength": 1
        },
        "origin_hub_id": {
          "type": "string",
          "minLength": 1
        },
        "destination_hub_id": {
          "type": "string",
          "minLength": 1
        },
        "payload_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "deadline_minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "operating_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ]
    },
    "leg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leg_id",
        "platform_id",
        "origin_hub_id",
        "destination_hub_id",
        "duration_minutes_min",
        "duration_minutes_max",
        "route_authorization_status",
        "environmental_protection_status",
        "recovery_status",
        "hazard_status"
      ],
      "properties": {
        "leg_id": {
          "type": "string",
          "minLength": 1
        },
        "platform_id": {
          "type": "string",
          "minLength": 1
        },
        "origin_hub_id": {
          "type": "string",
          "minLength": 1
        },
        "destination_hub_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_minutes_min": {
          "type": "number",
          "minimum": 0
        },
        "duration_minutes_max": {
          "type": "number",
          "minimum": 0
        },
        "route_authorization_status": {
          "$ref": "#/$defs/status"
        },
        "environmental_protection_status": {
          "$ref": "#/$defs/status"
        },
        "recovery_status": {
          "$ref": "#/$defs/status"
        },
        "hazard_status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_id",
        "from_leg_id",
        "to_leg_id",
        "hub_id",
        "duration_minutes_min",
        "duration_minutes_max",
        "authorization_status",
        "environmental_protection_status",
        "securement_status",
        "condition_control_status",
        "accessibility_status",
        "patient_support_status",
        "privacy_custody_status",
        "operator_status",
        "recovery_status",
        "hazard_status"
      ],
      "properties": {
        "handoff_id": {
          "type": "string",
          "minLength": 1
        },
        "from_leg_id": {
          "type": "string",
          "minLength": 1
        },
        "to_leg_id": {
          "type": "string",
          "minLength": 1
        },
        "hub_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_minutes_min": {
          "type": "number",
          "minimum": 0
        },
        "duration_minutes_max": {
          "type": "number",
          "minimum": 0
        },
        "authorization_status": {
          "$ref": "#/$defs/status"
        },
        "environmental_protection_status": {
          "$ref": "#/$defs/status"
        },
        "securement_status": {
          "$ref": "#/$defs/status"
        },
        "condition_control_status": {
          "$ref": "#/$defs/status"
        },
        "accessibility_status": {
          "$ref": "#/$defs/status"
        },
        "patient_support_status": {
          "$ref": "#/$defs/status"
        },
        "privacy_custody_status": {
          "$ref": "#/$defs/status"
        },
        "operator_status": {
          "$ref": "#/$defs/status"
        },
        "recovery_status": {
          "$ref": "#/$defs/status"
        },
        "hazard_status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_id",
        "mission_id",
        "legs",
        "handoffs"
      ],
      "properties": {
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "legs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/leg"
          }
        },
        "handoffs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/handoff"
          }
        }
      }
    }
  }
}
