{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/water-process-closure-001-run-v1.schema.json",
  "title": "Water process closure evaluator receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verification_state",
    "qualification_status",
    "implementation_revision",
    "input_sha256",
    "oracle_sha256",
    "cargo_lock_sha256",
    "result_count",
    "matched_case_count",
    "mismatches",
    "results",
    "claim_ceiling",
    "nonclaims"
  ],
  "properties": {
    "schema_version": {
      "const": "water-process-closure-001-run-v1"
    },
    "verification_state": {
      "enum": [
        "PassedExactRevision",
        "PassedLocalUnpinned",
        "OracleMismatch"
      ]
    },
    "qualification_status": {
      "const": "NotRun"
    },
    "implementation_revision": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_count": {
      "type": "integer",
      "const": 16
    },
    "matched_case_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    },
    "mismatches": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "expected",
          "actual"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^WPC-[0-9]{2}$"
          },
          "expected": {
            "$ref": "#/$defs/caseResult"
          },
          "actual": {
            "$ref": "#/$defs/caseResult"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "claim_ceiling": {
      "const": "WaterProcessAccountingContractOnly"
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cargo_lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "water_balance_status",
        "material_mass_status",
        "tracer_status",
        "lifecycle_status",
        "overall_disposition"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^WPC-[0-9]{2}$"
        },
        "water_balance_status": {
          "enum": [
            "ExactBalanced",
            "ExactUnbalanced",
            "Invalid",
            "Incomplete"
          ]
        },
        "material_mass_status": {
          "enum": [
            "ExactBalanced",
            "ExactUnbalanced",
            "PossibleWithUncertainty",
            "ImpossibleWithinBounds",
            "Incomplete",
            "Invalid"
          ]
        },
        "tracer_status": {
          "enum": [
            "NotApplicable",
            "ExactBalanced",
            "Unbalanced",
            "NotAssessable"
          ]
        },
        "lifecycle_status": {
          "enum": [
            "ClosedForAccounting",
            "Indeterminate",
            "Incomplete"
          ]
        },
        "overall_disposition": {
          "enum": [
            "AccountingOnly",
            "Unbalanced",
            "Invalid",
            "Indeterminate",
            "Incomplete"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_state": {
            "const": "PassedExactRevision"
          }
        },
        "required": [
          "verification_state"
        ]
      },
      "then": {
        "properties": {
          "implementation_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "matched_case_count": {
            "const": 16
          },
          "mismatches": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_state": {
            "const": "PassedLocalUnpinned"
          }
        },
        "required": [
          "verification_state"
        ]
      },
      "then": {
        "properties": {
          "implementation_revision": {
            "type": "null"
          },
          "matched_case_count": {
            "const": 16
          },
          "mismatches": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_state": {
            "const": "OracleMismatch"
          }
        },
        "required": [
          "verification_state"
        ]
      },
      "then": {
        "properties": {
          "mismatches": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
