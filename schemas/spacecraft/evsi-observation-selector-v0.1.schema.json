{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/spacecraft/evsi-observation-selector-v0.1.schema.json",
  "title": "Spacecraft EVSI Observation Selector Scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "mission",
    "probability_denominator",
    "hypotheses",
    "prior_probability_bps",
    "decisions",
    "decision_loss_units",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "probability_denominator": {
      "const": 10000
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "prior_probability_bps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "decision_loss_units": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 32,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "likelihood_bps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "likelihood_bps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cost_units",
        "estimated_latency_us",
        "max_latency_us",
        "capability_available",
        "preconditions_met",
        "dependencies_known",
        "advisory_only",
        "actuation_authority",
        "outcomes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "estimated_latency_us": {
          "type": "integer",
          "minimum": 1
        },
        "max_latency_us": {
          "type": "integer",
          "minimum": 1
        },
        "capability_available": {
          "type": "boolean"
        },
        "preconditions_met": {
          "type": "boolean"
        },
        "dependencies_known": {
          "type": "boolean"
        },
        "advisory_only": {
          "type": "boolean"
        },
        "actuation_authority": {
          "type": "boolean"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        }
      }
    }
  }
}
