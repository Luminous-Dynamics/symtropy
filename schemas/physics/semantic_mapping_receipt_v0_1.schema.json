{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physics/semantic_mapping_receipt_v0_1.schema.json",
  "title": "Symtropy Cross-Simulator Semantic Mapping Receipt V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario",
    "left_backend",
    "right_backend",
    "dimensions",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "symtropy.semantic_mapping_receipt/0.1"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "left_backend": {
      "$ref": "#/$defs/backend"
    },
    "right_backend": {
      "$ref": "#/$defs/backend"
    },
    "dimensions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/dimension_mapping"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "identity_geometry"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "mass_properties"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "constraints"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "contacts"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "integration"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "ccd"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "actuation"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "observations"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "dimension"
            ],
            "properties": {
              "dimension": {
                "const": "numerical_profile"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author_id",
        "reviewer_id"
      ],
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_id",
        "version",
        "adapter_commit",
        "profile_id",
        "profile_digest"
      ],
      "properties": {
        "engine_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "adapter_commit": {
          "$ref": "#/$defs/commit"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dimension_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "status",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "identity_geometry",
            "mass_properties",
            "constraints",
            "contacts",
            "integration",
            "ccd",
            "actuation",
            "observations",
            "numerical_profile"
          ]
        },
        "status": {
          "enum": [
            "strictly_equivalent",
            "mapped_equivalent_with_bound",
            "not_applicable",
            "not_provided",
            "non_equivalent",
            "unsupported",
            "unknown_unassessed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "string",
          "minLength": 1
        },
        "error_bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error_bound"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "mapped_equivalent_with_bound"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "transformation",
              "error_bounds"
            ],
            "properties": {
              "error_bounds": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "strictly_equivalent",
                  "non_equivalent",
                  "unsupported"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "transformation"
                  ]
                },
                {
                  "required": [
                    "error_bounds"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "error_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "maximum_absolute_error",
        "unit",
        "source"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "maximum_absolute_error": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
