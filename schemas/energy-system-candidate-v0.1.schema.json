{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/energy-system-candidate-v0.1.schema.json",
  "title": "Evidence-bounded candidate energy-system design v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "generator",
    "synthetic",
    "evidence_class",
    "evidence_ref",
    "system_boundary",
    "horizon",
    "components",
    "connections",
    "services",
    "scenarios",
    "hard_constraints",
    "objectives",
    "requested_evaluations",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "energy-system-candidate-v0.1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "synthetic": {
      "type": "boolean"
    },
    "evidence_class": {
      "$ref": "#/$defs/evidenceClass"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "system_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_id",
        "description",
        "included_boundaries",
        "excluded_boundaries"
      ],
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "included_boundaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_unix_seconds",
        "end_unix_seconds",
        "timezone",
        "interval_seconds"
      ],
      "properties": {
        "start_unix_seconds": {
          "type": "integer"
        },
        "end_unix_seconds": {
          "type": "integer"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "interval_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "requested_evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "schema_validation",
          "conservation_audit",
          "exact_dispatch_reference",
          "thermal_exergy",
          "chronological_reliability",
          "symtropy_trajectory",
          "fault_replay",
          "sensitivity",
          "external_reference_comparison"
        ]
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_class": {
            "not": {
              "const": "analyst_assumption"
            }
          }
        },
        "required": [
          "evidence_class"
        ]
      },
      "then": {
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "evidenceClass": {
      "type": "string",
      "enum": [
        "analyst_assumption",
        "published_model",
        "vendor_target",
        "measured",
        "field_pilot",
        "operating_plant",
        "replicated_fleet",
        "independently_audited"
      ]
    },
    "carrier": {
      "type": "string",
      "enum": [
        "electricity",
        "thermal_heat",
        "chemical_fuel",
        "mechanical_work",
        "radiant_energy"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "kW",
        "kWh",
        "MW",
        "MWh",
        "kW_th",
        "kWh_th",
        "kW_e",
        "kWh_e",
        "degC",
        "K",
        "kg",
        "kg_CO2e",
        "currency",
        "L",
        "m3",
        "vehicle_km",
        "unitless"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "lower",
        "upper",
        "notes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none_declared",
            "interval",
            "standard_deviation",
            "distribution",
            "qualitative",
            "unknown"
          ]
        },
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "parameterClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "value",
        "unit",
        "evidence_class",
        "source_ref",
        "as_of",
        "applicability",
        "uncertainty"
      ],
      "properties": {
        "parameter_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidenceClass"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "not": {
                  "const": "analyst_assumption"
                }
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port_id",
        "direction",
        "carrier",
        "unit",
        "temperature_grade_c"
      ],
      "properties": {
        "port_id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "input",
            "output",
            "bidirectional"
          ]
        },
        "carrier": {
          "$ref": "#/$defs/carrier"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "temperature_grade_c": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "carrier": {
                "const": "thermal_heat"
              }
            },
            "required": [
              "carrier"
            ]
          },
          "then": {
            "properties": {
              "temperature_grade_c": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "temperature_grade_c": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "kind",
        "name",
        "ports",
        "parameter_claims"
      ],
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "converter",
            "storage",
            "distribution",
            "controller",
            "service_interface",
            "sink"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "parameter_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameterClaim"
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "from_component",
        "from_port",
        "to_component",
        "to_port",
        "carrier"
      ],
      "properties": {
        "connection_id": {
          "type": "string",
          "minLength": 1
        },
        "from_component": {
          "type": "string",
          "minLength": 1
        },
        "from_port": {
          "type": "string",
          "minLength": 1
        },
        "to_component": {
          "type": "string",
          "minLength": 1
        },
        "to_port": {
          "type": "string",
          "minLength": 1
        },
        "carrier": {
          "$ref": "#/$defs/carrier"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "service_kind",
        "component_id",
        "essential",
        "unit",
        "minimum_delivery_temperature_c",
        "description"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1
        },
        "service_kind": {
          "type": "string",
          "enum": [
            "electricity",
            "thermal_heat",
            "water",
            "communications",
            "mobility",
            "industrial_process",
            "compute"
          ]
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "essential": {
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "minimum_delivery_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "service_kind": {
                "const": "thermal_heat"
              }
            },
            "required": [
              "service_kind"
            ]
          },
          "then": {
            "properties": {
              "minimum_delivery_temperature_c": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "minimum_delivery_temperature_c": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_id",
        "start_unix_seconds",
        "duration_seconds",
        "grid_outage",
        "resource_available_kwh",
        "service_requested"
      ],
      "properties": {
        "interval_id": {
          "type": "string",
          "minLength": 1
        },
        "start_unix_seconds": {
          "type": "integer"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "grid_outage": {
          "type": "boolean"
        },
        "resource_available_kwh": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_id",
              "available_kwh"
            ],
            "properties": {
              "component_id": {
                "type": "string",
                "minLength": 1
              },
              "available_kwh": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "service_requested": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "service_id",
              "requested_quantity"
            ],
            "properties": {
              "service_id": {
                "type": "string",
                "minLength": 1
              },
              "requested_quantity": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "evidence_class",
        "source_ref",
        "description",
        "intervals"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidenceClass"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "intervals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/interval"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "not": {
                  "const": "analyst_assumption"
                }
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "description",
        "severity",
        "verifier_id"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "hard",
            "soft"
          ]
        },
        "verifier_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "direction",
        "unit",
        "description"
      ],
      "properties": {
        "objective_id": {
          "type": "string",
          "enum": [
            "essential_unserved_energy",
            "flexible_unserved_energy",
            "service_reliability",
            "lifecycle_cost",
            "operating_cost",
            "emissions",
            "water_use",
            "land_use",
            "material_use",
            "curtailment",
            "maintenance_burden",
            "recovery_time",
            "candidate_compute_cost"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "minimize",
            "maximize"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
