{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:luminous-dynamics:garment-care-ops:0.1.0",
  "title":"Garment-Care Continuous Production Episode Contract v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","program_id","status","claim_ceiling","event_types","required_event_fields","terminal_states","reconciliation_policy","custody_policy","failure_families","fault_injection_scenarios","metrics","governance","sources"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "program_id":{"const":"GARMENT-OPS-001"},
    "status":{"const":"proposal_no_physical_observations"},
    "claim_ceiling":{"const":"no_production_recorder_or_reliability_qualification"},
    "event_types":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"enum":["production_run","sop_step","failure_event","intervention_event","machine_health_event","resource_event","custody_event"]}},
    "required_event_fields":{"type":"array","minItems":12,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "terminal_states":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"enum":["accepted_destination","quarantined","human_handoff","lost_or_damaged"]}},
    "reconciliation_policy":{
      "type":"object","additionalProperties":false,
      "required":["attempts_reconcile","eventual_acceptance_reconciles","retry_linked_to_original","every_attempt_has_one_terminal_state","unknown_terminal_blocks_summary","wrong_destination_is_not_success"],
      "properties":{
        "attempts_reconcile":{"const":true},
        "eventual_acceptance_reconciles":{"const":true},
        "retry_linked_to_original":{"const":true},
        "every_attempt_has_one_terminal_state":{"const":true},
        "unknown_terminal_blocks_summary":{"const":true},
        "wrong_destination_is_not_success":{"const":true}
      }
    },
    "custody_policy":{
      "type":"object","additionalProperties":false,
      "required":["local_first_recording","offline_episode_recording","network_required_for_local_recovery","promoted_artifact_digest_required","delete_local_only_after_receipt","partial_upload_is_failure","ring_buffer_capacity_fault_is_visible","raw_video_required_for_routine_episode"],
      "properties":{
        "local_first_recording":{"const":true},
        "offline_episode_recording":{"const":true},
        "network_required_for_local_recovery":{"const":false},
        "promoted_artifact_digest_required":{"const":true},
        "delete_local_only_after_receipt":{"const":true},
        "partial_upload_is_failure":{"const":true},
        "ring_buffer_capacity_fault_is_visible":{"const":true},
        "raw_video_required_for_routine_episode":{"const":false}
      }
    },
    "failure_families":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "fault_injection_scenarios":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "metrics":{
      "type":"array","minItems":10,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","unit","denominator","scope","target_hypothesis","status","hard_guardrails"],
        "properties":{
          "id":{"type":"string","minLength":4},
          "unit":{"type":"string","minLength":1},
          "denominator":{"type":"string","minLength":3},
          "scope":{"type":"string","minLength":15},
          "target_hypothesis":{"type":"string","minLength":3},
          "status":{"const":"proposal_target_only"},
          "hard_guardrails":{"type":"array","minItems":1,"items":{"type":"string","minLength":4}}
        }
      }
    },
    "governance":{
      "type":"object","additionalProperties":false,
      "required":["physical_observations","production_episodes","trained_failure_models","product_claims","symthaea_authority","physical_interlocks","claim_scope"],
      "properties":{
        "physical_observations":{"const":0},
        "production_episodes":{"const":0},
        "trained_failure_models":{"const":0},
        "product_claims":{"const":false},
        "symthaea_authority":{"const":"advisory_diagnostics_only_no_actuation"},
        "physical_interlocks":{"const":"independent_deterministic_device_controls"},
        "claim_scope":{"const":"contract_only"}
      }
    },
    "sources":{
      "type":"array","minItems":3,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["id","uri","scope_note"],
        "properties":{
          "id":{"type":"string","minLength":3},
          "uri":{"type":"string","format":"uri","pattern":"^https://"},
          "scope_note":{"type":"string","minLength":15}
        }
      }
    }
  }
}