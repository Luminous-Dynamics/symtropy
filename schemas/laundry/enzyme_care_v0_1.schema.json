{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:luminous-dynamics:enzyme-care:0.1.0",
  "title":"Selective Enzyme Textile Care Experiment Contract v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","program_id","status","claim_ceiling","tracks","external_comparators","control_arms","standards","validation_policy","safety_policy","metrics","hard_gates","governance","sources"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "program_id":{"const":"ENZYME-CARE-001"},
    "status":{"const":"proposal_no_physical_measurements"},
    "claim_ceiling":{"const":"no_formulation_or_garment_process_qualification"},
    "tracks":{"type":"array","minItems":2,"maxItems":2,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","objective","treatment_families","substrate_strata","primary_endpoints","maximum_inference"],
      "properties":{
        "id":{"enum":["wool_anti_felting_finishing","stain_specific_enzyme_care"]},
        "objective":{"type":"string","minLength":20},
        "treatment_families":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["untreated_control","sham_auxiliary_control","enzyme_only","enzyme_plus_polymer_prefill","enzyme_plus_reductant","enzyme_plus_other_auxiliary","detergent_only","detergent_plus_single_enzyme","detergent_plus_enzyme_cocktail","inactive_enzyme_control","localized_pretreatment","commercial_reference"]}},
        "substrate_strata":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":4}},
        "primary_endpoints":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string","minLength":4}},
        "maximum_inference":{"type":"string","minLength":20}
      }
    }},
    "external_comparators":{"type":"array","minItems":5,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","track_id","treatment_family","enzyme_only_claim","auxiliary_chemistry","substrate_scope","reported_outcomes","reported_conditions","source_uri","scope_note","is_our_result"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "track_id":{"enum":["wool_anti_felting_finishing","stain_specific_enzyme_care"]},
        "treatment_family":{"enum":["enzyme_only","enzyme_plus_polymer_prefill","enzyme_plus_reductant","enzyme_plus_detergent","enzyme_plus_other_auxiliary"]},
        "enzyme_only_claim":{"type":"boolean"},
        "auxiliary_chemistry":{"type":"array","items":{"type":"string","minLength":3}},
        "substrate_scope":{"type":"string","minLength":10},
        "reported_outcomes":{"type":"array","minItems":1,"items":{"type":"string","minLength":5}},
        "reported_conditions":{"type":"string","minLength":10},
        "reported_temperature_c":{"type":["number","null"]},
        "source_uri":{"type":"string","format":"uri","pattern":"^https://"},
        "scope_note":{"type":"string","minLength":20},
        "is_our_result":{"const":false}
      }
    }},
    "control_arms":{"type":"array","minItems":10,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "standards":{
      "type":"object","additionalProperties":false,
      "required":["domestic_wash_dry","dimensional_change","colour_fastness","colour_fastness_role"],
      "properties":{
        "domestic_wash_dry":{"const":"ISO 6330:2021"},
        "dimensional_change":{"const":"ISO 5077:2007"},
        "colour_fastness":{"const":"ISO 105-C06:2010"},
        "colour_fastness_role":{"const":"colour_fastness_only_not_stain_removal_metric"}
      }
    },
    "validation_policy":{
      "type":"object","additionalProperties":false,
      "required":["independent_specimen_and_lot_holdout","random_measurement_split_allowed","repeated_specimen_is_independent_n","swatch_only_proves_garment_washability","repeat_cycles_required","blinded_assessment_required","pilot_variance_before_sample_size"],
      "properties":{
        "independent_specimen_and_lot_holdout":{"const":true},
        "random_measurement_split_allowed":{"const":false},
        "repeated_specimen_is_independent_n":{"const":false},
        "swatch_only_proves_garment_washability":{"const":false},
        "repeat_cycles_required":{"const":true},
        "blinded_assessment_required":{"const":true},
        "pilot_variance_before_sample_size":{"const":true}
      }
    },
    "safety_policy":{
      "type":"object","additionalProperties":false,
      "required":["closed_handling","open_powder_or_aerosol_allowed","characterized_supplier_preparations","enzyme_residual_assessment","auxiliary_chemistry_assessment","wastewater_assessment","live_microbe_appliance_production_allowed","occupational_exposure_assessment"],
      "properties":{
        "closed_handling":{"const":true},
        "open_powder_or_aerosol_allowed":{"const":false},
        "characterized_supplier_preparations":{"const":true},
        "enzyme_residual_assessment":{"const":true},
        "auxiliary_chemistry_assessment":{"const":true},
        "wastewater_assessment":{"const":true},
        "live_microbe_appliance_production_allowed":{"const":false},
        "occupational_exposure_assessment":{"const":true}
      }
    },
    "metrics":{"type":"array","minItems":12,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","track_id","unit","denominator","scope","target_hypothesis","status","hard_guardrails"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "track_id":{"enum":["wool_anti_felting_finishing","stain_specific_enzyme_care","shared"]},
        "unit":{"type":"string","minLength":1},
        "denominator":{"type":"string","minLength":3},
        "scope":{"type":"string","minLength":15},
        "target_hypothesis":{"type":"string","minLength":3},
        "status":{"const":"proposal_target_only"},
        "hard_guardrails":{"type":"array","minItems":1,"items":{"type":"string","minLength":4}}
      }
    }},
    "hard_gates":{"type":"array","minItems":10,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "governance":{
      "type":"object","additionalProperties":false,
      "required":["physical_observations","trained_models","formulations_qualified","product_claims","dry_clean_replacement_claim","symthaea_authority","physical_interlocks","claim_scope"],
      "properties":{
        "physical_observations":{"const":0},
        "trained_models":{"const":0},
        "formulations_qualified":{"const":0},
        "product_claims":{"const":false},
        "dry_clean_replacement_claim":{"const":false},
        "symthaea_authority":{"const":"advisory_only_no_actuation"},
        "physical_interlocks":{"const":"independent_deterministic_device_controls"},
        "claim_scope":{"const":"experiment_contract_only"}
      }
    },
    "sources":{"type":"array","minItems":7,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","uri","scope_note"],
      "properties":{
        "id":{"type":"string","minLength":3},
        "uri":{"type":"string","format":"uri","pattern":"^https://"},
        "scope_note":{"type":"string","minLength":15}
      }
    }}
  }
}