{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:luminous-dynamics:garment-ready-finishing:0.1.0",
  "title":"Garment Ready-State and Finishing Benchmark Contract v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","program_id","status","claim_ceiling","endpoint_classes","benchmark_suites","external_comparators","metrics","comparison_policy","standard_watch","hard_gates","governance","sources"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "program_id":{"const":"GARMENT-READY-001"},
    "status":{"const":"proposal_no_physical_measurements"},
    "claim_ceiling":{"const":"no_endpoint_robot_or_product_qualification_claim"},
    "endpoint_classes":{"type":"array","minItems":3,"maxItems":3,"uniqueItems":true,"items":{"enum":["ready_to_wear","ready_to_store","ready_to_iron"]}},
    "benchmark_suites":{"type":"array","minItems":2,"maxItems":2,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","cohort_scope","first_pass_success_target","stretch_success_target","first_pass_human_throughput_ratio","stretch_human_throughput_ratio","production_shift_hours","first_pass_table_ready_items_per_hour_target","stretch_table_ready_items_per_hour_target","first_pass_table_ready_items_per_shift_target","stretch_table_ready_items_per_shift_target","first_pass_destination_accuracy_target","stretch_destination_accuracy_target","end_to_end_destination_required","human_baseline_required"],
      "properties":{
        "id":{"enum":["standardized_commercial_textiles","diverse_household_garments"]},
        "cohort_scope":{"type":"string","minLength":20},
        "first_pass_success_target":{"type":"number","minimum":0.0,"maximum":1.0},
        "stretch_success_target":{"type":"number","minimum":0.0,"maximum":1.0},
        "first_pass_human_throughput_ratio":{"type":"number","minimum":0.0},
        "stretch_human_throughput_ratio":{"type":"number","minimum":0.0},
        "production_shift_hours":{"type":["number","null"],"minimum":0.0},
        "first_pass_table_ready_items_per_hour_target":{"type":["number","null"],"minimum":0.0},
        "stretch_table_ready_items_per_hour_target":{"type":["number","null"],"minimum":0.0},
        "first_pass_table_ready_items_per_shift_target":{"type":["number","null"],"minimum":0.0},
        "stretch_table_ready_items_per_shift_target":{"type":["number","null"],"minimum":0.0},
        "first_pass_destination_accuracy_target":{"type":"number","minimum":0.0,"maximum":1.0},
        "stretch_destination_accuracy_target":{"type":"number","minimum":0.0,"maximum":1.0},
        "end_to_end_destination_required":{"const":true},
        "human_baseline_required":{"const":true}
      }
    }},
    "external_comparators":{"type":"array","minItems":4,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","suite_id","evidence_class","reported_success_rate","reported_human_throughput_ratio","reported_items_per_hour","reported_accepted_items_per_shift","reported_shift_hours","reported_completion_scope","attempt_count","source_uri","scope_note","is_our_result"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "suite_id":{"enum":["standardized_commercial_textiles","diverse_household_garments"]},
        "evidence_class":{"enum":["external_analysis_of_company_report","vendor_published_evaluation","vendor_published_operational_report","external_demo_report"]},
        "reported_success_rate":{"type":"number","minimum":0.0,"maximum":1.0},
        "reported_human_throughput_ratio":{"type":["number","null"],"minimum":0.0},
        "reported_items_per_hour":{"type":["number","null"],"minimum":0.0},
        "reported_accepted_items_per_shift":{"type":["number","null"],"minimum":0.0},
        "reported_shift_hours":{"type":["number","null"],"minimum":0.0},
        "reported_completion_scope":{"enum":["fold_only","fold_and_quality_assessed","fold_and_bin_stack_placement","fold_and_destination_placement"]},
        "attempt_count":{"type":["integer","null"],"minimum":0},
        "source_uri":{"type":"string","format":"uri","pattern":"^https://"},
        "scope_note":{"type":"string","minLength":20},
        "is_our_result":{"const":false}
      }
    }},
    "metrics":{"type":"array","minItems":10,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","unit","denominator","scope","target_hypothesis","status","hard_guardrails"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "unit":{"type":"string","minLength":1},
        "denominator":{"enum":["per_accepted_garment","per_kg_accepted_dry_equivalent_textile","per_100_attempts","seconds_per_accepted_garment","per_18_hour_shift","accepted_items_per_hour"]},
        "scope":{"type":"string","minLength":15},
        "target_hypothesis":{"type":"string","minLength":3},
        "status":{"const":"proposal_target_only"},
        "hard_guardrails":{"type":"array","minItems":1,"items":{"type":"string","minLength":4}}
      }
    }},
    "comparison_policy":{"type":"object","additionalProperties":false,
      "required":["same_garment_cohort_required","same_task_definition_required","human_baseline_required_for_robot_speed_claim","failed_attempts_retained","vendor_claims_are_external_only","P50_P95_time_required","intervention_and_damage_accounting_required"],
      "properties":{
        "same_garment_cohort_required":{"const":true},
        "same_task_definition_required":{"const":true},
        "human_baseline_required_for_robot_speed_claim":{"const":true},
        "failed_attempts_retained":{"const":true},
        "vendor_claims_are_external_only":{"const":true},
        "P50_P95_time_required":{"const":true},
        "intervention_and_damage_accounting_required":{"const":true}
      }
    },
    "standard_watch":{"type":"object","additionalProperties":false,
      "required":["published_predecessor","current_reference","current_reference_status","published_standard"],
      "properties":{
        "published_predecessor":{"const":"ISO 15487:2018"},
        "current_reference":{"const":"ISO/DIS 15487:2026 Edition 4"},
        "current_reference_status":{"const":"draft_under_development"},
        "published_standard":{"const":false}
      }
    },
    "hard_gates":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "governance":{"type":"object","additionalProperties":false,
      "required":["physical_observations","product_claims","symthaea_authority","physical_interlocks","contract_receipt_scope"],
      "properties":{
        "physical_observations":{"const":0},
        "product_claims":{"const":false},
        "symthaea_authority":{"const":"advisory_only_no_actuation"},
        "physical_interlocks":{"const":"independent_deterministic_device_controls"},
        "contract_receipt_scope":{"const":"benchmark_contract_only"}
      }
    },
    "sources":{"type":"array","minItems":4,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","uri","scope_note"],
      "properties":{
        "id":{"type":"string","minLength":3},
        "uri":{"type":"string","format":"uri","pattern":"^https://"},
        "scope_note":{"type":"string","minLength":15}
      }
    }}
  }
}