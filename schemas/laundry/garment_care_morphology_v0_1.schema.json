{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:luminous-dynamics:garment-care-morphology:0.1.0",
  "title":"Garment-Care Platform Morphology Contract v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","program_id","status","claim_ceiling","candidates","hard_gates","governance","sources"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "program_id":{"const":"GARMENT-CARE-MORPH-001"},
    "status":{"const":"proposal_no_physical_measurements"},
    "claim_ceiling":{"const":"no_cleaning_superiority_or_product_qualification_claim"},
    "candidates":{"type":"array","minItems":8,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","deployment","route","maturity","scope","soil_removal_claim","dry_clean_claim","safety_boundary"],
      "properties":{
        "id":{"type":"string","minLength":5},
        "deployment":{"enum":["home","local_professional","central_specialist","industrial_service"]},
        "route":{"enum":["aqueous_wash","refresh_only","localized_spot","professional_wet_clean","professional_lco2","professional_solvent","intake_routing","textile_tunnel"]},
        "maturity":{"enum":["commercial_baseline","commercial_specialist","research_candidate","integration_concept"]},
        "scope":{"type":"string","minLength":20},
        "soil_removal_claim":{"type":"boolean"},
        "dry_clean_claim":{"type":"boolean"},
        "safety_boundary":{"type":"string","minLength":20}
      }
    }},
    "hard_gates":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":5}},
    "governance":{"type":"object","additionalProperties":false,
      "required":["physical_observations","product_claims","symthaea_authority","solvent_circuits_shared","lco2_household_authorized","pce_new_equipment_selected","unknown_material_action"],
      "properties":{
        "physical_observations":{"const":0},
        "product_claims":{"const":false},
        "symthaea_authority":{"const":"advisory_only_no_actuation"},
        "solvent_circuits_shared":{"const":false},
        "lco2_household_authorized":{"const":false},
        "pce_new_equipment_selected":{"const":false},
        "unknown_material_action":{"const":"abstain_or_human_review"}
      }
    },
    "sources":{"type":"array","minItems":7,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","uri","scope_note"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "uri":{"type":"string","format":"uri","pattern":"^https://"},
        "scope_note":{"type":"string","minLength":15}
      }
    }}
  }
}