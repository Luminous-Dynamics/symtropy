{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:luminous-dynamics:garment-material-passport:0.1.0",
  "title":"Garment Material Passport and NIR Benchmark Contract v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","program_id","status","claim_ceiling","datasets","external_reference_results","validation_policy","metrics","hard_gates","governance","scan_records","sources"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "program_id":{"const":"GARMENT-MATERIAL-PASSPORT-001"},
    "status":{"const":"benchmark_contract_proposal_no_physical_measurements"},
    "claim_ceiling":{"const":"no_model_or_process_qualification_claim"},
    "datasets":{"type":"array","minItems":3,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","version","kind","specimen_count","scope","source_uri","role","not_our_measurement"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "version":{"type":"string","minLength":1},
        "kind":{"enum":["nir_reference_dataset","nir_hyperspectral_reference_dataset","published_external_validation_cohort"]},
        "specimen_count":{"type":"integer","minimum":1},
        "spectrum_count":{"type":"integer","minimum":0},
        "annotated_spectrum_count":{"type":"integer","minimum":0},
        "scope":{"type":"string","minLength":20},
        "source_uri":{"type":"string","format":"uri","pattern":"^https://"},
        "role":{"enum":["development_and_instrument_validation","external_domain_challenge","published_result_comparator"]},
        "not_our_measurement":{"const":true}
      }
    }},
    "external_reference_results":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","dataset_id","metric_id","reported_result","unit","scope_note","is_our_result"],
      "properties":{
        "id":{"type":"string","minLength":3},
        "dataset_id":{"type":"string","minLength":3},
        "metric_id":{"type":"string","minLength":3},
        "reported_result":{"type":"string","minLength":3},
        "unit":{"type":"string","minLength":1},
        "scope_note":{"type":"string","minLength":20},
        "is_our_result":{"const":false}
      }
    }},
    "validation_policy":{"type":"object","additionalProperties":false,
      "required":["split_group_fields","random_spectral_pixel_split_allowed","source_lot_holdout_required","instrument_holdout_required","external_cohorts_separate","chemical_ground_truth_required_for_blend_claim"],
      "properties":{
        "split_group_fields":{"type":"array","minItems":3,"uniqueItems":true,"items":{"enum":["physical_specimen_id","garment_id","source_lot_id","acquisition_session_id"]}},
        "random_spectral_pixel_split_allowed":{"const":false},
        "source_lot_holdout_required":{"const":true},
        "instrument_holdout_required":{"const":true},
        "external_cohorts_separate":{"const":true},
        "chemical_ground_truth_required_for_blend_claim":{"const":true}
      }
    },
    "metrics":{"type":"array","minItems":8,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","unit","target_hypothesis","scope","status"],
      "properties":{
        "id":{"type":"string","minLength":4},
        "unit":{"type":"string","minLength":1},
        "target_hypothesis":{"type":"string","minLength":3},
        "scope":{"type":"string","minLength":15},
        "status":{"const":"proposal_target_only"}
      }
    }},
    "hard_gates":{"type":"array","minItems":8,"uniqueItems":true,"items":{"type":"string","minLength":4}},
    "governance":{"type":"object","additionalProperties":false,
      "required":["physical_scan_observations","trained_models","product_claims","care_route_authority","symthaea_authority","physical_interlocks"],
      "properties":{
        "physical_scan_observations":{"const":0},
        "trained_models":{"const":0},
        "product_claims":{"const":false},
        "care_route_authority":{"const":"advisory_material_estimate_human_gate"},
        "symthaea_authority":{"const":"advisory_only_no_actuation"},
        "physical_interlocks":{"const":"independent_deterministic_device_controls"}
      }
    },
    "scan_records":{"type":"array","maxItems":0},
    "sources":{"type":"array","minItems":5,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","uri","scope_note"],
      "properties":{
        "id":{"type":"string","minLength":3},
        "uri":{"type":"string","format":"uri","pattern":"^https://"},
        "scope_note":{"type":"string","minLength":15}
      }
    }}
  }
}