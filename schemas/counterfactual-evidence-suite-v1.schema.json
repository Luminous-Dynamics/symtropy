{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-counterfactual-evidence-suite-v1.schema.json",
  "title": "AV Counterfactual Evidence Robustness Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark_id", "schema_version", "baseline", "variants"],
  "properties": {
    "benchmark_id": {"const": "av-evidence-certificate-v0"},
    "schema_version": {"const": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workload", "truth", "submission"],
      "properties": {
        "workload": {"$ref": "workload-v1.schema.json"},
        "truth": {"$ref": "truth-v1.schema.json"},
        "submission": {"$ref": "submission-v1.schema.json"}
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id", "intervention", "claim_id",
          "removed_observation_ids", "workload", "submission"
        ],
        "properties": {
          "variant_id": {"type": "string", "minLength": 1},
          "intervention": {
            "enum": [
              "REMOVE_IRRELEVANT",
              "REMOVE_ALL_SUFFICIENT",
              "ADD_IRRELEVANT"
            ]
          },
          "claim_id": {"type": "string", "minLength": 1},
          "removed_observation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "workload": {"$ref": "workload-v1.schema.json"},
          "submission": {"$ref": "submission-v1.schema.json"}
        }
      }
    }
  }
}
