{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/plasma-food-trial-v0.1.schema.json",
  "title": "Plasma Food Trial Manifest V0.1",
  "description": "Evidence-aware metadata contract for a planned or executed plasma food-processing trial. A valid record does not establish food safety or efficacy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "status",
    "commodity",
    "process",
    "controls",
    "endpoints",
    "safety_review",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "trial_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "incomplete",
        "stopped",
        "not_comparable"
      ]
    },
    "commodity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "name",
        "lot_id",
        "initial_condition"
      ],
      "properties": {
        "category": {
          "enum": [
            "grain",
            "pulse",
            "produce",
            "meat",
            "dairy",
            "liquid",
            "packaged_food",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cultivar_or_variety": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplier_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "lot_id": {
          "type": "string",
          "minLength": 1
        },
        "mass_g": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "moisture_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "initial_condition": {
          "type": "string",
          "minLength": 1
        },
        "storage_history_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modality",
        "plasma_source",
        "stage",
        "planned"
      ],
      "properties": {
        "modality": {
          "enum": [
            "thermal_plasma",
            "cold_atmospheric_plasma",
            "low_pressure_cold_plasma",
            "plasma_activated_water",
            "plasma_activated_mist",
            "in_package_plasma",
            "other"
          ]
        },
        "plasma_source": {
          "enum": [
            "dielectric_barrier_discharge",
            "radio_frequency",
            "atmospheric_pressure_jet",
            "glow_discharge",
            "corona",
            "gliding_arc",
            "microwave",
            "other",
            "unknown"
          ]
        },
        "stage": {
          "enum": [
            "ingredient_pretreatment",
            "surface_treatment",
            "in_package_treatment",
            "wash_media_generation",
            "direct_thermal_cooking",
            "other"
          ]
        },
        "planned": {
          "type": "boolean"
        },
        "reactor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reactor_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "pressure_pa": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "feed_gas": {
          "type": [
            "string",
            "null"
          ]
        },
        "gas_purity_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "gas_flow_l_min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "relative_humidity_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "voltage_rms_v": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "current_a": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "wall_plug_energy_kwh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "absorbed_energy_kwh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "treatment_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "electrode_gap_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sample_distance_mm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sample_temperature_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "auxiliary_energy_kwh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "process_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "type",
          "description"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "untreated",
              "conventional_soak",
              "thermal_pretreatment",
              "commercial_reference",
              "water_only",
              "validated_wash",
              "uv_c",
              "pulsed_light",
              "hpp",
              "pef",
              "ultrasound",
              "other"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "matched_batch_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint_id",
          "domain",
          "measurand",
          "unit",
          "method_ref",
          "evidence_class"
        ],
        "properties": {
          "endpoint_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "time",
              "energy",
              "water",
              "mass_balance",
              "texture",
              "sensory",
              "nutrition",
              "oxidation",
              "microbiology",
              "package_integrity",
              "reactive_chemistry",
              "emissions",
              "cost",
              "other"
            ]
          },
          "measurand": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "method_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "instrument_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "calibration_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_class": {
            "enum": [
              "declared",
              "modelled",
              "simulated",
              "measured",
              "assayed",
              "attested"
            ]
          },
          "result": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "detection_limit": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "safety_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_status",
        "review_ref"
      ],
      "properties": {
        "review_status": {
          "enum": [
            "not_started",
            "in_review",
            "approved_for_lab_trial",
            "rejected",
            "not_applicable"
          ]
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "high_voltage_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "chemical_exposure_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "food_contact_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "microbiology_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "jurisdiction_review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "package": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "design_id",
        "revision",
        "material_ref",
        "seal_integrity_endpoint_ref"
      ],
      "properties": {
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "material_ref": {
          "type": "string",
          "minLength": 1
        },
        "seal_integrity_endpoint_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "headspace_composition": {
          "type": [
            "string",
            "null"
          ]
        },
        "migration_assay_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_revision",
        "source_manifest_digest",
        "raw_data_refs",
        "deviations"
      ],
      "properties": {
        "protocol_revision": {
          "type": "string",
          "minLength": 1
        },
        "source_manifest_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "raw_data_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_code_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim_boundary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
