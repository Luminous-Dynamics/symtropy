{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-forecast-verification-fixture-v0.1.schema.json",
  "title": "Synthetic landscape forecast verification fixture v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "data_origin",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "luminous.landscape_forecast_verification_fixture.v0.1"
    },
    "suite_id": {
      "const": "LANDSCAPE-FORECAST-VERIFICATION-V0.1"
    },
    "data_origin": {
      "const": "synthetic_fixture"
    },
    "claim_ceiling": {
      "const": "SYNTHETIC_CONTRACT_TEST_ONLY"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "metric_id",
        "unit",
        "spatial_scope",
        "temporal_stratum",
        "independent_unit_id",
        "evaluation_split",
        "prediction",
        "baseline",
        "reference"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/nonempty"
        },
        "metric_id": {
          "$ref": "#/$defs/nonempty"
        },
        "unit": {
          "$ref": "#/$defs/nonempty"
        },
        "spatial_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "temporal_stratum": {
          "$ref": "#/$defs/nonempty"
        },
        "prediction": {
          "$ref": "#/$defs/prediction"
        },
        "baseline": {
          "$ref": "#/$defs/baseline"
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "independent_unit_id": {
          "$ref": "#/$defs/nonempty"
        },
        "evaluation_split": {
          "enum": [
            "training",
            "calibration",
            "held_out"
          ]
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "mean",
        "interval_level",
        "lower",
        "upper",
        "scope_key"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/nonempty"
        },
        "mean": {
          "type": "number"
        },
        "interval_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "scope_key": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "mean"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/nonempty"
        },
        "mean": {
          "type": "number"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "uncertainty_abs",
        "method_id",
        "scope_key",
        "source_digest"
      ],
      "properties": {
        "status": {
          "enum": [
            "valid",
            "missing",
            "stale",
            "contradictory"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "uncertainty_abs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "method_id": {
          "$ref": "#/$defs/nonempty"
        },
        "scope_key": {
          "$ref": "#/$defs/nonempty"
        },
        "source_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
