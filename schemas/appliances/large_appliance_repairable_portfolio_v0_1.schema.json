{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:large-appliance-repairable-portfolio:0.1.0",
  "title": "Large Appliance Repairable Architecture Portfolio v0.1",
  "description": "Proposed architecture and benchmark profiles. Proposed values are not empirical performance, conformity or legal conclusions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_id",
    "status",
    "claim_ceiling",
    "selection_policy",
    "common_architecture_hypotheses",
    "benchmark_policy",
    "families",
    "references",
    "washer_architecture_variants",
    "washer_benchmark_protocol"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "portfolio_id": {
      "const": "LARGE-APPLIANCE-REPAIRABLE-001"
    },
    "status": {
      "const": "proposed_architecture_and_benchmark_profile"
    },
    "claim_ceiling": {
      "const": "no_physical_performance_or_conformity_claim"
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_large_appliance",
        "reason",
        "not_a_market_ranking"
      ],
      "properties": {
        "first_large_appliance": {
          "enum": [
            "washing_machine",
            "dishwasher",
            "refrigerator_freezer",
            "heat_pump_dryer",
            "heat_pump_water_heater",
            "heat_pump_hvac"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "not_a_market_ranking": {
          "const": true
        }
      }
    },
    "common_architecture_hypotheses": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "proposal",
          "success_condition",
          "failure_modes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{2,48}$"
          },
          "proposal": {
            "type": "string",
            "minLength": 15
          },
          "success_condition": {
            "type": "string",
            "minLength": 15
          },
          "failure_modes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          }
        }
      }
    },
    "benchmark_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controls_minimum",
        "freeze_before_test",
        "metrics",
        "proposed_targets",
        "no_claims"
      ],
      "properties": {
        "controls_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "freeze_before_test": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          }
        },
        "proposed_targets": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "target",
              "status",
              "guardrail"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "target": {
                "type": "string",
                "minLength": 10
              },
              "status": {
                "const": "proposal_not_result"
              },
              "guardrail": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        },
        "no_claims": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "priority",
          "why",
          "architecture_hypotheses",
          "user_maintenance_tasks",
          "qualified_service_tasks",
          "function_metrics",
          "hazards",
          "regulatory_references",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,50}$"
          },
          "name": {
            "type": "string",
            "minLength": 4
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "why": {
            "type": "string",
            "minLength": 15
          },
          "architecture_hypotheses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "user_maintenance_tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "qualified_service_tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "function_metrics": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "hazards": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "regulatory_references": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "status": {
            "const": "proposed_no_physical_validation"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "kind",
          "scope_note"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "enum": [
              "official_regulation",
              "official_guidance",
              "existing_standard_project",
              "internal_issue",
              "open_dataset"
            ]
          },
          "scope_note": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "washer_architecture_variants": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "hypothesis",
          "compare_against",
          "required_measurements",
          "failure_modes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^W[0-4]-[A-Z0-9-]{3,40}$"
          },
          "role": {
            "enum": [
              "control",
              "candidate",
              "orthogonal_trade"
            ]
          },
          "hypothesis": {
            "type": "string",
            "minLength": 20
          },
          "compare_against": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 4
            }
          },
          "required_measurements": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "failure_modes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "status": {
            "const": "proposed_no_measurements"
          }
        }
      }
    },
    "washer_benchmark_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "status",
        "claim_ceiling",
        "control_plan",
        "workload_plan",
        "instrumentation_plan",
        "metrics",
        "analysis_freeze",
        "service_trials",
        "evidence_rules"
      ],
      "properties": {
        "protocol_id": {
          "const": "WASHER-BENCHMARK-PROTOCOL-001"
        },
        "status": {
          "const": "draft_pending_control_selection"
        },
        "claim_ceiling": {
          "const": "no_measurements_no_comparison_claim"
        },
        "control_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum_units",
            "selection_state",
            "matching_fields",
            "documented_fields"
          ],
          "properties": {
            "minimum_units": {
              "type": "integer",
              "minimum": 3
            },
            "selection_state": {
              "const": "not_selected"
            },
            "matching_fields": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "documented_fields": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "workload_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "variables_to_freeze",
            "functional_outputs",
            "deviation_policy"
          ],
          "properties": {
            "status": {
              "const": "not_frozen"
            },
            "variables_to_freeze": {
              "type": "array",
              "minItems": 8,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "functional_outputs": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "deviation_policy": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "instrumentation_plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "required_channels",
            "calibration_policy",
            "raw_data_policy"
          ],
          "properties": {
            "status": {
              "const": "not_selected"
            },
            "required_channels": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "calibration_policy": {
              "type": "string",
              "minLength": 20
            },
            "raw_data_policy": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "dimension",
              "unit",
              "denominator",
              "method",
              "comparison_rule",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,63}$"
              },
              "dimension": {
                "enum": [
                  "functional_output",
                  "resource_use",
                  "serviceability",
                  "lifecycle_cost",
                  "reliability",
                  "sourcing",
                  "safety_gate"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 2
              },
              "denominator": {
                "type": "string",
                "minLength": 3
              },
              "method": {
                "type": "string",
                "minLength": 15
              },
              "comparison_rule": {
                "enum": [
                  "noninferiority_after_control_pilot",
                  "lower_is_better_after_control_pilot",
                  "higher_is_better_after_control_pilot",
                  "descriptive_separate_gate",
                  "not_comparable_until_defined"
                ]
              },
              "status": {
                "const": "method_to_be_frozen_before_candidate_measurements"
              }
            }
          }
        },
        "analysis_freeze": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage_a",
            "stage_b",
            "stage_c",
            "missing_data_policy",
            "no_post_hoc_rule"
          ],
          "properties": {
            "stage_a": {
              "const": "freeze_measurement_method_and_control_selection_before_any_measurements"
            },
            "stage_b": {
              "const": "control_only_pilot_establishes_repeatability_and_instrument_uncertainty"
            },
            "stage_c": {
              "const": "freeze_numeric_margins_exclusions_and_analysis_before_candidate_measurements"
            },
            "missing_data_policy": {
              "const": "unknown_not_zero"
            },
            "no_post_hoc_rule": {
              "type": "string",
              "minLength": 30
            }
          }
        },
        "service_trials": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "fault_tasks",
            "time_components",
            "outcome_fields",
            "role_boundary"
          ],
          "properties": {
            "status": {
              "const": "not_scheduled"
            },
            "fault_tasks": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "time_components": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "outcome_fields": {
              "type": "array",
              "minItems": 5,
              "items": {
                "type": "string",
                "minLength": 5
              }
            },
            "role_boundary": {
              "type": "string",
              "minLength": 30
            }
          }
        },
        "evidence_rules": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  }
}