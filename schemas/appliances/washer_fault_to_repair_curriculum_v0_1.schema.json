{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:washer-fault-to-repair-curriculum:0.1.0",
  "title": "Washer Fault-to-Repair Benchmark Curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_id",
    "status",
    "claim_ceiling",
    "selection_basis",
    "references",
    "tasks",
    "measurement_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "curriculum_id": {
      "const": "WASHER-FAULT-CURRICULUM-001"
    },
    "status": {
      "const": "benchmark_design_only"
    },
    "claim_ceiling": {
      "const": "no_local_prevalence_no_physical_repair_or_superiority_claim"
    },
    "selection_basis": {
      "const": "coverage_balanced_not_prevalence_weighted"
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "scope_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 10
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "scope_note": {
            "type": "string",
            "minLength": 30
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fault_family",
          "observed_symptom",
          "competing_hypotheses",
          "safe_discriminating_checks",
          "repair_scope_options",
          "service_tier",
          "hazard_boundary",
          "post_repair_verification",
          "recurrence_policy",
          "source_ids",
          "status"
        ],
        "properties": {
          "id": {
            "enum": [
              "WFT-01",
              "WFT-02",
              "WFT-03",
              "WFT-04",
              "WFT-05",
              "WFT-06",
              "WFT-07",
              "WFT-08"
            ]
          },
          "fault_family": {
            "type": "string",
            "minLength": 5
          },
          "observed_symptom": {
            "type": "string",
            "minLength": 10
          },
          "competing_hypotheses": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "safe_discriminating_checks": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "repair_scope_options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 10
            }
          },
          "service_tier": {
            "enum": [
              "U0",
              "P"
            ]
          },
          "hazard_boundary": {
            "type": "string",
            "minLength": 20
          },
          "post_repair_verification": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "recurrence_policy": {
            "type": "string",
            "minLength": 20
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9-]+$"
            }
          },
          "status": {
            "const": "curriculum_design_only"
          }
        }
      }
    },
    "measurement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_policy",
        "prevalence_policy",
        "unknown_policy",
        "safety_gate",
        "success_receipt_required"
      ],
      "properties": {
        "aggregate_policy": {
          "const": "per_class_plus_macro_average_no_easy_task_masking"
        },
        "prevalence_policy": {
          "const": "no_prevalence_weights_without_validated_target_market_denominator"
        },
        "unknown_policy": {
          "const": "unknown_not_zero"
        },
        "safety_gate": {
          "const": "non_compensatory"
        },
        "success_receipt_required": {
          "const": true
        }
      }
    }
  }
}
