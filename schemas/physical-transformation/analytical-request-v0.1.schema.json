{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/analytical-request-v0.1.schema.json",
  "title": "Physical Analytical Adapter Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","request_id","source_revision","scene_revision","scene_sha256","case_id","requested_physics","units","parameters"],
  "properties": {
    "schema_version": {"const":"physical-analytical-request-v0.1"},
    "request_id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9_.:-]+$"},
    "source_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "scene_revision": {"type":"integer","minimum":0},
    "scene_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "case_id": {"enum":["axial_bar","cantilever_tip_load","simply_supported_uniform_load","phase_field_fracture","dynamic_response","rigid_contact"]},
    "requested_physics": {"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["topology","static_linear_elastic","dynamic_response","nonlinear_material","fracture","rigid_contact","granular_contact","thermal_coupling"]}},
    "units": {
      "type":"object","additionalProperties":false,
      "required":["length","area","force","youngs_modulus","second_moment_area","outer_fiber_distance","distributed_load"],
      "properties":{"length":{"const":"m"},"area":{"const":"m^2"},"force":{"const":"N"},"youngs_modulus":{"const":"Pa"},"second_moment_area":{"const":"m^4"},"outer_fiber_distance":{"const":"m"},"distributed_load":{"const":"N/m"}}
    },
    "parameters": {"type":"object"}
  },
  "allOf":[
    {"if":{"properties":{"case_id":{"const":"axial_bar"}},"required":["case_id"]},"then":{"properties":{"parameters":{"type":"object","additionalProperties":false,"required":["force_n","length_m","area_m2","youngs_modulus_pa"],"properties":{"force_n":{"type":"number"},"length_m":{"type":"number","exclusiveMinimum":0},"area_m2":{"type":"number","exclusiveMinimum":0},"youngs_modulus_pa":{"type":"number","exclusiveMinimum":0}}}}}},
    {"if":{"properties":{"case_id":{"const":"cantilever_tip_load"}},"required":["case_id"]},"then":{"properties":{"parameters":{"type":"object","additionalProperties":false,"required":["force_n","length_m","youngs_modulus_pa","second_moment_area_m4","outer_fiber_distance_m"],"properties":{"force_n":{"type":"number"},"length_m":{"type":"number","exclusiveMinimum":0},"youngs_modulus_pa":{"type":"number","exclusiveMinimum":0},"second_moment_area_m4":{"type":"number","exclusiveMinimum":0},"outer_fiber_distance_m":{"type":"number","exclusiveMinimum":0}}}}}},
    {"if":{"properties":{"case_id":{"const":"simply_supported_uniform_load"}},"required":["case_id"]},"then":{"properties":{"parameters":{"type":"object","additionalProperties":false,"required":["load_n_per_m","length_m","youngs_modulus_pa","second_moment_area_m4","outer_fiber_distance_m"],"properties":{"load_n_per_m":{"type":"number"},"length_m":{"type":"number","exclusiveMinimum":0},"youngs_modulus_pa":{"type":"number","exclusiveMinimum":0},"second_moment_area_m4":{"type":"number","exclusiveMinimum":0},"outer_fiber_distance_m":{"type":"number","exclusiveMinimum":0}}}}}}
  ]
}