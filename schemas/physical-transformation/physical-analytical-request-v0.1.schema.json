{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/physical-analytical-request-v0.1.schema.json",
  "title": "Physical Analytical Reference Request v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "source_revision",
    "case_id",
    "assumption_profile",
    "requested_physics",
    "units",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "physical-analytical-request-v0.1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "case_id": {
      "enum": [
        "axial_bar",
        "cantilever_tip_load",
        "simply_supported_uniform_load",
        "planar_truss_two_bar"
      ]
    },
    "assumption_profile": {
      "enum": [
        "uniform_linear_elastic_axial_bar",
        "small_deflection_euler_bernoulli_cantilever_tip_load",
        "small_deflection_euler_bernoulli_simply_supported_uniform_load",
        "small_displacement_linear_elastic_asymmetric_two_bar_planar_truss"
      ]
    },
    "requested_physics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "static_linear_elastic",
          "dynamic_response",
          "fracture",
          "rigid_contact",
          "granular_contact",
          "thermal_coupling"
        ]
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "force",
        "area",
        "stress",
        "second_moment",
        "distributed_load"
      ],
      "properties": {
        "length": {
          "const": "m"
        },
        "force": {
          "const": "N"
        },
        "area": {
          "const": "m^2"
        },
        "stress": {
          "const": "Pa"
        },
        "second_moment": {
          "const": "m^4"
        },
        "distributed_load": {
          "const": "N/m"
        }
      }
    },
    "inputs": {
      "type": "object"
    },
    "input_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "inputs"
      ],
      "properties": {
        "schema_version": {
          "const": "physical-input-bounds-v0.1"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/inputBound"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "case_id": {
              "const": "axial_bar"
            },
            "assumption_profile": {
              "const": "uniform_linear_elastic_axial_bar"
