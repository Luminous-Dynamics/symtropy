                }
              }
            },
            "input_bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "inputs"
              ],
              "properties": {
                "schema_version": {
                  "const": "physical-input-bounds-v0.1"
                },
                "inputs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "span_m",
                    "apex_x_m",
                    "apex_height_m",
                    "axial_rigidity_a_n",
                    "axial_rigidity_b_n",
                    "force_x_n",
                    "force_y_n"
                  ],
                  "properties": {
                    "span_m": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "m"
                        }
                      },
                      "allOf": [
                        {
                          "properties": {
                            "lower": {
                              "exclusiveMinimum": 0
                            }
                          }
                        }
                      ]
                    },
                    "apex_x_m": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "m"
                        }
                      }
                    },
                    "apex_height_m": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "m"
                        }
                      },
                      "allOf": [
                        {
                          "properties": {
                            "lower": {
                              "exclusiveMinimum": 0
                            }
                          }
                        }
                      ]
                    },
                    "force_x_n": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "N"
                        }
                      }
                    },
                    "force_y_n": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "N"
                        }
                      }
                    },
                    "axial_rigidity_a_n": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "N"
                        }
                      },
