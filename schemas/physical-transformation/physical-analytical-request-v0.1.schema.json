            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "force_n",
                "length_m",
                "area_m2",
                "youngs_modulus_pa"
              ],
              "properties": {
                "force_n": {
                  "type": "number"
                },
                "length_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "area_m2": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "youngs_modulus_pa": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "input_bounds": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "inputs"
              ],
              "properties": {
                "schema_version": {
