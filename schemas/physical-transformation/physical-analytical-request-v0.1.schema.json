              "const": "planar_truss_two_bar"
            },
            "assumption_profile": {
              "const": "small_displacement_linear_elastic_asymmetric_two_bar_planar_truss"
            },
            "inputs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "span_m",
