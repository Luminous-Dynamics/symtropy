                },
                "second_moment_area_m4": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "outer_fiber_distance_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "input_bounds": {
              "type": "object",
