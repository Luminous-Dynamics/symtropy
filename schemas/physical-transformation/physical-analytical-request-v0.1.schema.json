                },
                "inputs": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "load_n_per_m",
                    "length_m",
                    "youngs_modulus_pa",
                    "second_moment_area_m4",
                    "outer_fiber_distance_m"
                  ],
                  "properties": {
