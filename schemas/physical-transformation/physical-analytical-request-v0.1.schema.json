                },
                "apex_x_m": {
                  "type": "number"
                },
                "apex_height_m": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "force_x_n": {
                  "type": "number"
                },
                "force_y_n": {
                  "type": "number"
                },
                "axial_rigidity_a_n": {
