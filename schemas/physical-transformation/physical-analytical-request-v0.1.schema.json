                    "force_n",
                    "length_m",
                    "youngs_modulus_pa",
                    "second_moment_area_m4",
                    "outer_fiber_distance_m"
                  ],
                  "properties": {
                    "force_n": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "N"
                        }
                      }
                    },
                    "length_m": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "m"
                        }
                      }
                    },
                    "youngs_modulus_pa": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "Pa"
                        }
                      }
                    },
