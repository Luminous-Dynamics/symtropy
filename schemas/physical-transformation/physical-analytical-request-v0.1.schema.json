                        {
                          "properties": {
                            "lower": {
                              "exclusiveMinimum": 0
                            }
                          }
                        }
                      ]
                    },
                    "axial_rigidity_b_n": {
                      "$ref": "#/$defs/inputBound",
                      "properties": {
                        "unit": {
                          "const": "N"
                        }
                      },
                      "allOf": [
                        {
                          "properties": {
                            "lower": {
                              "exclusiveMinimum": 0
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "inputBound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "unit",
        "basis",
        "source_ref"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "N",
            "N/m",
            "m",
            "m^2",
            "Pa",
            "m^4"
          ]
        },
        "basis": {
          "enum": [
            "instrumented_measurement",
            "datasheet_tolerance",
            "engineering_estimate",
            "scenario_bound"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "calibration_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "instrumented_measurement"
              }
            },
            "required": [
              "basis"
            ]
          },
          "then": {
            "required": [
              "calibration_ref"
            ]
          }
        }
      ]
    }
  }
}
