{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/analytical-receipt-v0.1.schema.json",
  "title": "Physical Analytical Adapter Receipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_validation","request_id","request_sha256","source_revision","scene_revision","scene_sha256","adapter_revision","case_id","requested_physics","physics_omitted","computation_status","analytical_model_executed","outputs","output_units","assumptions","diagnostics","claim_ceiling"],
  "properties":{
    "schema_version":{"const":"physical-analytical-receipt-v0.1"},
    "request_validation":{"const":"PASS"},
    "request_id":{"type":"string"},
    "request_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "scene_revision":{"type":"integer","minimum":0},
    "scene_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "adapter_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "case_id":{"type":"string"},
    "requested_physics":{"type":"array","items":{"type":"string"}},
    "physics_omitted":{"type":"array","items":{"type":"string"}},
    "computation_status":{"enum":["COMPUTED","UNRESOLVED"]},
    "analytical_model_executed":{"type":"boolean"},
    "outputs":{"type":["object","null"]},
    "output_units":{"type":"object"},
    "assumptions":{"type":"array","items":{"type":"string"}},
    "diagnostics":{"type":"array","minItems":1,"items":{"type":"string"}},
    "claim_ceiling":{"type":"string","minLength":1}
  }
}