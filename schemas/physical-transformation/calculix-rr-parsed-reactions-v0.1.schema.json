{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/calculix-rr-parsed-reactions-v0.1.schema.json",
  "title": "CalculiX Reaction-Only RR Parsed Output v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parse_status",
    "source_semantics",
    "deck_sha256",
    "dat_sha256",
    "node_set",
    "time_value_as_written",
    "time_value",
    "expected_node_ids",
    "nodes",
    "unit_status",
    "coordinate_frame_status",
    "physical_result_qualified",
    "real_world_validation_status",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": { "const": "calculix-rr-parsed-reactions-v0.1" },
    "parse_status": { "const": "PASS" },
    "source_semantics": { "const": "reaction_only_RR" },
    "deck_sha256": { "$ref": "#/$defs/sha256" },
    "dat_sha256": { "$ref": "#/$defs/sha256" },
    "node_set": { "$ref": "#/$defs/token" },
    "time_value_as_written": { "type": "string", "minLength": 1, "maxLength": 64 },
    "time_value": { "type": "number" },
    "expected_node_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "force_components_as_written",
          "source_line",
          "raw_line"
        ],
        "properties": {
          "node_id": { "type": "integer", "minimum": 0 },
          "force_components_as_written": { "$ref": "#/$defs/vector3" },
          "source_line": { "type": "integer", "minimum": 1 },
          "raw_line": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "unit_status": { "const": "NOT_ENCODED_IN_CCX_OUTPUT" },
    "coordinate_frame_status": { "const": "NOT_INFERRED_BY_PARSER" },
    "physical_result_qualified": { "const": false },
    "real_world_validation_status": { "const": "UNRESOLVED" },
    "claim_ceiling": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}