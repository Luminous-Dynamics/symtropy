{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/benchmark-manifest-v0.1.schema.json",
  "title": "Physical Solver Benchmark Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_date",
    "claim_policy",
    "catalogs",
    "benchmarks"
  ],
  "properties": {
    "schema_version": {
      "const": "physical-benchmark-manifest-v0.1"
    },
    "manifest_date": {
      "type": "string",
      "format": "date"
    },
    "claim_policy": {
      "type": "string",
      "minLength": 1
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalog"
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/benchmark"
      }
    }
  },
  "$defs": {
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_id",
        "publisher",
        "catalog_version",
        "source_url",
        "catalog_scope"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "catalog_version": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "catalog_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_ref",
        "source_digest_sha256",
        "oracle_ref",
        "tolerance",
        "exact_head_test_ref"
      ],
      "properties": {
        "fixture_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "oracle_ref": {
          "type": "string",
          "minLength": 1
        },
        "tolerance": {
          "type": "string",
          "minLength": 1
        },
        "exact_head_test_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "catalog_id",
        "external_id",
        "title",
        "source_url",
        "analysis_class",
        "physics",
        "source_access",
        "status",
        "related_local_cases",
        "equivalence_claim",
        "missing_prerequisites",
        "notes"
      ],
      "properties": {
        "benchmark_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "catalog_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "analysis_class": {
          "type": "string",
          "minLength": 1
        },
        "physics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_access": {
          "enum": [
            "catalog_public_input_or_license_status_to_verify",
            "catalog_and_input_files_listed_redistribution_terms_to_verify",
            "metadata_only_no_fixture_claimed"
          ]
        },
        "status": {
          "enum": [
            "catalogued",
            "inputs_unavailable",
            "fixture_incomplete",
            "implemented_unverified",
            "equation_verified",
            "numerically_verified",
            "experimentally_validated"
          ]
        },
        "related_local_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "equivalence_claim": {
          "const": "none_unverified"
        },
        "missing_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/verificationEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "equation_verified",
                  "numerically_verified",
                  "experimentally_validated"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        }
      ]
    }
  }
}
