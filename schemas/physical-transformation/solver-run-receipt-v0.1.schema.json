{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/solver-run-receipt-v0.1.schema.json",
  "title": "External Solver Run Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "manifest_sha256",
    "reference_source_revision",
    "input_fixture_sha256",
    "solver",
    "runner",
    "refinement_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "solver-run-receipt-v0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 3
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "input_fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version_pin",
        "binary_sha256",
        "configuration_sha256"
      ],
      "properties": {
        "name": {
          "enum": [
            "code_aster",
            "opensees",
            "calculix",
            "moose",
            "other"
          ]
        },
        "version_pin": {
          "type": "string",
          "minLength": 1
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_head_sha",
        "workflow_run_id",
        "runner_image",
        "execution_log_sha256"
      ],
      "properties": {
        "workflow_head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_run_id": {
          "type": "string",
          "minLength": 1
        },
        "runner_image": {
          "type": "string",
          "minLength": 1
        },
        "execution_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "refinement_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refinement_level",
          "element_count",
          "exit_code",
          "convergence_status",
          "outputs",
          "output_units",
          "output_semantics",
          "result_file_sha256"
        ],
        "properties": {
          "refinement_level": {
            "type": "integer",
            "minimum": 1
          },
          "element_count": {
            "type": "integer",
            "minimum": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "convergence_status": {
            "enum": [
              "converged",
              "not_converged",
              "unknown"
            ]
          },
          "outputs": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          },
          "output_units": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_semantics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "result_file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
