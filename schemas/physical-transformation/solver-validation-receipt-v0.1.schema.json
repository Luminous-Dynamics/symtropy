{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/solver-validation-receipt-v0.1.schema.json",
  "title": "Physical Solver Request Validation Receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_validation", "request_id", "request_sha256", "source_revision", "scene_sha256", "validator_revision", "model_fidelity", "requested_physics", "physics_omitted", "capability_status", "solver_invoked", "physical_result_status", "required_outputs", "diagnostics", "claim_ceiling"],
  "properties": {
    "schema_version": {"const": "physical-solver-validation-receipt-v0.1"},
    "request_validation": {"const": "PASS"},
    "request_id": {"type": "string"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scene_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validator_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "model_fidelity": {"enum": ["graph_topology", "analytical_linear_elastic", "continuum_linear_elastic", "continuum_nonlinear", "phase_field_fracture", "rigid_contact", "granular_dem"]},
    "requested_physics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "physics_omitted": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "capability_status": {"enum": ["WITHIN_REFERENCE_REQUEST_ENVELOPE", "UNRESOLVED"]},
    "solver_invoked": {"const": false},
    "physical_result_status": {"const": "UNRESOLVED"},
    "required_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "diagnostics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  }
}