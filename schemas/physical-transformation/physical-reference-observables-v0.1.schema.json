{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/physical-reference-observables-v0.1.schema.json",
  "title": "Physical Reference Observables v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reference_id", "case_id", "request_id", "scene_sha256", "scene_revision", "request_sha256", "comparison_protocol_id", "oracle", "observables"],
  "properties": {
    "schema_version": { "const": "physical-reference-observables-v0.1" },
    "reference_id": { "$ref": "#/$defs/token" },
    "case_id": { "$ref": "#/$defs/token" },
    "request_id": { "$ref": "#/$defs/token" },
    "scene_sha256": { "$ref": "#/$defs/sha256" },
    "scene_revision": { "type": "integer", "minimum": 0 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "comparison_protocol_id": { "$ref": "#/$defs/token" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "identity", "source_ref"],
      "properties": {
        "method": { "enum": ["analytical_exact", "independent_numerical"] },
        "identity": { "type": "string", "minLength": 1, "maxLength": 512 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "observables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observable_id", "expected_value", "unit", "absolute_tolerance", "relative_tolerance"],
        "properties": {
          "observable_id": { "$ref": "#/$defs/token" },
          "expected_value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "absolute_tolerance": { "type": "number", "minimum": 0 },
          "relative_tolerance": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
