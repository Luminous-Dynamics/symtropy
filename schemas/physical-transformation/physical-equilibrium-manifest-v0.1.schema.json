{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/physical-equilibrium-manifest-v0.1.schema.json",
  "title": "Physical Equilibrium Audit Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "audit_id", "case_id", "request_id", "request_sha256",
    "scene_sha256", "scene_revision", "coordinate_frame_id", "origin_m", "units",
    "reference", "applied_loads", "required_reaction_force_ids",
    "required_reaction_moment_ids", "tolerances"
  ],
  "properties": {
    "schema_version": { "const": "physical-equilibrium-manifest-v0.1" },
    "audit_id": { "$ref": "#/$defs/id" },
    "case_id": { "$ref": "#/$defs/id" },
    "request_id": { "$ref": "#/$defs/id" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "scene_sha256": { "$ref": "#/$defs/sha256" },
    "scene_revision": { "type": "integer", "minimum": 0 },
    "coordinate_frame_id": { "$ref": "#/$defs/id" },
    "origin_m": { "$ref": "#/$defs/vector3" },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "force", "moment"],
      "properties": {
        "length": { "const": "m" },
        "force": { "const": "N" },
        "moment": { "const": "N*m" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "identity", "source_ref"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 256 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "applied_loads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["load_id", "target_id", "force_n", "position_m", "couple_nm"],
        "properties": {
          "load_id": { "$ref": "#/$defs/id" },
          "target_id": { "$ref": "#/$defs/id" },
          "force_n": { "$ref": "#/$defs/vector3" },
          "position_m": { "$ref": "#/$defs/vector3" },
          "couple_nm": { "$ref": "#/$defs/vector3" }
        }
      }
    },
    "required_reaction_force_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
    },
    "required_reaction_moment_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["force_absolute_n", "force_relative", "moment_absolute_nm", "moment_relative"],
      "properties": {
        "force_absolute_n": { "type": "number", "minimum": 0 },
        "force_relative": { "type": "number", "minimum": 0 },
        "moment_absolute_nm": { "type": "number", "minimum": 0 },
        "moment_relative": { "type": "number", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}