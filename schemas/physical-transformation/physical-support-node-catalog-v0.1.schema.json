{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/physical-support-node-catalog-v0.1.schema.json",
  "title": "Physical Support Node Catalogue v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "request_id", "request_sha256",
    "scene_sha256", "scene_revision", "coordinate_frame_id", "deck_sha256",
    "units", "nodes", "provenance"
  ],
  "properties": {
    "schema_version": { "const": "physical-support-node-catalog-v0.1" },
    "case_id": { "$ref": "#/$defs/token" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "scene_sha256": { "$ref": "#/$defs/sha256" },
    "scene_revision": { "type": "integer", "minimum": 0 },
    "coordinate_frame_id": { "$ref": "#/$defs/token" },
    "deck_sha256": { "$ref": "#/$defs/sha256" },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length"],
      "properties": { "length": { "const": "m" } }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "position_m"],
        "properties": {
          "node_id": { "type": "integer", "minimum": 0 },
          "position_m": { "$ref": "#/$defs/vector3" }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vector3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "identity", "source_ref"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  }
}