{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/physical-transformation/calculix-rf-restricted-proof-manifest-v0.1.schema.json",
  "title": "CalculiX Restricted RF Equivalence Proof Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "request_id", "request_sha256", "scene_sha256",
    "scene_revision", "coordinate_frame_id", "node_set", "deck_sha256",
    "node_catalog_sha256", "support_node_map", "load_node_map", "units", "provenance"
  ],
  "properties": {
    "schema_version": { "const": "calculix-rf-restricted-proof-manifest-v0.1" },
    "case_id": { "$ref": "#/$defs/token" },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "scene_sha256": { "$ref": "#/$defs/sha256" },
    "scene_revision": { "type": "integer", "minimum": 0 },
    "coordinate_frame_id": { "$ref": "#/$defs/token" },
    "node_set": { "$ref": "#/$defs/token" },
    "deck_sha256": { "$ref": "#/$defs/sha256" },
    "node_catalog_sha256": { "$ref": "#/$defs/sha256" },
    "support_node_map": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nodeMap" }
    },
    "load_node_map": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nodeMap" }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "force"],
      "properties": { "length": { "const": "m" }, "force": { "const": "N" } }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "identity", "source_ref"],
      "properties": {
        "method": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "identity": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "source_ref": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nodeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "node_id"],
      "properties": {
        "target_id": { "$ref": "#/$defs/token" },
        "node_id": { "type": "integer", "minimum": 1 }
      }
    }
  }
}