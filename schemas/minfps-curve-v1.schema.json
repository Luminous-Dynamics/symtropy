{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/av-minfps-curve-v1.schema.json",
  "title": "AV Minimum-FPS Sweep Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id", "schema_version", "protocol_id", "episode_id",
    "source_cluster_id", "policy_id", "model_digest_sha256",
    "runtime_digest_sha256", "sampler_id", "sampler_digest_sha256",
    "sampling_design", "fps_grid", "media_duration_ms",
    "sampling_tolerance_ms", "minimum_success_fraction",
    "minimum_seed_count", "seeds"
  ],
  "properties": {
    "benchmark_id": {"const": "av-minfps-curve-v0"},
    "schema_version": {"const": 1},
    "protocol_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "source_cluster_id": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "model_digest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "runtime_digest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "sampler_id": {"type": "string", "minLength": 1},
    "sampler_digest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "sampling_design": {"enum": ["NESTED_FIXED_RATE", "INDEPENDENT_FIXED_RATE"]},
    "fps_grid": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "media_duration_ms": {"type": "number", "exclusiveMinimum": 0},
    "sampling_tolerance_ms": {"type": "number", "exclusiveMinimum": 0},
    "minimum_success_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "minimum_seed_count": {"type": "integer", "minimum": 1},
    "seeds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seed_id", "runs"],
        "properties": {
          "seed_id": {"type": "string", "minLength": 1},
          "runs": {
            "type": "array",
            "minItems": 2,
            "items": {"$ref": "#/$defs/rateRun"}
          }
        }
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "timestamp_ms"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1},
        "timestamp_ms": {"type": "number", "minimum": 0}
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frames_delivered", "video_bytes", "audio_samples", "audio_bytes",
        "input_tokens", "output_tokens", "model_calls", "wall_time_ms",
        "peak_ram_mb", "peak_vram_mb", "energy_millijoules",
        "energy_provenance", "energy_method", "energy_evidence_digest_sha256"
      ],
      "properties": {
        "frames_delivered": {"type": "integer", "minimum": 0},
        "video_bytes": {"type": ["integer", "null"], "minimum": 0},
        "audio_samples": {"type": ["integer", "null"], "minimum": 0},
        "audio_bytes": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "model_calls": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"type": ["integer", "null"], "minimum": 0},
        "peak_ram_mb": {"type": ["integer", "null"], "minimum": 0},
        "peak_vram_mb": {"type": ["integer", "null"], "minimum": 0},
        "energy_millijoules": {"type": ["number", "null"], "minimum": 0},
        "energy_provenance": {"enum": ["MEASURED", "ESTIMATED", "SYNTHETIC", "NOT_MEASURED"]},
        "energy_method": {"type": ["string", "null"]},
        "energy_evidence_digest_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "rateRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps", "run_status", "frame_manifest", "frame_manifest_sha256",
        "grounded_success", "answer_correct", "evidence_sufficient",
        "decision_on_time", "certificate_scorecard_sha256", "resource"
      ],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "run_status": {"enum": ["COMPLETED", "TIMEOUT", "FAILED", "MALFORMED"]},
        "frame_manifest": {"type": "array", "items": {"$ref": "#/$defs/frame"}},
        "frame_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "grounded_success": {"type": ["boolean", "null"]},
        "answer_correct": {"type": ["boolean", "null"]},
        "evidence_sufficient": {"type": ["boolean", "null"]},
        "decision_on_time": {"type": ["boolean", "null"]},
        "certificate_scorecard_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "resource": {"$ref": "#/$defs/resource"}
      }
    }
  }
}
