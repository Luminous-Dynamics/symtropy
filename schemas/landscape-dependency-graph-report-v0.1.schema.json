{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/landscape-dependency-graph-report-v0.1.schema.json",
  "title": "Landscape dependency graph report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "conformance_status",
    "data_origin",
    "claim_ceiling",
    "graph_id",
    "input_sha256",
    "dependency_semantics_sha256",
    "node_count",
    "dependency_count",
    "scenario_count",
    "service_count",
    "cross_layer_dependency_count",
    "baseline_supported_service_count",
    "single_failure_audit",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "symtropy.landscape_dependency_graph_report.v0.1"
    },
    "suite_id": {
      "const": "LANDSCAPE-SETS-DEPENDENCY-GRAPH-V0.1"
    },
    "conformance_status": {
      "const": "PASS_SYNTHETIC_DEPENDENCY_CONFORMANCE_ONLY"
    },
    "data_origin": {
      "const": "synthetic_fixture"
    },
    "claim_ceiling": {
      "const": "STRUCTURAL_DEPENDENCY_ANALYSIS_ONLY"
    },
    "graph_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_semantics_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "dependency_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 500
    },
    "scenario_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "service_count": {
      "type": "integer",
      "minimum": 1
    },
    "cross_layer_dependency_count": {
      "type": "integer",
      "minimum": 0
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "label",
          "injected_failure_count",
          "service_count",
          "supported_service_count",
          "unsupported_service_count",
          "service_availability_fraction",
          "cascade_amplification",
          "unsupported_service_ids",
          "node_assessments"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "injected_failure_count": {
            "type": "integer",
            "minimum": 0
          },
          "service_count": {
            "type": "integer",
            "minimum": 1
          },
          "supported_service_count": {
            "type": "integer",
            "minimum": 0
          },
          "unsupported_service_count": {
            "type": "integer",
            "minimum": 0
          },
          "service_availability_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cascade_amplification": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "unsupported_service_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "node_assessments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node_id",
                "layer",
                "is_service",
                "operational",
                "self_failed",
                "unsatisfied_groups"
              ],
              "properties": {
                "node_id": {
                  "type": "string"
                },
                "layer": {
                  "enum": [
                    "social",
                    "ecological",
                    "technical"
                  ]
                },
                "is_service": {
                  "type": "boolean"
                },
                "operational": {
                  "type": "boolean"
                },
                "self_failed": {
                  "type": "boolean"
                },
                "unsatisfied_groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "requirement_group_id",
                      "provider_alternatives"
                    ],
                    "properties": {
                      "requirement_group_id": {
                        "type": "string"
                      },
                      "provider_alternatives": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "edge_id",
                            "provider_node_id",
                            "status"
                          ],
                          "properties": {
                            "edge_id": {
                              "type": "string"
                            },
                            "provider_node_id": {
                              "type": "string"
                            },
                            "status": {
                              "enum": [
                                "operational",
                                "node_failed",
                                "edge_disabled",
                                "dependency_unavailable"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "baseline_supported_service_count": {
      "type": "integer",
      "minimum": 0
    },
    "single_failure_audit": {
      "type": "array",
      "minItems": 1,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_kind",
          "target_id",
          "baseline_supported_service_count",
          "supported_service_count",
          "lost_service_count",
          "relative_service_loss_fraction",
          "lost_service_ids"
        ],
        "properties": {
          "failure_kind": {
            "enum": [
              "node",
              "edge"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "baseline_supported_service_count": {
            "type": "integer",
            "minimum": 0
          },
          "supported_service_count": {
            "type": "integer",
            "minimum": 0
          },
          "lost_service_count": {
            "type": "integer",
            "minimum": 0
          },
          "relative_service_loss_fraction": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "lost_service_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
