{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cfi-space/evaluator-ledger-v0.2.schema.json",
  "title": "CFI-Space Evaluator Ledger v0.2",
  "description": "Evaluator-side truth including label-audited ground-truth pose. Never mount this file in the candidate process.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "episodes"],
  "properties": {
    "schema_version": {"const": 2},
    "benchmark_id": {"type":"string","minLength":1},
    "episodes": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/record"}}
  },
  "$defs": {
    "split":{"enum":["development","calibration","confirmatory","blind_holdout"]},
    "variant":{"enum":["clean","single_fault","interaction"]},
    "disposition":{"enum":["qualified","abstain","out_of_scope","disagreement","dependence_unknown","missing_evidence"]},
    "fault_family":{"enum":["rgb_local","event_local","timing","extrinsics","common_cause","translation","dynamics","observability","integrity"]},
    "generalization":{"enum":["seen_target","unseen_target","unseen_target_family","unseen_renderer","unseen_sensor_rig"]},
    "unit":{
      "type":"object","additionalProperties":false,
      "required":["target_id","session_id","trajectory_id","sensor_rig_id"],
      "properties":{
        "target_id":{"type":"string","minLength":1},"session_id":{"type":"string","minLength":1},
        "trajectory_id":{"type":"string","minLength":1},"sensor_rig_id":{"type":"string","minLength":1}
      }
    },
    "pose_truth":{
      "type":"object","additionalProperties":false,
      "required":["coordinate_frame","transform_direction","translation_m","orientation_xyzw","annotation_sha256","label_audit_sha256"],
      "properties":{
        "coordinate_frame":{"type":"string","minLength":1},
        "transform_direction":{"type":"string","minLength":1},
        "translation_m":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"minItems":3,"maxItems":3},
        "orientation_xyzw":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}],"minItems":4,"maxItems":4},
        "annotation_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "label_audit_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "record":{
      "type":"object","additionalProperties":false,
      "required":["episode_id","parent_episode_id","counterfactual_group_id","variant_kind","split","independent_unit","fault_ids","fault_families","critical","expected_disposition","generalization","ground_truth_pose"],
      "properties":{
        "episode_id":{"type":"string","minLength":1},"parent_episode_id":{"type":"string","minLength":1},
        "counterfactual_group_id":{"type":"string","minLength":1},"variant_kind":{"$ref":"#/$defs/variant"},
        "split":{"$ref":"#/$defs/split"},"independent_unit":{"$ref":"#/$defs/unit"},
        "fault_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "fault_families":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/fault_family"}},
        "critical":{"type":"boolean"},"expected_disposition":{"$ref":"#/$defs/disposition"},
        "generalization":{"$ref":"#/$defs/generalization"},"ground_truth_pose":{"$ref":"#/$defs/pose_truth"}
      }
    }
  }
}
