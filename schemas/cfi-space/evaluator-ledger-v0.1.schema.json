{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cfi-space/evaluator-ledger-v0.1.schema.json",
  "title": "CFI-Space Evaluator Ledger v0.1",
  "description": "Evaluator-side truth ledger. Never mount this file in the candidate process.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "split": {
      "enum": [
        "development",
        "calibration",
        "confirmatory",
        "blind_holdout"
      ]
    },
    "variant": {
      "enum": [
        "clean",
        "single_fault",
        "interaction"
      ]
    },
    "disposition": {
      "enum": [
        "qualified",
        "abstain",
        "out_of_scope",
        "disagreement",
        "dependence_unknown",
        "missing_evidence"
      ]
    },
    "fault_family": {
      "enum": [
        "rgb_local",
        "event_local",
        "timing",
        "extrinsics",
        "common_cause",
        "translation",
        "dynamics",
        "observability",
        "integrity"
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "session_id",
        "trajectory_id",
        "sensor_rig_id"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "trajectory_id": {
          "type": "string",
          "minLength": 1
        },
        "sensor_rig_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "parent_episode_id",
        "counterfactual_group_id",
        "variant_kind",
        "split",
        "independent_unit",
        "fault_ids",
        "fault_families",
        "critical",
        "expected_disposition",
        "generalization"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_episode_id": {
          "type": "string",
          "minLength": 1
        },
        "counterfactual_group_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_kind": {
          "$ref": "#/$defs/variant"
        },
        "split": {
          "$ref": "#/$defs/split"
        },
        "independent_unit": {
          "$ref": "#/$defs/unit"
        },
        "fault_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fault_families": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fault_family"
          }
        },
        "critical": {
          "type": "boolean"
        },
        "expected_disposition": {
          "$ref": "#/$defs/disposition"
        },
        "generalization": {
          "$ref": "#/$defs/generalization"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "variant_kind": {
                "const": "clean"
              }
            },
            "required": [
              "variant_kind"
            ]
          },
          "then": {
            "properties": {
              "fault_ids": {
                "maxItems": 0
              },
              "fault_families": {
                "maxItems": 0
              },
              "expected_disposition": {
                "const": "qualified"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variant_kind": {
                "const": "single_fault"
              }
            },
            "required": [
              "variant_kind"
            ]
          },
          "then": {
            "properties": {
              "fault_ids": {
                "minItems": 1,
                "maxItems": 1
              },
              "fault_families": {
                "minItems": 1,
                "maxItems": 1
              },
              "expected_disposition": {
                "not": {
                  "const": "qualified"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "variant_kind": {
                "const": "interaction"
              }
            },
            "required": [
              "variant_kind"
            ]
          },
          "then": {
            "properties": {
              "fault_ids": {
                "minItems": 2
              },
              "fault_families": {
                "minItems": 1
              },
              "expected_disposition": {
                "not": {
                  "const": "qualified"
                }
              }
            }
          }
        }
      ]
    },
    "generalization": {
      "enum": [
        "seen_target",
        "unseen_target",
        "unseen_target_family",
        "unseen_renderer",
        "unseen_sensor_rig"
      ]
    }
  }
}
