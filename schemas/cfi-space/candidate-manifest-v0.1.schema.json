{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/cfi-space/candidate-manifest-v0.1.schema.json",
  "title": "CFI-Space Candidate Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "episodes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/episode"
      }
    }
  },
  "$defs": {
    "modality": {
      "enum": [
        "rgb",
        "event",
        "depth",
        "infrared",
        "lidar"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_id",
        "sequence",
        "timestamp_us",
        "modalities"
      ],
      "properties": {
        "frame_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_us": {
          "type": "integer",
          "minimum": 0
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modality"
          }
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "input_bundle_sha256",
        "frame_budget",
        "expected_frame_count",
        "first_sequence",
        "horizon_us",
        "frames",
        "input_bundle_path"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "input_bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frame_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "expected_frame_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "first_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "horizon_us": {
          "type": "integer",
          "minimum": 1
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/frame"
          }
        },
        "input_bundle_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_./-]+$"
        }
      }
    }
  }
}
