{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/schemas/manufacturing/machine_capability_case_v0_1.schema.json",
  "title": "Machine Capability Compiler Case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario_id",
    "description",
    "part",
    "routes",
    "expected"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,80}$"
    },
    "description": {
      "type": "string",
      "minLength": 8
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "revision",
        "risk_class",
        "allowed_tiers",
        "rights_status",
        "revision_status",
        "process_family",
        "required_inspection",
        "post_repair_verification_required",
        "required_max_temperature_c",
        "deadline_hours"
      ],
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "risk_class": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "allowed_tiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "H0",
              "N1",
              "R2",
              "Q3",
              "OEM"
            ]
          }
        },
        "rights_status": {
          "enum": [
            "verified",
            "unknown",
            "revoked",
            "not_permitted"
          ]
        },
        "revision_status": {
          "enum": [
            "exact",
            "unknown",
            "mismatch"
          ]
        },
        "process_family": {
          "type": "string",
          "minLength": 1
        },
        "required_inspection": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "post_repair_verification_required": {
          "type": "boolean"
        },
        "required_max_temperature_c": {
          "type": "number",
          "minimum": -273.15
        },
        "deadline_hours": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "tier",
          "machine_id",
          "process_family",
          "machine_identity_status",
          "machine_safety_status",
          "material_status",
          "calibration_status",
          "operator_status",
          "inspection_status",
          "post_repair_status",
          "machine_envelope_status",
          "capacity_units",
          "lead_time_hours",
          "dependencies",
          "cost",
          "max_process_temperature_c",
          "inspection_methods",
          "support_status"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "H0",
              "N1",
              "R2",
              "Q3",
              "OEM"
            ]
          },
          "machine_id": {
            "type": "string",
            "minLength": 1
          },
          "process_family": {
            "type": "string",
            "minLength": 1
          },
          "machine_identity_status": {
            "enum": [
              "verified",
              "unknown",
              "revoked"
            ]
          },
          "machine_safety_status": {
            "enum": [
              "qualified",
              "unknown",
              "unqualified"
            ]
          },
          "material_status": {
            "enum": [
              "approved",
              "unknown",
              "prohibited"
            ]
          },
          "calibration_status": {
            "enum": [
              "current",
              "unknown",
              "expired"
            ]
          },
          "operator_status": {
            "enum": [
              "qualified",
              "unknown",
              "unqualified"
            ]
          },
          "inspection_status": {
            "enum": [
              "qualified",
              "unknown",
              "missing"
            ]
          },
          "post_repair_status": {
            "enum": [
              "complete",
              "unknown",
              "missing",
              "not_required"
            ]
          },
          "machine_envelope_status": {
            "enum": [
              "within",
              "unknown",
              "outside"
            ]
          },
          "capacity_units": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "required",
              "available",
              "unit"
            ],
            "properties": {
              "required": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "available": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "lead_time_hours": {
            "type": "number",
            "minimum": 0
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dependency_id",
                "criticality",
                "sourcing_class",
                "alternate_sources",
                "local_repair_status",
                "evidence_status",
                "requires"
              ],
              "properties": {
                "dependency_id": {
                  "type": "string",
                  "minLength": 1
                },
                "criticality": {
                  "enum": [
                    "critical",
                    "important",
                    "noncritical"
                  ]
                },
                "sourcing_class": {
                  "enum": [
                    "locally_manufactured",
                    "local_service_imported_inputs",
                    "imported_stocked",
                    "imported_long_lead",
                    "unknown"
                  ]
                },
                "alternate_sources": {
                  "type": "integer",
                  "minimum": 0
                },
                "local_repair_status": {
                  "enum": [
                    "repairable",
                    "not_repairable",
                    "unknown"
                  ]
                },
                "evidence_status": {
                  "enum": [
                    "measured",
                    "independently_verified",
                    "vendor_declared",
                    "assumed",
                    "synthetic",
                    "unknown",
                    "revoked"
                  ]
                },
                "requires": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capital_allocation_zar",
              "material_zar",
              "energy_zar",
              "labour_zar",
              "setup_zar",
              "calibration_zar",
              "inspection_zar",
              "finishing_zar",
              "transport_zar",
              "maintenance_zar",
              "failure_rework_zar",
              "warranty_reserve_zar",
              "accepted_outputs"
            ],
            "properties": {
              "capital_allocation_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "material_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "energy_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "labour_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "setup_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "calibration_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "inspection_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "finishing_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "transport_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "maintenance_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "failure_rework_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "warranty_reserve_zar": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "accepted_outputs": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "max_process_temperature_c": {
            "type": "number",
            "minimum": -273.15
          },
          "inspection_methods": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "support_status": {
            "enum": [
              "supported",
              "unknown",
              "unsupported"
            ]
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "feasible_route_ids",
        "route_results",
        "local_closure_disposition"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "feasible",
            "infeasible",
            "unknown",
            "unsupported"
          ]
        },
        "feasible_route_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "route_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route_id",
              "disposition",
              "blockers"
            ],
            "properties": {
              "route_id": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "feasible",
                  "infeasible",
                  "unknown",
                  "unsupported"
                ]
              },
              "blockers": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "local_closure_disposition": {
          "enum": [
            "locally_reproducible",
            "local_service_only",
            "import_dependent",
            "unknown"
          ]
        }
      }
    }
  }
}
