{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mfg-policy-v0.2-execution-ledger",
  "title": "Manufacturing Policy v0.2 Event-Sourced Execution Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "benchmark_id", "case_id", "evidence_class", "steps", "claim_ceiling"],
  "properties": {
    "schema_id": {"const": "https://luminousdynamics.io/schemas/mfg-policy-v0.2-execution-ledger"},
    "benchmark_id": {"const": "MFG-POLICY-V02-CHALLENGE-001"},
    "case_id": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "synthetic_execution_trace"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epoch", "decision_frame", "transitions"],
        "properties": {
          "epoch": {"type": "integer", "minimum": 0, "maximum": 3},
          "decision_frame": {"type": "object"},
          "transitions": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "claim_ceiling": {"const": "Synthetic event-sourced state replay only; no physical execution, source authentication, accepted production output or schedule optimality claim."}
  }
}