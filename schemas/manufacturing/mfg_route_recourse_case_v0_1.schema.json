{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mfg-route-recourse-case-v0.1",
  "title": "MFG-ROUTE-RECOURSE-001 scenario corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "benchmark_id",
    "evidence_class",
    "family_manifest",
    "case_count",
    "cases",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "https://luminousdynamics.io/schemas/mfg-route-recourse-case-v0.1"
    },
    "benchmark_id": {
      "const": "MFG-ROUTE-RECOURSE-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "family_manifest": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_family_id",
          "case_count",
          "replication_seeds"
        ],
        "properties": {
          "scenario_family_id": {
            "type": "string",
            "minLength": 1
          },
          "case_count": {
            "const": 20
          },
          "replication_seeds": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      }
    },
    "case_count": {
      "const": 120
    },
    "cases": {
      "type": "array",
      "minItems": 120,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scenario_family_id",
          "seed",
          "routes",
          "jobs",
          "decision_points"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_family_id": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "routes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "route_id",
                "owner_disposition",
                "blockers",
                "common_cause_domains",
                "capacity_units",
                "cost_per_unit",
                "lead_time_hours"
              ],
              "properties": {
                "route_id": {
                  "type": "string",
                  "minLength": 1
                },
                "owner_disposition": {
                  "const": "feasible"
                },
                "blockers": {
                  "type": "array",
                  "maxItems": 0
                },
                "common_cause_domains": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "capacity_units": {
                  "type": "integer",
                  "minimum": 0
                },
                "cost_per_unit": {
                  "type": "integer",
                  "minimum": 1
                },
                "lead_time_hours": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "jobs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "job_id",
                "quantity_units",
                "max_lead_time_hours",
                "max_total_cost_units"
              ],
              "properties": {
                "job_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity_units": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_lead_time_hours": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_total_cost_units": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "decision_points": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision_id",
                "decision_hour",
                "observations",
                "hidden_future"
              ],
              "properties": {
                "decision_id": {
                  "type": "string",
                  "minLength": 1
                },
                "decision_hour": {
                  "type": "integer",
                  "minimum": 0
                },
                "observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "observed_hour",
                      "sequence",
                      "event_type",
                      "target_id"
                    ],
                    "properties": {
                      "observed_hour": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "sequence": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "event_type": {
                        "enum": [
                          "route_failed",
                          "common_cause_failed",
                          "capacity_reduced",
                          "route_evidence_unknown",
                          "calibration_stale",
                          "material_incompatible",
                          "execution_outcome_unknown",
                          "execution_reconciled_failure",
                          "execution_reconciled_accepted"
                        ]
                      },
                      "target_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "related_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "value_units": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      }
                    }
                  }
                },
                "hidden_future": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event_type",
                      "target_id",
                      "occurs_at_hour"
                    ],
                    "properties": {
                      "event_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "occurs_at_hour": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
