{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/manufacturing/mfg_accepted_output_scorecard_known_answers_v0_1.schema.json",
  "title": "Manufacturing accepted-output resilience scorecard known answers v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "benchmark_id", "evidence_class", "answer_count", "answers", "claim_ceiling"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "mfg-accepted-output-scorecard-known-answers-v0.1"},
    "benchmark_id": {"const": "MFG-ACCEPTED-OUTPUT-SCORECARD-001"},
    "evidence_class": {"const": "synthetic_offline"},
    "answer_count": {"type": "integer", "minimum": 1},
    "answers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/answer"}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nullableInteger": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "produced_units", "independently_accepted_units", "independently_rejected_units", "unresolved_units", "unqualified_acceptance_claim_units", "time_to_first_accepted_output_ms", "time_to_recovery_target_ms", "accepted_demand_fill_ppm", "accepted_quality_yield_ppm"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "produced_units": {"type": "integer", "minimum": 0},
        "independently_accepted_units": {"type": "integer", "minimum": 0},
        "independently_rejected_units": {"type": "integer", "minimum": 0},
        "unresolved_units": {"type": "integer", "minimum": 0},
        "unqualified_acceptance_claim_units": {"type": "integer", "minimum": 0},
        "time_to_first_accepted_output_ms": {"$ref": "#/$defs/nullableInteger"},
        "time_to_recovery_target_ms": {"$ref": "#/$defs/nullableInteger"},
        "accepted_demand_fill_ppm": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "accepted_quality_yield_ppm": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000}, {"type": "null"}]}
      }
    }
  }
}
