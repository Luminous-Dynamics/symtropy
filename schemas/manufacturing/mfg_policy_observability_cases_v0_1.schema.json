{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mfg-policy-observability-cases-v0.1.schema.json",
  "title": "Manufacturing Policy Observability Timeline Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "benchmark_id",
    "evidence_class",
    "case_count",
    "cases",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "https://luminousdynamics.io/schemas/mfg-policy-observability-cases-v0.1"
    },
    "benchmark_id": {
      "const": "MFG-POLICY-OBSERVABILITY-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "case_count": {
      "const": 20
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scenario_family_id",
          "events",
          "decision_cuts"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_family_id": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "source_id",
                "source_owner",
                "sequence",
                "subject_id",
                "event_type",
                "effective_min_ms",
                "effective_max_ms",
                "observed_at_ms",
                "disposition",
                "supersedes_event_id",
                "evidence_sha256"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_owner": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 0
                },
                "subject_id": {
                  "type": "string",
                  "minLength": 1
                },
                "event_type": {
                  "type": "string",
                  "minLength": 1
                },
                "effective_min_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "effective_max_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "observed_at_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "disposition": {
                  "enum": [
                    "ADMITTED",
                    "RECONCILED",
                    "UNKNOWN",
                    "CONFLICTED"
                  ]
                },
                "supersedes_event_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "decision_cuts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision_cut_id",
                "cutoff_ms"
              ],
              "properties": {
                "decision_cut_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cutoff_ms": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
