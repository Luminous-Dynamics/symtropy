{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mfg-policy-observability-answers-v0.1.schema.json",
  "title": "Manufacturing Policy Observability Known Projections v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "benchmark_id",
    "evidence_class",
    "answer_count",
    "answers",
    "claim_ceiling"
  ],
  "properties": {
    "schema_id": {
      "const": "https://luminousdynamics.io/schemas/mfg-policy-observability-answers-v0.1"
    },
    "benchmark_id": {
      "const": "MFG-POLICY-OBSERVABILITY-001"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "answer_count": {
      "const": 20
    },
    "answers": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "projections"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "projections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "decision_cut_id",
                "cutoff_ms",
                "visible_event_ids",
                "active_event_ids",
                "unresolved_event_ids",
                "superseded_event_ids"
              ],
              "properties": {
                "decision_cut_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cutoff_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "visible_event_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "active_event_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "unresolved_event_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "superseded_event_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  }
}
