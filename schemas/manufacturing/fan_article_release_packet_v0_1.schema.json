              },
              "decision_ref": {
                "$ref": "#/$defs/evidence_ref"
              },
              "recorded_at": {
                "$ref": "#/$defs/nonempty_string"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "INCOMPLETE"
          }
        }
      },
      "then": {
