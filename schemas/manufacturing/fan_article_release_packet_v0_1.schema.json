        },
        "disposition_reason": {
          "$ref": "#/$defs/nullable_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "BLOCKED",
                  "NOT_APPLICABLE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "disposition_reason": {
                "$ref": "#/$defs/nonempty_string"
              },
              "reviewer_id": {
