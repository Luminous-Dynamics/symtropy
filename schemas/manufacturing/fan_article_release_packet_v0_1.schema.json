                "const": "NOT_REVIEWED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OWNER_REVIEWED"
          }
        }
      },
      "then": {
        "properties": {
          "owner_disposition": {
