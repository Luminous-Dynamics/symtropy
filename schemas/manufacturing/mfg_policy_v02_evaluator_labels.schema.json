{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/mfg-policy-v0.2-evaluator-labels",
  "title": "Manufacturing Policy v0.2 Evaluator-Only Labels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "benchmark_id", "evidence_class", "case_count", "cases", "claim_ceiling"],
  "properties": {
    "schema_id": {"const": "https://luminousdynamics.io/schemas/mfg-policy-v0.2-evaluator-labels"},
    "benchmark_id": {"const": "MFG-POLICY-V02-CHALLENGE-001"},
    "evidence_class": {"const": "synthetic_evaluator_only"},
    "case_count": {"const": 120},
    "cases": {"type": "array", "minItems": 120, "maxItems": 120, "items": {"$ref": "#/$defs/case"}},
    "claim_ceiling": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "disposition": {"type": "string", "enum": ["ACCEPTED", "REJECTED", "INDETERMINATE"]},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome_id", "operation_id", "disposition"],
      "properties": {
        "outcome_id": {"type": "string", "minLength": 1},
        "operation_id": {"type": "string", "minLength": 1},
        "disposition": {"$ref": "#/$defs/disposition"}
      }
    },
    "scenarioOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "hidden_terminal_quality_outcomes"],
      "properties": {
        "scenario_id": {"type": "string", "minLength": 1},
        "hidden_terminal_quality_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outcome"}}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "scenario_family_id", "scenario_outcomes"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "scenario_family_id": {"type": "string", "minLength": 1},
        "scenario_outcomes": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/scenarioOutcome"}}
      }
    }
  }
}