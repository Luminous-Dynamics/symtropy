{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital/coalition-consequence-corpus-v0.1.json",
  "title":"Finite joint-scenario coalition consequence corpus",
  "type":"object","additionalProperties":false,
  "required":["schema","evidence_class","claim_ceiling","cases"],
  "properties":{
    "schema":{"const":"luminous.orbital-coalition-consequence-binding.corpus.v0.1"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"synthetic-finite-joint-scenario-coalition-binding-only"},
    "cases":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/case"}}
  },
  "$defs":{"case":{
    "type":"object",
    "required":["case_id","scope_sha256","loss_unit","resource_capacity","candidate_actions","coalitions","incumbent_bridge_case","loss_model_universe_case","loss_model_universe_checker_commit","nominal_distribution","expected"],
    "properties":{
      "case_id":{"type":"string","minLength":1},
      "scope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
      "loss_unit":{"type":"string","minLength":1},
      "resource_capacity":{"type":"integer","minimum":0,"maximum":9007199254740991},
      "candidate_actions":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","required":["action_id","resource_cost","actionable","coordination_required"],"properties":{"action_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"resource_cost":{"type":"integer","minimum":0},"actionable":{"type":"boolean"},"coordination_required":{"type":"boolean"}}}},
      "coalitions":{"type":"array","minItems":1,"items":{"type":"object"}},
      "incumbent_bridge_case":{"type":"object"},
      "loss_model_universe_case":{"type":"object"},
      "loss_model_universe_checker_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
      "nominal_distribution":{"type":["object","null"]},
      "expected":{"type":"object"}
    }
  }}
}