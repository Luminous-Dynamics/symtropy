{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital assurance dependency invalidation corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-assurance-invalidation.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-dependency-invalidation-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "expected_content_sha256",
        "expected_scope_sha256"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "expected_content_sha256": {
          "$ref": "#/$defs/sha"
        },
        "expected_scope_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_type",
        "content_sha256",
        "current_content_sha256",
        "scope_sha256",
        "current_scope_sha256",
        "dependencies"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "node_type": {
          "$ref": "#/$defs/id"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha"
        },
        "current_content_sha256": {
          "$ref": "#/$defs/sha"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "current_scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "required_root_node_ids",
        "nodes",
        "expected_disposition",
        "expected_invalidated_node_ids"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "required_root_node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "expected_disposition": {
          "enum": [
            "CURRENT",
            "REQUALIFICATION_REQUIRED",
            "INVALID_GRAPH"
          ]
        },
        "expected_invalidated_node_ids": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  }
}
