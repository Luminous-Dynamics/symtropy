{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-assurance-bundle-corpus-v0.1.json",
  "title": "Orbital assurance bundle corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-assurance-bundle.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-assurance-graph-structure-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "configuration_id",
        "operating_mode_id",
        "mission_profile_id",
        "environment_profile_id",
        "valid_from",
        "valid_until"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "operating_mode_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "valid_from": {
          "type": "integer"
        },
        "valid_until": {
          "type": "integer"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "source_repo",
        "source_path",
        "source_commit",
        "receipt_schema",
        "receipt_sha256",
        "evidence_class",
        "recorded_at",
        "effective_from",
        "effective_until"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "source_repo": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "receipt_schema": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "software",
            "bench",
            "physical",
            "authority"
          ]
        },
        "recorded_at": {
          "type": "integer"
        },
        "effective_from": {
          "type": "integer"
        },
        "effective_until": {
          "type": "integer"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "source_repo",
        "source_path",
        "source_commit",
        "receipt_schema",
        "receipt_sha256"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "source_repo": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "receipt_schema": {
          "type": "string",
          "minLength": 1
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "state",
        "scope",
        "estimand",
        "unit",
        "model_profile",
        "validation_domain",
        "mandatory",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_type": {
          "enum": [
            "orbital_review_bundle",
            "lifecycle_qualification",
            "test_matrix_adequacy",
            "event_history_integrity",
            "mission_success_probability",
            "constant_failure_intensity",
            "physical_test_observation",
            "measurement_calibration",
            "model_credibility",
            "evidence_custody",
            "external_authority_decision",
            "defeater",
            "power_law_recurrent_intensity",
            "weibull_first_failure_life"
          ]
        },
        "state": {
          "enum": [
            "supported",
            "contradicted",
            "indeterminate",
            "stale",
            "withdrawn",
            "unsupported",
            "open_defeater"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "estimand": {
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_claim_id",
        "to_claim_id",
        "relation"
      ],
      "properties": {
        "from_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "to_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "supports",
            "derived_from",
            "contradicts",
            "supersedes"
          ]
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "blocker_count",
        "authority_granted"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "review_bundle_complete",
            "incomplete_argument",
            "blocked_by_open_defeater",
            "blocked_by_unsupported_or_stale_evidence",
            "blocked_by_scope_mismatch",
            "blocked_by_claim_type_mismatch",
            "blocked_by_missing_authority",
            "contradicted",
            "indeterminate",
            "invalid_graph"
          ]
        },
        "blocker_count": {
          "type": "integer",
          "minimum": 0
        },
        "authority_granted": {
          "const": false
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "root_claim_id",
        "scope",
        "effective_cutoff",
        "knowledge_cutoff",
        "required_claim_types",
        "receipt_pins",
        "claims",
        "edges",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "root_claim_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "effective_cutoff": {
          "type": "integer"
        },
        "knowledge_cutoff": {
          "type": "integer"
        },
        "required_claim_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim/properties/claim_type"
          }
        },
        "receipt_pins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
