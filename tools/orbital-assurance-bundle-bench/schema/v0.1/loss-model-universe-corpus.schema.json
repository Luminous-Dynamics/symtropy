{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital loss-model universe adequacy corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-loss-model-universe-adequacy.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-loss-model-universe-adequacy-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "profile_tags",
        "scope_sha256"
      ],
      "properties": {
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "profile_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "family",
        "version",
        "scope_sha256",
        "source_receipt_id",
        "state"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "CURRENT",
            "STALE",
            "OUT_OF_PROFILE",
            "INDETERMINATE"
          ]
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "model_id",
        "declared_applicable",
        "exclusion_reason",
        "evidence_receipt_id"
      ],
      "properties": {
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        },
        "declared_applicable": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "jointPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "world_id",
        "model_id"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "model_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "missing_model_ids",
        "missing_pair_ids",
        "unexpected_model_ids",
        "unexpected_pair_ids"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "LOSS_MODEL_UNIVERSE_CLOSED_WITHIN_DECLARED_GRAMMAR",
            "COMMON_MODE_MODEL_OMISSION",
            "MISSING_LOSS_MODEL",
            "MISSING_WORLD_MODEL_PAIR",
            "UNWITNESSED_MODEL_EXCLUSION",
            "MODEL_FAMILY_INADEQUATE",
            "MODEL_STALE",
            "MODEL_OUT_OF_PROFILE",
            "MODEL_SOURCE_UNAVAILABLE",
            "MODEL_SCOPE_MISMATCH",
            "MODEL_RECEIPT_ALIAS",
            "UNEXPECTED_MODEL",
            "UNEXPECTED_WORLD_MODEL_PAIR",
            "INVALID_CASE",
            "MODEL_FAMILY_MISMATCH"
          ]
        },
        "missing_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "missing_pair_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unexpected_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "unexpected_pair_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "mission_class",
        "scope_sha256",
        "worlds",
        "producer_models",
        "declared_model_ids",
        "applicability",
        "joint_pairs",
        "expected"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "mission_class": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "worlds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/world"
          }
        },
        "producer_models": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/model"
          }
        },
        "declared_model_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "applicability": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/applicability"
          }
        },
        "joint_pairs": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/jointPair"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
