{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probability-qualified CVaR regret corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "alphas",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-cvar-regret.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "probability-conditioned-synthetic-tail-risk-algebra-only"
    },
    "alphas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "numerator",
          "denominator"
        ],
        "properties": {
          "numerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "denominator": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "scope_id",
          "scope_sha256",
          "decision_cutoff_id",
          "world_set_receipt_id",
          "joint_loss_receipt_id",
          "joint_scenario_manifest_sha256",
          "expected_scenario_ids",
          "expected_scenario_ids_sha256",
          "joint_scenarios",
          "probability_model",
          "policies"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "scope_id": {
            "type": "string",
            "minLength": 1
          },
          "scope_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "decision_cutoff_id": {
            "type": "string",
            "minLength": 1
          },
          "world_set_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "joint_loss_receipt_id": {
            "type": "string",
            "minLength": 1
          },
          "joint_scenario_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_scenario_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16384,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "expected_scenario_ids_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "joint_scenarios": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16384,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario_id",
                "world_id",
                "loss_model_id"
              ],
              "properties": {
                "scenario_id": {
                  "type": "string",
                  "minLength": 1
                },
                "world_id": {
                  "type": "string",
                  "minLength": 1
                },
                "loss_model_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "probability_model": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "receipt_schema",
                  "claim_ceiling",
                  "source_commit",
                  "probability_model_id",
                  "receipt_id",
                  "receipt_sha256",
                  "source_case_id",
                  "scope_id",
                  "scope_sha256",
                  "decision_cutoff_id",
                  "world_set_receipt_id",
                  "joint_loss_receipt_id",
                  "joint_scenario_manifest_sha256",
                  "expected_scenario_ids_sha256",
                  "calibration_receipt_id",
                  "calibration_receipt_sha256",
                  "validation_split_id",
                  "validation_split_sha256",
                  "probability_payload_sha256",
                  "state",
                  "calibration_state",
                  "coverage_state",
                  "model_family_state",
                  "assumptions",
                  "result",
                  "weights"
                ],
                "properties": {
                  "receipt_schema": {
                    "const": "luminous.orbital-probability-model.receipt.v0.1"
                  },
                  "claim_ceiling": {
                    "const": "explicit-joint-probability-model-receipt-only"
                  },
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "probability_model_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "receipt_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "receipt_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "source_case_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "decision_cutoff_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "world_set_receipt_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "joint_loss_receipt_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "joint_scenario_manifest_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "expected_scenario_ids_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "calibration_receipt_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calibration_receipt_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "validation_split_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "validation_split_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "probability_payload_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "state": {
                    "enum": [
                      "CURRENT",
                      "STALE",
                      "REVOKED",
                      "CONTRADICTED",
                      "INDETERMINATE"
                    ]
                  },
                  "calibration_state": {
                    "enum": [
                      "QUALIFIED",
                      "UNQUALIFIED",
                      "INDETERMINATE",
                      "STALE"
                    ]
                  },
                  "coverage_state": {
                    "enum": [
                      "ADEQUATE",
                      "INADEQUATE",
                      "INDETERMINATE"
                    ]
                  },
                  "model_family_state": {
                    "enum": [
                      "ADEQUATE",
                      "INADEQUATE",
                      "INDETERMINATE"
                    ]
                  },
                  "assumptions": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sampling_design",
                      "dependence_model"
                    ],
                    "properties": {
                      "sampling_design": {
                        "const": "EXPLICIT_JOINT_DISTRIBUTION"
                      },
                      "dependence_model": {
                        "const": "JOINT_SCENARIO_WEIGHTS"
                      }
                    }
                  },
                  "result": {
                    "enum": [
                      "pass",
                      "fail"
                    ]
                  },
                  "weights": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16384,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "scenario_id",
                        "weight"
                      ],
                      "properties": {
                        "scenario_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "weight": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "numerator",
                            "denominator"
                          ],
                          "properties": {
                            "numerator": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 1000000000000
                            },
                            "denominator": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 1000000000000
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "policies": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "policy_id",
                "per_scenario"
              ],
              "properties": {
                "policy_id": {
                  "type": "string",
                  "minLength": 1
                },
                "per_scenario": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16384,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "scenario_id",
                      "wait_and_see_regret",
                      "outcome_class_regret"
                    ],
                    "properties": {
                      "scenario_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "wait_and_see_regret": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000000000
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000000
                          }
                        }
                      },
                      "outcome_class_regret": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 1000000000000
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000000000
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
