                              },
                              "denominator": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 1000000000000
                              }
                            }
                          },
                          "tail_mass": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "numerator",
                              "denominator"
                            ],
                            "properties": {
                              "numerator": {
                                "type": "integer",
                                "minimum": 0,
