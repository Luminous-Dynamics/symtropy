                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "numerator",
                        "denominator"
                      ],
                      "properties": {
                        "numerator": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000000
