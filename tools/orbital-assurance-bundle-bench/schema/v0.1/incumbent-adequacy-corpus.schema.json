{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital finite-world incumbent adequacy corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-incumbent-adequacy.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-finite-world-incumbent-adequacy-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worldLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "source_numerator",
        "source_denominator",
        "loss"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "loss": {
          "type": "integer",
          "minimum": 0
        },
        "source_numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "world_id",
        "loss_model_id",
        "evidence_status",
        "evidence_receipt_id",
        "loss_unit",
        "scope_sha256",
        "feasible_action_ids",
        "losses"
      ],
      "properties": {
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "feasible_action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "losses": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/worldLoss"
          }
        },
        "loss_unit": {
          "$ref": "#/$defs/id"
        },
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "loss_model_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_status": {
          "enum": [
            "admissible",
            "inadmissible",
            "indeterminate",
            "out_of_profile"
          ]
        },
        "evidence_receipt_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "maxItems": 16384
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "trigger_reason",
        "worst_case_improvement"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "RETAIN_INCUMBENT",
            "REOPTIMIZATION_WARRANTED",
            "ABSTAIN",
            "INVALID_INPUT"
          ]
        },
        "trigger_reason": {
          "type": "string",
          "minLength": 1
        },
        "worst_case_improvement": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scope_sha256",
        "loss_unit",
        "incumbent_action_id",
        "action_ids",
        "worlds",
        "world_set_state",
        "world_set_receipt_schema",
        "world_set_claim_ceiling",
        "world_set_source_commit",
        "world_set_source_case_id",
        "world_set_receipt_id",
        "world_set_receipt_sha256",
        "expected_world_ids",
        "expected_world_ids_sha256",
        "loss_model_set",
        "domain_closure_state",
        "dependency_graph_state",
        "model_family_state",
        "evidence_state",
        "materiality_margin",
        "switching_cost",
        "expected"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "loss_unit": {
          "$ref": "#/$defs/id"
        },
        "incumbent_action_id": {
          "$ref": "#/$defs/id"
        },
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "worlds": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/world"
          }
        },
        "world_set_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNAVAILABLE"
          ]
        },
        "domain_closure_state": {
          "enum": [
            "CLOSED_WITHIN_DECLARED_SCOPE",
            "OPEN",
            "STALE",
            "INADEQUATE"
          ]
        },
        "model_family_state": {
          "enum": [
            "ADEQUATE",
            "INADEQUATE"
          ]
        },
        "evidence_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "CONTRADICTED",
            "INDETERMINATE"
          ]
        },
        "materiality_margin": {
          "type": "integer",
          "minimum": 0
        },
        "switching_cost": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "dependency_graph_state": {
          "enum": [
            "GRAPH_COMPLETE_WITHIN_DECLARED_GRAMMAR",
            "MISSING_DEPENDENCY_EDGE",
            "COMMON_MODE_DEPENDENCY_OMISSION",
            "CONSUMER_MANIFEST_OMISSION",
            "UNDECLARED_DEPENDENCY_EDGE",
            "DEPENDENCY_MODEL_INADEQUATE",
            "DEPENDENCY_SOURCE_UNAVAILABLE",
            "DEPENDENCY_SCOPE_MISMATCH",
            "INVALID_GRAPH",
            "STALE",
            "INDETERMINATE"
          ]
        },
        "world_set_receipt_id": {
          "$ref": "#/$defs/id"
        },
        "world_set_receipt_sha256": {
          "$ref": "#/$defs/sha"
        },
        "expected_world_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "expected_world_ids_sha256": {
          "$ref": "#/$defs/sha"
        },
        "loss_model_set": {
          "$ref": "#/$defs/lossModelSet"
        },
        "world_set_receipt_schema": {
          "const": "luminous.orbital-decision-identifiability.receipt.v0.1"
        },
        "world_set_claim_ceiling": {
          "const": "exact-finite-world-decision-set-algebra-only"
        },
        "world_set_source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "world_set_source_case_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "lossModelSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "source_receipt_schema",
        "source_claim_ceiling",
        "source_commit",
        "source_receipt_sha256",
        "source_case_id",
        "source_manifest_id",
        "source_scenarios_sha256",
        "source_loss_unit",
        "projection_id",
        "projection_scale_numerator",
        "projection_scale_denominator",
        "expected_scenario_ids",
        "expected_scenario_ids_sha256",
        "projected_scenarios_sha256"
      ],
      "properties": {
        "state": {
          "enum": [
            "CURRENT",
            "STALE",
            "INDETERMINATE",
            "OUT_OF_PROFILE",
            "INADEQUATE"
          ]
        },
        "source_receipt_schema": {
          "const": "luminous.orbital-joint-loss-scenario.receipt.v0.1"
        },
        "source_claim_ceiling": {
          "const": "finite-joint-loss-scenario-regret-algebra-only"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_receipt_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_case_id": {
          "$ref": "#/$defs/id"
        },
        "source_manifest_id": {
          "$ref": "#/$defs/id"
        },
        "source_scenarios_sha256": {
          "$ref": "#/$defs/sha"
        },
        "expected_scenario_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16384,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "expected_scenario_ids_sha256": {
          "$ref": "#/$defs/sha"
        },
        "projected_scenarios_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_loss_unit": {
          "$ref": "#/$defs/id"
        },
        "projection_id": {
          "$ref": "#/$defs/id"
        },
        "projection_scale_numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "projection_scale_denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
