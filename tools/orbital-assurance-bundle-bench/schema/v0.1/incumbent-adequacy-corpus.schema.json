{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital finite-world incumbent adequacy corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-incumbent-adequacy.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-finite-world-incumbent-adequacy-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "worldLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "loss"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "loss": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "scope_sha256",
        "feasible_action_ids",
        "losses"
      ],
      "properties": {
        "world_id": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "feasible_action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "losses": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/worldLoss"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "trigger_reason",
        "worst_case_regret"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "RETAIN_INCUMBENT",
            "REOPTIMIZATION_WARRANTED",
            "ABSTAIN",
            "INVALID_INPUT"
          ]
        },
        "trigger_reason": {
          "type": "string",
          "minLength": 1
        },
        "worst_case_regret": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "scope_sha256",
        "loss_unit",
        "incumbent_action_id",
        "action_ids",
        "worlds",
        "world_set_state",
        "domain_closure_state",
        "model_family_state",
        "evidence_state",
        "materiality_margin",
        "switching_cost",
        "expected"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        },
        "loss_unit": {
          "$ref": "#/$defs/id"
        },
        "incumbent_action_id": {
          "$ref": "#/$defs/id"
        },
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "worlds": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/world"
          }
        },
        "world_set_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNAVAILABLE"
          ]
        },
        "domain_closure_state": {
          "enum": [
            "CLOSED_WITHIN_DECLARED_SCOPE",
            "OPEN",
            "STALE",
            "INADEQUATE"
          ]
        },
        "model_family_state": {
          "enum": [
            "ADEQUATE",
            "INADEQUATE"
          ]
        },
        "evidence_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "CONTRADICTED",
            "INDETERMINATE"
          ]
        },
        "materiality_margin": {
          "type": "integer",
          "minimum": 0
        },
        "switching_cost": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
