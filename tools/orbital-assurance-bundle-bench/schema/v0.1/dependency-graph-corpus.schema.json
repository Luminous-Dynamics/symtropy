{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital dependency graph adequacy corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-dependency-graph-adequacy.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-dependency-graph-adequacy-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "artifact_id",
        "artifact_type",
        "content_sha256",
        "scope_sha256"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_type": {
          "$ref": "#/$defs/id"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha"
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "output_artifact_id",
        "operation",
        "input_artifact_ids",
        "scope_sha256"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/id"
        },
        "output_artifact_id": {
          "$ref": "#/$defs/id"
        },
        "operation": {
          "$ref": "#/$defs/id"
        },
        "input_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "scope_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_node_id",
        "consumer_node_id",
        "artifact_id"
      ],
      "properties": {
        "parent_node_id": {
          "$ref": "#/$defs/id"
        },
        "consumer_node_id": {
          "$ref": "#/$defs/id"
        },
        "artifact_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "missing_dependency_edges",
        "extra_dependency_edges"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "GRAPH_COMPLETE_WITHIN_DECLARED_GRAMMAR",
            "MISSING_DEPENDENCY_EDGE",
            "COMMON_MODE_DEPENDENCY_OMISSION",
            "CONSUMER_MANIFEST_OMISSION",
            "UNDECLARED_DEPENDENCY_EDGE",
            "DEPENDENCY_MODEL_INADEQUATE",
            "DEPENDENCY_SOURCE_UNAVAILABLE",
            "DEPENDENCY_SCOPE_MISMATCH",
            "INVALID_GRAPH"
          ]
        },
        "missing_dependency_edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "extra_dependency_edges": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "producers",
        "consumers",
        "declared_edges",
        "expected"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/id"
        },
        "producers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/producer"
          }
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/consumer"
          }
        },
        "declared_edges": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        }
      }
    }
  }
}
