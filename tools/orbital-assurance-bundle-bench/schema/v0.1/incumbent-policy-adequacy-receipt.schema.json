{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Incumbent policy adequacy receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema",
    "source_commit",
    "fixture_sha256",
    "result",
    "evaluation",
    "physical_qualification_granted",
    "authority_granted"
  ],
  "properties": {
    "receipt_schema": {
      "const": "luminous.orbital-incumbent-policy-adequacy.receipt.v0.1"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "physical_qualification_granted": {
      "const": false
    },
    "authority_granted": {
      "const": false
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evidence_class",
        "claim_ceiling",
        "summary",
        "cases",
        "authority_granted"
      ],
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence_class": {
          "const": "synthetic"
        },
        "claim_ceiling": {
          "const": "synthetic-observable-policy-maintenance-algebra-only"
        },
        "authority_granted": {
          "const": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_count",
            "retain_incumbent_policy_cases",
            "policy_review_warranted_cases",
            "abstain_cases",
            "invalid_input_cases",
            "resource_blocked_cases",
            "authority_grants"
          ],
          "properties": {
            "case_count": {
              "type": "integer",
              "minimum": 1
            },
            "retain_incumbent_policy_cases": {
              "type": "integer",
              "minimum": 0
            },
            "policy_review_warranted_cases": {
              "type": "integer",
              "minimum": 0
            },
            "abstain_cases": {
              "type": "integer",
              "minimum": 0
            },
            "invalid_input_cases": {
              "type": "integer",
              "minimum": 0
            },
            "resource_blocked_cases": {
              "type": "integer",
              "minimum": 0
            },
            "authority_grants": {
              "const": 0
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "status",
              "trigger_reason",
              "loss_unit",
              "materiality_margin",
              "incumbent_worst_case_loss",
              "best_eligible_reference_worst_case_loss",
              "worst_case_improvement",
              "eligible_reference_policy_count",
              "resource_blocked_policy_count",
              "authority_granted"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "RETAIN_INCUMBENT_POLICY",
                  "POLICY_REVIEW_WARRANTED",
                  "ABSTAIN",
                  "INVALID_INPUT"
                ]
              },
              "trigger_reason": {
                "type": "string",
                "minLength": 1
              },
              "loss_unit": {
                "type": "string",
                "minLength": 1
              },
              "materiality_margin": {
                "$ref": "#/$defs/rational"
              },
              "incumbent_worst_case_loss": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/rational"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "best_eligible_reference_worst_case_loss": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/rational"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "worst_case_improvement": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/signed_difference"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eligible_reference_policy_count": {
                "type": "integer",
                "minimum": 0
              },
              "resource_blocked_policy_count": {
                "type": "integer",
                "minimum": 0
              },
              "authority_granted": {
                "const": false
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "signed_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "magnitude"
      ],
      "properties": {
        "direction": {
          "enum": [
            "positive_improvement",
            "negative_improvement",
            "no_change"
          ]
        },
        "magnitude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "denominator": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        }
      }
    }
  }
}
