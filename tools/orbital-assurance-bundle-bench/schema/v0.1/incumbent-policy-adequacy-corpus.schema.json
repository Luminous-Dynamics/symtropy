  "$defs": {
    "source_signed_difference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "magnitude"
      ],
      "properties": {
        "direction": {
          "enum": [
            "positive_improvement",
            "negative_improvement",
            "no_change"
          ]
        },
        "magnitude": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numerator",
            "denominator"
          ],
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000000000
            }
          }
        }
      }
