{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/ev_mission_option_frontier_v0_1",
  "title": "EV mission option frontier corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "option_set_id",
    "claim_ceiling",
    "service_contract",
    "mission_reports",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "option_set_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "service_contract": {
      "$ref": "#/$defs/service_contract"
    },
    "mission_reports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/mission_report"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "service_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "contract_sha256",
        "mission_functional_unit",
        "quantity_unit",
        "minimum_service_quantity"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_sha256": {
          "$ref": "#/$defs/digest"
        },
        "mission_functional_unit": {
          "type": "string",
          "minLength": 1
        },
        "quantity_unit": {
          "type": "string",
          "minLength": 1
        },
        "minimum_service_quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "mission_result": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "scenario_id",
        "design_id",
        "evidence_class",
        "mission_functional_unit",
        "status",
        "gross_mass_margin_kg",
        "peak_power_margin_kw",
        "energy_margin_vs_usable_capacity_kwh",
        "total_unserved_energy_kwh",
        "net_battery_energy_demand_kwh",
        "total_travel_hours",
        "total_stationary_segment_hours",
        "nontravel_duration_hours"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "design_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "measured",
            "manufacturer",
            "literature",
            "estimate",
            "unknown"
          ]
        },
        "mission_functional_unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passes_synthetic_screen",
            "passes_evidence_backed_screen",
            "blocked",
            "indeterminate"
          ]
        },
        "gross_mass_margin_kg": {
          "type": "number"
        },
        "peak_power_margin_kw": {
          "type": "number"
        },
        "energy_margin_vs_usable_capacity_kwh": {
          "type": "number"
        },
        "total_unserved_energy_kwh": {
          "type": "number",
          "minimum": 0
        },
        "net_battery_energy_demand_kwh": {
          "type": "number",
          "minimum": 0
        },
        "total_travel_hours": {
          "type": "number",
          "minimum": 0
        },
        "total_stationary_segment_hours": {
          "type": "number",
          "minimum": 0
        },
        "nontravel_duration_hours": {
          "type": "number",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mission_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_ref",
        "report_sha256",
        "report"
      ],
      "properties": {
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "$ref": "#/$defs/digest"
        },
        "report": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "schema_version",
            "catalog_id",
            "profile_set_id",
            "method",
            "results",
            "claim_ceiling"
          ],
          "properties": {
            "schema_version": {
              "const": "0.2.0"
            },
            "catalog_id": {
              "const": "EV-PLATFORM-001"
            },
            "profile_set_id": {
              "const": "EV-MISSION-PHYSICS-001"
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "claim_ceiling": {
              "type": "string",
              "minLength": 1
            },
            "results": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/mission_result"
              }
            }
          }
        }
      }
    },
    "metric_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "unit",
        "boundary",
        "bound_basis",
        "evidence_class",
        "evidence_ref",
        "evidence_sha256"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0
        },
        "upper": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "bound_basis": {
          "enum": [
            "DECLARED_HARD_BOUND",
            "SCENARIO_ENVELOPE"
          ]
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "measured",
            "manufacturer",
            "literature",
            "estimate",
            "unknown"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "service_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper",
        "unit",
        "bound_basis",
        "evidence_class",
        "evidence_ref",
        "evidence_sha256"
      ],
      "properties": {
        "lower": {
          "type": "number",
          "minimum": 0
        },
        "upper": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "bound_basis": {
          "enum": [
            "DECLARED_HARD_BOUND",
            "SCENARIO_ENVELOPE"
          ]
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "measured",
            "manufacturer",
            "literature",
            "estimate",
            "unknown"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "label",
        "strategy_class",
        "source_report_ref",
        "source_report_sha256",
        "scenario_id",
        "source_result_sha256",
        "service_delivery",
        "battery_energy",
        "elapsed_time"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "strategy_class": {
          "enum": [
            "baseline",
            "route_profile",
            "speed_profile",
            "auxiliary_management",
            "load_shed"
          ]
        },
        "source_report_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_report_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "source_result_sha256": {
          "$ref": "#/$defs/digest"
        },
        "service_delivery": {
          "$ref": "#/$defs/service_delivery"
        },
        "battery_energy": {
          "$ref": "#/$defs/metric_bound"
        },
        "elapsed_time": {
          "$ref": "#/$defs/metric_bound"
        }
      }
    }
  }
}
