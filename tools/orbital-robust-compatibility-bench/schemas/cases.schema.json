{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-robust-compatibility-v0.1.json",
  "title": "Orbital Robust Compatibility Corpus v0.1",
  "type": "object",
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-robust-compatibility.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-profile-only"
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "items": {
        "$ref": "#/$defs/robustCase"
      }
    }
  },
  "$defs": {
    "dependence": {
      "type": "object",
      "required": [
        "group_id",
        "context_of_use",
        "disposition",
        "receipt_id",
        "artifact_sha256",
        "profile_bindings",
        "profile_bindings"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "context_of_use": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "joint_model",
            "evidence_backed_independence",
            "no_shared_source_assessed",
            "unknown"
          ]
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "profile_id",
              "configuration_revision"
            ],
            "properties": {
              "profile_id": {
                "type": "string",
                "minLength": 1
              },
              "configuration_revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "uncertaintyReceipt": {
      "type": "object",
      "required": [
        "receipt_id",
        "source_schema",
        "source_commit",
        "artifact_sha256",
        "profile_id",
        "configuration_revision",
        "lifecycle_state_id",
        "measurand_id",
        "unit",
        "representation",
        "disposition",
        "uncertainty_minus",
        "uncertainty_plus",
        "context_of_use",
        "valid_from_tick",
        "valid_until_tick",
        "claim_ceiling",
        "dependence"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "source_schema": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_state_id": {
          "type": "string",
          "minLength": 1
        },
        "measurand_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "representation": {
          "enum": [
            "hard_bounded_error",
            "standard_uncertainty",
            "expanded_uncertainty",
            "coverage_interval",
            "prediction_interval"
          ]
        },
        "disposition": {
          "enum": [
            "qualified",
            "unknown",
            "inconclusive",
            "rejected"
          ]
        },
        "uncertainty_minus": {
          "type": "number",
          "minimum": 0
        },
        "uncertainty_plus": {
          "type": "number",
          "minimum": 0
        },
        "context_of_use": {
          "type": "string",
          "minLength": 1
        },
        "valid_from_tick": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_tick": {
          "type": "integer",
          "minimum": 0
        },
        "claim_ceiling": {
          "const": "synthetic-profile-only"
        },
        "dependence": {
          "$ref": "#/$defs/dependence"
        }
      },
      "additionalProperties": false
    },
    "robustCase": {
      "type": "object",
      "required": [
        "case_id",
        "at_tick",
        "context_of_use",
        "provider_lifecycle_state_id",
        "client_lifecycle_state_id",
        "nominal_case",
        "uncertainty_receipts",
        "expected_status",
        "expected_reason"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "at_tick": {
          "type": "integer",
          "minimum": 0
        },
        "context_of_use": {
          "type": "string",
          "minLength": 1
        },
        "provider_lifecycle_state_id": {
          "type": "string",
          "minLength": 1
        },
        "client_lifecycle_state_id": {
          "type": "string",
          "minLength": 1
        },
        "nominal_case": {
          "$ref": "../../orbital-interface-conformance-bench/schemas/cases.schema.json#/$defs/case"
        },
        "uncertainty_receipts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/uncertaintyReceipt"
          }
        },
        "expected_status": {
          "enum": [
            "robustly_compatible_synthetic",
            "rejected",
            "indeterminate"
          ]
        },
        "expected_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
