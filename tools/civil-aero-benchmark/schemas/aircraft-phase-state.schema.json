{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/aircraft-phase-state-0.1.json",
  "title": "AER-01 Aircraft Phase State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "mission_id",
    "phase_id",
    "state_kind",
    "configuration_sha256",
    "source_generation_sha256",
    "previous_state_sha256",
    "state_sha256",
    "reference_frame_id",
    "mass_items",
    "expected_mass_properties",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "aircraft-phase-state/0.1.0"
    },
    "state_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "phase_id": {
      "type": "string",
      "minLength": 1
    },
    "state_kind": {
      "enum": [
        "dispatch",
        "takeoff",
        "intermediate",
        "landing",
        "diversion",
        "go_around",
        "reserve"
      ]
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "source_generation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "previous_state_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "reference_frame_id": {
      "type": "string",
      "minLength": 1
    },
    "mass_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mass_item"
      }
    },
    "expected_mass_properties": {
      "$ref": "#/$defs/mass_properties"
    },
    "fuel_consumption_since_previous_kg": {
      "type": "number",
      "minimum": 0
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "mass_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "category",
        "mass_kg",
        "position_m"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "mass_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_mass_kg",
        "center_of_gravity_m",
        "inertia_tensor_about_cg_kg_m2"
      ],
      "properties": {
        "total_mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "center_of_gravity_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "inertia_tensor_about_cg_kg_m2": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        }
      }
    }
  }
}
