{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/civil-aero-benchmark/inspection-observability/inspection-observability-corpus-v0.1.schema.json",
  "title": "AER-01 synthetic inspection observability corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "claim_ceiling",
    "physical_probability_of_detection_claim",
    "aircraft_acceptance_claim",
    "cases",
    "invariant_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "aero-inspection-observability-corpus/0.1.0"
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "const": "synthetic_contract_conformance_only"
    },
    "physical_probability_of_detection_claim": {
      "const": false
    },
    "aircraft_acceptance_claim": {
      "const": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "invariant_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_POD_claim",
        "synthetic_sensor_reliability_probability",
        "maintenance_release",
        "required_region_coverage",
        "correction_must_not_clear_damage_hypothesis",
        "unknown_sensing_state_must_abstain"
      ],
      "properties": {
        "synthetic_POD_claim": {
          "const": "FORBIDDEN"
        },
        "synthetic_sensor_reliability_probability": {
          "const": "FORBIDDEN"
        },
        "maintenance_release": {
          "const": "NOT_AUTHORIZED"
        },
        "required_region_coverage": {
          "const": "ALL_CRITICAL_REGIONS"
        },
        "correction_must_not_clear_damage_hypothesis": {
          "const": true
        },
        "unknown_sensing_state_must_abstain": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "title",
        "evidence_class",
        "article",
        "inspection",
        "sensing",
        "expected_disposition"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^SYN-IO-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "const": "synthetic"
        },
        "article": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration_id",
            "geometry_generation",
            "material_family"
          ],
          "properties": {
            "configuration_id": {
              "type": "string",
              "minLength": 1
            },
            "geometry_generation": {
              "type": "string",
              "minLength": 1
            },
            "material_family": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "procedure_revision",
            "procedure_current",
            "calibration_current",
            "coordinate_frame_match",
            "geometry_generation_match",
            "method_applicable",
            "surface_coverage_fraction",
            "required_regions",
            "observed_regions",
            "critical_regions_observed"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "procedure_revision": {
              "type": "string",
              "minLength": 1
            },
            "procedure_current": {
              "type": "boolean"
            },
            "calibration_current": {
              "type": "boolean"
            },
            "coordinate_frame_match": {
              "type": "boolean"
            },
            "geometry_generation_match": {
              "type": "boolean"
            },
            "method_applicable": {
              "type": "boolean"
            },
            "surface_coverage_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "required_regions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observed_regions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "critical_regions_observed": {
              "type": "boolean"
            }
          }
        },
        "sensing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state_known",
            "structural_damage_candidate",
            "sensor_fault_candidate",
            "environment_shift",
            "correction_applied"
          ],
          "properties": {
            "state_known": {
              "type": "boolean"
            },
            "structural_damage_candidate": {
              "type": "boolean"
            },
            "sensor_fault_candidate": {
              "type": "boolean"
            },
            "environment_shift": {
              "type": "boolean"
            },
            "correction_applied": {
              "type": "boolean"
            },
            "corrected_signal_looks_healthy": {
              "type": "boolean"
            }
          }
        },
        "expected_disposition": {
          "enum": [
            "NO_ANOMALY_IN_SYNTHETIC_FIXTURE",
            "UNRESOLVED_INCOMPLETE_CRITICAL_COVERAGE",
            "REJECT_IDENTITY_MISMATCH",
            "REJECT_INVALID_INSPECTION_STATE",
            "UNRESOLVED_METHOD_OUT_OF_DOMAIN",
            "REQUIRE_INDEPENDENT_NDE",
            "SENSOR_FAULT_SUSPECTED_NO_STRUCTURAL_CLEARANCE",
            "REASSESS_ENVIRONMENT",
            "UNRESOLVED_SENSING_STATE"
          ]
        },
        "pod": {
          "not": {}
        },
        "pod90_95": {
          "not": {}
        },
        "sensor_reliability_probability": {
          "not": {}
        },
        "inspection_accepted": {
          "not": {}
        },
        "maintenance_release": {
          "not": {}
        },
        "aircraft_safe": {
          "not": {}
        }
      }
    }
  }
}
