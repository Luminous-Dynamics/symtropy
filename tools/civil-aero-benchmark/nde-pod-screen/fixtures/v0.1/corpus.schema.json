{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/civil-aero-benchmark/nde-pod-screen/fixtures/v0.1/corpus.schema.json",
  "title": "AER-01 fixed-target hit/miss binomial screen corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_id",
    "evidence_class",
    "claim_ceiling",
    "scope",
    "criteria",
    "base_study",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.aero.nde-fixed-target-screen.v0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "fixed_target_binomial_screening_only"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_inspectors",
        "minimum_flaw_trials_per_inspector",
        "minimum_blank_trials_per_inspector",
        "target_detection_probability",
        "detection_one_sided_confidence",
        "maximum_false_call_probability",
        "false_call_one_sided_confidence"
      ],
      "properties": {
        "minimum_inspectors": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_flaw_trials_per_inspector": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_blank_trials_per_inspector": {
          "type": "integer",
          "minimum": 1
        },
        "target_detection_probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "detection_one_sided_confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "maximum_false_call_probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "false_call_one_sided_confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "base_study": {
      "$ref": "#/$defs/study"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ref",
        "method_id",
        "procedure_revision",
        "material_system",
        "defect_family",
        "defect_orientation",
        "environment_id",
        "target_flaw_size_mm"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "procedure_revision": {
          "type": "string",
          "minLength": 1
        },
        "material_system": {
          "type": "string",
          "minLength": 1
        },
        "defect_family": {
          "type": "string",
          "minLength": 1
        },
        "defect_orientation": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        },
        "target_flaw_size_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_id",
        "evidence_class",
        "scope_ref",
        "inspectors"
      ],
      "properties": {
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "const": "synthetic"
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "inspectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inspector"
          }
        }
      }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inspector_id",
        "equipment_serial",
        "calibration_id",
        "calibration_valid",
        "flaw_trials",
        "blank_trials"
      ],
      "properties": {
        "inspector_id": {
          "type": "string",
          "minLength": 1
        },
        "equipment_serial": {
          "type": "string",
          "minLength": 1
        },
        "calibration_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_valid": {
          "type": "boolean"
        },
        "flaw_trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flawTrial"
          }
        },
        "blank_trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blankTrial"
          }
        }
      }
    },
    "flawTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specimen_id",
        "scope_ref",
        "flaw_size_mm",
        "detected"
      ],
      "properties": {
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "flaw_size_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detected": {
          "type": "boolean"
        }
      }
    },
    "blankTrial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specimen_id",
        "scope_ref",
        "false_call"
      ],
      "properties": {
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "false_call": {
          "type": "boolean"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "mutations",
        "expected_disposition"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_disposition": {
          "type": "string",
          "minLength": 1
        },
        "mutations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "remove_inspector",
                  "set_calibration_valid",
                  "set_flaw_detected",
                  "set_blank_false_call",
                  "set_flaw_size_mm",
                  "set_flaw_specimen_id",
                  "truncate_blank_trials"
                ]
              },
              "inspector_id": {
                "type": "string"
              },
              "trial_index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {}
            }
          }
        }
      }
    }
  }
}
