{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb-fuel-service-case-v0.1.schema.json",
  "title": "SAFRB synthetic fuel-to-service case v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "archetype", "seed", "scenarioStartUnixS", "horizonHours", "evidenceMaturity", "inventory", "transport", "conversion", "generator", "service"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "caseId": { "type": "string", "pattern": "^safrb-fuel-v0\\.1-" },
    "archetype": { "enum": ["baseline-all-paths", "crude-cargo-delay", "refined-diesel-cargo-delay", "tank-quality-quarantine", "tank-gauge-uncertainty", "pump-pipeline-failure", "berth-discharge-restriction", "refinery-process-trip", "generator-derating", "generator-fuel-grade-mismatch", "grid-islanded-backup-constraint", "common-cause-supplier-port-grid-comms"] },
    "seed": { "type": "integer", "minimum": 0 },
    "scenarioStartUnixS": { "type": "integer", "minimum": 0 },
    "horizonHours": { "const": 72 },
    "evidenceMaturity": { "const": "synthetic_fixture" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "openingGrams", "acceptedInflowGrams", "withdrawalsGrams", "declaredLossesGrams", "closingGrams", "measurementUncertaintyBasisPoints", "observedLowerGrams", "observedUpperGrams", "quarantinedGrams", "operatingHeelGrams", "usableGrams", "encumberedGrams", "authorityAvailable", "accessibleGrams"],
      "properties": {
        "product": { "enum": ["crude_oil", "diesel"] },
        "openingGrams": { "type": "integer", "minimum": 0 },
        "acceptedInflowGrams": { "type": "integer", "minimum": 0 },
        "withdrawalsGrams": { "type": "integer", "minimum": 0 },
        "declaredLossesGrams": { "type": "integer", "minimum": 0 },
        "closingGrams": { "type": "integer", "minimum": 0 },
        "measurementUncertaintyBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "observedLowerGrams": { "type": "integer", "minimum": 0 },
        "observedUpperGrams": { "type": "integer", "minimum": 0 },
        "quarantinedGrams": { "type": "integer", "minimum": 0 },
        "operatingHeelGrams": { "type": "integer", "minimum": 0 },
        "usableGrams": { "type": "integer", "minimum": 0 },
        "encumberedGrams": { "type": "integer", "minimum": 0 },
        "authorityAvailable": { "type": "boolean" },
        "accessibleGrams": { "type": "integer", "minimum": 0 }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cargoArrivalHour", "transitDelayHours", "primaryCapacityGramsPerHour", "alternateCapacityGramsPerHour", "effectiveCapacityGramsPerHour", "deliverableGrams", "commonCauseGroup"],
      "properties": {
        "cargoArrivalHour": { "type": "integer", "minimum": 0 },
        "transitDelayHours": { "type": "integer", "minimum": 0, "maximum": 72 },
        "primaryCapacityGramsPerHour": { "type": "integer", "minimum": 0 },
        "alternateCapacityGramsPerHour": { "type": "integer", "minimum": 0 },
        "effectiveCapacityGramsPerHour": { "type": "integer", "minimum": 0 },
        "deliverableGrams": { "type": "integer", "minimum": 0 },
        "commonCauseGroup": { "type": "string", "minLength": 1 }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputProduct", "outputProduct", "inputGrams", "outputGrams", "declaredProcessLossGrams", "processCapacityGrams", "yieldBasisPoints", "processModelId"],
      "properties": {
        "inputProduct": { "enum": ["crude_oil", "diesel"] },
        "outputProduct": { "const": "diesel" },
        "inputGrams": { "type": "integer", "minimum": 0 },
        "outputGrams": { "type": "integer", "minimum": 0 },
        "declaredProcessLossGrams": { "type": "integer", "minimum": 0 },
        "processCapacityGrams": { "type": "integer", "minimum": 0 },
        "yieldBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "processModelId": { "type": "string", "minLength": 1 }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fuelGradeCompatible", "fuelConsumedGrams", "syntheticLhvMilliWhPerGram", "efficiencyBasisPoints", "ratedPowerCapacityKw", "derateBasisPoints", "networkDeliveryBasisPoints", "grossElectricityWh", "networkDeliverableWh"],
      "properties": {
        "fuelGradeCompatible": { "type": "boolean" },
        "fuelConsumedGrams": { "type": "integer", "minimum": 0 },
        "syntheticLhvMilliWhPerGram": { "type": "integer", "minimum": 0 },
        "efficiencyBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "ratedPowerCapacityKw": { "type": "integer", "minimum": 0 },
        "derateBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "networkDeliveryBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "grossElectricityWh": { "type": "integer", "minimum": 0 },
        "networkDeliverableWh": { "type": "integer", "minimum": 0 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["demandWh", "criticalFloorWh", "deliveredLowerWh", "deliveredUpperWh", "uncertaintyBasisPoints", "telemetryState", "disposition"],
      "properties": {
        "demandWh": { "type": "integer", "minimum": 1 },
        "criticalFloorWh": { "type": "integer", "minimum": 1 },
        "deliveredLowerWh": { "type": "integer", "minimum": 0 },
        "deliveredUpperWh": { "type": "integer", "minimum": 0 },
        "uncertaintyBasisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "telemetryState": { "enum": ["fresh_synthetic", "stale_or_conflicting"] },
        "disposition": { "enum": ["guaranteed", "confirmed_shortfall", "indeterminate"] }
      }
    }
  }
}
