{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb-cargo-ledger-observation-v0.1.schema.json",
  "title": "SAFRB planner-visible cargo manifest observation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","recordKind","caseId","horizonHours","evidenceMaturity","manifests"],
  "properties": {
    "schemaVersion": {"const":"0.1.0"},
    "recordKind": {"const":"planner_observation"},
    "caseId": {"type":"string","minLength":1},
    "horizonHours": {"const":72},
    "evidenceMaturity": {"const":"synthetic_fixture"},
    "manifests": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["cargoId","supplierId","terminalId","product","grade","plannedQuantityGrams","declaredEtaHour","knownAtHour","commonCauseGroup","documentaryStatus"],"properties":{"cargoId":{"type":"string","minLength":1},"supplierId":{"type":"string","minLength":1},"terminalId":{"type":"string","minLength":1},"product":{"type":"string","minLength":1},"grade":{"type":"string","minLength":1},"plannedQuantityGrams":{"type":"integer","minimum":1},"declaredEtaHour":{"type":"integer","minimum":0},"knownAtHour":{"const":0},"commonCauseGroup":{"type":"string","minLength":1},"documentaryStatus":{"type":"string","minLength":1}}}}
  }
}
