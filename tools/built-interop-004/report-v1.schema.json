{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/built-interop-004/report-v1.schema.json",
  "title": "BUILT-INTEROP-004 Validation Ladder Report v1",
  "description": "A closed, evidence-carrying report contract. A separate deterministic checker enforces cross-field gate and overall-decision invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "reported_at",
    "evaluation_profile",
    "evaluator",
    "artifacts",
    "gates",
    "overall_decision",
    "scope_statement",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "benchmark_id": {
      "const": "BUILT-INTEROP-004"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ifc_schema",
        "ids_version",
        "supported_subset"
      ],
      "properties": {
        "ifc_schema": {
          "type": "string",
          "minLength": 1
        },
        "ids_version": {
          "const": "1.0"
        },
        "supported_subset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_commit_sha"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "sha256",
          "byte_length",
          "media_type",
          "locator"
        ],
        "properties": {
          "role": {
            "enum": [
              "source_ifc",
              "requirements_ids",
              "target_ifc"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "mandatory",
          "status",
          "claim_scope",
          "limitations",
          "evidence"
        ],
        "properties": {
          "gate_id": {
            "enum": [
              "artifact_integrity",
              "step_syntax",
              "ifc_schema_conformance",
              "ids_xsd_validity",
              "ids_semantic_validity",
              "ids_model_conformance",
              "exchange_semantic_preservation",
              "engineering_release_qualification"
            ]
          },
          "mandatory": {
            "const": true
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "UNRESOLVED",
              "NOT_RUN"
            ]
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tool": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "config_sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "config_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_id",
                "kind",
                "sha256",
                "locator"
              ],
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "enum": [
                    "tool_output",
                    "validator_report",
                    "mutation_test",
                    "external_attestation",
                    "artifact_digest",
                    "review_record"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "tool"
              ],
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_RUN"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence": {
                  "maxItems": 0
                }
              },
              "not": {
                "required": [
                  "tool"
                ]
              }
            }
          }
        ]
      }
    },
    "overall_decision": {
      "enum": [
        "QUALIFIED",
        "BLOCKED",
        "UNQUALIFIED"
      ]
    },
    "scope_statement": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
