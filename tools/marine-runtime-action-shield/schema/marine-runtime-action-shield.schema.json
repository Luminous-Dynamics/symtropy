{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-runtime-action-shield:0.1.0",
  "title": "Marine Runtime Action Shield Decision Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_id",
    "record_status",
    "claim_ceiling",
    "mission_snapshot",
    "service_contract",
    "hard_gate_roster",
    "scenario_roster",
    "disturbance_roster",
    "current_state",
    "decision",
    "permit_registry",
    "authority_scope",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scorecard_id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "synthetic",
        "shadow_replay",
        "measured_campaign",
        "published_reproduction"
      ]
    },
    "claim_ceiling": {
      "const": "one_step_runtime_decision_receipt_only"
    },
    "mission_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "mission_snapshot_sha256",
        "craft_configuration_sha256",
        "actuator_configuration_sha256",
        "service_contract_sha256",
        "hard_gate_roster_sha256",
        "scenario_roster_sha256",
        "disturbance_roster_sha256",
        "model_sha256",
        "operating_domain_sha256"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "craft_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "actuator_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "service_contract_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "hard_gate_roster_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "scenario_roster_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "disturbance_roster_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "operating_domain_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "service_contract": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "unit",
          "operator",
          "floor_value",
          "minimum_coverage_fraction"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "gte",
              "lte"
            ]
          },
          "floor_value": {
            "type": "number"
          },
          "minimum_coverage_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "hard_gate_roster": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scenario_roster": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "disturbance_roster": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_class",
          "disturbance_id",
          "disturbance_sha256"
        ],
        "properties": {
          "scenario_class": {
            "type": "string",
            "minLength": 1
          },
          "disturbance_id": {
            "type": "string",
            "minLength": 1
          },
          "disturbance_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_sequence",
        "state_sha256",
        "observed_at",
        "valid_until",
        "craft_configuration_sha256",
        "actuator_configuration_sha256",
        "model_sha256",
        "operating_domain_sha256",
        "available_capabilities",
        "resource_metrics"
      ],
      "properties": {
        "state_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": "string",
          "format": "date-time"
        },
        "craft_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "actuator_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "operating_domain_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "available_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resource_metrics": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "unit",
              "value",
              "lower_bound",
              "upper_bound",
              "coverage_fraction",
              "evidence_sha256"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number"
              },
              "lower_bound": {
                "type": "number"
              },
              "upper_bound": {
                "type": "number"
              },
              "coverage_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_time",
        "max_state_age_seconds",
        "permit_ttl_seconds",
        "permit_nonce_sha256"
      ],
      "properties": {
        "decision_time": {
          "type": "string",
          "format": "date-time"
        },
        "max_state_age_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "permit_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "permit_nonce_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "permit_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumed_nonce_sha256"
      ],
      "properties": {
        "consumed_nonce_sha256": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "authority_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "authority_ref",
        "authority_sha256"
      ],
      "properties": {
        "scope": {
          "const": "runtime_decision_receipt_only"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        },
        "authority_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "role",
          "fallback_priority",
          "action_id",
          "required_capabilities",
          "precondition_state_sequence",
          "precondition_state_sha256",
          "craft_configuration_sha256",
          "actuator_configuration_sha256",
          "model_sha256",
          "operating_domain_sha256",
          "transition_relation_sha256",
          "action_evidence_sha256",
          "action_digest_sha256",
          "duration_seconds",
          "scenario_successors"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "proposed",
              "fallback"
            ]
          },
          "fallback_priority": {
            "type": "integer",
            "minimum": 0
          },
          "action_id": {
            "type": "string",
            "minLength": 1
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "precondition_state_sequence": {
            "type": "integer",
            "minimum": 1
          },
          "precondition_state_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "craft_configuration_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "actuator_configuration_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "operating_domain_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "transition_relation_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "action_evidence_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "action_digest_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "scenario_successors": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scenario_class",
                "disturbance_sha256",
                "successor_state_sha256",
                "resource_metrics",
                "hard_gate_checks",
                "recoverability"
              ],
              "properties": {
                "scenario_class": {
                  "type": "string",
                  "minLength": 1
                },
                "disturbance_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "successor_state_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "resource_metrics": {
                  "type": "array",
                  "minItems": 11,
                  "maxItems": 11,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "metric",
                      "unit",
                      "value",
                      "lower_bound",
                      "upper_bound",
                      "coverage_fraction",
                      "evidence_sha256"
                    ],
                    "properties": {
                      "metric": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "number"
                      },
                      "lower_bound": {
                        "type": "number"
                      },
                      "upper_bound": {
                        "type": "number"
                      },
                      "coverage_fraction": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "evidence_sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      }
                    }
                  }
                },
                "hard_gate_checks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "gate_id",
                      "status",
                      "evidence_sha256"
                    ],
                    "properties": {
                      "gate_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "pass",
                          "fail",
                          "unknown"
                        ]
                      },
                      "evidence_sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      }
                    }
                  }
                },
                "recoverability": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "minimum_intervention_margin_seconds",
                    "required_intervention_margin_seconds",
                    "evidence_sha256"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "reachable",
                        "unreachable",
                        "unknown"
                      ]
                    },
                    "minimum_intervention_margin_seconds": {
                      "type": "number"
                    },
                    "required_intervention_margin_seconds": {
                      "type": "number",
                      "minimum": 0
                    },
                    "evidence_sha256": {
                      "type": "string",
                      "pattern": "^[a-fA-F0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
