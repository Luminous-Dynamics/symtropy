{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/bh-execution-manifest-1.0.0.schema.json",
  "title": "Black-hole numerical execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "evidence_status", "method_id", "implementation_id", "implementation_sha256", "code", "build", "invocation", "runtime", "hardware", "arithmetic", "solver", "result", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "evidence_status": {"enum": ["illustrative_not_executed", "completed", "failed", "interrupted"]},
    "method_id": {"type": "string", "minLength": 1},
    "implementation_id": {"type": "string", "minLength": 1},
    "implementation_sha256": {"$ref": "#/$defs/sha256"},
    "code": {"$ref": "#/$defs/code"},
    "build": {"$ref": "#/$defs/build"},
    "invocation": {"$ref": "#/$defs/invocation"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "hardware": {"$ref": "#/$defs/hardware"},
    "arithmetic": {"$ref": "#/$defs/arithmetic"},
    "solver": {"$ref": "#/$defs/solver"},
    "result": {"$ref": "#/$defs/result"},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "optional_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "code": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "working_tree", "source_tree_sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^([a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"},
        "working_tree": {"enum": ["clean", "dirty", "unknown"]},
        "source_tree_sha256": {"$ref": "#/$defs/optional_sha256"}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "compiler", "compiler_version", "target_triple", "profile", "flags", "dependency_lock_sha256", "executable_sha256"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "target_triple": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "flags": {"type": "array", "items": {"type": "string"}},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "executable_sha256": {"$ref": "#/$defs/optional_sha256"}
      }
    },
    "named_digest": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
      "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "environment_digest": {
      "type": "object", "additionalProperties": false, "required": ["name", "value_sha256"],
      "properties": {"name": {"type": "string", "minLength": 1}, "value_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "working_directory", "input_files", "input_set_format", "input_set_sha256", "environment"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "working_directory": {"type": "string", "minLength": 1},
        "input_files": {"type": "array", "items": {"$ref": "#/$defs/named_digest"}},
        "input_set_format": {"const": "utf8_bytewise_name_tab_lowercase_sha256_lf_v1"},
        "input_set_sha256": {"$ref": "#/$defs/sha256"},
        "environment": {"type": "array", "items": {"$ref": "#/$defs/environment_digest"}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["operating_system", "kernel", "architecture", "runtime", "container_image_sha256"],
      "properties": {
        "operating_system": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runtime": {"type": "string", "minLength": 1},
        "container_image_sha256": {"$ref": "#/$defs/optional_sha256"}
      }
    },
    "accelerator": {
      "type": "object", "additionalProperties": false, "required": ["model", "driver", "memory_bytes"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "driver": {"type": "string", "minLength": 1},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_model", "logical_cpus", "memory_bytes", "accelerators"],
      "properties": {
        "cpu_model": {"type": "string", "minLength": 1},
        "logical_cpus": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "accelerators": {"type": "array", "items": {"$ref": "#/$defs/accelerator"}}
      }
    },
    "arithmetic": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "precision_bits", "rounding_mode", "deterministic_reductions"],
      "properties": {
        "format": {"type": "string", "minLength": 1},
        "precision_bits": {"type": "integer", "minimum": 1},
        "rounding_mode": {"type": "string", "minLength": 1},
        "deterministic_reductions": {"type": "boolean"}
      }
    },
    "solver": {
      "type": "object", "additionalProperties": false,
      "required": ["solver_id", "solver_version", "algorithm", "settings_sha256", "parameters", "stopping_criteria", "max_steps", "random_seed"],
      "properties": {
        "solver_id": {"type": "string", "minLength": 1},
        "solver_version": {"type": "string", "minLength": 1},
        "algorithm": {"type": "string", "minLength": 1},
        "settings_sha256": {"$ref": "#/$defs/sha256"},
        "parameters": {"type": "object", "additionalProperties": {"type": "string"}},
        "stopping_criteria": {"type": "string", "minLength": 1},
        "max_steps": {"type": ["integer", "null"], "minimum": 1},
        "random_seed": {"type": ["string", "null"]}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at_unix_ns", "finished_at_unix_ns", "elapsed_ns", "exit_code", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "started_at_unix_ns": {"type": ["integer", "null"], "minimum": 0},
        "finished_at_unix_ns": {"type": ["integer", "null"], "minimum": 0},
        "elapsed_ns": {"type": ["integer", "null"], "minimum": 0},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_sha256": {"$ref": "#/$defs/optional_sha256"},
        "stderr_sha256": {"$ref": "#/$defs/optional_sha256"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path", "role", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
