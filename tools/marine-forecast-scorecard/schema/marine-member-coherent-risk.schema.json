{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-member-coherent-risk:0.1.0",
  "title": "Marine Member-Coherent Route Risk Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","scorecard_id","record_status","claim_ceiling","forecast","routes"],
  "properties": {
    "schema_version": {"const":"0.1.0"},
    "scorecard_id": {"type":"string","minLength":1},
    "record_status": {"enum":["synthetic","shadow_replay","measured_campaign","published_reproduction"]},
    "claim_ceiling": {"const":"member_coherent_route_risk_only"},
    "forecast": {
      "type":"object","additionalProperties":false,
      "required":["source_id","cycle_id","artifact_sha256","forecast_issue_time","first_available_at","decision_cutoff","availability_receipt_ref","availability_receipt_sha256","member_set_sha256","members"],
      "properties": {
        "source_id":{"type":"string","minLength":1},
        "cycle_id":{"type":"string","minLength":1},
        "artifact_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "forecast_issue_time":{"type":"string","format":"date-time"},
        "first_available_at":{"type":"string","format":"date-time"},
        "decision_cutoff":{"type":"string","format":"date-time"},
        "availability_receipt_ref":{"type":"string","minLength":1},
        "availability_receipt_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "member_set_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
        "members":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["member_id","artifact_sha256"],"properties":{"member_id":{"type":"string","minLength":1},"artifact_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}}}}
      }
    },
    "routes": {
      "type":"array","minItems":2,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["route_id","edge_ids","members"],
        "properties":{
          "route_id":{"type":"string","minLength":1},
          "edge_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
          "members":{
            "type":"array","minItems":2,
            "items":{
              "type":"object","additionalProperties":false,
              "required":["member_id","source_member_sha256","path_result_sha256","edge_losses"],
              "properties":{
                "member_id":{"type":"string","minLength":1},
                "source_member_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
                "path_result_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
                "edge_losses":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["edge_id","loss_kwh_equivalent"],"properties":{"edge_id":{"type":"string","minLength":1},"loss_kwh_equivalent":{"type":"number","minimum":0}}}}
              }
            }
          }
        }
      }
    }
  }
}