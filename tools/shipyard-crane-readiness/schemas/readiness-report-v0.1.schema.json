{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/shipyard-crane-readiness-report-v0.1.schema.json",
  "title": "Shipyard Crane Readiness Report V0.1",
  "description": "Human-review readiness output; never a permit or authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "disposition",
    "diagnostics",
    "verified_evidence_count",
    "required_evidence_count",
    "verified_device_count",
    "required_device_count",
    "verified_role_count",
    "required_role_count"
  ],
  "properties": {
    "contract_version": {
      "const": "shipyard-crane-readiness-v0.1"
    },
    "disposition": {
      "enum": [
        "ready_for_human_review",
        "rejected",
        "indeterminate"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "subject_id",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "rejected",
              "indeterminate"
            ]
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "verified_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "required_evidence_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_device_count": {
      "type": "integer",
      "minimum": 0
    },
    "required_device_count": {
      "type": "integer",
      "minimum": 0
    },
    "verified_role_count": {
      "type": "integer",
      "minimum": 0
    },
    "required_role_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
