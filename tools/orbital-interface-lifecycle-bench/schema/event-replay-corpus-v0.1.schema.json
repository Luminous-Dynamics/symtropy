{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-interface-event-replay-corpus-v0.1.schema.json",
  "title": "Orbital Interface Event Replay Corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-interface-event-replay.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-event-replay-semantics-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "at_tick",
          "events",
          "expected_status",
          "expected_reason",
          "expected_cycle_count",
          "expected_duplicate_count"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "at_tick": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "raw_event",
                "claimed_sha256"
              ],
              "properties": {
                "raw_event": {
                  "type": "string",
                  "minLength": 2
                },
                "claimed_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "expected_status": {
            "enum": [
              "qualified",
              "requalification_required",
              "withdrawn",
              "rejected",
              "disputed",
              "indeterminate"
            ]
          },
          "expected_reason": {
            "type": "string",
            "minLength": 1
          },
          "expected_cycle_count": {
            "type": "integer",
            "minimum": 0
          },
          "expected_duplicate_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
