{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/battery-pack-state-journal-v0.1.schema.json",
  "title": "Battery pack state journal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id",
    "configuration_digest",
    "replay_cutoff_unix_ms",
    "initial_state",
    "events"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration_digest": {
      "type": "string",
      "minLength": 1
    },
    "replay_cutoff_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "initial_state": {
      "$ref": "#/$defs/packStateEvidence"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "packState": {
      "type": "string",
      "enum": [
        "available",
        "installed",
        "reserved",
        "depleted",
        "charging",
        "cooling",
        "balancing",
        "inspection",
        "repair",
        "post_test",
        "quarantined",
        "in_transit",
        "retired",
        "unknown"
      ]
    },
    "evidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "configuration_digest",
        "producer_id",
        "method_id",
        "evidence_reference",
        "evidence_class",
        "observed_at_unix_ms",
        "valid_from_unix_ms",
        "valid_until_unix_ms"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "synthetic",
            "measured",
            "independent_test",
            "unknown"
          ]
        },
        "observed_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "valid_from_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "valid_until_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "packStateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "value"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidenceEnvelope"
        },
        "value": {
          "$ref": "#/$defs/packState"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "idempotency_key",
        "operation_id",
        "sequence",
        "event_time_unix_ms",
        "from_state",
        "proposed_to_state",
        "disposition",
        "evidence"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "event_time_unix_ms": {
          "type": "integer",
          "minimum": 1
        },
        "from_state": {
          "$ref": "#/$defs/packState"
        },
        "proposed_to_state": {
          "$ref": "#/$defs/packState"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "confirmed",
            "timeout",
            "outcome_unknown",
            "reconciled"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidenceEnvelope"
        }
      }
    }
  }
}
