{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/ev-passenger-cost-frontier/schemas/mobility_service_risk_envelope_v0_1.schema.json",
  "title": "Mobility Service Risk Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "tail_mass_ppm",
    "total_variation_radius_ppm",
    "probability_manifest",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "MOBILITY-SERVICE-RISK-ENVELOPE-001"
    },
    "tail_mass_ppm": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "total_variation_radius_ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "probability_manifest": {
      "$ref": "#/$defs/probabilityManifest"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "probabilityManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "benchmark_id",
        "probability_set_id",
        "probability_basis",
        "probability_source_reference",
        "scenario_tree_revision",
        "scenario_tree_digest",
        "scenario_tree_reference",
        "scenario_tree_benchmark_id",
        "expected_leaf_node_ids",
        "source_dataset_digest",
        "calibration_report_digest",
        "geography",
        "service_population",
        "service_class",
        "joint_event_definition",
        "data_version",
        "training_cutoff_seconds",
        "evaluation_window_start_seconds",
        "evaluation_window_end_seconds",
        "forecast_issue_time_seconds",
        "sample_count",
        "effective_sample_size_milli",
        "expert_panel_count",
        "elicitation_protocol_reference"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "benchmark_id": {
          "const": "MOBILITY-SERVICE-PROBABILITY-SET-001"
        },
        "probability_set_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "probability_basis": {
          "enum": [
            "synthetic",
            "historical_frequency_estimate",
            "forecast_model",
            "expert_elicitation",
            "stress_only",
            "unknown"
          ]
        },
        "probability_source_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "scenario_tree_revision": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "scenario_tree_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "scenario_tree_benchmark_id": {
          "const": "NONANTICIPATIVE-SERVICE-ORACLE-001"
        },
        "expected_leaf_node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "source_dataset_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration_report_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "geography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "service_population": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "service_class": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "joint_event_definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "data_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "training_cutoff_seconds": {
          "$ref": "#/$defs/nullableInteger"
        },
        "evaluation_window_start_seconds": {
          "$ref": "#/$defs/nullableInteger"
        },
        "evaluation_window_end_seconds": {
          "$ref": "#/$defs/nullableInteger"
        },
        "forecast_issue_time_seconds": {
          "$ref": "#/$defs/nullableInteger"
        },
        "sample_count": {
          "$ref": "#/$defs/nullableInteger"
        },
        "effective_sample_size_milli": {
          "$ref": "#/$defs/nullableInteger"
        },
        "expert_panel_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "elicitation_protocol_reference": {
          "$ref": "#/$defs/nullableString"
        },
        "scenario_tree_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    }
  }
}
