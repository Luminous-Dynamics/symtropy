{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EV carrier module manufacturing process catalog v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "configurations",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "EV-CARRIER-MODULE-MFG-001"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "configurations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "config_id",
          "architecture",
          "evidence_class",
          "evidence_reference",
          "modules_per_good_vehicle",
          "good_module_yield_fraction",
          "station_processes",
          "notes"
        ],
        "properties": {
          "config_id": {
            "type": "string",
            "minLength": 1
          },
          "architecture": {
            "enum": [
              "integrated_enclosed_bay",
              "detachable_drone_pod",
              "mobile_drone_station_trailer",
              "amr_cargo_handoff"
            ]
          },
          "evidence_class": {
            "enum": [
              "synthetic",
              "measured",
              "independent_test",
              "unknown"
            ]
          },
          "evidence_reference": {
            "type": "string",
            "minLength": 1
          },
          "modules_per_good_vehicle": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "good_module_yield_fraction": {
            "oneOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "station_processes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "process_id",
                "process_label",
                "cycle_minutes_per_attempt",
                "equipment_capex_usd_per_cell",
                "footprint_sqm_per_cell",
                "operators_per_cell_per_shift",
                "maximum_parallel_cells_available",
                "energy_kwh_per_attempt",
                "thermal_energy_kwh_per_attempt"
              ],
              "properties": {
                "process_id": {
                  "type": "string",
                  "minLength": 1
                },
                "process_label": {
                  "type": "string",
                  "minLength": 1
                },
                "cycle_minutes_per_attempt": {
                  "oneOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "equipment_capex_usd_per_cell": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "footprint_sqm_per_cell": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operators_per_cell_per_shift": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "energy_kwh_per_attempt": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "thermal_energy_kwh_per_attempt": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maximum_parallel_cells_available": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
