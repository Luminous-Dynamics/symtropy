{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/ev-passenger-cost-frontier/schemas/sustainable_mobility_service_capacity_v0_1.schema.json",
  "title": "Sustainable Mobility Service Capacity v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "horizon_seconds",
    "architectures",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "SUSTAINABLE-MOBILITY-SERVICE-CAPACITY-001"
    },
    "horizon_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/architecture"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_id",
        "description",
        "aircraft_count",
        "battery_pack_count",
        "initial_ready_spares",
        "max_stored_spares_per_aircraft",
        "mission_duration_seconds",
        "operational_turnaround_seconds",
        "charge_duration_seconds",
        "parallel_charging_channels",
        "charger_input_power_w",
        "site_grid_import_limit_w",
        "site_fixed_load_w"
      ],
      "properties": {
        "architecture_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "aircraft_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "battery_pack_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "initial_ready_spares": {
          "type": "integer",
          "minimum": 0,
          "maximum": 56
        },
        "max_stored_spares_per_aircraft": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "mission_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "operational_turnaround_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "charge_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "parallel_charging_channels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "charger_input_power_w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "site_grid_import_limit_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "site_fixed_load_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      }
    }
  }
}
