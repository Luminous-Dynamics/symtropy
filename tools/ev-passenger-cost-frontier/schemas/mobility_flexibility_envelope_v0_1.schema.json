{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/ev-passenger-cost-frontier/schemas/mobility_flexibility_envelope_v0_1.schema.json",
  "title": "Mobility Flexibility Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "site_id",
    "site_configuration_digest",
    "decision_time_unix_ms",
    "slot_duration_seconds",
    "horizon_slots",
    "site_evidence",
    "allocation_evidence",
    "charging_queue_evidence",
    "site_meter_evidence",
    "storage_resources",
    "reserve_scenarios",
    "pcc_slots",
    "candidate_dispatch",
    "export_permission",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "MOBILITY-FLEX-ENVELOPE-001"
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "site_configuration_digest": {
      "type": "string",
      "minLength": 1
    },
    "decision_time_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "slot_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "horizon_slots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "site_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "allocation_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "charging_queue_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "site_meter_evidence": {
      "$ref": "#/$defs/evidence"
    },
    "storage_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/storageResource"
      }
    },
    "reserve_scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/reserveScenario"
      }
    },
    "pcc_slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/pccSlot"
      }
    },
    "candidate_dispatch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/dispatchSlot"
      }
    },
    "export_permission": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/booleanEvidence"
        }
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "configuration_digest",
        "producer_id",
        "method_id",
        "evidence_reference",
        "evidence_class",
        "observed_at_unix_ms",
        "valid_from_unix_ms",
        "valid_until_unix_ms"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "synthetic",
            "measured",
            "independent_test",
            "unknown"
          ]
        },
        "observed_at_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "valid_from_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_unix_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "storageResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "configuration_digest",
        "resource_kind",
        "available_energy_lower_bound_wh",
        "max_discharge_power_lower_bound_w",
        "energy_evidence",
        "power_evidence",
        "interface_qualification_evidence",
        "availability_evidence",
        "site_connection_evidence"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "resource_kind": {
          "enum": [
            "stationary_ess",
            "qualified_bidirectional_storage",
            "aircraft_propulsion_pack"
          ]
        },
        "available_energy_lower_bound_wh": {
          "type": "integer",
          "minimum": 1
        },
        "max_discharge_power_lower_bound_w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "energy_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "power_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "interface_qualification_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "availability_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "site_connection_evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "resourceReserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "mission_reserve_receipt_id",
        "inventory_buffer_receipt_id",
        "safety_outage_reserve_receipt_id",
        "uncertainty_reserve_receipt_id",
        "mission_energy_reserve_wh",
        "inventory_buffer_energy_wh",
        "safety_outage_reserve_energy_wh",
        "uncertainty_energy_allowance_wh",
        "mission_power_reserve_w_by_slot",
        "inventory_buffer_power_w_by_slot",
        "safety_outage_power_reserve_w_by_slot",
        "uncertainty_power_allowance_w_by_slot"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_energy_reserve_wh": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_buffer_energy_wh": {
          "type": "integer",
          "minimum": 0
        },
        "safety_outage_reserve_energy_wh": {
          "type": "integer",
          "minimum": 0
        },
        "uncertainty_energy_allowance_wh": {
          "type": "integer",
          "minimum": 0
        },
        "mission_power_reserve_w_by_slot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "inventory_buffer_power_w_by_slot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "safety_outage_power_reserve_w_by_slot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "uncertainty_power_allowance_w_by_slot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "mission_reserve_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "inventory_buffer_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "safety_outage_reserve_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty_reserve_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_reserve_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "inventory_buffer_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "safety_outage_reserve_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "uncertainty_reserve_evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "reserveScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "evidence",
        "resource_reserves"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "resource_reserves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/resourceReserve"
          }
        }
      }
    },
    "pccSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "base_site_load_w",
        "scheduled_mobility_charging_load_w",
        "import_limit_w",
        "export_limit_w",
        "base_load_evidence",
        "scheduled_charging_load_evidence",
        "evidence"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "base_site_load_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "scheduled_mobility_charging_load_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "import_limit_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "export_limit_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "base_load_evidence": {
          "$ref": "#/$defs/evidence"
        },
        "scheduled_charging_load_evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "dispatchSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "requested_discharge_power_w"
      ],
      "properties": {
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "requested_discharge_power_w": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        }
      }
    },
    "booleanEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "value"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}
