{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/battery-service-network-v0.1.schema.json",
  "title": "Battery Service Network v0.1 input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "dispatch_epoch_id",
    "packs",
    "missions",
    "claim_ceiling",
    "dispatch_time_unix_ms"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "BATTERY-SERVICE-NETWORK-001"
    },
    "dispatch_epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/pack"
      }
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/mission"
      }
    },
    "dispatch_time_unix_ms": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "evidenceClass": {
      "type": "string",
      "enum": [
        "synthetic",
        "measured",
        "independent_test",
        "unknown"
      ]
    },
    "packState": {
      "type": "string",
      "enum": [
        "available",
        "installed",
        "reserved",
        "depleted",
        "charging",
        "cooling",
        "inspection",
        "quarantined",
        "in_transit",
        "retired",
        "unknown"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "value"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidenceEnvelope"
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000000
        }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "pack_temperature_c",
        "qualified_max_temperature_c"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidenceEnvelope"
        },
        "pack_temperature_c": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        },
        "qualified_max_temperature_c": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "configuration_id",
        "usable_energy",
        "peak_power",
        "thermal",
        "identity_verification",
        "custody_resolution",
        "post_test",
        "configuration_digest",
        "state_evidence"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "usable_energy": {
          "$ref": "#/$defs/metric"
        },
        "peak_power": {
          "$ref": "#/$defs/metric"
        },
        "thermal": {
          "$ref": "#/$defs/thermal"
        },
        "identity_verification": {
          "$ref": "#/$defs/booleanEvidence"
        },
        "custody_resolution": {
          "$ref": "#/$defs/booleanEvidence"
        },
        "post_test": {
          "$ref": "#/$defs/booleanEvidence"
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "state_evidence": {
          "$ref": "#/$defs/packStateEvidence"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "configuration_id",
        "required_energy_with_reserve_wh",
        "required_peak_power_w",
        "maximum_pack_temperature_c",
        "configuration_digest"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "required_energy_with_reserve_wh": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "required_peak_power_w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maximum_pack_temperature_c": {
          "type": "integer",
          "minimum": -100,
          "maximum": 250
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "booleanEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "value"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidenceEnvelope"
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "evidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "configuration_digest",
        "producer_id",
        "method_id",
        "evidence_reference",
        "evidence_class",
        "observed_at_unix_ms",
        "valid_from_unix_ms",
        "valid_until_unix_ms"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "producer_id": {
          "type": "string",
          "minLength": 1
        },
        "method_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "type": "string",
          "enum": [
            "synthetic",
            "measured",
            "independent_test",
            "unknown"
          ]
        },
        "observed_at_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "valid_from_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "valid_until_unix_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "packStateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "value"
      ],
      "properties": {
        "evidence": {
          "$ref": "#/$defs/evidenceEnvelope"
        },
        "value": {
          "$ref": "#/$defs/packState"
        }
      }
    }
  }
}
