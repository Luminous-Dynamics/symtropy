{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/battery-service-network-v0.1.schema.json",
  "title": "Battery Service Network v0.1 input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "dispatch_epoch_id",
    "packs",
    "missions",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "BATTERY-SERVICE-NETWORK-001"
    },
    "dispatch_epoch_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/pack"
      }
    },
    "missions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/mission"
      }
    }
  },
  "$defs": {
    "freshness": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ]
    },
    "evidenceClass": {
      "type": "string",
      "enum": [
        "synthetic",
        "measured",
        "independent_test",
        "unknown"
      ]
    },
    "packState": {
      "type": "string",
      "enum": [
        "available",
        "installed",
        "reserved",
        "depleted",
        "charging",
        "cooling",
        "inspection",
        "quarantined",
        "in_transit",
        "retired",
        "unknown"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "evidence_class",
        "evidence_reference",
        "value"
      ],
      "properties": {
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidenceClass"
        },
        "evidence_reference": {
          "type": "string"
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100000000
        }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "evidence_class",
        "evidence_reference",
        "pack_temperature_c",
        "qualified_max_temperature_c"
      ],
      "properties": {
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "evidence_class": {
          "$ref": "#/$defs/evidenceClass"
        },
        "evidence_reference": {
          "type": "string"
        },
        "pack_temperature_c": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        },
        "qualified_max_temperature_c": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -100,
          "maximum": 250
        }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pack_id",
        "configuration_id",
        "state",
        "identity_verified",
        "custody_resolved",
        "post_test_freshness",
        "post_test_passed",
        "post_test_evidence_reference",
        "usable_energy",
        "peak_power",
        "thermal"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/packState"
        },
        "identity_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "custody_resolved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "post_test_freshness": {
          "$ref": "#/$defs/freshness"
        },
        "post_test_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "post_test_evidence_reference": {
          "type": "string"
        },
        "usable_energy": {
          "$ref": "#/$defs/metric"
        },
        "peak_power": {
          "$ref": "#/$defs/metric"
        },
        "thermal": {
          "$ref": "#/$defs/thermal"
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "configuration_id",
        "required_energy_with_reserve_wh",
        "required_peak_power_w",
        "maximum_pack_temperature_c"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "required_energy_with_reserve_wh": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "required_peak_power_w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "maximum_pack_temperature_c": {
          "type": "integer",
          "minimum": -100,
          "maximum": 250
        }
      }
    }
  }
}
