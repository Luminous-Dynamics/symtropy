{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/ev-passenger-cost-frontier/schemas/nonanticipative_service_oracle_v0_1.schema.json",
  "title": "Nonanticipative Service Oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "horizon_seconds",
    "linked_service_input",
    "capacity_input",
    "observation_nodes",
    "scenarios",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "NONANTICIPATIVE-SERVICE-ORACLE-001"
    },
    "horizon_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "observation_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "linked_service_input": {
      "$ref": "./sustainable_mobility_service_quality_linked_v0_1.schema.json"
    },
    "capacity_input": {
      "$ref": "./sustainable_mobility_service_capacity_v0_1.schema.json"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_information_set_digest",
        "information_set_digest",
        "observation_digest",
        "decision_time_seconds",
        "revealed_request_ids",
        "available_opportunity_ids",
        "weather_state",
        "permission_state",
        "weather_evidence_digest",
        "permission_evidence_digest",
        "flight_window_id"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parent_information_set_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "information_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "decision_time_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "revealed_request_ids": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "available_opportunity_ids": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "weather_state": {
          "enum": [
            "go",
            "no_go",
            "unknown"
          ]
        },
        "permission_state": {
          "enum": [
            "approved",
            "denied",
            "unknown"
          ]
        },
        "weather_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "permission_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "flight_window_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "probability_units",
        "node_path"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "probability_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "node_path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
