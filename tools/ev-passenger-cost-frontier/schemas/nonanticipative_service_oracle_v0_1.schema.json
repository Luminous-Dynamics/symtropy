{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/ev-passenger-cost-frontier/schemas/nonanticipative_service_oracle_v0_1.schema.json",
  "title": "Nonanticipative Service Oracle v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "horizon_seconds",
    "requests",
    "opportunities",
    "observation_nodes",
    "scenarios",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "NONANTICIPATIVE-SERVICE-ORACLE-001"
    },
    "horizon_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/request"
      }
    },
    "opportunities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/opportunity"
      }
    },
    "observation_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "arrival_seconds",
        "accept_by_seconds",
        "deadline_seconds",
        "required_service_seconds",
        "payload_units",
        "allowed_mode"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "arrival_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "accept_by_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "required_service_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "payload_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "allowed_mode": {
          "enum": [
            "aerial_only",
            "fallback_only",
            "either"
          ]
        }
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "resource_id",
        "mode",
        "start_seconds",
        "max_service_duration_seconds",
        "turnaround_seconds",
        "max_payload_units"
      ],
      "properties": {
        "opportunity_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "aerial",
            "ground_courier",
            "locker",
            "amr"
          ]
        },
        "start_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_service_duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "turnaround_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "max_payload_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "parent_information_set_digest",
        "information_set_digest",
        "observation_digest",
        "decision_time_seconds",
        "revealed_request_ids",
        "available_opportunity_ids",
        "weather_state",
        "permission_state",
        "weather_evidence_digest",
        "permission_evidence_digest"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "parent_information_set_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "information_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "observation_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "decision_time_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "revealed_request_ids": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "available_opportunity_ids": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "weather_state": {
          "enum": [
            "go",
            "no_go",
            "unknown"
          ]
        },
        "permission_state": {
          "enum": [
            "approved",
            "denied",
            "unknown"
          ]
        },
        "weather_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        },
        "permission_evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]{64}$"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "probability_units",
        "node_path"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "probability_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "node_path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
