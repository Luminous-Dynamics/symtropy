{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EV carrier qualification matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "EV-CARRIER-QUALIFICATION-001"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "carrier_config_id",
          "base_design_id",
          "architecture",
          "configuration_digest_sha256",
          "module_process_config_id",
          "module_process_required",
          "gates",
          "notes"
        ],
        "properties": {
          "carrier_config_id": {
            "type": "string",
            "minLength": 1
          },
          "base_design_id": {
            "type": "string",
            "minLength": 1
          },
          "architecture": {
            "enum": [
              "truck_only",
              "integrated_enclosed_bay",
              "detachable_drone_pod",
              "mobile_drone_station_trailer",
              "amr_cargo_handoff"
            ]
          },
          "configuration_digest_sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "module_process_config_id": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "module_process_required": {
            "type": "boolean"
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requirement_id",
                "criticality",
                "required_evidence_class",
                "state",
                "evidence_class",
                "evidence_reference",
                "evidence_digest_sha256",
                "subject_configuration_digest_sha256"
              ],
              "properties": {
                "requirement_id": {
                  "type": "string",
                  "minLength": 1
                },
                "criticality": {
                  "enum": [
                    "safety_critical",
                    "regulatory",
                    "service",
                    "quality"
                  ]
                },
                "required_evidence_class": {
                  "enum": [
                    "measured",
                    "independent_test",
                    "external_authority"
                  ]
                },
                "state": {
                  "enum": [
                    "qualified",
                    "unknown",
                    "failed"
                  ]
                },
                "evidence_class": {
                  "enum": [
                    "synthetic",
                    "measured",
                    "independent_test",
                    "external_authority",
                    "unknown"
                  ]
                },
                "evidence_reference": {
                  "type": "string"
                },
                "evidence_digest_sha256": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "subject_configuration_digest_sha256": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Fa-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
