  "model_families": [
    {
      "model_id": "independent-equipment-faults",
      "mechanism": "Independent equipment downtimes",
      "structural_change": "Reference mechanism: machine outages are independent and rework feedback is represented by a calibrated-free fixed response."
    },
    {
      "model_id": "common-cause-outages",
      "mechanism": "Common-cause equipment outages",
      "structural_change": "Multiple stations can fail together due to shared utilities or control dependencies; independent-fault simplification is removed."
    },
    {
      "model_id": "bursty-repair-times",
      "mechanism": "Bursty and heavy-tailed repair duration",
      "structural_change": "Repair durations have a long-tailed regime rather than a low-variance approximation."
    },
    {
      "model_id": "finite-buffer-blocking",
      "mechanism": "Finite-buffer blocking propagation",
      "structural_change": "Downstream blocking and upstream starvation are explicit, so spare station capacity may be blocked."
    },
    {
      "model_id": "rework-feedback",
      "mechanism": "Rework re-enters constrained upstream process",
      "structural_change": "Failed quality checks re-enter an upstream queue and can amplify congestion rather than incurring only a fixed scrap penalty."
    },
    {
      "model_id": "supplier-product-mix-coupling",
      "mechanism": "Supplier disruption correlated with product mix",
      "structural_change": "Supplier starvation is coupled to variants/product mix rather than modelled as independent of line demand."
    }
  ],
