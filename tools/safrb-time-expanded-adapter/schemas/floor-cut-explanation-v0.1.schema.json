{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb/floor-cut-explanation-v0.1.schema.json",
  "title": "SAFRB Beneficiary Floor Infeasibility Cut Explanation v0.1",
  "description": "A verifier-reconstructed semantic attribution of the exact min-cut in a lower-bound circulation reduction. It explains constraints in the compiled model, not physical root cause.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_state",
    "schema_version",
    "case_id",
    "base_graph_sha256",
    "auxiliary_graph_sha256",
    "required_auxiliary_flow",
    "achieved_auxiliary_flow",
    "shortfall",
    "min_cut_capacity",
    "source_side_nodes",
    "cut_edges",
    "directly_referenced_service_ids",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "safrb-beneficiary-floor-cut-explanation-v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "base_graph_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "auxiliary_graph_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "required_auxiliary_flow": {
      "type": "integer",
      "minimum": 1
    },
    "achieved_auxiliary_flow": {
      "type": "integer",
      "minimum": 0
    },
    "shortfall": {
      "type": "integer",
      "minimum": 1
    },
    "min_cut_capacity": {
      "type": "integer",
      "minimum": 0
    },
    "source_side_nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "cut_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "auxiliary_edge_id",
          "from",
          "to",
          "capacity",
          "metadata_ref",
          "constraint_family",
          "original_edge_id",
          "node_id",
          "period",
          "related_service_ids"
        ],
        "properties": {
          "auxiliary_edge_id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "metadata_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "constraint_family": {
            "enum": [
              "beneficiary_request_ceiling_residual",
              "outbound_handling_capacity",
              "beneficiary_service_issue_capacity",
              "end_of_period_storage_carry_capacity",
              "route_capacity_and_transit",
              "receipt_availability_quantity",
              "opening_inventory_quantity",
              "lower_bound_positive_balance_demand",
              "lower_bound_negative_balance_discharge",
              "circulation_return_closure"
            ]
          },
          "original_edge_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "period": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "related_service_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "node_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "inventory",
              "handling",
              "service_issue",
              null
            ],
            "description": "Temporal state represented by the cut edge when it is tied to a specific physical node-period."
          }
        }
      }
    },
    "directly_referenced_service_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_ceiling": {
      "const": "Exact min-cut attribution in the declared synthetic lower-bound circulation graph only; not a physical root-cause diagnosis, unique intervention set, evidence-authenticity result, legal determination, dispatch authorization or actual service claim."
    }
  }
}
