{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb/dimacs-mcf-import-receipt-v0.1.schema.json",
  "title": "SAFRB DIMACS MCF Import Receipt v0.1",
  "description": "A strict receipt binding exact raw DIMACS MCF input bytes, canonical imported-network identity, parser version, import summaries and admission limits. It is not a feasibility or optimality certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_version",
    "format_version",
    "raw_sha256",
    "canonical_sha256",
    "node_count",
    "declared_arc_count",
    "nonzero_supply_record_count",
    "raw_input_bytes",
    "estimated_primary_allocation_bytes",
    "limits",
    "total_supply_decimal",
    "supply_total_is_zero",
    "negative_cost_arc_count",
    "negative_lower_bound_arc_count",
    "negative_upper_bound_arc_count",
    "nonzero_lower_bound_arc_count",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "dimacs-mcf-import-receipt-v0.1"
    },
    "parser_version": {
      "const": "luminous-dimacs-mcf-import-v0.1"
    },
    "format_version": {
      "const": "dimacs-mcf-v1"
    },
    "raw_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "node_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "declared_arc_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nonzero_supply_record_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "raw_input_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_primary_allocation_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_nodes",
        "max_arcs",
        "max_input_bytes",
        "max_working_bytes"
      ],
      "properties": {
        "max_nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "max_arcs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_working_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "total_supply_decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "supply_total_is_zero": {
      "type": "boolean"
    },
    "negative_cost_arc_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "negative_lower_bound_arc_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "negative_upper_bound_arc_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "nonzero_lower_bound_arc_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "claim_ceiling": {
      "const": "DIMACS MCF syntax, raw-file identity and canonical imported-network identity only; no instance feasibility, solver optimality, external source authority, physical model validity or service claim."
    }
  }
}
