{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb/capacity-schedule-report-v0.1.schema.json",
  "title": "SAFRB Admitted Capacity Schedule Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "scenario_id",
    "schedule_sha256",
    "windows",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "safrb-admitted-capacity-schedule-report-v0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "schedule_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "scenario_id",
          "subject_id",
          "role",
          "canonical_resource_ref",
          "effective_from_period",
          "effective_until_period_exclusive",
          "fresh_until_period_exclusive",
          "capacity",
          "unit_ref",
          "quantity_boundary_ref",
          "timebase_ref",
          "evidence_class",
          "admission_status",
          "issuer_ref",
          "authority_ref",
          "source_bytes_sha256",
          "admission_receipt_sha256"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "storage",
              "handling",
              "service_issue",
              "route"
            ]
          },
          "canonical_resource_ref": {
            "type": "string",
            "minLength": 1
          },
          "effective_from_period": {
            "type": "integer",
            "minimum": 0
          },
          "effective_until_period_exclusive": {
            "type": "integer",
            "minimum": 1
          },
          "fresh_until_period_exclusive": {
            "type": "integer",
            "minimum": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 0
          },
          "unit_ref": {
            "type": "string",
            "minLength": 1
          },
          "quantity_boundary_ref": {
            "type": "string",
            "minLength": 1
          },
          "timebase_ref": {
            "type": "string",
            "minLength": 1
          },
          "issuer_ref": {
            "type": "string",
            "minLength": 1
          },
          "authority_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_bytes_sha256": {
            "type": "string",
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          },
          "admission_receipt_sha256": {
            "type": "string",
            "pattern": "^sha256:[A-Fa-f0-9]{64}$"
          },
          "evidence_class": {
            "type": "string",
            "const": "conservative_operational_bound"
          },
          "admission_status": {
            "type": "string",
            "const": "admitted"
          }
        }
      }
    },
    "claim_ceiling": {
      "const": "Structural validation of externally pre-admitted, time-bounded capacity records only. This module does not verify source-byte authenticity, signatures, issuer authority, calibration, physical asset condition or scenario-set completeness. Same-role cross-subject aliases are rejected as unsupported; cross-role shared-asset coupling and shared-gate compilation are not modeled."
    }
  },
  "description": "A structural schedule receipt. Embedded admission receipt digests are references supplied by an upstream trust layer and are not cryptographically verified by this schema or module."
}
