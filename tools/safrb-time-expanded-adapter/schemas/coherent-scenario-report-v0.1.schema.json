{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb/coherent-scenario-report-v0.1.schema.json",
  "title": "SAFRB Coherent Scenario Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_set_id",
    "scenario_set_sha256",
    "outcomes",
    "minimum_scenario_maximum",
    "maximum_scenario_maximum",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "safrb-coherent-scenario-set-v0.1"
    },
    "scenario_set_id": {
      "type": "string",
      "minLength": 1
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "case_id",
          "graph_sha256",
          "maximum_requested_delivery",
          "certificate"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "graph_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "maximum_requested_delivery": {
            "type": "integer",
            "minimum": 0
          },
          "certificate": {
            "$ref": "../../single-commodity-flow-kernel/schemas/flow-certificate-v1.schema.json"
          }
        }
      }
    },
    "minimum_scenario_maximum": {
      "type": "integer",
      "minimum": 0
    },
    "maximum_scenario_maximum": {
      "type": "integer",
      "minimum": 0
    },
    "claim_ceiling": {
      "const": "Maximum aggregate requested delivery within each supplied coherent synthetic scenario only; no scenario-set completeness, evidence authority, probability, beneficiary-floor guarantee, physical qualification, dispatch authority or actual service claim."
    },
    "scenario_set_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Binds the scenario-set identifier, sorted scenario IDs and canonical temporal profiles."
    }
  },
  "description": "Per-scenario graph-bound receipts. Minimum/maximum are ranges of aggregate maxima, not a guaranteed or jointly committed beneficiary allocation."
}
