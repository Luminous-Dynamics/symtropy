{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-observation-identifiability-corpus-v0.1.json",
  "title": "Orbital observation-process identifiability corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "analytic_cases",
    "sensitivity_cases",
    "simulation_cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-observation-identifiability.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-thinned-plp-identifiability-only"
    },
    "analytic_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/analytic_case"
      }
    },
    "sensitivity_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sensitivity_case"
      }
    },
    "simulation_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/simulation_case"
      }
    }
  },
  "$defs": {
    "plp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eta",
        "beta"
      ],
      "properties": {
        "eta": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beta": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0",
        "gamma"
      ],
      "properties": {
        "p0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "gamma": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eta_observed",
        "beta_observed"
      ],
      "properties": {
        "eta_observed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "beta_observed": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "analytic_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "physical",
        "capture",
        "exposure_horizon",
        "decomposition_gammas",
        "decomposition_p0",
        "expected_observed",
        "expected_equivalent_physical_betas"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "physical": {
          "$ref": "#/$defs/plp"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "exposure_horizon": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "decomposition_gammas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "decomposition_p0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "expected_observed": {
          "$ref": "#/$defs/observed"
        },
        "expected_equivalent_physical_betas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "sensitivity_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "beta_observed",
        "gamma_min",
        "gamma_max",
        "expected_beta_min",
        "expected_beta_max",
        "expected_lower_open",
        "expected_identifiable"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "beta_observed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "gamma_min": {
          "type": "number",
          "minimum": 0
        },
        "gamma_max": {
          "type": "number",
          "minimum": 0
        },
        "expected_beta_min": {
          "type": "number",
          "minimum": 0
        },
        "expected_beta_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expected_lower_open": {
          "type": "boolean"
        },
        "expected_identifiable": {
          "type": "boolean"
        }
      }
    },
    "simulation_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "physical_beta",
        "capture_p0",
        "capture_gamma",
        "physical_event_count",
        "exposure_horizon",
        "physical_seed",
        "capture_seed",
        "maximum_beta_error"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "physical_beta": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capture_p0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "capture_gamma": {
          "type": "number",
          "minimum": 0
        },
        "physical_event_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "exposure_horizon": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "physical_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capture_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum_beta_error": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
