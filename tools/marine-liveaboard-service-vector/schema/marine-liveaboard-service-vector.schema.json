{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-liveaboard-service-vector:0.1.0",
  "title": "Marine Liveaboard Non-Compensatory Mission Service Vector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_id",
    "record_status",
    "claim_ceiling",
    "mission_snapshot",
    "service_floor_contract",
    "comparison",
    "policies"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scorecard_id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "synthetic",
        "shadow_replay",
        "measured_campaign",
        "published_reproduction"
      ]
    },
    "claim_ceiling": {
      "const": "non_compensatory_service_vector_comparison_only"
    },
    "mission_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "mission_snapshot_sha256",
        "craft_configuration_sha256",
        "occupancy_sha256",
        "initial_resource_state_sha256",
        "mission_plan_sha256",
        "forecast_information_set_sha256",
        "hard_gate_roster_sha256",
        "operating_envelope_sha256",
        "service_floor_contract_sha256"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "mission_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "craft_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "occupancy_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "initial_resource_state_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "mission_plan_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "forecast_information_set_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "hard_gate_roster_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "operating_envelope_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "service_floor_contract_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "service_floor_contract": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "unit",
          "operator",
          "floor_value",
          "minimum_coverage_fraction"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "gte",
              "lte"
            ]
          },
          "floor_value": {
            "type": "number"
          },
          "minimum_coverage_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_policy_id",
        "candidate_policy_id"
      ],
      "properties": {
        "baseline_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_policy_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "role",
          "forecast_use",
          "mission_snapshot_sha256",
          "decision_output_sha256",
          "operating_envelope_sha256",
          "hard_gate_disposition",
          "hard_gate_violations",
          "soft_constraint_relaxations",
          "resource_metrics"
        ],
        "properties": {
          "policy_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "weather_blind_reference",
              "weather_informed_resource_blind",
              "integrated_candidate",
              "authorized_soft_relaxation"
            ]
          },
          "forecast_use": {
            "type": "boolean"
          },
          "mission_snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "decision_output_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "operating_envelope_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "hard_gate_disposition": {
            "enum": [
              "pass",
              "fail",
              "infeasible",
              "abstain"
            ]
          },
          "hard_gate_violations": {
            "type": "integer",
            "minimum": 0
          },
          "soft_constraint_relaxations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "constraint_class",
                "constraint_id",
                "prior_limit",
                "new_limit",
                "unit",
                "authority_receipt_ref",
                "authority_receipt_sha256",
                "new_operating_envelope_sha256"
              ],
              "properties": {
                "constraint_class": {
                  "const": "soft"
                },
                "constraint_id": {
                  "type": "string",
                  "minLength": 1
                },
                "prior_limit": {
                  "type": "number"
                },
                "new_limit": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "authority_receipt_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "authority_receipt_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "new_operating_envelope_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          },
          "resource_metrics": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "unit",
                "value",
                "coverage_fraction",
                "evidence_sha256",
                "lower_bound",
                "upper_bound",
                "measurement_window_start",
                "measurement_window_end",
                "measurement_method",
                "measurement_class"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "coverage_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "lower_bound": {
                  "type": "number"
                },
                "upper_bound": {
                  "type": "number"
                },
                "measurement_window_start": {
                  "type": "string",
                  "format": "date-time"
                },
                "measurement_window_end": {
                  "type": "string",
                  "format": "date-time"
                },
                "measurement_method": {
                  "type": "string",
                  "minLength": 1
                },
                "measurement_class": {
                  "enum": [
                    "measured",
                    "modeled",
                    "derived",
                    "synthetic"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
