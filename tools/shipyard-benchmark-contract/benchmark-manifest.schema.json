{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shipyard benchmark manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "title",
    "claim_class",
    "scope",
    "source",
    "protocol",
    "candidate",
    "baselines",
    "oracle",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "shipyard-benchmark-manifest/v0"
    },
    "benchmark_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim_class": {
      "enum": [
        "semantic-correctness",
        "algorithmic-quality",
        "operational-performance",
        "industrial-validation"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models",
        "supported_constraints",
        "unsupported_constraints"
      ],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "rectangular-space-time",
              "spatial-transfers",
              "unary-resources",
              "execution-replay",
              "irregular-polygons",
              "multi-crane-physics"
            ]
          }
        },
        "supported_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "generated",
            "published",
            "permissioned-industrial",
            "hand-authored"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "license_or_access_basis": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "seed",
        "parameters_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "parameters_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_class",
        "wall_clock_budget_ms",
        "candidate_evaluation_budget",
        "repetitions",
        "warmup_runs",
        "random_seed",
        "timeout_policy"
      ],
      "properties": {
        "hardware_class": {
          "type": "string",
          "minLength": 1
        },
        "wall_clock_budget_ms": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_evaluation_budget": {
          "type": "integer",
          "minimum": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_policy": {
          "enum": [
            "count-as-no-solution",
            "censored-runtime",
            "invalidate-run"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "revision",
        "config_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40,64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "baselines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "revision",
          "config_sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{40,64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "implementation_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact-enumeration",
            "independent-verifier",
            "published-reference",
            "industrial-execution-trace",
            "none"
          ]
        },
        "implementation_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "false_feasible_count",
          "false_infeasible_count",
          "feasible_cases_found",
          "feasible_case_recall",
          "area_time_utilization",
          "vehicle_travel_time",
          "makespan",
          "tardiness",
          "recovery_horizon",
          "unaffected_plan_churn",
          "reservation_changes",
          "rehandles",
          "objective_regret",
          "runtime_ms",
          "peak_memory_bytes",
          "timeout_count",
          "bound_gap",
          "start_deviation_ticks",
          "completion_deviation_ticks",
          "missing_observation_count"
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "kind": {
                "const": "generated"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "required": [
          "generator"
        ]
      }
    }
  ]
}
