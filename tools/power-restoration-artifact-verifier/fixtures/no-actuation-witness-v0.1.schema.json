{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/power-restoration-no-actuation-witness-v0.1.schema.json",
  "title":"Power restoration no-actuation witness receipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","witnessId","issuerId","controllerId","deviceId","runId","caseSha256","decisionStep","proposalSha256","actionId","actionKind","commandId","commandSha256","challengeNonce","monotonicSequence","rejectionBoundary","actuationAcquired","queueDispatched","driverAcquired","outputTransitionObserved","hardwareFeedback","observedAtUnixMs","expiresAtUnixMs","toolSourceCommit","toolConfigurationSha256"],
  "properties":{
    "schemaVersion":{"const":"0.1.0"},
    "witnessId":{"type":"string","minLength":1},
    "issuerId":{"type":"string","minLength":1},
    "controllerId":{"type":"string","minLength":1},
    "deviceId":{"type":"string","minLength":1},
    "runId":{"type":"string","minLength":1},
    "caseSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decisionStep":{"type":"integer","minimum":0},
    "proposalSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "actionId":{"type":"string","minLength":1},
    "actionKind":{"type":"string","minLength":1},
    "commandId":{"type":"string","minLength":1},
    "commandSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "challengeNonce":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "monotonicSequence":{"type":"integer","minimum":1},
    "rejectionBoundary":{"const":"before_actuation"},
    "actuationAcquired":{"const":false},
    "queueDispatched":{"const":false},
    "driverAcquired":{"const":false},
    "outputTransitionObserved":{"const":false},
    "hardwareFeedback":{"enum":["unavailable","no_movement_observed"]},
    "observedAtUnixMs":{"type":"integer","minimum":0},
    "expiresAtUnixMs":{"type":"integer","minimum":1},
    "toolSourceCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "toolConfigurationSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
