{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/rural-industrial-electrification-evaluator/schemas/vehicle_verification_matrix_v0_1.schema.json",
  "title": "EV verification matrix v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "programme_id", "claim_ceiling", "evidence_classes", "release_rule", "design_count", "gates_per_design", "designs", "cross_class_invariants"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "programme_id": { "const": "EV-VALIDATION-001" },
    "claim_ceiling": { "type": "string", "minLength": 1 },
    "evidence_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["synthetic", "estimate", "literature", "manufacturer", "measured", "independent_review"] }
    },
    "release_rule": { "type": "string", "minLength": 1 },
    "design_count": { "const": 19 },
    "gates_per_design": { "const": 5 },
    "designs": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": { "$ref": "#/$defs/design" }
    },
    "cross_class_invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/invariant" }
    }
  },
  "$defs": {
    "textList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "stage", "release_blocking", "acceptance_rule", "measurement_set", "failure_injection", "result_class", "test_id", "mission_specific_scope", "evidence_class_required", "evidence_required"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "release_blocking": { "const": true },
        "acceptance_rule": { "type": "string", "minLength": 1 },
        "measurement_set": { "$ref": "#/$defs/textList" },
        "failure_injection": { "type": "string", "minLength": 1 },
        "result_class": { "enum": ["hard_gate", "safety_gate", "evidence_gate"] },
        "test_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "mission_specific_scope": { "type": "string", "minLength": 1 },
        "functional_unit": { "type": "string", "minLength": 1 },
        "evidence_class_required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["synthetic", "estimate", "literature", "manufacturer", "measured", "independent_review"] }
        },
        "evidence_required": { "type": "string", "minLength": 1 }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_id", "label", "platform_family_id", "functional_unit", "verification_gates"],
      "properties": {
        "design_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "platform_family_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "functional_unit": { "type": "string", "minLength": 1 },
        "verification_gates": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/gate" }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "target", "type"],
      "properties": {
        "invariant_id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 }
      }
    }
  }
}
