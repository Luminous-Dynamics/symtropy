{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/power-restoration-risk-metrics-input-v0.1.schema.json",
  "title":"Power restoration risk metrics input v0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["batchId","cohort","policy","aggregationPolicy","episodes","actions"],
  "properties":{
    "batchId":{"type":"string","minLength":1},
    "cohort":{"$ref":"#/$defs/cohort"},
    "policy":{"$ref":"#/$defs/policy"},
    "aggregationPolicy":{
      "type":"object","additionalProperties":false,
      "required":["unscoredEpisodePolicy","worstCaseRegret"],
      "properties":{
        "unscoredEpisodePolicy":{"enum":["strict_complete","conservative_worst_case"]},
        "worstCaseRegret":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "episodes":{
      "type":"array","minItems":1,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["episodeId","caseId","cohort","policy","seed","disposition","normalizedRegret","episodeArtifact","operational"],
        "properties":{
          "episodeId":{"type":"string","minLength":1},
          "caseId":{"type":"string","minLength":1},
          "cohort":{"$ref":"#/$defs/cohort"},
          "policy":{"$ref":"#/$defs/policy"},
          "seed":{"type":"integer","minimum":0},
          "disposition":{"enum":["completed","incomplete","timed_out","abstained","malformed","infrastructure_failed"]},
          "normalizedRegret":{"type":["number","null"],"minimum":0,"maximum":1},
          "episodeArtifact":{"$ref":"#/$defs/artifact"},
          "operational":{
            "type":"object","additionalProperties":false,
            "required":["elapsedMs","tokenCount","apiCostUsd","solverCalls","solverWallTimeMs","observationRequests","peakMemoryBytes"],
            "properties":{
              "elapsedMs":{"type":["integer","null"],"minimum":0},
              "tokenCount":{"type":["integer","null"],"minimum":0},
              "apiCostUsd":{"type":["number","null"],"minimum":0},
              "solverCalls":{"type":["integer","null"],"minimum":0},
              "solverWallTimeMs":{"type":["integer","null"],"minimum":0},
              "observationRequests":{"type":["integer","null"],"minimum":0},
              "peakMemoryBytes":{"type":["integer","null"],"minimum":0}
            }
          }
        }
      }
    },
    "actions":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["episodeId","actionId","commandId","disposition","adjudication","unknownReason","evidenceArtifact","adjudicatorId","adjudicatorScope","adjudicatorProfileSha256","independentOfPolicyAndGuard"],
        "properties":{
          "episodeId":{"type":"string","minLength":1},
          "actionId":{"type":"string","minLength":1},
          "commandId":{"type":["string","null"],"minLength":1},
          "disposition":{"enum":["executed","guard_rejected","abstained","not_attempted"]},
          "adjudication":{"enum":["safe","unsafe","unknown"]},
          "unknownReason":{"type":["string","null"],"minLength":1},
          "evidenceArtifact":{"$ref":"#/$defs/artifact"},
          "adjudicatorId":{"type":"string","minLength":1},
          "adjudicatorScope":{"type":"string","minLength":1},
          "adjudicatorProfileSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "independentOfPolicyAndGuard":{"const":true}
        }
      }
    }
  },
  "$defs":{
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["artifactUri","sha256"],
      "properties":{
        "artifactUri":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    },
    "cohort":{
      "type":"object","additionalProperties":false,
      "required":["benchmarkSuiteId","benchmarkRevision","datasetSha256","physicalScope","objectiveId","objectiveUnit","horizonSeconds","topologySplitId","topologyHoldoutPolicy","hardwareProfileId","wallClockBudgetMs","maxDecisionSteps"],
      "properties":{
        "benchmarkSuiteId":{"type":"string","minLength":1},
        "benchmarkRevision":{"type":"string","minLength":1},
        "datasetSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "physicalScope":{"enum":["topology_only","balanced_ac","unbalanced_three_phase_ac","protection_qualified","hardware_in_the_loop","commissioning"]},
        "objectiveId":{"type":"string","minLength":1},
        "objectiveUnit":{"type":"string","minLength":1},
        "horizonSeconds":{"type":"integer","minimum":1},
        "topologySplitId":{"type":"string","minLength":1},
        "topologyHoldoutPolicy":{"type":"string","minLength":1},
        "hardwareProfileId":{"type":"string","minLength":1},
        "wallClockBudgetMs":{"type":"integer","minimum":1},
        "maxDecisionSteps":{"type":"integer","minimum":1}
      }
    },
    "policy":{
      "type":"object","additionalProperties":false,
      "required":["policyId","policyBuildSha256","configurationSha256","modelOrSolverRevision"],
      "properties":{
        "policyId":{"type":"string","minLength":1},
        "policyBuildSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "configurationSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "modelOrSolverRevision":{"type":"string","minLength":1}
      }
    }
  }
}
