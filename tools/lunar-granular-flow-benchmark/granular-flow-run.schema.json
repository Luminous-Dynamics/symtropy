    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver_family",
        "model_name",
        "model_version",
        "source_revision",
        "executable_sha256",
        "configuration_artifact_id",
        "parameters_artifact_id",
        "random_seed",
        "run_status",
        "predictions"
      ],
      "properties": {
        "solver_family": {
          "enum": [
            "force_balance",
            "dem",
            "continuum",
            "physics_informed_residual",
            "ml_surrogate",
            "other"
          ]
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "configuration_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "parameters_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "random_seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "run_status": {
          "enum": [
            "converged",
            "failed",
            "not_run",
            "not_applicable"
          ]
        },
        "predictions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/predictionInterval"
          }
        }
      }
    },
    "predictionInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimate",
        "lower",
        "upper",
        "unit",
        "nominal_coverage"
      ],
      "properties": {
        "estimate": {
          "type": "number"
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "nominal_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "role",
        "path",
        "media_type",
        "sha256"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "raw_video",
