        },
        "residual_mass_kg": {
          "$ref": "#/$defs/measurement"
        },
        "dust_and_fines_mass_kg": {
          "$ref": "#/$defs/measurement"
        },
        "energy_input_j": {
          "$ref": "#/$defs/measurement"
        },
