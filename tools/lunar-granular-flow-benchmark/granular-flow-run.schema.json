{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:symtropy:lunar-granular-flow-run:0.1.0",
  "title": "Lunar Granular Flow and Material Transfer Run",
  "description": "Evidence-scoped record for rotating-drum, hopper, chute, conveyor and beneficiation flow tests. Schema conformance is necessary but not sufficient for physical admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "recorded_at",
    "source_class",
    "partition",
    "group_keys",
    "material",
    "environment",
    "apparatus",
    "operation",
    "observations",
    "model",
    "artifacts",
    "derived_coordinates"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "benchmark_id": {
      "const": "lunar-granular-flow-validation-v0"
    },
    "run_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_class": {
      "enum": [
        "physical_analogue_measurement",
        "published_measurement",
        "simulation",
        "synthetic_fixture"
      ]
    },
    "partition": {
      "enum": [
        "calibration",
        "validation",
        "blind_test"
      ]
    },
    "group_keys": {
      "$ref": "#/$defs/groupKeys"
    },
    "material": {
      "$ref": "#/$defs/material"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "apparatus": {
      "$ref": "#/$defs/apparatus"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "source_citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "derived_coordinates": {
      "$ref": "#/$defs/derivedCoordinates"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "standard_uncertainty",
        "unit",
        "status",
        "source_artifact_id",
        "calibration_record_id"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "standard_uncertainty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "measured",
            "published",
            "estimated",
            "synthetic",
            "unknown",
            "derived"
          ]
        },
        "source_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "calibration_record_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "derivation_method_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "calculation_version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "standard_uncertainty": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "number"
              },
              "standard_uncertainty": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "groupKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_batch_id",
        "preparation_protocol_id",
        "wall_surface_id",
        "apparatus_geometry_id",
        "environment_profile_id",
        "operating_regime_id"
      ],
      "properties": {
        "material_batch_id": {
          "type": "string",
          "minLength": 1
        },
        "preparation_protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "wall_surface_id": {
          "type": "string",
          "minLength": 1
        },
        "apparatus_geometry_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "operating_regime_id": {
          "type": "string",
          "minLength": 1
        },
        "laboratory_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "campaign_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_family",
        "material_name",
        "batch_id",
        "preparation_protocol_id",
        "particle_size_distribution_artifact_id",
        "d10_um",
        "d50_um",
        "d60_um",
        "d90_um",
        "bulk_density_kg_m3",
        "particle_morphology",
        "compaction_history_id",
        "representative_particle_mass_kg",
        "mean_interparticle_cohesion_force_n",
        "initial_charge_mass_kg"
      ],
      "properties": {
        "material_family": {
          "enum": [
            "returned_lunar_regolith",
            "lunar_regolith_simulant",
            "terrestrial_analogue",
            "other"
          ]
        },
        "material_name": {
          "type": "string",
          "minLength": 1
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "preparation_protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "particle_size_distribution_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "d10_um": {
          "$ref": "#/$defs/measurement"
        },
        "d50_um": {
          "$ref": "#/$defs/measurement"
        },
        "d60_um": {
          "$ref": "#/$defs/measurement"
        },
        "d90_um": {
          "$ref": "#/$defs/measurement"
        },
        "bulk_density_kg_m3": {
          "$ref": "#/$defs/measurement"
        },
        "cohesion_pa": {
          "$ref": "#/$defs/measurement"
        },
        "water_or_volatile_mass_fraction": {
          "$ref": "#/$defs/measurement"
        },
        "surface_charge_coulomb_per_kg": {
          "$ref": "#/$defs/measurement"
        },
        "particle_morphology": {
          "type": "string",
          "minLength": 1
        },
        "particle_shape_artifact_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "compaction_history_id": {
          "type": "string",
          "minLength": 1
        },
        "conditioning_protocol_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "representative_particle_mass_kg": {
          "$ref": "#/$defs/measurement"
        },
        "mean_interparticle_cohesion_force_n": {
          "$ref": "#/$defs/measurement"
        },
        "initial_charge_mass_kg": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gravity_m_s2",
        "chamber_pressure_pa",
        "temperature_k",
        "pressure_profile_id",
        "atmosphere",
        "electrostatic_field_v_m",
        "surface_potential_v"
      ],
      "properties": {
        "gravity_m_s2": {
          "$ref": "#/$defs/measurement"
        },
        "chamber_pressure_pa": {
          "$ref": "#/$defs/measurement"
        },
        "temperature_k": {
          "$ref": "#/$defs/measurement"
        },
        "pressure_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "atmosphere": {
          "enum": [
            "air",
            "high_vacuum",
            "inert_gas",
            "other",
            "unknown"
          ]
        },
        "humidity_relative_percent": {
          "$ref": "#/$defs/measurement"
        },
        "electrostatic_grounding_state": {
          "enum": [
            "grounded",
            "floating",
            "controlled_bias",
            "unknown"
          ]
        },
        "environment_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "electrostatic_field_v_m": {
          "$ref": "#/$defs/measurement"
        },
        "surface_potential_v": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "apparatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apparatus_type",
        "geometry_id",
        "geometry_artifact_id",
        "wall_surface_id",
        "wall_material",
        "wall_roughness_ra_um",
        "wall_conductivity_s_m",
        "wall_grounding",
        "fill_fraction",
        "wall_pull_off_force_n",
        "wall_surface_energy_j_m2",
        "wall_contact_angle_deg"
      ],
      "properties": {
        "apparatus_type": {
          "enum": [
            "rotating_drum",
            "fixed_funnel",
            "hopper",
            "chute",
            "conveyor",
            "sieve",
            "transfer_system",
            "other"
          ]
        },
        "geometry_id": {
          "type": "string",
          "minLength": 1
        },
        "geometry_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "drum_inner_radius_m": {
          "$ref": "#/$defs/measurement"
        },
        "outlet_width_m": {
          "$ref": "#/$defs/measurement"
        },
        "hopper_wall_angle_deg": {
          "$ref": "#/$defs/measurement"
        },
        "chute_inclination_deg": {
          "$ref": "#/$defs/measurement"
        },
        "wall_surface_id": {
          "type": "string",
          "minLength": 1
        },
        "wall_material": {
          "type": "string",
          "minLength": 1
        },
        "wall_roughness_ra_um": {
          "$ref": "#/$defs/measurement"
        },
        "wall_conductivity_s_m": {
          "$ref": "#/$defs/measurement"
        },
        "wall_grounding": {
          "enum": [
            "grounded",
            "floating",
            "controlled_bias",
            "unknown"
          ]
        },
        "wall_coating": {
          "type": [
            "string",
            "null"
          ]
        },
        "fill_fraction": {
          "$ref": "#/$defs/measurement"
        },
        "wall_pull_off_force_n": {
          "$ref": "#/$defs/measurement"
        },
        "wall_surface_energy_j_m2": {
          "$ref": "#/$defs/measurement"
        },
        "wall_contact_angle_deg": {
          "$ref": "#/$defs/measurement"
        },
        "feeder_type": {
          "enum": [
            "rotary_pocket",
            "screw",
            "vibratory_trough",
            "gravity_only",
            "other"
          ]
        },
        "feeder_geometry_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "pocket_volume_m3": {
          "$ref": "#/$defs/measurement"
        },
        "feeder_rotational_speed_rpm": {
          "$ref": "#/$defs/measurement"
        },
        "hopper_outlet_diameter_m": {
          "$ref": "#/$defs/measurement"
        },
        "hopper_column_height_m": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_mount_profile_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_type",
        "flow_regime",
        "protocol_id",
        "duration_s",
        "speed_rpm",
        "angular_velocity_rad_s",
        "target_froude_number",
        "actual_froude_number",
        "vibration_frequency_hz",
        "vibration_amplitude_m",
        "vibration_enabled",
        "vibration_profile_id"
      ],
      "properties": {
        "operation_type": {
          "enum": [
            "rotating_drum",
            "funnel_discharge",
            "hopper_discharge",
            "chute_transfer",
            "conveyor_transfer",
            "screening",
            "beneficiation",
            "integrated_chain"
          ]
        },
        "flow_regime": {
          "enum": [
            "slumping",
            "rolling",
            "cascading",
            "cataracting",
            "continuous_discharge",
            "intermittent_discharge",
            "bridging",
            "unknown",
            "funnel_flow",
            "mass_flow",
            "asymmetric_flow",
            "ratholing"
          ]
        },
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "$ref": "#/$defs/measurement"
        },
        "speed_rpm": {
          "$ref": "#/$defs/measurement"
        },
        "angular_velocity_rad_s": {
          "$ref": "#/$defs/measurement"
        },
        "target_froude_number": {
          "$ref": "#/$defs/measurement"
        },
        "actual_froude_number": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_frequency_hz": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_amplitude_m": {
          "$ref": "#/$defs/measurement"
        },
        "start_stop_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "wear_state": {
          "enum": [
            "new",
            "run_in",
            "worn",
            "reconditioned",
            "unknown"
          ]
        },
        "feeder_setpoint_rpm": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_enabled": {
          "type": "boolean"
        },
        "vibration_peak_acceleration_m_s2": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_gamma": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_displacement_peak_m": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_displacement_peak_to_peak_m": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_phase_rad": {
          "$ref": "#/$defs/measurement"
        },
        "vibration_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "shear_rate_s_minus_1": {
          "$ref": "#/$defs/measurement"
        },
        "normal_confining_stress_pa": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_observation_artifact_id",
        "static_angle_of_repose_deg",
        "dynamic_angle_of_repose_deg",
        "angle_stability_cv",
        "avalanche_count",
        "discharge_mass_rate_kg_s",
        "input_mass_kg",
        "delivered_mass_kg",
        "residual_mass_kg",
        "dust_and_fines_mass_kg",
        "energy_input_j",
        "accepted_target_size_mass_kg",
        "flow_continuity_status",
        "flow_interruption_count",
        "mass_flow_rate_cv",
        "vibration_energy_j",
        "agglomerate_fragmentation_fraction",
        "flow_regime_classification",
        "flow_regime_confidence",
