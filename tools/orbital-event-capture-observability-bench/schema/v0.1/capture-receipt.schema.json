{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-event-capture-receipt-v0.1.json",
  "title": "Orbital event-capture observability receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema",
    "source_commit",
    "fixture_sha256",
    "result",
    "report",
    "fit_acceptance_granted",
    "reliability_claim_granted",
    "physical_completeness_claim_granted",
    "authority_granted"
  ],
  "properties": {
    "receipt_schema": {
      "const": "luminous.orbital-event-capture.receipt.v0.1"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "evidence_class",
        "claim_ceiling",
        "fit_acceptance_granted",
        "reliability_claim_granted",
        "physical_completeness_claim_granted",
        "authority_granted",
        "summary",
        "cases"
      ],
      "properties": {
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "evidence_class": {
          "const": "synthetic"
        },
        "claim_ceiling": {
          "const": "synthetic-capture-reconciliation-only"
        },
        "fit_acceptance_granted": {
          "const": false
        },
        "reliability_claim_granted": {
          "const": false
        },
        "physical_completeness_claim_granted": {
          "const": false
        },
        "authority_granted": {
          "const": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_count",
            "reconciled_fixture_only",
            "incomplete",
            "indeterminate",
            "out_of_envelope",
            "rejected",
            "disputed",
            "expected_result_mismatches",
            "missing_events",
            "duplicate_events",
            "unexpected_events",
            "loss_counter_cases",
            "fit_acceptances",
            "reliability_claims",
            "physical_completeness_claims",
            "authority_grants"
          ],
          "properties": {
            "case_count": {
              "type": "integer",
              "minimum": 0
            },
            "reconciled_fixture_only": {
              "type": "integer",
              "minimum": 0
            },
            "incomplete": {
              "type": "integer",
              "minimum": 0
            },
            "indeterminate": {
              "type": "integer",
              "minimum": 0
            },
            "out_of_envelope": {
              "type": "integer",
              "minimum": 0
            },
            "rejected": {
              "type": "integer",
              "minimum": 0
            },
            "disputed": {
              "type": "integer",
              "minimum": 0
            },
            "expected_result_mismatches": {
              "type": "integer",
              "minimum": 0
            },
            "missing_events": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_events": {
              "type": "integer",
              "minimum": 0
            },
            "unexpected_events": {
              "type": "integer",
              "minimum": 0
            },
            "loss_counter_cases": {
              "type": "integer",
              "minimum": 0
            },
            "fit_acceptances": {
              "type": "integer",
              "minimum": 0
            },
            "reliability_claims": {
              "type": "integer",
              "minimum": 0
            },
            "physical_completeness_claims": {
              "type": "integer",
              "minimum": 0
            },
            "authority_grants": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_id",
              "declared_evidence_bindings",
              "disposition",
              "injected_count",
              "captured_count",
              "missed_count",
              "duplicate_count",
              "unexpected_count",
              "upper_miss_probability_95",
              "loss_counters_nonzero",
              "fit_acceptance_granted",
              "reliability_claim_granted",
              "physical_completeness_claim_granted",
              "authority_granted",
              "expected_result_matched",
              "blockers"
            ],
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "declared_evidence_bindings": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "qualified_scope",
                  "test_scope",
                  "test_window_seconds",
                  "minimum_event_rate_per_second",
                  "maximum_event_rate_per_second",
                  "reference_event_count",
                  "derived_reference_event_rate_per_second",
                  "reference",
                  "counters",
                  "calibration",
                  "clock"
                ],
                "properties": {
                  "qualified_scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sensor_id",
                      "firmware_sha256",
                      "acquisition_config_sha256",
                      "event_class",
                      "operating_mode_id",
                      "environment_id"
                    ],
                    "properties": {
                      "sensor_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "firmware_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "acquisition_config_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "event_class": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operating_mode_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "environment_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "test_scope": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sensor_id",
                      "firmware_sha256",
                      "acquisition_config_sha256",
                      "event_class",
                      "operating_mode_id",
                      "environment_id"
                    ],
                    "properties": {
                      "sensor_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "firmware_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "acquisition_config_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "event_class": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operating_mode_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "environment_id": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "test_window_seconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minimum_event_rate_per_second": {
                    "type": "number",
                    "minimum": 0
                  },
                  "maximum_event_rate_per_second": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000000
                  },
                  "reference_event_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "derived_reference_event_rate_per_second": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "reference": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "available",
                      "system_id",
                      "reference_artifact_sha256",
                      "failure_domains",
                      "acquisition_failure_domains"
                    ],
                    "properties": {
                      "available": {
                        "type": "boolean"
                      },
                      "system_id": {
                        "type": "string"
                      },
                      "reference_artifact_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "failure_domains": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "acquisition_failure_domains": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "counters": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "overflow_count",
                      "dropped_event_count",
                      "dropped_packet_count",
                      "reset_count",
                      "sequence_gap_count",
                      "counter_artifact_sha256"
                    ],
                    "properties": {
                      "overflow_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "dropped_event_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "dropped_packet_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "reset_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "sequence_gap_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "counter_artifact_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "calibration": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "valid_at_test_time",
                      "scope_matches",
                      "certificate_sha256"
                    ],
                    "properties": {
                      "valid_at_test_time": {
                        "type": "boolean"
                      },
                      "scope_matches": {
                        "type": "boolean"
                      },
                      "certificate_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  },
                  "clock": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "synchronized",
                      "monotonic",
                      "measured_max_error_ticks",
                      "allowed_max_error_ticks",
                      "synchronization_artifact_sha256"
                    ],
                    "properties": {
                      "synchronized": {
                        "type": "boolean"
                      },
                      "monotonic": {
                        "type": "boolean"
                      },
                      "measured_max_error_ticks": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "allowed_max_error_ticks": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "synchronization_artifact_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              },
              "disposition": {
                "enum": [
                  "reconciled_fixture_only",
                  "incomplete",
                  "indeterminate",
                  "out_of_envelope",
                  "rejected",
                  "disputed"
                ]
              },
              "injected_count": {
                "type": "integer",
                "minimum": 0
              },
              "captured_count": {
                "type": "integer",
                "minimum": 0
              },
              "missed_count": {
                "type": "integer",
                "minimum": 0
              },
              "duplicate_count": {
                "type": "integer",
                "minimum": 0
              },
              "unexpected_count": {
                "type": "integer",
                "minimum": 0
              },
              "upper_miss_probability_95": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "loss_counters_nonzero": {
                "type": "boolean"
              },
              "fit_acceptance_granted": {
                "const": false
              },
              "reliability_claim_granted": {
                "const": false
              },
              "physical_completeness_claim_granted": {
                "const": false
              },
              "authority_granted": {
                "const": false
              },
              "expected_result_matched": {
                "type": "boolean"
              },
              "blockers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "fit_acceptance_granted": {
      "const": false
    },
    "reliability_claim_granted": {
      "const": false
    },
    "physical_completeness_claim_granted": {
      "const": false
    },
    "authority_granted": {
      "const": false
    }
  }
}
