{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-event-capture-corpus-v0.1.json",
  "title": "Orbital event-capture observability corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-event-capture.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-capture-reconciliation-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sensor_id",
        "firmware_sha256",
        "acquisition_config_sha256",
        "event_class",
        "operating_mode_id",
        "environment_id"
      ],
      "properties": {
        "sensor_id": {
          "type": "string",
          "minLength": 1
        },
        "firmware_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "acquisition_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_class": {
          "type": "string",
          "minLength": 1
        },
        "operating_mode_id": {
          "type": "string",
          "minLength": 1
        },
        "environment_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "time_ticks",
        "payload_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "time_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observed_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "reference_event_id",
        "time_ticks",
        "payload_sha256"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_event_id": {
          "type": "string",
          "minLength": 1
        },
        "time_ticks": {
          "type": "integer",
          "minimum": 0
        },
        "payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "qualified_scope",
        "test_scope",
        "minimum_event_rate_per_second",
        "maximum_event_rate_per_second",
        "test_event_rate_per_second",
        "reference",
        "reference_events",
        "observed_events",
        "counters",
        "calibration",
        "clock",
        "expected"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "qualified_scope": {
          "$ref": "#/$defs/scope"
        },
        "test_scope": {
          "$ref": "#/$defs/scope"
        },
        "minimum_event_rate_per_second": {
          "type": "number",
          "minimum": 0
        },
        "maximum_event_rate_per_second": {
          "type": "number",
          "minimum": 0
        },
        "test_event_rate_per_second": {
          "type": "number",
          "minimum": 0
        },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "system_id",
            "reference_artifact_sha256",
            "failure_domains",
            "acquisition_failure_domains"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "system_id": {
              "type": "string"
            },
            "reference_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "failure_domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "acquisition_failure_domains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reference_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference_event"
          }
        },
        "observed_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observed_event"
          }
        },
        "counters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overflow_count",
            "dropped_event_count",
            "dropped_packet_count",
            "reset_count",
            "sequence_gap_count",
            "counter_artifact_sha256"
          ],
          "properties": {
            "overflow_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "dropped_event_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "dropped_packet_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "reset_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "sequence_gap_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "counter_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid_at_test_time",
            "scope_matches",
            "certificate_sha256"
          ],
          "properties": {
            "valid_at_test_time": {
              "type": "boolean"
            },
            "scope_matches": {
              "type": "boolean"
            },
            "certificate_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "synchronized",
            "monotonic",
            "measured_max_error_ticks",
            "allowed_max_error_ticks",
            "synchronization_artifact_sha256"
          ],
          "properties": {
            "synchronized": {
              "type": "boolean"
            },
            "monotonic": {
              "type": "boolean"
            },
            "measured_max_error_ticks": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "allowed_max_error_ticks": {
              "type": "integer",
              "minimum": 0
            },
            "synchronization_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "injected_count",
            "captured_count",
            "missed_count",
            "duplicate_count",
            "unexpected_count",
            "upper_miss_probability_95"
          ],
          "properties": {
            "disposition": {
              "enum": [
                "reconciled_fixture_only",
                "incomplete",
                "indeterminate",
                "out_of_envelope",
                "rejected",
                "disputed"
              ]
            },
            "injected_count": {
              "type": "integer",
              "minimum": 0
            },
            "captured_count": {
              "type": "integer",
              "minimum": 0
            },
            "missed_count": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate_count": {
              "type": "integer",
              "minimum": 0
            },
            "unexpected_count": {
              "type": "integer",
              "minimum": 0
            },
            "upper_miss_probability_95": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
