{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital-assurance-budget-receipt-v0.1.json",
  "title":"Exact assurance budget receipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["receipt_schema","source_commit","corpus_sha256","result","evidence_class","claim_ceiling","assurance_budget_id","requested_scope","requested_scope_id","status","total_alpha","alpha_allocated","alpha_used","alpha_remaining","joint_lower_confidence","missing_required_classes","noncomposable_claim_ids","claim_reports","independence_assumed","physical_qualification_granted","authority_granted"],
  "properties":{
    "receipt_schema":{"const":"luminous.orbital-assurance-budget.receipt.v0.1"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "corpus_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "result":{"const":"pass"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"exact-union-bound-assurance-budget-algebra-only"},
    "assurance_budget_id":{"type":"string","minLength":1},
    "requested_scope":{"enum":["FIXED_EVALUATION","ANYTIME"]},
    "requested_scope_id":{"type":"string","minLength":1},
    "status":{"enum":["ASSURANCE_SCOPE_MISMATCH","ASSURANCE_INDETERMINATE","ASSURANCE_BUDGET_EXCEEDED","ASSURANCE_COMPOSED_FIXED_EVALUATION","ASSURANCE_COMPOSED_ANYTIME"]},
    "total_alpha":{"$ref":"#/$defs/rational"},
    "alpha_allocated":{"$ref":"#/$defs/rational"},
    "alpha_used":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]},
    "alpha_remaining":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]},
    "joint_lower_confidence":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]},
    "missing_required_classes":{"type":"array","items":{"type":"string"}},
    "noncomposable_claim_ids":{"type":"array","items":{"type":"string"}},
    "claim_reports":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/claim_report"}},
    "independence_assumed":{"const":false},
    "physical_qualification_granted":{"const":false},
    "authority_granted":{"const":false}
  },
  "$defs":{
    "rational":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],
      "properties":{"numerator":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "denominator":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
    "claim_report":{"type":"object","additionalProperties":false,
      "required":["claim_id","claim_class","guarantee_kind","claim_scope","evidence_status","composable","exclusion_reason","alpha"],
      "properties":{
        "claim_id":{"type":"string","minLength":1},
        "claim_class":{"type":"string","minLength":1},
        "guarantee_kind":{"enum":["STATISTICAL_GUARANTEE","STRUCTURAL_ONLY"]},
        "claim_scope":{"enum":["FIXED_EVALUATION","ANYTIME"]},
        "evidence_status":{"enum":["admissible","indeterminate","out_of_scope"]},
        "composable":{"type":"boolean"},
        "exclusion_reason":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "alpha":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]}
      }
    }
  }
}
