{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital-feasibility-discovery-corpus-v0.1.json",
  "title":"Finite feasibility-discovery policy corpus v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","evidence_class","claim_ceiling","cases"],
  "properties":{
    "schema":{"const":"luminous.orbital-feasibility-discovery.corpus.v0.1"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"finite-passive-query-policy-tree-algebra-only"},
    "cases":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/case"}}
  },
  "$defs":{
    "rational":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],
      "properties":{"numerator":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "denominator":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
    "cost":{"type":"object","additionalProperties":false,"required":["reference_trials","exposure_micro_units","elapsed_millis"],
      "properties":{"reference_trials":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "exposure_micro_units":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "elapsed_millis":{"type":"integer","minimum":0,"maximum":9007199254740991}}},
    "base_decision":{"type":"object","required":["case_id","decision_scope_id","compatible_world_set","action_universe","scenario_manifest","actions"],
      "properties":{"case_id":{"type":"string","minLength":1},"decision_scope_id":{"type":"string","minLength":1},
        "compatible_world_set":{"type":"object"},"action_universe":{"type":"object"},
        "scenario_manifest":{"type":"object"},"actions":{"type":"array","minItems":1}}},
    "query":{"type":"object","additionalProperties":false,
      "required":["query_id","query_kind","admissibility_status","admissibility_receipt_id","evidence_status","evidence_receipt_id","expected_world_ids","expected_world_ids_sha256","world_observations","cost"],
      "properties":{
        "query_id":{"type":"string","minLength":1},
        "query_kind":{"const":"passive_observation"},
        "admissibility_status":{"enum":["admissible","prohibited","indeterminate"]},
        "admissibility_receipt_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "evidence_status":{"enum":["admissible","indeterminate","out_of_profile"]},
        "evidence_receipt_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
        "expected_world_ids":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1}},
        "expected_world_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "world_observations":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}},
        "cost":{"$ref":"#/$defs/cost"}
      }},
    "query_universe":{"type":"object","additionalProperties":false,
      "required":["source_receipt_id","scope_id","expected_query_ids","expected_query_ids_sha256","queries_sha256","queries"],
      "properties":{"source_receipt_id":{"type":"string","minLength":1},
        "scope_id":{"type":"string","minLength":1},
        "expected_query_ids":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1}},
        "expected_query_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "queries_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "queries":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/query"}}}},
    "case":{"type":"object","additionalProperties":false,
      "required":["case_id","base_decision","query_universe"],
      "properties":{"case_id":{"type":"string","minLength":1},
        "base_decision":{"$ref":"#/$defs/base_decision"},
        "query_universe":{"$ref":"#/$defs/query_universe"}}}
  }
}
