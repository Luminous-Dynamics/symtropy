{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital-feasibility-regret-receipt-v0.1.json",
  "title":"Joint feasibility and regret receipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["receipt_schema","source_commit","corpus_sha256","result","evidence_class","claim_ceiling","summary","cases","physical_qualification_granted","authority_granted"],
  "properties":{
    "receipt_schema":{"const":"luminous.orbital-feasibility-regret.receipt.v0.1"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "corpus_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "result":{"const":"pass"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"finite-joint-feasibility-and-regret-algebra-only"},
    "summary":{"$ref":"#/$defs/summary"},
    "cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case_result"}},
    "physical_qualification_granted":{"const":false},
    "authority_granted":{"const":false}
  },
  "$defs":{
    "rational":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],
      "properties":{"numerator":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "denominator":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
    "cost":{"type":"object","additionalProperties":false,"required":["reference_trials","exposure_micro_units","elapsed_millis"],
      "properties":{"reference_trials":{"type":"integer","minimum":0},"exposure_micro_units":{"type":"integer","minimum":0},"elapsed_millis":{"type":"integer","minimum":0}}},
    "feasibility_class":{"type":"object","additionalProperties":false,
      "required":["action_id","classification","feasible_scenario_count","infeasible_scenario_count","eligibility_status","eligibility_receipt_id"],
      "properties":{"action_id":{"type":"string"},"classification":{"enum":["ALWAYS_FEASIBLE","SOMETIMES_FEASIBLE","NEVER_FEASIBLE","PROHIBITED"]},
                    "feasible_scenario_count":{"type":"integer","minimum":0},"infeasible_scenario_count":{"type":"integer","minimum":0},
                    "eligibility_status":{"enum":["eligible","prohibited","indeterminate"]},
                    "eligibility_receipt_id":{"anyOf":[{"type":"string"},{"type":"null"}]}}},
    "scenario_set":{"type":"object","additionalProperties":false,
      "required":["scenario_id","world_id","loss_model_id","feasible_action_ids","infeasible_action_ids","prohibited_action_ids"],
      "properties":{"scenario_id":{"type":"string"},"world_id":{"type":"string"},"loss_model_id":{"type":"string"},
                    "feasible_action_ids":{"type":"array","items":{"type":"string"}},
                    "infeasible_action_ids":{"type":"array","items":{"type":"string"}},
                    "prohibited_action_ids":{"type":"array","items":{"type":"string"}}}},
    "scenario_regret":{"type":"object","additionalProperties":false,
      "required":["scenario_id","world_id","loss_model_id","loss","wait_and_see_regret","robust_set_regret"],
      "properties":{"scenario_id":{"type":"string"},"world_id":{"type":"string"},"loss_model_id":{"type":"string"},
                    "loss":{"$ref":"#/$defs/rational"},"wait_and_see_regret":{"$ref":"#/$defs/rational"},
                    "robust_set_regret":{"$ref":"#/$defs/rational"}}},
    "metric":{"type":"object","additionalProperties":false,
      "required":["action_id","eligibility_receipt_id","worst_case_loss","worst_case_wait_and_see_regret","worst_case_robust_set_regret","worst_loss_scenario_ids","worst_wait_and_see_scenario_ids","worst_robust_set_scenario_ids","uniformly_best_against_scenario_feasible_sets","cost","per_scenario"],
      "properties":{"action_id":{"type":"string"},"eligibility_receipt_id":{"type":"string"},
                    "worst_case_loss":{"$ref":"#/$defs/rational"},
                    "worst_case_wait_and_see_regret":{"$ref":"#/$defs/rational"},
                    "worst_case_robust_set_regret":{"$ref":"#/$defs/rational"},
                    "worst_loss_scenario_ids":{"type":"array","items":{"type":"string"}},
                    "worst_wait_and_see_scenario_ids":{"type":"array","items":{"type":"string"}},
                    "worst_robust_set_scenario_ids":{"type":"array","items":{"type":"string"}},
                    "uniformly_best_against_scenario_feasible_sets":{"type":"boolean"},
                    "cost":{"$ref":"#/$defs/cost"},"per_scenario":{"type":"array","items":{"$ref":"#/$defs/scenario_regret"}}}},
    "case_result":{"type":"object","additionalProperties":false,
      "required":["case_id","status","compatible_world_set_receipt_id","compatible_world_ids_sha256","action_universe_receipt_id","action_universe_scope_id","action_universe_closure_kind","action_universe_enumeration_method","action_ids_sha256","scenario_manifest_id","expected_scenario_ids_sha256","scenarios_sha256","compatible_world_count","action_count","scenario_count","robust_feasible_action_ids","scenario_feasible_action_ids","action_feasibility_classes","scenario_feasible_sets","minimax_wait_and_see_regret_action_ids","minimax_robust_set_regret_action_ids","pareto_frontier_action_ids","action_metrics"],
      "properties":{"case_id":{"type":"string"},
        "status":{"enum":["ACTION_UNIVERSE_OPEN","ACTION_UNIVERSE_INDETERMINATE","ACTION_ADMISSIBILITY_INDETERMINATE","FEASIBILITY_INDETERMINATE","OUT_OF_PROFILE","LOSS_MODEL_INDETERMINATE","NO_FEASIBLE_ACTION_IN_SCENARIO","NO_ROBUST_FEASIBLE_ACTION","ROBUST_FEASIBLE_DECISION_SET_AVAILABLE"]},
        "compatible_world_set_receipt_id":{"type":"string"},"compatible_world_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "action_universe_receipt_id":{"type":"string"},"action_universe_scope_id":{"type":"string"},
        "action_universe_closure_kind":{"enum":["finite_exhaustive","open","indeterminate"]},"action_universe_enumeration_method":{"type":"string"},
        "action_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"scenario_manifest_id":{"type":"string"},
        "expected_scenario_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"scenarios_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "compatible_world_count":{"type":"integer","minimum":1},"action_count":{"type":"integer","minimum":1},"scenario_count":{"type":"integer","minimum":1},
        "robust_feasible_action_ids":{"type":"array","items":{"type":"string"}},
        "scenario_feasible_action_ids":{"type":"array","items":{"type":"string"}},
        "action_feasibility_classes":{"type":"array","items":{"$ref":"#/$defs/feasibility_class"}},
        "scenario_feasible_sets":{"type":"array","items":{"$ref":"#/$defs/scenario_set"}},
        "minimax_wait_and_see_regret_action_ids":{"type":"array","items":{"type":"string"}},
        "minimax_robust_set_regret_action_ids":{"type":"array","items":{"type":"string"}},
        "pareto_frontier_action_ids":{"type":"array","items":{"type":"string"}},
        "action_metrics":{"type":"array","items":{"$ref":"#/$defs/metric"}}}},
    "summary":{"type":"object","additionalProperties":false,
      "required":["case_count","action_universe_open_cases","action_universe_indeterminate_cases","action_admissibility_indeterminate_cases","feasibility_indeterminate_cases","loss_model_indeterminate_cases","no_feasible_scenario_cases","no_robust_feasible_action_cases","robust_decision_cases","declared_action_count","robust_feasible_action_count","sometimes_feasible_action_count","never_feasible_action_count","pareto_frontier_action_count"],
      "properties":{"case_count":{"type":"integer","minimum":0},"action_universe_open_cases":{"type":"integer","minimum":0},
        "action_universe_indeterminate_cases":{"type":"integer","minimum":0},"action_admissibility_indeterminate_cases":{"type":"integer","minimum":0},
        "feasibility_indeterminate_cases":{"type":"integer","minimum":0},"loss_model_indeterminate_cases":{"type":"integer","minimum":0},
        "no_feasible_scenario_cases":{"type":"integer","minimum":0},"no_robust_feasible_action_cases":{"type":"integer","minimum":0},
        "robust_decision_cases":{"type":"integer","minimum":0},"declared_action_count":{"type":"integer","minimum":0},
        "robust_feasible_action_count":{"type":"integer","minimum":0},"sometimes_feasible_action_count":{"type":"integer","minimum":0},
        "never_feasible_action_count":{"type":"integer","minimum":0},"pareto_frontier_action_count":{"type":"integer","minimum":0}}}
  }
}
