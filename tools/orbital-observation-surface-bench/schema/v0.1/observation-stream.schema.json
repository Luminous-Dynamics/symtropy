{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-observation-surface-observations-v0.1.json",
  "title": "Orbital synthetic observation stream v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "source_commit",
    "corpus_sha256",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-observation-surface.observations.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-observation-stream-only"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "corpus_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "observed_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_fraction"
      ],
      "properties": {
        "time_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "events"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observed_event"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "configuration_id",
        "channels"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/channel"
          }
        }
      }
    }
  }
}
