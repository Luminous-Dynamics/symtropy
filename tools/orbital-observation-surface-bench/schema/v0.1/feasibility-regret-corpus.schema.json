{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital-feasibility-regret-corpus-v0.1.json",
  "title":"Joint feasibility and regret corpus v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema","evidence_class","claim_ceiling","cases"],
  "properties":{
    "schema":{"const":"luminous.orbital-feasibility-regret.corpus.v0.1"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"finite-joint-feasibility-and-regret-algebra-only"},
    "cases":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/case"}}
  },
  "$defs":{
    "rational":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],
      "properties":{"numerator":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "denominator":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
    "world_set":{"type":"object","additionalProperties":false,
      "required":["source_receipt_id","world_ids_sha256","world_ids"],
      "properties":{"source_receipt_id":{"type":"string","minLength":1},
                    "world_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "world_ids":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1}}}},
    "action_universe":{"type":"object","additionalProperties":false,
      "required":["source_receipt_id","scope_id","closure_kind","enumeration_method","evidence_status","expected_action_ids","expected_action_ids_sha256"],
      "properties":{"source_receipt_id":{"type":"string","minLength":1},
                    "scope_id":{"type":"string","minLength":1},
                    "closure_kind":{"enum":["finite_exhaustive","open","indeterminate"]},
                    "enumeration_method":{"type":"string","minLength":1},
                    "evidence_status":{"enum":["admissible","indeterminate","out_of_scope"]},
                    "expected_action_ids":{"type":"array","minItems":1,"maxItems":128,"items":{"type":"string","minLength":1}},
                    "expected_action_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "cost":{"type":"object","additionalProperties":false,
      "required":["reference_trials","exposure_micro_units","elapsed_millis"],
      "properties":{"reference_trials":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "exposure_micro_units":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "elapsed_millis":{"type":"integer","minimum":0,"maximum":9007199254740991}}},
    "action":{"type":"object","additionalProperties":false,
      "required":["action_id","eligibility_status","eligibility_receipt_id","cost"],
      "properties":{"action_id":{"type":"string","minLength":1},
                    "eligibility_status":{"enum":["eligible","prohibited","indeterminate"]},
                    "eligibility_receipt_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
                    "cost":{"$ref":"#/$defs/cost"}}},
    "outcome":{"type":"object","additionalProperties":false,
      "required":["feasibility_status","loss"],
      "properties":{"feasibility_status":{"enum":["feasible","infeasible","indeterminate","prohibited"]},
                    "loss":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]}}},
    "scenario":{"type":"object","additionalProperties":false,
      "required":["scenario_id","world_id","loss_model_id","evidence_status","evidence_receipt_id","action_outcomes"],
      "properties":{"scenario_id":{"type":"string","minLength":1},
                    "world_id":{"type":"string","minLength":1},
                    "loss_model_id":{"type":"string","minLength":1},
                    "evidence_status":{"enum":["admissible","indeterminate","out_of_profile"]},
                    "evidence_receipt_id":{"anyOf":[{"type":"string","minLength":1},{"type":"null"}]},
                    "action_outcomes":{"type":"object","minProperties":1,"additionalProperties":{"$ref":"#/$defs/outcome"}}}},
    "scenario_manifest":{"type":"object","additionalProperties":false,
      "required":["source_manifest_id","expected_scenario_ids","expected_scenario_ids_sha256","scenarios_sha256","scenarios"],
      "properties":{"source_manifest_id":{"type":"string","minLength":1},
                    "expected_scenario_ids":{"type":"array","minItems":1,"maxItems":4096,"items":{"type":"string","minLength":1}},
                    "expected_scenario_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "scenarios_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
                    "scenarios":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"#/$defs/scenario"}}}},
    "case":{"type":"object","additionalProperties":false,
      "required":["case_id","decision_scope_id","compatible_world_set","action_universe","scenario_manifest","actions"],
      "properties":{"case_id":{"type":"string","minLength":1},
                    "decision_scope_id":{"type":"string","minLength":1},
                    "compatible_world_set":{"$ref":"#/$defs/world_set"},
                    "action_universe":{"$ref":"#/$defs/action_universe"},
                    "scenario_manifest":{"$ref":"#/$defs/scenario_manifest"},
                    "actions":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/action"}}}}
  }
}
