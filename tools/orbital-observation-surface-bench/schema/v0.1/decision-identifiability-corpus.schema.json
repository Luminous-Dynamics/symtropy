{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-decision-identifiability-corpus-v0.1.json",
  "title": "Orbital decision identifiability finite-world corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-decision-identifiability.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "exact-finite-world-decision-set-algebra-only"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "mass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "probability"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "probability": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/mass"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "configuration_id",
        "admissibility_status",
        "admissibility_receipt_id",
        "observation_law"
      ],
      "properties": {
        "scope_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "admissibility_status": {
          "enum": [
            "admissible",
            "indeterminate"
          ]
        },
        "admissibility_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observation_law": {
          "$ref": "#/$defs/law"
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "parameter_signature",
        "observation_law",
        "decision_class"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "minLength": 1
        },
        "parameter_signature": {
          "type": "object"
        },
        "observation_law": {
          "$ref": "#/$defs/law"
        },
        "decision_class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_trials",
        "exposure_micro_units",
        "elapsed_millis"
      ],
      "properties": {
        "reference_trials": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exposure_micro_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "elapsed_millis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_id",
        "admissibility_status",
        "admissibility_receipt_id",
        "cost",
        "world_outcome_laws"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "admissibility_status": {
          "enum": [
            "admissible",
            "inadmissible",
            "indeterminate"
          ]
        },
        "admissibility_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "world_outcome_laws": {
          "type": "object"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "evidence",
        "worlds",
        "probes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "worlds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/world"
          }
        },
        "probes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/probe"
          }
        }
      }
    }
  }
}
