{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital-feasibility-discovery-receipt-v0.1.json",
  "title":"Finite feasibility-discovery policy receipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["receipt_schema","source_commit","corpus_sha256","result","evidence_class","claim_ceiling","summary","cases","physical_qualification_granted","authority_granted"],
  "properties":{
    "receipt_schema":{"const":"luminous.orbital-feasibility-discovery.receipt.v0.1"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "corpus_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "result":{"const":"pass"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"finite-passive-query-policy-tree-algebra-only"},
    "summary":{"$ref":"#/$defs/summary"},
    "cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case_result"}},
    "physical_qualification_granted":{"const":false},
    "authority_granted":{"const":false}
  },
  "$defs":{
    "rational":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],
      "properties":{"numerator":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "denominator":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
    "cost":{"type":"object","additionalProperties":false,"required":["reference_trials","exposure_micro_units","elapsed_millis"],
      "properties":{"reference_trials":{"type":"integer","minimum":0},"exposure_micro_units":{"type":"integer","minimum":0},"elapsed_millis":{"type":"integer","minimum":0}}},
    "difference":{"type":"object","additionalProperties":false,"required":["direction","magnitude"],
      "properties":{"direction":{"enum":["positive_improvement","negative_improvement","no_change"]},"magnitude":{"$ref":"#/$defs/rational"}}},
    "scenario_metric":{"type":"object","additionalProperties":false,
      "required":["scenario_id","world_id","loss_model_id","observed_outcome_id","selected_action_id","loss","wait_and_see_regret","outcome_class_regret"],
      "properties":{"scenario_id":{"type":"string"},"world_id":{"type":"string"},"loss_model_id":{"type":"string"},
        "observed_outcome_id":{"type":"string"},"selected_action_id":{"type":"string"},
        "loss":{"$ref":"#/$defs/rational"},"wait_and_see_regret":{"$ref":"#/$defs/rational"},
        "outcome_class_regret":{"$ref":"#/$defs/rational"}}},
    "policy_metric":{"type":"object","additionalProperties":false,
      "required":["policy_id","query_id","branch_actions","observation_class_world_ids","worst_case_loss","worst_case_wait_and_see_regret","worst_case_outcome_class_regret","worst_loss_scenario_ids","worst_wait_and_see_scenario_ids","worst_outcome_class_regret_scenario_ids","worst_loss_reduction_vs_best_no_query","query_cost","branch_action_cost_upper_bound","total_cost_upper_bound","per_scenario"],
      "properties":{"policy_id":{"type":"string"},"query_id":{"anyOf":[{"type":"string"},{"type":"null"}]},
        "branch_actions":{"type":"object","additionalProperties":{"type":"string"}},
        "observation_class_world_ids":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}},
        "worst_case_loss":{"$ref":"#/$defs/rational"},
        "worst_case_wait_and_see_regret":{"$ref":"#/$defs/rational"},
        "worst_case_outcome_class_regret":{"$ref":"#/$defs/rational"},
        "worst_loss_scenario_ids":{"type":"array","items":{"type":"string"}},
        "worst_wait_and_see_scenario_ids":{"type":"array","items":{"type":"string"}},
        "worst_outcome_class_regret_scenario_ids":{"type":"array","items":{"type":"string"}},
        "worst_loss_reduction_vs_best_no_query":{"anyOf":[{"$ref":"#/$defs/difference"},{"type":"null"}]},
        "query_cost":{"$ref":"#/$defs/cost"},
        "branch_action_cost_upper_bound":{"$ref":"#/$defs/cost"},
        "total_cost_upper_bound":{"$ref":"#/$defs/cost"},
        "per_scenario":{"type":"array","items":{"$ref":"#/$defs/scenario_metric"}}}},
    "query_report":{"type":"object","additionalProperties":false,
      "required":["query_id","status","observable_outcome_ids","observation_class_world_ids","common_feasible_action_ids_by_outcome","generated_policy_count","policy_ids"],
      "properties":{"query_id":{"type":"string"},"status":{"enum":["READY","QUERY_PROHIBITED","QUERY_ADMISSIBILITY_INDETERMINATE","QUERY_OUT_OF_PROFILE","QUERY_EVIDENCE_INDETERMINATE","NO_SAFE_POLICY_FOR_OUTCOME","POLICY_ENUMERATION_LIMIT_EXCEEDED"]},
        "observable_outcome_ids":{"type":"array","items":{"type":"string"}},
        "observation_class_world_ids":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}},
        "common_feasible_action_ids_by_outcome":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}}},
        "generated_policy_count":{"type":"integer","minimum":0},"policy_ids":{"type":"array","items":{"type":"string"}}}},
    "case_result":{"type":"object","additionalProperties":false,
      "required":["case_id","status","base_feasibility_status","compatible_world_ids_sha256","action_ids_sha256","scenario_manifest_sha256","query_universe_receipt_id","query_universe_scope_id","expected_query_ids_sha256","queries_sha256","no_query_policy_ids","query_reports","policy_metrics","policy_pareto_frontier_ids","best_no_query_worst_case_loss","clairvoyant_worst_case_loss"],
      "properties":{"case_id":{"type":"string"},"status":{"enum":["BASE_DECISION_INDETERMINATE","NO_FEASIBLE_QUERY_OR_STATIC_POLICY","QUERY_CONDITIONED_POLICIES_AVAILABLE_NO_STATIC_BASELINE","POLICY_FRONTIER_AVAILABLE"]},
        "base_feasibility_status":{"type":"string"},"compatible_world_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "action_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"scenario_manifest_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "query_universe_receipt_id":{"type":"string"},"query_universe_scope_id":{"type":"string"},
        "expected_query_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"queries_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "no_query_policy_ids":{"type":"array","items":{"type":"string"}},
        "query_reports":{"type":"array","items":{"$ref":"#/$defs/query_report"}},
        "policy_metrics":{"type":"array","items":{"$ref":"#/$defs/policy_metric"}},
        "policy_pareto_frontier_ids":{"type":"array","items":{"type":"string"}},
        "best_no_query_worst_case_loss":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]},
        "clairvoyant_worst_case_loss":{"anyOf":[{"$ref":"#/$defs/rational"},{"type":"null"}]}}},
    "summary":{"type":"object","additionalProperties":false,
      "required":["case_count","base_decision_indeterminate_cases","no_query_policy_cases","no_safe_query_policy_cases","query_evidence_indeterminate_count","query_prohibited_count","generated_policy_count","pareto_frontier_policy_count","positive_worst_loss_reduction_policy_count","policy_enumeration_limit_cases"],
      "properties":{"case_count":{"type":"integer","minimum":0},"base_decision_indeterminate_cases":{"type":"integer","minimum":0},
        "no_query_policy_cases":{"type":"integer","minimum":0},"no_safe_query_policy_cases":{"type":"integer","minimum":0},
        "query_evidence_indeterminate_count":{"type":"integer","minimum":0},"query_prohibited_count":{"type":"integer","minimum":0},
        "generated_policy_count":{"type":"integer","minimum":0},"pareto_frontier_policy_count":{"type":"integer","minimum":0},
        "positive_worst_loss_reduction_policy_count":{"type":"integer","minimum":0},"policy_enumeration_limit_cases":{"type":"integer","minimum":0}}}
  }
}
