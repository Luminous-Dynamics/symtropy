{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/orbital-joint-loss-scenario-receipt-v0.1.json",
  "title":"Joint loss-model scenario receipt v0.1",
  "type":"object","additionalProperties":false,
  "required":["receipt_schema","source_commit","corpus_sha256","result","evidence_class","claim_ceiling","summary","cases","physical_qualification_granted","authority_granted"],
  "properties":{
    "receipt_schema":{"const":"luminous.orbital-joint-loss-scenario.receipt.v0.1"},
    "source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "corpus_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "result":{"const":"pass"},
    "evidence_class":{"const":"synthetic"},
    "claim_ceiling":{"const":"finite-joint-loss-scenario-regret-algebra-only"},
    "summary":{"$ref":"#/$defs/summary"},
    "cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case_result"}},
    "physical_qualification_granted":{"const":false},
    "authority_granted":{"const":false}
  },
  "$defs":{
    "rational":{"type":"object","additionalProperties":false,"required":["numerator","denominator"],
      "properties":{"numerator":{"type":"integer","minimum":0,"maximum":9007199254740991},
                    "denominator":{"type":"integer","minimum":1,"maximum":9007199254740991}}},
    "cost":{"type":"object","additionalProperties":false,"required":["reference_trials","exposure_micro_units","elapsed_millis"],
      "properties":{"reference_trials":{"type":"integer","minimum":0},"exposure_micro_units":{"type":"integer","minimum":0},"elapsed_millis":{"type":"integer","minimum":0}}},
    "excluded_action":{"type":"object","additionalProperties":false,"required":["action_id","admissibility_status"],
      "properties":{"action_id":{"type":"string"},"admissibility_status":{"enum":["inadmissible","indeterminate"]}}},
    "evidence_issue":{"type":"object","additionalProperties":false,
      "required":["scenario_id","world_id","loss_model_id","evidence_status","evidence_receipt_id"],
      "properties":{"scenario_id":{"type":"string"},"world_id":{"type":"string"},"loss_model_id":{"type":"string"},
                    "evidence_status":{"enum":["inadmissible","indeterminate","out_of_profile"]},
                    "evidence_receipt_id":{"anyOf":[{"type":"string"},{"type":"null"}]}}},
    "scenario_regret":{"type":"object","additionalProperties":false,
      "required":["scenario_id","world_id","loss_model_id","loss","joint_regret"],
      "properties":{"scenario_id":{"type":"string"},"world_id":{"type":"string"},"loss_model_id":{"type":"string"},
                    "loss":{"$ref":"#/$defs/rational"},"joint_regret":{"$ref":"#/$defs/rational"}}},
    "action_metric":{"type":"object","additionalProperties":false,
      "required":["action_id","admissibility_receipt_id","worst_case_loss","worst_case_joint_regret","worst_case_rectangular_regret","rectangular_regret_excess","worst_joint_regret_scenarios","worst_rectangular_regret_worlds","uniformly_optimal_across_joint_scenarios","joint_scenario_best_count","cost","per_scenario"],
      "properties":{"action_id":{"type":"string"},"admissibility_receipt_id":{"type":"string"},
                    "worst_case_loss":{"$ref":"#/$defs/rational"},"worst_case_joint_regret":{"$ref":"#/$defs/rational"},
                    "worst_case_rectangular_regret":{"$ref":"#/$defs/rational"},"rectangular_regret_excess":{"$ref":"#/$defs/rational"},
                    "worst_joint_regret_scenarios":{"type":"array","items":{"type":"string"}},
                    "worst_rectangular_regret_worlds":{"type":"array","items":{"type":"string"}},
                    "uniformly_optimal_across_joint_scenarios":{"type":"boolean"},"joint_scenario_best_count":{"type":"integer","minimum":0},
                    "cost":{"$ref":"#/$defs/cost"},"per_scenario":{"type":"array","items":{"$ref":"#/$defs/scenario_regret"}}}},
    "case_result":{"type":"object","additionalProperties":false,
      "required":["case_id","status","compatible_world_set_receipt_id","compatible_world_ids_sha256","loss_scenario_manifest_id","loss_scenarios_sha256","compatible_world_count","loss_scenario_count","loss_model_ids","uniformly_optimal_action_ids","joint_minimax_regret_action_ids","rectangular_minimax_regret_action_ids","joint_scenario_pareto_frontier_action_ids","rectangular_pareto_frontier_action_ids","excluded_actions","scenario_evidence_issues","action_metrics"],
      "properties":{"case_id":{"type":"string"},
        "status":{"enum":["OUT_OF_PROFILE","LOSS_MODEL_INDETERMINATE","NO_ADMISSIBLE_ACTION","UNIFORM_OPTIMUM_ACROSS_JOINT_SCENARIOS","NO_UNIFORM_OPTIMUM_JOINT_SCENARIO_FRONTIER"]},
        "compatible_world_set_receipt_id":{"type":"string"},"compatible_world_ids_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "loss_scenario_manifest_id":{"type":"string"},"loss_scenarios_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "compatible_world_count":{"type":"integer","minimum":1},"loss_scenario_count":{"type":"integer","minimum":1},
        "loss_model_ids":{"type":"array","items":{"type":"string"}},
        "uniformly_optimal_action_ids":{"type":"array","items":{"type":"string"}},
        "joint_minimax_regret_action_ids":{"type":"array","items":{"type":"string"}},
        "rectangular_minimax_regret_action_ids":{"type":"array","items":{"type":"string"}},
        "joint_scenario_pareto_frontier_action_ids":{"type":"array","items":{"type":"string"}},
        "rectangular_pareto_frontier_action_ids":{"type":"array","items":{"type":"string"}},
        "excluded_actions":{"type":"array","items":{"$ref":"#/$defs/excluded_action"}},
        "scenario_evidence_issues":{"type":"array","items":{"$ref":"#/$defs/evidence_issue"}},
        "action_metrics":{"type":"array","items":{"$ref":"#/$defs/action_metric"}}}},
    "summary":{"type":"object","additionalProperties":false,
      "required":["case_count","no_admissible_action_cases","loss_model_indeterminate_cases","out_of_profile_cases","uniform_optimum_cases","no_uniform_optimum_cases","admissible_action_count","excluded_action_count","scenario_evidence_issue_count","joint_frontier_action_count","rectangular_frontier_action_count"],
      "properties":{"case_count":{"type":"integer","minimum":0},"no_admissible_action_cases":{"type":"integer","minimum":0},
        "loss_model_indeterminate_cases":{"type":"integer","minimum":0},"out_of_profile_cases":{"type":"integer","minimum":0},
        "uniform_optimum_cases":{"type":"integer","minimum":0},"no_uniform_optimum_cases":{"type":"integer","minimum":0},
        "admissible_action_count":{"type":"integer","minimum":0},"excluded_action_count":{"type":"integer","minimum":0},
        "scenario_evidence_issue_count":{"type":"integer","minimum":0},"joint_frontier_action_count":{"type":"integer","minimum":0},
        "rectangular_frontier_action_count":{"type":"integer","minimum":0}}}
  }
}
