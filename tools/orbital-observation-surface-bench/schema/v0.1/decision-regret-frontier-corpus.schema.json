{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-decision-regret-frontier-corpus-v0.1.json",
  "title": "Finite compatible-world decision loss and regret corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_class", "claim_ceiling", "cases"],
  "properties": {
    "schema": {"const": "luminous.orbital-decision-regret-frontier.corpus.v0.1"},
    "evidence_class": {"const": "synthetic"},
    "claim_ceiling": {"const": "finite-compatible-world-loss-and-regret-algebra-only"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "denominator": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "world_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_receipt_id", "world_ids_sha256", "world_ids"],
      "properties": {
        "source_receipt_id": {"type": "string", "minLength": 1},
        "world_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "world_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_trials", "exposure_micro_units", "elapsed_millis"],
      "properties": {
        "reference_trials": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "exposure_micro_units": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "elapsed_millis": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "admissibility_status", "admissibility_receipt_id", "cost", "world_losses"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "admissibility_status": {"enum": ["admissible", "inadmissible", "indeterminate"]},
        "admissibility_receipt_id": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "cost": {"$ref": "#/$defs/cost"},
        "world_losses": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/rational"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "compatible_world_set", "actions"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "compatible_world_set": {"$ref": "#/$defs/world_set"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/action"}
        }
      }
    }
  }
}
