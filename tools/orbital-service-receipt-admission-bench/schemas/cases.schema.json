{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/orbital-service-receipt-admission-v0.1.json",
  "title": "Orbital Service Receipt Admission Corpus v0.1",
  "type": "object",
  "required": [
    "schema",
    "evidence_class",
    "claim_ceiling",
    "planned_capacity_source_commit",
    "composition_source_commit",
    "source_commits",
    "service_profile",
    "service_window_start_tick",
    "service_window_end_tick",
    "finalization_tick",
    "providers",
    "scenarios"
  ],
  "properties": {
    "schema": {
      "const": "luminous.orbital-service-receipt-admission.corpus.v0.1"
    },
    "evidence_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "const": "synthetic-receiver-accepted-service-receipt-admission-only"
    },
    "planned_capacity_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "composition_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_commits": {
      "$ref": "#/$defs/sourceCommits"
    },
    "service_profile": {
      "$ref": "#/$defs/serviceProfile"
    },
    "service_window_start_tick": {
      "type": "integer",
      "minimum": 0
    },
    "service_window_end_tick": {
      "type": "integer",
      "minimum": 0
    },
    "finalization_tick": {
      "type": "integer",
      "minimum": 0
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/providerWindow"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "sourceCommits": {
      "type": "object",
      "required": [
        "earth_orbit_chain",
        "orbital_capture",
        "orbital_fluid"
      ],
      "properties": {
        "earth_orbit_chain": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "orbital_capture": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "orbital_fluid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "serviceProfile": {
      "type": "object",
      "required": [
        "client_id",
        "interface_id",
        "interface_revision",
        "fluid_id",
        "minimum_receiver_accepted_mass_g"
      ],
      "properties": {
        "client_id": {
          "type": "string",
          "minLength": 1
        },
        "interface_id": {
          "type": "string",
          "minLength": 1
        },
        "interface_revision": {
          "type": "integer",
          "minimum": 1
        },
        "fluid_id": {
          "type": "string",
          "minLength": 1
        },
        "minimum_receiver_accepted_mass_g": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "providerWindow": {
      "type": "object",
      "required": [
        "provider_id",
        "profile_id",
        "configuration_revision",
        "lifecycle_state_id",
        "effective_from_tick",
        "effective_until_tick"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_revision": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_state_id": {
          "type": "string",
          "minLength": 1
        },
        "effective_from_tick": {
          "type": "integer",
          "minimum": 0
        },
        "effective_until_tick": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "serviceReceipt": {
      "type": "object",
      "required": [
        "event_id",
        "idempotency_key",
        "provider_id",
        "provider_profile_id",
        "provider_configuration_revision",
        "provider_lifecycle_state_id",
        "event_time_tick",
        "observed_at_tick",
        "composition_receipt_json",
        "composition_receipt_sha256"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_profile_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_configuration_revision": {
          "type": "string",
          "minLength": 1
        },
        "provider_lifecycle_state_id": {
          "type": "string",
          "minLength": 1
        },
        "event_time_tick": {
          "type": "integer",
          "minimum": 0
        },
        "observed_at_tick": {
          "type": "integer",
          "minimum": 0
        },
        "causal_predecessor_event_id": {
          "type": "string"
        },
        "supersedes_event_id": {
          "type": "string"
        },
        "composition_receipt_json": {
          "type": "string",
          "minLength": 1
        },
        "composition_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": [
        "case_id",
        "capacity_plan_case_id",
        "capacity_plan_receipt_json",
        "capacity_plan_receipt_sha256",
        "required_operation_ticks",
        "receipts",
        "expected_status",
        "expected_reason"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity_plan_case_id": {
          "type": "string",
          "minLength": 1
        },
        "capacity_plan_receipt_json": {
          "type": "string",
          "minLength": 1
        },
        "capacity_plan_receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_operation_ticks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceReceipt"
          }
        },
        "expected_status": {
          "enum": [
            "service_floor_met_synthetic",
            "partial_service_synthetic",
            "service_shortfall",
            "indeterminate",
            "rejected",
            "disputed"
          ]
        },
        "expected_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
