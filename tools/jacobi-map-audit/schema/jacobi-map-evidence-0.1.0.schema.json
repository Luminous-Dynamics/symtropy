{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/jacobi-map-evidence-0.1.0.schema.json",
  "title": "Screen-projected Jacobi map evidence",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sample_id", "branch_id", "branch_parameter", "normalization_id", "map", "componentwise_absolute_error_bound"],
    "properties": {
      "sample_id": {"type": "string", "minLength": 1},
      "branch_id": {"type": "string", "minLength": 1},
      "branch_parameter": {"type": "number"},
      "normalization_id": {"type": "string", "minLength": 1},
      "map": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entries"],
        "properties": {
          "entries": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {
              "type": "array", "minItems": 2, "maxItems": 2,
              "items": {"type": "number"}
            }
          }
        }
      },
      "componentwise_absolute_error_bound": {"type": "number", "minimum": 0}
    }
  }
}
