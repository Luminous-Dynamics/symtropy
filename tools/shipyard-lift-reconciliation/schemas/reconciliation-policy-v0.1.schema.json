{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/shipyard-lift-reconciliation-policy-v0.1.schema.json",
  "title": "Shipyard Lift Reconciliation Policy V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_revision",
    "required_channels",
    "maximum_sample_gap_ticks",
    "maximum_ingest_lateness_ticks"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "required_channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "hook_load",
          "wind_gust",
          "crane_configuration",
          "motion_envelope",
          "occupancy_projection",
          "overload_alarm",
          "hoist_state"
        ]
      }
    },
    "maximum_sample_gap_ticks": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_ingest_lateness_ticks": {
      "type": "integer",
      "minimum": 0
    }
  }
}
