{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/tools/textile-feed-presentation-contract/feed-cases.schema.json",
  "title": "Textile feed-presentation synthetic challenge corpus v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "fixture_class",
    "claim_ceiling",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "corpus_id": {
      "const": "TEXTILE-FEED-PRESENTATION-CASES-001"
    },
    "fixture_class": {
      "const": "synthetic"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "mutation",
          "expected"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "mutation": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "valid",
              "findings"
            ],
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "findings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
