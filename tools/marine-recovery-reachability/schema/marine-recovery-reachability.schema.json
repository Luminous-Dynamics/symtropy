{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luminous-dynamics:marine-recovery-reachability:0.1.0",
  "title": "Marine Bounded-Action Recovery Reachability Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scorecard_id",
    "record_status",
    "claim_ceiling",
    "mission_snapshot",
    "service_contract",
    "trigger_roster",
    "hard_gate_roster",
    "graph_limits",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "scorecard_id": {
      "type": "string",
      "minLength": 1
    },
    "record_status": {
      "enum": [
        "synthetic",
        "shadow_replay",
        "measured_campaign",
        "published_reproduction"
      ]
    },
    "claim_ceiling": {
      "const": "bounded_action_recovery_graph_audit_only"
    },
    "mission_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "craft_configuration_sha256",
        "occupancy_sha256",
        "operating_envelope_sha256",
        "service_contract_sha256",
        "trigger_roster_sha256",
        "hard_gate_roster_sha256",
        "scenario_set_sha256",
        "mission_window_start",
        "mission_window_end",
        "mission_snapshot_sha256"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "craft_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "occupancy_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "operating_envelope_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "service_contract_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "trigger_roster_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "hard_gate_roster_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "scenario_set_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "mission_window_start": {
          "type": "string",
          "format": "date-time"
        },
        "mission_window_end": {
          "type": "string",
          "format": "date-time"
        },
        "mission_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "service_contract": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "unit",
          "operator",
          "floor_value",
          "minimum_coverage_fraction",
          "max_abs_rate_per_hour",
          "rate_bound_method",
          "rate_bound_class",
          "rate_bound_evidence_sha256"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "operator": {
            "enum": [
              "gte",
              "lte"
            ]
          },
          "floor_value": {
            "type": "number"
          },
          "minimum_coverage_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "max_abs_rate_per_hour": {
            "type": "number",
            "minimum": 0
          },
          "rate_bound_method": {
            "type": "string",
            "minLength": 1
          },
          "rate_bound_class": {
            "enum": [
              "measured",
              "modeled",
              "derived",
              "synthetic"
            ]
          },
          "rate_bound_evidence_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "trigger_roster": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hard_gate_roster": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "graph_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_paths_per_scenario",
        "max_action_depth"
      ],
      "properties": {
        "max_paths_per_scenario": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_action_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "trigger_class",
          "scenario_class",
          "trigger_state",
          "trigger_state_sha256",
          "available_components",
          "available_capabilities",
          "decision_time",
          "intervention_deadline_hours",
          "max_action_depth",
          "required_hard_gate_ids",
          "actions",
          "terminals",
          "expected_outcome",
          "scenario_sha256"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "trigger_class": {
            "type": "string",
            "minLength": 1
          },
          "scenario_class": {
            "type": "string",
            "minLength": 1
          },
          "trigger_state": {
            "type": "array",
            "minItems": 11,
            "maxItems": 11,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "metric",
                "unit",
                "value",
                "lower_bound",
                "upper_bound",
                "coverage_fraction",
                "evidence_sha256"
              ],
              "properties": {
                "metric": {
                  "type": "string",
                  "minLength": 1
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                },
                "lower_bound": {
                  "type": "number"
                },
                "upper_bound": {
                  "type": "number"
                },
                "coverage_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          },
          "trigger_state_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "available_components": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "available_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision_time": {
            "type": "string",
            "format": "date-time"
          },
          "intervention_deadline_hours": {
            "type": "integer",
            "minimum": 1
          },
          "max_action_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "required_hard_gate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action_id",
                "from_node",
                "to_node",
                "action_class",
                "trigger_classes",
                "duration_hours_lower",
                "duration_hours_upper",
                "requires_components",
                "requires_capabilities",
                "metric_deltas",
                "hard_gate_checks",
                "action_evidence_sha256",
                "action_sha256"
              ],
              "properties": {
                "action_id": {
                  "type": "string",
                  "minLength": 1
                },
                "from_node": {
                  "type": "string",
                  "minLength": 1
                },
                "to_node": {
                  "type": "string",
                  "minLength": 1
                },
                "action_class": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger_classes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "duration_hours_lower": {
                  "type": "integer",
                  "minimum": 1
                },
                "duration_hours_upper": {
                  "type": "integer",
                  "minimum": 1
                },
                "requires_components": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "requires_capabilities": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "metric_deltas": {
                  "type": "array",
                  "minItems": 11,
                  "maxItems": 11,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "metric",
                      "unit",
                      "lower_delta",
                      "upper_delta",
                      "evidence_sha256"
                    ],
                    "properties": {
                      "metric": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "lower_delta": {
                        "type": "number"
                      },
                      "upper_delta": {
                        "type": "number"
                      },
                      "evidence_sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      }
                    }
                  }
                },
                "hard_gate_checks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "gate_id",
                      "status",
                      "evidence_sha256"
                    ],
                    "properties": {
                      "gate_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "enum": [
                          "pass",
                          "fail",
                          "unknown"
                        ]
                      },
                      "evidence_sha256": {
                        "type": "string",
                        "pattern": "^[a-fA-F0-9]{64}$"
                      }
                    }
                  }
                },
                "action_evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "action_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          },
          "terminals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "terminal_id",
                "node_id",
                "objective_class",
                "available",
                "access_status",
                "service_status",
                "arrival_deadline_at",
                "receipt_valid_until",
                "destination_location_sha256",
                "access_evidence_sha256",
                "service_availability_sha256",
                "authority_receipt_ref",
                "authority_receipt_sha256",
                "terminal_evidence_sha256",
                "receipt_sha256"
              ],
              "properties": {
                "terminal_id": {
                  "type": "string",
                  "minLength": 1
                },
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "objective_class": {
                  "enum": [
                    "safe_haven",
                    "shore_resupply",
                    "repair_restoration",
                    "controlled_safe_hold"
                  ]
                },
                "available": {
                  "type": "boolean"
                },
                "access_status": {
                  "enum": [
                    "verified",
                    "unverified",
                    "closed"
                  ]
                },
                "service_status": {
                  "enum": [
                    "verified",
                    "not_required",
                    "unverified",
                    "unavailable"
                  ]
                },
                "arrival_deadline_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "receipt_valid_until": {
                  "type": "string",
                  "format": "date-time"
                },
                "destination_location_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "access_evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "service_availability_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "authority_receipt_ref": {
                  "type": "string"
                },
                "authority_receipt_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "terminal_evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "receipt_sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          },
          "expected_outcome": {
            "enum": [
              "recoverable",
              "abstain"
            ]
          },
          "scenario_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  }
}
