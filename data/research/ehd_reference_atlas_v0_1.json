  "created_date": "2026-11-21",
  "status": "source_transcribed_benchmark_atlas_not_independently_reproduced",
  "comparability_policy": [
    "Never merge atmospheric air corona, reduced-pressure air corona, CO2 DBD, wind-tunnel flight-flow, and RF-CCP into one unqualified cohort.",
    "Keep maximum values from different electrode configurations as separate records.",
    "Separate absolute thrust, per-span thrust, thrust density, thrust-to-power, thrust-to-weight, and net effective thrust after frame drag.",
    "A source figure export or interpolating pickle is not a raw instrument time-series.",
    "Unknown values are null, not zero; absent source conditions remain explicit.",
    "Power boundary and system-mass boundary are required before cross-study ranking."
  ],
  "metric_ontology": {
    "thrust_absolute": {
      "unit": "N",
      "definition": "Direct force measurement or derived force; method must be explicit."
    },
    "thrust_per_span": {
      "unit": "N/m",
      "definition": "Force normalized by active span; not interchangeable with total thrust."
    },
    "thrust_density": {
      "unit": "N/m^2",
      "definition": "Force divided by declared reference frontal/active area; area definition is mandatory."
    },
    "thrust_to_power": {
      "unit": "N/kW",
      "equivalent_unit": "mN/W",
      "definition": "Thrust divided by declared power boundary; numeric equivalence is only after correct SI conversion."
    },
    "thrust_to_weight": {
      "unit": "1",
      "definition": "Thrust/weight with exact mass included; collector-only mass is not aircraft system T/W."
    },
    "effective_thrust": {
      "unit": "N or N/m",
      "definition": "Net force after declared frame/electrode aerodynamic drag; separate from ionic thrust."
    },
    "real_ac_power": {
      "unit": "W",
      "definition": "Cycle-mean real power from simultaneous u(t), i(t) using the declared time integration window."
    },
    "electrical_terminal_power": {
      "unit": "W",
      "definition": "Simultaneous measured terminal V·I for DC; not automatically wall-plug power."
    },
    "system_wall_power": {
      "unit": "W",
      "definition": "Complete supply input including converter and auxiliary loads where measured."
    }
  },
