{
  "contract_id": "ehd_piv_reference_evidence_v0_1",
  "version": "0.1.0",
  "status": "prospective_contract_with_authored_reference_verifier_ci_pending",
  "scope": "content integrity, dependence-aware partitioning, reference qualification, common-mode uncertainty and receipt binding for EHD-PIV empirical covariance inputs",
  "claim_boundary": {
    "residual_estimand": "PIV_minus_reference_residual_covariance",
    "piv_only_claim_requires": "qualified_reference_uncertainty_and_piv_reference_cross_covariance_or_a_validated_negligibility_bound",
    "unknown_reference_or_cross_covariance": "residual_covariance_only",
    "digest_proves": "byte_identity_against_declared_digest",
    "digest_does_not_prove": [
      "authorship",
      "custody",
      "calibration_validity",
      "reference_independence",
      "physical_truth"
    ]
  },
  "covariance": {
    "residual_definition": "r = y_PIV - y_ref",
    "identity": "Cov(r)=Cov(e_PIV)+Cov(e_ref)-Cov(e_PIV,e_ref)-Cov(e_ref,e_PIV)",
    "independence_assumed_by_default": false,
    "cross_covariance_required_for_piv_only_decomposition": true,
    "if_cross_covariance_unidentified": "retain_combined_residual_covariance_and_block_piv_only_claim",
    "supported_components": [
      "piv_path_only",
      "reference_path_only",
      "shared_common_mode",
      "acquisition_session_effect",
      "flow_variability",
      "observer_induced_physical_change"
    ]
  },
  "dependence_graph": {
    "hierarchy": [
      "campaign",
      "session",
      "calibration_or_reference_batch",
      "dependence_cluster",
      "acquisition",
      "asset",
      "frame_or_vector"
    ],
    "split_unit": "connected_component_of_declared_shared_cause_graph",
    "shared_causes": [
      "camera_calibration",
      "reference_calibration",
      "clock_synchronization",
      "geometry_registration",
      "tracer_batch",
      "illumination_state",
      "environmental_control",
      "electrode_conditioning",
      "shared_source_asset"
    ],
    "cohort_component_overlap_allowed": false,
    "acquisition_id_uniqueness_is_sufficient": false,
    "connected_component_algorithm": "union_find_over_asset_dependence_group_ids_and_explicit_shared_cause_edges",
    "cohort_must_include_complete_component": true,
    "checked_overlap_dimensions": [
      "acquisition_id",
      "dependence_component_id",
      "asset_id",
      "reference_evidence_id"
    ],
    "cohort_partitions_bind_source_manifest_digest": true,
    "complete_coverage_required_for_accepted_split": true
  },
  "asset_manifest": {
    "hash_algorithm": "SHA-256",
    "asset_digest_encoding": "lowercase_hex_64",
    "manifest_encoding": "versioned_canonical_json",
    "source_bytes_rehashed_before_decode_or_processing": true,
    "required_asset_fields": [
      "asset_id",
      "role",
      "relative_path",
      "byte_length",
      "media_type",
      "sha256",
      "acquisition_id",
      "dependence_group_ids",
      "reference_evidence_id",
      "clock_domain",
      "captured_at_utc"
    ],
    "required_manifest_fields": [
      "schema_version",
      "canonicalization_version",
      "manifest_id",
      "source_release_id",
      "protocol_fingerprint",
      "reference_assessment_id",
      "observer_state_id",
      "split_policy_digest",
      "dependency_graph_sha256",
      "assets",
      "dependency_edges"
    ],
    "reject_on": [
      "missing_asset",
      "duplicate_asset_id",
      "duplicate_locator_unless_declared_shared",
      "byte_length_mismatch",
      "sha256_mismatch",
      "manifest_digest_mismatch",
      "invalid_locator",
      "path_escape"
    ],
    "canonicalization_version": "serde_json_v1_sorted_inventory",
    "portable_path_policy": {
      "relative_paths_only": true,
      "forward_slashes_only": true,
      "reject_parent_or_current_components": true,
      "reject_windows_drive_or_stream_colon": true,
      "reject_symlink_components": true,
      "reject_case_insensitive_path_collisions": false,
      "reject_windows_reserved_components": true,
      "reject_ascii_case_insensitive_path_collisions": true
    }
  },
  "protocol_fingerprint": {
    "required_domains": [
      "imaging",
      "calibration",
      "illumination",
      "timing",
      "piv_processing",
      "flow_and_system",
      "tracer_and_observer",
      "reference"
    ],
    "mismatch_disposition": "ProtocolMismatch",
    "pooling_different_fingerprints_by_default": false
  },
  "reference_assessment": {
    "independence_status": [
      "independent",
      "partially_shared",
      "dependent",
      "unknown"
    ],
    "required_fields": [
      "reference_id",
      "modality",
      "measurand",
      "instrument_identity",
      "calibration_evidence",
      "validity_interval",
      "operating_range",
      "resolution",
      "bandwidth",
      "response_time",
      "spatial_temporal_transfer_function",
      "drift_assessment",
      "coordinate_registration",
      "time_synchronization",
      "uncertainty_budget",
      "shared_causes",
      "independence_status",
      "supported_claim"
    ],
    "unknown_or_dependent_blocks_piv_only_claim": true,
    "synthetic_truth_scope": "software_verification_not_physical_ehd_validation",
    "same_source_image_reprocessing_is_independent": false
  },
  "observer_state": {
    "required": true,
    "contract_owner": "EHD-PIV-UQ-009",
    "required_fields": [
      "tracer_material",
      "particle_properties",
      "concentration",
      "seeding_start_stop",
      "illumination_state",
      "probe_and_lpt_state",
      "time_since_introduction",
      "washout_state",
      "humidity",
      "temperature",
      "pressure",
      "voltage",
      "current",
      "polarity",
      "electrode_condition",
      "randomized_block_id",
      "schedule_digest"
    ],
    "nonperturbative_claim_requires_predeclared_equivalence_margin": true
  },
  "evidence_receipt": {
    "append_only": true,
    "bind": [
      "source_manifest_digest",
      "asset_digests",
      "dependency_graph_digest",
      "split_policy_digest",
      "protocol_fingerprint",
      "reference_assessment_id",
      "common_mode_model_digest",
      "observer_state_id",
      "processing_source_and_config_digest",
      "derived_field_digest",
      "residual_manifest_digest",
      "fit_config_and_calibration_manifest_digest",
      "validation_manifest_and_disposition",
      "covariance_parameter_uncertainty_digest",
      "functional_result_and_decision_digest",
      "build_and_commit_identity"
    ],
    "replay_against_mutated_binding": "reject"
  },
  "qualification_dispositions": [
    "EvidenceIntegrityFailed",
    "DependenceOverlap",
    "ReferenceUnknown",
    "ReferenceInadequate",
    "CommonModeUnresolved",
    "ObserverEffectUnresolved",
    "ProtocolMismatch",
    "ResidualCovarianceQualified",
    "MeasurementQualifiedForFunctional"
  ],
  "fail_closed_rules": {
    "unknown_or_missing_reference_evidence": "no_piv_only_claim",
    "unknown_cross_covariance": "residual_covariance_only",
    "shared_cause_crosses_cohort": "reject_partition",
    "raw_asset_digest_mismatch": "reject_before_processing",
    "covariance_receipt_without_bias_and_functional_gates": "cannot_qualify_engineering_decision"
  },
  "prospective_acceptance_targets": [
    {
      "metric": "source_asset_byte_hash_verification_fraction",
      "target": 1,
      "status": "not_measured"
    },
    {
      "metric": "dependence_component_overlap_across_cohorts",
      "target": 0,
      "status": "not_measured"
    },
    {
      "metric": "piv_only_exports_with_unknown_reference_or_cross_covariance",
      "target": 0,
      "status": "not_measured"
    },
    {
      "metric": "successful_receipt_replay_after_bound_input_mutation",
      "target": 0,
      "status": "not_measured"
    },
    {
      "metric": "engineering_decision_exports_from_covariance_only_receipt",
      "target": 0,
      "status": "not_measured"
    }
  ],
  "benchmark_separation": {
    "synthetic_truth": "software_verification_and_adversarial_controls",
    "physical_ehd": "separate_reference_and_experiment_validation_cohort",
    "vector_classifier_scores": "separate_from_field_and_function_coverage",
    "processing_throughput": "matched_hardware_and_configuration_lane"
  },
  "references": {
    "piv_spatial_uncertainty": "https://doi.org/10.1088/0957-0233/27/8/084006",
    "pivtools_2026": "https://doi.org/10.1016/j.softx.2026.102967",
    "pivpostprocess_2026": "https://doi.org/10.1007/s00348-026-04319-7",
    "ffs_s_piv": "https://doi.org/10.5281/zenodo.21732072",
    "asme_vv20": "https://www.asme.org/codes-standards/find-codes-standards/standard-for-verification-and-validation-in-computational-fluid-dynamics-and-heat-transfer",
    "nistir_8298": "https://doi.org/10.6028/NIST.IR.8298",
    "ehd_observer_effect_air": "https://doi.org/10.1007/s00348-026-04322-y",
    "ehd_observer_effect_liquid": "https://doi.org/10.1016/j.elstat.2026.104261"
  },
  "implementation": {
    "crate_path": "tools/ehd-piv-acquisition-evidence/",
    "canonicalization_version": "serde_json_v1_sorted_inventory",
    "source_asset_hashing": "streaming_sha256_and_byte_count_from_same_read_stream",
    "manifest_verification": "manifest_digest_then_rehash_every_file_before_processing",
    "cohort_partition": "source_manifest_bound_union_find_dependency_components_and_pairwise_disjoint_roles",
    "reference_claim_gate": "metadata_eligibility_only_not_authentication_or_deconvolution",
    "authored_negative_control_count": 21,
    "filesystem_threat_model": "symlink_and_path_escape_rejection; not race_hardened_against_concurrent_local_adversary",
    "validation_state": {
      "rust_format": "not_run",
      "rust_compile": "not_run",
      "rust_tests": "authored_not_run",
      "clippy": "not_run",
      "hosted_ci": "pending_or_not_yet_observed"
    },
    "ci_integration": {
      "workflow": ".github/workflows/ci.yml",
      "mode": "conditional_three_os_steps_when_standalone_cargo_manifest_exists",
      "commands": [
        "cargo fmt --manifest-path ... -- --check",
        "cargo test --manifest-path ...",
        "cargo clippy --manifest-path ... --all-targets -- -D warnings"
      ]
    },
    "complete_cohort_cover": "all_manifest_dependence_components_must_be_assigned_exactly_once"
  },
  "nonclaims": [
    "reference verifier Rust tests, compilation, rustfmt and Clippy have not yet passed in the authoring environment",
    "file digest verification does not authenticate source authorship, custody, calibration validity or physical truth",
    "filesystem path checks are not race-hardened against a concurrent hostile local writer"
  ]
}
