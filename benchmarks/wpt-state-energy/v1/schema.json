{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://luminousdynamics.io/schemas/wpt-state-energy/v1/schema.json",
  "title":"WPT state-derived storage energy record v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","record_id","mode_id","topology_sha256","model_class","inductance","capacitance"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "record_id":{"type":"string","minLength":1,"maxLength":128},
    "mode_id":{"type":"string","minLength":1,"maxLength":128},
    "topology_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "model_class":{"const":"LINEAR_RECIPROCAL_QUASI_STATIC"},
    "expected_disposition":{"enum":["STORED_ENERGY_DERIVED","STORAGE_MODEL_REJECTED","STORAGE_MODEL_UNRESOLVED","INVALID_INPUT"]},
    "inductance":{"$ref":"#/$defs/inductance"},
    "capacitance":{"$ref":"#/$defs/capacitance"}
  },
  "$defs":{
    "nonnegative":{"type":"number","minimum":0},
    "matrix":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"number"}}},
    "nonnegativeMatrix":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/nonnegative"}}},
    "vector":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"number"}},
    "nonnegativeVector":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/nonnegative"}},
    "inductance":{
      "type":"object","additionalProperties":false,
      "required":["matrix_unit","matrix_h","abs_uncertainty_h","state_unit","current_a","current_abs_uncertainty_a"],
      "properties":{
        "matrix_unit":{"const":"H"},"matrix_h":{"$ref":"#/$defs/matrix"},"abs_uncertainty_h":{"$ref":"#/$defs/nonnegativeMatrix"},
        "state_unit":{"const":"A"},"current_a":{"$ref":"#/$defs/vector"},"current_abs_uncertainty_a":{"$ref":"#/$defs/nonnegativeVector"}
      }
    },
    "capacitance":{
      "type":"object","additionalProperties":false,
      "required":["matrix_unit","matrix_f","abs_uncertainty_f","state_unit","voltage_v","voltage_abs_uncertainty_v"],
      "properties":{
        "matrix_unit":{"const":"F"},"matrix_f":{"$ref":"#/$defs/matrix"},"abs_uncertainty_f":{"$ref":"#/$defs/nonnegativeMatrix"},
        "state_unit":{"const":"V"},"voltage_v":{"$ref":"#/$defs/vector"},"voltage_abs_uncertainty_v":{"$ref":"#/$defs/nonnegativeVector"}
      }
    }
  }
}
