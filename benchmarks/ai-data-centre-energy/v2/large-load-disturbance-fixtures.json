{
  "schema_version": "symtropy.large-load-disturbance-fixtures.v1",
  "protocol": "GRID-DISTURBANCE-001",
  "evidence_class": "SYNTHETIC_KNOWN_TRUTH",
  "claim_boundary": "observable PCC RMS trace conformance to pinned operator-defined limits only; not converter internal stability, positive-sequence dynamic model validity, EMT/PDT, protection, harmonic compliance, grid-code certification or ELCC",
  "base_requirement": {
    "requirement_id": "operator-rule-1",
    "version": "2026.1",
    "jurisdiction": "operator-region-a",
    "source_digest": "sha256:requirement",
    "pcc_id": "pcc-1",
    "nominal_frequency_hz": 50,
    "horizon_ns": 4000000000,
    "segments": [
      {
        "start_elapsed_ns": 0,
        "end_elapsed_ns": 2000000000,
        "min_voltage_pu": 0.1,
        "max_voltage_pu": 1.2,
        "min_frequency_hz": 47,
        "max_frequency_hz": 52,
        "max_abs_rocof_hz_s": 2,
        "connection": "must_remain_connected"
      },
      {
        "start_elapsed_ns": 2000000000,
        "end_elapsed_ns": 4000000000,
        "min_voltage_pu": 0.9,
        "max_voltage_pu": 1.1,
        "min_frequency_hz": 49,
        "max_frequency_hz": 51,
        "max_abs_rocof_hz_s": 1,
        "connection": "must_remain_connected"
      }
    ],
    "recovery": {
      "min_recovered_voltage_pu": 0.9,
      "recovered_frequency_hz": [
        49,
        51
      ],
      "stable_dwell_ns": 500000000,
      "deadline_after_dwell_ns": 500000000,
      "min_power_fraction": 0.9,
      "max_overshoot_fraction": 0.1,
      "max_abs_ramp_mw_s": 20
    }
  },
  "cases": [
    {
      "case_id": "in-envelope-stay-connected-recovery-pass",
      "expected": {
        "ride_through": true,
        "connection": true,
        "recovery": true,
        "qualified": true,
        "dr_credit": false
      }
    },
    {
      "case_id": "must-stay-connected-zone-trips",
      "expected": {
        "ride_through": true,
        "connection": false,
        "unexpected_trip": true,
        "qualified": false,
        "dr_credit": false
      }
    },
    {
      "case_id": "operator-permitted-momentary-cessation-under-duration",
      "expected": {
        "connection": true,
        "qualified": true
      }
    },
    {
      "case_id": "momentary-cessation-exceeds-duration",
      "expected": {
        "connection": false,
        "qualified": false
      }
    },
    {
      "case_id": "voltage-outside-operator-boundary",
      "expected": {
        "ride_through": false,
        "qualified": false
      }
    },
    {
      "case_id": "frequency-outside-operator-boundary",
      "expected": {
        "ride_through": false,
        "qualified": false
      }
    },
    {
      "case_id": "rocof-over-operator-threshold",
      "expected": {
        "rocof_pass": false,
        "qualified": false
      }
    },
    {
      "case_id": "recovery-ramp-boundary-crossing-spike",
      "expected": {
        "recovery": false,
        "qualified": false
      }
    },
    {
      "case_id": "recovery-overshoot-over-limit",
      "expected": {
        "recovery": false,
        "qualified": false
      }
    },
    {
      "case_id": "recovery-never-stabilizes",
      "expected": {
        "recovery_condition_observed": false,
        "qualified": false
      }
    },
    {
      "case_id": "critical-sample-gap",
      "expected": {
        "accepted": false,
        "reason": "sample_gap_exceeds_contract"
      }
    },
    {
      "case_id": "trace-shorter-than-pinned-horizon",
      "expected": {
        "accepted": false,
        "reason": "observation_horizon_incomplete"
      }
    },
    {
      "case_id": "waveform-sample-at-exclusive-horizon-end",
      "expected": {
        "accepted": false,
