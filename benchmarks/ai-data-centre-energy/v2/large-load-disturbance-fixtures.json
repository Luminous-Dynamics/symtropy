    },
    {
      "case_id": "load-trip-never-credited-as-dispatch",
      "expected": {
        "dr_credit": false
      }
    },
    {
      "case_id": "initial-waveform-coverage-gap",
      "first_sample_offset_ns": 100000000,
      "maximum_sample_gap_ns": 50000000,
      "expected": {
        "accepted": false,
        "reason": "initial_sample_gap_exceeds_contract"
      }
    },
    {
      "case_id": "required-reactive-power-or-current-missing",
      "missing_channel": "reactive_power_mvar",
      "expected": {
        "accepted": false,
        "reason": "missing_required_channel"
      }
    },
    {
      "case_id": "reactive-power-outside-operator-envelope",
      "reactive_power_mvar": 6,
      "operator_range_mvar": [
        -5,
        5
      ],
      "expected": {
        "qualified": false,
        "reason": "reactive_current_envelope_violation"
      }
    },
    {
      "case_id": "pcc-current-over-operator-limit",
