      }
    },
    {
      "case_id": "stale-requirement-version",
      "expected": {
        "accepted": false,
        "reason": "requirement_identity_mismatch"
      }
    },
    {
      "case_id": "wrong-pcc-reference-point",
      "expected": {
        "accepted": false,
        "reason": "pcc_identity_mismatch"
      }
    },
    {
      "case_id": "clock-uncertainty-too-large",
      "expected": {
        "accepted": false,
        "reason": "clock_uncertainty_exceeds_contract"
      }
    },
    {
      "case_id": "rms-window-too-long",
      "expected": {
        "accepted": false,
        "reason": "rms_window_exceeds_contract"
      }
    },
    {
      "case_id": "insufficient-measurement-bandwidth",
      "expected": {
        "accepted": false,
        "reason": "measurement_bandwidth_below_contract"
