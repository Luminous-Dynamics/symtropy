    "momentary_cessation_duration_exceeded",
    "active_power_recovery_misses_deadline",
    "recovery_ramp_limit_exceeded",
    "post_fault_overshoot_exceeded",
    "recovery_stability_condition_never_observed",
    "waveform_initial_sample_missing_beyond_cadence",
    "waveform_sample_rate_below_nyquist_for_declared_bandwidth",
    "reactive_power_or_current_channel_missing_when_operator_requires_it",
    "PCC_reactive_power_exceeds_operator_envelope",
    "PCC_current_exceeds_operator_limit"
