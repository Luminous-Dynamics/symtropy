{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/wpt-hybrid-transition/v1/schema.json",
  "title": "WPT hybrid mode transition energy receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "transition_stream_id",
    "transition_sequence",
    "event_time_ns",
    "event_window",
    "pre_mode",
    "post_mode",
    "switch_event"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "transition_stream_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "transition_sequence": { "type": "integer", "minimum": 0 },
    "event_time_ns": { "type": "integer", "minimum": 0 },
    "event_window": { "$ref": "#/$defs/eventWindow" },
    "expected_disposition": {
      "enum": [
        "PASSIVE_TRANSITION_CERTIFIED",
        "ENERGY_GENERATING_REJECTED",
        "ENERGY_GENERATION_UNRESOLVED",
        "ENERGY_BALANCE_UNRESOLVED",
        "ENERGY_TANK_RESERVE_UNRESOLVED",
        "MODE_UNQUALIFIED",
        "INVALID_INPUT"
      ]
    },
    "pre_mode": { "$ref": "#/$defs/mode" },
    "post_mode": { "$ref": "#/$defs/mode" },
    "energy_tank": { "$ref": "#/$defs/energyTank" },
    "switch_event": { "$ref": "#/$defs/switchEvent" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "eventWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ns", "end_ns"],
      "properties": {
        "start_ns": { "type": "integer", "minimum": 0 },
        "end_ns": { "type": "integer", "minimum": 1 }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode_id",
        "topology_sha256",
        "certificate_status",
        "certificate_sha256",
        "stored_energy_j",
        "energy_uncertainty_j",
        "state_dimension"
      ],
      "properties": {
        "mode_id": { "type": "string", "minLength": 1 },
        "topology_sha256": { "$ref": "#/$defs/digest" },
        "certificate_status": {
          "enum": ["PASSIVE_CERTIFIED", "UNRESOLVED", "NOT_PROVIDED", "REJECTED"]
        },
        "certificate_sha256": { "$ref": "#/$defs/digest" },
        "stored_energy_j": { "$ref": "#/$defs/nonnegative" },
        "energy_uncertainty_j": { "$ref": "#/$defs/nonnegative" },
        "state_dimension": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "energyTank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_energy_j",
        "pre_energy_uncertainty_j",
        "post_energy_j",
        "post_energy_uncertainty_j"
      ],
      "properties": {
        "pre_energy_j": { "$ref": "#/$defs/nonnegative" },
        "pre_energy_uncertainty_j": { "$ref": "#/$defs/nonnegative" },
        "post_energy_j": { "$ref": "#/$defs/nonnegative" },
        "post_energy_uncertainty_j": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "switchEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_kind",
        "mapping_sha256",
        "tolerance_policy_sha256",
        "port_energy_receipt_sha256",
        "switch_work_receipt_sha256",
        "dissipation_receipt_sha256",
        "state_mapping_receipt_sha256",
        "source_state_dimension",
        "target_state_dimension",
        "switch_work_net_j",
        "switch_work_uncertainty_j",
        "port_net_energy_j",
        "port_net_energy_uncertainty_j",
        "event_dissipation_j",
        "event_dissipation_uncertainty_j",
        "absolute_tolerance_j",
        "relative_tolerance"
      ],
      "properties": {
        "mapping_kind": {
          "enum": [
            "IDENTITY",
            "CHARGE_FLUX_CONSISTENT",
            "ENERGY_MINIMIZING",
            "DECLARED_PHYSICAL_RESET",
            "ENERGY_TANK"
          ]
        },
        "mapping_sha256": { "$ref": "#/$defs/digest" },
        "tolerance_policy_sha256": { "$ref": "#/$defs/digest" },
        "port_energy_receipt_sha256": { "$ref": "#/$defs/digest" },
        "switch_work_receipt_sha256": { "$ref": "#/$defs/digest" },
        "dissipation_receipt_sha256": { "$ref": "#/$defs/digest" },
        "state_mapping_receipt_sha256": { "$ref": "#/$defs/digest" },
        "source_state_dimension": { "type": "integer", "minimum": 1, "maximum": 256 },
        "target_state_dimension": { "type": "integer", "minimum": 1, "maximum": 256 },
        "switch_work_net_j": { "type": "number" },
        "switch_work_uncertainty_j": { "$ref": "#/$defs/nonnegative" },
        "port_net_energy_j": { "type": "number" },
        "port_net_energy_uncertainty_j": { "$ref": "#/$defs/nonnegative" },
        "event_dissipation_j": { "$ref": "#/$defs/nonnegative" },
        "event_dissipation_uncertainty_j": { "$ref": "#/$defs/nonnegative" },
        "absolute_tolerance_j": { "$ref": "#/$defs/nonnegative" },
        "relative_tolerance": { "type": "number", "minimum": 0, "maximum": 0.005 }
      }
    }
  }
}
