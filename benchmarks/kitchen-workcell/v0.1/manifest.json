      "target_ratio_max": 0.9,
      "notes": "Exploratory target: at least 10% lower than best matched baseline without worse food quality or safety."
    },
    {
      "metric_id": "user_present_time_per_accepted_meal",
      "unit": "minutes/accepted meal",
      "denominator": "accepted meal",
      "method": "timestamped direct observation; separate total elapsed time",
      "evidence_class": "measured",
      "target_ratio_max": 0.85,
      "notes": "Exploratory target: at least 15% lower; no substitution of unattended elapsed time."
    },
    {
      "metric_id": "particle_size_cv",
      "unit": "coefficient of variation",
      "denominator": "all sampled output particles by mass/size method",
      "method": "predeclared image/sieve measurement with calibration and sampling plan",
      "evidence_class": "assayed",
      "target_ratio_max": 0.75,
      "notes": "Exploratory target: at least 25% reduction without greater fines or yield loss."
    },
    {
      "metric_id": "avoidable_prep_loss_fraction",
      "unit": "fraction of edible input mass",
      "denominator": "edible input mass",
      "method": "tare-corrected mass balance of input, accepted output, residue and declared inedible trim",
      "evidence_class": "measured",
      "target_ratio_max": 0.8,
      "notes": "Exploratory target: at least 20% reduction in avoidable trim and transfer loss."
    },
    {
      "metric_id": "sensory_liking_9pt",
      "unit": "points on 9-point liking scale",
      "denominator": "valid blinded panel responses",
      "method": "randomized blinded consumer or trained panel protocol, prespecified analysis",
      "evidence_class": "assayed",
      "non_inferiority_margin": 0.5,
      "notes": "Non-inferiority margin is exploratory and requires power calculation before confirmatory trial."
    },
    {
      "metric_id": "food_safety_validation",
      "unit": "not a numeric optimization metric",
      "denominator": "product-specific independent conformity and food-safety evidence",
      "method": "competent laboratory and applicable authority review",
      "evidence_class": "assayed",
      "notes": "Hard gate; no AI estimate or modelled microbial lethality is accepted as qualification."
    },
    {
      "metric_id": "cleaning_time",
      "unit": "seconds/task",
      "denominator": "complete post-task cleaning cycle",
      "method": "timestamped observation under frozen cleaning procedure",
      "evidence_class": "measured"
    }
