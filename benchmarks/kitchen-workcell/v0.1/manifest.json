  "metrics": [
    {
      "metric_id": "energy_wh_per_accepted_serving",
      "unit": "Wh/accepted serving",
      "denominator": "accepted edible serving count",
      "method": "calibrated mains power meter; include preheat, cook, release, transfer and cleaning where assigned to task",
