{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/kitchen/KitchenRobotEpisodeReceiptV1.schema.json",
  "title": "KitchenRobotEpisodeReceiptV1",
  "description": "Evidence receipt for one Kitchen-R style simulated kitchen episode. Simulation only; it does not establish physical robot, appliance, food-safety or culinary-quality qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "episode_id",
    "mode",
    "instruction_id",
    "source_ref",
    "rights_status",
    "episode_seed",
    "simulator",
    "robot",
    "initial_state_sha256",
    "perturbations",
    "planning",
    "control",
    "integration",
    "evidence_class",
    "claim_ceiling",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "const": "kitchen-r-adapter-v1"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "planning_only",
        "low_level_control_only",
        "integrated"
      ]
    },
    "instruction_id": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "rights_status": {
      "enum": [
        "public_domain",
        "licensed",
        "user_supplied",
        "permission_granted",
        "unknown",
        "restricted"
      ]
    },
    "episode_seed": {
      "type": "integer",
      "minimum": 0
    },
    "simulator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "scene_id",
        "asset_manifest_sha256",
        "physics_config_ref"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "physics_config_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "revision"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "initial_state_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "perturbations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "time_ms",
          "severity",
          "source_ref"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "time_ms": {
            "type": "integer",
            "minimum": 0
          },
          "severity": {
            "type": "number",
            "minimum": 0
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "status",
        "success",
        "plan_ref",
        "verifier_ref",
        "temporal_violation_count",
        "resource_conflict_count",
        "repair_count"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_run",
            "valid",
            "invalid",
            "timeout",
            "error"
          ]
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "plan_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "verifier_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "temporal_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "resource_conflict_count": {
          "type": "integer",
          "minimum": 0
        },
        "repair_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executed",
        "status",
        "success",
        "policy_revision",
        "subtask_attempt_count",
        "subtask_success_count",
        "timeout_count",
        "collision_count",
        "constraint_violation_count",
        "execution_time_s"
      ],
      "properties": {
        "executed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not_run",
            "success",
            "partial",
            "failed",
            "timeout",
            "error"
          ]
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "policy_revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "subtask_attempt_count": {
          "type": "integer",
          "minimum": 0
        },
        "subtask_success_count": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_count": {
          "type": "integer",
          "minimum": 0
        },
        "collision_count": {
          "type": "integer",
          "minimum": 0
        },
        "constraint_violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "execution_time_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_reached",
        "human_takeover",
        "human_takeover_count",
        "recovery_attempts",
        "environment_restored",
        "final_state_sha256"
      ],
      "properties": {
        "goal_reached": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "human_takeover": {
          "type": "boolean"
        },
        "human_takeover_count": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "success",
              "duration_s"
            ],
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "success": {
                "type": "boolean"
              },
              "duration_s": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "environment_restored": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "final_state_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "evidence_class": {
      "const": "simulated"
    },
    "claim_ceiling": {
      "const": "Simulated Kitchen-R episode evidence only; not physical robot safety, appliance compatibility, food safety, hygiene, taste, or real meal-quality qualification."
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audit_status",
        "claim_state",
        "spec_registry_ref",
        "spec_results",
        "applicable_spec_count",
        "satisfied_spec_count",
        "violated_spec_count",
        "unknown_spec_count",
        "signal_coverage_rate",
        "success_but_unsafe",
        "worst_violation_severity_index",
        "hazard_triggered",
        "safe_stop_success",
        "safe_stop_latency_ms",
        "native_task_success",
        "safe_stop_bound_ms"
      ],
      "properties": {
        "audit_status": {
          "enum": [
            "not_run",
            "complete",
            "incomplete",
            "invalid",
            "error"
          ]
        },
        "claim_state": {
          "enum": [
            "not_claimed",
            "safe_under_declared_specs",
            "unsafe",
            "indeterminate"
          ]
        },
        "spec_registry_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "spec_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spec_id",
              "family",
              "applicability",
              "applicability_reason",
              "status",
              "robustness_score",
              "violation_severity",
              "method_ref",
              "required_signal_refs",
              "observed_signal_refs"
            ],
            "properties": {
              "spec_id": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "enum": [
                  "arm_contact_force",
                  "target_contact_force",
                  "aggregate_contact_force",
                  "bystander_displacement",
                  "held_object_stability",
                  "grasp_slip",
                  "joint_torque",
                  "self_collision",
                  "appliance_boundary",
                  "thermal_exposure",
                  "pressure_boundary",
                  "other"
                ]
              },
              "applicability": {
                "enum": [
                  "applicable",
                  "not_applicable",
                  "unknown"
                ]
              },
              "applicability_reason": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "status": {
                "enum": [
                  "satisfied",
                  "violated",
                  "unknown",
                  "not_applicable"
                ]
              },
              "robustness_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "violation_severity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "method_ref": {
                "type": "string",
                "minLength": 1
              },
              "required_signal_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "observed_signal_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "enum": [
                        "satisfied",
                        "violated"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "applicability": {
                      "const": "applicable"
                    },
                    "robustness_score": {
                      "type": "number"
                    },
                    "required_signal_refs": {
                      "minItems": 1
                    },
                    "observed_signal_refs": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "violated"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "violation_severity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "not_applicable"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "applicability": {
                      "const": "not_applicable"
                    },
                    "applicability_reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required_signal_refs": {
                      "maxItems": 0
                    },
                    "observed_signal_refs": {
                      "maxItems": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "unknown"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "robustness_score": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        },
        "applicable_spec_count": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied_spec_count": {
          "type": "integer",
          "minimum": 0
        },
        "violated_spec_count": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_spec_count": {
          "type": "integer",
          "minimum": 0
        },
        "signal_coverage_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "success_but_unsafe": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "worst_violation_severity_index": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "hazard_triggered": {
          "type": "boolean"
        },
        "safe_stop_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "safe_stop_latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "native_task_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "safe_stop_bound_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_state": {
                "const": "safe_under_declared_specs"
              }
            },
            "required": [
              "claim_state"
            ]
          },
          "then": {
            "properties": {
              "audit_status": {
                "const": "complete"
              },
              "applicable_spec_count": {
                "minimum": 1
              },
              "violated_spec_count": {
                "const": 0
              },
              "unknown_spec_count": {
                "const": 0
              },
              "signal_coverage_rate": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_state": {
                "const": "unsafe"
              }
            },
            "required": [
              "claim_state"
            ]
          },
          "then": {
            "properties": {
              "audit_status": {
                "const": "complete"
              },
              "violated_spec_count": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "claim_state": {
                "const": "indeterminate"
              }
            },
            "required": [
              "claim_state"
            ]
          },
          "then": {
            "properties": {
              "audit_status": {
                "enum": [
                  "incomplete",
                  "invalid",
                  "error"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "audit_status": {
                "const": "not_run"
              }
            },
            "required": [
              "audit_status"
            ]
          },
          "then": {
            "properties": {
              "claim_state": {
                "const": "not_claimed"
              },
              "spec_results": {
                "maxItems": 0
              },
              "applicable_spec_count": {
                "const": 0
              },
              "satisfied_spec_count": {
                "const": 0
              },
              "violated_spec_count": {
                "const": 0
              },
              "unknown_spec_count": {
                "const": 0
              },
              "signal_coverage_rate": {
                "type": "null"
              },
              "success_but_unsafe": {
                "type": "null"
              },
              "worst_violation_severity_index": {
                "type": "null"
              },
              "safe_stop_success": {
                "type": "null"
              },
              "safe_stop_latency_ms": {
                "type": "null"
              },
              "native_task_success": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "safe_stop_bound_ms": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "planning_only"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "planning": {
            "properties": {
              "executed": {
                "const": true
              }
            }
          },
          "control": {
            "properties": {
              "executed": {
                "const": false
              },
              "status": {
                "const": "not_run"
              },
              "success": {
                "type": "null"
              }
            }
          },
          "integration": {
            "properties": {
              "goal_reached": {
                "type": "null"
              },
              "environment_restored": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "low_level_control_only"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "planning": {
            "properties": {
              "executed": {
                "const": false
              },
              "status": {
                "const": "not_run"
              },
              "success": {
                "type": "null"
              }
            }
          },
          "control": {
            "properties": {
              "executed": {
                "const": true
              }
            }
          },
          "integration": {
            "properties": {
              "goal_reached": {
                "type": "null"
              },
              "environment_restored": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "integrated"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "planning": {
            "properties": {
              "executed": {
                "const": true
              }
            }
          },
          "control": {
            "properties": {
              "executed": {
                "const": true
              }
            }
          },
          "integration": {
            "properties": {
              "goal_reached": {
                "type": "boolean"
              },
              "environment_restored": {
                "type": "boolean"
              },
              "final_state_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integration": {
            "properties": {
              "human_takeover": {
                "const": false
              }
            }
          }
        },
        "required": [
          "integration"
        ]
      },
      "then": {
        "properties": {
          "integration": {
            "properties": {
              "human_takeover_count": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
