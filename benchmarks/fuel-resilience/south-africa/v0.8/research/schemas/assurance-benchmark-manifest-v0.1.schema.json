{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/safrb/assurance-benchmark-manifest-v0.1.schema.json",
  "title": "SAFRB Assurance Benchmark Manifest v0.1",
  "description": "A preregistration contract for one frozen benchmark case. It distinguishes raw inputs, canonical model identity, objective semantics, comparator configuration, independent oracle, resource budget and qualification outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "benchmark_id",
    "case_id",
    "lane",
    "status",
    "source",
    "input_artifacts",
    "model_contract",
    "objective",
    "comparators",
    "oracle",
    "resource_budget",
    "mutation_families",
    "claim_ceiling"
  ],
  "properties": {
    "manifest_version": {
      "const": "safrb-assurance-benchmark-manifest-v0.1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "enum": [
        "solver",
        "model_semantics",
        "evidence_integrity",
        "coherent_scenarios",
        "service_outcomes",
        "interop",
        "nonanticipative_policy"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "frozen",
        "executed",
        "independently_verified",
        "retired"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "uri",
        "license"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dimacs_official",
            "derived_synthetic",
            "owner_authorized_replay",
            "vendor_sandbox",
            "field_observation",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        },
        "generator_version": {
          "type": "string"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "owner_authorization_ref": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_role",
          "uri",
          "digest_algorithm",
          "digest"
        ],
        "properties": {
          "artifact_role": {
            "enum": [
              "raw_input",
              "evidence_bundle",
              "schema",
              "calendar",
              "model_input",
              "reference_output",
              "other"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "digest_algorithm": {
            "enum": [
              "sha256",
              "git_blob_sha1",
              "other"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{40,64}$"
          },
          "revision": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "model_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_class",
        "schema_version",
        "commodity_ref",
        "unit_ref",
        "quantity_boundary_ref",
        "timebase_ref"
      ],
      "properties": {
        "model_class": {
          "enum": [
            "single_commodity_max_flow",
            "single_commodity_min_cost_flow",
            "temporal_single_commodity_flow",
            "coherent_temporal_scenarios",
            "multi_commodity",
            "process_coupled",
            "integer_schedule",
            "electrical_power_flow",
            "other",
            "nonanticipative_scenario_tree"
          ]
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "canonical_model_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "commodity_ref": {
          "type": "string",
          "minLength": 1
        },
        "unit_ref": {
          "type": "string",
          "minLength": 1
        },
        "quantity_boundary_ref": {
          "type": "string",
          "minLength": 1
        },
        "timebase_ref": {
          "type": "string",
          "minLength": 1
        },
        "admission_profile": {
          "type": "string"
        },
        "unsupported_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision_timing": {
          "enum": [
            "here_and_now",
            "full_recourse",
            "two_stage_nonanticipative",
            "multi_stage_nonanticipative"
          ],
          "description": "Decision-time contract. Comparisons across different timing/recourse assumptions are invalid."
        },
        "information_set_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Digest of canonical decision-time information sets."
        },
        "scenario_tree_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Digest of the exact rooted scenario tree and observation/revelation schedule."
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_components",
        "scalarization"
      ],
      "properties": {
        "ordered_components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "direction",
              "meaning"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "maximize",
                  "minimize",
                  "fixed"
                ]
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "unit": {
                "type": "string"
              }
            }
          }
        },
        "scalarization": {
          "enum": [
            "none",
            "exact_sequential_passes",
            "proved_equivalent_scalarization",
            "unsupported"
          ]
        },
        "objective_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "cost_authority_ref": {
          "type": "string",
          "description": "Required when cost is claimed to represent a tariff, market price or other external value."
        }
      }
    },
    "comparators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "configuration_digest"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "configuration_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "role": {
            "enum": [
              "primary",
              "secondary",
              "production_baseline",
              "independent_verifier"
            ]
          },
          "license": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "independence",
        "expected_disposition"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exhaustive_integral",
            "independent_solver",
            "analytical",
            "owner_record",
            "measured_field",
            "none"
          ]
        },
        "independence": {
          "enum": [
            "independent_physical_quantity",
            "independent_implementation",
            "external_owner",
            "not_independent",
            "none"
          ]
        },
        "expected_disposition": {
          "enum": [
            "feasible",
            "infeasible",
            "guaranteed",
            "possible",
            "relaxation_only",
            "indeterminate",
            "unsupported",
            "not_yet_known",
            "here_and_now_feasible",
            "full_recourse_only",
            "not_feasible_within_supplied_tree"
          ]
        },
        "expected_objective_vector": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "number",
              "string"
            ]
          }
        },
        "expected_service_floors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "memory_bytes"
      ],
      "properties": {
        "wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cpu_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "hardware_manifest_ref": {
          "type": "string"
        },
        "toolchain_manifest_ref": {
          "type": "string"
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "measured_repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "decision_time_budget_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scenario_count": {
          "type": "integer",
          "minimum": 1
        },
        "decision_node_count": {
          "type": "integer",
          "minimum": 1
        },
        "policy_action_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mutation_families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "held_out": {
      "type": "boolean",
      "default": false
    },
    "run_receipt_uri": {
      "type": "string",
      "format": "uri"
    },
    "run_receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "notes": {
      "type": "string"
    }
  }
}
