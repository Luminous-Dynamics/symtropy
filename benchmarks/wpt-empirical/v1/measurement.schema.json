{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/wpt-empirical/v1/measurement.schema.json",
  "title": "Typed WPT Measurement Record v1",
  "description": "A typed observation whose physical quantity, measurement purpose, provenance, statistic and system boundary are explicit. This schema describes records; comparison eligibility additionally requires semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "measurement_id",
    "system_id",
    "quantity_kind",
    "measurement_purpose",
    "raw_measurement",
    "normalized_measurement",
    "boundary",
    "statistic",
    "evidence",
    "conditions",
    "source_refs",
    "qualification",
    "notes",
    "field_observation"
  ],
  "properties": {
    "schema_version": {
      "const": "wpt-measurement-v1"
    },
    "measurement_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$",
      "minLength": 3
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]+$",
      "minLength": 3
    },
    "quantity_kind": {
      "enum": [
        "electrical_real_power",
        "useful_load_power",
        "delivered_energy",
        "energy_per_distance",
        "end_to_end_efficiency",
        "subsystem_efficiency",
        "service_energy_replenishment_ratio",
        "electric_field_strength",
        "magnetic_field_strength",
        "magnetic_flux_density",
        "specific_absorption_rate",
        "internal_electric_field",
        "current_density",
        "contact_current",
        "mutual_inductance",
        "coupling_coefficient",
        "quality_factor",
        "temperature",
        "temperature_rise",
        "uptime_fraction",
        "fault_rate",
        "false_trigger_rate",
        "control_latency",
        "signal_to_noise_ratio",
        "bit_error_rate",
        "data_rate",
        "apparent_power",
        "reactive_power",
        "power_factor"
      ]
    },
    "measurement_purpose": {
      "enum": [
        "system_transfer_performance",
        "subsystem_characterization",
        "vehicle_service_outcome",
        "human_exposure_assessment",
        "thermal_performance",
        "operational_reliability",
        "communications_performance",
        "environmental_context"
      ]
    },
    "raw_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "upper_value",
        "unit",
        "qualifier",
        "reported_text"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "qualifier": {
          "enum": [
            "EXACT",
            "APPROX",
            "GREATER_THAN",
            "LESS_THAN",
            "RANGE",
            "NOT_REPORTED"
          ]
        },
        "reported_text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "normalized_measurement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "value",
        "upper_value",
        "unit",
        "conversion_id",
        "dimension"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "conversion_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dimension": {
          "enum": [
            "dimensionless",
            "power",
            "energy",
            "energy_per_distance",
            "electric_field",
            "magnetic_field",
            "magnetic_flux_density",
            "specific_absorption_rate",
            "inductance",
            "temperature",
            "time",
            "rate",
            "frequency",
            "data_rate"
          ]
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_class",
        "measurement_point",
        "input_plane",
        "output_plane",
        "included_stages",
        "excluded_stages",
        "boundary_signature",
        "input_plane_kind",
        "output_plane_kind",
        "stage_set_status"
      ],
      "properties": {
        "boundary_class": {
          "enum": [
            "whole_system",
            "subsystem",
            "passive_link",
            "vehicle_service",
            "component",
            "field_probe",
            "communications_link",
            "not_applicable"
          ]
        },
        "measurement_point": {
          "type": "string",
          "minLength": 1
        },
        "input_plane": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_plane": {
          "type": [
            "string",
            "null"
          ]
        },
        "included_stages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "excluded_stages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        },
        "boundary_signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_plane_kind": {
          "enum": [
            "MAINS_AC_INPUT",
            "SYSTEM_DC_INPUT",
            "PRIMARY_DC_BUS",
            "INVERTER_AC_OUTPUT",
            "RESONANT_LINK_AC_INPUT",
            "RELAY_AC_INPUT",
            "RECEIVER_AC_OUTPUT",
            "RECTIFIED_DC_OUTPUT",
            "SECONDARY_DC_BUS",
            "BATTERY_DC_TERMINAL",
            "USEFUL_LOAD_DC",
            "LASER_DRIVER_DC_INPUT",
            "LASER_DRIVER_OUTPUT",
            "PV_DC_OUTPUT",
            "VEHICLE_TRACTION_ENERGY_CONSUMED",
            "VEHICLE_ENERGY_REPLENISHED",
            "FIELD_PROBE_UNLOCATED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "output_plane_kind": {
          "enum": [
            "MAINS_AC_INPUT",
            "SYSTEM_DC_INPUT",
            "PRIMARY_DC_BUS",
            "INVERTER_AC_OUTPUT",
            "RESONANT_LINK_AC_INPUT",
            "RELAY_AC_INPUT",
            "RECEIVER_AC_OUTPUT",
            "RECTIFIED_DC_OUTPUT",
            "SECONDARY_DC_BUS",
            "BATTERY_DC_TERMINAL",
            "USEFUL_LOAD_DC",
            "LASER_DRIVER_DC_INPUT",
            "LASER_DRIVER_OUTPUT",
            "PV_DC_OUTPUT",
            "VEHICLE_TRACTION_ENERGY_CONSUMED",
            "VEHICLE_ENERGY_REPLENISHED",
            "FIELD_PROBE_UNLOCATED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "stage_set_status": {
          "enum": [
            "COMPLETE",
            "INCOMPLETE",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "window_s",
        "sample_count"
      ],
      "properties": {
        "kind": {
          "enum": [
            "instantaneous",
            "peak",
            "rms",
            "mean",
            "median",
            "p95",
            "integral",
            "steady_state",
            "reported_unspecified",
            "not_applicable"
          ]
        },
        "window_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "sample_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "method",
        "source_locator",
        "uncertainty"
      ],
      "properties": {
        "kind": {
          "enum": [
            "MEASURED",
            "AUTHOR_CALCULATED",
            "SIMULATED",
            "SECONDARY_REPORTED",
            "UNKNOWN"
          ]
        },
        "method": {
          "enum": [
            "instrumented_measurement",
            "author_reported_measurement",
            "calculation_from_reported_values",
            "numerical_model",
            "secondary_extraction",
            "not_reported"
          ]
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lower",
            "upper",
            "coverage_factor",
            "instrument_calibration"
          ],
          "properties": {
            "kind": {
              "enum": [
                "standard",
                "expanded",
                "confidence_interval",
                "reported_range",
                "not_reported"
              ]
            },
            "lower": {
              "type": [
                "number",
                "null"
              ]
            },
            "upper": {
              "type": [
                "number",
                "null"
              ]
            },
            "coverage_factor": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "instrument_calibration": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frequency_hz",
        "transfer_gap_m",
        "load_power_w",
        "operating_duration_s",
        "waveform",
        "alignment",
        "thermal_state",
        "medium",
        "nominal_power_class_w",
        "transfer_gap_min_m",
        "transfer_gap_max_m",
        "vehicle_ground_clearance_min_m",
        "vehicle_ground_clearance_max_m",
        "operating_mode",
        "route_distance_km",
        "vehicle_speed_mean_mps",
        "transmitter_pitch_m",
        "vehicle_energy_demand_wh_km",
        "vehicle_profile_id",
        "drive_cycle_id"
      ],
      "properties": {
        "frequency_hz": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "transfer_gap_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load_power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "operating_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "waveform": {
          "type": [
            "string",
            "null"
          ]
        },
        "alignment": {
          "type": [
            "string",
            "null"
          ]
        },
        "thermal_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "type": [
            "string",
            "null"
          ]
        },
        "nominal_power_class_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "transfer_gap_min_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "transfer_gap_max_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vehicle_ground_clearance_min_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vehicle_ground_clearance_max_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "operating_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "STATIC",
            "DYNAMIC",
            null
          ]
        },
        "route_distance_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vehicle_speed_mean_mps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "transmitter_pitch_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vehicle_energy_demand_wh_km": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vehicle_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "drive_cycle_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "PRIMARY_PUBLICATION",
              "SURVEY_SECONDARY",
              "STANDARD",
              "DATASET",
              "OTHER"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "qualification": {
      "enum": [
        "QUALIFIED_RECORD",
        "BOUNDARY_INCOMPLETE",
        "SOURCE_CLAIM_ONLY",
        "MODEL_ONLY",
        "UNRESOLVED",
        "NOT_COMPARABLE"
      ]
    },
    "notes": {
      "type": "string"
    },
    "field_observation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "probe_method",
        "probe_model",
        "position_m",
        "orientation",
        "reference_frame",
        "spatial_region",
        "averaging_method",
        "averaging_window_s"
      ],
      "properties": {
        "probe_method": {
          "enum": [
            "MEASURED",
            "SIMULATED",
            "COMBINED",
            "UNKNOWN"
          ]
        },
        "probe_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "position_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": [
                "number",
                "null"
              ]
            },
            "y": {
              "type": [
                "number",
                "null"
              ]
            },
            "z": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "orientation": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_frame": {
          "type": [
            "string",
            "null"
          ]
        },
        "spatial_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "averaging_method": {
          "enum": [
            "rms",
            "peak",
            "spatial_maximum",
            "spatial_average",
            "time_average",
            "not_reported",
            "not_applicable"
          ]
        },
        "averaging_window_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
