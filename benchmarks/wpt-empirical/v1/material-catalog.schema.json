{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/wpt-empirical/v1/material-catalog.schema.json",
  "title": "WPT Magnetic Material Evidence Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "material_id",
    "catalogue_type",
    "material_family",
    "grade",
    "manufacturer",
    "composition_description",
    "operating_frequency_hz_min",
    "operating_frequency_hz_max",
    "operating_temperature_c_min",
    "operating_temperature_c_max",
    "properties",
    "saturation_curve",
    "source_refs",
    "data_status",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "wpt-material-v1"
    },
    "material_id": {
      "type": "string",
      "pattern": "^WPT-MAT-[A-Z0-9-]+$"
    },
    "catalogue_type": {
      "enum": [
        "MATERIAL_FAMILY",
        "COMMERCIAL_GRADE",
        "CUSTOM_FORMULATION",
        "ASSEMBLY_COMPOSITE"
      ]
    },
    "material_family": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "composition_description": {
      "type": [
        "string",
        "null"
      ]
    },
    "operating_frequency_hz_min": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "operating_frequency_hz_max": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "operating_temperature_c_min": {
      "type": [
        "number",
        "null"
      ]
    },
    "operating_temperature_c_max": {
      "type": [
        "number",
        "null"
      ]
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "property_kind",
          "value",
          "unit",
          "frequency_hz",
          "temperature_c",
          "flux_density_t",
          "test_method",
          "evidence_kind",
          "source_locator",
          "uncertainty"
        ],
        "properties": {
          "property_kind": {
            "enum": [
              "relative_permeability",
              "loss_tangent",
              "core_loss_density",
              "thermal_conductivity",
              "specific_heat",
              "density",
              "electrical_resistivity",
              "tensile_strength",
              "compressive_strength",
              "flexural_strength",
              "curie_temperature",
              "saturation_flux_density",
              "coefficient_thermal_expansion",
              "other"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "frequency_hz": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "temperature_c": {
            "type": [
              "number",
              "null"
            ]
          },
          "flux_density_t": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "test_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_kind": {
            "enum": [
              "MEASURED",
              "MANUFACTURER_DATASHEET",
              "AUTHOR_CALCULATED",
              "SIMULATED",
              "SECONDARY_REPORTED",
              "UNKNOWN"
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "saturation_curve": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "temperature_c",
          "saturation_flux_density_t",
          "evidence_kind",
          "source_locator",
          "uncertainty"
        ],
        "properties": {
          "temperature_c": {
            "type": "number"
          },
          "saturation_flux_density_t": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "evidence_kind": {
            "enum": [
              "MEASURED",
              "MANUFACTURER_DATASHEET",
              "AUTHOR_CALCULATED",
              "SIMULATED",
              "SECONDARY_REPORTED",
              "UNKNOWN"
            ]
          },
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "role",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "PRIMARY_PUBLICATION",
              "MANUFACTURER_DATASHEET",
              "SURVEY_SECONDARY",
              "OTHER"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data_status": {
      "enum": [
        "UNRESOLVED",
        "PARTIAL",
        "DUAL_REVIEWED",
        "EXPERT_REVIEWED",
        "RETIRED"
      ]
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  }
}
