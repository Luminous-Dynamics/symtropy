{
  "schema_version": "maritime-contingent-recovery-fixture-v0.1",
  "dataset_id": "SYNTH-MARITIME-RECOVERY-001",
  "status": "synthetic_conformance_fixture_not_physical_data",
  "effects_enabled": false,
  "purpose": "Frozen contract examples for independent tiny-instance enumeration and hostile evidence/resource tests. Values are synthetic and must never be treated as operational maritime facts.",
  "time_model": {
    "epoch": "T0",
    "unit": "integer_minutes_from_T0",
    "interval_semantics": "[start,end)",
    "rule": "All intervals are half-open; physical resource identity, not graph edge identity, governs shared capacity."
  },
  "quantity_model": {
    "energy_unit": "synthetic_energy_unit",
    "resource_capacity_unit": "concurrent_slots",
    "rule": "No implicit conversion between rates, concurrent occupancy, and period quotas."
  },
  "canonical_policy": {
    "id": "synthetic-priority-then-earliest-feasible-v0",
    "priorities": [
      "urgent_medical_cargo",
      "time_critical_perishable",
      "standard_cargo"
    ],
    "tie_breaking": [
      "maximize_served_priority_vector_lexicographically",
      "minimize_declared_cost",
      "minimize_delay",
      "canonical_plan_id"
    ],
    "probability_claims": "none",
    "rule": "Policy ordering is frozen for conformance cases only; it is not a general fairness prescription."
  },
  "cases": [
