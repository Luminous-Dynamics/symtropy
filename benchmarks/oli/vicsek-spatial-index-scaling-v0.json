      "box_size": "L = sqrt(particle_count / number_density)",
      "interaction_radius": "R = radius_spacing_factor * ell",
      "rationale": "Holding R/ell fixed approximately holds expected local geometric degree fixed as N grows; this is the primary bounded-density scaling track."
