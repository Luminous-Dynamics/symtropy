    "spatial_index": "PeriodicNeighborIndex",
    "brute_force_reference": "Test-only all-pairs reference path for exact one-step and metric parity",
    "index_policy": {
      "cell_width": "box_size / floor(box_size / interaction_radius), with at least one cell per axis",
      "query": "periodic 3x3 cell stencil",
      "candidate_order": "ascending particle index after sort/dedup",
      "exact_filter": "minimum-image radius plus configured directed visual-sector visibility",
      "fallback": [
        "interaction radius <= 0",
        "required cell_count > 1,000,000 per axis",
        "cell_width < interaction_radius"
      ],
      "asymptotic_claim": "Expected near O(N + local candidate work) for bounded density and short range; worst case O(N^2)."
    }
  },
  "workload_design": {
