{
  "schema_version": "0.1.0",
  "benchmark_id": "WELD-MULTIMODAL-ALIGNMENT-ORACLE-001",
  "formula": "master_event_time_ns = local_timestamp_ns - clock_offset_local_minus_master_ns - sensor_response_delay_ns; combined_uncertainty_ns = clock_uncertainty_ns + latency_uncertainty_ns (conservative sum; no independence assumption).",
  "no_interpolation_across_missing_blocks": true,
  "cases": [
    {
      "case_id": "ALIGN-PROCESS-001",
      "modality": "process_current_voltage",
      "sample_interval_ns": 100000,
      "clock_offset_local_minus_master_ns": 2000,
      "sensor_response_delay_ns": 500,
      "clock_uncertainty_ns": 100,
      "latency_uncertainty_ns": 50,
      "maximum_alignment_uncertainty_ns": 500,
      "samples": [
        {
          "local_timestamp_ns": 1002500,
          "expected_master_event_time_ns": 1000000
        },
        {
          "local_timestamp_ns": 1102500,
          "expected_master_event_time_ns": 1100000
        }
      ]
    },
    {
      "case_id": "ALIGN-ROBOT-002",
      "modality": "robot_tcp",
      "sample_interval_ns": 8000000,
      "clock_offset_local_minus_master_ns": -5000,
      "sensor_response_delay_ns": 3000,
      "clock_uncertainty_ns": 1000,
      "latency_uncertainty_ns": 500,
      "maximum_alignment_uncertainty_ns": 5000,
      "samples": [
        {
          "local_timestamp_ns": 7998000,
          "expected_master_event_time_ns": 8000000
        },
        {
          "local_timestamp_ns": 15998000,
          "expected_master_event_time_ns": 16000000
        }
      ]
    },
    {
      "case_id": "ALIGN-OPCUA-003",
      "modality": "power_source_opcua",
      "sample_interval_ns": 100000000,
      "clock_offset_local_minus_master_ns": 100000,
      "sensor_response_delay_ns": 200000,
      "clock_uncertainty_ns": 20000,
      "latency_uncertainty_ns": 50000,
      "maximum_alignment_uncertainty_ns": 100000,
      "samples": [
        {
          "local_timestamp_ns": 100300000,
          "expected_master_event_time_ns": 100000000
        },
        {
          "local_timestamp_ns": 200300000,
          "expected_master_event_time_ns": 200000000
        }
      ]
    },
    {
      "case_id": "ALIGN-VIDEO-004",
      "modality": "video_trigger",
      "sample_interval_ns": 25000000,
