{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/wpt-energy-interface/v1/service-contract.schema.json",
  "title": "Typed wireless energy service event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "sequence",
    "timestamp_ns",
    "event_type",
    "session_state",
    "previous_event_sha256",
    "service",
    "source",
    "receiver",
    "authorization",
    "positioning",
    "safety",
    "measurement",
    "event_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ns": {
      "type": "integer",
      "minimum": 0
    },
    "event_type": {
      "enum": [
        "DISCOVER",
        "OFFER",
        "AUTHENTICATE",
        "RESERVE",
        "POSITION_CONFIRM",
        "ENERGIZE",
        "POWER_UPDATE",
        "HANDOVER_BEGIN",
        "RAMP_DOWN",
        "DEENERGIZE",
        "VERIFY",
        "ABORT"
      ]
    },
    "session_state": {
      "enum": [
        "DISCOVERED",
        "OFFERED",
        "AUTHENTICATED",
        "RESERVED",
        "POSITION_CONFIRMED",
        "ENERGIZED",
        "RAMPING_DOWN",
        "DEENERGIZED",
        "VERIFIED",
        "ABORTED"
      ]
    },
    "previous_event_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_disposition": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "UNRESOLVED",
        "INVALID_INPUT"
      ]
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "receiver": {
      "$ref": "#/$defs/receiver"
    },
    "authorization": {
      "$ref": "#/$defs/authorization"
    },
    "positioning": {
      "$ref": "#/$defs/positioning"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "measurement": {
      "$ref": "#/$defs/measurement"
    },
    "event_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonnegative": {
      "type": "number",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_type",
        "service_quantity",
        "service_unit",
        "measurement_method",
        "source_input_boundary_id",
        "useful_output_boundary_id",
        "requested_useful_energy_j",
        "minimum_useful_energy_j",
        "maximum_input_power_w",
        "deadline_ns",
        "flow_direction",
        "power_profile"
      ],
      "properties": {
        "service_type": {
          "enum": [
            "BATTERY_DC",
            "SHAFT_MECHANICAL",
            "PROCESS_HEAT",
            "OPTICAL_RADIANT",
            "CHEMICAL_PROCESS"
          ]
        },
        "service_quantity": {
          "enum": [
            "ELECTRICAL_DC_ENERGY",
            "MECHANICAL_SHAFT_WORK",
            "THERMAL_PROCESS_ENERGY",
            "OPTICAL_RADIANT_ENERGY",
            "CHEMICAL_FREE_ENERGY_CHANGE"
          ]
        },
        "service_unit": {
          "const": "J"
        },
        "measurement_method": {
          "enum": [
            "DC_REAL_POWER_INTEGRATION",
            "TORQUE_SPEED_INTEGRATION",
            "CALORIMETRY_OR_ENTHALPY",
            "OPTICAL_RADIOMETRY",
            "REACTION_EXTENT_AND_CHEMICAL_POTENTIAL"
          ]
        },
        "source_input_boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "useful_output_boundary_id": {
          "type": "string",
          "minLength": 1
        },
        "requested_useful_energy_j": {
          "$ref": "#/$defs/nonnegative"
        },
        "minimum_useful_energy_j": {
          "$ref": "#/$defs/nonnegative"
        },
        "maximum_input_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "deadline_ns": {
          "type": "integer",
          "minimum": 1
        },
        "flow_direction": {
          "enum": [
            "SOURCE_TO_RECEIVER",
            "RECEIVER_TO_SOURCE",
            "NOT_APPLICABLE"
          ]
        },
        "power_profile": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "time_ns",
              "requested_input_power_w"
            ],
            "properties": {
              "time_ns": {
                "type": "integer",
                "minimum": 0
              },
              "requested_input_power_w": {
                "$ref": "#/$defs/nonnegative"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "service_type": {
                "const": "BATTERY_DC"
              }
            }
          },
          "then": {
            "properties": {
              "service_quantity": {
                "const": "ELECTRICAL_DC_ENERGY"
              },
              "measurement_method": {
                "const": "DC_REAL_POWER_INTEGRATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service_type": {
                "const": "SHAFT_MECHANICAL"
              }
            }
          },
          "then": {
            "properties": {
              "service_quantity": {
                "const": "MECHANICAL_SHAFT_WORK"
              },
              "measurement_method": {
                "const": "TORQUE_SPEED_INTEGRATION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service_type": {
                "const": "PROCESS_HEAT"
              }
            }
          },
          "then": {
            "properties": {
              "service_quantity": {
                "const": "THERMAL_PROCESS_ENERGY"
              },
              "measurement_method": {
                "const": "CALORIMETRY_OR_ENTHALPY"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service_type": {
                "const": "OPTICAL_RADIANT"
              }
            }
          },
          "then": {
            "properties": {
              "service_quantity": {
                "const": "OPTICAL_RADIANT_ENERGY"
              },
              "measurement_method": {
                "const": "OPTICAL_RADIOMETRY"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "service_type": {
                "const": "CHEMICAL_PROCESS"
              }
            }
          },
          "then": {
            "properties": {
              "service_quantity": {
                "const": "CHEMICAL_FREE_ENERGY_CHANGE"
              },
              "measurement_method": {
                "const": "REACTION_EXTENT_AND_CHEMICAL_POTENTIAL"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "capability_sha256",
        "firmware_sha256",
        "topology_sha256",
        "maximum_input_power_w"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_sha256": {
          "$ref": "#/$defs/digest"
        },
        "firmware_sha256": {
          "$ref": "#/$defs/digest"
        },
        "topology_sha256": {
          "$ref": "#/$defs/digest"
        },
        "maximum_input_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiver_id",
        "capability_sha256",
        "firmware_sha256",
        "maximum_service_power_w",
        "supported_service_type"
      ],
      "properties": {
        "receiver_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_sha256": {
          "$ref": "#/$defs/digest"
        },
        "firmware_sha256": {
          "$ref": "#/$defs/digest"
        },
        "maximum_service_power_w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "supported_service_type": {
          "enum": [
            "BATTERY_DC",
            "SHAFT_MECHANICAL",
            "PROCESS_HEAT",
            "OPTICAL_RADIANT",
            "CHEMICAL_PROCESS"
          ]
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated",
        "authorized",
        "fresh",
        "nonce_sha256",
        "credential_receipt_sha256",
        "command_counter",
        "expires_ns"
      ],
      "properties": {
        "authenticated": {
          "type": "boolean"
        },
        "authorized": {
          "type": "boolean"
        },
        "fresh": {
          "type": "boolean"
        },
        "nonce_sha256": {
          "$ref": "#/$defs/digest"
        },
        "credential_receipt_sha256": {
          "$ref": "#/$defs/digest"
        },
        "command_counter": {
          "type": "integer",
          "minimum": 0
        },
        "expires_ns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "position_receipt_sha256",
        "maximum_uncertainty_m"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFIRMED",
            "UNRESOLVED",
            "FAILED",
            "NOT_REQUIRED"
          ]
        },
        "position_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "maximum_uncertainty_m": {
          "$ref": "#/$defs/nonnegative"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protection_ready",
        "foreign_object_clear",
        "sensor_health",
        "hard_limits_clear",
        "safe_state_confirmed",
        "safe_action",
        "reason_code"
      ],
      "properties": {
        "protection_ready": {
          "type": "boolean"
        },
        "foreign_object_clear": {
          "type": "boolean"
        },
        "sensor_health": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "FAILED",
            "UNKNOWN"
          ]
        },
        "hard_limits_clear": {
          "type": "boolean"
        },
        "safe_state_confirmed": {
          "type": "boolean"
        },
        "safe_action": {
          "enum": [
            "NONE",
            "INHIBIT",
            "DERATE",
            "RAMP_DOWN",
            "DEENERGIZE",
            "ABORT"
          ]
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_input_energy_j",
        "useful_service_energy_j",
        "auxiliary_energy_j",
        "stored_energy_delta_j",
        "energy_residual_j",
        "expanded_uncertainty_j",
        "measurement_receipt_sha256",
        "calibration_receipt_sha256",
        "clock_sync_uncertainty_ns",
        "accounted_loss_energy_j"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_MEASURED",
            "MEASURED",
            "UNRESOLVED"
          ]
        },
        "source_input_energy_j": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "useful_service_energy_j": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "auxiliary_energy_j": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "stored_energy_delta_j": {
          "type": [
            "number",
            "null"
          ]
        },
        "energy_residual_j": {
          "type": [
            "number",
            "null"
          ]
        },
        "expanded_uncertainty_j": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "measurement_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "calibration_receipt_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "clock_sync_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "accounted_loss_energy_j": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
