    },
    {
      "id": "growth",
      "formula": "growth = min(0.08 + target_nutrient * 0.06, source_biomass * 0.25)",
      "target_biomass_credit": "growth",
      "source_biomass_debit": "growth * 0.05",
      "nutrient_debit": "growth * 0.35",
      "source": "no explicit stoichiometric yield or unit conversion"
    },
    {
      "id": "biomass_decay",
      "formula": "FieldGrid biomass diffusion=0.0, decay=0.002, dt=1.0",
      "destination": "untyped / not represented in an explicit detrital or nutrient pool"
    },
    {
      "id": "unreachable_threshold",
      "condition_a": "if biomass < 0.25 then continue",
      "condition_b": "later if biomass < 0.05 then continue",
      "consequence": "the second threshold is unreachable for cells that reach it"
    }
  ],
