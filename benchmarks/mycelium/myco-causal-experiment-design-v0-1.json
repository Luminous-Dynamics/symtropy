          "name": "host_genotype",
          "levels": [
            "multiple_admitted_genotypes"
          ]
        },
        {
          "name": "fungal_strain",
          "levels": [
            "multiple_admitted_strains"
          ]
        },
        {
          "name": "P_supply",
          "levels": [
            "low",
            "reference",
            "high"
          ]
        },
        {
          "name": "N_supply",
          "levels": [
            "low",
            "reference",
            "high"
          ]
        },
        {
          "name": "time",
          "levels": [
            "baseline",
            "pulse",
            "chase",
            "harvest"
          ]
        }
      ],
      "primary_outcomes": [
        "donor_acquisition",
        "fungal_allocation",
        "recipient_delivery",
        "plant_uptake",
        "C_P_exchange_front"
      ],
      "measurement_requirements": [
        "isotope_tracer_by_compartment",
        "fungal_vs_bacterial_pathway_controls",
        "root_fungal_identity"
      ],
      "claim_limit": "Do not collapse acquisition, allocation, transfer and uptake into one exchange ratio."
    },
    {
      "id": "E5",
      "name": "global_field_sampling_value_of_information",
      "randomization_unit": "independent_site_or_soil_core_cluster",
      "blocking": [
        "biome",
        "study_protocol",
        "soil_type",
        "site"
      ],
      "factors": [
        {
          "name": "site_selection_policy",
          "levels": [
            "random",
            "stratified_gap",
            "uncertainty_only",
            "expected_information_gain"
          ]
        },
        {
          "name": "measurement_package",
          "levels": [
            "core_density",
            "robotic_hyphal_imaging",
            "both"
          ]
        }
      ],
      "primary_outcomes": [
        "study_holdout_error",
        "biome_holdout_error",
        "global_interval_width",
        "uncertainty_reduction_per_cost"
      ],
