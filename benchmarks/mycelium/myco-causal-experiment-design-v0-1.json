    }
  ],
  "model_competitors": [
    "random_experiment_selection",
    "sensitivity_only",
    "uncertainty_only",
    "expected_information_gain",
    "causal_hypothesis_discrimination",
    "cost_constrained_pareto_design"
  ],
  "evaluation_metrics": [
    "expected_information_gain_per_cost",
    "heldout_hypothesis_discrimination_accuracy",
    "manipulation_fidelity_pass_rate",
    "negative_control_false_positive_rate",
    "replicate_level_interval_coverage",
    "minimum_detectable_effect",
    "worst_stratum_calibration",
    "cost_per_independent_unit",
    "randomization_replay_match"
  ],
  "preregistration_receipt": [
    "hypothesis_set_and_prediction_table",
    "primary_estimand",
    "randomization_unit",
    "nested_sampling_structure",
    "blocking_and_randomization_seed",
    "treatment_protocol_and_manipulation_check",
    "primary_and_secondary_outcomes",
    "negative_controls",
    "exclusion_and_missingness_rules",
    "power_analysis_source_variance",
    "analysis_code_digest",
    "source_and_instrument_calibration"
  ],
  "target_policy": {
    "no_fixed_sample_sizes_without_pilot_variance": true,
    "no_pseudoreplication": true,
    "future_interventions_are_not_claimed_as_completed": true,
    "target": "design selection should outperform random/uncertainty-only baselines in held-out known-truth simulation before experimental use"
  }
}
