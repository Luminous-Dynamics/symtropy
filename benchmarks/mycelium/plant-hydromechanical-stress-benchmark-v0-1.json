    },
    {
      "id": "mechanical",
      "observables": ["tissue_pressure", "strain", "swelling", "deformation"],
      "required_metadata": ["tissue_identity", "geometry", "spatial_resolution", "imaging_or_sensor_calibration", "time_window", "uncertainty"]
    },
    {
      "id": "calcium",
      "observables": ["cytosolic_calcium_reporter_signal"],
      "required_metadata": ["reporter_identity", "calibration", "imaging_exposure", "time_window", "uncertainty"],
      "claim_limit": "reporter_signal_is_not_a_direct_measurement_of_hydraulic_pressure_or_specific_causal_pathway"
    },
    {
      "id": "electrical",
      "observables": ["measured_electrical_potential_or_current"],
      "required_metadata": ["electrode_geometry", "reference_electrode", "instrument_calibration", "filtering", "time_window", "uncertainty"],
      "claim_limit": "electrical_dynamics_do_not_establish_mass_flow_or_nutrient_transfer"
    },
    {
      "id": "fungal",
      "observables": ["hyphal_graph", "hyphal_growth", "cytoplasmic_flow_velocity", "fungal_resource_pool"],
      "required_metadata": ["fungal_taxon_and_strain", "culture_or_field_unit", "roi_or_segment", "source_receipt", "clock_alignment", "uncertainty"]
    },
    {
      "id": "isotope_and_exchange",
      "observables": ["isotope_atom_fraction", "total_element_pool_mass_if_available", "compartment_specific_recovery"],
      "required_metadata": ["isotope_identity", "donor_and_receiver_compartment", "baseline", "matched_control", "time_alignment", "source_receipt", "uncertainty"],
      "claim_limit": "isotope_enrichment_alone_does_not_establish_direct_fungal_transport_or_mass_transferred"
    }
  ],
  "model_tournament": [
    {
      "id": "soil_root_reference",
