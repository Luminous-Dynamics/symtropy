  "process_scales": [
    {
      "id": "fast_hydromechanical",
      "nominal_window": "microseconds_to_minutes",
      "state_families": ["xylem_pressure", "tissue_pressure", "strain", "swelling", "pressure_driven_mass_flow"],
      "qualification": "source_specific_time_constants_and_observation_rate_required"
    },
    {
      "id": "stomatal_and_leaf",
      "nominal_window": "seconds_to_hours",
      "state_families": ["stomatal_conductance", "transpiration", "leaf_water_potential", "carbon_assimilation", "leaf_temperature"],
      "qualification": "diurnal_forcing_and_sensor_cadence_must_be_preserved"
    },
    {
      "id": "soil_root_hydraulic",
      "nominal_window": "minutes_to_days",
      "state_families": ["soil_water_potential", "soil_hydraulic_conductivity", "rhizosphere_resistance", "root_uptake", "root_hydraulic_conductance"],
      "qualification": "soil_texture_root_architecture_and_boundary_conditions_are_profile_specific"
    },
    {
      "id": "fungal_network",
      "nominal_window": "hours_to_days",
      "state_families": ["hyphal_topology", "growth_front", "cytoplasmic_flow", "fungal_resource_pools"],
      "qualification": "taxon_strain_and_observation_modality_are_explicit"
    },
    {
      "id": "developmental_and_recovery",
      "nominal_window": "days_to_months",
      "state_families": ["root_architecture_change", "fungal_turnover", "carbon_allocation", "growth", "survival", "recovery_memory"],
      "qualification": "historical_state_is_preserved_only_where_the_constitutive_model_requires_it"
    }
  ],
  "causal_process_paths": [
    {
      "id": "soil_to_leaf_hydraulics",
      "sequence": ["soil_water_state", "soil_and_rhizosphere_conductance", "root_uptake_flux", "xylem_water_state", "leaf_water_state"],
      "status": "reference_models_required"
    },
    {
      "id": "stomatal_carbon_water",
      "sequence": ["leaf_water_state", "stomatal_conductance", "transpiration", "carbon_assimilation"],
      "status": "compare_process_based_and_empirical_models"
    },
    {
      "id": "poroelastic_signal",
      "sequence": ["local_pressure_perturbation", "xylem_pressure_propagation", "tissue_pressure_and_strain", "downstream_observable_response"],
      "status": "wound_reference_only_until_drought_mechanism_is_independently_supported"
    },
    {
      "id": "chemical_elicitor",
      "sequence": ["elicitor_release", "pressure_driven_advection_and_diffusion", "target_receptor_or_channel", "cellular_response"],
      "status": "competing_hypothesis_requires_direct_chemical_or_reporter_evidence"
    },
    {
      "id": "fungal_interface",
      "sequence": ["soil_resource_or_water_state", "admitted_fungal_process", "measured_interface_exchange", "plant_pool_or_state_change"],
      "status": "disabled_without_taxon_specific_route_evidence_and_matched_controls"
    }
  ],
  "scenarios": [
    {
      "id": "S0",
      "name": "reference_equilibrium",
      "forcing": "stable_soil_water_vpd_and_temperature",
      "purpose": "steady_state_and_boundary_balance",
      "holdout": false
    },
    {
      "id": "S1",
      "name": "soil_supply_pulse",
      "forcing": "reduce_soil_water_availability_or_hydraulic_conductivity_with_atmospheric_demand_fixed",
      "purpose": "identify_supply_limited_response",
      "holdout": false
    },
    {
      "id": "S2",
      "name": "atmospheric_demand_pulse",
      "forcing": "increase_vpd_and_or_temperature_with_soil_supply_fixed",
      "purpose": "identify_demand_limited_response",
      "holdout": false
    },
    {
      "id": "S3",
      "name": "compound_soil_and_atmospheric_stress",
      "forcing": "combined_S1_and_S2_with_matched_single_factor_controls",
      "purpose": "measure_interaction_and_non_additivity",
      "holdout": true
    },
    {
      "id": "S4",
      "name": "localized_root_zone_perturbation",
      "forcing": "spatially_localized_wet_dry_boundary_or_split_root_input",
      "purpose": "test_spatial_response_and_cross_root_lag",
      "holdout": true
    },
    {
      "id": "S5",
      "name": "repeated_drought_rewatering",
      "forcing": "single_and_repeated_soil_drying_and_rewatering_pulses",
      "purpose": "test_path_dependence_hysteresis_recovery_and_memory",
      "holdout": true
    },
    {
      "id": "S6",
      "name": "wound_induced_poroelastic_reference",
      "forcing": "source_faithful_local_wound_pressure_perturbation",
      "purpose": "verify_fast_pressure_strain_and_mass_flow_model_separately_from_drought",
      "holdout": true
    },
    {
      "id": "S7",
      "name": "fungal_interface_route_discrimination",
      "forcing": "selected_plant_fungus_system_with_intact_severed_no_fungus_and_diffusion_or_microbe_controls",
      "purpose": "test_only_the_resource_or_water_pathway_supported_by_admitted_measurements",
      "holdout": true
    }
  ],
  "observation_channels": [
    {
      "id": "soil_and_rhizosphere",
      "observables": ["soil_water_content", "soil_water_potential", "soil_hydraulic_conductivity", "rhizosphere_resistance"],
      "required_metadata": ["soil_profile", "depth", "spatial_support", "calibration", "time_window", "uncertainty"]
    },
    {
      "id": "root_and_xylem",
      "observables": ["root_uptake_flux", "root_hydraulic_conductance", "xylem_water_potential", "xylem_pressure"],
      "required_metadata": ["root_identity", "architecture_revision", "measurement_method", "units", "time_window", "uncertainty"]
    },
    {
      "id": "leaf_and_stomatal",
      "observables": ["leaf_water_potential", "stomatal_conductance", "transpiration", "carbon_assimilation", "leaf_temperature"],
