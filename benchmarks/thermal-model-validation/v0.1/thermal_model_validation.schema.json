{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/thermal-model-validation/v0.1/thermal_model_validation.schema.json",
  "title":"Thermal Model Validation Record v0.1",
  "description":"Evidence contract for identifying and validating actuator thermal models on leakage-resistant held-out missions. Schema validity does not establish physical model validity.",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","record_kind","validation_id","model","dataset","split","fit","held_out_evaluation","model_comparisons","validity_domain","review","evidence","claim_ceiling"],
  "properties":{
    "schema_version":{"const":"0.1.0"},
    "record_kind":{"enum":["synthetic_analytic_fixture","physical_model_validation","numerical_crosscheck","independent_reproduction"]},
    "validation_id":{"type":"string","minLength":1},
    "model":{
      "type":"object","additionalProperties":false,
      "required":["model_id","model_class","equation_reference","parameter_count","parameters","predicted_channels"],
      "properties":{
        "model_id":{"type":"string","minLength":1},
        "model_class":{"enum":["ambient_only_baseline","single_node_linear_rc","two_node_linear_rc","multi_node_thermal_network","temperature_dependent_thermal_network","physics_plus_learned_residual","data_driven_surrogate","other"]},
        "equation_reference":{"type":"string","minLength":1},
        "parameter_count":{"type":"integer","minimum":0},
        "parameters":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","value","unit","lower_bound","upper_bound","uncertainty_status","standard_uncertainty"],"properties":{"name":{"type":"string","minLength":1},"value":{"type":"number"},"unit":{"type":"string","minLength":1},"lower_bound":{"type":["number","null"]},"upper_bound":{"type":["number","null"]},"uncertainty_status":{"enum":["estimated","fixed_from_independent_measurement","synthetic_exact","not_identifiable","unknown"]},"standard_uncertainty":{"type":["number","null"],"minimum":0},"reason":{"type":["string","null"]}}}},
        "predicted_channels":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
      }
    },
    "dataset":{
      "type":"object","additionalProperties":false,
      "required":["dataset_id","dataset_digest","evidence_origin","trace_catalog"],
      "properties":{
        "dataset_id":{"type":"string","minLength":1},
        "dataset_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "evidence_origin":{"enum":["synthetic_generated","physical_measured","vendor_reported","mixed","other"]},
        "trace_catalog":{"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["trace_id","trace_digest","article_group_id","mission_group_id","configuration_digest","channels"],"properties":{
          "trace_id":{"type":"string","minLength":1},
          "trace_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
          "article_group_id":{"type":"string","minLength":1},
          "mission_group_id":{"type":"string","minLength":1},
          "configuration_digest":{"type":["string","null"]},
          "channels":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["channel_id","location","unit","sensor_status","calibration_reference","standard_uncertainty"],"properties":{
            "channel_id":{"type":"string","minLength":1},
            "location":{"enum":["winding","stator","case","gearbox","driver","ambient","lumped_node","other"]},
            "unit":{"type":"string","minLength":1},
            "sensor_status":{"enum":["calibrated_physical_sensor","uncalibrated_sensor","estimated","synthetic"]},
            "calibration_reference":{"type":["string","null"]},
            "standard_uncertainty":{"type":["number","null"],"minimum":0}
          }}}
        }}}
      }
    },
    "split":{
      "type":"object","additionalProperties":false,
      "required":["split_id","split_digest","grouping_keys","training_trace_ids","validation_trace_ids","held_out_trace_ids","split_method","locked_before_fit"],
      "properties":{
        "split_id":{"type":"string","minLength":1},
        "split_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "grouping_keys":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["article_group_id","mission_group_id","configuration_digest"]}},
        "training_trace_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "validation_trace_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "held_out_trace_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "split_method":{"type":"string","minLength":1},
        "locked_before_fit":{"type":"boolean"},
        "split_lock_reference":{"type":["string","null"]}
      }
    },
    "fit":{
      "type":"object","additionalProperties":false,
      "required":["algorithm","fit_status","evaluation_budget","evaluations_used","seed","regularization","training_data_digest","identifiability"],
      "properties":{
        "algorithm":{"type":"string","minLength":1},
        "fit_status":{"enum":["converged","fixed_analytic_parameters","failed","not_run"]},
        "evaluation_budget":{"type":"integer","minimum":0},
        "evaluations_used":{"type":"integer","minimum":0},
        "seed":{"type":["integer","string","null"]},
        "regularization":{"type":"string"},
        "training_data_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
        "identifiability":{"type":"object","additionalProperties":false,"required":["status","method","local_condition_number","minimum_singular_value","max_abs_parameter_correlation","bootstrap_draws","notes"],"properties":{
          "status":{"enum":["well_identified","partially_identified","not_identified","not_applicable","not_evaluated"]},
          "method":{"type":"string","minLength":1},
          "local_condition_number":{"type":["number","null"],"exclusiveMinimum":0},
          "minimum_singular_value":{"type":["number","null"],"minimum":0},
          "max_abs_parameter_correlation":{"type":["number","null"],"minimum":0,"maximum":1},
          "bootstrap_draws":{"type":"integer","minimum":0},
          "notes":{"type":"string"}
        }}
      }
    },
    "held_out_evaluation":{
      "type":"object","additionalProperties":false,
      "required":["evaluation_method","evaluated_trace_ids","per_trace"],
      "properties":{
        "evaluation_method":{"type":"string","minLength":1},
        "evaluated_trace_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "per_trace":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["trace_id","channels"],"properties":{
          "trace_id":{"type":"string","minLength":1},
          "channels":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["channel_id","sample_count","rmse_c","mae_c","bias_c","max_abs_error_c","normalized_rmse_by_sensor_uncertainty","prediction_interval_coverage_90","prediction_interval_coverage_95","residual_autocorrelation_lag1"],"properties":{
            "channel_id":{"type":"string","minLength":1},
            "sample_count":{"type":"integer","minimum":1},
            "rmse_c":{"type":"number","minimum":0},
            "mae_c":{"type":"number","minimum":0},
            "bias_c":{"type":"number"},
            "max_abs_error_c":{"type":"number","minimum":0},
            "normalized_rmse_by_sensor_uncertainty":{"type":["number","null"],"minimum":0},
            "prediction_interval_coverage_90":{"type":["number","null"],"minimum":0,"maximum":1},
            "prediction_interval_coverage_95":{"type":["number","null"],"minimum":0,"maximum":1},
            "residual_autocorrelation_lag1":{"type":["number","null"],"minimum":-1,"maximum":1}
          }}}
        }}}
      }
    },
    "model_comparisons":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["model_id","model_class","parameter_count","split_digest","evaluated_trace_ids","evaluation_method","fit_budget_evaluations","per_channel_metrics"],"properties":{
      "model_id":{"type":"string","minLength":1},
      "model_class":{"type":"string","minLength":1},
      "parameter_count":{"type":"integer","minimum":0},
      "split_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
      "evaluated_trace_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
      "evaluation_method":{"type":"string","minLength":1},
      "fit_budget_evaluations":{"type":"integer","minimum":0},
      "per_channel_metrics":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["channel_id","rmse_c","mae_c","bias_c","prediction_interval_coverage_90"],"properties":{
        "channel_id":{"type":"string","minLength":1},
        "rmse_c":{"type":"number","minimum":0},
        "mae_c":{"type":"number","minimum":0},
        "bias_c":{"type":"number"},
        "prediction_interval_coverage_90":{"type":["number","null"],"minimum":0,"maximum":1}
      }}}
    }}},
    "validity_domain":{"type":"object","additionalProperties":false,"required":["ambient_temperature_c_min","ambient_temperature_c_max","initial_temperature_c_min","initial_temperature_c_max","cooling_boundary","load_envelope","speed_envelope","hardware_revisions","extrapolation_policy"],"properties":{
      "ambient_temperature_c_min":{"type":["number","null"]},
      "ambient_temperature_c_max":{"type":["number","null"]},
      "initial_temperature_c_min":{"type":["number","null"]},
      "initial_temperature_c_max":{"type":["number","null"]},
      "cooling_boundary":{"type":"array","items":{"type":"string"}},
      "load_envelope":{"type":"string","minLength":1},
      "speed_envelope":{"type":"string","minLength":1},
      "hardware_revisions":{"type":"array","items":{"type":"string"}},
      "extrapolation_policy":{"enum":["reject_outside_domain","flag_outside_domain","not_defined"]}
    }},
    "review":{"type":"object","additionalProperties":false,"required":["qualification_status","independent_review","independent_reproduction","review_notes"],"properties":{
      "qualification_status":{"enum":["not_evaluated","candidate","passed","failed","indeterminate"]},
      "independent_review":{"enum":["yes","no","not_disclosed","not_applicable"]},
      "independent_reproduction":{"enum":["yes","no","not_disclosed","not_applicable"]},
      "reviewer_role":{"type":["string","null"]},
      "review_notes":{"type":"string"}
    }},
    "evidence":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["evidence_id","source_type","uri","digest","notes"],"properties":{
      "evidence_id":{"type":"string","minLength":1},
      "source_type":{"enum":["raw_trace","calibration_certificate","source_code","paper","simulation_output","independent_report","other"]},
      "uri":{"type":"string","format":"uri"},
      "digest":{"type":["string","null"]},
      "notes":{"type":"string"}
    }}},
    "claim_ceiling":{"type":"string","minLength":1}
  }
}
