{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/schemas/wpt-multifidelity-bench-v1.json",
  "title": "WPT multi-fidelity transient model benchmark suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "wpt-multifidelity-bench-v1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_s",
        "channels"
      ],
      "properties": {
        "time_s": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/channel"
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "unit",
        "values"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "family",
        "state_order",
        "model_digest",
        "training_data_digest",
        "trace",
        "execution_environment_digest",
        "runtime_median_ms",
        "runtime_p95_ms",
        "peak_memory_bytes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "full_order",
            "balanced_truncation",
            "data_driven_petrov_galerkin",
            "port_hamiltonian",
            "learned_surrogate",
            "other"
          ]
        },
        "state_order": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "model_digest": {
          "$ref": "#/$defs/digest"
        },
        "training_data_digest": {
          "$ref": "#/$defs/digest"
        },
        "trace": {
          "$ref": "#/$defs/trace"
        },
        "execution_environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "runtime_median_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "runtime_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "maximum_absolute_value"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "maximum_absolute_value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_channel_nrmse",
        "maximum_peak_magnitude_relative_error",
        "maximum_energy_relative_error",
        "peak_limits"
      ],
      "properties": {
        "maximum_channel_nrmse": {
          "type": "number",
          "minimum": 0
        },
        "maximum_peak_magnitude_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "maximum_energy_relative_error": {
          "type": "number",
          "minimum": 0
        },
        "peak_limits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limit"
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "evidence_class",
        "power_flow_direction",
        "reference",
        "energy_channel_ids",
        "candidates",
        "acceptance",
        "execution_environment_digest",
        "reference_runtime_median_ms",
        "reference_runtime_p95_ms"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "synthetic_known_truth",
            "published_data_replay",
            "experimental_data_replay",
            "simulation_reference"
          ]
        },
        "power_flow_direction": {
          "enum": [
            "grid_to_vehicle",
            "vehicle_to_grid"
          ]
        },
        "reference": {
          "$ref": "#/$defs/trace"
        },
        "energy_channel_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance"
        },
        "execution_environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "reference_runtime_median_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_runtime_p95_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
