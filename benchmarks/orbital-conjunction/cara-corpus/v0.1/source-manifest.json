  "admission_gates": [
    "Map each candidate implementation, test case, comparison workbook, and ephemeris file to the applicable NASA Open Source Software Agreement.",
    "Check whether sample CDMs / OEM ephemerides contain mission or third-party restrictions independent of the source-code license.",
    "Record whether use is permitted for local test execution, derived numeric comparison, redistribution, and publication; these are separate permissions.",
    "If a file cannot be redistributed, download only in a controlled test workflow and publish derived metrics plus source path and digest where allowed.",
    "Do not promote any corpus case to a frozen benchmark until the exact file bytes are retrieved, SHA-256 is computed locally, parser conventions are documented, and event semantics are checked."
  ],
  "baseline_policy": {
    "name": "NASA CARA PcMultiStep / PcMultiStepWithSDMC",
    "status": "public-source comparator; rights review required before redistribution",
    "stages": [
      "input data quality and TCA / covariance processing",
      "2D-Pc conjunction-plane estimate",
      "2D-Pc usage-violation indicators and rough/proxy correction",
      "conditional 2D-Nc refinement",
      "conditional 3D-Nc refinement",
      "conditional SDMC refinement in PcMultiStepWithSDMC"
    ],
    "usage_violation_axes": [
      "non-positive-definite covariance / covariance remediation",
      "extended conjunction duration",
      "collision-rate peak offset from TCA",
      "potential 2D-Pc inaccuracy under curvilinear dynamics",
      "convergence / quadrature adequacy for advanced methods",
      "very-low-relative-velocity and blended encounter behavior"
    ],
    "internal_only_capability": {
      "name": "BFMC",
      "description": "Brute-force high-fidelity Monte Carlo from OD epoch over multiple encounters",
      "public_source_status": "not publicly released according to PcMultiStepWithSDMC source documentation"
    },
    "benchmark_rule": "Compare the full public escalation policy and its thresholds, not only each estimator independently. Any BFMC comparison requires an independently available implementation and matching event / dynamics assumptions."
  }
}
