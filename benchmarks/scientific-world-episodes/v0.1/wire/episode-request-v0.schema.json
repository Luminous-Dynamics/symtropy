{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/scientific-world-episodes/v0.1/wire/episode-request-v0.schema.json",
  "title": "Symtropy Joint World Episode Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "view"
  ],
  "properties": {
    "protocol_version": {
      "const": "symtropy-joint-world-episode-v0"
    },
    "view": {
      "$ref": "#/$defs/episodeView"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "world_model_sha256",
        "model_profile_sha256",
        "world_recipe_sha256",
        "clock_profile_sha256",
        "time_origin_sha256"
      ],
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/digest"
        },
        "world_model_sha256": {
          "$ref": "#/$defs/digest"
        },
        "model_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "world_recipe_sha256": {
          "$ref": "#/$defs/digest"
        },
        "clock_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "time_origin_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "cost_units"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "event_step",
        "acquisition_step",
        "available_at_step"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "event_step": {
          "type": "integer",
          "minimum": 0
        },
        "acquisition_step": {
          "type": "integer",
          "minimum": 0
        },
        "available_at_step": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "observation_id"
          ],
          "properties": {
            "status": {
              "const": "applied"
            },
            "observation_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "hazard_terminal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_unknown_action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_terminal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_attempt_budget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_cost_budget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_step_budget"
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "ordinal",
        "requested_action_id",
        "requested_cost_units",
        "charged_cost_units",
        "requested_at_step",
        "executed_at_step",
        "disposition"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt-[0-9]{8}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "requested_action_id": {
          "type": "string",
          "maxLength": 128
        },
        "requested_cost_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "charged_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "requested_at_step": {
          "type": "integer",
          "minimum": 0
        },
        "executed_at_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "rationale"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "identified",
            "ambiguous",
            "no_compatible_model",
            "abstain"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "episodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "manifest",
        "current_step",
        "actions",
        "observations",
        "attempts",
        "accepted_attempts",
        "spent_cost_units",
        "max_attempts",
        "max_cost_units",
        "max_world_steps",
        "dropped_attempts",
        "trace_complete",
        "finish",
        "terminal"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{16,96}$"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "current_step": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "accepted_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "spent_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "max_world_steps": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "trace_complete": {
          "type": "boolean"
        },
        "finish": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/finish"
            }
          ]
        },
        "terminal": {
          "type": "boolean"
        }
      }
    }
  }
}
