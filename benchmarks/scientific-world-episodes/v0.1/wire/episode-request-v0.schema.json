{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/scientific-world-episodes/v0.1/wire/episode-request-v0.schema.json",
  "title": "Symtropy Joint World Episode Request v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "view"
  ],
  "properties": {
    "protocol_version": {
      "const": "symtropy-joint-world-episode-v0"
    },
    "view": {
      "$ref": "#/$defs/episodeView"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "world_model_sha256",
        "model_profile_sha256",
        "world_recipe_sha256",
        "clock_profile_sha256",
        "time_origin_sha256",
        "public_profile"
      ],
      "properties": {
        "contract_sha256": {
          "$ref": "#/$defs/digest"
        },
        "world_model_sha256": {
          "$ref": "#/$defs/digest"
        },
        "model_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "world_recipe_sha256": {
          "$ref": "#/$defs/digest"
        },
        "clock_profile_sha256": {
          "$ref": "#/$defs/digest"
        },
        "time_origin_sha256": {
          "$ref": "#/$defs/digest"
        },
        "public_profile": {
          "$ref": "#/$defs/publicProfile"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "cost_units",
        "description",
        "target"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "event_step",
        "acquisition_step",
        "available_at_step",
        "description",
        "unit"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "event_step": {
          "type": "integer",
          "minimum": 0
        },
        "acquisition_step": {
          "type": "integer",
          "minimum": 0
        },
        "available_at_step": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "observation_id"
          ],
          "properties": {
            "status": {
              "const": "applied"
            },
            "observation_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "hazard_terminal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_unknown_action"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_terminal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_attempt_budget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_cost_budget"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "rejected_step_budget"
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "ordinal",
        "requested_action_id",
        "requested_cost_units",
        "charged_cost_units",
        "requested_at_step",
        "executed_at_step",
        "disposition"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt-[0-9]{8}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "requested_action_id": {
          "type": "string",
          "maxLength": 128
        },
        "requested_cost_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "charged_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "requested_at_step": {
          "type": "integer",
          "minimum": 0
        },
        "executed_at_step": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "rationale",
        "compatible_hypothesis_ids"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "identified",
            "ambiguous",
            "no_compatible_model",
            "outside_candidate_family",
            "abstain"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "compatible_hypothesis_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        }
      }
    },
    "episodeView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "manifest",
        "current_step",
        "actions",
        "observations",
        "attempts",
        "accepted_attempts",
        "spent_cost_units",
        "max_attempts",
        "max_cost_units",
        "max_world_steps",
        "dropped_attempts",
        "trace_complete",
        "finish",
        "terminal"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{16,96}$"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "current_step": {
          "type": "integer",
          "minimum": 0
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "accepted_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "spent_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "max_world_steps": {
          "type": "integer",
          "minimum": 0
        },
        "dropped_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "trace_complete": {
          "type": "boolean"
        },
        "finish": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/finish"
            }
          ]
        },
        "terminal": {
          "type": "boolean"
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "structural_family",
        "description",
        "prior_probability"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "structural_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "prior_probability": {
          "$ref": "#/$defs/publicProbability"
        }
      }
    },
    "actionDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "description",
        "target"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "observationDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "channel_id",
        "description",
        "unit"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "channel_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "publicProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_description",
        "candidate_hypotheses",
        "actions",
        "observations",
        "model_catalogue"
      ],
      "properties": {
        "task_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "candidate_hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hypothesis"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/actionDescription"
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observationDescription"
          }
        },
        "model_catalogue": {
          "$ref": "#/$defs/modelCatalogue"
        }
      }
    },
    "publicProbability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,38})$"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,38}$"
        }
      }
    },
    "initialStateMass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_state",
        "sensor_state",
        "conditional_mass"
      ],
      "properties": {
        "physical_state": {
          "type": "integer",
          "minimum": 0
        },
        "sensor_state": {
          "type": "integer",
          "minimum": 0
        },
        "conditional_mass": {
          "$ref": "#/$defs/publicProbability"
        }
      }
    },
    "transitionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probability",
        "next_physical_state",
        "next_sensor_state",
        "observation_id"
      ],
      "properties": {
        "probability": {
          "$ref": "#/$defs/publicProbability"
        },
        "next_physical_state": {
          "type": "integer",
          "minimum": 0
        },
        "next_sensor_state": {
          "type": "integer",
          "minimum": 0
        },
        "observation_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 96
        }
      }
    },
    "transitionRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical_state",
        "sensor_state",
        "action_id",
        "outcomes"
      ],
      "properties": {
        "physical_state": {
          "type": "integer",
          "minimum": 0
        },
        "sensor_state": {
          "type": "integer",
          "minimum": 0
        },
        "action_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transitionOutcome"
          }
        }
      }
    },
    "candidateModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id",
        "initial_state_belief",
        "transition_rows"
      ],
      "properties": {
        "hypothesis_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "initial_state_belief": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/initialStateMass"
          }
        },
        "transition_rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/transitionRow"
          }
        }
      }
    },
    "modelCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "physical_state_count",
        "sensor_state_count",
        "action_ids",
        "observation_ids",
        "candidate_models",
        "catalogue_sha256"
      ],
      "properties": {
        "version": {
          "const": "sim-rel-public-model-catalogue-v0"
        },
        "physical_state_count": {
          "type": "integer",
          "minimum": 1
        },
        "sensor_state_count": {
          "type": "integer",
          "minimum": 1
        },
        "action_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
          }
        },
        "observation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
          }
        },
        "candidate_models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidateModel"
          }
        },
        "catalogue_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  }
}
