{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/scientific-world-episodes/v0.1/public-episode-packet.schema.json",
  "title": "Scientific World Episode Public Packet v0.1",
  "description": "Policy-visible episode metadata only. Sealed truth, seeds, split labels and evaluator fields are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "episode",
    "objective",
    "scope",
    "observation_channels",
    "interventions",
    "budget",
    "timebase",
    "initial_observations",
    "evidence_profile"
  ],
  "properties": {
    "schema_id": {
      "const": "org.luminous-dynamics.scientific-world-episode.public-packet"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_instance_id",
        "contract_digest"
      ],
      "properties": {
        "opaque_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{16,96}$"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        },
        "visible_state_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "claim_scope"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "claim_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "observation_channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "description",
          "value_type",
          "unit",
          "quality_states"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "value_type": {
            "enum": [
              "number",
              "integer",
              "boolean",
              "string",
              "vector",
              "categorical"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "quality_states": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "current",
                "stale",
                "missing",
                "invalid",
                "saturated",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "description",
          "parameters",
          "cost_units",
          "duration_steps"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "unit",
                "minimum",
                "maximum"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              }
            }
          },
          "cost_units": {
            "type": "integer",
            "minimum": 0
          },
          "duration_steps": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_observation_requests",
        "max_interventions",
        "max_simulation_steps",
        "max_compute_units",
        "compute_unit_definition"
      ],
      "properties": {
        "max_observation_requests": {
          "type": "integer",
          "minimum": 0
        },
        "max_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "max_simulation_steps": {
          "type": "integer",
          "minimum": 0
        },
        "max_compute_units": {
          "type": "integer",
          "minimum": 0
        },
        "compute_unit_definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_id",
        "time_origin_id",
        "time_unit"
      ],
      "properties": {
        "clock_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "time_origin_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "time_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "initial_observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "evidence_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_class",
        "applicability_domain",
        "claim_ceiling"
      ],
      "properties": {
        "evidence_class": {
          "enum": [
            "synthetic",
            "modelled",
            "measured",
            "independently_qualified"
          ]
        },
        "applicability_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "claim_ceiling": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "owner_profile_ref": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "channel_id",
        "value",
        "unit",
        "event_time",
        "available_at",
        "quality_state"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,128}$"
        },
        "channel_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,96}$"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "boolean",
            "string",
            "array",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "event_time": {
          "type": "integer",
          "minimum": 0
        },
        "acquisition_time": {
          "type": "integer",
          "minimum": 0
        },
        "available_at": {
          "type": "integer",
          "minimum": 0
        },
        "quality_state": {
          "enum": [
            "current",
            "stale",
            "missing",
            "invalid",
            "saturated",
            "unknown"
          ]
        },
        "source_evidence_ref": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
