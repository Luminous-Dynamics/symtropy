{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminousdynamics.io/symtropy/robotics-benchmark-robustness/run/v0.1",
  "title": "Paired robotics benchmark robustness run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "bootstrap",
    "task_clusters"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_id",
        "benchmark_commit",
        "protocol_digest_hex",
        "embodiment",
        "evaluation_split",
        "tuned_on_benchmark"
      ],
      "properties": {
        "benchmark_id": {
          "type": "string",
          "minLength": 1
        },
        "benchmark_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "protocol_digest_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "embodiment": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_split": {
          "type": "string",
          "minLength": 1
        },
        "tuned_on_benchmark": {
          "type": "boolean"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicates",
        "seed"
      ],
      "properties": {
        "replicates": {
          "type": "integer",
          "minimum": 1000
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "task_clusters": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "category",
          "horizon",
          "shift_family",
          "episodes"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "horizon": {
            "type": "integer",
            "minimum": 1
          },
          "shift_family": {
            "type": "string",
            "minLength": 1
          },
          "episodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "episode_id",
                "baseline_success",
                "candidate_success"
              ],
              "properties": {
                "episode_id": {
                  "type": "string",
                  "minLength": 1
                },
                "baseline_success": {
                  "type": "boolean"
                },
                "candidate_success": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
