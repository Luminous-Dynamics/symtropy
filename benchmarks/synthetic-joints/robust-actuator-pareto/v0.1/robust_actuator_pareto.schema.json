{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/robust-actuator-pareto/v0.1/robust_actuator_pareto.schema.json",
  "title": "Robust Actuator Pareto Candidate Batch v0.1",
  "description": "Evidence-lane-separated candidate objective/constraint records. A negative margin is a robust violation only when the margin itself has known evidence provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "objective_definitions",
    "hard_constraint_definitions",
    "candidates",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective_definition"
      }
    },
    "hard_constraint_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint_definition"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "objective_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        }
      }
    },
    "constraint_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "interpretation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_class": {
      "enum": [
        "independent_physical",
        "source_author_physical",
        "vendor_physical",
        "model_derived",
        "unknown"
      ]
    },
    "metric_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "evidence_class",
        "source_reference",
        "method",
        "configuration_digest",
        "operating_condition_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraint_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minimum_robust_margin",
        "unit",
        "evidence_class",
        "source_reference",
        "method",
        "configuration_digest",
        "operating_condition_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "minimum_robust_margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "configuration_digest",
        "operating_condition_digest",
        "mission_set_digest",
        "objectives",
        "hard_constraints"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric_evidence"
          }
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_evidence"
          }
        }
      }
    }
  }
}
