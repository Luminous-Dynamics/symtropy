{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/robust-actuator-pareto/v0.1/robust_actuator_pareto.schema.json",
  "title": "Robust Actuator Pareto Candidate Batch v0.1",
  "description": "Evidence-lane-separated candidate objective/constraint records. A negative margin is a robust violation only when the margin itself has known evidence provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "comparison_id",
    "objective_definitions",
    "hard_constraint_definitions",
    "candidates",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective_definition"
      }
    },
    "hard_constraint_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint_definition"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "objective_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "direction"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "minimize",
            "maximize"
          ]
        }
      }
    },
    "constraint_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "interpretation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_class": {
      "enum": [
        "independent_physical",
        "source_author_physical",
        "vendor_physical",
        "model_derived",
        "unknown",
        "calibrated_model_prediction"
      ]
    },
    "metric_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "unit",
        "evidence_class",
        "source_reference",
        "method",
        "configuration_digest",
        "operating_condition_digest",
        "system_boundary_digest",
        "mission_set_digest",
        "stress_set_digest",
        "calibration_receipt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "stress_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "calibration_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/calibration_receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "constraint_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "minimum_robust_margin",
        "unit",
        "evidence_class",
        "source_reference",
        "method",
        "configuration_digest",
        "operating_condition_digest",
        "system_boundary_digest",
        "stress_set_digest",
        "mission_set_digest",
        "calibration_receipt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "minimum_robust_margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "stress_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "calibration_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/calibration_receipt"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "configuration_digest",
        "operating_condition_digest",
        "mission_set_digest",
        "objectives",
        "hard_constraints",
        "system_boundary_digest",
        "stress_set_digest",
        "model_digest",
        "prediction_domain_digest"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric_evidence"
          }
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_evidence"
          }
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "stress_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "model_digest": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "prediction_domain_digest": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "measurement_evidence_class": {
      "type": "string",
      "enum": [
        "independent_physical",
        "source_author_physical",
        "vendor_physical"
      ]
    },
    "calibration_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_digest",
        "model_digest",
        "training_split_digest",
        "calibration_split_digest",
        "test_split_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "mission_set_digest",
        "domain_digest",
        "alpha",
        "calibration_specimen_count",
        "order_statistic_rank",
        "correction_q_nm",
        "test_specimen_count",
        "in_domain_test_specimen_count",
        "covered_test_specimen_count",
        "uncovered_test_specimen_count",
        "out_of_domain_test_specimen_count",
        "empirical_group_coverage",
        "wilson_95_lower",
        "wilson_95_upper",
        "measurement_evidence_class"
      ],
      "properties": {
        "report_digest": {
          "type": "string",
          "minLength": 1
        },
        "model_digest": {
          "type": "string",
          "minLength": 1
        },
        "training_split_digest": {
          "type": "string",
          "minLength": 1
        },
        "calibration_split_digest": {
          "type": "string",
          "minLength": 1
        },
        "test_split_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "domain_digest": {
          "type": "string",
          "minLength": 1
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "calibration_specimen_count": {
          "type": "integer",
          "minimum": 1
        },
        "order_statistic_rank": {
          "type": "integer",
          "minimum": 1
        },
        "correction_q_nm": {
          "type": "number",
          "minimum": 0
        },
        "test_specimen_count": {
          "type": "integer",
          "minimum": 1
        },
        "in_domain_test_specimen_count": {
          "type": "integer",
          "minimum": 1
        },
        "covered_test_specimen_count": {
          "type": "integer",
          "minimum": 0
        },
        "uncovered_test_specimen_count": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_domain_test_specimen_count": {
          "type": "integer",
          "minimum": 0
        },
        "empirical_group_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wilson_95_lower": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "wilson_95_upper": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "measurement_evidence_class": {
          "$ref": "#/$defs/measurement_evidence_class"
        }
      }
    }
  }
}
