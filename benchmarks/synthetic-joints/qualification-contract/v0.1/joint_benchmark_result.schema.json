{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/qualification-contract/v0.1/joint_benchmark_result.schema.json",
  "title": "Synthetic Joint Benchmark Result V1",
  "description": "Evidence-bound result record for J1 leg, J2 wrist/ankle and J3 finger/gripper benchmark campaigns. This schema records claims; it does not certify their truth or safety.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","record_id","candidate","configuration","task_envelope","system_boundary","metrics","run_summary","evidence","claim_ceiling"],
  "properties": {
    "schema_version": {"const":"1.0.0"},
    "record_id": {"type":"string","minLength":1},
    "candidate": {
      "type":"object","additionalProperties":false,
      "required":["candidate_id","name","joint_class","architecture","evidence_origin"],
      "properties": {
        "candidate_id":{"type":"string","minLength":1},
        "name":{"type":"string","minLength":1},
        "joint_class":{"enum":["J1","J2","J3"]},
        "architecture":{"type":"string","minLength":1},
        "topology":{"type":["string","null"]},
        "manufacturer_or_lab":{"type":["string","null"]},
        "evidence_origin":{"enum":["research_prototype","commercial_product","simulation_model","analytic_reference","internal_prototype","other"]},
        "source_record":{"type":["string","null"]}
      }
    },
    "configuration": {
      "type":"object","additionalProperties":false,
      "required":["configuration_id","revision_state","software_revision","calibration_state","service_state"],
      "properties":{
        "configuration_id":{"type":"string","minLength":1},
        "configuration_digest":{"type":["string","null"]},
        "hardware_revision":{"type":["string","null"]},
        "software_revision":{"type":["string","null"]},
        "controller_revision":{"type":["string","null"]},
        "revision_state":{"enum":["exact","partially_known","source_not_disclosed","not_applicable"]},
        "calibration_state":{"enum":["current","expired","not_disclosed","not_applicable","unknown"]},
        "service_state":{"enum":["new","conditioned","aged","repaired","remounted","not_disclosed","unknown"]},
        "unit_identifier":{"type":["string","null"]}
      }
    },
    "task_envelope":{
      "type":"object","additionalProperties":false,
      "required":["task_id","task_description","pose_set_id","payload_state","motion_or_wrench_envelope","duty","environment"],
      "properties":{
        "task_id":{"type":"string","minLength":1},
        "task_description":{"type":"string","minLength":1},
        "pose_set_id":{"type":["string","null"]},
        "pose_count":{"type":["integer","null"],"minimum":1},
        "coordinate_frame":{"type":["string","null"]},
        "payload_state":{
          "type":"object","additionalProperties":false,"required":["status","description"],
          "properties":{"status":{"enum":["known","unknown","not_applicable"]},"description":{"type":"string","minLength":1}}
        },
        "motion_or_wrench_envelope":{"type":"object","description":"Source-bound trajectories, torques, forces, velocities, accelerations, impulses and contact conditions. Do not merge unlike quantities.","additionalProperties":true},
        "duty":{
          "type":"object","additionalProperties":false,"required":["duration_s","duty_fraction","thermal_condition"],
          "properties":{"duration_s":{"type":["number","null"],"minimum":0},"duty_fraction":{"type":["number","null"],"minimum":0,"maximum":1},"thermal_condition":{"type":"string","minLength":1}}
        },
        "environment":{
          "type":"object","additionalProperties":false,"required":["ambient_temperature_c","other_conditions"],
          "properties":{"ambient_temperature_c":{"type":["number","null"]},"other_conditions":{"type":"array","items":{"type":"string"}}}
        }
      }
    },
    "system_boundary":{
      "type":"object","additionalProperties":false,
      "required":["mass","volume","included_components","excluded_components","power_sources","boundary_notes"],
      "properties":{
        "mass":{"$ref":"#/$defs/bounded_quantity"},
        "volume":{"$ref":"#/$defs/bounded_quantity"},
        "included_components":{"type":"array","items":{"type":"string"}},
        "excluded_components":{"type":"array","items":{"type":"string"}},
        "power_sources":{"type":"array","items":{"type":"string"}},
        "boundary_notes":{"type":"string"}
      }
    },
    "metrics":{"type":"array","items":{"$ref":"#/$defs/metric_observation"}},
    "run_summary":{
      "type":"object","additionalProperties":false,
      "required":["planned_runs","completed_runs","failed_runs","excluded_runs","censored_runs","failure_reasons","outcome_disposition"],
      "properties":{
        "planned_runs":{"type":["integer","null"],"minimum":0},
        "completed_runs":{"type":["integer","null"],"minimum":0},
        "failed_runs":{"type":["integer","null"],"minimum":0},
        "excluded_runs":{"type":["integer","null"],"minimum":0},
        "censored_runs":{"type":["integer","null"],"minimum":0},
        "failure_reasons":{"type":"array","items":{"type":"string"}},
        "outcome_disposition":{"enum":["accepted","partially_accepted","failed","indeterminate","not_a_task_result"]}
      }
    },
    "evidence":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence_reference"}},
    "claim_ceiling":{"type":"string","minLength":1},
    "review":{
      "type":"object","additionalProperties":false,"required":["independent_review","reviewer_role"],
      "properties":{"independent_review":{"enum":["yes","no","not_disclosed","not_applicable"]},"reviewer_role":{"type":"string"},"review_date":{"type":["string","null"],"format":"date"}}
    }
  },
  "$defs":{
    "bounded_quantity":{
      "type":"object","additionalProperties":false,
      "required":["status","value","unit","measurement_boundary","evidence_refs"],
      "properties":{
        "status":{"enum":["reported","measured","derived","unknown","not_disclosed","not_applicable"]},
        "value":{"type":["number","null"]},
        "unit":{"type":"string","minLength":1},
        "measurement_boundary":{"type":"string","minLength":1},
        "evidence_refs":{"type":"array","items":{"type":"string"}},
        "reason":{"type":["string","null"]}
      },
      "allOf":[
        {"if":{"properties":{"status":{"enum":["unknown","not_disclosed","not_applicable"]}},"required":["status"]},"then":{"properties":{"value":{"type":"null"},"reason":{"type":"string","minLength":1}}}},
        {"if":{"properties":{"status":{"enum":["reported","measured","derived"]}},"required":["status"]},"then":{"properties":{"value":{"type":"number"}}}}
      ]
    },
    "metric_observation":{
      "type":"object","additionalProperties":false,
      "required":["metric_id","category","value_status","value","unit","regime","denominator","source_class","verification_state","evidence_refs"],
      "properties":{
        "metric_id":{"type":"string","minLength":1},
        "category":{"enum":["torque","force","torque_density","force_density","speed","bandwidth","stiffness","damping","workspace","conditioning","impact","energy","efficiency","thermal","sensing","model_error","task_coverage","durability","service","cost","other"]},
        "value_status":{"enum":["observed","derived","unknown","not_disclosed","not_applicable"]},
        "value":{"type":["number","integer","string","array","object","null"]},
        "unit":{"type":"string","minLength":1},
        "statistic":{"type":["string","null"]},
        "regime":{"type":"string"},
        "denominator":{"type":"string"},
        "source_class":{"enum":["manufacturer_claim","vendor_affiliated_measurement","paper_reported_model","paper_reported_physical_measurement","independent_lab_measurement","internal_physical_measurement","source_transcription","derived_arithmetic","analytic_reference","numerical_simulation","other"]},
        "verification_state":{"enum":["unreviewed","transcribed","arithmetic_checked","analytically_tested","numerically_crosschecked","physically_measured","independently_replicated"]},
        "uncertainty":{"$ref":"#/$defs/uncertainty"},
        "calibration_ref":{"type":["string","null"]},
        "evidence_refs":{"type":"array","items":{"type":"string"},"minItems":1},
        "stratum":{"type":["string","null"]},
        "reason":{"type":["string","null"]}
      },
      "allOf":[
        {"if":{"properties":{"value_status":{"enum":["unknown","not_disclosed","not_applicable"]}},"required":["value_status"]},"then":{"properties":{"value":{"type":"null"},"reason":{"type":"string","minLength":1}}}},
        {"if":{"properties":{"value_status":{"enum":["observed","derived"]}},"required":["value_status"]},"then":{"properties":{"value":{"not":{"type":"null"}}}}}
      ]
    },
    "uncertainty":{
      "type":["object","null"],"additionalProperties":false,
      "required":["method","coverage_or_confidence","lower","upper"],
      "properties":{"method":{"type":"string","minLength":1},"coverage_or_confidence":{"type":["number","string","null"]},"lower":{"type":["number","null"]},"upper":{"type":["number","null"]},"notes":{"type":["string","null"]}}
    },
    "evidence_reference":{
      "type":"object","additionalProperties":false,
      "required":["evidence_id","source_type","uri","locator","digest"],
      "properties":{
        "evidence_id":{"type":"string","minLength":1},
        "source_type":{"enum":["paper","manufacturer_document","independent_report","raw_measurement","simulation_output","source_code","calibration_certificate","other"]},
        "uri":{"type":"string","format":"uri"},
        "locator":{"type":["string","null"]},
        "digest":{"type":["string","null"]},
        "publication_or_acquisition_date":{"type":["string","null"],"format":"date"},
        "notes":{"type":["string","null"]}
      }
    }
  }
}