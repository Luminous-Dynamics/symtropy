{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/paired-actuator-sharing/v0.1/paired_actuator_sharing.schema.json",
  "title": "Paired Actuator Load-Sharing Qualification Input v0.1",
  "description": "Per-unit output-equivalent torque, current, thermal and capability evidence at a common output reference plane. Current share is not torque share.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "joint_id",
    "joint_configuration_digest",
    "system_boundary_digest",
    "operating_condition_digest",
    "output_reference_plane_digest",
    "reference_clock_id",
    "reference_instant_s",
    "actuator_units",
    "joint_torque_cross_check",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "joint_id": {
      "type": "string",
      "minLength": 1
    },
    "joint_configuration_digest": {
      "type": "string",
      "minLength": 1
    },
    "system_boundary_digest": {
      "type": "string",
      "minLength": 1
    },
    "operating_condition_digest": {
      "type": "string",
      "minLength": 1
    },
    "output_reference_plane_digest": {
      "type": "string",
      "minLength": 1
    },
    "reference_clock_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_instant_s": {
      "type": "number"
    },
    "actuator_units": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/actuator_unit"
      }
    },
    "joint_torque_cross_check": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/joint_cross_check"
        }
      ]
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      }
    },
    "evidence_class": {
      "enum": [
        "synthetic",
        "independent_physical",
        "source_author_physical",
        "vendor_physical",
        "model_derived",
        "unknown"
      ]
    },
    "actuator_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actuator_id",
        "configuration_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "output_reference_plane_digest",
        "reference_clock_id",
        "reference_instant_s",
        "current_magnitude_a",
        "current_evidence_class",
        "current_source_reference",
        "current_method",
        "current_calibration_digest",
        "output_torque_nm",
        "torque_evidence_class",
        "torque_source_reference",
        "torque_method",
        "torque_calibration_digest",
        "capability_evidence_class",
        "capability_source_reference",
        "capability_method",
        "capability_digest",
        "continuous_torque_capability_lower_nm",
        "peak_torque_capability_lower_nm",
        "maximum_speed_capability_lower_rad_s",
        "output_speed_rad_s",
        "required_peak_duration_s",
        "available_peak_duration_lower_s",
        "temperature_c",
        "thermal_limit_lower_c",
        "thermal_evidence_class",
        "thermal_source_reference",
        "thermal_method",
        "thermal_calibration_digest"
      ],
      "properties": {
        "actuator_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "output_reference_plane_digest": {
          "type": "string",
          "minLength": 1
        },
        "reference_clock_id": {
          "type": "string",
          "minLength": 1
        },
        "reference_instant_s": {
          "type": "number"
        },
        "current_magnitude_a": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/interval"
            }
          ]
        },
        "current_evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "current_source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_calibration_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "output_torque_nm": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/interval"
            }
          ]
        },
        "torque_evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "torque_source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "torque_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "torque_calibration_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability_evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "capability_source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuous_torque_capability_lower_nm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_torque_capability_lower_nm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximum_speed_capability_lower_rad_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_speed_rad_s": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/interval"
            }
          ]
        },
        "required_peak_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "available_peak_duration_lower_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "temperature_c": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/interval"
            }
          ]
        },
        "thermal_limit_lower_c": {
          "type": [
            "number",
            "null"
          ]
        },
        "thermal_evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "thermal_source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "thermal_method": {
          "type": [
            "string",
            "null"
          ]
        },
        "thermal_calibration_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "joint_cross_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_torque_nm",
        "evidence_class",
        "source_reference",
        "method",
        "calibration_digest",
        "output_reference_plane_digest",
        "reference_clock_id",
        "system_boundary_digest",
        "operating_condition_digest",
        "reference_instant_s",
        "joint_configuration_digest"
      ],
      "properties": {
        "output_torque_nm": {
          "$ref": "#/$defs/interval"
        },
        "evidence_class": {
          "enum": [
            "independent_physical",
            "synthetic"
          ]
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "calibration_digest": {
          "type": "string",
          "minLength": 1
        },
        "output_reference_plane_digest": {
          "type": "string",
          "minLength": 1
        },
        "reference_clock_id": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "reference_instant_s": {
          "type": "number"
        },
        "joint_configuration_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
