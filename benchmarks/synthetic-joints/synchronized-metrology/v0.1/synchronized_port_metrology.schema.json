{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/synchronized-metrology/v0.1/synchronized_port_metrology.schema.json",
  "title": "Synchronized Actuator Mechanical-Port Metrology Input v0.1",
  "description": "Traceability- and time-bound channel records for deterministic torque-times-angular-velocity interval estimates. A valid schema record does not itself establish physical calibration or traceability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "system_boundary_digest",
    "operating_condition_digest",
    "reference_clock_id",
    "reference_instant_s",
    "torque",
    "angular_velocity",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "system_boundary_digest": {
      "type": "string",
      "minLength": 1
    },
    "operating_condition_digest": {
      "type": "string",
      "minLength": 1
    },
    "reference_clock_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_instant_s": {
      "type": "number"
    },
    "torque": {
      "$ref": "#/$defs/channel"
    },
    "angular_velocity": {
      "$ref": "#/$defs/channel"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower",
        "upper"
      ],
      "properties": {
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "unit",
        "value",
        "sensor_range",
        "calibrated_range",
        "bound_representation",
        "calibration_status",
        "traceability_status",
        "evidence_class",
        "sensor_serial",
        "calibration_sensor_serial",
        "calibration_certificate_reference",
        "reference_standard_reference",
        "calibration_chain_digest",
        "calibration_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "source_reference",
        "measurement_method",
        "raw_trace_digest",
        "reference_clock_id",
        "clock_mapping_digest",
        "reference_instant_s",
        "sample_time_offset_s",
        "clock_offset_uncertainty_s",
        "timestamp_jitter_bound_s",
        "filter_group_delay_s",
        "filter_delay_compensation_s",
        "filter_delay_uncertainty_s",
        "absolute_slew_bound_per_s",
        "slew_bound_provenance_digest",
        "slew_bound_source_reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "output_torque",
            "angular_velocity"
          ]
        },
        "unit": {
          "enum": [
            "N m",
            "rad/s"
          ]
        },
        "value": {
          "$ref": "#/$defs/interval"
        },
        "sensor_range": {
          "$ref": "#/$defs/interval"
        },
        "calibrated_range": {
          "$ref": "#/$defs/interval"
        },
        "bound_representation": {
          "enum": [
            "validated_bound",
            "standard_uncertainty",
            "expanded_uncertainty",
            "unknown"
          ]
        },
        "calibration_status": {
          "enum": [
            "in_date",
            "expired",
            "out_of_tolerance",
            "unknown",
            "not_calibrated"
          ]
        },
        "traceability_status": {
          "enum": [
            "established",
            "partial",
            "not_established",
            "unknown"
          ]
        },
        "evidence_class": {
          "enum": [
            "independent_physical",
            "source_author_physical",
            "vendor_physical",
            "model_derived",
            "unknown"
          ]
        },
        "sensor_serial": {
          "type": "string",
          "minLength": 1
        },
        "calibration_sensor_serial": {
          "type": "string",
          "minLength": 1
        },
        "calibration_certificate_reference": {
          "type": "string",
          "minLength": 1
        },
        "reference_standard_reference": {
          "type": "string",
          "minLength": 1
        },
        "calibration_chain_digest": {
          "type": "string",
          "minLength": 1
        },
        "calibration_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "format": "uri"
        },
        "measurement_method": {
          "type": "string",
          "minLength": 1
        },
        "raw_trace_digest": {
          "type": "string",
          "minLength": 1
        },
        "reference_clock_id": {
          "type": "string",
          "minLength": 1
        },
        "clock_mapping_digest": {
          "type": "string",
          "minLength": 1
        },
        "reference_instant_s": {
          "type": "number"
        },
        "sample_time_offset_s": {
          "type": "number"
        },
        "clock_offset_uncertainty_s": {
          "type": "number",
          "minimum": 0
        },
        "timestamp_jitter_bound_s": {
          "type": "number",
          "minimum": 0
        },
        "filter_group_delay_s": {
          "type": "number"
        },
        "filter_delay_compensation_s": {
          "type": "number"
        },
        "filter_delay_uncertainty_s": {
          "type": "number",
          "minimum": 0
        },
        "absolute_slew_bound_per_s": {
          "type": "number",
          "minimum": 0
        },
        "slew_bound_provenance_digest": {
          "type": "string",
          "minLength": 1
        },
        "slew_bound_source_reference": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
