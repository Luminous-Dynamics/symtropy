{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/mission-conditioned-capability/v0.1/mission_conditioned_joint_capability.schema.json",
  "title": "Mission-Conditioned Joint Capability Profile v0.1",
  "description": "Evidence-bound candidate torque-speed envelopes and mission trajectory requirements. Mechanical feasibility only; not a full hardware qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "candidate",
    "mission",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "mission": {
      "$ref": "#/$defs/mission"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "configuration_digest",
        "operating_condition_digest",
        "regimes"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "regimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regime_envelope"
          }
        },
        "installed_mass": {
          "$ref": "#/$defs/measurement"
        },
        "installed_volume": {
          "$ref": "#/$defs/measurement"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "unit",
        "uncertainty",
        "boundary",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "independently_measured",
            "source_reported",
            "vendor_reported",
            "derived",
            "modelled",
            "unknown",
            "not_disclosed"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "regime_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "points",
        "maximum_interpolation_gap_rad_s",
        "maximum_contiguous_peak_duration_s",
        "evidence"
      ],
      "properties": {
        "regime": {
          "enum": [
            "hold",
            "forward_motoring",
            "forward_regenerating",
            "reverse_motoring",
            "reverse_regenerating"
          ]
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/torque_speed_point"
          }
        },
        "maximum_interpolation_gap_rad_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_contiguous_peak_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "torque_speed_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speed_abs_rad_s",
        "continuous_torque_nm",
        "continuous_uncertainty_nm",
        "peak_torque_nm",
        "peak_uncertainty_nm"
      ],
      "properties": {
        "speed_abs_rad_s": {
          "type": "number",
          "minimum": 0
        },
        "continuous_torque_nm": {
          "type": "number",
          "minimum": 0
        },
        "continuous_uncertainty_nm": {
          "type": "number",
          "minimum": 0
        },
        "peak_torque_nm": {
          "type": "number",
          "minimum": 0
        },
        "peak_uncertainty_nm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "source_reference",
        "method",
        "calibration_reference",
        "configuration_digest",
        "operating_condition_digest"
      ],
      "properties": {
        "class": {
          "enum": [
            "independent_raw_trace",
            "independent_tabulated",
            "source_author_physical_test",
            "vendor_physical_test",
            "digitized_source_plot",
            "reported_without_method",
            "model_derived",
            "unknown"
          ]
        },
        "source_reference": {
          "type": "string",
          "format": "uri"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "calibration_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "candidate_configuration_digest",
        "operating_condition_digest",
        "samples",
        "task_success_condition"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/mission_sample"
          }
        },
        "task_success_condition": {
          "type": "string",
          "minLength": 1
        },
        "payload_boundary": {
          "type": "string"
        },
        "environmental_conditions": {
          "type": "string"
        },
        "sampling_method": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mission_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_s",
        "required_torque_nm",
        "required_torque_uncertainty_nm",
        "angular_speed_rad_s"
      ],
      "properties": {
        "time_s": {
          "type": "number",
          "minimum": 0
        },
        "required_torque_nm": {
          "type": "number"
        },
        "required_torque_uncertainty_nm": {
          "type": "number",
          "minimum": 0
        },
        "angular_speed_rad_s": {
          "type": "number"
        }
      }
    }
  }
}
