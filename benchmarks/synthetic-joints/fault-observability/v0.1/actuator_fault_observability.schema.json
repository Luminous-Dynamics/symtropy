{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Luminous-Dynamics/symtropy/blob/main/benchmarks/synthetic-joints/fault-observability/v0.1/actuator_fault_observability.schema.json",
  "title": "Actuator Fault Observability Campaign v0.1",
  "description": "Event-level detector alarms, fault ground truth, specimen-specific no-fault exposure, TTD, FAR, compound isolation and specimen-grouped MDFA inputs. Schema validity does not establish physical evidence or detector performance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign",
    "claim_ceiling"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "campaign": {
      "$ref": "#/$defs/campaign"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence_class": {
      "enum": [
        "independent_physical",
        "source_author_physical",
        "vendor_physical",
        "synthetic_fixture",
        "unknown"
      ]
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "fault_episodes",
        "alarm_episodes",
        "no_fault_exposure"
      ],
      "properties": {
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "fault_episodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fault_episode"
          }
        },
        "alarm_episodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alarm_episode"
          }
        },
        "no_fault_exposure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/no_fault_exposure"
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "detector_digest",
        "dataset_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "mission_set_digest",
        "expected_fault_classes",
        "minimum_detection_wilson_lower_95",
        "maximum_false_alarms_per_hour",
        "minimum_independent_specimens_per_amplitude",
        "evidence_class"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "detector_digest": {
          "type": "string",
          "minLength": 1
        },
        "dataset_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "expected_fault_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimum_detection_wilson_lower_95": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_false_alarms_per_hour": {
          "type": "number",
          "minimum": 0
        },
        "minimum_independent_specimens_per_amplitude": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        }
      }
    },
    "fault_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "specimen_id",
        "fault_class",
        "amplitude",
        "amplitude_unit",
        "onset_s",
        "clear_s",
        "termination",
        "evidence_class",
        "ground_truth_reference",
        "raw_trace_digest",
        "configuration_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "mission_set_digest"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "minLength": 1
        },
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "fault_class": {
          "type": "string",
          "minLength": 1
        },
        "amplitude": {
          "type": "number",
          "minimum": 0
        },
        "amplitude_unit": {
          "type": "string",
          "minLength": 1
        },
        "onset_s": {
          "type": "number",
          "minimum": 0
        },
        "clear_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "termination": {
          "enum": [
            "fault_cleared",
            "observation_ended"
          ]
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "ground_truth_reference": {
          "type": "string",
          "minLength": 1
        },
        "raw_trace_digest": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alarm_episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alarm_id",
        "specimen_id",
        "alarm_time_s",
        "hypothesized_fault_classes",
        "detector_digest",
        "channel_set_digest",
        "source_reference",
        "method",
        "configuration_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "mission_set_digest"
      ],
      "properties": {
        "alarm_id": {
          "type": "string",
          "minLength": 1
        },
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "alarm_time_s": {
          "type": "number",
          "minimum": 0
        },
        "hypothesized_fault_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "detector_digest": {
          "type": "string",
          "minLength": 1
        },
        "channel_set_digest": {
          "type": "string",
          "minLength": 1
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "no_fault_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure_id",
        "specimen_id",
        "start_s",
        "end_s",
        "evidence_class",
        "source_reference",
        "raw_trace_digest",
        "configuration_digest",
        "system_boundary_digest",
        "operating_condition_digest",
        "mission_set_digest"
      ],
      "properties": {
        "exposure_id": {
          "type": "string",
          "minLength": 1
        },
        "specimen_id": {
          "type": "string",
          "minLength": 1
        },
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "evidence_class": {
          "$ref": "#/$defs/evidence_class"
        },
        "source_reference": {
          "type": "string",
          "minLength": 1
        },
        "raw_trace_digest": {
          "type": "string",
          "minLength": 1
        },
        "configuration_digest": {
          "type": "string",
          "minLength": 1
        },
        "system_boundary_digest": {
          "type": "string",
          "minLength": 1
        },
        "operating_condition_digest": {
          "type": "string",
          "minLength": 1
        },
        "mission_set_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
